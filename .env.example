# Local development — copy to .env and fill in values.
# For Docker Compose, DATABASE_URL is set in docker-compose.yml.
# Put secrets (GITHUB_CLIENT_SECRET, SESSION_SECRET, etc.) in .env.localFs
# when using Docker Compose — it's loaded automatically if present.

# Database provider: "postgresql" or "sqlite"
# For SQLite, run: npm run db:use-sqlite
# For PostgreSQL (default), run: npm run db:use-pg
DB_PROVIDER=postgresql
DATABASE_URL="postgresql://user:password@localhost:5432/hadron"
# For SQLite: DATABASE_URL="file:./hadron.db"

# Server
PORT=4000

# GitHub OAuth (for human web users)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=baragaun

# JWT signing secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-in-production

# Base URL of this server (used for OAuth callback URL construction)
BASE_URL=http://localhost:4000

# Frontend URL (for OAuth redirect after login, and CORS origin)
FRONTEND_URL=http://localhost:5173

# GitHub App (for webhook verification and PR validator)
GITHUB_APP_WEBHOOK_SECRET=
