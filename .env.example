# Local development — copy to .env and fill in values.
# For Docker Compose, DATABASE_URL is set in docker-compose.yml.
# Put secrets (GITHUB_CLIENT_SECRET, SESSION_SECRET, etc.) in .env.localFs
# when using Docker Compose — it's loaded automatically if present.

# PostgreSQL (with pgvector) is the only supported database.
DATABASE_URL="postgresql://user:password@localhost:5432/hadron"

# Optional OWNER credential (#2413 role split), for deployed containers only.
# When set, scripts/docker-start.sh migrates, revokes and verifies with it and
# starts the server under DATABASE_URL, which is then the non-owner SERVE role.
# Leave it unset locally: dev, tests and Docker Compose run single-role (the
# entrypoint logs db.runtime_role.owner_serving). Never point DATABASE_URL at
# the owner URL by hand in a deployment that sets this.
# MIGRATE_DATABASE_URL=
# RUNTIME_ROLE_NAME=hadron_app

# Server
PORT=4000

# GitHub OAuth App (for human web login)
GITHUB_OAUTH_APP_CLIENT_ID=
GITHUB_OAUTH_APP_CLIENT_SECRET=
# GITHUB_OAUTH_APP_ID=
# GITHUB_OAUTH_APP_AUTH_CALLBACK_URL=https://your-domain.com/auth/github/callback
GITHUB_ORG=baragaun

# Google OAuth client for human login only. Keep this client in a separate GCP
# project from the Gmail mailbox integration; request only openid/email/profile.
# Authorized redirect URIs must include BASE_URL/auth/google/callback exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT signing secret. Production refuses to boot below 32 UTF-8 bytes (#421).
# (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-in-production

# Optional domain-specific team-attention HMAC secret; falls back to
# JWT_SECRET when unset.
# TEAM_ATTENTION_TOKEN_SECRET=

# Base URL of this server (used for OAuth callback URL construction)
BASE_URL=http://localhost:4000

# Frontend URL (for OAuth redirect after login, and CORS origin)
FRONTEND_URL=http://localhost:5173

# Dev-only login endpoint (#792): GET /auth/dev/login?email=… signs in as an
# EXISTING user with no email round-trip. Triple-gated (this flag AND
# NODE_ENV !== 'production' AND loopback TCP peer + localhost Host); NEVER
# set in a deployed env.
# DEV_LOGIN_ENABLED=true

# GitHub App webhook verification
GITHUB_WEBHOOK_SECRET=

# Optional: fallback GitHub App credentials (normally stored per-org in DB)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# AES-256-GCM key for encrypting secrets at rest (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
HADRON_ENCRYPTION_KEY=

# Optional: JWT token lifetime (default: 7d)
# JWT_EXPIRY=7d

# Optional: local filesystem path for cloned graph repos (default: ./graphs)
# GRAPHS_PATH=./graphs

# PDF export — the internal hadrontool-pdf service that renders a node to PDF
# (nodeExport(format: PDF)). Required only when PDF export is used; the resolver
# returns a typed error if PDF is requested while PDF_SERVICE_URL is unset.
# PDF_SERVICE_URL=http://localhost:8080
# Optional bearer token; must match the tool's PDF_SERVICE_TOKEN. The tool is
# internal-only (not cloud-exposed); required in the tool's production mode.
# PDF_SERVICE_TOKEN=

# Email authentication (Resend)
RESEND_API_KEY=

# Optional: sender address for magic-link emails (default: Hadron <noreply@hadrongraph.io>)
# EMAIL_FROM="Hadron <noreply@hadrongraph.io>"

# Headless-run email capability tool (separate Resend account/key from auth mail)
# RESEND_TOOL_URL=http://hadrontool-resend:8080
# RESEND_TOOL_TOKEN=
# Comma-separated Organization PKs explicitly allowed to use the sidecar's
# platform Resend account. Unset = BYO sender required for every organization.
# RESEND_PLATFORM_ORG_IDS=
# QUOTA_EMAILS_PER_DAY_APP=25
# QUOTA_EMAILS_PER_DAY_ORG=100

# Microsoft Exchange (optional — only needed if Exchange integration is enabled)
# Hadron's multi-tenant Azure AD app — users sign in via OAuth, no Azure Portal needed
# MICROSOFT_CLIENT_ID=       # Hadron's Azure AD app registration client ID
# MICROSOFT_CLIENT_SECRET=   # Hadron's Azure AD app registration client secret
# EXCHANGE_WEBHOOK_URL=      # Public URL for Graph change notifications (e.g. https://api.example.com/exchange/webhook)

# Cloudflare R2 (asset upload storage)
# Per-environment bucket; keys are scoped {orgUrn}/{memorySegment}/{assetId}.{ext}.
# Spec: specs/001-asset-upload/contracts/http-endpoints.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hadron-assets-dev
# Optional: override the S3 endpoint for local dev with MinIO substituting for R2.
# Leave unset in production (the endpoint is derived from R2_ACCOUNT_ID).
# R2_ENDPOINT_OVERRIDE=http://localhost:9000

# Asset-upload dev convenience: when truthy, new asset uploads land with
# scanStatus="clean" instead of "pending", bypassing the virus-scan gate so
# dev downloads work without a scanner running. NEVER set in production.
# HADRON_ASSET_SCAN_AUTO_CLEAN=true

# 033-rag-vector-retrieval: self-hosted embedding model for vector search.
# Required when any memory has vectorIndexEnabled=true. Dev: run Ollama
# (`ollama pull nomic-embed-text`) → http://localhost:11434/api/embed (batch).
# Prod: HF text-embeddings-inference / vLLM. ALSO register these in Doppler
# (the prod/secrets source), not just here. The client accepts both the Ollama
# ({embeddings:[][]}) and OpenAI ({data:[{embedding}]}) response shapes.
# EMBEDDING_MODEL is sent verbatim to the endpoint, so it must match the served
# tag — for Ollama that's `nomic-embed-text` (which serves nomic-embed-text-v1.5,
# 768-dim), NOT `nomic-embed-text-v1.5` (that tag would 404).
EMBEDDING_API_URL=http://localhost:11434/api/embed
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
# Optional: bearer token for an authenticated self-hosted endpoint.
# EMBEDDING_API_KEY=

# #1895 rollout gates: exact lowercase true is the only opt-in; restart to apply.
# General signing stays off until Holger authorizes it after AL passes.
PASSKEY_SIGNING_ENABLED=false
# Registration additionally waits for Holger's new-domain authorization.
PASSKEY_REGISTRATION_ENABLED=false

# Query-purpose embedding deadline, in milliseconds (default 5000).
# Read when the process-wide embedding client is first constructed, not at boot.
# Positive safe integer, at most 2147483647 (effective Node timer limit; larger values clamp to 1ms).
# Applies to both HTTP and SageMaker queries; valid document calls gain no deadline.
# Invalid configuration refuses shared-client construction, including document workers.
# Bounds client waiting only; it does not guarantee server cancellation or cap cost.
# EMBEDDING_QUERY_TIMEOUT_MS=5000

# S3 team tags: DARK by default. One deployment mode covers team. prefix
# reservation, team-directed routing/stamps and new bare-@team retirement.
# Enablement remains gated on authorized inventory/collision disposition and
# fleet/client readiness; merging this code does not authorize activation.
TEAM_TAGS_ENABLED=false

# S12 cast reporting choice: default OFF for released legacy callers.
# Enable only after CLI/portal/task-source rollout approval. This does not
# bypass the fail-closed head-cast guard if future standby becomes available.
CAST_REPORTING_CHOICE_REQUIRED=false
