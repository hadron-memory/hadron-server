{
  "name": "@hadron/controller",
  "version": "0.1.0",
  "description": "Hadron Controller — GraphQL API, usage DB, and node collection",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:use-pg": "cp prisma/schema.postgresql.prisma prisma/schema.prisma && prisma generate",
    "db:use-sqlite": "cp prisma/schema.sqlite.prisma prisma/schema.prisma && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:dev-reset": "DATABASE_URL=postgresql://holger@localhost:5432/hadron_dev scripts/reset-db.sh",
    "db:test-setup": "DATABASE_URL=postgresql://holger@localhost:5432/hadron_test prisma db push --skip-generate && psql postgresql://holger@localhost:5432/hadron_test -v ON_ERROR_STOP=1 -f prisma/post-push.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@azure/msal-node": "^5.1.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@prisma/client": "^6.19.2",
    "@types/pg": "^8.20.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "graphql": "^16.9.0",
    "isomorphic-fetch": "^3.0.0",
    "jose": "^6.1.3",
    "json-logic-js": "^2.0.5",
    "mustache": "^4.2.0",
    "pg": "^8.20.0",
    "resend": "^6.9.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/json-logic-js": "^2.0.8",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "prisma": "^6.19.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
