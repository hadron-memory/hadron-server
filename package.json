{
  "name": "@hadron/controller",
  "version": "0.1.0",
  "description": "Hadron Controller — GraphQL API, usage DB, and node collection",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:dev-reset": "scripts/reset-db.sh",
    "db:dev-setup": "scripts/dev-setup.sh",
    "db:test-setup": "tsx src/test/setupTestDb.ts",
    "db:dev-from-prod": "scripts/dev-from-prod-snapshot.sh",
    "schema:export": "tsx scripts/export-graphql-sdl.mjs",
    "check:loc-scope": "node scripts/check-loc-scope.mjs",
    "admin:mint-token": "tsx scripts/admin-mint-token.ts",
    "admin:backfill-urn-v2": "tsx scripts/backfill-urn-v2.ts",
    "admin:backfill-shared-memory-agent": "tsx scripts/backfill-shared-memory-agent.ts",
    "admin:backfill-system-embeddings": "tsx src/jobs/backfillSystemMemoryEmbeddings.ts",
    "admin:transfer-exchange-tokens": "tsx scripts/admin-transfer-exchange-tokens.ts",
    "admin:audit-system-memory": "tsx scripts/admin-audit-system-memory.ts",
    "test": "vitest run",
    "db:test-prune-legacy": "tsx src/test/pruneLegacyTestDbs.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:urn-alias": "node scripts/check-urn-rename-aliased.mjs",
    "check:sdl-enums": "tsx scripts/check-sdl-enumerations.mjs",
    "check:sdl-hash-docs": "node scripts/check-sdl-hash-descriptions.mjs",
    "check:sdl-spec-citations": "node scripts/check-sdl-spec-citations.mjs"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.10",
    "@ai-sdk/anthropic": "^4.0.7",
    "@ai-sdk/openai": "^4.0.7",
    "@apollo/server": "^4.11.0",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/client-sagemaker-runtime": "^3.1059.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@azure/msal-node": "^7.1.0",
    "@hadron-memory/access-control": "0.3.0",
    "@hadron-memory/urn-lib-js": "0.0.17",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@mozilla/readability": "^0.6.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@prisma/client": "^6.19.2",
    "@sentry/node": "^10.67.0",
    "@simplewebauthn/server": "14.0.3",
    "@types/pg": "^8.20.0",
    "ai": "^7.0.14",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron-parser": "^5.6.1",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "graphql": "^16.9.0",
    "graphql-query-complexity": "2.0.0",
    "jose": "^6.1.3",
    "json-logic-js": "^2.0.5",
    "linkedom": "^0.18.12",
    "mustache": "^4.2.0",
    "pg": "^8.20.0",
    "resend": "^6.9.3",
    "undici": "^6.27.0",
    "yaml": "2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/json-logic-js": "^2.0.8",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "prisma": "^6.19.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
