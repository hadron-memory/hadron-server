generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  CONTRIBUTOR
  READER
}

enum ClientType {
  WORKSTATION
  AGENT
  AUTOMATION
  CLOUD
  IOT
}

enum SubscriptionType {
  READ_ONLY
  READ_WRITE
}

enum SessionType {
  DEVELOPER
  CHATBOT
  AUTOMATION
  EDGE
}

enum SyncStatus {
  PENDING
  SYNCING
  OK
  ERROR
}

enum IdentityProvider {
  GITHUB
  EMAIL
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum MemoryLogEventType {
  SYNC
  LICENSE
  EDGE
  OTHER
}

enum Visibility {
  PUBLIC
  PRIVATE
}

// ─── Models ────────────────────────────────────────────────────────────

model User {
  id               String            @id @default(cuid())
  githubId         Int?              @unique
  githubUsername    String?           @unique
  identityProvider IdentityProvider?
  name             String?
  email            String?           @unique
  avatarUrl        String?
  roles            Role[]            @default([READER])
  maxReferrals     Int?
  createdAt        DateTime          @default(now())
  createdBy        String?
  updatedAt        DateTime          @updatedAt
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?

  memberships               OrgMember[]
  clients                   Client[]
  sentInvitations           UserInvitation[]           @relation("SentInvitations")
  invitationActivations     UserInvitationActivation[]
  receivedMemberInvitations OrgMemberInvitation[]      @relation("ReceivedMemberInvitations")
  pendingSetup              PendingSetup?

  @@map("users")
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  domain               String   @unique
  isPersonal           Boolean  @default(false)
  githubInstallationId            Int?     @unique
  githubAppId                     String?
  githubAppPrivateKeyEncrypted    String?
  createdAt                       DateTime @default(now())
  createdBy            String?
  updatedAt            DateTime @updatedAt
  updatedBy            String?
  deletedAt            DateTime?
  deletedBy            String?

  members       OrgMember[]
  memories      Memory[]
  clients       Client[]
  memoryBundles MemoryBundle[]
  subscriptions MemorySubscription[]
  invitations   UserInvitation[]     @relation("OrgInvitations")

  @@map("organizations")
}

model OrgMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(READER)
  canInvite      Boolean  @default(false)
  createdAt      DateTime @default(now())
  createdBy      String?
  updatedAt      DateTime?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentMemberInvitations OrgMemberInvitation[] @relation("SentByMember")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("org_members")
}

model Client {
  id             String     @id @default(cuid())
  userId         String?
  organizationId String?
  clientType     ClientType @default(WORKSTATION)
  label          String
  keyHash        String
  apiKeyShown    Boolean    @default(false)
  role           Role       @default(READER)
  namespace      String?
  description    String?
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime   @default(now())
  createdBy      String?
  updatedAt      DateTime?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  user                User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization        Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  bundleSubscriptions ClientBundleSubscription[]
  sessions            Session[]
  usageEvents         UsageEvent[]
  logEntries          ClientLogEntry[]

  @@unique([organizationId, label])
  @@unique([userId, label])
  @@map("clients")
}

model ClientBundleSubscription {
  id               String           @id @default(cuid())
  clientId         String
  bundleId         String
  subscriptionType SubscriptionType @default(READ_ONLY)
  trainingMode     Boolean          @default(false)
  createdAt        DateTime         @default(now())
  createdBy        String?
  updatedAt        DateTime?
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?

  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bundle MemoryBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([clientId, bundleId])
  @@map("client_bundle_subscriptions")
}

model Memory {
  id                   String     @id @default(cuid())
  organizationId       String
  name                 String
  source               String?
  sourceTokenEncrypted String?
  sourceTokenExpiresAt DateTime?
  readBranch           String?
  writeBranch          String?
  visibility           Visibility @default(PRIVATE)
  requiresLicense      Boolean    @default(false)
  lastSyncedAt         DateTime?
  syncStatus           SyncStatus @default(PENDING)
  syncError            String?
  pendingEdgeCount     Int        @default(0)
  createdAt            DateTime   @default(now())
  createdBy            String?
  updatedAt            DateTime   @updatedAt
  updatedBy            String?
  deletedAt            DateTime?
  deletedBy            String?

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodes         Node[]
  subscriptions MemorySubscription[]
  bundleItems   MemoryBundleItem[]
  licenses      MemoryLicense[]
  logEntries    MemoryLogEntry[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("memories")
}

model Node {
  id          String   @id // UUIDv7 from node.yaml — stable across moves
  memoryId    String
  name        String
  title       String
  alias       String?
  loc         String
  isLink      Boolean  @default(false)
  description String?
  content     String?
  contentHash String?
  tokens      Int?
  tags        String[]
  namespace   String
  ownerRepo   String?
  isRunnable  Boolean?
  createdAt   DateTime @default(now())
  createdBy   String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  memory        Memory        @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  outgoingEdges Edge[]        @relation("SourceNode")
  incomingEdges Edge[]        @relation("TargetNode")
  pendingEdges  PendingEdge[]
  usageEvents   UsageEvent[]
  versions      NodeVersion[]

  @@unique([loc, memoryId])
  @@index([loc])
  @@index([namespace])
  @@index([memoryId])
  @@map("nodes")
}

model Edge {
  id       String @id @default(cuid())
  sourceId String
  targetId String
  label    String
  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  source Node @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target Node @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, label])
  @@index([targetId])
  @@map("edges")
}

model PendingEdge {
  id       String  @id @default(cuid())
  sourceId String
  targetId String // intended target node id — NOT a FK
  label    String?
  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  source Node @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([targetId])
  @@map("pending_edges")
}

model Session {
  id              String      @id // caller-generated (e.g. UUID from h-start-session)
  type            SessionType @default(DEVELOPER)
  clientId        String?
  repo            String?
  branch          String?
  prNumber        Int?
  customerId      String?
  language        String?
  plan            String?
  llmModel        String?
  inputTokens     Int?
  outputTokens    Int?
  turnCount       Int?
  errorCount      Int?
  parentSessionId String?
  prevSessionId   String?
  summary         String?
  outcome         Float?
  outcomeRef      String?
  outcomeMeta     Json?
  startedAt       DateTime    @default(now())
  endedAt         DateTime?
  autoExpiredAt   DateTime?
  createdAt       DateTime    @default(now())
  createdBy       String?
  updatedAt       DateTime?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?

  client       Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  events       UsageEvent[]
  parent       Session?   @relation("SubAgentSessions", fields: [parentSessionId], references: [id], onDelete: SetNull)
  subSessions  Session[]  @relation("SubAgentSessions")
  prev         Session?   @relation("SessionChain", fields: [prevSessionId], references: [id], onDelete: SetNull)
  nextSessions Session[]  @relation("SessionChain")

  @@index([type])
  @@index([repo])
  @@index([customerId])
  @@index([startedAt])
  @@index([parentSessionId])
  @@index([prevSessionId])
  @@index([clientId])
  @@map("sessions")
}

model UsageEvent {
  id         String   @id @default(cuid())
  type       String
  nodeLoc    String?
  nodeId     String?
  sessionId  String?
  clientId   String?
  actionArgs Json?
  model      String?
  tokensIn   Int?
  tokensOut  Int?
  createdAt  DateTime @default(now())
  createdBy  String?
  updatedAt  DateTime?
  updatedBy  String?
  deletedAt  DateTime?
  deletedBy  String?

  node    Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([nodeLoc])
  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
  @@index([clientId])
  @@map("usage_events")
}

model MemoryBundle {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  createdBy      String?
  updatedAt      DateTime?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items               MemoryBundleItem[]
  clientSubscriptions ClientBundleSubscription[]

  @@unique([organizationId, name])
  @@map("memory_bundles")
}

model MemoryBundleItem {
  id       String   @id @default(cuid())
  bundleId String
  memoryId String
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  bundle MemoryBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  memory Memory       @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([bundleId, memoryId])
  @@map("memory_bundle_items")
}

model MemoryLicense {
  id          String   @id @default(cuid())
  memoryId    String
  licenseType String
  seats       Int
  validFrom   DateTime
  validUntil  DateTime
  licenseKeys String[]
  terms       String
  activated   Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdBy   String?
  updatedAt   DateTime?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  memory        Memory              @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  subscriptions MemorySubscription[]

  @@map("memory_licenses")
}

model MemorySubscription {
  id             String  @id @default(cuid())
  memoryId       String
  organizationId String
  licenseId      String?
  role           Role    @default(READER)
  activated      Boolean @default(false)
  createdAt      DateTime @default(now())
  createdBy      String?
  updatedAt      DateTime?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  memory       Memory         @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  license      MemoryLicense? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@unique([memoryId, organizationId])
  @@index([organizationId])
  @@map("memory_subscriptions")
}

model HadronServer {
  id              String    @id @default(cuid())
  organizationId  String?
  url             String
  logLevel        LogLevel  @default(ERROR)
  version         String?
  lastHeartbeatAt DateTime?
  createdAt       DateTime  @default(now())
  createdBy       String?
  updatedAt       DateTime?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?

  logEntries ServerLogEntry[]

  @@map("hadron_server")
}

model ServerLogEntry {
  id           String   @id @default(cuid())
  serverId     String
  level        LogLevel
  memoryId     String?
  message      String
  detail       Json?
  createdAt    DateTime @default(now())
  createdBy    String?
  updatedAt    DateTime?
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  server HadronServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([level])
  @@index([createdAt])
  @@map("server_log")
}

model ClientLogEntry {
  id        String   @id @default(cuid())
  clientId  String
  level     LogLevel
  memoryId  String?
  sessionId String?
  message   String
  detail    Json?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([level])
  @@index([createdAt])
  @@map("client_log")
}

model MemoryLogEntry {
  id        String             @id @default(cuid())
  memoryId  String
  level     LogLevel
  eventType MemoryLogEventType
  message   String
  detail    Json?
  createdAt DateTime           @default(now())
  createdBy String?
  updatedAt DateTime?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([level])
  @@index([eventType])
  @@index([createdAt])
  @@map("memory_log")
}

model OrgMemberInvitation {
  id              String    @id @default(cuid())
  memberUserId    String
  recipientUserId String
  role            Role      @default(READER)
  expiresAt       DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  createdBy       String?
  updatedAt       DateTime?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?

  sender    OrgMember @relation("SentByMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  recipient User      @relation("ReceivedMemberInvitations", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@map("org_member_invitations")
}

model UserInvitation {
  id             String    @id @default(cuid())
  senderUserId   String?
  organizationId String?
  slug           String    @unique
  userRole       Role?
  memberRole     Role      @default(READER)
  newUserId      String?
  name           String?
  email          String?
  githubUsername  String?
  phoneNumber    String?
  maxActivations Int?
  expiresAt      DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  createdBy      String?
  updatedAt      DateTime?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  sender       User?          @relation("SentInvitations", fields: [senderUserId], references: [id], onDelete: SetNull)
  organization Organization?  @relation("OrgInvitations", fields: [organizationId], references: [id], onDelete: SetNull)
  activations  UserInvitationActivation[]

  @@map("user_invitations")
}

model UserInvitationActivation {
  id           String   @id @default(cuid())
  invitationId String
  userId       String
  createdAt    DateTime @default(now())
  createdBy    String?
  updatedAt    DateTime?
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  invitation UserInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_invitation_activations")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_verification_tokens")
}

model NodeVersion {
  id          String   @id @default(cuid())
  nodeId      String
  loc         String
  name        String
  title       String
  alias       String?
  description String?
  content     String?
  tags        String[]
  editedBy    String?
  createdAt   DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
  @@map("node_versions")
}

model PendingSetup {
  id              String   @id @default(cuid())
  userId          String   @unique
  clientId        String
  rawKeyEncrypted String
  consumed        Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pending_setups")
}
