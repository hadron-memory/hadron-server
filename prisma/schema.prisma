generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  CONTRIBUTOR
  READER
}

enum ClientType {
  WORKSTATION
  AGENT
  AUTOMATION
  CLOUD
  IOT
}

enum SubscriptionType {
  READ_ONLY
  READ_WRITE
}

enum SessionType {
  DEVELOPER
  CHATBOT
  AUTOMATION
  EDGE
}

enum SyncStatus {
  PENDING
  SYNCING
  OK
  ERROR
}

enum IdentityProvider {
  GITHUB
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum GraphLogEventType {
  SYNC
  LICENSE
  EDGE
  OTHER
}

enum Visibility {
  PUBLIC
  PRIVATE
}

// ─── Models ────────────────────────────────────────────────────────────

model User {
  id               String            @id @default(cuid())
  githubId         Int               @unique
  githubUsername    String            @unique
  identityProvider IdentityProvider?
  name             String?
  email            String?           @unique
  avatarUrl        String?
  roles            Role[]            @default([READER])
  maxReferrals     Int?
  createdAt        DateTime          @default(now())
  createdBy        String?
  updatedAt        DateTime          @updatedAt
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?

  memberships               OrganizationMember[]
  clients                   Client[]
  sentInvitations           UserInvitation[]           @relation("SentInvitations")
  invitationActivations     UserInvitationActivation[]
  receivedMemberInvitations MemberInvitation[]         @relation("ReceivedMemberInvitations")

  @@map("users")
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  domain               String   @unique
  githubInstallationId Int?     @unique
  createdAt            DateTime @default(now())
  createdBy            String?
  updatedAt            DateTime @updatedAt
  updatedBy            String?
  deletedAt            DateTime?
  deletedBy            String?

  members       OrganizationMember[]
  graphs        Graph[]
  clients       Client[]
  graphBundles  GraphBundle[]
  subscriptions GraphSubscription[]
  invitations   UserInvitation[]     @relation("OrgInvitations")

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role     @default(READER)
  canInvite      Boolean  @default(false)
  createdAt      DateTime @default(now())
  createdBy      String?
  updatedAt      DateTime?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentMemberInvitations MemberInvitation[] @relation("SentByMember")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Client {
  id             String     @id @default(cuid())
  userId         String?
  organizationId String?
  clientType     ClientType @default(WORKSTATION)
  label          String
  keyHash        String
  apiKeyShown    Boolean    @default(false)
  role           Role       @default(READER)
  namespace      String?
  description    String?
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime   @default(now())
  createdBy      String?
  updatedAt      DateTime?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  user                User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization        Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  bundleSubscriptions ClientBundleSubscription[]
  sessions            Session[]
  usageEvents         UsageEvent[]
  logEntries          ClientLogEntry[]

  @@unique([organizationId, label])
  @@unique([userId, label])
  @@map("clients")
}

model ClientBundleSubscription {
  id               String           @id @default(cuid())
  clientId         String
  bundleId         String
  subscriptionType SubscriptionType @default(READ_ONLY)
  trainingMode     Boolean          @default(false)
  createdAt        DateTime         @default(now())
  createdBy        String?
  updatedAt        DateTime?
  updatedBy        String?
  deletedAt        DateTime?
  deletedBy        String?

  client Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bundle GraphBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([clientId, bundleId])
  @@map("client_bundle_subscriptions")
}

model Graph {
  id                   String     @id @default(cuid())
  organizationId       String
  name                 String
  source               String?
  sourceTokenEncrypted String?
  sourceTokenExpiresAt DateTime?
  readBranch           String?
  writeBranch          String?
  visibility           Visibility @default(PRIVATE)
  requiresLicense      Boolean    @default(false)
  lastSyncedAt         DateTime?
  syncStatus           SyncStatus @default(PENDING)
  syncError            String?
  pendingEdgeCount     Int        @default(0)
  createdAt            DateTime   @default(now())
  createdBy            String?
  updatedAt            DateTime   @updatedAt
  updatedBy            String?
  deletedAt            DateTime?
  deletedBy            String?

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodes         Node[]
  subscriptions GraphSubscription[]
  bundleGraphs  GraphBundleGraph[]
  licenses      GraphLicense[]
  logEntries    GraphLogEntry[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("graphs")
}

model Node {
  id          String   @id // UUIDv7 from node.yaml — stable across moves
  graphId     String
  name        String
  title       String
  alias       String?
  loc         String   @unique
  description String?
  content     String?
  contentHash String?
  tokens      Int?
  tags        String[]
  namespace   String
  ownerRepo   String?
  isRunnable  Boolean?
  createdAt   DateTime @default(now())
  createdBy   String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  graph         Graph         @relation(fields: [graphId], references: [id], onDelete: Cascade)
  outgoingEdges Edge[]        @relation("SourceNode")
  incomingEdges Edge[]        @relation("TargetNode")
  pendingEdges  PendingEdge[]
  usageEvents   UsageEvent[]

  @@index([namespace])
  @@index([graphId])
  @@map("nodes")
}

model Edge {
  id       String @id @default(cuid())
  sourceId String
  targetId String
  label    String
  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  source Node @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target Node @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, label])
  @@index([targetId])
  @@map("edges")
}

model PendingEdge {
  id       String  @id @default(cuid())
  sourceId String
  targetId String // intended target node id — NOT a FK
  label    String?
  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  source Node @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([targetId])
  @@map("pending_edges")
}

model Session {
  id              String      @id // caller-generated (e.g. UUID from h-start-session)
  type            SessionType @default(DEVELOPER)
  clientId        String?
  repo            String?
  branch          String?
  prNumber        Int?
  customerId      String?
  language        String?
  plan            String?
  llmModel        String?
  inputTokens     Int?
  outputTokens    Int?
  turnCount       Int?
  errorCount      Int?
  parentSessionId String?
  prevSessionId   String?
  summary         String?
  outcome         Float?
  outcomeRef      String?
  outcomeMeta     Json?
  startedAt       DateTime    @default(now())
  endedAt         DateTime?
  autoExpiredAt   DateTime?
  createdAt       DateTime    @default(now())
  createdBy       String?
  updatedAt       DateTime?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?

  client       Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  events       UsageEvent[]
  parent       Session?   @relation("SubAgentSessions", fields: [parentSessionId], references: [id], onDelete: SetNull)
  subSessions  Session[]  @relation("SubAgentSessions")
  prev         Session?   @relation("SessionChain", fields: [prevSessionId], references: [id], onDelete: SetNull)
  nextSessions Session[]  @relation("SessionChain")

  @@index([type])
  @@index([repo])
  @@index([customerId])
  @@index([startedAt])
  @@index([parentSessionId])
  @@index([prevSessionId])
  @@index([clientId])
  @@map("sessions")
}

model UsageEvent {
  id         String   @id @default(cuid())
  type       String
  nodeLoc    String?
  nodeId     String?
  sessionId  String?
  clientId   String?
  actionArgs Json?
  model      String?
  tokensIn   Int?
  tokensOut  Int?
  createdAt  DateTime @default(now())
  createdBy  String?
  updatedAt  DateTime?
  updatedBy  String?
  deletedAt  DateTime?
  deletedBy  String?

  node    Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([nodeLoc])
  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
  @@index([clientId])
  @@map("usage_events")
}

model GraphBundle {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  createdBy      String?
  updatedAt      DateTime?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  graphs              GraphBundleGraph[]
  clientSubscriptions ClientBundleSubscription[]

  @@unique([organizationId, name])
  @@map("graph_bundles")
}

model GraphBundleGraph {
  id       String   @id @default(cuid())
  bundleId String
  graphId  String
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  bundle GraphBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  graph  Graph       @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@unique([bundleId, graphId])
  @@map("graph_bundle_graphs")
}

model GraphLicense {
  id          String   @id @default(cuid())
  graphId     String
  licenseType String
  seats       Int
  validFrom   DateTime
  validUntil  DateTime
  licenseKeys String[]
  terms       String
  activated   Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdBy   String?
  updatedAt   DateTime?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  graph         Graph              @relation(fields: [graphId], references: [id], onDelete: Cascade)
  subscriptions GraphSubscription[]

  @@map("graph_licenses")
}

model GraphSubscription {
  id             String  @id @default(cuid())
  graphId        String
  organizationId String
  licenseId      String?
  role           Role    @default(READER)
  activated      Boolean @default(false)
  createdAt      DateTime @default(now())
  createdBy      String?
  updatedAt      DateTime?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  graph        Graph         @relation(fields: [graphId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  license      GraphLicense? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@unique([graphId, organizationId])
  @@index([organizationId])
  @@map("graph_subscriptions")
}

model HadronController {
  id              String    @id @default(cuid())
  organizationId  String?
  url             String
  logLevel        LogLevel  @default(ERROR)
  version         String?
  lastHeartbeatAt DateTime?
  createdAt       DateTime  @default(now())
  createdBy       String?
  updatedAt       DateTime?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?

  logEntries ControllerLogEntry[]

  @@map("hadron_controller")
}

model ControllerLogEntry {
  id           String   @id @default(cuid())
  controllerId String
  level        LogLevel
  graphId      String?
  message      String
  detail       Json?
  createdAt    DateTime @default(now())
  createdBy    String?
  updatedAt    DateTime?
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  controller HadronController @relation(fields: [controllerId], references: [id], onDelete: Cascade)

  @@index([controllerId])
  @@index([level])
  @@index([createdAt])
  @@map("controller_log")
}

model ClientLogEntry {
  id        String   @id @default(cuid())
  clientId  String
  level     LogLevel
  graphId   String?
  sessionId String?
  message   String
  detail    Json?
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([level])
  @@index([createdAt])
  @@map("client_log")
}

model GraphLogEntry {
  id        String            @id @default(cuid())
  graphId   String
  level     LogLevel
  eventType GraphLogEventType
  message   String
  detail    Json?
  createdAt DateTime          @default(now())
  createdBy String?
  updatedAt DateTime?
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  graph Graph @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@index([graphId])
  @@index([level])
  @@index([eventType])
  @@index([createdAt])
  @@map("graph_log")
}

model MemberInvitation {
  id              String    @id @default(cuid())
  memberUserId    String
  recipientUserId String
  role            Role      @default(READER)
  expiresAt       DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  createdBy       String?
  updatedAt       DateTime?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?

  sender    OrganizationMember @relation("SentByMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  recipient User               @relation("ReceivedMemberInvitations", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@map("member_invitations")
}

model UserInvitation {
  id             String    @id @default(cuid())
  senderUserId   String?
  organizationId String?
  slug           String    @unique
  userRole       Role?
  memberRole     Role      @default(READER)
  newUserId      String?
  name           String?
  email          String?
  githubUsername  String?
  phoneNumber    String?
  maxActivations Int?
  expiresAt      DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  createdBy      String?
  updatedAt      DateTime?
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?

  sender       User?          @relation("SentInvitations", fields: [senderUserId], references: [id], onDelete: SetNull)
  organization Organization?  @relation("OrgInvitations", fields: [organizationId], references: [id], onDelete: SetNull)
  activations  UserInvitationActivation[]

  @@map("user_invitations")
}

model UserInvitationActivation {
  id           String   @id @default(cuid())
  invitationId String
  userId       String
  createdAt    DateTime @default(now())
  createdBy    String?
  updatedAt    DateTime?
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  invitation UserInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_invitation_activations")
}
