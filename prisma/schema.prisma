generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  // 033-rag-vector-retrieval: postgresqlExtensions is still a preview feature
  // in Prisma 6.x; enables the `extensions` block below so `prisma db push` /
  // `migrate` manage `CREATE EXTENSION vector` (pgvector).
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // 033-rag-vector-retrieval: pgvector. db push/migrate runs CREATE EXTENSION
  // vector before creating the vector(768) column on node_embeddings.
  extensions = [vector]
}

// ─── Hadron entity model ──────────────────────────────────────────────
//
// This schema is the **canonical** source of entity definitions for the
// Hadron platform. The legacy Entities.md (in the sister `hadron-concept`
// repo, at hadron-specs/General/Entities.md) was folded into this file on
// 2026-05-11 and deleted; do not recreate it.
//
// Cross-repo references below cite paths in sister repos by repo name
// (e.g. `hadron-concept/...`, `hadron-docs/...`). Those trees do not live
// in this repository.
//
// Shared audit fields
// -------------------
// Every model below carries the same audit columns (not re-described per
// field to keep the file readable):
//   createdAt, createdBy   — set at row insert (createdBy is fk-ish to
//                            User.id but unconstrained for system writes)
//   updatedAt, updatedBy   — set on every update (Prisma @updatedAt)
//   deletedAt, deletedBy   — soft-delete marker; null = live row
// A handful of tables (AppMember, AgentSubscription, AgentOrgGrant) omit
// deletedAt/deletedBy on purpose — soft-delete is redundant there because
// the row has a richer lifecycle field (revokedAt) or is a pure join with
// no meaningful "soft-deleted" state. Each such table calls this out in
// its model-level doc.
//
// URN convention
// --------------
// Globally addressable entities (Organization, Memory, Agent, App) carry
// both a `urn` (unique, stable, colon-delimited identifier) and a `name`
// (human-friendly display label, not unique). Colon is the structural
// delimiter. URN shapes:
//   - Organization: `<domain>`               e.g. "baragaun.com"
//   - Memory:       `<org>:<slug>`           e.g. "baragaun.com:secureid"
//   - Agent:        `<org>:<slug>`           e.g. "micromentor.org:juno"
//   - App:          `<org>:<slug>`           e.g. "baragaun.com:internal-ops"
//   - Node:         `<memory.urn>:<loc>`     computed, NOT stored
//   - Asset:        computed, NOT stored — the read surface emits grammar v2
//                   `hrn:asset:<root>:<mem...>:assets:<asset.id>` (see the
//                   Asset model doc and the GraphQL `Asset.urn` docstring).
// The four stored shapes above are the BARE column values. Every read surface
// renders them through the grammar-v2 emitters (#697 Stage 2), so a client sees
// `hrn:org:` / `hrn:mem:` / `hrn:agent:` / `hrn:app:` prefixes that the column
// itself does not carry — and for Memory the `chk_memory_urn_not_prefixed`
// guardrail actively rejects storing the rendered form.
// Full scheme: `hadron-concept/hadron-specs/General/URN.md` (sister repo).
//
// Table naming
// ------------
// All model `@@map(...)` names are explicit snake_case. Most are plural
// (`users`, `organizations`, `memories`), but some are singular by
// convention — `hadron_server`, `server_log`, `memory_log`, `app_log`,
// `waiting_list`. Prisma would default to PascalCase otherwise; the
// explicit map keeps the SQL surface stable across model renames.

// ─── Enums ─────────────────────────────────────────────────────────────

/// Global / organization-membership role. Used on OrgMember.role,
/// MemorySubscription.role, and the *Invitation roles. Hierarchy:
/// OWNER > ADMIN > CONTRIBUTOR > READER. Invitations cannot grant a
/// role higher than the sender's own. **Note**: MemorySubscription /
/// OrgMemberInvitation / UserInvitation use this full enum at the
/// column level, but the intended grant set is narrower (typically
/// CONTRIBUTOR | READER for subscriptions; admin | contributor |
/// reader for invitations). Tightening the column is reserved for a
/// future cleanup spec.
enum Role {
  OWNER
  ADMIN
  CONTRIBUTOR
  READER
}

/// Per-App default role assigned to new members when no Agent
/// `installation_policy.memberRoles` override applies. Free-form
/// AppMember.role strings (validated against installation_policy) are
/// distinct from this enum — the enum survives mainly for legacy
/// App.role storage.
enum AppMembershipRole {
  OWNER
  ADMIN
  CONTRIBUTOR
  READER
}

/// **Deprecated** in favor of App.surfaces (008-agent-installation
/// R-4). Kept to avoid spurious portal churn; a follow-up cleanup
/// spec will drop it.
enum AppType {
  WORKSTATION
  CHATBOT
  AGENT
  AUTOMATION
  CLOUD
  IOT
}

/// Reserved enum — declared but not currently referenced by any
/// column. A 2026-Q3 marketplace-licensing spec is expected to wire
/// this into MemorySubscription. Flagged for cleanup-if-not-used.
enum SubscriptionType {
  READ_ONLY
  READ_WRITE
}

/// Coarse classification of a Session: who/what is driving it.
///   DEVELOPER  — interactive coding session (Claude Code, Cursor, …)
///   CHATBOT    — end-user chat through an App (e.g. Juno)
///   AUTOMATION — non-interactive run (cron, CI, scripted agent)
///   EDGE       — triggered by an Edge condition firing
enum SessionType {
  DEVELOPER
  CHATBOT
  AUTOMATION
  EDGE
}

/// State machine for Memory git-sync and ExchangeConnection mailbox
/// sync. Transitions: PENDING → SYNCING → OK | ERROR; ERROR rows can
/// re-enter SYNCING on retry.
enum SyncStatus {
  PENDING
  SYNCING
  OK
  ERROR
}

/// How a User authenticated. APP is reserved for users provisioned
/// via App-scoped flows (e.g. chatbot `createAppUser`); GOOGLE landed
/// with Sign-in-with-Google (#581), APPLE with Sign-in-with-Apple
/// (#584); MICROSOFT is reserved for future SSO.
enum IdentityProvider {
  GITHUB
  EMAIL
  APP
  GOOGLE
  MICROSOFT
  APPLE
}

/// App-level policy for whether the App may create new platform Users
/// on-the-fly when a chatbot session arrives with a previously-unseen
/// external id.
///   DENY     — never create; reject the request
///   EXPLICIT — only via the `createAppUser` mutation
///   IMPLICIT — auto-create on first contact (used by Workstation apps)
enum CreateUserPermission {
  DENY
  EXPLICIT
  IMPLICIT
}

/// App-level policy for how to resolve "which User is this?" from the
/// incoming session credential.
///   USER_ID — the App passes our internal User.id (default; trust-the-caller)
///   SECRET  — the App passes a per-user secret we look up
enum IdentifyUserMethod {
  USER_ID
  SECRET
}

/// **Largely legacy**. The Agent.type field below carries the coarse
/// behavior hint (ASSISTANT vs CHATBOT). Post-008-agent-installation
/// most behavior is driven by surfaces / installation_policy /
/// memory_provisioning, not this enum. Kept for backward-compat with
/// portal listings; a follow-up cleanup spec may collapse it.
enum AgentType {
  ASSISTANT
  CHATBOT
}

/// #4224 (S3 of #4229) — how long a worker of this Agent runs. LONG_LIVED (default, today's behaviour): its
/// process should always run. SHORT_LIVED: it should run only while the worker is the assignee of a pending or
/// started task, one waiting on its child tasks included (G7). Read by the desired-state query
/// (src/lib/desiredState) and, #4223, by a task's finish or cancellation: the worker's session ends with its last
/// open task (src/lib/hostOperations/sessionEnd.ts).
enum AgentLifecycle {
  LONG_LIVED
  SHORT_LIVED
}

/// #4291 (S14 of #4229; decision record run-settings-are-not-worker-identity, settled A) — the generic effort scale
/// of a
/// run. LOW..MAX are requests the launcher maps to the family's own values (hadron-cli#2199); UNSET is the family's
/// default. NOT_APPLICABLE is REPORT-ONLY: a session whose family has no effort control records it, and so may the
/// worker's last-used record; a task never carries it, and a start that falls back to it sends UNSET.
enum EffortLevel {
  LOW
  MEDIUM
  HIGH
  XHIGH
  MAX
  UNSET
  NOT_APPLICABLE
}

/// #4224 (S3 of #4229) — the App's sweep switch. OFF (default): the host sweep acts on no worker and every
/// desired-state
/// row says SWEEP_OFF. OBSERVE: the sweep compares and reports. APPLY: it also repairs.
enum SweepMode {
  OFF
  OBSERVE
  APPLY
}

/// Severity of a log entry (ServerLogEntry, MemoryLogEntry, AppLogEntry), and the lowest level a server records
/// (`HadronServer.logLevel`).
enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// Tag for MemoryLogEntry rows to support filtered tail views in
/// hadron-portal (e.g. "show me only sync errors for this memory").
enum MemoryLogEventType {
  SYNC
  LICENSE
  EDGE
  OTHER
}

/// Memory visibility — **035-visibility-enum-cleanup**. Meaningful only
/// for `knowledge` (PUBLIC/ORGANIZATION) and `group` (GROUP); NULL for
/// every other class. The `PERSONAL`/`PRIVATE` values were dropped (spec
/// 034 moved privacy onto the `personal`/`private` CLASS). The
/// `chk_memory_visibility_class` CHECK forbids a non-null visibility on
/// any class other than knowledge/group.
enum MemoryVisibility {
  PUBLIC
  ORGANIZATION
  /// 023-app-shape: bidirectional with `MemoryClass.group`. Enforced by
  /// the `chk_memory_group_visibility` CHECK constraint:
  /// `class = 'group' ⇔ visibility = 'GROUP'`.
  GROUP
}

/// Agent visibility — **035-visibility-enum-cleanup** split this off the
/// shared `MemoryVisibility` enum. `PERSONAL` is the creator-only draft
/// state (named PERSONAL, not PRIVATE, so it never collides with the
/// memory `private` class). `Organization.agents` filters on it;
/// `createAgent` defaults to it.
enum AgentVisibility {
  PUBLIC
  ORGANIZATION
  PERSONAL
}

/// Per-Memory typology — formalized in 005-agent-subscription
/// (2026-04-30); per-class governance refined in 008-agent-installation
/// (2026-05-02), re-keyed onto `class` by 034-memory-class-access.
/// `personal`/`private`-class memories MUST have Memory.userId set
/// (chk_personal_visibility_user). `app`-class MUST have Memory.appId set;
/// `personal`/`private` MAY have it (set when app-scoped, NULL when
/// free-standing); `system`/`knowledge`/`group` MUST NOT
/// (chk_memory_class_app_id, relaxed by spec 034).
///
///   system     — the Agent's own definition (one per Agent, linked via
///                Agent.systemMemoryId). Universally read-only from any
///                App context post-008 (DEVELOP-from-App is dropped per
///                R-10). Edits happen in the Agent ownership surface.
///   app        — records the App writes through the Agent (chat history,
///                extracted facts, generated artifacts). Keyed on
///                (app_id, agent_id) for shared-app-memory Agents,
///                (app_id, agent_id, user_id) for per-user-app-memory.
///                Spec 017 (2026-05-12): app-class memories named
///                `${app.urn}:${agentSlug}:shared` are the v1 home for
///                SHARED chats (chats readable by every AppMember of
///                the App). Keyed per-(App, Agent) so the multi-Agent
///                App from 2026-05-12-user-installing-app §3 — where
///                one App can install N Agents under the reintroduced
///                AppAgent join — gives each installed Agent its own
///                shared memory. Lazy-provisioned by
///                `findOrCreateAppClassMemory` on the first shared
///                chat for an (App, Agent) pair.
///   knowledge  — reference content the Agent reads from. Per-Agent
///                (not per-App); two installs of the same Agent share
///                the same knowledge memory.
///   personal   — per-user records owned by Memory.userId. App-scoped by
///                (app_id, agent_id, user_id) when provisioned inside an
///                app (the per-App pivot gives Mike-on-two-orgs clean
///                isolation), OR free-standing (app_id/agent NULL) when a
///                user creates it directly (spec 034). Strict ownership.
///   private    — single-owner, owner-only (no MemoryShare path, no
///                ADMIN/OWNER bypass). Spec 034 (#242) made it
///                user-creatable via createMemory — free-standing or
///                app-scoped. May opt into encrypt-at-rest, but the
///                encryption implementation is a deferred follow-up, so
///                **do not rely on at-rest encryption for secrets yet.**
enum MemoryClass {
  system
  app
  knowledge
  personal
  /// 023-app-shape: symmetric team-shared memory. Governance is by
  /// `MemoryMember` (list of users with roles `reader | writer | owner`),
  /// not by a single Memory.userId owner. `Memory.userId IS NULL` for
  /// group-class rows (enforced by `chk_memory_group_no_owner`). The
  /// bidirectional invariant `class = 'group' ⇔ visibility = 'GROUP'`
  /// is enforced by `chk_memory_group_visibility`.
  group
  private
}

/// 023-app-shape: role on a `MemoryShare` row (asymmetric cross-user
/// grant for personal-class memory). `reader` permits read; `writer`
/// permits read and write.
enum MemoryShareRole {
  reader
  writer
}

/// 023-app-shape: role on a `MemoryMember` row (symmetric membership
/// for group-class memory). `reader` permits read; `writer` permits
/// read and write; `owner` adds management capabilities (add/remove
/// members, change roles, delete/rename/configure the Memory) per
/// spec 023 FR-036. The platform protects against zero-owner states:
/// removing or demoting the sole remaining `owner` is rejected with
/// `LAST_OWNER_PROTECTED` (FR-038).
enum MemoryMemberRole {
  reader
  writer
  owner
}

/// Asset virus-scan state. Downloads are gated on CLEAN. Transitions:
/// PENDING → CLEAN | BLOCKED.
enum AssetScanStatus {
  PENDING
  CLEAN
  BLOCKED
}

// ─── Models ────────────────────────────────────────────────────────────

/// A person with an account on this server. Every authenticated request that acts for a human resolves to one User
/// row, and the row is the root of what that person owns, holds and may do.
///
/// A user signs in through an identity provider (`identityProvider`; the provider's own account id is in `githubId`,
/// `googleId` or `appleId`) or by email, and is addressed by a unique `handle`. An App can also provision a user for
/// one of its own end users; (`externalAppId`, `externalId`) is the key that finds that user again.
///
/// Relationships:
/// - Organizations: many-to-many through OrgMember. A user needs no organization: it can own Apps, Agents and
///   Memories directly (`ownedApps`, `ownedAgents`, `tenantMemories`), and signup creates no personal organization.
/// - Principal: `principalId` points at the row that reserves the handle in the one namespace handles share with
///   organization names.
/// - Memories: `ownedMemories` are the personal and private memories whose strict owner is this user
///   (`Memory.userId`). That is a different relation from `tenantMemories` (`Memory.ownerUserId`).
/// - Credentials and sign-in: UserApiKey, PasskeyCredential, AuthCode, SignIn and the pending sign-in models.
/// - Team work: the Worker names this person holds, the Sessions attributed to them, the AgentTasks they own or
///   are assigned.
/// - UserMerge: `mergedInto` is set when this account was merged into another; `mergedFrom` lists the accounts
///   merged into this one.
///
/// Invitation chain: UserInvitationActivation links a user to the UserInvitation that brought them in, whose
/// `senderUserId` is the inviter, and so on up to a root invitation with no sender (a system seed).
///
/// Referral quota (`maxReferrals`): the number of new platform users this user may bring in. Only accepted
/// activations count, and they count for every inviter up the chain: when A invites B and B invites C, C joining
/// uses quota of both A and B. An invitation's `UserInvitation.maxActivations` must not exceed the smallest free
/// quota in the inviter's chain. A person who is already signing up is never refused for the quota: if the account
/// creation would exceed it, the account is created anyway.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:040:01.
model User {
  id               String            @id @default(cuid())
  /// Unique username, e.g. "holger"; displayed as `@holger` in UI and node
  /// frontmatter `author` field, and the owner namespace of a user-owned
  /// App/Agent/Memory URN (spec 047). NOT NULL (all users backfilled 2026-07-14):
  /// every real signup path assigns one via `generateUniqueHandle`; the
  /// DB-generated random default is a backstop for handle-omitting inserts
  /// (test fixtures) so those need no churn. Case-insensitive uniqueness is the
  /// `users_handle_lower_uniq` functional index (post-push.sql); the `@unique`
  /// here is the plain case-sensitive one.
  handle           String            @unique @default(dbgenerated("\"left\"(md5((random())::text), 12)"))
  /// User-layer action-policy link (hrn:node:hadronmemory.com:specs:cor:acl:040:02) — constrains runs made
  /// on-behalf-of this user. Same allow-list shape as Organization.policy;
  /// NULL = no restriction. Self-authored (updateMyPolicy).
  policy           Json?
  /// GitHub numeric account id.
  githubId         Int?              @unique @map("github_id")
  /// GitHub login.
  githubUsername   String?           @unique @map("github_username")
  /// Google account id — the OIDC `sub` claim (#581). A string of digits,
  /// but stored as text: Google documents it as an opaque string and it
  /// can exceed 2^53.
  googleId         String?           @unique @map("google_id")
  /// Apple account id — the Sign-in-with-Apple `sub` claim (#584). An
  /// opaque team-scoped string (e.g. "001234.abcd1234ef….0102").
  appleId          String?           @unique @map("apple_id")
  identityProvider IdentityProvider? @map("identity_provider")
  // 005-agent-subscription discovery (2026-04-30): R-5 in research.md
  // proposed dropping `externalId`, but the implementation found that
  // `createAppUser` and `startAgentSession` use it as the lookup key
  // for "find the existing User this chatbot already provisioned for
  // external-7." Dropping it would force every chatbot call to create
  // a new User row (no idempotency) or require the chatbot to track
  // the hadron user-id itself on every call. That requires a separate
  // design discussion — restored `externalId` for now; deferred the
  // drop. See spec.md §"Assumptions" for the deferral note.
  /// App-scoped external user id. Composite-unique with `externalAppId`.
  externalId       String?           @map("external_id")
  /// The App that minted this externalId. Forms a (App, externalId)
  /// idempotency key for chatbot user provisioning.
  externalAppId    String?           @map("external_app_id")
  /// When this app-scoped external identity was linked to the
  /// platform User (i.e. when the chatbot user "graduated" to a real
  /// account).
  linkedAt         DateTime?         @map("linked_at")
  name             String?
  /// Used for invite matching and email-based auth.
  email            String?           @unique
  avatarUrl        String?           @map("avatar_url")
  /// Global platform roles (not org-scoped). Default `[READER]`.
  roles            Role[]            @default([READER])
  /// Maximum number of new platform users this user can onboard. See
  /// the model-level doc for the referral-quota semantics.
  maxReferrals     Int?              @map("max_referrals")
  createdAt        DateTime          @default(now()) @map("created_at")
  createdBy        String?           @map("created_by")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  updatedBy        String?           @map("updated_by")
  deletedAt        DateTime?         @map("deleted_at")
  deletedBy        String?           @map("deleted_by")

  memberships                   OrgMember[]
  issuedGrants                  Grant[]                     @relation("GrantIssuer")
  sentInvitations               UserInvitation[]            @relation("SentInvitations")
  invitationActivations         UserInvitationActivation[]
  receivedMemberInvitations     OrgMemberInvitation[]       @relation("ReceivedMemberInvitations")
  pendingSetup                  PendingSetup?
  exchangeConnections           ExchangeConnection[]
  connectionGrantsByUser        ConnectionGrant[]           @relation("ConnectionGrantsByUser")
  principalGrants               PrincipalGrant[]            @relation("UserPrincipalGrants")
  externalApp                   App?                        @relation(fields: [externalAppId], references: [id], onDelete: SetNull)
  sessions                      Session[]                   @relation("SessionUser")
  /// #1050 — worker names this person HOLDS. Held until released, never freed
  /// by a session ending; one human may hold many.
  heldWorkers                   Worker[]                    @relation("WorkerHolder")
  /// #1705 — agent tasks this person owns / is assigned.
  ownedAgentTasks               AgentTask[]                 @relation("AgentTaskOwnerUser")
  assignedAgentTasks            AgentTask[]                 @relation("AgentTaskAssigneeUser")
  mcpSessionStates              McpSessionState[]
  ownedMemories                 Memory[]                    @relation("UserMemoriesOwned")
  // spec 047 (Phase 2b): entities this user is the TENANT owner of (user-owned
  // App/Agent/Memory). `ownedMemories` above is the personal/private strict
  // owner (Memory.userId) — a DIFFERENT relation from `tenantMemories` here.
  ownedApps                     App[]                       @relation("AppOwner")
  ownedAgents                   Agent[]                     @relation("AgentOwner")
  tenantMemories                Memory[]                    @relation("MemoryTenantOwner")
  agentSubscriptions            AgentSubscription[]         @relation("UserAgentSubscriptions")
  appMemberships                AppMember[]                 @relation("UserAppMemberships")
  // 023-app-shape: per-Memory authorization back-relations.
  memorySharesGranted           MemoryShare[]               @relation("MemorySharesGranted")
  memorySharesByGrantor         MemoryShare[]               @relation("MemorySharesByGrantor")
  memoryMemberships             MemoryMember[]              @relation("MemoryMemberships")
  // 025-oauth-for-mcp: user-level credential + OAuth back-relations.
  userApiKeys                   UserApiKey[]
  userApiKeyDeletions           UserApiKeyDeletion[]
  authCodes                     AuthCode[]
  passkeyCredentials            PasskeyCredential[]
  freshSignIns                  FreshSignIn[]
  passkeyCeremonies             PasskeyCeremony[]
  passkeyRegistrationNotices    PasskeyRegistrationNotice[]
  pendingEmailSignIns           PendingEmailSignIn[]
  signIns                       SignIn[]
  authHandoffCodes              AuthHandoffCode[]
  connectionFlows               ConnectionFlow[]
  // #620: revisions this user approved (NodeRevision.approvedBy).
  approvedNodeRevisions         NodeRevision[]              @relation("NodeRevisionApprover")
  // 046-usage-metering: billing attribution back-relation.
  usageEvents                   UsageEvent[]
  // #772: the user's placed /app/dashboard widgets (user-scoped layout config).
  dashboardWidgets              DashboardWidget[]
  // #806: the user's SAVED widget configurations (a palette, not a placement).
  dashboardWidgetPresets        DashboardWidgetPreset[]
  // Admin impersonation (read-only support sessions): sessions this user
  // started as the admin actor / was the target of.
  impersonationSessionsAsAdmin  ImpersonationSession[]      @relation("ImpersonationSessionsAsAdmin")
  impersonationSessionsAsTarget ImpersonationSession[]      @relation("ImpersonationSessionsAsTarget")
  // #692 — the user's root principal in the unified pool (handle is the
  // denormalized read source-of-truth, kept in sync at mint).
  principalId                   String?                     @unique @map("principal_id")
  principal                     Principal?                  @relation("UserPrincipal", fields: [principalId], references: [id], onDelete: SetNull)
  /// #1325 — MemoryConfig templates this user owns (user-owned owner branch).
  memoryConfigTemplates         MemoryConfigTemplate[]      @relation("MemoryConfigTemplateOwnerUser")
  /// #1715 — this account's merge into another, if it was merged away.
  mergedInto                    UserMerge?                  @relation("UserMergeSource")
  /// #1715 — accounts merged into this one.
  mergedFrom                    UserMerge[]                 @relation("UserMergeTarget")

  @@unique([externalAppId, externalId])
  @@map("users")
}

/// The record of one account merge (`mergeUsers`): the source account was merged into the target account, and the
/// target survives. Readers use these rows to find the surviving account behind a user id that was stored before
/// the merge.
///
/// Relationships: `source` and `target` are both Users. The row is keyed on the source, so an account is merged
/// away at most once. `consentHash` and `consentReceipt` hold the sealed evidence that both accounts approved (see
/// UserMergeConsent); they are absent only on merges recorded before that evidence existed.
///
/// Behaviour: written inside the merge transaction and never changed. The source account is soft-deleted by the
/// merge, so it can never be the target of a later merge, which keeps the chains free of cycles. A merge does not
/// rewrite user ids stored inside authenticated data (decision and decision-log payloads); a reader follows the
/// stored id through these rows, one merge after another, to the surviving account (src/lib/userMerges.ts). For
/// that reason `targetUserId` is not updated when the target is itself merged later: the chain resolves it.
///
/// Background: #1715, #1641, #1642.
model UserMerge {
  sourceUserId   String   @id @map("source_user_id")
  targetUserId   String   @map("target_user_id")
  mergedAt       DateTime @default(now()) @map("merged_at")
  /// The acting admin at the merge. Null only on historical merge records.
  mergedBy       String?  @map("merged_by")
  /// #1642: sealed dual-login consent evidence; absent only on historical merges.
  consentHash    String?  @unique @map("consent_hash")
  consentReceipt Json?    @map("consent_receipt")

  source User @relation("UserMergeSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  target User @relation("UserMergeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@map("user_merges")
}

/// A request for the consent of both accounts to one merge: this source into this target, in that order, for a
/// full consolidation (`scope`). `mergeUsers` goes ahead only on a request that both accounts approved after a
/// fresh login and that has not expired or been used.
///
/// Relationships: none by foreign key. `sourceUserId`, `targetUserId` and `requestedBy` are user ids stored as
/// sealed snapshots, so a later merge of one of those accounts does not change them. A consumed request leaves its
/// evidence on the UserMerge row (`consentHash`, `consentReceipt`).
///
/// Behaviour: an administrator starts the request (src/lib/userMergeConsent.ts). The server hands back a random
/// proof and stores only its SHA-256 digest (`proofHash`). Each account approves by signing in; the login time and
/// method are recorded per side. The request expires after 15 minutes, is single-use (`consumedAt`), and one
/// requester may hold at most 10 live requests. A sweep deletes a retired request 30 days after the later of its
/// expiry and its consumption.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:api:010:02. Background: #1642, #1770.
model UserMergeConsent {
  id                String    @id @default(cuid())
  proofHash         String    @unique @map("proof_hash")
  sourceUserId      String    @map("source_user_id")
  targetUserId      String    @map("target_user_id")
  requestedBy       String    @map("requested_by")
  scope             String    @default("FULL_CONSOLIDATION")
  createdAt         DateTime  @default(now()) @map("created_at")
  expiresAt         DateTime  @map("expires_at")
  sourceLoginAt     DateTime? @map("source_login_at")
  sourceLoginMethod String?   @map("source_login_method")
  targetLoginAt     DateTime? @map("target_login_at")
  targetLoginMethod String?   @map("target_login_method")
  consumedAt        DateTime? @map("consumed_at")

  @@map("user_merge_consents")
}

/// The kinds of widget that can be placed on a user's /app/dashboard grid
/// (#772). Add a member when a new widget ships; each type has a server-side
/// data provider feeding the combined `dashboardWidgetData` query.
enum DashboardWidgetType {
  MEMORY_STATS
  AGENT_STATS
  USAGE_ACTIVITY
}

/// One widget a user has placed on their portal dashboard (`/app/dashboard`). The rows of one user, ordered by
/// `position`, are that user's dashboard layout.
///
/// Relationships: belongs to one User and is deleted with it. `type` names the kind of widget
/// (DashboardWidgetType); each kind has a server-side data provider behind the `dashboardWidgetData` query. A
/// DashboardWidgetPreset can be copied into `config`, but the widget keeps no link to the preset.
///
/// Behaviour: owner-only; it belongs to no organization and cannot be shared. The whole set is read with
/// `dashboardWidgets` and replaced atomically with `setDashboardWidgets`.
///
/// Background: #772, #788.
model DashboardWidget {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  type      DashboardWidgetType
  /// Columns to span on the 12-col desktop grid (clamped on smaller screens).
  span      Int                 @default(4)
  /// Rows to span on the fixed-height row grid (#788; clamped server-side to 1-4).
  rowSpan   Int                 @default(1) @map("row_span")
  /// Widget-instance settings, shape widget-defined (#788) — e.g. a stats
  /// widget scoped to one org. Stored + round-tripped only; no server-side
  /// behavior until dashboardWidgetData goes per-instance.
  config    Json?
  /// 0-based sort order among the user's widgets.
  position  Int                 @default(0)
  createdAt DateTime            @default(now()) @map("created_at")
  createdBy String?             @map("created_by")
  updatedAt DateTime            @updatedAt @map("updated_at")
  updatedBy String?             @map("updated_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@map("dashboard_widgets")
}

/// A named widget configuration a user has saved, to apply to dashboard widgets later. It is a palette entry, not
/// a placement: it does not appear on the dashboard by itself.
///
/// Relationships: belongs to one User and is deleted with it. The name is unique per user and widget type. It is
/// generic over DashboardWidgetType, so any configurable widget kind can have presets.
///
/// Behaviour: the portal copies the preset's `config` into a DashboardWidget's `config` when the user applies it.
/// The copy is not a live link: editing a preset does not change widgets already made from it, and deleting a
/// preset leaves them as they are. Owner-only, like DashboardWidget: no organization, no sharing.
///
/// Background: #806.
model DashboardWidgetPreset {
  id     String              @id @default(cuid())
  userId String              @map("user_id")
  type   DashboardWidgetType
  /// Display name, unique per (user, type). Trimmed, 1-60 chars.
  name   String
  /// The saved settings, shape widget-defined — same 4KB cap and plain-object
  /// guard as a placement's `config`, since it becomes one verbatim.
  config Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, name])
  @@index([userId, type])
  @@map("dashboard_widget_presets")
}

/// A company, team or other group that owns resources on this server and has members. Its `urn` is its domain
/// name (for example "example.com") and is the first part of the URN of everything it owns.
///
/// Relationships:
/// - Members: Users through OrgMember. An organization must keep at least one member with the role OWNER.
/// - Owned resources: Memories, Agents and Apps, plus the organization-level configuration that hangs off them
///   (AiServiceConfig, McpServer, HomeAssistantInstance, ResendSender, the mail, calendar, drive and Slack
///   connections, Scopes, RegisterEntries, MemoryConfigTemplates).
/// - Other organizations' resources: MemorySubscription (a memory another organization owns) and AgentOrgGrant
///   (an Agent another organization owns).
/// - Principal: `principalId` points at the row that reserves the organization's name in the namespace it shares
///   with user handles.
/// - Billing: UsageEvent and CreditLedgerEntry rows are attributed to the organization.
///
/// Behaviour: `policy` is the organization's layer of the action-policy chain, an allow-list that is copied into
/// each run when the run is created, so an edit applies to later runs only. The GitHub App fields let the server
/// mint short-lived tokens to sync the organization's Git-backed memories; the private key is stored encrypted.
/// `listedOnMarketplace` controls advertisement: a listed organization can be discovered by non-members, who see
/// its sanitized public view (src/lib/orgDiscoverability.ts). It gives no access to what the organization holds.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:040:02.
model Organization {
  id                           String    @id @default(cuid())
  name                         String
  /// The organization's domain name, e.g. "baragaun.com",
  /// "micromentor.org". Serves as the namespace for all resources
  /// owned by this org (URN prefix).
  urn                          String    @unique
  /// Opt-in marketplace catalogue flag (hrn:node:hadronmemory.com:specs:cor:acl:080:04): whether this org is
  /// advertised in the marketplace browse. DISTINCT from access/visibility —
  /// it governs advertisement, not who may read the org. Contributes to
  /// non-member discoverability (hrn:node:hadronmemory.com:specs:cor:acl:080:02). (Spec 048 dropped the former
  /// `isVisible` listing flag with the auto-personal org — every org now lists.)
  listedOnMarketplace          Boolean   @default(false) @map("listed_on_marketplace")
  /// GitHub App installation id. Used to mint ephemeral tokens
  /// (1-hour expiry) for memory git-sync against repos within this
  /// installation's scope.
  githubInstallationId         Int?      @unique @map("github_installation_id")
  githubAppId                  String?   @map("github_app_id")
  /// AES-256-GCM-encrypted GitHub App private key. Plaintext never
  /// stored or shown after initial entry. Encryption key:
  /// HADRON_ENCRYPTION_KEY env var.
  githubAppPrivateKeyEncrypted String?   @map("github_app_private_key_encrypted")
  createdAt                    DateTime  @default(now()) @map("created_at")
  createdBy                    String?   @map("created_by")
  updatedAt                    DateTime  @updatedAt @map("updated_at")
  updatedBy                    String?   @map("updated_by")
  deletedAt                    DateTime? @map("deleted_at")
  deletedBy                    String?   @map("deleted_by")

  members         OrgMember[]
  memories        Memory[]
  agents          Agent[]
  subscriptions   MemorySubscription[]
  principalGrants PrincipalGrant[]
  /// Org-layer action-policy link of the conjunctive chain (hrn:node:hadronmemory.com:specs:cor:acl:040:02):
  /// allow-list JSON `{ "allow": ["action", "prefix.*", "*"] }`. NULL = no
  /// restriction (the layer is absent, not deny-all). Snapshotted into
  /// AppRun.policy at mint — edits apply to FUTURE runs only.
  policy          Json?
  /// #2973 PR1 / hrn:node:hadronmemory.com:specs:cor:agt:040:09 — the organisation's boot-prompt signing
  /// switch: when true, a compiled boot prompt served in this organisation's
  /// Apps must be signed. DEFAULT false and NO control API in PR1, so no
  /// organisation can be switched on and the serve check is inert through it;
  /// PR2 adds the audience-gated switch (G1). The serve reads it only together
  /// with the deployment's signing policy (G2, `signingSurfacePolicy().signing`).
  bootPromptSigningRequired Boolean @default(false) @map("boot_prompt_signing_required")

  invitations            UserInvitation[]        @relation("OrgInvitations")
  exchangeConnections    ExchangeConnection[]
  connectionFlows        ConnectionFlow[]
  slackConnections       SlackConnection[]
  mcpServers             McpServer[]
  homeAssistantInstances HomeAssistantInstance[]
  resendSender           ResendSender?
  // 046-usage-metering: billing back-relations.
  usageEvents            UsageEvent[]
  creditLedgerEntries    CreditLedgerEntry[]
  apps                   App[]
  agentOrgGrants         AgentOrgGrant[]
  aiServiceConfigs       AiServiceConfig[]
  // Admin impersonation (read-only support sessions) scoped to this org.
  impersonationSessions  ImpersonationSession[]
  mcpSessionStates       McpSessionState[]
  scopes                 Scope[]
  registerEntries        RegisterEntry[]
  // #692 — the org's root principal in the unified pool (urn is the denormalized
  // read source-of-truth, kept in sync at mint).
  principalId            String?                 @unique @map("principal_id")
  principal              Principal?              @relation("OrgPrincipal", fields: [principalId], references: [id], onDelete: SetNull)

  memoryConfigTemplates MemoryConfigTemplate[]

  @@map("organizations")
}

/// One reserved root name: a user's handle or an organization's name. The table is the single pool both kinds of
/// name are taken from, so the first part of a URN names exactly one owner without a marker that says which kind
/// it is.
///
/// Relationships: at most one User or one Organization points at a principal (`User.principalId`,
/// `Organization.principalId`). Their own `handle` and `urn` columns remain what reads use; the principal row is
/// written in the same transaction that sets them, so the two stay equal.
///
/// Behaviour: `name` is unique across every status, and across case. The unique index is a plain, case-sensitive
/// one; the CHECK `chk_principals_name_lower` (`name = lower(name)`) refuses any name that is not lower case, so
/// two names that differ only in case can never both be stored. The writers (`mintPrincipal` and the backfills)
/// lower-case the name before they write.
/// A name that is given up is kept as a tombstone (`status = 'released'`, owner
/// detached) and is never handed out again, so an old URN can never come to mean a different owner. Words the
/// platform keeps for itself (for example `hadron`, `platform`) are rows with `status = 'reserved'`.
///
/// Background: #692.
model Principal {
  id         String    @id @default(cuid())
  /// The canonical root name, stored lowercase. `@unique` is a plain (case-
  /// sensitive) index, which is sufficient because the database refuses a name
  /// that is not lower case (CHECK `chk_principals_name_lower`, #4400; in the
  /// migration and prisma/post-push.sql, since Prisma models no CHECK) — so it is
  /// case-insensitive AND index-backed for the `findUnique` availability probe.
  /// Spans ALL statuses (no status filter), so a `released` tombstone reserves
  /// its name forever (indefinite, no recycling).
  name       String    @unique
  /// 'user' | 'org' | 'platform'.
  kind       String
  /// 'active' | 'released' (tombstone) | 'reserved' (platform word).
  status     String    @default("active")
  releasedAt DateTime? @map("released_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user         User?         @relation("UserPrincipal")
  organization Organization? @relation("OrgPrincipal")

  @@map("principals")
}

/// The membership of one User in one Organization, with the role the user has there. This row is what makes a
/// person a member of an organization; organization-level access checks read it.
///
/// Relationships: joins User and Organization, one row per pair. OrgMemberInvitation rows name the member that
/// sent them (`sentMemberInvitations`).
///
/// Behaviour: `role` is the member's role in the organization (OWNER > ADMIN > CONTRIBUTOR > READER). Removing a
/// user from an organization soft-deletes this row (`deletedAt`), and such a row authorizes nothing. The last
/// member with the role OWNER cannot be removed; the resolver enforces that, not the schema. `canInvite` allows
/// inviting existing platform users into the organization; inviting a new platform user is governed by
/// `User.maxReferrals` instead.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:040:03.
model OrgMember {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  role           Role      @default(READER)
  /// Whether this member can invite other existing platform users to
  /// the organization. Inviting a *new* platform user (UserInvitation)
  /// is governed separately by User.maxReferrals.
  canInvite      Boolean   @default(false) @map("can_invite")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentMemberInvitations OrgMemberInvitation[] @relation("SentByMember")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("org_members")
}

/// A knowledge graph: a named container of Nodes and the Edges between them, with its own URN, owner, access
/// rules and settings. Everything an agent or a person stores in Hadron is stored in a memory.
///
/// Ownership: exactly one of `organizationId` and `ownerUserId` is set (`chk_memory_owner_xor`), so a memory
/// belongs to an organization or directly to a user.
///
/// Class: `class` decides how the memory is addressed and who may read and write it (see the MemoryClass enum):
/// `system` (an Agent's definition, or an App's install memory that customises an Agent), `app` (what an App
/// writes through an Agent), `knowledge` (reference content), `group` (shared by its MemoryMembers), `personal`
/// and `private` (owned by one user, `userId`). The columns `appId`, `userId`, `userMemoryOfAgentId`,
/// `sharedMemoryOfAgentId`, `installOfAgentId` and `isInstallMemory` say which App, user and Agent the memory
/// belongs to; database CHECK constraints tie each of them to the class.
///
/// Relationships:
/// - Content: Nodes, Edges, Assets, NodeEmbeddings.
/// - Access: MemoryShare (a personal memory shared with another user), MemoryMember (members of a group memory),
///   MemorySubscription and MemoryLicense (another organization's access), AgentMemoryItem (an Agent's access),
///   AppMemoryWriteGrant and AppAutomationReadGrant (an App's runs).
/// - Configuration: MemoryConfig (the memory's rulebook, created on the first rule write) and
///   MemoryConfigDefaultSkip.
/// - Use: Sessions that write to it, the Worker whose working memory it is, Channels, Scopes it is part of.
/// - Records: MemoryLogEntry, GitMirrorObligation.
///
/// Git-backed memories: when `source` is set the memory is synced from a Git repository. Only a memory owned by
/// an organization is synced; a user-owned memory is refused (src/integrations/github/syncGraphFromGithub.ts).
/// The root `node.yaml` of the repository is the memory manifest: it declares the memory's URN and marketplace
/// metadata, and an import
/// creates or updates this row from it. The organization part of the URN must match an Organization that exists
/// on the server.
/// To read the repository the server first uses the owning organization's GitHub App installation to mint a token
/// that lasts one hour. For a repository outside that installation (another GitHub organization, a personal
/// repository, another Git host) it uses `sourceTokenEncrypted`. Two different keys are involved, and neither is
/// on this row: the private key of the platform's own GitHub App is in the server's environment and never in the
/// database, and an organization that uses a GitHub App of its own stores that App's key, encrypted, in
/// `Organization.githubAppPrivateKeyEncrypted`.
///
/// Token encryption: `sourceTokenEncrypted` is encrypted with AES-256-GCM under the server's
/// `HADRON_ENCRYPTION_KEY`. The plaintext is never stored or shown again after it is entered; to replace an
/// expired or revoked token the user enters a new one. Rotating the server key means re-encrypting every stored
/// token in one migration.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:060:01.
model Memory {
  id                    String  @id @default(cuid())
  organizationId        String? @map("organization_id")
  /// The user TENANT owner of a user-owned Memory (rooted on the bare
  /// `<handle>` — #697 v2, no `@` sigil). DISTINCT from `userId` (the
  /// personal/private strict-owner). The exactly-one-of
  /// `organizationId`/`ownerUserId` XOR is ENFORCED — `chk_memory_owner_xor` in
  /// post-push.sql: `(organization_id IS NULL) <> (owner_user_id IS NULL)` — so
  /// exactly one is non-null (the URN backfill dispatches owner KIND off it;
  /// don't add a redundant ambiguity branch).
  ownerUserId           String? @map("owner_user_id")
  ownerUser             User?   @relation("MemoryTenantOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  // 008-agent-installation (2026-05-02), relaxed by 034-memory-class-access and
  // #653: App pivot. Required for class='app'; OPTIONAL for knowledge/group/
  // personal/private (set when app-scoped, NULL when free-standing); forbidden
  // for class='system'. Enforced by the chk_memory_class_app_id CHECK constraint.
  /// The App this memory belongs to. Required when `class` is `app`; optional
  /// for `knowledge`/`group`/`personal`/`private` (set when app-scoped, NULL
  /// when free-standing); NULL for `system`. Enforced by chk_memory_class_app_id
  /// (#653 allowed knowledge + group to attach to an App).
  appId                 String? @map("app_id")
  // 005-agent-subscription (2026-04-30), re-keyed onto class by 034: explicit
  // User owner for personal/private-class memories. NULL otherwise. Postgres
  // CHECK enforces: class IN ('personal','private') ⇔ userId IS NOT NULL.
  /// Owning user for personal/private-class memories. Bidirectional invariant
  /// (CHECK chk_personal_visibility_user): `class IN ('personal','private')`
  /// ⇔ `userId IS NOT NULL`.
  userId                String? @map("user_id")
  /// Agent pivot used by live access-control and memory classification.
  /// With a calling App, legacy personal/private rows with appId NULL require
  /// this Agent installed; agent-scoped AgentSubscription checks use this Agent too.
  /// Marks per-user/session/anonymous holdings for exclusion from shared App/team
  /// memory folds. Free-standing personal/private memories leave this and appId NULL.
  userMemoryOfAgentId   String? @map("user_memory_of_agent_id")
  /// #723 — the IDENTITY of an App's `shared` app-class memory: the Agent whose
  /// shared space this is, under `appId`. Set ONLY on that runtime memory (NULL
  /// on every other row, including the name-addressable `createMemoryInApp`
  /// app-class memories), so `@@unique([appId, sharedMemoryOfAgentId])` is the
  /// find-or-create key for `findOrCreateAppClassMemory` — Postgres treats NULLs
  /// as distinct, so unset rows are unconstrained. Before #723 that identity was
  /// the URN STRING (`<app-urn>:<agent-slug>:shared`), which forced the row to
  /// keep a compound v1 URN (node URNs inside it could not round-trip through
  /// `splitNodeUrn`, so portal links to them 404'd) and silently orphaned the
  /// memory when its App was renamed. Enforced by chk_memory_shared_agent_scope
  /// (set ⇒ `class='app'` AND `app_id IS NOT NULL`).
  sharedMemoryOfAgentId String? @map("shared_memory_of_agent_id")
  /// #2044 (S7) — the IDENTITY of an App's INSTALL MEMORY: the Agent this
  /// `class='system'` row customises for `appId` (hrn:node:hadronmemory.com:specs:cor:agt:040:06). Set ONLY
  /// there; NULL on every other row, including an Agent's own system memory
  /// (which is `app_id IS NULL` and is reached through `Agent.systemMemoryId`,
  /// a pointer an install memory never has). Identity is by COLUMNS, never by
  /// URN, so a renamed App or Agent cannot orphan it. One LIVE row per
  /// (app_id, install_of_agent_id): the partial unique index lives in
  /// prisma/post-push.sql (Prisma cannot model the WHERE). Enforced by
  /// chk_memory_class_app_id (system ⇒ both set or both NULL).
  installOfAgentId      String? @map("install_of_agent_id")


  /// R94 C (#2064): TRUE for an App's install memory, for its whole life. The
  /// link to the Agent above is NULLed when the Agent is erased with its
  /// owner's account (the memory stays with its App, a detached install), so
  /// the discriminator every gate branches on cannot be that link. Enforced by
  /// chk_memory_class_app_id: class='system' with an app_id ⇔ TRUE.
  isInstallMemory       Boolean @default(false) @map("is_install_memory")

  /// Globally unique identifier, e.g. "baragaun.com:secureid".
  /// Derived from `org.urn + ":" + slug`.
  urn                  String            @unique
  /// Human-friendly display name, e.g. "SecureID Service".
  name                 String
  /// One-line summary for marketplace listings and search results.
  shortDescription     String?           @map("short_description")
  /// Full description (markdown); shown when expanding a listing.
  description          String?
  /// Free-form structured metadata for this memory — a client-defined
  /// JSON bag with no server-side semantics. Written via the GraphQL
  /// createMemory / updateMemory mutations; surfaced read-only over MCP
  /// (hadron_list_memories renders it as a `data:` line). The MCP surface has
  /// no memory-mutation tool, so writes stay GraphQL-only. NULL when unset.
  data                 Json?
  /// #725 — opt-in per-memory PROPERTY SCHEMA (structured storage): the
  /// collections (object types) this memory declares and each one's typed
  /// fields. A dedicated column (NOT nested in `data`) so a schema'd memory is
  /// visible at a glance. Shape + well-formedness validated by
  /// src/lib/memorySchema.ts; authored via updateMemory (GraphQL/portal),
  /// read-only over MCP for discovery. NULL ⇒ no schema (unstructured). Node
  /// `properties`/`objectType` are validated against it in the enforcement
  /// phase (a later PR) — free-form until then.
  schema               Json?
  /// #1591 — legacy whole-corpus flag retained for compatibility. Draft rights
  /// now belong to each node and end at its first mint; false does not mean
  /// every node in this memory is minted. Minting still clears this flag.
  corpusDraft          Boolean           @default(false) @map("corpus_draft")
  /// #1591 — legacy record of the latest nonempty mint in this memory and its
  /// actor. Node mint records determine mint state; this stamp confers no
  /// memory-wide removal protection or draft rights.
  corpusMintedAt       DateTime?         @map("corpus_minted_at")
  corpusMintedBy       String?           @map("corpus_minted_by")
  /// Classification tags for search and filtering.
  tags                 String[]
  /// License identifier (e.g. "MIT", "CC-BY-4.0", "proprietary").
  license              String?
  /// Primary category (e.g. "Developer Tools").
  category0            String?           @map("category_0")
  /// Secondary category (e.g. "Backend").
  category1            String?           @map("category_1")
  /// Tertiary category (e.g. "Node.js").
  category2            String?           @map("category_2")
  /// Square icon/logo URL for listings.
  iconUrl              String?           @map("icon_url")
  /// Banner image URL for the detail page.
  heroUrl              String?           @map("hero_url")
  /// External homepage or documentation URL.
  homeUrl              String?           @map("home_url")
  /// Git clone URL; null = DB-only mode (no git backing).
  source               String?
  /// AES-256-GCM-encrypted access token for repos not covered by the
  /// org's GitHub App installation (e.g. personal repos, GitLab,
  /// Bitbucket). Plaintext never stored or displayed after initial entry.
  sourceTokenEncrypted String?           @map("source_token_encrypted")
  /// Expiry of the stored token; server warns via MemoryLogEntry
  /// before expiration.
  sourceTokenExpiresAt DateTime?         @map("source_token_expires_at")
  /// Branch to clone/pull from (default: repo default branch).
  readBranch           String?           @map("read_branch")
  /// #1566: false until one safe sync using the corrected branch commits.
  /// This is conservative for both existing and newly created memories.
  readBranchCorrected  Boolean           @default(false) @map("read_branch_corrected")
  /// Branch for mutations (default: "hadron-updates").
  writeBranch          String?           @map("write_branch")
  /// 035-visibility-enum-cleanup: nullable, no default. Set only for
  /// `knowledge` (PUBLIC/ORGANIZATION) and `group` (GROUP); NULL for
  /// system/app/personal/private (enforced by chk_memory_visibility_class).
  visibility           MemoryVisibility?
  /// Opt-in marketplace catalogue flag (hrn:node:hadronmemory.com:specs:cor:acl:080:04): whether this memory is
  /// advertised in the marketplace browse. DISTINCT from `visibility` — PUBLIC
  /// governs access (reachable by URN), this governs advertisement. "Unlisted
  /// but public" is valid; contributes to the owner org's discoverability
  /// (hrn:node:hadronmemory.com:specs:cor:acl:080:02).
  listedOnMarketplace  Boolean           @default(false) @map("listed_on_marketplace")
  /// Whether the memory's contents (including asset bytes) are
  /// encrypted at rest using AES-256-GCM under HADRON_ENCRYPTION_KEY.
  isEncrypted          Boolean           @default(false) @map("is_encrypted")
  // 005-agent-subscription (2026-04-30): four-way memory typology. Required
  // post-migration; backfilled by the migration's UPDATE statements.
  /// Per-class governance — see MemoryClass enum doc for the four
  /// classes and their addressing rules.
  class                MemoryClass
  /// When an anonymous (pre-account-creation) memory expires and is
  /// reaped by the janitor. NULL for non-anonymous memories.
  anonymousExpiresAt   DateTime?         @map("anonymous_expires_at")
  /// If true, any subscription must have a valid MemoryLicense.
  requiresLicense      Boolean           @default(false) @map("requires_license")
  /// Last successful git sync.
  lastSyncedAt         DateTime?         @map("last_synced_at")
  syncStatus           SyncStatus        @default(PENDING) @map("sync_status")
  /// Error message from the last failed sync.
  syncError            String?           @map("sync_error")
  /// Versioned last completed sync outcome; null after a clean sync (or before any sync).
  lastSyncReport       String?           @map("last_sync_report")
  /// Number of live unresolved PendingEdge records whose live source is in
  /// this memory (a derived projection, denormalized for dashboard display).
  pendingEdgeCount     Int               @default(0) @map("pending_edge_count")
  // 006-asset-upload-redesign (2026-05-01): per-memory upload acceptance
  // flag. Default true at the column level; system-class memories must
  // opt out explicitly at creation time. Migration backfilled existing
  // rows by class (system → false; app/knowledge/personal → true).
  /// Whether this memory accepts asset uploads. system-class memories
  /// typically opt out.
  acceptsUploads       Boolean           @default(true) @map("accepts_uploads")
  // ─── D-2026-08-25-004 / #1180: protected-loc declarations ───
  /// Locs in THIS memory whose subtree only a specific authoring operation may

  // ─── 033-rag-vector-retrieval: per-memory vector-index config ───
  /// Opt-in: when true, this memory's nodes are vector-indexed. DB default is
  /// `false`; the **class-derived default** is applied at createMemory — a
  /// `knowledge`-class, non-encrypted memory is created with `true`, all other
  /// classes and any encrypted memory stay `false` (FR-001). Flippable per memory.
  vectorIndexEnabled Boolean         @default(false) @map("vector_index_enabled")
  /// What the vector index is built from. Memory property, NOT a query
  /// parameter (FR-002). Only meaningful when vectorIndexEnabled.
  embeddingSource    EmbeddingSource @default(abstract) @map("embedding_source")
  /// Per-memory chunking dials (FR-003). NULL ⇒ platform default (512 / 64).
  /// Consulted only when embeddingSource includes chunks.
  chunkTokens        Int?            @map("chunk_tokens")
  chunkOverlap       Int?            @map("chunk_overlap")
  /// Force fixed-size chunking, bypassing structure-aware (FR-015).
  forceFixedSize     Boolean         @default(false) @map("force_fixed_size")
  /// #621 — cap on how many NodeRevision rows are kept per node in this
  /// memory. On each new revision the oldest overflow is pruned. Must be >= 1
  /// (chk_memory_max_rev_count_positive); default 10.
  maxRevCount        Int             @default(10) @map("max_rev_count")
  /// Spec 041 (D-2026-07-06-B) — passphrase-derivation material for a
  /// caller-held-key encrypted memory. Parameters, NOT secrets: salt
  /// (base64) + scrypt params. NULL when the memory was encrypted with a
  /// raw data key (no passphrase) or is not encrypted.
  kdfSalt            String?         @map("kdf_salt")
  kdfParams          Json?           @map("kdf_params")
  /// enc:v1 encryption of a fixed check string under the data key — lets
  /// every unlock verify the supplied key WITHOUT touching node rows
  /// (wrong passphrase = typed WRONG_KEY, never garbage plaintext). The
  /// server still never holds the key itself.
  keyVerifier        String?         @map("key_verifier")

  /// Timestamp the owner acknowledged the embedding-inversion disclosure for an
  /// ENCRYPTED memory (FR-026). NULL ⇒ not acknowledged. Gates encrypted-memory
  /// indexing via chk_memory_vector_encrypted_ack.
  vectorIndexEncryptedAckAt DateTime? @map("vector_index_encrypted_ack_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  createdBy                 String?   @map("created_by")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  updatedBy                 String?   @map("updated_by")
  deletedAt                 DateTime? @map("deleted_at")
  deletedBy                 String?   @map("deleted_by")

  organization             Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodes                    Node[]
  edges                    Edge[] // first-class edges, scoped via denormalized memoryId
  embeddings               NodeEmbedding[] // 033: per-memory vectors (denormalized memoryId)
  assets                   Asset[]
  subscriptions            MemorySubscription[]
  agentItems               AgentMemoryItem[]
  licenses                 MemoryLicense[]
  /// Online URN-shape migration gate (spec 021 FR-032, repurposed for the #697
  /// v1→v2 emission flip). Null = pre-normalization row; set = row normalized
  /// onto the flat v2 form (`<root>:<slug>`, single colon). Transient.
  /// TODO(spec-021-cleanup): drop once the FR-032 migration completes.
  urnNormalizedAt          DateTime?            @map("urn_normalized_at")
  /// Spec 021 sentinel for data-defect rows during the FR-032 migration.
  /// TODO(spec-021-cleanup): drop alongside urnNormalizedAt.
  urnMigrationFailedReason String?              @map("urn_migration_failed_reason")
  /// #697 stored alias map: the pre-v2 (v1) URN this row was migrated FROM.
  /// Null until the online migration flips `urn` to the flat v2 form; then a
  /// legacy input (wikilink, export, external link) resolves to this row by
  /// matching `legacyUrn`. Indexed, non-unique — resolution disambiguates a
  /// rare collision to the live row, else a typed error. Transient with the
  /// migration; TODO(#697-cleanup): drop once every reference is v2-native.
  legacyUrn                String?              @map("legacy_urn")

  logEntries          MemoryLogEntry[]
  userMemoryOfAgent   Agent?            @relation("UserMemoriesOfAgent", fields: [userMemoryOfAgentId], references: [id], onDelete: SetNull)
  // #723: SetNull mirrors userMemoryOfAgent — a hard-deleted Agent leaves the
  // shared memory's content intact (orphan retention, cor:dmo:050:03); the row
  // simply stops being the find-or-create target for that pairing. Restrict was
  // considered and rejected: `deleteAgent` is a SOFT delete, so the only hard
  // deletes are user-account deletion and the create-persona compensation, and
  // blocking those on a memory FK trades a rare orphan for a stuck account
  // deletion. A nulled row can in principle be re-adopted by a replacement Agent
  // that reuses the slug in the same App — but only while it still carries the
  // pre-#723 compound urn (a post-#723 row's flat `<app>-shared` never matches
  // the legacy key), and user-account deletion cascades the App's memories away
  // in the same pass, so the window is narrow and self-closing.
  sharedMemoryOfAgent Agent?            @relation("SharedMemoriesOfAgent", fields: [sharedMemoryOfAgentId], references: [id], onDelete: SetNull)
  // #2044 / R94 C: SetNull. Org Agents are soft-deleted, so this fires only for
  // user-account deletion: another App's install memory of the erased Agent is
  // KEPT and detached (never erased, never blocking the erasure). It stays an
  // install memory through `isInstallMemory`, not through this link.
  installOfAgent      Agent?            @relation("InstallMemoriesOfAgent", fields: [installOfAgentId], references: [id], onDelete: SetNull)
  user                User?             @relation("UserMemoriesOwned", fields: [userId], references: [id], onDelete: SetNull)
  // 008-agent-installation: hard App deletion cascades to its personal/app
  // memories (per data-model.md "Cascade behavior"). The CHECK constraint
  // prohibits app_id IS NULL for class IN ('app', 'personal'), so SET NULL
  // would leave the row in an invalid state on delete. AppMember removal
  // (orphan retention per FR-015) is independent — that's a row delete in
  // app_members, not in apps.
  app                 App?              @relation("AppMemories", fields: [appId], references: [id], onDelete: Cascade)
  sessions            Session[]         @relation("SessionMemory")
  mcpSessionStates    McpSessionState[]
  scopeMemberships    ScopeMemory[]
  channels            Channel[]
  /// #974 — the Workers whose casting-scoped working memory this is (at most
  /// one in practice; identity lives on `Worker.memoryId`, hrn:node:hadronmemory.com:specs:cor:dmo:050:11).
  workerOf            Worker[]          @relation("WorkerMemory")
  // 023-app-shape: per-Memory authorization primitives.
  // `shares`      — populated only when `class = 'personal'` (FR-018);
  //                 cross-user grants (asymmetric).
  // `memberships` — populated only when `class = 'group'` (FR-027);
  //                 symmetric team membership.
  shares              MemoryShare[]
  memberships         MemoryMember[]
  /// #1325 — this memory's rulebook, at most one row. ABSENT reads as the
  /// empty config: it is materialized on the first rule write, never at memory
  /// creation (there is no shared creation helper to hang that on —
  /// hadron-server findings:memory-creation-has-no-shared-helper).
  config              MemoryConfig?
  defaultSkips        MemoryConfigDefaultSkip[]
  /// #2484 — Apps holding a prefix-scoped write grant on this memory for their userless runs.
  appWriteGrants      AppMemoryWriteGrant[]
  /// #2883 — automation read grants on this memory.
  automationReadGrants AppAutomationReadGrant[]
  gitMirrorObligations GitMirrorObligation[]

  // #723: ONE shared app-class memory per (App, Agent) — the find-or-create key
  // that replaced the deterministic `…:shared` URN. Spans soft-deleted rows (the
  // provisioner RESTORES a tombstoned row rather than creating a second one),
  // and NULL `sharedMemoryOfAgentId` rows are unconstrained (Postgres NULLs are
  // distinct), so it binds only the runtime shared memories.
  @@unique([appId, sharedMemoryOfAgentId])
  @@index([organizationId])
  @@index([userMemoryOfAgentId])
  @@index([anonymousExpiresAt])
  @@index([userId])
  @@index([appId])
  @@index([installOfAgentId])
  @@index([ownerUserId])
  @@index([legacyUrn])
  @@map("memories")
}

/// A file (a document or an image) stored for a Memory. The bytes are in object storage; this row holds the
/// file's metadata, the key of the stored object, and the state of its malware scan.
///
/// Relationships: belongs to one Memory and is deleted with it. `memoryId` is null while the asset is staged:
/// uploaded but not yet attached to a memory. Nodes do not reference assets by foreign key.
///
/// Behaviour:
/// - Scan: an upload starts as PENDING and is downloadable only when CLEAN. A BLOCKED row is kept as a record of
///   the verdict and its bytes are deleted. `scanDueAt` is the queue of the background scan: a due row is scanned
///   again, or has its leftover bytes purged.
/// - Retention: a staged asset that is not attached within 24 hours, and a soft-deleted asset 24 hours after its
///   deletion, are removed by the asset janitor together with their bytes.
/// - Missing bytes: `bytesCheckedAt` is the cursor of the sweep that checks that the object behind a live row
///   still exists.
/// - Public link: `publicLinkEnabled` is the per-asset opt-in for the anonymous link
///   (hrn:node:hadronmemory.com:specs:cor:dmo:060:15). It is stored policy, not proof that the link works: the
///   deployment must also allow it, and the asset must be CLEAN.
/// - URN: computed, not stored: `hrn:asset:<root>:<mem...>:assets:<asset.id>`, built from the holding memory's
///   URN. The GraphQL `Asset.urn` description has the full contract.
///
/// Why a table of its own and not a node type: an asset's columns differ from a node's, uploaded raw material
/// should not grow the node table, and an asset is contained in a memory by a foreign key, not by a graph edge.
///
/// Background (history, not law): the Spec Kit specs 004-asset-upload and 006-asset-upload-redesign. Issues #896
/// (scan), #1140 (missing bytes), #1667 (public link).
///
/// Specs: hrn:node:hadronmemory.com:specs:cor:dmo:060:10, hrn:node:hadronmemory.com:specs:cor:dmo:060:12,
/// hrn:node:hadronmemory.com:specs:cor:dmo:060:13.
model Asset {
  id            String          @id @default(cuid())
  // 006-asset-upload-redesign (2026-05-01): nullable to support staging.
  // An asset with memoryId IS NULL is "staged" — uploaded but not yet
  // attached to a memory. Janitor sweeps staged assets past the 24h TTL.
  /// The Memory this asset belongs to; NULL while the asset is staged
  /// (uploaded but not yet attached). Janitor sweeps staged assets
  /// past the 24h TTL.
  memoryId      String?         @map("memory_id")
  /// Original filename as supplied by the user. Never appears in
  /// `storageKey`.
  filename      String
  /// RFC 6838 type/subtype.
  mimeType      String          @map("mime_type")
  /// Verified at complete-upload time against `HeadObject.contentLength`.
  sizeBytes     Int             @map("size_bytes")
  // Object-store key. Encrypted at rest (AES-256-GCM under
  // HADRON_ENCRYPTION_KEY) when the memory is encrypted; plaintext
  // otherwise. See src/lib/asset/encryption.ts.
  /// Object-store key shape: `{orgUrn}/{memoryUrn-segment}/{assetId}.{ext}`.
  /// Encrypted at rest when the memory is encrypted; plaintext otherwise.
  storageKey    String          @unique @map("storage_key")
  /// Virus scan state. Downloads gated on CLEAN.
  scanStatus    AssetScanStatus @default(PENDING) @map("scan_status")
  /// Engine signature name recorded when the scan verdict was BLOCKED
  /// (e.g. "Eicar-Signature"). A BLOCKED row is kept as an audit
  /// tombstone; its object bytes are deleted (#896).
  scanSignature String?         @map("scan_signature")
  /// Number of scan attempts so far (inline at complete-upload plus
  /// sweep retries). Drives the retry sweep's exponential backoff.
  scanAttempts  Int             @default(0) @map("scan_attempts")
  /// When the last scan attempt ran (whether or not it produced a
  /// verdict). NULL = never attempted. Informational; the sweep
  /// selects on `scan_due_at`, not this.
  scannedAt     DateTime?       @map("scanned_at")
  /// When the next background scan action is due (the #882
  /// embedding-queue pattern: a future-dated stamp IS the queue).
  /// PENDING rows: next scan retry. BLOCKED rows: next purge retry
  /// for object bytes that survived a failed delete. NULL = nothing
  /// pending (CLEAN, or BLOCKED with bytes confirmed gone). Every
  /// sweep touch pushes it forward, so no row can monopolize a batch.
  scanDueAt     DateTime?       @map("scan_due_at")
  /// When the bytes-missing row sweep (#1140) last examined this row.
  /// NULL = never. It is the sweep's persisted cursor (least-recently
  /// examined first, NULLs first), so a restart resumes instead of
  /// re-walking the same head of the table. A deferral (encrypted memory
  /// with no cached session key) stamps it too, so such a row rotates
  /// behind other work; a failed store lookup does NOT.
  bytesCheckedAt DateTime?      @map("bytes_checked_at")
  /// Optional; agent- or user-provided.
  description   String?
  uploadedAt    DateTime        @default(now()) @map("uploaded_at")
  /// fk to User.id — who uploaded. NULL when the asset was created
  /// server-side by an app run with no on-behalf-of user
  /// (hadron_store_file); the run id is recorded on the asset's
  /// reference node and in the audit log.
  uploadedBy    String?         @map("uploaded_by")
  /// Soft-delete marker. Janitor sweeps R2 object + hard-deletes
  /// after 24h.
  deletedAt     DateTime?       @map("deleted_at")
  /// #1667, hrn:node:hadronmemory.com:specs:cor:dmo:060:15 — the per-asset public-link opt-in. STORED POLICY, not
  /// proof of publication: the anonymous hotlink also needs the deployment gate
  /// and the existing eligibility checks. Every asset starts OFF.
  publicLinkEnabled Boolean     @default(false) @map("public_link_enabled")

  memory Memory? @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId, scanStatus, uploadedAt(sort: Desc)])
  // #896 — the scan sweep's selector (due rows, oldest due first).
  @@index([scanDueAt])
  // #1140 — the bytes-missing row sweep's cursor (least-recently examined first).
  @@index([bytesCheckedAt])
  // 006-asset-upload-redesign: two partial indexes for staged assets
  // (WHERE memory_id IS NULL) live in the migration SQL only — Prisma
  // schema syntax can't express WHERE clauses on @@index. See
  // prisma/migrations/20260501000000_memory_uploads_and_staged_assets/migration.sql:
  //   - assets_uploaded_by_staged_idx (per-user staged listing)
  //   - assets_staged_uploaded_at_idx (janitor TTL sweep)
  @@map("assets")
}

/// #1326 — how the server attributed the current content. NULL on legacy or
/// as-yet-unstamped writes; callers cannot choose this through NodeInput.
enum NodeAuthorshipKind {
  TASK
  HUMAN
}

/// #1326 — a content-validation result is advisory, never a write gate.
enum NodeContentValidationOutcome {
  PASS
  FAIL
  ERROR
}

/// #1332 (hrn:node:hadronmemory.com:specs:cor:dmo:160:01) — whether a content-validation report's author check
/// compared R's recorded author with the reporter. CHECKED means compared and
/// different, never "independent". NULL only on a report written before #1332.
enum NodeContentValidationAuthorCheck {
  CHECKED
  AUTHOR_UNKNOWN
}

/// #1332 (hrn:node:hadronmemory.com:specs:cor:dmo:160:01 refusal 5) — the kind of server-derived reporter, the
/// first that applies: a headless run, a worker session, a person acting
/// directly (any credential, by user id), an App key with no user or worker.
enum NodeContentValidationReporterKind {
  RUN
  WORKER
  PERSON
  APP_KEY
}

/// One node of a Memory's knowledge graph: a titled piece of content at an address. Nodes are what agents and
/// people read, write and search; almost everything stored in a memory is a node.
///
/// Address: `loc` is the node's colon-delimited path inside its memory (for example `auth:tokens`), unique per
/// memory. The node's URN is computed from the memory's URN and the `loc`; it is not stored. `id` stays the same
/// when the node moves. An imported `node.yaml` may give the `id`; the server assigns one when it does not.
///
/// Relationships:
/// - Memory: belongs to one Memory and is deleted with it.
/// - Graph: Edges leave and enter it (`outgoingEdges`, `incomingEdges`); a PendingEdge waits for a target that
///   does not exist yet.
/// - History: NodeRevision holds earlier states, NodeEdgeRemoval the edges removed with them,
///   CompiledPromptRevision the provenance of a compiled prompt.
/// - Review: NodeSignature and SigningRequest (signatures), NodeContentValidationReport (validation results),
///   CommentMeta (the node is a comment, or has comments).
/// - Search: NodeEmbedding rows hold its vectors.
/// - Other roles: the chat root of a Channel; the tasks or processes index of an Agent; the author task,
///   validation task or description of a NodeRoleRule.
///
/// Three fields say what kind of node it is, and they are independent:
/// - `nodeType` is the platform's kind. It is a free string, not an enum and not constrained in the database, so
///   that third-party agents and Apps can add their own values; the platform gives no special treatment to values
///   it does not know. The canonical values for ordinary nodes:
///   - `abstract`: agent-generated summaries (chat summaries, topic abstracts); retrieval flows search them first.
///   - `chat`: chat sessions and messages.
///   - `data`: the structured payload is the artifact; there is no human-written body.
///   - `info` (the default): reference content such as articles, guides and extracted facts.
///   - `prompt`: system prompt content for an LLM call.
///   - `record`: stored data that is mostly appended to, such as user profiles and event logs.
///   - `reference`: pointers to external sources or to other memories, such as papers, URLs and asset references.
///   - `system`: an agent's internal configuration, such as conversation designs, stages and topics; usually in
///     an Agent's system memory and hidden from end-user search.
///   `comment` is reserved by the platform for governed feedback (see CommentMeta). The platform also uses
///   further values of its own, for example `task` and `compiled-boot-prompt`.
/// - `objectType` names the collection the node is an instance of, in a memory that declares a schema.
/// - `role` says what the node is for. It is an open string; a small closed subset of its values routes writes
///   to that kind's own path. No platform behaviour depends on any other value, apart from the role rules a
///   memory declares for itself (NodeRoleRule).
///
/// Behaviour:
/// - Content: `name`, `abstract` and `content` are the text. `abstractOriginHash` records which content the
///   abstract was written for, so a reader can tell a stale abstract.
/// - Revisions: `revSeq` is the current revision number. A revisioned edit saves the state before the edit as a
///   NodeRevision and advances the number.
/// - Approval and minting: the `approved*` columns hold the latest approval and the `minted*` columns the mint,
///   both on the live row because the current revision has no NodeRevision row.
/// - Attribution: the `authored*` and `createdBy*`/`updatedBy*` columns are set by the server from the
///   authenticated request, never by the caller.
/// - Embedding: the `embedding*` columns are the work queue and the failure record of the vector index.
/// - Chat roots: a chat-root node (`chats:<id>`, `nodeType` `record`) carries `data.scope` (`private` or `shared`),
///   set when the chat is created and never changed. It repeats the class of the holding memory and must stay
///   consistent with it (src/api/graphql/schema/chat-scope.ts).
///
/// Specs: hrn:node:hadronmemory.com:specs:cor:dmo:060:02, hrn:node:hadronmemory.com:specs:cor:dmo:020:04.
model Node {
  chatRootCounter ChatRootCounter?
  chatRootEngineState ChatRootEngineState?
  /// UUIDv7 from `node.yaml` when supplied by the importer (stable across
  /// moves); falls back to `cuid()` for inserts that omit `id`.
  id                  String              @id @default(cuid())
  memoryId            String              @map("memory_id")
  /// See the node-types list in the model doc. Default `info`.
  nodeType            String              @default("info") @map("node_type")
  /// #725 — collection discriminator (the MongoDB-collection equivalent): which
  /// domain object this node is an instance of, e.g. "competitor" / "insight".
  /// Orthogonal to `nodeType` (the platform-kind axis). NULL for an ordinary
  /// node. When set on a schema-governed memory it must name a declared object
  /// type (enforced at write time — a later phase); free-form until then.
  objectType          String?             @map("object_type")
  /// Human-friendly display name of this node.
  name                String
  /// Alternative name.
  alias               String?
  /// Colon-delimited path within the memory (e.g. "auth:tokens").
  loc                 String
  isLink              Boolean             @default(false) @map("is_link")
  /// #1450 — a RESERVED spec citation with no spec written yet (a placeholder
  /// in a draft corpus; see src/lib/specCorpus.ts). Set only by the server's
  /// `reserveSpecCitation`, never by a client write, and never inferred from an
  /// empty body. Writing real content clears it; the node keeps its citation.
  /// Minting refuses while any remain, so a minted corpus has none.
  isPlaceholder       Boolean             @default(false) @map("is_placeholder")
  description         String?
  /// Paragraph-length summary of this node. Cap is 2000 characters,
  /// enforced at the API boundary (not as a DB CHECK — caps are
  /// validation, not invariants). Surfacing rules across MCP tools
  /// (find/read/list/validate), the `Source: abstract-fallback` marker
  /// on `hadron_get_node` content-scope fallback, and the RAG-substrate
  /// motivation are documented in spec 031 (FR-005 + edge cases). That
  /// is the load-bearing reference; this comment is the cold-read
  /// pointer for someone scanning the schema.
  abstract            String?
  /// The topic content (topic.md full text).
  content             String?
  /// SHA256(yaml+md)[0:8] for change detection. Set by external
  /// producers (YAML frontmatter via importer, Git sync). UNCHANGED by
  /// spec 032 — that spec adds `abstractOriginHash` below as a separate
  /// column with its own domain (SHA256(content)[0:8]); the two are
  /// never compared against each other.
  contentHash         String?             @map("content_hash")
  /// Spec 032 — fingerprint of `content` value at the time `abstract`
  /// was authored. SHA-256 of plaintext content truncated to 8 hex
  /// chars (same width as `contentHash`, different domain). At read
  /// time, compared against `computeContentHash(node.content)` to
  /// detect staleness: the abstract may not reflect current content
  /// when the two differ, OR when this is NULL on a node that has
  /// both an abstract and content (#1128 — an abstract written before
  /// the body existed was never fingerprinted, so it has never been
  /// checked against it; that reads as unverified, not as verified).
  /// NULL is a clean state only when the node has no abstract, or no
  /// content for the abstract to describe. Surfaced by
  /// `hadron_get_node`'s `Source: abstract-stale` marker and
  /// `hadron_validate`'s `[stale-abstract]` warning. System-managed:
  /// never settable via GraphQL `NodeInput`.
  ///
  /// Until #1232 this said staleness required the value to be
  /// NON-NULL — the pre-#1128 rule, which #1128 deliberately removed
  /// along with the validator's own `!= null` guard. The published
  /// Data Model reference is generated from this comment, so it
  /// contradicted the GraphQL reference for the whole gap.
  abstractOriginHash  String?             @map("abstract_origin_hash")
  // ─── 033-rag-vector-retrieval: durable embedding-queue markers ───
  /// Set when this node needs (re-)embedding; cleared on success. The single
  /// work signal the embedding worker drains (FR-006/FR-007). Operational
  /// state only — intentionally NOT versioned on NodeRevision.
  embeddingPendingAt DateTime? @map("embedding_pending_at")
  /// internal#4: opaque identity of one durable obligation; time only schedules it.
  /// Operational, never copied into revisions or approval/authorship state.
  embeddingWorkToken String?   @db.Uuid @map("embedding_work_token")
  /// Set when an embed attempt failed (record, not a work signal). Transient
  /// failures keep pending set for retry; permanent failures clear pending (FR-009).
  embeddingFailedAt   DateTime?           @map("embedding_failed_at")
  /// Attempt counter for backoff / give-up. Non-null; reset to 0 on success/revoke.
  embeddingAttempts   Int                 @default(0) @map("embedding_attempts")
  /// Passage chunks omitted by the per-node cap (#887); NULL when not truncated.
  embeddingTruncatedChunks Int? @map("embedding_truncated_chunks")
  /// Last embed error (diagnosability; surfaced by hadron_validate).
  embeddingError      String?             @map("embedding_error")
  /// Number of input tokens.
  tokens              Int?
  /// Classification tags.
  tags                String[]
  /// Typed key-value structured data; queryable via the API.
  properties          Json?
  /// Structured JSON on the node; used for template-variable
  /// resolution, user profiles, extracted facts, reference metadata.
  /// Returned by `hadron_get_node`; written by `hadron_update_node`
  /// (replaces the bag) or `hadron_update_node_data` (shallow merge).
  data                Json?
  /// Sort order among sibling nodes (lower values come first); used
  /// by `hadron_get_next_node` and portal drag-and-drop reordering.
  seq                 Int?
  /// #1430 paged attention: the owning Channel for chat-message transcript
  /// rows — stamped in the append transaction, providing a Channel-local
  /// seq-first access path (see the partial index below).
  messageChannelId    String?             @map("message_channel_id")
  /// GitHub repo slug (e.g. "micromentor/mmdata").
  ownerRepo           String?             @map("owner_repo")
  /// If true, this node can be executed as a task.
  isRunnable          Boolean?            @map("is_runnable")
  /// #1201 — what this node IS TO ITS AUTHOR, as an open string. Set it to
  /// anything; the platform reads a small CLOSED subset and ignores the rest.
  ///
  /// THREE KIND-ISH FIELDS, and the distinction is what readers get wrong:
  ///   - `nodeType`   — the PLATFORM-kind axis (info/task/prompt/…), load-bearing
  ///                    for retrieval and rendering. NOT this field.
  ///   - `objectType` — the COLLECTION discriminator (#725): which domain object
  ///                    this is an instance of, schema-validated. NOT this field.
  ///   - `role`       — what the node is FOR. It does not affect default
  ///                    retrieval/ranking, but callers may filter by role family.
  ///
  /// This is the axis the law corpus already named and the schema never had:
  /// `hrn:node:hadronmemory.com:specs:cor:urn:010:01` lists node TYPES and node ROLES as separate categories,
  /// and the roles (chat, chat-message, config, …) live in `nodeType` today.
  /// Migrating those off `nodeType` is deliberately NOT part of #1201 — live
  /// consumers include `isChecklistItemListing`, the chat surfaces and
  /// `preflight_add --type`.
  ///
  /// GOVERNED values (`src/lib/governedRole.ts`) route a write to that kind's
  /// own door; every other value is inert to the platform, apart from the role rules a memory declares for
  /// itself (NodeRoleRule). Open so an agent builder may use it
  /// freely, closed where it gates so the gate is never caller-defined.
  role                String?
  /// LLM model that created or last modified this node (e.g.
  /// "claude-opus-4-6", "gpt-4o").
  llmModel            String?             @map("llm_model")
  /// AI agent tool that created or last modified this node (e.g.
  /// "claude-code", "cursor", "hadron-portal").
  aiAgent             String?             @map("ai_agent")
  /// #1326 — server-owned attribution for this content state. A task stamp
  /// records the stable task Node.id and its revision when the content was
  /// authored; a HUMAN stamp records the authenticated person, never a task.
  /// NULL kind means unknown/legacy, not a claim of human authorship. No FK:
  /// deleting or moving a task/user must not rewrite historical attribution.
  authorshipKind      NodeAuthorshipKind? @map("authorship_kind")
  authoredByTask      String?             @map("authored_by_task")
  authoredByRevision  Int?                @map("authored_by_revision")
  authoredByHuman     String?             @map("authored_by_human")
  authoredAt          DateTime?           @map("authored_at")
  /// #696/#1323: the live node's current revision. Creation is revision 1.
  /// A revisioned edit snapshots the pre-edit state at this number, then
  /// atomically advances the live row to the next number.
  revSeq              Int                 @default(1) @map("rev_seq")
  /// #1611 (hrn:node:hadronmemory.com:specs:cor:dmo:120:04) — the revision at which the approval-hashed fields
  /// (title, abstract, content under approval-hash v1) last changed through a
  /// SANCTIONED writer; maintained by the `nodes_initialize_revision_content_hash`
  /// trigger on the same 'refresh' marker as `revisionContentHash`. An approval
  /// recorded at `approvedRevNo` is still valid iff `contentRevSeq <= approvedRevNo`:
  /// metadata-only revisions advance `revSeq` but not this. A write outside the
  /// revision system never moves it, so such a change stays TAMPERED.
  contentRevSeq       Int                 @default(1) @map("content_rev_seq")
  /// #1323: host-independent MD5 of the complete at-rest revisioned state.
  /// Internal safeguard only (never an artifact fingerprint): an exposed read
  /// reconciles a mismatch by taking a server-authored revision. Included
  /// partials/template data and operational fields are deliberately outside it.
  revisionContentHash String?             @map("revision_content_hash")
  /// #1591 — the node's LATEST approval, kept here rather than only on a
  /// NodeRevision row because the live revision has no row (rows are pre-edit
  /// snapshots) and rows are prunable and deletable. The current revision is
  /// approved iff `approvedRevNo >= contentRevSeq` (#1611); a lower number
  /// means its content changed since. `approvedBy` is a User.id when one is known, with no FK so a
  /// user deletion cannot rewrite who approved; otherwise `approvedByInfo`
  /// holds the principal (the NodeRevision.editedByInfo convention).
  /// `approvalHash` is the full SHA-256 of approval hash v1
  /// (src/lib/approvalHash.ts) at approval time. All five are set together or
  /// not at all (chk_node_approval_complete), except that `approvalHash` alone is
  /// cleared when the node enters an encrypted memory (#1838): who, when and which
  /// revision stay, and a hashless approval covers nothing.
  approvedRevNo       Int?                @map("approved_rev_no")
  approvedBy          String?             @map("approved_by")
  approvedByInfo      String?             @map("approved_by_info")
  approvedAt          DateTime?           @map("approved_at")
  approvalHash        String?             @map("approval_hash")
  /// #1591 — per-node minting. A node is minted iff `mintedAt` is set; a new
  /// node starts unminted, with draft rights (renumber, move without an alias,
  /// bulk replace). Minting stamps every unminted live node of a memory at once
  /// (`mintMemoryNodes`), after its checks, including an approved current
  /// revision. `mintedRevNo` / `mintedHash` record that revision and its
  /// approval hash; both are null for nodes backfilled as minted by the #1591
  /// migration, whose minted revision is unknown. `mintedBy` is a User.id (no
  /// FK, like `approvedBy`), else `mintedByInfo` holds the principal
  /// ("backfill" for the migration). Minting protects nothing by itself
  /// (Holger, 2026-10-01: no minted-spec permanence for now).
  /// chk_node_mint_complete.
  mintedAt            DateTime?           @map("minted_at")
  mintedBy            String?             @map("minted_by")
  mintedByInfo        String?             @map("minted_by_info")
  mintedRevNo         Int?                @map("minted_rev_no")
  mintedHash          String?             @map("minted_hash")
  /// #1632 / hrn:node:hadronmemory.com:specs:cor:dmo:130:04 — when the node's title, abstract or content last
  /// changed, from the DB clock. Set only by the signing trigger
  /// (prisma/signing-invariants.sql), never by application code, and never
  /// decreases. A signature verified at or before this time reads EARLIER, so
  /// restoring earlier text never revives it (#9824). Null = unchanged since
  /// creation. A timestamp rather than a revision number, so pruning, history
  /// clears and revSeq reconciliation cannot move it.
  contentChangedAt    DateTime?           @map("content_changed_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  createdBy           String?             @map("created_by")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  updatedBy           String?             @map("updated_by")
  deletedAt           DateTime?           @map("deleted_at")
  deletedBy           String?             @map("deleted_by")
  /// #1610 — the Worker / Agent behind the write, beside the user in
  /// createdBy / updatedBy. Server-derived from the request's validated
  /// session binding or App run (src/lib/requestActor.ts), never
  /// client-supplied; stamped centrally on creates and authored-field
  /// updates (src/integrations/db/client.ts). The updatedBy* pair describes
  /// the LAST authored edit, so an edit with no agent behind it clears it.
  /// No FK, like the audit stamps (hrn:node:hadronmemory.com:specs:cor:dmo:010:01).
  createdByWorkerId   String?             @map("created_by_worker_id")
  createdByAgentId    String?             @map("created_by_agent_id")
  updatedByWorkerId   String?             @map("updated_by_worker_id")
  updatedByAgentId    String?             @map("updated_by_agent_id")
  /// #2176 — the User behind the last authored edit, beside the Worker / Agent
  /// above and stamped with them in one place (src/integrations/db/client.ts).
  /// It is exactly what NodeRevision.editedBy records for the same edit
  /// (`editorFromAuth`): the request's validated `auth.userId`, from the
  /// RequestActor holder, never a clientId or a credential holder. An authored
  /// edit with no user behind it clears it. Null = unknown (nodes edited before
  /// #2176 are not backfilled). No FK, like the audit stamps (hrn:node:hadronmemory.com:specs:cor:dmo:010:01).
  updatedByUserId     String?             @map("updated_by_user_id")

  memory                   Memory                        @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  includeReferences        IncludeReference[]
  includeSourceCoverage    IncludeSourceCoverage?
  outgoingEdges            Edge[]                        @relation("SourceNode")
  incomingEdges            Edge[]                        @relation("TargetNode")
  pendingEdges             PendingEdge[]
  usageEvents              UsageEvent[]
  revisions                NodeRevision[]
  edgeRemovals             NodeEdgeRemoval[]
  /// #2046 (S9): the immutable provenance of each compiled revision of this node.
  compiledPromptRevisions  CompiledPromptRevision[]
  /// #1606 — present iff `nodeType = 'comment'` (deferred DB trigger).
  commentMeta              CommentMeta?                  @relation("CommentMetaNode")
  /// #1606 — the comments (top-level and replies) whose target is this node.
  commentsOn               CommentMeta[]                 @relation("CommentMetaTarget")
  contentValidationReports NodeContentValidationReport[]
  /// Spec 049 Phase 4: the Channel whose chat root this node is, if any.
  channel                  Channel?                      @relation("ChannelRoot")
  embeddings               NodeEmbedding[] // 033: 1 abstract row + N chunk rows; Cascade delete

  signingRequests                SigningRequest[]
  signatures                     NodeSignature[]
  /// #1892 — the Agents whose tasks / processes index this node is.
  tasksIndexOf                   Agent[]                    @relation("AgentTasksIndex")
  processesIndexOf               Agent[]                    @relation("AgentProcessesIndex")
  /// #1325 — rules and template rules that reference this node as their
  /// author task, validation task or description node (node-id FKs, SET NULL).
  authorTaskOfRules              NodeRoleRule[]             @relation("NodeRoleRuleAuthorTask")
  validationTaskOfRules          NodeRoleRule[]             @relation("NodeRoleRuleValidationTask")
  descriptionNodeOfRules         NodeRoleRule[]             @relation("NodeRoleRuleDescriptionNode")
  authorTaskOfTemplateRules      MemoryConfigTemplateRule[] @relation("TemplateRuleAuthorTask")
  validationTaskOfTemplateRules  MemoryConfigTemplateRule[] @relation("TemplateRuleValidationTask")
  descriptionNodeOfTemplateRules MemoryConfigTemplateRule[] @relation("TemplateRuleDescriptionNode")

  @@unique([loc, memoryId])
  @@index([loc])
  @@index([memoryId])
  // Graph-view scale path (#466): memoryNodes runs
  // `WHERE memory_id = ? ORDER BY loc LIMIT/OFFSET`. This composite lets
  // Postgres seek to the memory's rows AND return them loc-ordered without a
  // separate sort or a full loc-index scan across other memories.
  @@index([memoryId, loc])
  // #725 — "list all nodes of collection X in this memory" (the objectType
  // facet). objectType is NULL for most nodes; the composite seeks a memory's
  // typed rows directly.
  @@index([memoryId, objectType])
  @@map("nodes")
}

/// 033-rag-vector-retrieval: what a memory's vector index is built from
/// (per-memory property, not a query parameter — FR-002).
enum EmbeddingSource {
  abstract // default — embed Node.abstract
  contentChunks @map("content_chunks") // embed content chunks
  both // embed both
}

/// 033-rag-vector-retrieval: kind of a stored vector.
enum EmbeddingKind {
  abstract // one row per node — vector of Node.abstract
  chunk // N rows per node — vector of one content chunk
}

/// One stored embedding vector of a Node: either the vector of the node's abstract (one per node) or the vector
/// of one chunk of its content (several per node). Vector search over a memory reads these rows.
///
/// Relationships: belongs to one Node and is deleted with it. `memoryId` repeats the node's memory so a search
/// can filter by memory before it orders by distance.
///
/// Behaviour: rows exist only for memories with `Memory.vectorIndexEnabled`; `Memory.embeddingSource` decides
/// whether abstracts, chunks or both are embedded. The embedding job writes them from the plaintext, and the
/// vectors are stored unencrypted. `provider`, `model` and `dim` record which model produced the vector, so a
/// later change of model can find the rows to re-embed. For a chunk, `chunkIndex`, `charStart`, `charEnd` and
/// `chunkText` locate the text the vector stands for.
///
/// The `embedding` column is a pgvector `vector(768)`, a type Prisma does not have. It is never read or written
/// through the generated client: every access is raw SQL. The HNSW index and the partial unique index that allows
/// one abstract vector per node are in the migration and prisma/post-push.sql, because the Prisma schema cannot
/// express them.
///
/// Background (history, not law): the Spec Kit spec 033-rag-vector-retrieval.
model NodeEmbedding {
  id         String                      @id @default(cuid())
  nodeId     String                      @map("node_id")
  /// Denormalized for fast per-memory similarity filtering (search filters by
  /// memory before ORDER BY distance).
  memoryId   String                      @map("memory_id")
  kind       EmbeddingKind
  /// Embedding provider — "local" | "openai" | "voyage" … v1 is always "local".
  provider   String
  /// Stored model id (FR-014) — e.g. "nomic-embed-text-v1.5". Forward-compat
  /// for a deliberate re-embed when the platform model changes.
  model      String
  /// Vector dimension (sanity / forward-compat guard).
  dim        Int
  // ── chunk-only locators (NULL for kind = abstract); FR-016 ──
  chunkIndex Int?                        @map("chunk_index")
  charStart  Int?                        @map("char_start")
  charEnd    Int?                        @map("char_end")
  chunkText  String?                     @map("chunk_text")
  // ── the vector — pgvector; Prisma has no native type ──
  // Declared OPTIONAL (and nullable in the DB) on purpose: a REQUIRED Unsupported
  // field drops the model from Prisma's client create/upsert and breaks the
  // $allModels extension in src/integrations/db/client.ts. Keeping schema and DB
  // both nullable means migrations and schema.prisma agree (the migration-smoke
  // test). Rows are only ever inserted via raw SQL, which always supplies the
  // vector, so a NULL embedding never occurs in practice.
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now()) @map("created_at")

  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([nodeId, kind, chunkIndex]) // dedupes CHUNK rows; abstract uniqueness via partial index (post-push.sql)
  @@index([nodeId])
  @@index([memoryId])
  @@map("node_embeddings")
}

/// Directed edge between two Nodes: it says that the source node relates to the target node, and optionally how.
/// Edges are what make a memory a graph. They also drive behaviour: an edge can be runnable and can carry a
/// condition, which is how task automation and conversation flows move from one node to the next.
///
/// An edge is an addressable entity of its own. `loc` is its path inside the memory, unique per memory, and the
/// suffix of its URN (`hrn:edge:<root>:<memory>:<loc>`); it is derived from the two endpoints and the name when
/// the author gives none (src/lib/edgeLoc.ts). The optional `name` describes the relationship, for example
/// "imports", "depends_on", "related-to", "cites" or "abstract-of".
///
/// Relationships: `source` and `target` are Nodes, and the edge is deleted with either. `memoryId` is the
/// source node's memory, also for an edge whose target is in another memory. An edge whose target does not exist
/// yet is stored as a PendingEdge until the target arrives.
///
/// Behaviour: among the edges that leave one node, `priority` orders resolution (lower first) and `condition`, a
/// JSONLogic expression, decides whether the edge fires (null: always). `governedKind` marks an edge the platform
/// owns: the anchor or reply edge of a comment, or an edge derived from an include tag. A governed edge cannot be
/// created, changed or deleted through the generic edge writes, and the database keeps it immutable
/// (hrn:node:hadronmemory.com:specs:cor:dmo:110:01, hrn:node:hadronmemory.com:specs:cor:dmo:110:04).
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:060:03.
model Edge {
  id                 String            @id @default(cuid())
  /// Denormalized from the SOURCE node's memory so `loc` can be made
  /// unique within a memory (a unique index can't span the source-node
  /// table). For cross-memory edges this is the source's memory.
  memoryId           String            @map("memory_id")
  sourceId           String            @map("source_id")
  targetId           String            @map("target_id")
  /// Colon-delimited path within the memory — the edge's identity and
  /// the suffix of its URN (`hrn:edge:<root>:<memory>:<loc>`). Required;
  /// derived from the endpoints + name when not authored (see
  /// `src/lib/edgeLoc.ts`). Mirrors `Node.loc`.
  loc                String
  /// Free-form relationship name (e.g. imports, depends_on, abstract-of).
  /// Optional since spec-037 — `loc` is now the identity. (Was `label`.)
  name               String?
  /// Human-readable description of the edge (parity with `Node.description`).
  description        String?
  /// If true, this edge can be executed/run (task automation, conversation
  /// transitions). Mirrors `Node.isRunnable`.
  isRunnable         Boolean?          @map("is_runnable")
  // Edge-condition spec: JSONLogic gating expression. Null = always fires.
  // Validated server-side at save and evaluate time. See
  // src/lib/edge-conditions/.
  /// JSONLogic gating expression evaluated by the shared
  /// edge-condition evaluator at edge-resolution time. NULL means the
  /// edge always fires. Validated against the v1 operator subset and
  /// the FOUR variable scopes (`memory.*`, `chat.*`, `agent.*`,
  /// `message.data.*` — `VALID_SCOPE_PREFIXES`; anything else is
  /// UNKNOWN_SCOPE). The time builtins `now()` and `today()` are a
  /// SEPARATE constant, not a fifth scope: whole references rather than
  /// prefixes, pre-resolved by the evaluator from the request clock.
  /// Said "five variable scopes" here until #1246, in the same sentence
  /// as the GraphQL SDL and generated into the public Data Model
  /// reference. Spec:
  /// `hadron-concept/spec-kits/specs/001-edge-condition-spec/spec.md`
  /// (sister repo). User docs:
  /// https://docs.hadronmemory.com/reference/edge-conditions/.
  condition          Json?
  // Stable ordering hook (lower = earlier). Future agent-exceptions
  // feature uses this so handler edges can sit at the top of the
  // resolution order without re-architecting.
  /// Resolution-order hook for edges sharing a source node; lower
  /// fires first, ties broken by insertion order. Reserved space for
  /// the future agent-exceptions feature to slot handler edges at the
  /// top.
  priority           Int               @default(0)
  /// Free-form structured payload on the edge (e.g. transition
  /// metadata for conversation-design edges).
  data               Json?
  createdAt          DateTime          @default(now()) @map("created_at")
  createdBy          String?           @map("created_by")
  updatedAt          DateTime?         @updatedAt @map("updated_at")
  updatedBy          String?           @map("updated_by")
  deletedAt          DateTime?         @map("deleted_at")
  deletedBy          String?           @map("deleted_by")
  /// #1606 (`hrn:node:hadronmemory.com:specs:cor:dmo:110:01`) — set only by the comment path: the edge is a
  /// comment's anchor (comment → target) or reply (reply → thread root).
  /// NULL for every ordinary edge. A governed edge is immutable (DB trigger
  /// `edges_governed_immutable`) and no generic edge write may create, alter
  /// or delete one (`hrn:node:hadronmemory.com:specs:cor:dmo:110:04`).
  governedKind       EdgeGovernedKind? @map("governed_kind")
  /// The target revision a top-level comment was written against. Set iff
  /// `governedKind = COMMENT_ANCHOR` (CHECK `chk_edges_governed_anchor`).
  anchorRevNo        Int?              @map("anchor_rev_no")
  /// `computeApprovalHash` of the target's title/abstract/content AT
  /// `anchorRevNo` (64 lowercase hex), whether or not that revision was ever
  /// approved, so the anchored text stays checkable after the revision
  /// snapshot is pruned (`hrn:node:hadronmemory.com:specs:cor:dmo:110:01`).
  anchorApprovalHash String?           @map("anchor_approval_hash")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  source Node   @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target Node   @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([loc, memoryId])
  @@index([memoryId])
  @@index([targetId])
  @@index([sourceId])
  // Graph-view scale path (#466): memoryEdges runs
  // `WHERE memory_id = ? ORDER BY loc LIMIT/OFFSET` (plus endpoint-liveness
  // joins). Same memory-scoped, loc-ordered seek as nodes_memory_id_loc_idx.
  @@index([memoryId, loc])
  @@map("edges")
}

/// #1606 — the reserved, governed edge kinds (`hrn:node:hadronmemory.com:specs:cor:dmo:110:01`).
enum EdgeGovernedKind {
  COMMENT_ANCHOR
  COMMENT_REPLY
  /// Derived from an include tag in the source node's content (#2040); owned by the content writer, never by a client.
  INCLUDE
}

/// #1606 — a comment thread's state (`hrn:node:hadronmemory.com:specs:cor:dmo:110:05`); top-level only.
enum CommentThreadState {
  OPEN
  RESOLVED
}

/// The comment-specific state of a comment. A comment is a Node with `nodeType = 'comment'`, and every such node
/// has exactly one row here. The comment's text is the node's `content`; this row says what the comment is on,
/// which thread it belongs to and who wrote it. For a top-level comment it also holds the thread's state (open or
/// resolved), and for any comment the markers of a retraction or a deletion.
///
/// Relationships: `node` is the comment node (one to one). `target` is the commented node. `threadRootId` is null
/// for a top-level comment and names the thread's top-level comment for a reply. The same facts exist as governed
/// Edges (comment to target, reply to thread root), and the columns here always equal those edges' endpoints.
///
/// Why these columns are here and not in the node's `data`: the quoted text and the moderation reasons are in the
/// node's `data`, so an encrypted memory encrypts them with the body. The columns in this table are the ones a
/// constraint or an index has to read in plaintext.
///
/// Behaviour and invariants (prisma/post-push.sql and migration `20261005200000_comment_nodes`):
/// - A node has a CommentMeta row exactly when it is a comment.
/// - The comment, its target and its thread root are in one memory, of a class that allows comments.
/// - The target of a comment is never itself a comment.
/// - `targetNodeId`, `threadRootId` and `authorKey` never change.
/// - One author has at most one open, live top-level thread per target (`comment_meta_one_open_thread`, a partial
///   unique index Prisma cannot model).
/// - Only a top-level comment has a `threadState` (OPEN or RESOLVED).
/// - Deleting a comment that has live replies leaves a stub with its text blanked (`retractedAt`); a comment
///   without replies is soft-deleted. `threadDeleted*` repeats the soft delete of the comment node, and its cause,
///   so the one-open-thread index can leave the row out.
///
/// Rules: hrn:node:hadronmemory.com:specs:cor:dmo:110:01 (governed edges),
/// hrn:node:hadronmemory.com:specs:cor:dmo:110:03 (the author), hrn:node:hadronmemory.com:specs:cor:dmo:110:05
/// (thread state). Background: #1606, #1721.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:110:12.
model CommentMeta {
  nodeId             String              @id @map("node_id")
  /// The commented node. Immutable. `ON DELETE CASCADE` only so a whole-memory
  /// delete never depends on cascade order: hard-deleting a commented target
  /// on its own is still refused, by the governed-edge trigger (its anchor
  /// edge cannot go while the comment exists) and, at commit, by the
  /// comment-without-meta check.
  targetNodeId       String              @map("target_node_id")
  /// NULL for a top-level comment; else the thread's top-level comment.
  threadRootId       String?             @map("thread_root_id")
  /// OPEN | RESOLVED for a top-level comment; NULL for a reply (CHECK).
  threadState        CommentThreadState? @map("thread_state")
  /// The author (`hrn:node:hadronmemory.com:specs:cor:dmo:110:03`): `w:<workerId>`, `ua:<userId>:<agentId>`,
  /// `u:<userId>` or `app:<appId>`. Immutable.
  authorKey          String              @map("author_key")
  /// #1721 — set when deleteComment leaves a stub (a top-level comment with
  /// live replies; its text is blanked). A comment deleted without replies is
  /// soft-deleted instead, and these record who deleted it.
  retractedAt        DateTime?           @map("retracted_at")
  /// Actor key (the `authorKey` grammar) of whoever deleted the comment.
  retractedBy        String?             @map("retracted_by")
  resolvedAt         DateTime?           @map("resolved_at")
  resolvedBy         String?             @map("resolved_by")
  /// Mirrors the comment node's soft delete (a thread delete, or the target's
  /// soft delete), so the one-open-thread index can exclude it.
  threadDeletedAt    DateTime?           @map("thread_deleted_at")
  threadDeletedBy    String?             @map("thread_deleted_by")
  /// `ADMIN` (deleteCommentThread), `AUTHOR` or `MANAGER` (#1721 deleteComment,
  /// by its author or by a memory manager), or `TARGET` (the target was
  /// soft-deleted; restoring the target restores exactly these).
  threadDeletedCause String?             @map("thread_deleted_cause")
  createdAt          DateTime            @default(now()) @map("created_at")

  node   Node @relation("CommentMetaNode", fields: [nodeId], references: [id], onDelete: Cascade)
  target Node @relation("CommentMetaTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([targetNodeId])
  @@index([threadRootId])
  @@map("comment_meta")
}

/// An edge whose target Node does not exist on this server yet. It keeps what was written (source, intended
/// target, name, description, data and, if one was given, the `loc`) until the target arrives, and is then turned
/// into a regular Edge.
///
/// Relationships: `source` is a Node, and the row is deleted with it. `targetId` is the id of the intended target
/// and deliberately not a foreign key, because that node is not there. One row per (source, target).
///
/// Behaviour: created when a write or a Git sync names a target that is missing. When the target node is
/// created or synced, the pending edge is promoted to an Edge (src/lib/pendingEdgePromotion.ts); the Edge derives
/// a `loc` when this row has none. `Memory.pendingEdgeCount` counts the live unresolved rows whose source is in
/// that memory.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:060:05.
model PendingEdge {
  id          String    @id @default(cuid())
  sourceId    String    @map("source_id")
  /// Intended target node id — **NOT a foreign key**; resolved at
  /// promotion time.
  targetId    String    @map("target_id")
  /// Edge loc carried so an authored loc survives until promotion; the
  /// promoted Edge derives one when this is null. (Mirrors `Edge.loc`.)
  loc         String?
  /// Free-form relationship name (was `label`).
  name        String?
  /// Preserved until the unresolved edge is promoted; empty differs from null.
  description String?
  /// Structured edge payload carried through deferred Git sync and cloning.
  data        Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  source Node @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([targetId])
  @@map("pending_edges")
}

/// #1156 / hrn:node:hadronmemory.com:specs:cor:dmo:070:05 — only an end writer supplies a cause; legacy NULL stays
/// unknown.
enum SessionEndReason {
  ended
  superseded
  expired
  /// #4292: the host that runs a SHORT_LIVED worker ended the session on its proof that no agent runs (hrn:node:hadronmemory.com:specs:cor:agt:050:10).
  agent_absent
}

/// One stretch of work by a person, an agent or an automation: an interactive coding session, a chat with an
/// end user through an App, an automation run, or a run started by an edge (`type`). Usage is
/// recorded against a session where there is one, and a session is what binds a Worker to the process that is
/// doing its work.
///
/// Relationships:
/// - Who: `user` (the person the work is attributed to), `app`, `agent`, and `worker` when the session is bound
///   to a Worker; `role` is that worker's role at the time of the bind
///   (hrn:node:hadronmemory.com:specs:cor:dmo:050:11, hrn:node:hadronmemory.com:specs:cor:agt:020:03).
/// - Where it writes: `memory`, the session's active write memory when there is exactly one.
/// - Other sessions: `parent` (this session was started by another, as a sub-agent) and `prev` (this session
///   continues an earlier one); `supersededBySessionId` names the session that replaced this one at a bind.
/// - Usage: UsageEvent rows are recorded inside a session.
/// - Launch: for a session a host started, `launchHostId`, `launchOperationId`, `launchTaskId` and
///   `launchIssuedBy` name the host, the start operation, the task it was started for and who issued the start
///   (hrn:node:hadronmemory.com:specs:cor:agt:070:08). All four are null for a session a person started by hand.
///
/// Behaviour:
/// - The caller chooses the `id`.
/// - A session is open until `endedAt` is set. `endReason` says how it ended; the first end wins.
/// - Silence never ends a session. Whether a session is live (driven recently) is derived when it is read
///   (src/lib/sessionActivity.ts) and changes nothing stored. The session reaper ends a session only when it is
///   past `expiresAt`, which is set only for sessions started with an App's session timeout.
/// - `llmModel`, `family`, `effort` and `tool` are what the session reported about itself. They are inputs to
///   matching work to workers, never to authorization.
/// - Token counts, turn and error counts, `summary` and the `outcome*` fields are reports about the work done.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:070:05.
model Session {
  id                String            @id // caller-generated (e.g. UUID from h-start-session)
  type              SessionType       @default(DEVELOPER)
  appId             String?           @map("app_id")
  /// The User this session is attributed to (typically the end-user
  /// in a chatbot/automation session; the developer in a DEVELOPER
  /// session).
  userId            String?           @map("user_id")
  /// The Agent driving the session (NULL for free-form developer
  /// sessions not tied to a specific Agent). When `workerId` is set this
  /// records the ROLE-agent behind the casting (hrn:node:hadronmemory.com:specs:cor:agt:020:03).
  agentId           String?           @map("agent_id")
  /// #974 — the named identity doing the work: the Worker (casting) this
  /// session is bound to (hrn:node:hadronmemory.com:specs:cor:dmo:050:11, hrn:node:hadronmemory.com:specs:cor:agt:020:03). Binding is
  /// gated at start (the worker must belong to the session's App); "taken
  /// right now" derives from an ACTIVE session bound to the worker.
  workerId          String?           @map("worker_id")
  /// #2458 (hrn:node:hadronmemory.com:specs:cor:dmo:050:11): the worker's role AT BIND, stamped from the locked worker row with `agentId`, so a
  /// past session keeps the role it ran under after the worker's agent (and so its role) changes. Null for a
  /// session with no worker; the migration backfills earlier sessions exactly (the role was immutable before #2458).
  role              String?           @map("role")
  /// The active write-memory for this session, when there's an
  /// unambiguous one. Resolves the multi-writable-memory ambiguity.
  memoryId          String?           @map("memory_id")
  /// Hard expiry; the session reaper (src/jobs/reapSessions.ts, #930) ends
  /// sessions past this point. Since #1114 this is the ONLY thing the reaper
  /// acts on: a NULL here means the session is never ended automatically at
  /// all, because inactivity stopped being a reason to end one. It still
  /// stops reading as LIVE once nobody drives it inside its idle window, but
  /// that is derived at read time (lib/sessionActivity.ts) and mutates
  /// nothing. Set by startAgentSession from the App's sessionTimeoutSeconds —
  /// a promise made at session start rather than an inference from silence;
  /// startSession deliberately leaves it null (the client contract carries no
  /// TTL), so an explicit endSession is what closes those.
  expiresAt         DateTime?         @map("expires_at")
  /// Git repo slug.
  repo              String?
  /// Git branch name at session start.
  branch            String?
  /// GitHub PR number.
  prNumber          Int?              @map("pr_number")
  /// Tenant/customer identifier (free-form, supplied by the App).
  customerId        String?           @map("customer_id")
  /// Spoken ("en", "es") or programming language.
  language          String?
  /// The execution plan, when one was prepared.
  plan              String?
  /// LLM model used (e.g. "claude-opus-4-6").
  llmModel          String?           @map("llm_model")
  /// #928 coding-session provenance: where the driving tool's transcript
  /// physically lives on `host` (a filesystem path in that tool's store).
  transcriptPath    String?           @map("transcript_path")
  /// #928: machine identifier the session ran on.
  host              String?
  /// #928: the tool driving the session ("claude-code", "codex", ...).
  tool              String?
  /// #1707 — the model family this session runs as (hrn:node:hadronmemory.com:specs:cor:agt:060:04): given
  /// at session start, or derived from `llmModel` then `tool`; null when it
  /// could not be classified. A worker's family is its live bound session's.
  /// A matching input only, never an authorization input: it is self-declared.
  family            String?
  /// #2252 — when `llmModel` was last SELF-REPORTED (start, resume, or an
  /// updateSession carrying a model; a repeat of the same model counts). Null
  /// for a session that never reported, including every row from before this
  /// column: no historical backfill. Not `updated_at`, which unrelated writes
  /// move. Describes a self-report, not verified detection.
  modelReportedAt   DateTime?         @map("model_reported_at")
  /// #4291 — the effort this session runs at, as the launcher applied it and the session reported it (start, resume or
  /// updateSession). Null until reported; NOT_APPLICABLE for a family with no effort control. A report, never a control.
  effort            EffortLevel?
  /// #1709 (hrn:node:hadronmemory.com:specs:cor:agt:070:08; Holger via Vera #10773) — a host-launched session:
  /// the host that started it, the `worker.start` operation, the task it was
  /// launched for (none for a manager's start without one), and who issued the
  /// start (`platform` | `manager`). Bound on the holder's own token; the hold
  /// is unchanged. All four null for a session a person started by hand.
  launchHostId      String?           @map("launch_host_id")
  launchOperationId String?           @unique @map("launch_operation_id")
  launchTaskId      String?           @map("launch_task_id")
  launchIssuedBy    String?           @map("launch_issued_by")
  /// Total prompt tokens across the session.
  inputTokens       Int?              @map("input_tokens")
  /// Total completion tokens across the session.
  outputTokens      Int?              @map("output_tokens")
  /// Number of human-AI exchanges.
  turnCount         Int?              @map("turn_count")
  /// Failed tool calls / action runs.
  errorCount        Int?              @map("error_count")
  /// Sub-agent vertical relation (this session was spawned by a parent).
  parentSessionId   String?           @map("parent_session_id")
  /// Chain horizontal relation (linked journey — this session
  /// continues from a previous one).
  prevSessionId     String?           @map("prev_session_id")
  /// AI-composed summary at session end.
  summary           String?
  /// 0.0-1.0, reported externally.
  outcome           Float?
  /// GUID or URL of authoritative outcome record.
  outcomeRef        String?           @map("outcome_ref")
  /// Domain-specific outcome detail.
  outcomeMeta       Json?             @map("outcome_meta")
  startedAt         DateTime          @default(now()) @map("started_at")
  endedAt           DateTime?         @map("ended_at")
  /// First end wins. NULL on legacy ended rows is exposed as unknown, never backfilled.
  endReason         SessionEndReason? @map("end_reason")
  /// #3818 V25: immediate successor stamped by the same bind transaction; disclosure is independently gated on read.
  supersededBySessionId String?       @map("superseded_by_session_id")
  /// Set by the reaper (#930) when the session was auto-expired — meaning
  /// past `expiresAt`, and since #1114 nothing else. It no longer records an
  /// idle-window expiry, because there is no longer such a thing: inactivity
  /// never ends a session. Rows carrying this from before that change are the
  /// only ones stamped for idleness, which is why the liveness derivation
  /// still drops `updatedAt` on an auto-expired row (the reap overwrote it).
  /// Always written together with `endedAt` and to the same instant, so
  /// "ended" stays the single predicate `endedAt IS NOT NULL` and this
  /// column records only HOW it ended. (#1232 — this read `IS NULL`,
  /// which is the predicate for a session that has NOT ended, and it
  /// said so in the published Data Model reference.)
  autoExpiredAt     DateTime?         @map("auto_expired_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  createdBy         String?           @map("created_by")
  updatedAt         DateTime?         @updatedAt @map("updated_at")
  updatedBy         String?           @map("updated_by")
  deletedAt         DateTime?         @map("deleted_at")
  deletedBy         String?           @map("deleted_by")

  events       UsageEvent[]
  parent       Session?     @relation("SubAgentSessions", fields: [parentSessionId], references: [id], onDelete: SetNull)
  subSessions  Session[]    @relation("SubAgentSessions")
  prev         Session?     @relation("SessionChain", fields: [prevSessionId], references: [id], onDelete: SetNull)
  nextSessions Session[]    @relation("SessionChain")
  app          App?         @relation(fields: [appId], references: [id], onDelete: SetNull)
  user         User?        @relation("SessionUser", fields: [userId], references: [id], onDelete: SetNull)
  agent        Agent?       @relation("SessionAgent", fields: [agentId], references: [id], onDelete: SetNull)
  worker       Worker?      @relation("SessionWorker", fields: [workerId], references: [id], onDelete: SetNull)
  memory       Memory?      @relation("SessionMemory", fields: [memoryId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([repo])
  @@index([customerId])
  @@index([startedAt])
  @@index([parentSessionId])
  @@index([prevSessionId])
  @@index([appId, userId])
  @@index([expiresAt])
  @@index([workerId])
  /// #451: agent and memory deletes null these FKs (SET NULL); each needs its own leading index.
  @@index([agentId])
  @@index([memoryId])
  /// #1016 — the "what am I driving?" read (`hadron_whoami`), which filters
  /// `userId` alone and orders by `startedAt`. `[appId, userId]` cannot serve
  /// it: Postgres will not seek on a composite index's SECOND column, so the
  /// planner fell back to the `[startedAt]` index and scanned the global
  /// session history backwards — worst for the caller with NO open session,
  /// which is exactly the compaction-recovery case the tool exists for.
  @@index([userId, startedAt])
  @@map("sessions")
}

/// The record of one operation: a node read or write, an action run, an embedding call, an App run. Usage
/// reporting, billing and the activity charts are computed from these rows, and a session's liveness counts the
/// events recorded in it.
///
/// Relationships: an event can name the Session it happened in, the Node it touched, the App and AppKey that
/// made the request, the User it is attributed to and the Organization that is billed. All of those are set to
/// null when the row they point at is deleted, so the event outlives them. `nodeLoc` and `memoryId` are stored as
/// plain values, with no foreign key, for the same reason: the event stays in its memory's history after the
/// node or the memory is gone.
///
/// Behaviour:
/// - `type` is a string, not an enum. Values written today include `read`, `write`, `action-run`, `embedding`
///   and `app-run`.
/// - Cost: `provider`, `model`, the token counts and `keyOwnerType` describe an LLM call. `costMicroCents` is the
///   cost at the price in force when the event was recorded (AiModelPrice) and is never recomputed.
/// - Activity: `countsAsActivity` is true only when the session was live and owned by the recording principal
///   when the event was written, so a request attributed to a lapsed session does not make it live again.
/// - Rollup: database triggers on this table maintain UsageActivityCell.
///
/// Specs: hrn:node:hadronmemory.com:specs:cor:dmo:080:02, hrn:node:hadronmemory.com:specs:cor:dmo:100:02.
model UsageEvent {
  id               String    @id @default(cuid())
  type             String
  /// Stored directly so the event survives node deletion.
  nodeLoc          String?   @map("node_loc")
  /// Set null on node deletion.
  nodeId           String?   @map("node_id")
  /// Memory the event is attributed to (#796). Stored DIRECTLY at write time
  /// like `nodeLoc` — deliberately NO relation, unlike this model's five other
  /// FKs. Those are all `SetNull`, and memory-scoped analytics used to reach
  /// the memory by joining through `node`, so deleting a node silently erased
  /// the event from its memory's history. A `SetNull` FK here would recreate
  /// that loss one level up (on memory deletion), which is exactly what this
  /// column exists to prevent.
  memoryId         String?   @map("memory_id")
  /// Set null on session deletion.
  sessionId        String?   @map("session_id")
  /// The App that authored this event.
  appId            String?   @map("app_id")
  /// #2944 (hrn:node:hadronmemory.com:specs:cor:acl:090:01, ruling 0244 item 3): the App key that authenticated the request that made this
  /// event. Null for every other event: a user, a session, an async run, and every row recorded before the
  /// column (no backfill). A key filter never returns a null row. Set null if the key row is deleted.
  appKeyId         String?   @map("app_key_id")
  /// Key-value args when `type = 'action-run'`.
  actionArgs       Json?     @map("action_args")
  /// LLM model used for this specific event.
  model            String?
  /// Input tokens consumed.
  tokensIn         Int?      @map("tokens_in")
  /// Output tokens generated.
  tokensOut        Int?      @map("tokens_out")
  // ── 046-usage-metering (billing Phase 0) ──────────────────────────────
  /// The on-behalf-of user (billing attribution). Nullable — pure-App
  /// service runs have no user. Distinct from the audit `createdBy` string.
  userId           String?   @map("user_id")
  /// The billable organization. Set on every metered event so ledger
  /// attribution never needs a join through App.
  organizationId   String?   @map("organization_id")
  /// LLM provider that served the call — `model` alone is ambiguous
  /// across providers (e.g. claude via anthropic vs bedrock).
  provider         String?
  /// AiConfigOwnerType of the API key that served the call
  /// (HADRON_SERVER | ORGANIZATION | APP | AGENT). Only HADRON_SERVER
  /// spend is platform-paid and thus debitable; BYOK is observability-only.
  keyOwnerType     String?   @map("key_owner_type")
  /// Provider cost snapshot in micro-cents (1e-8 USD), computed from the
  /// AiModelPrice row effective at event time. NULL = no price known (or the
  /// event carries no tokens). Never recomputed — prices change (FR-003).
  costMicroCents   BigInt?   @map("cost_micro_cents")
  /// #1653 / ruling DY-2: whether this event counts as ACTIVITY for its
  /// session's liveness. True only when the session was live AND owned by the
  /// recording principal at write time (`usageEventCountsAsActivity`), so a
  /// request attributed to a LAPSED session keeps its attribution but never
  /// revives it — resuming is the DA door alone. Defaults to false so a writer
  /// that forgets the check fails safe; rows before the column are backfilled
  /// true by the migration, so liveness was unchanged at deploy.
  countsAsActivity Boolean   @default(false) @map("counts_as_activity")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  node         Node?         @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  session      Session?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  app          App?          @relation(fields: [appId], references: [id], onDelete: SetNull)
  appKey       AppKey?       @relation(fields: [appKeyId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([nodeLoc])
  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
  @@index([appId])
  /// #451: a node hard delete nulls this FK (SET NULL); without it each delete scans the firehose.
  @@index([nodeId])
  /// #796 — the two `usageActivity` scopes. Both are composite on `createdAt`
  /// so the bucketed aggregation is an index range scan; the composite
  /// `(userId, createdAt)` also prefix-covers the plain `userId` lookups the
  /// bare index used to serve, so that one was dropped.
  @@index([userId, createdAt])
  @@index([memoryId, createdAt])
  @@index([organizationId, createdAt])
  /// #2944: the key-filtered read (usageEvents(appKey:)), newest first within a window.
  @@index([appKeyId, createdAt])
  // #1903: session liveness also needs the PARTIAL index
  // usage_events_session_activity_idx (session_id, created_at) WHERE
  // counts_as_activity. Prisma can't model a partial index, so it lives in
  // prisma/post-push.sql and migration 20261014040000.
  @@map("usage_events")
}

/// A precomputed count of usage for one scope in one 15-minute interval: how many live `read` and `write`
/// UsageEvents fall into that interval for one user or one memory. The usage-activity charts read these rows so
/// they do not have to count `usage_events` each time.
///
/// Relationships: none by foreign key, on purpose. `scopeKind` is `user` (events attributed to that user) or
/// `memory` (events whose own `memoryId` is that memory), and `scopeId` is the id. The cells follow the events,
/// and an event outlives its memory. `cell` is the start of the interval, in UTC.
///
/// Behaviour: maintained only by statement-level triggers on `usage_events`
/// (prisma/usage-activity-rollup-invariants.sql); application code never writes it. A cell is removed when both
/// counters are zero or below. So a cell such as `reads = -1, writes = 3` stays; one can exist only for an
/// interval before `UsageActivityRollupState.appliesFrom` while the backfill is incomplete, where the reader does
/// not use cells and the backfill rebuilds them. A comment in that SQL file describes the removal differently ("a
/// cell that nets to zero or below is removed"); the file is carried byte for byte by the applied migration and
/// is never edited, so the correction is recorded here (#4320).
///
/// Background: #2719, #796.
model UsageActivityCell {
  scopeKind String   @map("scope_kind")
  scopeId   String   @map("scope_id")
  cell      DateTime
  reads     BigInt   @default(0)
  writes    BigInt   @default(0)

  @@id([scopeKind, scopeId, cell])
  @@map("usage_activity_cells")
}

/// The single row (`id = 1`) that says how far the usage-activity rollup can be trusted. A reader of
/// UsageActivityCell checks it to decide whether to answer from the cells or from `usage_events`.
///
/// Relationships: none; it describes the UsageActivityCell table as a whole.
///
/// Behaviour: the triggers maintain every cell at or after `appliesFrom`. Cells before it are written by the
/// backfill job (src/jobs/usageActivityRollup.ts), which sets `complete` when all history is in. Until then the
/// reader answers intervals before `appliesFrom` from `usage_events`, so the answers are correct before the
/// backfill has run, only slower. `appliesFrom` is a real timestamp because Prisma cannot read `-infinity`;
/// `complete` is what means "all history".
///
/// Background: #2719.
model UsageActivityRollupState {
  id          Int      @id @default(1)
  appliesFrom DateTime @map("applies_from")
  complete    Boolean  @default(false)

  @@map("usage_activity_rollup_state")
}

/// The definition of an agent: what a builder creates, and what an organization or a person installs. One row
/// holds the agent's identity (`urn`, `name`), a pointer to the memory with its instructions (`systemMemoryId`),
/// and the policies it declares for every installation.
///
/// Agent, App and Worker: an Agent is the definition and is shared by all its installations. An App is one
/// deployment: it authenticates, has members and collects its own data, and it installs Agents through AppAgent.
/// A Worker is a named casting of an installed Agent inside an App. Examples of agents: "Mealplan" (a family
/// meal planner) and "Juno" (a mentoring chat agent installed by several organizations).
///
/// Ownership: exactly one of `organizationId` and `ownerUserId` is set (`chk_agent_owner_xor`).
///
/// Relationships:
/// - Memories: its system memory (`systemMemoryId`); the knowledge memories attached through AgentMemoryItem; and
///   the memories that exist per installation or per user (`installMemories`, `sharedMemories`, `userMemories`).
/// - Installation: AppAgent (the Apps that installed it), AppAgentCustomization, AgentOrgGrant (another
///   organization allowed to install it), AgentSubscription (a user's subscription to it).
/// - Composition: `extendsAgent` is the one base Agent whose system-memory nodes this Agent inherits
///   (hrn:node:hadronmemory.com:specs:cor:dmo:050:14); AgentImport lists the Agents it imports.
/// - Work: Workers cast from it (hrn:node:hadronmemory.com:specs:cor:dmo:050:11), Sessions it drives, the tickers
///   it declares (AgentTickerTemplate), its ModelGroups and AiServiceConfigs.
/// - Its lists: `tasksIndex` and `processesIndex` are the Nodes that list the Agent's tasks and processes
///   (hrn:node:hadronmemory.com:specs:cor:dmo:050:15, hrn:node:hadronmemory.com:specs:cor:dmo:050:16).
///
/// Behaviour:
/// - `visibility` says who may see and install the Agent; PERSONAL is the creator-only draft state.
///   `listedOnMarketplace` controls advertisement only.
/// - `memoryProvisioning` and `installationPolicy` are the Agent's declarations for each App that installs it:
///   which App memory to create, how many members the App may have and which member roles exist.
/// - `publishedRevisionLoc` names the published revision of the system memory, so a builder can work on a draft
///   without changing running Apps. `editorLockUserId` is the one builder who holds the edit lock.
/// - `bootPromptNodeId` and `bootPromptUrn` point at the Agent's compiled boot prompt
///   (hrn:node:hadronmemory.com:specs:cor:agt:040:07).
/// - `usesTasks`, `lifecycle`, `resetContextAfterTask` and `contextCap` apply to every Worker cast from the Agent:
///   whether its workers work from tasks (`usesTasks` false means they always count as having one, so they are
///   expected to check their team channel every `App.deliveryCheckPeriodSeconds`), whether a worker's process runs
///   always or only while it has a task, and
///   when its host is asked to reset its context.
/// - `personaRole` is descriptive metadata; no server behaviour depends on it.
///
/// Background (history, not law): the Spec Kit spec 008-agent-installation.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:050:01.
model Agent {
  id                    String          @id @default(cuid())
  /// #2138 §3.5 — false: every worker cast from this Agent counts as HAVING a task (coordinators, the
  /// lifecycle agent), so it is expected to check every period (`App.deliveryCheckPeriodSeconds`).
  usesTasks             Boolean         @default(true) @map("uses_tasks")
  /// #2162 (hrn:node:hadronmemory.com:specs:cor:agt:050:27) — when a task one of this Agent's workers had started finishes or is cancelled, and it holds
  /// no other started task, the platform asks the worker's host to reset its context: a shed, never a session end.
  /// Off by default; written by whoever manages the Agent, like `usesTasks`.
  resetContextAfterTask Boolean         @default(false) @map("reset_context_after_task")
  /// #4224 (S3 of #4229) — every worker cast from this Agent shares it. Default LONG_LIVED, so no existing Agent
  /// changes behaviour; written by whoever manages the Agent, like `usesTasks`.
  lifecycle             AgentLifecycle  @default(LONG_LIVED)
  /// #4225 (S4b of #4229, hrn:node:hadronmemory.com:specs:cor:agt:050:27 part 12; G4) — the context size, in tokens, above which a worker of this
  /// LONG_LIVED Agent that its host reports idle is reset (`worker.reset-context`), at most once an hour. Null (the default)
  /// is no cap. Written by whoever manages the Agent, like `usesTasks`. `chk_agents_context_cap` keeps it at 1 or more.
  contextCap            Int?            @map("context_cap")
  organizationId        String?         @map("organization_id")
  /// User owner of a user-owned Agent (rooted on the bare `<handle>` — #697 v2,
  /// no `@` sigil). The org/owner XOR is ENFORCED — `chk_agent_owner_xor` in
  /// post-push.sql: `(organization_id IS NULL) <> (owner_user_id IS NULL)` — so
  /// exactly one of `organizationId`/`ownerUserId` is non-null.
  ownerUserId           String?         @map("owner_user_id")
  ownerUser             User?           @relation("AgentOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// Globally unique identifier (e.g. "micromentor.org:juno");
  /// derived from `org.urn + ":" + slug`.
  urn                   String          @unique
  /// Display name of this agent.
  name                  String
  description           String?
  /// #2045 (S8, hrn:node:hadronmemory.com:specs:cor:agt:040:07) — this Agent's boot-prompt POINTER: the id of a
  /// compiled boot-prompt node (`nodeType = 'compiled-boot-prompt'`), never its
  /// source. NO foreign key: nodes are hard-deleted on some paths (deleteNode
  /// hard/subtree, memory merge, git-sync cleanup), and SET NULL would turn a
  /// deleted target (R27) into "no pointer" (R26) while RESTRICT would block
  /// those deletes. `bootPromptUrn` is the target's canonical URN at write time,
  /// read only when the row is gone; both are set or both NULL
  /// (chk_*_boot_prompt_pointer_pair, prisma/boot-prompt-pointer-invariants.sql).
  /// Written only through `setBootPromptPointer` (src/lib/bootPromptPointer.ts).
  bootPromptNodeId      String?         @map("boot_prompt_node_id")
  bootPromptUrn         String?         @map("boot_prompt_urn")
  /// Memory containing conversation designs (stages, prompts,
  /// partials). Universally read-only from any App context post-008
  /// (DEVELOP-from-App is dropped per R-10); edits happen in the
  /// Agent ownership surface.
  systemMemoryId        String?         @map("system_memory_id")
  /// PUBLIC | ORGANIZATION | PERSONAL (035-visibility-enum-cleanup gave
  /// agents their own enum). PERSONAL is the creator-only draft state.
  visibility            AgentVisibility @default(PERSONAL)
  /// Opt-in marketplace catalogue flag (hrn:node:hadronmemory.com:specs:cor:acl:080:04): whether this agent is
  /// advertised in the marketplace browse. DISTINCT from `visibility` — PUBLIC
  /// governs access, this governs advertisement. Contributes to the owner org's
  /// discoverability (hrn:node:hadronmemory.com:specs:cor:acl:080:02) only when that org is activated.
  listedOnMarketplace   Boolean         @default(false) @map("listed_on_marketplace")
  /// Coarse behavior hint — see AgentType enum doc. Largely legacy
  /// post-008.
  type                  AgentType       @default(ASSISTANT)
  /// Surfaces this Agent is designed for (free-form per 008 R-9; v1
  /// known values: 'chat', 'slack', 'mcp', 'web'). Distinct from the
  /// per-App `surfaces` — this is the *design-time* declaration.
  surfaces              String[]        @default([])
  // 036-ai-service-config: the legacy ai_provider/ai_model/
  // ai_api_key_encrypted/ai_api_key_preview columns were dropped in favor
  // of Agent-owned AiServiceConfig rows (the Agent's design-time default
  // lives in its config named 'default'; an App-owned config overrides at
  // deploy time per the resolution walk).
  /// Loc of the currently-published revision of the Agent's system
  /// memory. Lets the Builder ship draft revisions without affecting
  /// running Apps.
  publishedRevisionLoc  String?         @map("published_revision_loc")
  /// Optimistic editor-lock owner (one Builder at a time can hold the
  /// edit lock on the system memory).
  editorLockUserId      String?         @map("editor_lock_user_id")
  /// When the editor lock expires (auto-released on stale).
  editorLockExpiresAt   DateTime?       @map("editor_lock_expires_at")
  /// Agent working state (per-user data like family budget,
  /// preferences); automatically available to the LLM as context.
  properties            Json?
  // 008-agent-installation (2026-05-02): Agent declares per-deployment memory
  // provisioning shape. Schema: { appMemory: 'shared' | 'user' | 'none' }.
  // Personal-class provisioning is implicit (lazy on first user-attributed write).
  /// Declares how this Agent expects per-App memory to be
  /// provisioned. Shape: `{ appMemory: 'shared' | 'user' | 'none' }`.
  /// `personalMemory` provisioning is implicit (lazy-create on first
  /// user-attributed write). 008-agent-installation FR-008.
  memoryProvisioning    Json            @default("{\"appMemory\": \"shared\"}") @map("memory_provisioning")
  /// Spec 049 Phase 5 (plan §3.5 recommendation): the defaults this Agent's
  /// install-created register row is made with — `{ mentionOnly?: boolean }`.
  /// A scalar default, not a reference that can rot; null = platform defaults.
  registerDefaults      Json?           @map("register_defaults")
  // 008-agent-installation (2026-05-02): Agent declares membership constraints.
  // Schema: { maxMembers: number | 'unlimited', memberRoles: string[] }.
  // Enforced at AppMember invite-acceptance time.
  /// Declares membership constraints for any App that installs this
  /// Agent. Shape: `{ maxMembers: number | 'unlimited', memberRoles:
  /// string[] }`. `maxMembers` enforced at AppMember
  /// invite-acceptance time. 008-agent-installation FR-009.
  installationPolicy    Json            @default("{\"maxMembers\": \"unlimited\", \"memberRoles\": [\"owner\"]}") @map("installation_policy")
  // #928 persona dressing, re-cut to the Worker model by #974 (cor:agt:020:01,
  // D-2026-08-14-004): a persona is UNIVERSAL DRESSING on an Agent — a role
  // plus a template prompt that let any agent present as a colleague. The
  // NAMED identity ("Iris") lives on the Worker entity (the casting of an
  // installed agent into an App), never here: the retired persona-as-agent
  // model's `persona_name` / `team_app_id` columns were dropped by the
  // 20260814130000_worker_model migration. These two columns are PURE
  // METADATA; no server behavior may fork on their presence (that would
  // rebuild the deprecated AgentType axis).
  /// Persona role — free string with conventions ("backend-engineer").
  /// A dedicated column so roster/casting queries can filter without
  /// parsing the prompt.
  personaRole           String?         @map("persona_role")
  /// #1885 (hrn:node:hadronmemory.com:specs:cor:dmo:050:14) — the one base Agent this Agent extends, or null.
  /// The child inherits its base chain's system-memory nodes (except boot
  /// prompts). One base, no cycles, at most 4 Agents in a chain counting this
  /// one: enforced by `src/lib/agentBase.ts`, the only writer, and backstopped
  /// by `agent_base_guard` (prisma/agent-base-invariants.sql). `Restrict`, as
  /// for an imported Agent: a live child keeps its base from being removed.
  extendsAgentId        String?         @map("extends_agent_id")
  /// #2245 (R145/R146): the Agent this one was cloned from, as a plain ref (the source's URN at clone time).
  /// No FK: the source may be retired or renamed, and the provenance must survive both.
  clonedFromAgentRef   String?         @map("cloned_from_agent_ref")
  /// #1892 (hrn:node:hadronmemory.com:specs:cor:dmo:050:15) — the index node whose incoming, trigger-labelled
  /// edges list this Agent's own tasks; null when it names none. Written only
  /// by `setAgentIndexRefs`, read by src/lib/agentDefinitionLists.ts.
  /// `SetNull`: removing the index node unsets the pointer.
  tasksIndexRef        String?         @map("tasks_index_ref")
  /// #1892 (hrn:node:hadronmemory.com:specs:cor:dmo:050:16) — the index node whose incoming, trigger-labelled
  /// edges list the processes this Agent starts or owns; null when none.
  processesIndexRef     String?         @map("processes_index_ref")
  createdAt             DateTime        @default(now()) @map("created_at")
  createdBy             String?         @map("created_by")
  updatedAt             DateTime?       @updatedAt @map("updated_at")
  updatedBy             String?         @map("updated_by")
  deletedAt             DateTime?       @map("deleted_at")
  deletedBy             String?         @map("deleted_by")

  /// Online URN-shape migration gate (spec 021 FR-032, repurposed for the #697
  /// v1→v2 emission flip). Null = pre-normalization row; set = row normalized
  /// onto the flat v2 form (`<root>:<slug>`, single colon). Transient.
  /// TODO(spec-021-cleanup): drop once the FR-032 migration completes.
  urnNormalizedAt          DateTime? @map("urn_normalized_at")
  /// Spec 021 sentinel for data-defect rows during the FR-032 migration.
  /// TODO(spec-021-cleanup): drop alongside urnNormalizedAt.
  urnMigrationFailedReason String?   @map("urn_migration_failed_reason")
  /// #697 stored alias map: the pre-v2 (v1) URN this row was migrated FROM
  /// (see Memory.legacyUrn). Null until the online migration flips `urn` to v2.
  legacyUrn                String?   @map("legacy_urn")

  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memoryItems        AgentMemoryItem[]
  userMemories       Memory[]            @relation("UserMemoriesOfAgent")
  /// #723 — the per-App `shared` app-class memories this Agent is the identity
  /// of (at most one per App).
  sharedMemories     Memory[]            @relation("SharedMemoriesOfAgent")
  /// #2044 — the per-App install memories that customise this Agent.
  installMemories    Memory[]            @relation("InstallMemoriesOfAgent")
  sessions           Session[]           @relation("SessionAgent")
  appRuns            AppRun[]            @relation("AppRunAgent")
  userSubscriptions  AgentSubscription[] @relation("AgentUserSubscriptions")
  // 023-app-shape Phase 2b: App↔Agent goes through `AppAgent` (N:M).
  // The direct `App[]` back-relation is gone (dropped with App.agentId).
  appAgentCustomizations AppAgentCustomization[]
  appAgents          AppAgent[]
  imports            AgentImport[]       @relation("ParentAgent")
  importedBy         AgentImport[]       @relation("ImportedAgent")
  orgGrants          AgentOrgGrant[]
  aiServiceConfigs   AiServiceConfig[]
  modelGroups        ModelGroup[]
  scopes             Scope[]
  registerAttendeeOf RegisterEntry[]     @relation("RegisterAttendeeAgent")
  readStates         ChannelReadState[]  @relation("ReadStateAgent")
  /// #974 — the named castings of this agent into Apps (hrn:node:hadronmemory.com:specs:cor:dmo:050:11).
  workers            Worker[]
  /// #1885 (hrn:node:hadronmemory.com:specs:cor:dmo:050:14) — the base this Agent extends, and the Agents
  /// that extend it. Never called a parent: that word belongs to imports.
  extendsAgent       Agent?              @relation("AgentBase", fields: [extendsAgentId], references: [id], onDelete: Restrict)
  extendedBy         Agent[]             @relation("AgentBase")
  /// #1892 — the nodes `tasksIndexRef` / `processesIndexRef` name.
  tasksIndex         Node?               @relation("AgentTasksIndex", fields: [tasksIndexRef], references: [id], onDelete: SetNull)
  processesIndex     Node?               @relation("AgentProcessesIndex", fields: [processesIndexRef], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([extendsAgentId])
  @@index([legacyUrn])
  @@index([bootPromptNodeId])
  /// #451: org agent listings and the org-delete cascade. The persona-name uniques are partial and cannot serve them.
  @@index([organizationId])
  @@map("agents")
  /// #2024 (S8, hrn:node:hadronmemory.com:specs:cor:agt:080:33): the tickers this Agent declares; each cast of a worker from it instantiates them.
  tickerTemplates       AgentTickerTemplate[]
}

/// Attaches one Memory to one Agent and says whether the Agent may only read it or also write it. This is how an
/// Agent is given its knowledge memories. The row limits and never grants: the memory's own access rules must
/// also allow what the Agent does there.
///
/// Relationships: joins Agent and Memory, one row per pair, and is deleted with either.
///
/// Behaviour: `role` is `read` (the default) or `read-write` and is the upper limit of what the Agent may do in
/// that memory. The access fold reads these rows together with the Agent's system memory
/// (`foldAgentIntoAccessMap`, src/mcp/access-control.ts). A memory that another organization owns can be attached
/// only while the Agent's own organization has a live MemorySubscription to it, and `read-write` only when that
/// subscription allows writing (src/lib/auth/memorySubscriptionAccess.ts). A user-owned Agent has no
/// organization, so it cannot be attached that way.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:050:09.
model AgentMemoryItem {
  id        String    @id @default(cuid())
  agentId   String    @map("agent_id")
  memoryId  String    @map("memory_id")
  /// `"read"` or `"read-write"`. Default `"read"`. Controls whether
  /// the Agent can write to this memory.
  role      String    @default("read")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([agentId, memoryId])
  @@map("agent_memory_items")
}

/// A commercial grant to use a Memory: how many consumers may use it (`seats`), for which period (`validFrom` to
/// `validUntil`), under which terms, and the license keys. A memory with `Memory.requiresLicense` is meant to be
/// subscribed to only under a valid license.
///
/// Relationships: belongs to one Memory and is deleted with it. A MemorySubscription names the license it uses
/// (`MemorySubscription.licenseId`).
///
/// Behaviour: `licenseType` is a string with the intended values `user`, `app` and `organization`. No mutation
/// creates or edits a license today, and no access check reads one: a subscription gives access with or without
/// a license (src/lib/auth/memorySubscriptionAccess.ts). The only code that reads the table is the memory
/// transfer, which refuses to move a memory that has live licenses.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:060:06.
model MemoryLicense {
  id          String    @id @default(cuid())
  memoryId    String    @map("memory_id")
  /// **Column type is `String` (not enum)** — intended values:
  /// `user | app | organization`.
  licenseType String    @map("license_type")
  /// Number of consumers allowed to use this license.
  seats       Int
  validFrom   DateTime  @map("valid_from")
  validUntil  DateTime  @map("valid_until")
  /// One or more license keys.
  licenseKeys String[]  @map("license_keys")
  /// Usage terms & conditions.
  terms       String
  /// If true, the memory will be merged into the blended graph for
  /// the consumer.
  activated   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  memory        Memory               @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  subscriptions MemorySubscription[]

  @@map("memory_licenses")
}

/// An Organization's subscription to a Memory that another organization owns. A live row is what lets the
/// subscribing organization reach that memory: its members can read it, and its Agents can be attached to it.
///
/// Relationships: joins the subscribing Organization (`organizationId`, never the owner) and the Memory, one row
/// per pair. `license` is the MemoryLicense the subscription was made under, if any.
///
/// Behaviour:
/// - Reach: a subscription reaches only an ordinary shared memory: not a `personal`, `private`, `group` or
///   `system` memory, and not one that belongs to an App or to one user of an Agent. One predicate decides this
///   for a member's read and for attaching an Agent (`subscribedMemoryWhere`,
///   src/lib/auth/memorySubscriptionAccess.ts).
/// - Role: READER is read-only, CONTRIBUTOR is read and write. The column is the full Role enum, but those two
///   are the intended values. A member may write only when both their role in the subscribing organization and
///   the subscription's role are CONTRIBUTOR or higher.
/// - `activated` says whether the memory is merged into the subscriber's blended graph. It is not an access
///   check, and neither is the license: a read makes no check on either.
/// - A soft-deleted row (`deletedAt`) gives no access.
/// - A subscription says nothing about access through an App or to a user's own memories. Which memories an
///   App and its installed Agents reach is decided per App (hrn:node:hadronmemory.com:specs:cor:dmo:050:17,
///   src/mcp/access-control.ts). Whatever role the caller has in an organization, a `personal` memory is
///   readable only by its owner and by those the owner shared it with (MemoryShare), and a `private` memory by
///   its owner alone.
///
/// Specs: hrn:node:hadronmemory.com:specs:cor:dmo:060:09, hrn:node:hadronmemory.com:specs:cor:dmo:050:09.
model MemorySubscription {
  id             String    @id @default(cuid())
  memoryId       String    @map("memory_id")
  /// The subscribing organization (not the owner).
  organizationId String    @map("organization_id")
  licenseId      String?   @map("license_id")
  /// Column type is the full `Role` enum, but the intended grant set
  /// is `CONTRIBUTOR | READER` (reader = read-only, contributor =
  /// read-write). Tightening reserved for a future cleanup spec.
  role           Role      @default(READER)
  /// If true, the memory will be merged into the blended graph for
  /// the subscriber.
  activated      Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  memory       Memory         @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  license      MemoryLicense? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@unique([memoryId, organizationId])
  @@index([organizationId])
  @@map("memory_subscriptions")
}

/// One running Hadron server instance, hosted or self-hosted. The row gives the server an identity that
/// server-owned things can belong to and be addressed by.
///
/// Relationships: owns the server-level AiServiceConfigs (the last step of the configuration lookup), the
/// server-owned MemoryConfigTemplates, and the ServerLogEntry rows. `organizationId` is the organization that
/// operates the server and is null for the hosted service.
///
/// Behaviour: a database may hold more than one row. "The server answering" is the oldest live row
/// (src/lib/hadronServer.ts), so a server-owned thing has the same identity in every address.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:080:01.
model HadronServer {
  id              String    @id @default(cuid())
  /// The organization that owns/operates this server; NULL for the
  /// Baragaun SaaS server.
  organizationId  String?   @map("organization_id")
  /// Base URL of this server (e.g. "https://server.hadrongraph.io").
  url             String
  /// Minimum level for ServerLogEntry records.
  logLevel        LogLevel  @default(ERROR) @map("log_level")
  /// Deployed software version.
  version         String?
  /// Last health-check timestamp.
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  logEntries       ServerLogEntry[]
  aiServiceConfigs AiServiceConfig[]

  memoryConfigTemplates MemoryConfigTemplate[]

  @@map("hadron_server")
}

/// A named configuration of an AI service: which provider and model to call, with which key, endpoint and
/// parameters. Wherever the platform calls an LLM for an App or an Agent, it resolves one of these rows by name.
///
/// Ownership: exactly one of HadronServer, Organization, App or Agent owns a config
/// (`chk_ai_service_config_owner` in prisma/post-push.sql; Prisma cannot express it). The name is unique per
/// owner, by four partial unique indexes in the same file.
///
/// Relationships: the four possible owners, each of which deletes its configs with itself. An App can also name
/// one config as its chatbot's (`App.chatbotAiConfigId`, the `chatbotOfApps` relation).
///
/// Behaviour: a lookup by name walks from the App to the Agent, to the organization (of the App, else of the
/// Agent), to the server, and the first enabled config with that name wins; a disabled config is skipped. The
/// conventional fallback name is `default`; `fast` and `frontier` are conventional extras. The API key is stored
/// encrypted (`apiKeyEncrypted`), and `apiKeyPreview` is the masked form for display. `provider`, `params`,
/// `endpoint` and `apiStyle` are validated when the config is written (src/lib/aiConfig.ts, src/lib/aiEndpoint.ts).
///
/// Background (history, not law): the Spec Kit spec 036-ai-service-config, which replaced the earlier AI columns
/// on Agent and App. Issue #1373 (endpoint and protocol).
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:050:10.
model AiServiceConfig {
  id              String    @id @default(cuid())
  /// Lookup name used by the resolution walk; lower-case canonical.
  name            String
  // Owner FKs — exactly one non-null (chk_ai_service_config_owner).
  hadronServerId  String?   @map("hadron_server_id")
  organizationId  String?   @map("organization_id")
  appId           String?   @map("app_id")
  agentId         String?   @map("agent_id")
  /// Provider identifier; known: 'anthropic' | 'openai' | 'glm' | 'kimi' | 'bedrock' |
  /// 'openai-compatible' (endpoint required). Validated against the registry
  /// in src/lib/aiConfig.ts.
  provider        String
  /// Model identifier, passed verbatim to the provider.
  model           String
  /// AES-256-GCM-encrypted API key (src/lib/tokenCrypto.ts encryptToken).
  /// For 'bedrock' this is a JSON-encoded {accessKeyId, secretAccessKey,
  /// region} triple, stored opaque.
  apiKeyEncrypted String?   @map("api_key_encrypted")
  /// Ellipsis + last 4 chars of the raw key for masked display.
  apiKeyPreview   String?   @map("api_key_preview")
  /// Provider-specific knobs (maxTokens, thinking, effort, baseUrl, ...).
  /// Validated per provider by zod in src/lib/aiConfig.ts.
  params          Json?
  /// #1373: base URL requests for this config are sent to. Null = the
  /// provider's default (src/lib/aiEndpoint.ts, the one suggestion list).
  /// Validated at write (validateEndpoint) and guarded at connect time.
  endpoint        String?
  /// #1373 D3: wire protocol for an OpenAI-compatible provider —
  /// 'CHAT_COMPLETIONS' | 'RESPONSES'. Null = the provider's default
  /// (src/lib/aiEndpoint.ts). Refused for providers with one protocol.
  apiStyle        String?   @map("api_style")
  /// Disabled configs are skipped by resolution (walk continues outward).
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")

  hadronServer HadronServer? @relation(fields: [hadronServerId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  app          App?          @relation("AppAiServiceConfigs", fields: [appId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// #3957: the Apps that name this config as their chatbot config (`App.chatbotAiConfigId`).
  chatbotOfApps App[]        @relation("AppChatbotAiConfig")

  @@index([hadronServerId])
  @@index([organizationId])
  @@index([appId])
  @@index([agentId])
  @@map("ai_service_configs")
}

/// A log entry about the server as a whole. The table is meant for system-level events an operator needs to
/// see, such as a failed memory sync or a GitHub App error. Nothing writes or shows it today (see Behaviour).
///
/// Relationships: belongs to one HadronServer and is deleted with it. `memoryId` is set when the entry is about
/// one memory; it is a plain value with no foreign key.
///
/// Behaviour: `HadronServer.logLevel` is the lowest level meant to be recorded. No code path writes this table
/// today; the memory transfer counts a memory's rows so that they move with it.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:080:03.
model ServerLogEntry {
  id        String    @id @default(cuid())
  serverId  String    @map("server_id")
  level     LogLevel
  /// Set if the log relates to a specific memory.
  memoryId  String?   @map("memory_id")
  /// Human-readable log message.
  message   String
  /// Structured context (stack trace, request/response, etc.).
  detail    Json?
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  server HadronServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([level])
  @@index([createdAt])
  @@map("server_log")
}

/// A log entry about one Memory, kept in the database as a record of what happened to it. The table is meant
/// for events such as a sync failure, an expired license or an unresolved pending edge; what is written today is
/// narrower (see Behaviour).
///
/// Relationships: belongs to one Memory and is deleted with it.
///
/// Behaviour: `eventType` (SYNC, LICENSE, EDGE, OTHER) lets a reader filter the entries. The entries written
/// today record a memory clone, the extraction of a subtree into a new memory, and a memory transfer.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:080:03.
model MemoryLogEntry {
  id        String             @id @default(cuid())
  memoryId  String             @map("memory_id")
  level     LogLevel
  /// Categorizes the log for filtering.
  eventType MemoryLogEventType @map("event_type")
  /// Human-readable log message.
  message   String
  /// Structured context (sync diff, expired license details, etc.).
  detail    Json?
  createdAt DateTime           @default(now()) @map("created_at")
  createdBy String?            @map("created_by")
  updatedAt DateTime?          @updatedAt @map("updated_at")
  updatedBy String?            @map("updated_by")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([level])
  @@index([eventType])
  @@index([createdAt])
  @@map("memory_log")
}

/// An invitation for a person who already has an account to join an Organization. (Inviting someone who has no
/// account yet is a UserInvitation.)
///
/// Relationships: `sender` is the OrgMember that sent it, which also names the organization; `recipient` is the
/// invited User. The invitation is deleted with either.
///
/// Behaviour: `role` is the role the recipient gets on acceptance. It cannot be higher than the sender's own
/// role, and OWNER is not given by invitation. `expiresAt` is when the invitation expires and `acceptedAt` when
/// the recipient accepted. No mutation creates these invitations today (a search of src/ finds no create of
/// the model), so the acceptance described here is the table's design, not a live flow. The only code that
/// touches the table revokes an organization's open invitations (src/lib/auth/revokeOrgInvitations.ts, also
/// used when an organization is soft-deleted).
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:040:04.
model OrgMemberInvitation {
  id              String    @id @default(cuid())
  /// fk to OrgMember.id — the sender of the invitation.
  memberUserId    String    @map("member_user_id")
  /// fk to User.id — the recipient (an existing platform user).
  recipientUserId String    @map("recipient_user_id")
  /// Column type is the full `Role` enum, but the intended grant set
  /// is `ADMIN | CONTRIBUTOR | READER` (you can't invite someone as
  /// OWNER — promotion happens via a separate transfer flow).
  role            Role      @default(READER)
  /// When this invitation expires.
  expiresAt       DateTime? @map("expires_at")
  /// When the recipient accepted the invitation.
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  sender    OrgMember @relation("SentByMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  recipient User      @relation("ReceivedMemberInvitations", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@map("org_member_invitations")
}

/// An invitation for one or more people who do not have an account yet to join the platform, and optionally an
/// Organization with it. The invitation's `slug` makes its unique invite link.
///
/// Relationships: `sender` is the inviting User (null for a system or seed invitation). `organization` is the
/// organization the new user is added to on signup, if any. Each account created from the invitation is one
/// UserInvitationActivation.
///
/// Behaviour:
/// - Use count: `maxActivations` is how many accounts the invitation may create; the current count is the number
///   of activations. With `maxActivations = 1` it is single-use.
/// - Locked identity: when `email` or `githubUsername` is given, the person signing up must match it, which
///   also makes the invitation single-use.
/// - Roles: `userRole` (a global role, usually none) and `memberRole` are the roles the new user gets. They are
///   meant not to exceed the sender's own. Creating an invitation for an organization requires the ADMIN role
///   in that organization (src/api/graphql/schema/resolvers.mutation.org.ts).
/// - Quota: how many people a user may bring in is tracked on `User.maxReferrals`, not here. The new user's own
///   `maxReferrals` is set during onboarding.
/// - Over the limit: a person who opens the link after the activations are used up is told the invitation has
///   expired. A person who has already started signing up is never refused for the count: if creating the
///   account would exceed `maxActivations`, the account is created anyway.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:040:05.
model UserInvitation {
  id             String    @id @default(cuid())
  /// fk to User.id — the sender; NULL for system/seed invitations
  /// from Baragaun.
  senderUserId   String?   @map("sender_user_id")
  /// If the new user should be added to an organization on signup.
  organizationId String?   @map("organization_id")
  /// Random string to get a unique invite URL.
  slug           String    @unique
  /// Column type is the full `Role` enum, but the intended set is
  /// `ADMIN | null` (most invites grant no global role).
  userRole       Role?     @map("user_role")
  /// Column type is the full `Role` enum, but the intended grant set
  /// is `ADMIN | CONTRIBUTOR | READER`.
  memberRole     Role      @default(READER) @map("member_role")
  /// fk to User.id — set when the invitation is accepted and a User
  /// is created.
  newUserId      String?   @map("new_user_id")
  /// Recipient's name.
  name           String?
  email          String?
  githubUsername String?   @map("github_username")
  phoneNumber    String?   @map("phone_number")
  /// Maximum number of times this invitation can be accepted by a
  /// new recipient; current count is determined from
  /// UserInvitationActivation rows.
  maxActivations Int?      @map("max_activations")
  expiresAt      DateTime? @map("expires_at")
  /// When this invitation was accepted and the new User was created.
  /// (For multi-use invites this is set on the *first* acceptance.)
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  sender       User?                      @relation("SentInvitations", fields: [senderUserId], references: [id], onDelete: SetNull)
  organization Organization?              @relation("OrgInvitations", fields: [organizationId], references: [id], onDelete: SetNull)
  activations  UserInvitationActivation[]

  @@map("user_invitations")
}

/// The record that one User account was created from one UserInvitation. The rows of an invitation count how
/// often it has been used, and a user's row leads back to who invited them.
///
/// Relationships: joins the UserInvitation and the new User, and is deleted with either. Following
/// `invitation.sender` from user to user gives the invitation chain that the referral quota is counted along
/// (see User).
///
/// Behaviour: written when the account is created. The row holds no roles: the roles the new user gets are the
/// invitation's (`UserInvitation.userRole`, `memberRole`), which cannot exceed the sender's at the time of the
/// activation.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:040:05.
model UserInvitationActivation {
  id           String    @id @default(cuid())
  /// The invitation that was accepted.
  invitationId String    @map("invitation_id")
  /// The newly created User.
  userId       String    @map("user_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  invitation UserInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_invitation_activations")
}

/// A single-use token that proves a person controls an email address. It is the secret inside the sign-in link
/// the server emails; presenting it completes the sign-in for that address.
///
/// Relationships: none by foreign key. `email` is the address the link was sent to (src/auth/email.ts).
///
/// Behaviour: the token expires at `expiresAt` and is marked used at `usedAt`. `clientStateHash` is the SHA-256
/// of a nonce the portal set in the browser that requested the link. It is carried into the login handoff code
/// when the token is verified, so only the browser that asked for the link can finish the sign-in (#505).
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:070:04.
model EmailVerificationToken {
  id              String    @id @default(cuid())
  email           String
  token           String    @unique
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  /// #505 session-fixation binding: SHA-256 of the browser nonce the portal set
  /// (HttpOnly cookie) when the magic link was REQUESTED. Carried into the login
  /// handoff code's clientStateHash at verify time so the browser that redeems
  /// must be the one that requested the link. NOT NULL in practice (POST
  /// /auth/email requires clientState); nullable only for forward-compat.
  clientStateHash String?   @map("client_state_hash")

  @@index([email])
  @@map("email_verification_tokens")
}

/// The provenance of one revision of a compiled boot prompt: which source nodes, at which revisions, the compile
/// put together to produce that text. A boot prompt is compiled from a root source node and the nodes it
/// includes; this row is the authority for what went into one compiled revision.
///
/// Relationships: belongs to the compiled Node (`compiledNode`) and is deleted with it. The key is the compiled
/// node and its revision number, so there is one row per compiled revision. `targetAgentId`, `targetAppId` and
/// `targetWorkerId` name what the prompt was compiled for (`targetKind`: AGENT, APP_AGENT or WORKER); they are
/// plain ids.
///
/// Behaviour: written by the compile in the same transaction as the revision it describes. A recompile inserts a
/// new row and never rewrites an older one; the database refuses an UPDATE. `provenance` records the root source
/// and every included or replacing node as {nodeId, revNo, hash}, with its selection settings and its place in
/// the expansion. It never holds copied source text, names or titles. The live compiled-from edge is only an
/// index of the latest compile; for a given revision this row is read (`readCompiledRevision`). The row is
/// operational state: it is not part of node revisions, approvals or content hashes.
///
/// Background: #2046.
model CompiledPromptRevision {
  compiledNodeId  String   @map("compiled_node_id")
  compiledRevNo   Int      @map("compiled_rev_no")
  /// SHA-256 hex of the compiled text this revision holds.
  contentHash     String   @map("content_hash")
  /// AGENT | APP_AGENT | WORKER: the target this revision was compiled for.
  targetKind      String   @map("target_kind")
  targetAgentId   String   @map("target_agent_id")
  targetAppId     String?  @map("target_app_id")
  targetWorkerId  String?  @map("target_worker_id")
  /// CompiledProvenance (src/lib/bootCompile/provenance.ts).
  provenance      Json
  occurrenceCount Int      @map("occurrence_count")
  compiledBy      String?  @map("compiled_by")
  createdAt       DateTime @default(now()) @map("created_at")
  compiledNode    Node     @relation(fields: [compiledNodeId], references: [id], onDelete: Cascade)

  @@id([compiledNodeId, compiledRevNo])
  @@map("compiled_prompt_revisions")
}

/// A snapshot of a Node as it was before an edit. The revisions of a node are its history: what it said, who
/// changed it, and which fields each edit changed. A reader can list them, compare them and restore one.
///
/// Relationships: belongs to one Node and is deleted with it. `memoryId` is the memory the node was in when the
/// snapshot was taken; a node can move between memories, and history is gated on the memory the content
/// belonged to, not only on the node's current one. `approvedByUser` is the User who approved that revision.
///
/// Behaviour:
/// - A revisioned edit saves the state before the edit here, under the node's revision number at that time
///   (`revNo`), and advances `Node.revSeq`. The current state of a node therefore has no row; it is the Node.
/// - `revNo` is the per-node number in the revision's URN (`hrn:noderev:<root>:<mem>:<loc...>:<rev>`).
/// - `changes` lists the fields that the edit which replaced this snapshot changed. `editedBy`, `editedByInfo`,
///   `editedByWorkerId` and `editedByAgentId` name who made that edit; `revLabel` is a label or the reason given.
/// - The snapshot holds the content fields of the node. Operational fields (the embedding queue, token counts,
///   sync provenance, audit stamps) are deliberately not versioned. A null `nodeType` marks a row from before
///   the full snapshot existed; restoring such a row leaves the fields it does not hold as they are.
/// - The `approved*` columns copy the node's approval when an approved revision is edited away. The approval of
///   record is on the Node.
/// - History is bounded: `Memory.maxRevCount` (default 10) is how many revisions are kept per node, and the
///   oldest are pruned when a new one is written.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:060:04. Background: #620, #696, #1591.
model NodeRevision {
  id                 String              @id @default(cuid())
  nodeId             String              @map("node_id")
  /// Memory this snapshot's content belonged to at capture time. A node
  /// can be MOVED across memories (moveNode keeps the stable id), so gating
  /// revision history by the node's CURRENT memory alone would leak snapshots
  /// captured while the node lived in a memory the caller can't read (#602 /
  /// Codex P1). Every snapshot site stamps this; nullable only for legacy
  /// rows predating the column (backfilled to the node's current memory —
  /// the read gate treats NULL as the current memory).
  memoryId           String?             @map("memory_id")
  loc                String
  name               String
  alias              String?
  description        String?
  /// Paragraph summary at the time of the snapshot. Spec 031.
  /// Added in the US1 implementation when the live `Node.abstract`
  /// column landed — revision history would otherwise silently drop
  /// abstract edits.
  abstract           String?
  /// Revision snapshot of `Node.abstractOriginHash` at capture time
  /// (hrn:node:hadronmemory.com:specs:cor:dmo:020:03, hrn:node:hadronmemory.com:specs:cor:dmo:060:02). Restored verbatim by `restoreNodeRevision`.
  /// A restored NULL on a node with both an abstract and content means the abstract is
  /// unverified, neither stale nor fresh. A NULL on a node with no abstract or no content needs no check.
  abstractOriginHash String?             @map("abstract_origin_hash")
  content            String?
  tags               String[]
  // ─── #620: full curated-subset snapshot of the Node's content fields.
  // NULL `nodeType` marks a LEGACY row captured before these columns
  // existed (nodeType is non-null on Node, so every post-#620 snapshot
  // sets it) — restoreNodeRevision keys on that sentinel to leave the
  // live node's values for these fields untouched when restoring a
  // legacy snapshot, instead of wiping them to NULL. Deliberately NOT
  // versioned: embedding* (operational state), tokens (derived from
  // content), contentHash + ownerRepo (external-sync provenance), and
  // the created/updated/deleted audit stamps.
  nodeType           String?             @map("node_type")
  /// #725 — collection discriminator at capture time (parity with nodeType).
  objectType         String?             @map("object_type")
  isLink             Boolean?            @map("is_link")
  properties         Json?
  data               Json?
  seq                Int?
  isRunnable         Boolean?            @map("is_runnable")
  /// #1201 — `Node.role` at capture time. In the curated subset for a specific
  /// reason rather than for parity: the escalation path #1202 exists for is
  /// CLEARING a governed role, and a history that cannot show the role cannot
  /// show the un-governing.
  role               String?
  llmModel           String?             @map("llm_model")
  aiAgent            String?             @map("ai_agent")
  /// #1326 — pre-edit content attribution, distinct from editedBy (the actor
  /// taking this snapshot for the next edit). NULL on legacy snapshots.
  authorshipKind     NodeAuthorshipKind? @map("authorship_kind")
  authoredByTask     String?             @map("authored_by_task")
  authoredByRevision Int?                @map("authored_by_revision")
  authoredByHuman    String?             @map("authored_by_human")
  authoredAt         DateTime?           @map("authored_at")
  /// #620: the User.id of the editor, when a user is known — nothing
  /// else goes here anymore. Historically this column was overloaded
  /// (`reason ?? clientId ?? userId`, so it held edit rationales, OAuth
  /// identity strings like "github:<login>", or a User id); the #620
  /// migration moved identity strings to `editedByInfo`, rationales to
  /// `revLabel`, and backfilled from `createdBy` where that held a User id.
  editedBy           String?             @map("edited_by")
  /// #620: what we know about the editor when no User.id is available.
  /// Identity-string forms in the wild: "github:<login>" / "email:<addr>"
  /// / "user:<id>" (AuthContext.clientId) and "app:<App.id>" (App-key
  /// principals).
  editedByInfo       String?             @map("edited_by_info")
  /// #1610 — the Worker / Agent behind the edit this snapshot records,
  /// beside editedBy (the user). Set from the snapshot editor (editorFromAuth),
  /// so the lazy reconcile, which builds its own editor, records none.
  editedByWorkerId   String?             @map("edited_by_worker_id")
  editedByAgentId    String?             @map("edited_by_agent_id")
  /// #620: user-settable label for this revision (updateNodeRevision
  /// mutation; REV_LABEL_MAX_LEN cap). Also captures the #88 `reason`
  /// arg at snapshot time — the edit rationale that previously squatted
  /// in `editedBy` (legacy reasons were migrated here).
  revLabel           String?             @map("rev_label")
  /// #620: which node fields the edit that took this snapshot changed
  /// (e.g. ["abstract","tags"]). The snapshot itself is the PRE-edit
  /// state, so `changes` describes the delta between this snapshot and
  /// the state that replaced it. Empty for legacy rows (NULL reads as []).
  changes            String[]
  /// #620/#1591: User who approved this revision, copied from the live
  /// node's approval when this revision is snapshotted (edited away) while
  /// approved. The approval of record is on Node (see Node.approvedRevNo);
  /// these columns are its history.
  approvedBy         String?             @map("approved_by")
  /// #1591: the approving principal when no User.id is known.
  approvedByInfo     String?             @map("approved_by_info")
  /// #1591: when this revision was approved.
  approvedAt         DateTime?           @map("approved_at")
  /// #1591: approval hash v1 recorded when this revision was approved.
  approvalHash       String?             @map("approval_hash")
  /// #696: per-node MONOTONIC revision number (1, 2, 3, …) — the stable atom
  /// in the `hrn:noderev:<root>:<mem>:<loc...>:<rev>` URN (rendered `r<N>`).
  /// Minted race-safely from `Node.revSeq` (atomic increment) inside the same
  /// tx that inserts the snapshot. Nullable only for legacy rows predating the
  /// column (backfilled per-node by createdAt order in the migration).
  revNo              Int?                @map("rev_no")
  createdBy          String?             @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at")

  node           Node  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  approvedByUser User? @relation("NodeRevisionApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  /// #696: resolve a noderev URN by its per-node revision number.
  @@unique([nodeId, revNo], map: "node_revisions_node_rev_no_uniq")
  @@index([nodeId, createdAt])
  @@map("node_revisions")
}

/// The result of one content validation of a Node: a validation task looked at one revision of the node and
/// reported PASS, FAIL or ERROR. The reports are evidence about a node's content; they are advice and never
/// block a write.
///
/// Relationships: belongs to one Node and is deleted with it. `memoryId` is the memory the node was in when the
/// report was made, so a later move to another memory does not show the report to readers of only the new
/// memory. `validationTaskId` is the id of the task node that did the validation; it is a plain id, so deleting
/// the task keeps the history.
///
/// Behaviour:
/// - Append-only. A report names the exact node revision (`nodeRevSeq`) and task revision
///   (`validationTaskRevSeq`) that were looked at. A report for revision N stays as history when the node
///   reaches revision N+1.
/// - Writing a report does not edit the node, does not stamp authorship and fires no node-written event.
/// - The reporter is derived by the server from the request and cannot be changed afterwards: a headless run, a
///   worker session, a person, or an App key (`reporterKind` and the matching id column). Only `reporterUserId`
///   moves, to the surviving account after a user merge.
/// - `authorCheck` records whether the node's recorded author was compared with the reporter.
/// - `runId` is an optional caller-supplied id that makes a repeated insert idempotent, unique per node and
///   memory. It is never an identity.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:dmo:160:01. Background: #1326, #1332.
model NodeContentValidationReport {
  id                   String                       @id @default(cuid())
  nodeId               String                       @map("node_id")
  /// Snapshot of the holding memory, so a later cross-memory move cannot
  /// disclose this report to a reader of only the new memory.
  memoryId             String                       @map("memory_id")
  nodeRevSeq           Int                          @map("node_rev_seq")
  /// Stable Node.id values rather than FKs: task deletion preserves history.
  validationTaskId     String                       @map("validation_task_id")
  validationTaskRevSeq Int                          @map("validation_task_rev_seq")
  outcome              NodeContentValidationOutcome
  reportedAt           DateTime                     @default(now()) @map("reported_at")
  /// Optional caller-supplied run id for idempotent insertion (#1332). Unique per
  /// (node, memory snapshot) only, so a run id never answers across memories. It
  /// is never an identity: the reporter columns below are.
  runId                String?                      @map("run_id")
  /// #1332 — the author check made when the report was recorded. NULL: pre-#1332.
  authorCheck          NodeContentValidationAuthorCheck? @map("author_check")
  /// #1332 — the reporter, derived by the server from the request, immutable
  /// after insert (trigger in post-push.sql) except that reporterUserId follows
  /// a user merge's survivor. Plain ids, never FKs: a deleted principal keeps
  /// its history and can never be matched again. NULL kind: no recorded
  /// reporter, which never replays.
  reporterKind         NodeContentValidationReporterKind? @map("reporter_kind")
  /// RUN: the server's AppRun id, never the request's runId.
  reporterRunId        String?                      @map("reporter_run_id")
  /// WORKER: the bound worker and its agent.
  reporterWorkerId     String?                      @map("reporter_worker_id")
  reporterAgentId      String?                      @map("reporter_agent_id")
  /// PERSON: the user, never the key it authenticated with.
  reporterUserId       String?                      @map("reporter_user_id")
  /// APP_KEY: the App key with no user or worker behind it.
  reporterAppKeyId     String?                      @map("reporter_app_key_id")

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, memoryId, runId], map: "node_validation_node_memory_run_uniq")
  @@index([nodeId, nodeRevSeq, reportedAt], map: "node_validation_node_rev_reported_idx")
  @@index([memoryId])
  @@index([reporterUserId], map: "node_validation_reporter_user_idx")
  @@map("node_content_validation_reports")
}

/// A table for the API key of a newly provisioned workspace: the raw `hdr_app_…` key of the workspace's App, to
/// be held encrypted until the user has seen it once during first-time setup. That setup flow is not in the
/// code today, so nothing fills the table (see Behaviour).
///
/// Relationships: one per User, for one App; deleted with either.
///
/// Behaviour: `rawKeyEncrypted` is meant to hold the key under AES-256-GCM and `consumed` to record that it was
/// shown. No code path creates or reads a row, and no `/setup/info` route exists (checked with a search of
/// src/ for the model and the route). The only code that touches the table is the deletion of a user's account,
/// which removes that user's row (src/controller/operations/deleteUser.ts), and the merge of two accounts, which
/// moves the source account's row to the target or drops it when the target has one
/// (src/controller/operations/mergeUsers.ts).
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:040:06.
model PendingSetup {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  /// The workspace's App; ON DELETE CASCADE.
  appId           String   @map("app_id")
  /// AES-256-GCM-encrypted raw API key.
  rawKeyEncrypted String   @map("raw_key_encrypted")
  consumed        Boolean  @default(false)
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  app  App  @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("pending_setups")
}

/// A connected account at an external provider: a mailbox, a calendar or a drive that a user connected so that
/// the platform can read and act in it for them. Despite the name, it is not limited to Microsoft Exchange:
/// `provider` says which provider tool serves the connection (`ms-exchange` by default).
///
/// Relationships: belongs to an Organization and to the User who connected the account, and is deleted with
/// either. ConnectionGrant rows give other principals access to the connection. One row per (organization,
/// provider, account address), so a calendar connection and a mail connection for the same account are two rows.
///
/// Behaviour: this row is the identity record only. The provider state (refresh tokens, change subscriptions)
/// lives in the provider's capability tool, and operations go through src/lib/emailClient.ts with
/// `toolConnectionId`. Operations on a connection are for its owner, or for a principal with a ConnectionGrant.
/// `syncEnabled` pauses sync without removing the connection; `syncStatus`, `lastSyncAt` and `lastError` report
/// the last sync. `refreshTokenEncrypted` is a legacy column, null on new rows.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:080:04. Background: #396.
model ExchangeConnection {
  id                    String     @id @default(cuid())
  organizationId        String     @map("organization_id")
  userId                String     @map("user_id")
  /// The mailbox/account email address; (organizationId, provider,
  /// mailboxEmail) is unique — provider-scoped so a calendar connection
  /// (provider 'google-cal') for the same Google account COEXISTS with its
  /// mail connection instead of overwriting it (PR-638 Codex P1).
  mailboxEmail          String     @map("mailbox_email")
  displayName           String?    @map("display_name")
  /// Email provider backing this connection — the emailClient dispatch key
  /// (#396: one capability tool per provider; 'ms-exchange' today).
  provider              String     @default("ms-exchange")
  /// The provider tool's connection id. NULL only for legacy rows whose
  /// token hasn't been transferred yet (scripts/admin-transfer-exchange-tokens.ts).
  toolConnectionId      String?    @map("tool_connection_id")
  /// LEGACY (#396): AES-256-GCM-encrypted MS Graph refresh token, kept (NULL
  /// for new rows) only as the rollback path until the one-time core→tool
  /// transfer is verified; a follow-up migration drops it.
  refreshTokenEncrypted String?    @map("refresh_token_encrypted")
  /// Soft toggle — operator can pause sync without removing the
  /// connection.
  syncEnabled           Boolean    @default(true) @map("sync_enabled")
  syncStatus            SyncStatus @default(PENDING) @map("sync_status")
  lastSyncAt            DateTime?  @map("last_sync_at")
  /// Error message from the last failed sync.
  lastError             String?    @map("last_error")
  /// MS Graph change-notification subscription id.
  webhookSubscriptionId String?    @map("webhook_subscription_id")
  /// Subscription expiry — MS Graph webhooks are short-lived; the
  /// renewer cron job watches this column.
  webhookExpiresAt      DateTime?  @map("webhook_expires_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  createdBy             String?    @map("created_by")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  updatedBy             String?    @map("updated_by")
  deletedAt             DateTime?  @map("deleted_at")
  deletedBy             String?    @map("deleted_by")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionGrants ConnectionGrant[]

  @@unique([organizationId, provider, mailboxEmail])
  @@index([userId])
  // The email-events ingress resolves connections by the tool's id on every
  // inbound email — this lookup must be indexed (#396 Phase 4).
  @@index([toolConnectionId])
  @@map("exchange_connections")
}

/// The state of one attempt to connect an external account (a mailbox, calendar or drive) that was started
/// through GraphQL. A client that started a connect flow reads this row to learn whether the flow is still
/// pending, which connection it made, or why it failed.
///
/// Relationships: belongs to the User who started the flow and to the Organization the connection is for, and is
/// deleted with either. `connectionId` is the id of the ExchangeConnection the flow made. It is a plain id, not
/// a relation, so a settled flow keeps saying which connection it made.
///
/// Behaviour: `startConnection` creates the row as pending. The provider callback settles it exactly once
/// (`settledAt`), with the connection id (the existing row, on a reconnect) or with the failure code of the done
/// page. Only the user who started the flow can read it, and only for one hour from `startedAt` on the database
/// clock.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:dmo:080:04 ("Finding the connection a flow made"). Background: #2913.
model ConnectionFlow {
  id             String    @id
  userId         String    @map("user_id")
  organizationId String    @map("organization_id")
  provider       String
  startedAt      DateTime  @default(now()) @map("started_at")
  connectionId   String?   @map("connection_id")
  failureCode    String?   @map("failure_code")
  settledAt      DateTime? @map("settled_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([startedAt])
  @@index([userId])
  @@index([organizationId])
  @@map("connection_flows")
}

/// A grant by the owner of a connected account (an ExchangeConnection) that lets one App use that connection
/// for a set of operations, for example reading mail. It is how an agent running in an App may act in a user's
/// mailbox or calendar without being that user.
///
/// Relationships: `connection` is the ExchangeConnection, `granteeApp` the App that receives the access,
/// `grantedBy` the User who owns the connection and made the grant. The grant is deleted with any of them.
///
/// Behaviour:
/// - The grantee is an App, never an Agent: one Agent installed in two Apps is two separate grantees.
/// - Only the connection's owner can create or revoke a grant; an organization administrator cannot.
/// - `scopes` are the operations covered (for example `mail.read`, `mail.send`, `calendar.read`; see
///   src/lib/emailOperationScopes.ts). The gate `requireEmailConnection` admits the owner, or a live grant that
///   covers the operation's scope.
/// - Several live grants for the same connection and App are allowed, and their scopes add up. There is
///   deliberately no unique constraint on the pair.
/// - Revoking is a soft delete (`deletedAt`); `expiresAt` is an optional end. A revoked or expired grant gives
///   nothing.
/// - The connection's organization and the App's organization may differ; the grant row alone decides.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:dmo:080:04 (operations on a connection are for its owner, with scoped
/// delegation to one App through a grant; an operation with no scope mapping stays owner-only). Background: #593.
model ConnectionGrant {
  id              String    @id @default(cuid())
  connectionId    String    @map("connection_id")
  /// The App install this grant delegates to (the grantee = `ctx.appId`).
  granteeAppId    String    @map("grantee_app_id")
  /// The connection owner who created the grant (owner-only create).
  grantedByUserId String    @map("granted_by_user_id")
  /// Operation scopes covered — subset of {mail.read, mail.send,
  /// calendar.freebusy, calendar.read}. See src/lib/emailOperationScopes.ts.
  scopes          String[]  @default([])
  /// Optional expiry; NULL = perpetual until revoked.
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  connection ExchangeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  granteeApp App                @relation("AppConnectionGrants", fields: [granteeAppId], references: [id], onDelete: Cascade)
  grantedBy  User               @relation("ConnectionGrantsByUser", fields: [grantedByUserId], references: [id], onDelete: Cascade)

  // Composite on the gate's hot lookup (connectionId + granteeAppId). The
  // connectionId-leading order still serves the ExchangeConnection cascade
  // delete, so no separate single-column index is needed (PR-599 review).
  @@index([connectionId, granteeAppId])
  @@index([granteeAppId])
  @@index([grantedByUserId])
  @@map("connection_grants")
}

/// A grant of extra management actions to one user within one Organization, on top of what the user's OrgMember
/// role already allows. It lets an organization hand someone a specific permission (for example cloning
/// memories) without raising their role.
///
/// Relationships: `principal` is the User who receives the actions; `organization` is where they apply. The
/// grant is deleted with either. `principalType` is `USER` today.
///
/// Behaviour: the access gate allows the union of the role's actions and the actions of the user's live grants.
/// `actions` uses the matcher grammar of the access-control package: an exact action (`memory.clone`), a prefix
/// (`memory.*`) or `*`. Several live grants for the same user and organization are allowed and add up. Revoking
/// is a soft delete; `expiresAt` is an optional end. Whether a grant is live is decided inside the gate's query,
/// never after it.
model PrincipalGrant {
  id             String    @id @default(cuid())
  /// 'USER' (v1). Reserved for future app/agent principals.
  principalType  String    @default("USER") @map("principal_type")
  /// The granted user (v1: principalType='USER').
  principalId    String    @map("principal_id")
  organizationId String    @map("organization_id")
  /// Allowed actions — the access-control matcher grammar: exact
  /// ('memory.clone'), prefix ('memory.*'), or '*'.
  actions        String[]  @default([])
  /// Optional expiry; NULL = perpetual until revoked.
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  principal    User         @relation("UserPrincipalGrants", fields: [principalId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Composite on the gate's hot lookup (principal + org); principal-leading
  // order also serves the User cascade delete.
  @@index([principalId, organizationId])
  @@index([organizationId])
  @@map("principal_grants")
}

/// One installation of the Hadron Slack app in a Slack workspace, owned by an Organization. It tells the server
/// which organization and which App a message or command from that workspace belongs to.
///
/// Relationships: belongs to an Organization and is deleted with it. `defaultApp` is the App that serves
/// commands from the workspace; deleting that App deletes the connection too. SlackEventReceipt rows refer to
/// the connection by `toolConnectionId`, not by foreign key.
///
/// Behaviour: the row holds identity only: the workspace (`teamId`, `teamName`), the bot's two Slack ids
/// (`botUserId` for messages it sends, `botId` for the events it causes; the loop filter needs both), and
/// `toolConnectionId`, the handle of the connection in the Slack capability tool. The Slack tokens are stored
/// encrypted in that tool and never appear in a GraphQL field
/// (hrn:node:hadronmemory.com:specs:cor:int:030:01). `toolConnectionId` is unique, because incoming
/// events are routed by it. One live connection per organization and workspace is enforced by a partial unique
/// index in raw SQL (`slack_connections_org_team_active_uniq`), so a soft-deleted row does not block connecting
/// the workspace again.
model SlackConnection {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  /// The Hadron App that serves commands from this workspace.
  defaultAppId     String    @map("default_app_id")
  /// The slackClient dispatch key ('slack' today).
  provider         String    @default("slack")
  /// The provider tool's connection id — the ops-call handle and the
  /// events-ingress resolution key.
  toolConnectionId String    @map("tool_connection_id")
  /// Slack workspace (team) id, e.g. "T0123456789".
  teamId           String    @map("team_id")
  teamName         String    @map("team_name")
  /// The bot's Slack USER id ("U…") — the sender on messages it posts.
  botUserId        String    @map("bot_user_id")
  /// The bot's BOT id ("B…") — what bot message EVENTS carry as `bot_id`.
  /// Distinct from botUserId; the bridge loop filter needs BOTH (spec 043
  /// decision 8, PR #594 review). Don't "simplify" to one column.
  botId            String    @map("bot_id")
  /// 'ACTIVE' | 'ERROR' — mirrors the tool's connection-status vocabulary
  /// (there is no sync loop here, so SyncStatus does not apply).
  status           String    @default("ACTIVE")
  /// Error message from the last permanent provider failure.
  lastError        String?   @map("last_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultApp   App          @relation(fields: [defaultAppId], references: [id], onDelete: Cascade)

  // The slack-events ingress resolves connections by the tool's id on every
  // inbound event — the routing key must be 1:1, so this is UNIQUE (PR #600
  // review): two rows sharing a tool id would make dispatch ambiguous and
  // risk cross-org misdelivery. Every registration mints a fresh tool id,
  // so soft-deleted history rows never collide.
  @@unique([toolConnectionId])
  // One LIVE connection per (org, workspace) — enforced by the PARTIAL
  // unique index `slack_connections_org_team_active_uniq WHERE deleted_at
  // IS NULL` (raw SQL: the 043 migration + prisma/post-push.sql +
  // src/test/globalSetup.ts, which must stay in sync). Prisma's @@unique
  // would be non-partial and make a soft-deleted row block workspace
  // re-registration forever — the apps_urn_active_uniq precedent.
  @@index([organizationId, teamId])
  @@index([defaultAppId])
  @@map("slack_connections")
}

/// The record that one incoming Slack event has been taken for processing, kept so the same event is not
/// processed twice. The Slack capability tool delivers events at least once, so a delivery can repeat.
///
/// Relationships: none by foreign key. `connectionId` is the tool's connection id
/// (`SlackConnection.toolConnectionId`); the duplicate check runs before the connection is looked up.
///
/// Behaviour: the dispatcher inserts a row for (connection, envelope) before it does anything else, and drops
/// the event when the insert conflicts.
model SlackEventReceipt {
  id           String   @id @default(cuid())
  connectionId String   @map("connection_id")
  envelopeId   String   @map("envelope_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([connectionId, envelopeId])
  @@index([createdAt])
  @@map("slack_event_receipts")
}

/// The server's record of one web-polling job that a headless run started: which run, App, agent and user the
/// job belongs to, and under which policy. When the polling tool later reports a change, this row decides which
/// run principal that event may wake.
///
/// Relationships: `sourceRun` is the AppRun that started the job; the binding is deleted with it. The other ids
/// (`organizationId`, `appId`, `agentId`, `userId`, `credentialSecretId`) are plain values captured when the job
/// was created.
///
/// Behaviour: the polling tool owns the job itself: its schedule, state, snapshots and credentials. This row is
/// an immutable snapshot taken at job creation, used for routing and audit; `jobId` is the tool's job id. `url`
/// is stored without query and fragment and is checked against the origin of incoming events. `cancelledAt`
/// marks a cancelled job.
model WebFetchPollBinding {
  jobId              String    @id @map("job_id")
  sourceRunId        String    @map("source_run_id")
  organizationId     String    @map("organization_id")
  appId              String    @map("app_id")
  agentId            String?   @map("agent_id")
  userId             String?   @map("user_id")
  entryNodeUrn       String    @map("entry_node_urn")
  policy             Json?
  /// The resolved `Secret` row a credentialed poll used (#677 — audit
  /// provenance; supersedes the #628 credentials_node_urn node scheme).
  credentialSecretId String?   @map("credential_secret_id")
  /// Query- and fragment-free URL for audit/event-origin validation.
  url                String
  cancelledAt        DateTime? @map("cancelled_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  sourceRun AppRun @relation("WebFetchPollSourceRun", fields: [sourceRunId], references: [id], onDelete: Cascade)

  @@index([organizationId, appId, cancelledAt])
  @@index([sourceRunId])
  @@map("webfetch_poll_bindings")
}

/// The record that one event of a web-polling job has been dispatched to a run, kept so a repeated delivery of
/// the same event starts no second run. The polling tool delivers events at least once.
///
/// Relationships: `routedRun` is the AppRun the event started; the receipt is deleted with it. `jobId` is the
/// polling job (see WebFetchPollBinding), as a plain value.
///
/// Behaviour: unique per (job, snapshot hash, kind). An event without a snapshot hash stores the empty string,
/// because a null would not take part in the unique key. The receipt is written once the dispatch is complete.
model WebFetchEventReceipt {
  id           String   @id @default(cuid())
  jobId        String   @map("job_id")
  snapshotHash String   @default("") @map("snapshot_hash")
  kind         String
  routedRunId  String   @map("routed_run_id")
  createdAt    DateTime @default(now()) @map("created_at")

  routedRun AppRun @relation("WebFetchEventRoutedRun", fields: [routedRunId], references: [id], onDelete: Cascade)

  @@unique([jobId, snapshotHash, kind])
  @@index([createdAt])
  @@index([routedRunId])
  @@map("webfetch_event_receipts")
}

/// An external MCP server that an Organization has registered, so that headless runs in the organization can
/// call that server's tools.
///
/// Relationships: belongs to one Organization and is deleted with it. A flow node names a tool of the server
/// as `mcp__<slug>__<tool>`; that reference is by slug, not by foreign key.
///
/// Behaviour:
/// - The row grants nothing by itself. Every call goes through the action-policy chain as
///   `tool.mcp__<slug>__<tool>` and uses the run's action budget.
/// - The server is reached through a stateless capability tool that knows nothing about Hadron
///   (hrn:node:hadronmemory.com:specs:cor:int:030:01). This row holds what that tool is given per call: the URL
///   and the static request headers.
/// - `headersEncrypted` is write-only: readers see only whether headers are set.
/// - `toolAllowlist` limits which of the server's tools are exposed (empty: all). A disabled server's tools
///   resolve as unknown, like an unregistered slug.
/// - Deleting is a hard delete: the row is configuration, not history, and a run that still names the server
///   fails visibly.
model McpServer {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  /// Run-tool name segment (`mcp__<slug>__<tool>`); lowercase [a-z0-9-],
  /// unique per org. Keep it short — provider tool-name caps are ~64 chars.
  slug             String
  name             String
  /// Streamable-HTTP MCP endpoint URL. The conduit refuses private-network
  /// hosts unless explicitly allowed (SSRF guard, dev only).
  url              String
  /// AES-256-GCM-encrypted JSON object of static request headers
  /// (src/lib/tokenCrypto.ts), e.g. {"Authorization":"Bearer ..."} —
  /// v1 auth posture (no OAuth). WRITE-ONLY on the API surface: resolvers
  /// expose only a hasHeaders boolean, never the value.
  headersEncrypted String?  @map("headers_encrypted")
  /// Exposed-tool allowlist; empty = every tool the server advertises.
  toolAllowlist    String[] @default([]) @map("tool_allowlist")
  /// Disabled servers fail run-tool resolution loud (unknown tool), same
  /// posture as an unregistered slug.
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  createdBy        String?  @map("created_by")
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedBy        String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Hard delete by design: a registry row is config, not audit history —
  // deleting one makes referencing runs fail their hop loud, which is the
  // wanted signal. No deletedAt ⇒ a plain (non-partial) unique works.
  @@unique([organizationId, slug], map: "mcp_servers_org_slug_uniq")
  @@map("mcp_servers")
}

/// One named secret in the platform's secret store, owned by a user, an organization, an App or a memory. A run
/// or a tool that needs a credential names the secret, and the server resolves and decrypts it for that use.
///
/// Relationships: the owner is (`ownerType`, `ownerId`), deliberately without a foreign key. Whether a caller
/// may use a secret is checked when it is resolved, and a secret whose owner is gone never resolves. An
/// App-owned secret keeps its value in SecretVersion rows.
///
/// Behaviour:
/// - Resolution: a bare name is looked up from the most specific owner to the least: memory, then App, then
///   user, then organization. The name is unique per owner.
/// - `kind` says what the secret is: `generic` is opaque; `webfetch-auth` is typed, with `metadata`
///   `{ type, urlPrefix }`, and is used only for requests under that URL prefix.
/// - `metadata` is the part that is not secret and may be shown: a reader can see that a secret exists and where
///   it applies. `valueEncrypted` is never selected into a read.
/// - For a user, organization or memory secret the value is in `valueEncrypted`, and a rotation overwrites it.
///   For an App secret that column is null and the value is the newest SecretVersion (`chk_secret_app_value`).
///   `protected` has a meaning only for App secrets.
/// - Deleting is a hard delete; a run that still names the secret fails visibly.
///
/// Background: #677, #3997.
model Secret {
  id             String   @id @default(cuid())
  ownerType      String   @map("owner_type") // 'user' | 'org' | 'app' | 'memory'
  ownerId        String   @map("owner_id")
  /// Cascade-resolution key; unique per owner; lowercase [a-z0-9-], max 64.
  name           String
  kind           String
  /// The NON-secret, inspectable half — safe on every read surface. A
  /// reader can see THAT a secret exists and (webfetch-auth) WHERE it
  /// applies without decrypting.
  metadata       Json     @default("{}")
  /// encryptToken(JSON.stringify(payload)) — AES-256-GCM under the platform
  /// key (src/lib/tokenCrypto.ts). NEVER selected into a read surface:
  /// redaction by construction, same as the aiConfig / HA / Resend / MCP
  /// registries. Rotation is overwrite (updateSecret), no versioning (v1).
  valueEncrypted String?  @map("value_encrypted")
  /// Key-rotation lineage headroom; unused (null) while HADRON_ENCRYPTION_KEY
  /// is the only key.
  keyId          String?  @map("key_id")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String?  @map("created_by")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedBy      String?  @map("updated_by")
  /// #3997 (S2 of #3991): an App-owned secret keeps NO value here — its value is its newest `secret_versions` row
  /// (`chk_secret_app_value`: `(owner_type = 'app') = (value_encrypted IS NULL)`). Org and user rows are as before.
  /// Plain ids, so an agent's write is attributable to a worker as the grant tables do.
  createdByWorkerId  String? @map("created_by_worker_id")
  createdBySessionId String? @map("created_by_session_id")
  /// Only meaningful for App rows (`chk_secret_protected_app_only`); the protection ceremony is S4.
  protected      Boolean  @default(false)
  versions       SecretVersion[]

  // Hard delete by design (registry-row posture): a deleted secret makes
  // referencing runs fail their resolution loud — the wanted signal.
  // The unique doubles as the (ownerType, ownerId) lookup index.
  @@unique([ownerType, ownerId, name], map: "secrets_owner_name_uniq")
  @@map("secrets")
}

/// A Home Assistant installation that an Organization has registered, so that headless runs in the organization
/// can read its state and call its services.
///
/// Relationships: belongs to one Organization and is deleted with it. A flow node names an operation as
/// `ha__<slug>__<op>`; the reference is by slug, which is why the slug cannot be changed.
///
/// Behaviour: the same posture as McpServer. The row grants nothing by itself: every call goes through the
/// action-policy chain as `tool.ha__<slug>__<op>` and uses the run's action budget. `tokenEncrypted` is the
/// instance's long-lived access token and is write-only. `opAllowlist` limits the operations (empty: all), so
/// an administrator can register a read-only instance. A disabled instance's operations resolve as unknown.
/// Deleting is a hard delete.
///
/// Background: #640.
model HomeAssistantInstance {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// Run-tool name segment (`ha__<slug>__<op>`); lowercase [a-z0-9-],
  /// unique per org. Keep it short — provider tool-name caps are ~64 chars.
  slug           String
  name           String
  /// Home Assistant base URL (e.g. https://ha.example.com or a Nabu Casa
  /// remote URL). The tool refuses private-network hosts unless its
  /// HA_TOOL_ALLOW_PRIVATE_NETWORKS flag is set (self-hosted posture).
  url            String
  /// AES-256-GCM-encrypted long-lived access token
  /// (src/lib/tokenCrypto.ts). WRITE-ONLY on the API surface: resolvers
  /// never return it; update replaces it.
  tokenEncrypted String   @map("token_encrypted")
  /// Exposed-op allowlist over the closed HA_OPS catalog; empty = every op.
  /// Lets an admin register a READ-ONLY instance (no call_service).
  opAllowlist    String[] @default([]) @map("op_allowlist")
  /// Disabled instances fail run-tool resolution loud (unknown tool), same
  /// posture as an unregistered slug.
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String?  @map("created_by")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedBy      String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug], map: "home_assistant_instances_org_slug_uniq")
  @@map("home_assistant_instances")
}

/// An Organization's own Resend account for sending email: the sender address and the API key. When a run in
/// the organization sends mail, it is sent from this sender.
///
/// Relationships: at most one per Organization, deleted with it.
///
/// Behaviour: the server stores the API key encrypted and write-only. The stateless Resend capability tool
/// receives the key only for a send that has already been authorized. One sender per organization means the
/// credential used is never chosen by a model.
model ResendSender {
  id              String   @id @default(cuid())
  organizationId  String   @unique(map: "resend_senders_organization_id_uniq") @map("organization_id")
  /// Fixed sender identity accepted by Resend, e.g.
  /// `Hadron Agent <agent@example.com>`. Not secret.
  fromAddress     String   @map("from_address")
  /// AES-256-GCM-encrypted Resend sending-access API key
  /// (src/lib/tokenCrypto.ts). WRITE-ONLY on the API surface.
  apiKeyEncrypted String   @map("api_key_encrypted")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String?  @map("created_by")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("resend_senders")
}

/// One signup on the pre-launch waiting list of the marketing site: an email address and, optionally, what the
/// person would most like the product to do.
///
/// Relationships: none. It is not linked to User, because a signup happens before the person has an account.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:040:07.
model WaitingListItem {
  id                String   @id @default(cuid())
  email             String
  requestedFeatures String?  @map("requested_features")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("waiting_list")
}

// ─── Multi-user agent: Apps ────────────────────────────────────────────

/// One deployment of agents: the place where an organization or a person installs Agents and runs them. An App
/// is what authenticates to the platform, has members, holds its own data and settings, and has a team of
/// Workers. Where an Agent is a definition shared by all its installations, an App is one installation site with
/// its own identity and state.
///
/// Ownership: exactly one of `organizationId` and `ownerUserId` is set (`chk_app_owner_xor`). The App is
/// deleted with that organization or user.
///
/// Relationships:
/// - Agents: AppAgent lists the Agents installed in the App (many to many); AppAgentCustomization holds
///   per-installation settings.
/// - Credentials: AppKey rows are the App's API keys (`hdr_app_…`), each revocable by itself.
/// - People: AppMember rows are the App's members and their roles. `users` are the Users the App provisioned for
///   its own end users.
/// - Data: the App's Memories (app-class, and personal memories per user), Sessions, UsageEvents, AppLogEntry
///   rows, AiServiceConfigs (which override an Agent's defaults for this App) and `chatbotAiConfig`.
/// - Team: Workers (the named castings of installed Agents), AgentTasks, Tickers, AppGrant and Grant rows, host
///   registrations and
///   operations, alarms and their episodes, stop signals. `defaultChannel` is the App's team chat.
///
/// Behaviour:
/// - URN: unique among live installs only (`apps_urn_active_uniq WHERE uninstalled_at IS NULL`, in raw SQL). An
///   uninstalled App (`uninstalledAt`) is read-only history and the same URN can be installed again, so a lookup
///   of the active App must filter on `uninstalledAt: null`.
/// - Users and sessions: `createUserPermission` and `identifyUserMethod` say whether and how the App may create
///   and identify its end users. `sessionTimeoutSeconds`, `agentSessionsExpire` and `sessionDormancyDays` bound
///   the App's agent sessions.
/// - Policy: `policy` is the App's layer of the action-policy chain
///   (hrn:node:hadronmemory.com:specs:cor:acl:040:02), copied into each run when the run is created.
/// - Team settings: the `ticker*`, `delivery*` and `wake*` columns are the App's settings for waking its
///   workers and judging whether they respond (hrn:node:hadronmemory.com:specs:cor:agt:080:05). `teamPausedAt`
///   pauses the whole team. `sweepMode` and `hostSetupSource` govern how hosts keep worker processes running.
/// - `properties` is the App's own JSON object, written whole by whoever manages the App
///   (hrn:node:hadronmemory.com:specs:cor:dmo:050:20).
/// - Deleting an App deletes its keys, members, log entries and its app-class and personal memories. Removing
///   one member does not delete that member's personal memory.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:050:02. Lifecycle:
/// hrn:node:hadronmemory.com:specs:cor:dmo:050:21. Background (history, not law): the Spec Kit specs
/// 008-agent-installation, 021 and 023-app-shape.
model App {
  id                                String               @id @default(cuid())
  secretAppKeys                     SecretAppKey[]
  /// Display name.
  name                              String
  /// App-layer action-policy link (hrn:node:hadronmemory.com:specs:cor:acl:040:02) — same allow-list shape
  /// as Organization.policy; NULL = no restriction. Org-admin-authored
  /// (updateApp). Snapshotted into AppRun.policy at mint.
  policy                            Json?
  /// Globally unique identifier; derived from `org.urn + ":" + slug`.
  ///
  /// **Spec 021 (FR-027) — uniqueness is now PARTIAL.** The DB-level
  /// constraint is `apps_urn_active_uniq WHERE uninstalled_at IS NULL`
  /// (declared in the 021 migration). The same URN can legitimately
  /// appear on multiple rows: one active (`uninstalledAt IS NULL`)
  /// plus N uninstalled history rows. Prisma's field-level `@unique`
  /// declaration was REMOVED because it would generate a non-partial
  /// global unique index that fights with the migration.
  ///
  /// Callers MUST use `findFirst({ where: { urn, uninstalledAt: null } })`
  /// for active-row resolution per FR-028 resolution precedence; the
  /// `findUnique` callers in `resolvers.ts` were migrated to this
  /// pattern in PR #124.
  urn                               String
  organizationId                    String?              @map("organization_id")
  /// User owner of a user-owned App (rooted on the bare `<handle>` — #697 v2, no
  /// `@` sigil). The org/owner XOR is ENFORCED — `chk_app_owner_xor` in
  /// post-push.sql: `(organization_id IS NULL) <> (owner_user_id IS NULL)` — so
  /// exactly one of `organizationId`/`ownerUserId` is non-null.
  ownerUserId                       String?              @map("owner_user_id")
  ownerUser                         User?                @relation("AppOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createUserPermission              CreateUserPermission @default(EXPLICIT) @map("create_user_permission")
  identifyUserMethod                IdentifyUserMethod   @default(USER_ID) @map("identify_user_method")
  sessionTimeoutSeconds             Int                  @default(900) @map("session_timeout_seconds")
  /// Ruling DY-5: days of no activity after which a lapsed worker session of
  /// this App is DORMANT. No agent act resumes a dormant session (DA/DY-1);
  /// only an explicit rebind by its human holder brings the worker back. The
  /// security half of Holger's session-lifetime principle: a long-forgotten
  /// session must not start acting again on its own.
  sessionDormancyDays               Int                  @default(90) @map("session_dormancy_days")
  /// Ruling DY-3: whether `startAgentSession` stamps a hard `expiresAt` by
  /// default. False = this App's agent sessions have NO hard expiry unless the
  /// call asks for one (a caller-supplied `sessionTimeoutSeconds`, still capped
  /// by the App ceiling). A forgotten one is still bounded: past the App's
  /// `sessionDormancyDays` it no longer binds (`bindSession`, DY-5).
  agentSessionsExpire               Boolean              @default(true) @map("agent_sessions_expire")
  anonymousTtlDays                  Int                  @default(7) @map("anonymous_ttl_days")
  /// hrn:node:hadronmemory.com:specs:cor:agt:080:05 — the App's ticker settings (one set per App), changed only
  /// by whoever manages the App. Bounds are enforced in the write
  /// (`TICKER_SETTINGS_OUT_OF_RANGE`) and pinned by CHECK
  /// `chk_apps_ticker_settings` (prisma/ticker-invariants.sql).
  /// The cadence floor, also the wake-rate ceiling: >= 60.
  tickerMinCadenceSeconds           Int                  @default(120) @map("ticker_min_cadence_seconds")
  /// #2025 / hrn:node:hadronmemory.com:specs:cor:agt:080:05 — bounds: 1..86400 whole seconds.
  deliveryBusyDelaySeconds          Int                  @default(600) @map("delivery_busy_delay_seconds")
  /// Bounds: 1..604800; strictly greater than busy delay + cadence floor.
  deliveryStuckWindowSeconds        Int                  @default(900) @map("delivery_stuck_window_seconds")
  /// #2138 §3.2 — a worker with a task is expected to check its team channel every period (seconds);
  /// the team ticker's cadence is set together with it.
  deliveryCheckPeriodSeconds        Int                  @default(600) @map("delivery_check_period_seconds")
  /// #2138 §3.2 — OVERDUE after this many missed periods (+5 min slack, hard-coded); at least 1.
  deliveryFailedChecksToOverdue     Int                  @default(2) @map("delivery_failed_checks_to_overdue")
  /// #2755 — a worker's unacknowledged due wake raises the dark-worker alarm after this many seconds (300..86400;
  /// default 1800). Not `deliveryStuckWindowSeconds` (deprecated, hrn:node:hadronmemory.com:specs:cor:agt:050:26's window).
  deliveryDarkAlarmWindowSeconds    Int                  @default(1800) @map("delivery_dark_alarm_window_seconds")
  /// #2138 §3.6 — a TEAM pause, separate from every worker's own `pausedUntil`: a worker cannot lift
  /// it, and ending it never clears a self-pause. NULL = not paused.
  teamPausedAt                      DateTime?            @map("team_paused_at")
  /// #2138 §3.6 — when the last team pause ENDED; restarts every worker's check clock (the status is not OVERDUE the moment a pause lifts). NULL = never paused.
  teamResumedAt                     DateTime?            @map("team_resumed_at")
  /// #4224 (S3 of #4229) — the sweep switch (see SweepMode). OFF by default: one write restores today's behaviour.
  sweepMode                         SweepMode            @default(OFF) @map("sweep_mode")
  /// The fastest ticker a worker may subscribe ITSELF to: [floor, 86400].
  tickerSelfSubscribeCadenceSeconds Int                  @default(600) @map("ticker_self_subscribe_cadence_seconds")
  /// How many live tickers the App may have: [1, 100].
  tickerLiveCap                     Int                  @default(20) @map("ticker_live_cap")
  /// Null = derived (subscribed workers x (86400 / self-subscribe cadence) x 2).
  wakeDailyBudget                   Int?                 @map("wake_daily_budget")
  /// #3125 S1 (hrn:node:hadronmemory.com:specs:cor:dmo:050:02, hrn:node:hadronmemory.com:specs:cor:dmo:050:20): the App's own JSON object, the App equivalent of `Node.properties`.
  /// Written whole by whoever manages the App (`setAppProperties`); never a credential. The platform still reads and
  /// validates one reserved key, `taskIntegrations` (src/lib/appProperties.ts). The law has since retired that
  /// App-property integration in favour of the intake adapter contract (hrn:node:hadronmemory.com:specs:cor:agt:120:04);
  /// removing the key's handling is tracked in #4085. NULL = no properties. CHECK: an object when set.
  properties                        Json?                @map("properties")
  /// #3125 S1 (V34): moved by every changing `setAppProperties` write, the optional expected-revision check's counter.
  /// Its own column, not `updatedAt`, which every other App write moves.
  propertiesRevision                Int                  @default(0) @map("properties_revision")
  /// **Deprecated** — superseded by `surfaces`. Scheduled for removal
  /// in a follow-up cleanup spec (per 008 R-4); kept in place to
  /// avoid spurious portal churn.
  appType                           AppType              @default(WORKSTATION) @map("app_type")
  /// Default member role applied when the Agent's
  /// `installation_policy.memberRoles` doesn't apply.
  role                              AppMembershipRole    @default(READER)
  description                       String?
  /// Tools this App's agent can access; default `[]`.
  agentTools                        String[]             @default([]) @map("agent_tools")
  // 036-ai-service-config: the legacy ai_provider/ai_model/
  // ai_api_key_encrypted columns were dropped in favor of App-owned
  // AiServiceConfig rows (an App-owned config is the deploy-time override
  // that wins over the Agent's default in the resolution walk).
  expiresAt                         DateTime?            @map("expires_at")
  // 008-agent-installation introduced a direct App→Agent FK; 023-app-shape
  // Phase 2b dropped it in favor of the reintroduced N:M `AppAgent` join
  // (multi-Agent App per US1). The GraphQL `App.agentId` and `App.agent`
  // fields are kept as soft-deprecated convenience reads, resolved via
  // the first AppAgent row by helpers in `src/lib/appAgent.ts`.
  /// Migrated from the dropped `app_agents.training_mode`. Sessions
  /// through this App are flagged as training data for the Agent's
  /// owner to review. 008-agent-installation FR-022.
  trainingMode                      Boolean              @default(false) @map("training_mode")
  /// Free-form per 008 R-9; v1 known values: `'chat'`, `'slack'`,
  /// `'mcp'`, `'web'`. Surface enforcement (which features are gated
  /// on which surfaces) is handled by the portal/app code; chat-tab
  /// gating in hadron-portal#187 reads `surfaces.includes('chat')`.
  /// 008-agent-installation FR-014.
  surfaces                          String[]             @default(["chat"])
  // Standard audit fields
  createdAt                         DateTime             @default(now()) @map("created_at")
  createdBy                         String?              @map("created_by")
  updatedAt                         DateTime?            @updatedAt @map("updated_at")
  updatedBy                         String?              @map("updated_by")
  deletedAt                         DateTime?            @map("deleted_at")
  deletedBy                         String?              @map("deleted_by")

  /// Soft-uninstall timestamp per spec 021 FR-025. Null = active install;
  /// set = uninstalled (read-only, write-rejected with "app uninstalled"
  /// error including cascade to child agents/memories/nodes per FR-026).
  /// Reinstall after soft-uninstall is allowed via the partial unique index
  /// `apps_urn_active_uniq WHERE uninstalled_at IS NULL` (declared in the
  /// 021 migration; supersedes Prisma's @unique on urn at the DB level).
  uninstalledAt            DateTime? @map("uninstalled_at")
  /// Online URN-shape migration gate (spec 021 FR-032, repurposed for the #697
  /// v1→v2 emission flip; transient). Null = pre-normalization row (read
  /// through the legacy parser); set = row normalized onto the flat v2 form
  /// (`<root>:<slug>`, single colon). Dropped once 100% of rows are migrated.
  /// TODO(spec-021-cleanup): drop this column once the FR-032 migration
  /// completes — tracked under the spec-021 cleanup follow-up. The
  /// `apps_urn_migration_pending_idx` partial index goes with it.
  urnNormalizedAt          DateTime? @map("urn_normalized_at")
  /// Spec 021 sentinel for data-defect rows during the FR-032 migration.
  /// Non-null = the row's urn failed normalization; the migration job
  /// skips it on subsequent passes (avoids infinite retry). Transient;
  /// dropped with urnNormalizedAt.
  /// TODO(spec-021-cleanup): drop alongside urnNormalizedAt.
  urnMigrationFailedReason String?   @map("urn_migration_failed_reason")
  /// #697 stored alias map: the pre-v2 (v1) URN this row was migrated FROM
  /// (see Memory.legacyUrn). Null until the online migration flips `urn` to v2.
  legacyUrn                String?   @map("legacy_urn")

  organization            Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 023-app-shape Phase 2b: App↔Agent is N:M through AppAgent. The
  // direct `agent` relation is gone (dropped with `agentId`).
  appAgentCustomizations AppAgentCustomization[]
  appAgents               AppAgent[]
  /// #974 — this App's STAFF: the named castings of installed agents
  /// (hrn:node:hadronmemory.com:specs:cor:dmo:050:11). Distinct from `appAgents`: the roster join says an
  /// Agent is installed here; a Worker is who, by name, does attributable
  /// work.
  workers                 Worker[]
  /// #1705 — the App's agent tasks and their append-only event stream.
  agentTasks              AgentTask[]
  /// #3825 — latest decided match outcome per combination.
  matchOutcomes           AgentMatchOutcome[]
  agentTaskCounters       AgentTaskCounter[]
  /// #1747 — tickers (hrn:node:hadronmemory.com:specs:cor:agt:080) and the grants held by this App's workers.
  tickers                 Ticker[]
  appGrants               AppGrant[]
  wakeDays                AppWakeDay[]
  wakeReservations        AppWakeReservation[]
  agentTeamEvents         AgentTeamEvent[]
  darkWorkerEpisodes      DarkWorkerEpisode[]
  cadenceEpisodes         CoordinatorCadenceEpisode[]
  cadenceClocks           CoordinatorCadenceClock[]
  postLimitEpisodes       PostLimitEpisode[]
  startFailingEpisodes    StartFailingEpisode[]
  hostSweepRuns           HostSweepRun[]
  hostSweepEpisodes       HostSweepEpisode[]
  automationAdoptionEvents AutomationAdoptionEvent[]
  /// #2484 — this App's prefix-scoped write grants for its userless runs, and their append-only history.
  memoryWriteGrants       AppMemoryWriteGrant[]
  memoryWriteGrantEvents  AppMemoryWriteGrantEvent[]
  /// #2883 — this App's automation read grants and their append-only history.
  automationReadGrants    AppAutomationReadGrant[]
  automationReadGrantEvents AppAutomationReadGrantEvent[]
  automationTeamSnapshotGrants AppAutomationTeamSnapshotGrant[]
  automationTeamSnapshotGrantEvents AppAutomationTeamSnapshotGrantEvent[]
  /// #3668 — grants issued in this App, the grants THIS App holds, and the grant events.
  grants                  Grant[]      @relation("GrantApp")
  secretReadClients       SecretReadClient[]
  grantEvents             GrantEvent[]
  /// #1706 — model-family availability (hrn:node:hadronmemory.com:specs:cor:agt:060:03) and the stall schedule.
  modelFamilyAvailability ModelFamilyAvailability[]
  agentTaskStallSchedule  AgentTaskStallSchedule?
  /// #1707 — hosts that registered which workers they can launch (hrn:node:hadronmemory.com:specs:cor:agt:070:01).
  hostRegistrations       HostRegistration[]
  hostOperations          HostOperation[]
  /// #4222 (hrn:node:hadronmemory.com:specs:cor:agt:070:01) — who states which workers a host runs: `host` (the default: the host
  /// states it at registration, as before) or `server` (the platform's assignments; a registration is checked against
  /// them). Set by whoever manages the App. Shape: prisma/host-assignment-invariants.sql.
  hostSetupSource         String                 @default("host") @map("host_setup_source")
  hostWorkerAssignments   HostWorkerAssignment[]
  /// #2162 — the context resets of this App's workers.
  contextResets           ContextReset[]
  /// #2022 (S6, hrn:node:hadronmemory.com:specs:cor:agt:090) — the App's stop signals, live and ended.
  stopSignals             TeamStopSignal[]
  stopConsumerDeclarations StopConsumerDeclaration[]
  launchGrants            LaunchGrant[]
  /// #1956 — resume claims written before a deliberate context reset (hrn:node:hadronmemory.com:specs:cor:agt:020:03).
  resumeClaims            ResumeClaim[]
  sessionEndRequests      TaskSessionEndRequest[]
  mcpSessionStates        McpSessionState[]
  scopes                  Scope[]
  registerEntries         RegisterEntry[]           @relation("RegisterOwnerApp")
  readStates              ChannelReadState[]        @relation("ReadStateApp")
  /// Spec 049 Phase 4 (D-2026-09-13-007 D2): the App's DEFAULT Channel — the row the
  /// team chat became, what `teamChatMessages(appRef)` addresses and what an
  /// installed Agent's default register row points at. Set at App creation
  /// (`ensureDefaultChannel`) and by the Phase 4 backfill (the OLDEST live
  /// `chats:team` root, the resolver's own ordering). A nullable FK rather than a
  /// flag on the Channel: two defaults per App would be a state no CHECK refuses.
  defaultChannelId        String?                   @unique @map("default_channel_id")
  defaultChannel          Channel?                  @relation("AppDefaultChannel", fields: [defaultChannelId], references: [id], onDelete: SetNull)
  keys                    AppKey[]
  members                 AppMember[]
  memories                Memory[]                  @relation("AppMemories")
  users                   User[]
  sessions                Session[]
  logEntries              AppLogEntry[]
  usageEvents             UsageEvent[]
  pendingSetups           PendingSetup[]
  aiServiceConfigs        AiServiceConfig[] @relation("AppAiServiceConfigs")
  /// #3957 (hrn:node:hadronmemory.com:specs:cor:dmo:050:10): one of THIS App's own configs, used for its chats unless a chat stored its own
  /// choice. Same-App ownership and `enabled` are judged where it is read and written (a DB FK cannot say
  /// "owned by this App"); a deleted config clears it (`SetNull`).
  chatbotAiConfigId       String?           @map("chatbot_ai_config_id")
  chatbotAiConfig         AiServiceConfig?  @relation("AppChatbotAiConfig", fields: [chatbotAiConfigId], references: [id], onDelete: SetNull)
  modelGroups             ModelGroup[]
  automationVersions      AutomationVersion[]
  connectionGrants        ConnectionGrant[]         @relation("AppConnectionGrants")
  slackConnections        SlackConnection[]
  memoryConfigTemplates   MemoryConfigTemplate[]

  @@index([organizationId])
  // Spec 021 FR-027: keep `urn` lookups index-served. The DB-level
  // partial unique index `apps_urn_active_uniq` already covers active-row
  // queries; this @@index makes lookups across the full history (active
  // + uninstalled) also index-served. Prisma generates a non-unique
  // btree index on `urn`.
  @@index([urn])
  @@index([ownerUserId])
  @@index([legacyUrn])
  @@index([chatbotAiConfigId])
  @@map("apps")
}

/// An API key of an App. A request that presents the key acts as that App. An App can have several keys, and
/// each can be revoked without affecting the others.
///
/// Relationships: belongs to one App and is deleted with it. AppKeyScope rows limit what a key may do;
/// UsageEvents and HostKeyUse rows record what was done with it.
///
/// Behaviour:
/// - The raw key starts with `hdr_app_` and is shown once, when the key is created. Only its SHA-256 hash is
///   stored (`keyHash`), with the last four characters for display (`keyPreview`). SHA-256 and not a salted
///   password hash, because the authentication looks the key up by its hash, and the key is a 256-bit random
///   value that cannot be guessed from a dictionary.
/// - Authentication (src/middleware/auth.ts) accepts a bearer token with that prefix, finds the key by hash and
///   resolves the caller to the App. What the App may then read and write is decided by the access rules
///   (src/mcp/access-control.ts).
/// - A key with `revokedAt` set no longer authenticates. `lastUsedAt` records the last use.
/// - The CLI keeps the key in the `appKey` field of `.hadron/config.json`.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:050:05.
model AppKey {
  id         String    @id @default(cuid())
  appId      String    @map("app_id")
  /// SHA-256 hash of the raw `hdr_app_<…>` key.
  keyHash    String    @unique @map("key_hash")
  /// Last 4 characters of the raw key for masked display.
  keyPreview String    @map("key_preview")
  /// Human-friendly name for this key.
  label      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  app      App              @relation(fields: [appId], references: [id], onDelete: Cascade)
  scopes   AppKeyScope[]
  reads    AppKeyWakeRead[]
  hostUses HostKeyUse[]
  usageEvents UsageEvent[]

  @@index([appId])
  @@map("app_keys")
}

/// The membership of one User in one App, with the member's role there. It is what makes a person a member of an
/// App.
///
/// Relationships: joins App and User, one row per pair (the primary key), and is deleted with either.
///
/// Behaviour:
/// - `role` is a free string. When it is written it must be a role the App offers: the union of the
///   `memberRoles` in the `installationPolicy` of every Agent installed in the App (for example `owner`, `guide`,
///   `cook`). An App with no installed Agent accepts no members (src/controller/operations/ensureAppMember.ts).
/// - The member limit is the `maxMembers` of the App's primary Agent, which is the Agent of the App's oldest
///   AppAgent row (`getPrimaryAgentId`, src/lib/appAgent.ts). It is checked when a new member row is
///   inserted, not when an existing member's role changes.
/// - There is no `deletedAt`, no expiry and no revocation column: removing a member deletes the row.
/// - Removing a member keeps that user's personal memory for the App. It is found again if the user later
///   rejoins the same App.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:050:04. Background (history, not law): the Spec Kit spec
/// 008-agent-installation.
model AppMember {
  appId     String    @map("app_id")
  userId    String    @map("user_id")
  // Free-form string per R-7. Validated at write-time against the parent
  // Agent's installation_policy.memberRoles (e.g., ['owner', 'guide']).
  /// Free-form string validated at write-time against the parent
  /// Agent's `installation_policy.memberRoles` (per 008 R-7). Examples:
  /// `'owner'`, `'guide'`, `'cook'`. `installation_policy.maxMembers`
  /// is enforced at invite-acceptance time (per FR-016).
  role      String
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  app  App  @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User @relation("UserAppMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([appId, userId])
  @@index([userId])
  @@map("app_members")
}

/// An Organization's permission to use an Agent: to install it in the organization's Apps, and to import it into
/// Agents the organization owns. It is the organization-level counterpart of AgentSubscription, which is a
/// user's permission to use an Agent.
///
/// Relationships: joins Organization and Agent, one row per pair (the primary key), and is deleted with either.
/// An AgentImport names the grant that authorizes it.
///
/// Behaviour:
/// - An organization using its own Agent gets the grant automatically on first use (`ensureAgentOrgGrant`).
///   Using another organization's Agent needs an active grant; for a PUBLIC Agent an organization can create one
///   (`createAgentOrgGrant`).
/// - Active means: `activatedAt` is set, `revokedAt` is null, and `expiresAt` is null or in the future. The same
///   test is used for AgentSubscription (`isLifecycleActive`).
/// - An administrator or owner of the Agent's organization revokes a grant (`revokeAgentOrgGrant`).
/// - There is no `deletedAt`; `revokedAt` is the end of the grant's life.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:050:07. Background (history, not law): the Spec Kit spec
/// 008-agent-installation.
model AgentOrgGrant {
  orgId       String    @map("org_id")
  agentId     String    @map("agent_id")
  /// v1 default: `now()` on creation since billing is out of scope.
  activatedAt DateTime? @map("activated_at")
  expiresAt   DateTime? @map("expires_at")
  /// Set by an ADMIN/OWNER of the Agent's owning org via
  /// `revokeAgentOrgGrant`.
  revokedAt   DateTime? @map("revoked_at")
  /// fk to User.id — audit trail for who revoked.
  revokedBy   String?   @map("revoked_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  imports      AgentImport[]

  @@id([orgId, agentId])
  @@index([agentId])
  @@map("agent_org_grants")
}

/// A dependency of one Agent on another: the parent Agent imports the other Agent, so that installing the parent
/// brings the imported Agent with it. It is how a suite of agents is assembled from existing ones.
///
/// Relationships: `parentAgent` is the Agent that imports and `importedAgent` the one imported; one row per pair
/// (the primary key). Deleting the parent deletes the import. An imported Agent cannot be deleted while an
/// import names it. `agentOrgGrant` is the AgentOrgGrant that allows the parent's organization to use the
/// imported Agent, and it cannot be deleted while the import exists.
///
/// Behaviour:
/// - An App that installs the parent also has its imported Agents: the required ones always, the optional ones
///   (`required = false`) only when the installer chooses them.
/// - Imports are one level deep: an imported Agent must not itself import anything. An Agent cannot import
///   itself.
/// - `position` orders the imports of one parent and is unique per parent. Values are spaced out (100, 200, …)
///   so an import can be moved without renumbering the others.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:050:06. Background (history, not law): the Spec Kit spec
/// 008-agent-installation.
model AgentImport {
  /// The Agent that does the importing (the "Suite"). ON DELETE
  /// CASCADE.
  parentAgentId        String   @map("parent_agent_id")
  /// The dep Agent. ON DELETE RESTRICT — deleting it would
  /// invalidate every Suite that depends on it; operators must
  /// remove the import edge first.
  importedAgentId      String   @map("imported_agent_id")
  /// Sparse-int ordering (per 008 R-8). Builders set values like
  /// 100, 200, 300 to allow easy reordering without renumbering.
  position             Int
  /// Hard dep vs optional. Default `true`.
  required             Boolean  @default(true)
  /// Composite fk to `AgentOrgGrant(orgId, agentId)` (ON DELETE
  /// RESTRICT) — the Builder grant authorizing this import. Spec
  /// FR-005 named this column `agent_subscription_id`; renamed per
  /// 008 R-2 since the universal-grant role for org-level grants
  /// lives on the new `AgentOrgGrant` sibling, not `AgentSubscription`.
  agentOrgGrantOrgId   String   @map("agent_org_grant_org_id")
  agentOrgGrantAgentId String   @map("agent_org_grant_agent_id")
  createdAt            DateTime @default(now()) @map("created_at")
  createdBy            String?  @map("created_by")

  parentAgent   Agent         @relation("ParentAgent", fields: [parentAgentId], references: [id], onDelete: Cascade)
  importedAgent Agent         @relation("ImportedAgent", fields: [importedAgentId], references: [id], onDelete: Restrict)
  agentOrgGrant AgentOrgGrant @relation(fields: [agentOrgGrantOrgId, agentOrgGrantAgentId], references: [orgId, agentId], onDelete: Restrict)

  @@id([parentAgentId, importedAgentId])
  @@unique([parentAgentId, position]) // prevents two imports at the same position under the same parent
  @@index([importedAgentId])
  @@map("agent_imports")
}

/// A User's permission to use an Agent. It is what allows the Agent, which may belong to another organization,
/// to write to that user's personal memory, and
/// it is the user-level counterpart of AgentOrgGrant.
///
/// Relationships: joins User and Agent, one row per pair (the primary key), and is deleted with either.
///
/// Behaviour:
/// - Created automatically the first time work is attributed to the user through the Agent
///   (src/controller/operations/ensureAgentSubscription.ts).
/// - Active means: `activatedAt` is set, `revokedAt` is null, and `expiresAt` is null or in the future
///   (`isLifecycleActive`). `activatedAt` is set at creation today.
/// - An administrator or owner of the Agent's organization revokes a subscription (`revokeAgentSubscription`).
/// - After a revocation the user's personal memory of the Agent is kept: the user owns it and can still read it,
///   the Agent can no longer write to it, and `Memory.userMemoryOfAgentId` still says which Agent it came from.
///   One exception: a personal memory with no nodes at the time of the revocation may be deleted with the
///   subscription.
/// - There is no `deletedAt`; `revokedAt` is the end of the subscription's life.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:050:08. Background (history, not law): the Spec Kit spec
/// 005-agent-subscription.
model AgentSubscription {
  userId      String    @map("user_id")
  agentId     String    @map("agent_id")
  // Lifecycle. v1 default: activatedAt = now() on creation. Future billing
  // work introduces a deferred-activation path (activatedAt = null until
  // payment confirms).
  /// v1 default: `now()` on creation since billing is out of scope;
  /// future billing introduces a deferred-activation path
  /// (activatedAt = null until payment confirms).
  activatedAt DateTime? @map("activated_at") @db.Timestamptz()
  /// Time-bounded subscriptions; NULL for non-expiring.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz()
  /// Set by an ADMIN/OWNER of the Agent's owning org via
  /// `revokeAgentSubscription`.
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz()
  /// fk to User.id — audit trail.
  revokedBy   String?   @map("revoked_by")
  // Standard audit fields. (No deletedAt — soft-delete is redundant with
  // the revokedAt lifecycle; if a row needs to truly disappear it's a
  // hard delete.)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz()
  updatedBy   String?   @map("updated_by")

  user  User  @relation("UserAgentSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  agent Agent @relation("AgentUserSubscriptions", fields: [agentId], references: [id], onDelete: Cascade)

  @@id([userId, agentId])
  @@index([agentId])
  @@map("agent_subscriptions")
}

/// A log entry about one App, kept in the database so that whoever manages the App can see what went wrong in
/// it.
///
/// Relationships: belongs to one App and is deleted with it. `memoryId` and `sessionId` are set when the entry
/// is about one memory or session; they are plain values with no foreign key.
///
/// Behaviour: server code writes entries as diagnostics, for example when a worker's check of its team channel
/// finds a problem (src/api/graphql/schema/resolvers.deliveryBatch.ts). Such a write is best-effort and happens
/// after the transaction of the work it describes, so a failed log write never fails that work.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:080:03.
model AppLogEntry {
  id        String    @id @default(cuid())
  appId     String    @map("app_id")
  level     LogLevel
  memoryId  String?   @map("memory_id")
  sessionId String?   @map("session_id")
  /// Human-readable log message.
  message   String
  /// Structured context.
  detail    Json?
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([appId, createdAt])
  @@index([level])
  @@index([createdAt])
  @@map("app_log")
}

// ─── 023-app-shape: multi-Agent App + per-Memory authorization ─────────

/// The App-level customisation of one Agent that an App has through an import: today, the boot prompt the App
/// uses for that Agent. An Agent that arrives in an App as the import of another Agent has no AppAgent row to
/// hold this, so it is held here.
///
/// Relationships: joins App and Agent, one row per pair (the primary key), and is deleted with either.
///
/// Behaviour: this row is not an installation. Whether an Agent is installed in an App is decided only by
/// AppAgent and AgentImport. `bootPromptNodeId` and `bootPromptUrn` are a boot-prompt pointer of the same kind
/// as `AppAgent.bootPromptNodeId`: the id of a compiled boot-prompt node with no foreign key, and its URN at the
/// time it was set. The row outlives the deletion of the install memory or of the compiled node, so a pointer
/// whose target was deleted is still refused as a deleted target and is not read as "no pointer".
///
/// Background: #2168.
model AppAgentCustomization {
  appId String @map("app_id")
  agentId String @map("agent_id")
  bootPromptNodeId String? @map("boot_prompt_node_id")
  bootPromptUrn String? @map("boot_prompt_urn")
  app App @relation(fields:[appId],references:[id],onDelete:Cascade)
  agent Agent @relation(fields:[agentId],references:[id],onDelete:Cascade)
  @@id([appId,agentId])
  @@index([bootPromptNodeId])
  @@map("app_agent_customizations")
}

/// The installation of one Agent in one App. A row here is what "this Agent is installed in this App" means; an
/// App can install several Agents, and an Agent can be installed in many Apps.
///
/// Relationships: joins App and Agent, one row per pair (the primary key), and is deleted with either. The
/// Workers of an App are cast from Agents installed in it.
///
/// Behaviour:
/// - Installing goes through `installAgentIntoApp`, which writes the row. Uninstalling deletes it; there is no
///   soft delete. The memories that exist for the pair are not deleted with it.
/// - There is no role column: an Agent's system memory is read-only from every App. Training mode is a setting
///   of the App (`App.trainingMode`), not of one installation.
/// - `bootPromptNodeId` and `bootPromptUrn` point at the installation's compiled boot prompt
///   (hrn:node:hadronmemory.com:specs:cor:agt:040:07). Because uninstalling deletes the row, a reinstall starts
///   without a pointer until the App's manager compiles again
///   (hrn:node:hadronmemory.com:specs:cor:agt:040:06).
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:050:03. Background (history, not law): the Spec Kit spec
/// 023-app-shape.
model AppAgent {
  appId            String    @map("app_id")
  agentId          String    @map("agent_id")
  // Audit fields mirror AppMember (no soft-delete). Uninstall is a
  // hard row delete; predicate lookups use `findUnique` on the
  // composite PK with no filter.
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by")
  /// #2045 (S8, hrn:node:hadronmemory.com:specs:cor:agt:040:07) — the install's boot-prompt POINTER: the id of a
  /// compiled boot-prompt node (`nodeType = 'compiled-boot-prompt'`), never its
  /// source. NO foreign key: nodes are hard-deleted on some paths (deleteNode
  /// hard/subtree, memory merge, git-sync cleanup), and SET NULL would turn a
  /// deleted target (R27) into "no pointer" (R26) while RESTRICT would block
  /// those deletes. `bootPromptUrn` is the target's canonical URN at write time,
  /// read only when the row is gone; both are set or both NULL
  /// (chk_*_boot_prompt_pointer_pair, prisma/boot-prompt-pointer-invariants.sql).
  /// Written only through `setBootPromptPointer` (src/lib/bootPromptPointer.ts).
  /// The row is hard-deleted on uninstall, so a reinstall starts empty until
  /// the App's manager next compiles (hrn:node:hadronmemory.com:specs:cor:agt:040:06, hrn:node:hadronmemory.com:specs:cor:dmo:050:03).
  bootPromptNodeId String?   @map("boot_prompt_node_id")
  bootPromptUrn    String?   @map("boot_prompt_urn")

  app   App   @relation(fields: [appId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([appId, agentId])
  @@index([agentId])
  @@index([bootPromptNodeId])
  @@map("app_agents")
}

/// A named member of a team: one Agent that is installed in an App, cast under a name of its own (for example
/// "Iris"). The Agent carries the reusable part, its persona role and compiled boot prompt. The Worker is the local
/// identity that work is attributed to: sessions, chat posts, agent tasks and commit trailers name the Worker.
///
/// Relationships: belongs to one App and is deleted with it. `agent` is the Agent it casts (Restrict: an Agent that
/// is cast cannot be hard-deleted from under it). `memory` is the worker's own working memory, provisioned at cast;
/// it is identified by `memoryId`, never by its URN. `heldBy` is the User who holds the name (SetNull: deleting the
/// user releases the name and keeps the casting). `reportsTo` is another Worker of the same App. Sessions,
/// AgentTasks, RegisterEntry and ChannelReadState rows, availability, wake and delivery records, host operations,
/// context resets and stop signals point at the Worker. `bootPromptNodeId` is a plain node id with no foreign key,
/// because nodes are hard-deleted on some paths; `retiredBy` and `leaveAloneBy` are plain user ids that record who
/// acted.
///
/// Behaviour:
/// - Casting is opt-in: an installed Agent with no Worker row is just an Agent. The Agent must be installed in the
///   App at cast time, and several Workers may cast the same Agent in one App.
/// - `name` is unique per App, case-insensitively: the functional unique index `workers_app_name_uniq` on `(app_id,
///   lower(name))` in prisma/post-push.sql, which Prisma cannot express. The index is not filtered on retirement. A
///   name binds to one casting forever, because commit trailers and chat archives refer to it and a reused name would
///   attribute old work to someone else.
/// - `slug` is the last part of the worker's URN (`hrn:worker:<root>:<app-slug>:<slug>`). It is derived from the name
///   at cast and never changes. It is unique per App (`workers_app_slug_uniq`), and the mint tries `-2`, `-3` and so
///   on instead of refusing, so the name stays the only collision a caller can see.
/// - A name is held by a person (`heldByUserId`, `heldAt`) until it is released. A session that ends or expires never
///   frees it, and the next bind of an unheld worker holds it (hrn:node:hadronmemory.com:specs:cor:agt:020:09).
/// - Workers retire (`retiredAt`); there is no soft delete. A retired worker cannot author and refuses new session
///   bindings, and its name stays reserved. A row is hard-deleted in three cases only: `deleteWorker` on a released
///   casting that nothing refers to, the cascade when its App is deleted, and the erasure of the account that owns
///   its Agent (src/controller/operations/deleteUser.ts).
/// - `signature` and `trailer` are templates the platform fills in and delivers at each bind
///   (hrn:node:hadronmemory.com:specs:cor:agt:040:04). `bootPromptNodeId` and `bootPromptUrn` are set only for a
///   customised worker, both or neither, and only through `setBootPromptPointer`
///   (hrn:node:hadronmemory.com:specs:cor:agt:040:07).
/// - `reportsToWorkerId` is a property of the casting, not of a session: a non-retired Worker of the same App, never
///   itself and never a cycle. It is written only by src/lib/workerReportsTo.ts, which also appends the event that
///   keeps its history.
/// - `terminal` is the latest report a host made about the worker's terminal; it is stored and shown, and decides
///   nothing. `leaveAlone` tells the host sweep to observe the worker and never start, stop or repair it.
///   `lastUsedFamily`, `lastUsedModel` and `lastUsedEffort` are what the worker's session last reported: a report,
///   not a control.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:050:11. Rules:
/// hrn:node:hadronmemory.com:specs:cor:agt:020:01, hrn:node:hadronmemory.com:specs:cor:agt:020:02. Background: #974,
/// #991, #1050, #1726, #2045, #2771, #4041, #4224, #4291.
model Worker {
  id                String    @id @default(cuid())
  darkWorkerEpisodes DarkWorkerEpisode[]
  cadenceEpisodes    CoordinatorCadenceEpisode[]
  cadenceClock       CoordinatorCadenceClock?
  postLimitEpisodes PostLimitEpisode[]
  startFailingEpisodes StartFailingEpisode[]
  appId             String    @map("app_id")
  agentId           String    @map("agent_id")
  /// The worker's name ("Iris") — the identity every surface renders.
  name              String
  /// #991 — the URN atom: `hrn:worker:<root>:<app-slug>:<slug>`. DERIVED from
  /// `name` at cast time (`deriveSlugFromName`, then `-2`/`-3`… until free in
  /// the App) and permanent thereafter — there is no rename mutation, and the
  /// name it was derived from is itself permanent (hrn:node:hadronmemory.com:specs:cor:agt:020:02).
  ///
  /// This is a SECOND stored uniqueness (`workers_app_slug_uniq`), which
  /// hrn:node:hadronmemory.com:specs:cor:agt:020:02 otherwise forbids — the distinction that makes it legal is
  /// that it NEVER REFUSES: the mint iterates instead of erroring, so the name
  /// collision stays the single allocation primitive a caller can observe. That
  /// is exactly what the reverted mention-token unique (PR #979) did not do.
  /// The index exists so a race between two casts deriving one base slug cannot
  /// produce two workers sharing a URN.
  slug              String
  /// The cast-list role this filling answers ("backend-engineer").
  /// Free string with conventions; defaults to the agent's `personaRole`
  /// at cast time when the caller names none.
  role              String?
  /// Per-worker signature template, delivered through S4 (hrn:node:hadronmemory.com:specs:cor:agt:040:04).
  signature         String
  /// Per-worker commit trailer template, delivered through S4 (hrn:node:hadronmemory.com:specs:cor:agt:040:04).
  trailer           String
  /// #2045 (S8, hrn:node:hadronmemory.com:specs:cor:agt:040:07) — this worker's boot-prompt POINTER: the id of a
  /// compiled boot-prompt node (`nodeType = 'compiled-boot-prompt'`), never its
  /// source. NO foreign key: nodes are hard-deleted on some paths (deleteNode
  /// hard/subtree, memory merge, git-sync cleanup), and SET NULL would turn a
  /// deleted target (R27) into "no pointer" (R26) while RESTRICT would block
  /// those deletes. `bootPromptUrn` is the target's canonical URN at write time,
  /// read only when the row is gone; both are set or both NULL
  /// (chk_*_boot_prompt_pointer_pair, prisma/boot-prompt-pointer-invariants.sql).
  /// Written only through `setBootPromptPointer` (src/lib/bootPromptPointer.ts).
  /// Set for customised workers only, empty otherwise (hrn:node:hadronmemory.com:specs:cor:dmo:050:11).
  bootPromptNodeId  String?   @map("boot_prompt_node_id")
  bootPromptUrn     String?   @map("boot_prompt_urn")
  /// #974 — the worker-scoped working memory in the App's container
  /// (`hrn:mem:<owner>:<app-slug>:<worker-slug>`), provisioned at cast.
  /// Identity is THIS column, never the memory's URN (the #723 rule).
  memoryId          String?   @map("memory_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")
  /// #1050 — the HUMAN holding this name. A name is held by a person, not by a
  /// live session: expiry, a reap, or a closed chat session never free it, and
  /// only an explicit release does.
  ///
  /// This is what separates the two meanings of "taken" that used to share one
  /// word (hadron-cli#487). HELD = the name belongs to someone; the answer to a
  /// second person wanting it is to cast their own, never to adjudicate whether
  /// the first is "really gone". TAKEN = a live session exists, which is only
  /// ever a question about your OWN worker. Deriving availability from session
  /// liveness is what let an agent end a mid-PR driver's session and bind as
  /// them, every step following the documented procedure (hadron-cli#492).
  ///
  /// Nullable because a released worker is genuinely unheld — and because a
  /// worker cast before this column existed has a holder only by backfill from
  /// `createdBy`. The next bind of an unheld worker holds it.
  heldByUserId      String?   @map("held_by_user_id")
  /// When the current hold was taken — provenance for a release decision, and
  /// what an admin force-release reports.
  ///
  /// Both platform write paths (`releaseWorker`, `deleteUserAccount`) clear
  /// this together with `heldByUserId`, but the FK's ON DELETE SET NULL clears
  /// only the id, so a RAW hard delete of a user can leave a vestigial
  /// timestamp here. `Worker.heldAt` therefore masks it to null whenever there
  /// is no holder, so the API invariant — heldAt is set exactly when
  /// heldByUserId is — holds because it is enforced rather than remembered. A
  /// CHECK cannot do that job: it would make the FK's own SET NULL violate it.
  heldAt            DateTime? @map("held_at")
  /// Retirement instant — the name stays reserved forever (hrn:node:hadronmemory.com:specs:cor:agt:020:02).
  /// A retired worker stops authoring (team chat's worker-App pin checks
  /// retirement at post time) and refuses new session bindings.
  retiredAt         DateTime? @map("retired_at")
  retiredBy         String?   @map("retired_by")
  /// #1726 — the one Worker this worker reports to (Holger, 2026-10-09): a
  /// non-retired Worker of the same App, never itself, and never a cycle. Null
  /// reports to nobody (the top of a team, or an unclaimed worker). A property
  /// of the casting, not of a session: binding, rotating or ending a session
  /// leaves it alone. Written only by `src/lib/workerReportsTo.ts`, which
  /// also appends the `worker.reports-to` event that keeps its history.
  reportsToWorkerId String?   @map("reports_to_worker_id")
  /// S12: explicit human choice; false + null reportsTo is UNSET, never inferred NO_TEAM.
  explicitNoTeam Boolean @default(false) @map("explicit_no_team")
  /// #2771 (proposed hrn:node:hadronmemory.com:specs:cor:agt:070:09) — the latest terminal report a HOST made for this worker, built by the server
  /// (`src/lib/workerTerminal.ts`): host {id,label}, status, prompt, reason (a closed code), lastTurnAt, checkedAt,
  /// reportedAt. Null until a host first reports. A stored report that DECIDES NOTHING: it feeds no `checkStatus`,
  /// availability, matcher, stall rule or alarm. No screen text is ever stored; `chk_workers_terminal_shape` (in
  /// prisma/host-operation-invariants.sql) allows exactly the keys above, so a write that bypasses the resolver still
  /// cannot store more. Read behind `maySeeWorkerInternals` (hrn:node:hadronmemory.com:specs:cor:dmo:050:11).
  /// #4225 S4a — the object also carries `contextTokens` and `contextMeasuredAt` (the worker's context size as its
  /// host measured it; both null when the host cannot measure, never 0; absent on a row stored before #4225).
  /// #4247 — and, for a refused or failed relaunch only, `repair` (RELAUNCH_REFUSED | RELAUNCH_FAILED), `repairReason` and
  /// `repairAttempt`: all three or none (the other repair outcomes are not stored).
  terminal Json? @map("terminal")
  /// #4041 (V82) — the last host repair notice the PLATFORM posted for this worker, set in the post's own append
  /// transaction: a space-separated set of alert tokens (`alert` for a no-snapshot / cap-reached alert, `<outcome>:<reason>` for a refused or
  /// failed relaunch), each once per episode until a report without a repair outcome or with a relaunch, or `relaunched:<checkedAt>` (so a replayed relaunch report posts nothing twice). Never read by a client.
  repairNoticeKey String? @map("repair_notice_key")
  /// #4224 (S3 of #4229) — the leave-alone marker: the host sweep observes and reports this worker but never starts,
  /// stops or repairs it. Set and cleared by whoever manages the App (`setWorkerLeaveAlone`), each change one
  /// `worker.leave-alone-changed` team event. The reason, the user who last set it and when are set together with
  /// the marker and cleared with it (chk_workers_leave_alone_shape, prisma/desired-state-invariants.sql).
  leaveAlone       Boolean   @default(false) @map("leave_alone")
  leaveAloneReason String?   @map("leave_alone_reason")
  /// The user who set the marker (the manager, or the holder a worker acted on the instruction of). A bare id, no FK:
  /// a record of who acted, like `retiredBy`.
  leaveAloneBy     String?   @map("leave_alone_by")
  leaveAloneAt     DateTime? @map("leave_alone_at")
  /// #4291 (decisions 2 and 8) — the worker's record of its run settings: the family, model and effort its session last
  /// reported, one value each and no history. A REPORT, not a control: written only from a session's bind or report
  /// (src/lib/agentTasks/runSettings.ts `recordRunSettings`), never cleared by a null, kept when the worker unbinds. A
  /// start reads it after the task's own setting (hrn:node:hadronmemory.com:specs:cor:agt:070:08); an unbound worker is matched on it (hrn:node:hadronmemory.com:specs:cor:agt:060:04).
  lastUsedFamily   String?      @map("last_used_family")
  lastUsedModel    String?      @map("last_used_model")
  lastUsedEffort   EffortLevel? @map("last_used_effort")

  app                  App                       @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// SetNull: a worker row is never hard-deleted in normal operation, but an
  /// App cascade must not fail on the self-reference.
  reportsTo            Worker?                   @relation("WorkerReportsTo", fields: [reportsToWorkerId], references: [id], onDelete: SetNull)
  reports              Worker[]                  @relation("WorkerReportsTo")
  agent                Agent                     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  memory               Memory?                   @relation("WorkerMemory", fields: [memoryId], references: [id], onDelete: SetNull)
  /// SetNull, not Cascade: a deleted user's held names must be RELEASED, never
  /// take the castings (and their worklog and handoff history) with them.
  heldBy               User?                     @relation("WorkerHolder", fields: [heldByUserId], references: [id], onDelete: SetNull)
  sessions             Session[]                 @relation("SessionWorker")
  /// Spec 049 Phase 5 — register rows naming this Worker as the attendee.
  registerAttendeeOf   RegisterEntry[]           @relation("RegisterAttendeeWorker")
  readStates           ChannelReadState[]        @relation("ReadStateWorker")
  /// #1705 — agent tasks this worker owns / is assigned.
  ownedAgentTasks      AgentTask[]               @relation("AgentTaskOwnerWorker")
  assignedAgentTasks   AgentTask[]               @relation("AgentTaskAssigneeWorker")
  /// #1706 — availability for work (hrn:node:hadronmemory.com:specs:cor:agt:060:02).
  availability         WorkerAvailability?
  /// #1747 — ticker subscriptions, wake settings, delivery record, grants held.
  tickerSubscriptions  TickerSubscription[]
  wakeSettings         WorkerWakeSettings?
  deliveryChannels     WorkerDeliveryChannel[]
  deliveryTicks        WorkerDeliveryTick[]
  deliveryTaskEvents   WorkerDeliveryTaskEvent[]
  wakeAcks             WorkerWakeAck[]
  wakeReservation      AppWakeReservation?
  appGrants            AppGrant[]
  launchableVia        HostRegistrationWorker[]
  hostOperations       HostOperation[]
  hostAssignments      HostWorkerAssignment[]
  /// #2162 — this worker's context resets (hrn:node:hadronmemory.com:specs:cor:agt:050:27).
  contextResets        ContextReset[]
  /// #2022 — worker- and team-scope stop signals naming this worker as target.
  stopSignalsTargeting TeamStopSignal[]

  /// The URN atom's uniqueness. Unfiltered on retirement, like
  /// `workers_app_name_uniq`: a retired worker's URN must keep resolving.
  @@unique([appId, slug], map: "workers_app_slug_uniq")
  /// #4222: the target of host_worker_assignments' (worker_id, app_id) key; unique trivially (id is the key).
  @@unique([id, appId], map: "workers_host_assignment_owner_uniq")
  @@index([appId])
  @@index([agentId])
  /// #1050 — "what does this person hold", across Apps.
  @@index([heldByUserId])
  @@index([reportsToWorkerId])
  @@index([bootPromptNodeId])
  @@map("workers")
}

/// A grant by the owner of a personal memory that lets one other user into it, as a reader or as a writer. It is the
/// only way someone other than the owner reaches a personal memory.
///
/// Relationships: `memory` is the shared Memory, `grantee` the User who receives access, `grantor` the User the grant
/// is made on behalf of. One row per memory and grantee (the primary key). The row is deleted with the memory, the
/// grantee or the grantor.
///
/// Behaviour:
/// - Applies only to memories of class `personal`; `createMemoryShare` refuses every other class. The check is in the
///   operation, not in the database.
/// - `grantorId` is always the memory's owner (`Memory.userId`), stored on the row so it can be read without a join.
///   Whoever made the API call, which may be an App backend acting for the owner, is recorded in `createdBy`.
/// - A personal memory that an organization owns can be shared only with a current member of that organization.
/// - There is no time window. To keep grantees apart over time, a new personal memory is made for each pairing.
/// - `role` can be changed (`updateMemoryShareRole`). Revoking deletes the row; there is no soft delete.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:060:08. Background (history, not law): the Spec Kit spec
/// 023-app-shape. Background: #778.
model MemoryShare {
  memoryId  String          @map("memory_id")
  granteeId String          @map("grantee_id")
  grantorId String          @map("grantor_id")
  role      MemoryShareRole
  // Audit fields (no soft-delete). Revoke is a hard row delete (FR-022);
  // predicate lookups use `findUnique` on the composite PK.
  createdAt DateTime        @default(now()) @map("created_at")
  createdBy String?         @map("created_by")
  updatedAt DateTime?       @updatedAt @map("updated_at")
  updatedBy String?         @map("updated_by")

  memory  Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  grantee User   @relation("MemorySharesGranted", fields: [granteeId], references: [id], onDelete: Cascade)
  grantor User   @relation("MemorySharesByGrantor", fields: [grantorId], references: [id], onDelete: Cascade)

  @@id([memoryId, granteeId])
  @@index([granteeId])
  @@index([grantorId])
  @@map("memory_shares")
}

/// One user's membership in a group memory, with a role. Membership is what decides who is in a team-shared memory
/// and what each person may do there.
///
/// Relationships: joins Memory and User, one row per pair (the primary key), and is deleted with either.
///
/// Behaviour:
/// - Applies only to memories of class `group`; `addMemoryMember` refuses every other class. The check is in the
///   operation, not in the database.
/// - `role`: `reader` may read; `writer` may also write nodes in the memory; `owner` may also manage the member list,
///   rename or delete the memory and change its configuration.
/// - The last remaining `owner` cannot be removed or demoted. `removeMemoryMember` and `updateMemoryMemberRole`
///   enforce this; the database would allow the delete.
/// - Removing a member deletes the row; there is no soft delete. Removing the last member who is not an owner does
///   not delete the memory.
/// - Rows are also written when a group memory is created, cloned, extracted from a subtree or transferred.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:060:07. Background (history, not law): the Spec Kit spec
/// 023-app-shape.
model MemoryMember {
  memoryId  String           @map("memory_id")
  userId    String           @map("user_id")
  role      MemoryMemberRole
  // Audit fields (no soft-delete). Remove is a hard row delete (FR-038
  // protects the last owner; non-owner removal is unrestricted);
  // predicate lookups use `findUnique` on the composite PK.
  createdAt DateTime         @default(now()) @map("created_at")
  createdBy String?          @map("created_by")
  updatedAt DateTime?        @updatedAt @map("updated_at")
  updatedBy String?          @map("updated_by")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user   User   @relation("MemoryMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([memoryId, userId])
  @@index([userId])
  @@map("memory_members")
}

/// An API key that authenticates a caller as one user. It is the credential behind user-scoped access, MCP in
/// particular, and the counterpart of AppKey, which authenticates as an App.
///
/// Relationships: belongs to one User and is deleted with the user. `mintedByKey` is the UserApiKey that was used to
/// create this one, and `mintedKeys` the keys created with it. `originSignIn` is the SignIn this key descends from,
/// when it has one; the composite key (`originSignInId`, `userId`) makes sure both belong to the same user.
///
/// Behaviour:
/// - The raw key is `hdr_user_` followed by random characters and is shown once. Only its SHA-256 hash is stored
///   (`keyHash`, unique), plus the last four characters for display (`keyPreview`). A plain hash is used, not a slow
///   password hash, because the key is looked up by its hash and its 256 bits of randomness make guessing pointless.
/// - Keys minted in the portal and keys issued by the OAuth token endpoint are the same kind of row and are validated
///   by one path (`resolveUserApiKey`). `issuedVia` records how the key came to be: `portal`, `oauth:<client_id>`,
///   `admin` for the bootstrap command, or the value of the key that minted it. `oauthScopes` are copied from the
///   authorization code and never change; an empty list is an unrestricted key
///   (hrn:node:hadronmemory.com:specs:cor:aut:010:02).
/// - A key does not authenticate when it is revoked, when its user is deleted, or when the SignIn it descends from
///   has been ended. `lastUsedAt` is updated on use.
/// - Rows are written once. The only state change is revocation (`revokedAt`), which also revokes every key minted
///   from it, down the whole tree. `hiddenAt` hides a revoked key from its owner's default list and is never read by
///   authentication.
/// - The key's own user may hard-delete it (`deleteUserApiKey`). A live key is revoked first, with its subtree; keys
///   it minted stay, revoked, with `mintedByKeyId` cleared; and one UserApiKeyDeletion row records the deletion.
/// - There are no `updatedAt` or `deletedAt` columns: there is no edit operation, and a revocable credential has no
///   use for a soft delete.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:070:03. Background (history, not law): the Spec Kit spec
/// 025-oauth-for-mcp. Background: #1253, #1897, #2298, #2659.
model UserApiKey {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  /// SHA-256 hash of the raw `hdr_user_<…>` key.
  keyHash     String    @unique @map("key_hash")
  /// Last 4 characters of the raw key for masked display.
  keyPreview  String    @map("key_preview")
  /// Human-friendly name for this key.
  label       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Actor that minted this key. Schema-wide convention: `User.id` of
  /// the actor. For self-service v1 this equals `userId`; the column
  /// exists for future admin-issued paths (where actor != owner).
  createdBy   String?   @map("created_by")
  /// Issuance identity: portal for direct sign-in, oauth:<client_id> for
  /// OAuth issuance, inherited from an authenticated minting key. Nullable
  /// historical provenance remains unknown. Distinct from the User actor.
  issuedVia   String?   @map("issued_via")
  /// Immutable OAuth scopes copied from the authorization code at token
  /// redemption. Empty means an unrestricted portal/legacy user key. There is
  /// deliberately no DB default: every issuance path writes the exact grant.
  oauthScopes String[]  @map("oauth_scopes")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  /// #2298: the owner hid this REVOKED key from their default list. Display
  /// state only: never read by authentication, revocation or lineage.
  hiddenAt    DateTime? @map("hidden_at")

  /// Authenticated credential that minted this key (#1253). Null means
  /// direct issuance, unknown legacy ancestry, or (#2659) a minting key its
  /// user has since deleted, the break recorded once in that key's
  /// UserApiKeyDeletion row; never inferred/backfilled.
  mintedByKeyId String?      @map("minted_by_key_id")
  mintedByKey   UserApiKey?  @relation("UserKeyLineage", fields: [mintedByKeyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mintedKeys    UserApiKey[] @relation("UserKeyLineage")

  /// #1897 / R66: the recorded SignIn this key descends from, directly or through minting keys. A SignIn row is
  /// written only when a passkey completed the sign-in, which no sign-in route requires or starts any more
  /// (hrn:node:hadronmemory.com:specs:cor:aut:030:03), so this is null for keys from ordinary sign-ins. Immutable, server-derived, never inferred from
  /// email/time/issuedVia; null = direct issuance or legacy (S6), never backfilled.
  originSignInId String? @map("origin_sign_in_id")
  originSignIn   SignIn? @relation(fields: [originSignInId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mintedByKeyId])
  @@index([originSignInId])
  @@map("user_api_keys")
}

/// One session in which an administrator views the platform, read-only, as another user. The row is both the audit
/// record of the session (who impersonated whom, in which organization, when and why) and the thing every request
/// checks to decide whether the session is still allowed.
///
/// Relationships: `adminUser` is the User who impersonates, `targetUser` the User being impersonated, `organization`
/// the one Organization both belong to, which limits what the session can read. The row is deleted only when one of
/// those three is hard-deleted. `endedBy` is a plain user id.
///
/// Behaviour:
/// - Started by an organization ADMIN or OWNER, or a platform admin, for a member of the same organization
///   (src/api/graphql/schema/resolvers.impersonation.ts). The session sees what the target sees inside that
///   organization only. The target's other organizations and everything that is theirs as a person (personal and
///   private memories, chats, mailbox, assets, personal credentials) stay invisible.
/// - The session's token only names the row. Every request reads the row again and derives both users' current roles
///   again (`resolveJwt`, src/middleware/auth.ts).
/// - A session is live while `endedAt` is null and `expiresAt` is in the future. Expiry is read from `expiresAt` and
///   never written back.
/// - How a session finished can be read from the row. `endedAt` and `endedBy` both set: a person stopped it.
///   `endedAt` set and `endedBy` null: the system revoked it, because the administrator lost the role, the target was
///   promoted above what the administrator may impersonate, the target left the organization, or the administrator's
///   account was deleted. `endedAt` null and `expiresAt` passed: it ran out.
/// - Stopping and revoking never delete the row.
///
/// Rules: hrn:node:hadronmemory.com:specs:cor:acl:100:01, hrn:node:hadronmemory.com:specs:cor:acl:100:03,
/// hrn:node:hadronmemory.com:specs:cor:acl:100:04. Background: #878.
model ImpersonationSession {
  id             String    @id @default(cuid())
  /// Actor (the admin). Schema-wide audit-actor convention: `User.id`.
  adminUserId    String    @map("admin_user_id")
  /// The member being impersonated.
  targetUserId   String    @map("target_user_id")
  /// The shared org that scopes the impersonated session's reads.
  organizationId String    @map("organization_id")
  /// Optional support/diagnostic reason supplied at start. Capped at the
  /// resolver (USER_API_KEY_LABEL_MAX_LEN precedent).
  reason         String?
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  /// Explicit-stop timestamp. NULL while live or when the session merely
  /// lapsed by TTL.
  endedAt        DateTime? @map("ended_at")
  /// `User.id` of whoever stopped it early (the admin in v1 — never the
  /// target: the impersonated context's self-stop records the actor).
  endedBy        String?   @map("ended_by")

  adminUser    User         @relation("ImpersonationSessionsAsAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  targetUser   User         @relation("ImpersonationSessionsAsTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([organizationId, createdAt])
  @@map("impersonation_sessions")
}

/// A registered OAuth client: an application that is allowed to start a sign-in against the platform. The table is
/// the registry that the authorize and token endpoints check.
///
/// Relationships: AuthCode rows point at the client and are deleted with it. `clientId` is the primary key and there
/// is no separate generated id, because the client id is the public, permanent name the client sends on every
/// request.
///
/// Behaviour:
/// - A row is created by `POST /oauth/register` (dynamic client registration), which is unauthenticated, or by a
///   seed. A registered client gets the id `dcr_` plus 32 hex characters; seeded fixtures use fixed ids such as
///   `test`.
/// - All clients are public. No client secret is stored; the proof at the token endpoint is PKCE (S256).
/// - `redirectUris` is the list the authorize endpoint checks a request's redirect URI against.
/// - `expiresAt` is set to 30 days from registration and moved forward by every token redemption. A daily job
///   (src/jobs/gcOauthClients.ts) soft-deletes a client that is more than 7 days past it, with `deletedBy =
///   'system:gc'`; the job only counts and changes nothing unless `OAUTH_CLIENT_GC_ENABLED` is `true`. A null
///   `expiresAt` never expires (seeded and hand-made clients).
/// - A soft-deleted client is refused at the authorize and token endpoints. Its authorization codes and the keys
///   already issued for it are not touched.
/// - The full set of audit columns is present although no edit or delete operation exists for a person yet.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:070:02. Background (history, not law): the Spec Kit spec
/// 025-oauth-for-mcp. Background: #155.
model OAuthClient {
  /// The public client identifier. DCR-registered:
  /// `dcr_<32 hex>` (16 bytes / 128 bits). Seeded fixtures use stable
  /// identifiers like `'test'`. Primary key.
  clientId     String    @id @map("client_id")
  clientName   String    @map("client_name")
  /// Allowed redirect URIs. /authorize must reject any redirect_uri
  /// not present here (OAuth 2.1 §3.1.2).
  redirectUris String[]  @map("redirect_uris")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")
  /// #155: when an unused DCR client becomes collectable. Set to now + 30
  /// days at registration and pushed forward by each token redemption; the
  /// GC job (src/jobs/gcOauthClients.ts) soft-deletes a client 7 days past
  /// it. NULL never expires (seeded and hand-made clients).
  expiresAt    DateTime? @map("expires_at")

  authCodes AuthCode[]

  @@map("oauth_clients")
}

/// A short-lived, single-use OAuth authorization code: what a client receives when a user approves it, and trades
/// once at the token endpoint for a UserApiKey.
///
/// Relationships: belongs to the User who approved and to the OAuthClient it was issued to; deleted with either.
/// `signIn` is the SignIn the approving session descends from, when it has one; it is passed on to the key as
/// `UserApiKey.originSignInId`.
///
/// Behaviour:
/// - Issued by `POST /oauth/authorize` when the user approves (src/auth/oauth.ts). The raw code goes to the client;
///   only its SHA-256 hash is stored (`codeHash`, unique), and the token endpoint looks the row up by the hash of
///   what it is given.
/// - It expires 10 minutes after it is issued (`expiresAt`).
/// - It carries what the token endpoint verifies: the client, the redirect URI, the PKCE S256 challenge
///   (`codeChallenge`) and the resource it was issued for (`resource`). `oauthScopes` are the scopes the user
///   approved and are copied unchanged to the key.
/// - Single use: redemption claims the row with a guarded update on `redeemedAt` being null, so of two concurrent
///   attempts only one succeeds. A wrong PKCE verifier or a wrong resource also sets `redeemedAt`, so the same code
///   cannot be tried again.
/// - When a SignIn is ended, its unredeemed codes are marked redeemed (`endSignInsCompletedBy`). The
///   `signInId` reference never changes after creation (a trigger in prisma/signin-invariants.sql).
/// - There are no `updatedAt` or `deletedAt` columns: `redeemedAt` and `expiresAt` carry the whole lifecycle.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:070:01. Background (history, not law): the Spec Kit spec
/// 025-oauth-for-mcp. Background: #1897.
model AuthCode {
  id            String    @id @default(cuid())
  /// SHA-256 hash of the raw code value handed to the client. Looked up
  /// by hash at /token to avoid plaintext credentials in the DB.
  codeHash      String    @unique @map("code_hash")
  clientId      String    @map("client_id")
  userId        String    @map("user_id")
  redirectUri   String    @map("redirect_uri")
  /// PKCE S256 challenge value (base64url, no padding).
  codeChallenge String    @map("code_challenge")
  /// RFC 8707 resource indicator(s) captured at /authorize. Multi-valued
  /// per RFC 8707 §2; v1 MCP usage populates a single element (the MCP
  /// endpoint URL). Application enforces ≥1 element.
  resource      String[]
  /// Immutable OAuth scopes approved by the user. Copied exactly to the
  /// UserApiKey minted when this code is redeemed.
  /// No DB default: the authorize path must always write the approved grant.
  oauthScopes   String[]  @map("oauth_scopes")
  expiresAt     DateTime  @map("expires_at")
  redeemedAt    DateTime? @map("redeemed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  /// Actor that initiated the /authorize request that minted this code.
  /// Resolves to the signed-in User; equals `userId` in self-service v1.
  createdBy     String?   @map("created_by")
  /// #1897: the recorded SignIn this code descends from (null = the approving session has no SignIn row, which is
  /// every ordinary sign-in, hrn:node:hadronmemory.com:specs:cor:aut:030:03; never inferred). Immutable, same owner as `userId`.
  signInId      String?   @map("sign_in_id")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  signIn SignIn?     @relation(fields: [signInId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([clientId])
  @@index([signInId])
  @@map("auth_codes")
}

/// One step of a passkey ceremony that a browser has opened and not yet finished: signing a node or a grant,
/// registering a passkey, revoking one, or the passkey step of a sign-in. The row is the server's proof that this
/// browser started this step for this purpose, and it can be used once.
///
/// Relationships: `user` and `vouchPasskey` are set only once a ceremony is bound to a person: the User who
/// registers, revokes or signs, and the PasskeyCredential that vouched for a registration or a revocation. The row is
/// deleted with the user; a PasskeyCredential that a ceremony names cannot be deleted (Restrict). PendingEmailSignIn
/// names its current ceremony by a plain id.
///
/// Behaviour:
/// - `purpose` says which step it is: `SIGN_IN`, `STEP_UP_ONLY`, `REGISTER`, `REVOKE`, `SIGN_PROOF`, `SIGN`,
///   `GRANT_SIGN_PROOF` or `GRANT_SIGN` (the `CeremonyPurpose` type, src/lib/passkeys/ceremony.ts).
/// - `browserNonceHash` is the SHA-256 of the nonce in the browser's ceremony cookie, and `challengeHash` the SHA-256
///   of the WebAuthn challenge issued for the step. A ceremony is never created without a challenge.
/// - Consuming sets `consumedAt` once. It succeeds only for the same browser nonce and the same purpose, and before
///   `expiresAt`. Expiry and consumption are decided on the database clock at the statement, and the consume runs in
///   the caller's transaction, so a later refusal rolls it back.
/// - Some ceremonies are bound to a person, once. A REGISTER ceremony is bound at its options step to who registers and
///   how they proved it: `kind` `first` with the fresh sign-in's method and that browser's hash, or `later` with the
///   vouching passkey, plus the new random WebAuthn user handle (hrn:node:hadronmemory.com:specs:cor:aut:040:02). A
///   REVOKE ceremony is bound the same way with `kind` `revoke`. A SIGN or GRANT_SIGN ceremony is created already
///   bound to the person its proof step proved (`kind` `sign`). Every other ceremony leaves these columns null. A
///   CHECK allows exactly these shapes, and a trigger refuses a second binding and a binding after consumption
///   (prisma/passkey-registration-invariants.sql).
/// - A job deletes a ceremony whose step is over (consumed or expired) 30 days after the later of the two
///   (src/jobs/sweepPasskeyCeremonies.ts, `PASSKEY_CEREMONY_RETENTION_SECONDS`). Credentials are never deleted by it.
///
/// Background: #1631, #1632, #3122, #3649.
model PasskeyCeremony {
  id                 String             @id
  purpose            String
  browserNonceHash   String             @map("browser_nonce_hash")
  /// SHA-256 hex of the challenge issued for this ceremony: every ceremony is bound to one.
  challengeHash      String             @map("challenge_hash")
  createdAt          DateTime           @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at")
  expiresAt          DateTime           @map("expires_at")
  consumedAt         DateTime?          @map("consumed_at")
  /// #1631 PR2: a REGISTER ceremony's binding, set once at its options step (hrn:node:hadronmemory.com:specs:cor:aut:040:02): who registers,
  /// 'first' (a fresh sign-in, its method and that browser's hash) or 'later' (the vouching passkey), and the
  /// fresh random WebAuthn user handle. A REVOKE ceremony is bound the same way ('revoke'), and a SIGN or GRANT_SIGN
  /// ceremony is created already bound to the person its proof step proved ('sign';
  /// hrn:node:hadronmemory.com:specs:cor:acl:140:07, hrn:node:hadronmemory.com:specs:cor:acl:140:09). Null for every other ceremony.
  userId             String?            @map("user_id")
  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind               String?
  registrationMethod String?            @map("registration_method")
  signInBrowserHash  String?            @map("sign_in_browser_hash")
  vouchPasskeyId     String?            @map("vouch_passkey_id")
  vouchPasskey       PasskeyCredential? @relation("PasskeyCeremonyVouch", fields: [vouchPasskeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userHandle         Bytes?             @map("user_handle")

  @@index([expiresAt])
  @@map("passkey_ceremonies")
}

/// The email notice that tells a user a passkey was registered on their account. There is one for every registration,
/// and it is written in the same transaction as the passkey, so a passkey never exists without its notice.
///
/// Relationships: one per PasskeyCredential (`passkeyId` is unique) and belongs to the User who owns it. Both are
/// Restrict: the notice is never deleted, and a trigger refuses any delete
/// (prisma/passkey-registration-invariants.sql).
///
/// Behaviour:
/// - `kind` is `first` or `later`. The notice of a first passkey carries its cancel link: `cancelTokenEnc` holds the
///   raw cancel token, encrypted, until the notice reaches a final state, and is then cleared.
/// - A loop sends the notices (src/jobs/sendPasskeyRegistrationNotices.ts). Each try is claimed first (`attempts`,
///   `leaseUntil`, `claimToken`), and the number of tries is capped. The notice ends as sent (`sentAt`) or failed
///   (`failedAt`), each set once.
/// - A user with no email address, or a deployment with no mail sender, settles the notice as failed at once.
///   Erasing the user's account (`deleteUser`, which keeps the user row) settles an unsent notice as failed and
///   clears its token.
/// - `seenAt` is for the in-app notice. The trigger lets it be set once; no code sets it today.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:aut:040:02. Background: #1631.
model PasskeyRegistrationNotice {
  id             String            @id
  passkeyId      String            @unique @map("passkey_id")
  passkey        PasskeyCredential @relation(fields: [passkeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId         String            @map("user_id")
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// 'first' | 'later'
  kind           String
  cancelTokenEnc String?           @map("cancel_token_enc")
  createdAt      DateTime          @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at")
  attempts       Int               @default(0)
  leaseUntil     DateTime?         @map("lease_until")
  claimToken     String?           @map("claim_token")
  sentAt         DateTime?         @map("sent_at")
  failedAt       DateTime?         @map("failed_at")
  seenAt         DateTime?         @map("seen_at")

  @@index([userId])
  @@index([sentAt])
  @@map("passkey_registration_notices")
}

/// The token behind the cancel link in the email about a user's first passkey. Following the link revokes that
/// passkey without a sign-in, which is how the real owner undoes a passkey that someone else registered.
///
/// Relationships: one per first PasskeyCredential (`passkeyId` is unique, Restrict). The token is never deleted; a
/// trigger refuses it (prisma/passkey-registration-invariants.sql).
///
/// Behaviour:
/// - Issued in the registering transaction, only for a first passkey whose cooling-off window is open
///   (`issueCancelToken`, src/lib/passkeys/cancel.ts). The raw token goes only into the email; the row stores its
///   SHA-256 (`tokenHash`, unique).
/// - It works once (`usedAt`) and only while the passkey's window is open, the passkey is not revoked and its owner
///   is not deleted. Every refusal looks the same to the caller.
/// - A successful cancel revokes the passkey, records the time, IP address and user agent on the PasskeyCredential,
///   spends the token and ends every SignIn that passkey completed, all in one transaction (`cancelFirstPasskey`).
/// - The trigger sets `createdAt` and `usedAt` from the database clock and keeps the token's identity unchanged.
///
/// Rules: hrn:node:hadronmemory.com:specs:cor:aut:040:07, hrn:node:hadronmemory.com:specs:cor:aut:040:08. Background:
/// #1631, #3746.
model PasskeyCancelToken {
  id        String            @id
  passkeyId String            @unique @map("passkey_id")
  passkey   PasskeyCredential @relation(fields: [passkeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash String            @unique @map("token_hash")
  createdAt DateTime          @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at")
  usedAt    DateTime?         @map("used_at")

  @@map("passkey_cancel_tokens")
}

/// Proof that a person has just proved who they are, to one browser, for one passkey step. It signs the person in to
/// nothing: no session, token or key comes from it. Registering a first passkey, ending a first passkey's cooling-off
/// window early and revoking a passkey each spend one.
///
/// Relationships: belongs to one User and is deleted with the user.
///
/// Behaviour:
/// - `method` is how the person proved it: `github`, `google` or `apple` (the identity provider's callback writes the
///   row) or `email` (a link requested from the ceremony page).
/// - Two secrets must meet before the row counts. `legHash` is the SHA-256 of the one-time leg id or of the emailed
///   token, held by the browser that finished the proof. `browserNonceHash` is the SHA-256 of the ceremony cookie,
///   held by the browser that started it. Neither raw value is stored. `confirmedAt` is set when both are presented
///   together.
/// - `consumedAt` and `consumedFor` (`register`, `end-window` or `revoke`) are set once, when a step spends the row.
///   The step must begin no more than 10 minutes after the identity proof (`signedInAt`), and a `revoke` never
///   accepts the `email` method (src/lib/passkeys/freshSignIn.ts).
/// - A trigger writes the times from the database clock and keeps the row's identity unchanged
///   (prisma/fresh-sign-in-invariants.sql).
/// - Rows older than 24 hours are deleted when a new proof is started. Deleting the user's account deletes them too.
///
/// Definition: hrn:node:hadronmemory.com:specs:cor:aut:040:09. Background: #1631.
model FreshSignIn {
  id               String    @id
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'github' | 'google' | 'apple' | 'email', set from the provider whose callback ran.
  method           String
  browserNonceHash String    @map("browser_nonce_hash")
  /// SHA-256 of the one-time leg id (IdP) or emailed token (email). The raw value is never stored.
  legHash          String    @unique @map("leg_hash")
  createdAt        DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  signedInAt       DateTime? @map("signed_in_at")
  confirmedAt      DateTime? @map("confirmed_at")
  consumedAt       DateTime? @map("consumed_at")
  /// 'register' | 'end-window' | 'revoke'
  consumedFor      String?   @map("consumed_for")

  @@index([browserNonceHash])
  @@index([createdAt])
  @@map("fresh_sign_ins")
}

/// An email sign-in that has been held back until the user's passkey confirms it. While the row is pending nothing is
/// issued: no handoff code, no session token, no cookie session and no key.
///
/// Relationships: belongs to one User and is deleted with the user. `signIn` is the SignIn the completion produced.
/// `ceremonyId` names the current SIGN_IN PasskeyCeremony as a plain id.
///
/// Behaviour:
/// - Nothing on a sign-in path creates these rows any more: signing in never depends on a passkey
///   (hrn:node:hadronmemory.com:specs:cor:aut:030:03). The code that creates and completes them is kept
///   (the begin and complete steps in src/api/passkeySignInRoutes.ts) and is called only by tests.
/// - `continuation` says where the flow resumes: `PORTAL` (with `clientStateHash`, `redirect`, `isNew`) or `OAUTH`
///   (with `returnTo`). Each kind carries exactly its own columns (a CHECK).
/// - The row is found by `browserHash`, the SHA-256 of the pending cookie; the cookie value is never stored. It lives
///   10 minutes, or 30 when the user must first add a passkey, by the database clock.
/// - It completes once, together with the SignIn it produced (`completedAt`, `signInId`), and only through a passkey
///   assertion over a SIGN_IN ceremony bound to the same browser hash. A trigger keeps identity and continuation
///   unchanged (prisma/pending-email-sign-in-invariants.sql).
/// - Rows older than 24 hours are deleted when a new one is created.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:aut:030:03. Background: #1897, #4339.
model PendingEmailSignIn {
  id              String    @id
  userId          String    @map("user_id")
  /// 'PORTAL' | 'OAUTH'. Each kind carries exactly its own columns (CHECK).
  continuation    String
  /// Portal: the ORIGINAL SHA-256 of the requesting browser's nonce, carried untouched to the handoff code.
  clientStateHash String?   @map("client_state_hash")
  redirect        String?
  isNew           Boolean?  @map("is_new")
  /// OAuth: the already-validated server-local path to resume at.
  returnTo        String?   @map("return_to")
  /// SHA-256 of the pending cookie; the cookie value is never stored.
  browserHash     String    @unique @map("browser_hash")
  /// The current SIGN_IN ceremony; replacing it consumes the earlier one.
  ceremonyId      String?   @map("ceremony_id")
  createdAt       DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at")
  expiresAt       DateTime  @map("expires_at")
  completedAt     DateTime? @map("completed_at")
  signInId        String?   @map("sign_in_id")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  signIn SignIn? @relation(fields: [signInId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([createdAt])
  @@map("pending_email_sign_ins")
}

/// One passkey that a user has registered: the public half of the credential, and the facts about its life. The
/// platform checks every passkey assertion against this record, whether it signs a node, signs a grant, vouches for
/// another passkey or proves ownership for a revocation. The private key never reaches the platform.
///
/// Relationships: belongs to one User (`ownerId`, Restrict). NodeSignature, GrantSignature and SignIn rows name the
/// passkey that made them. It has at most one PasskeyCancelToken and one PasskeyRegistrationNotice, and
/// PasskeyCeremony rows name it as the vouching passkey. A record is never deleted: a trigger refuses it
/// (prisma/passkey-invariants.sql).
///
/// Behaviour:
/// - Written by the registration ceremony (src/lib/passkeys/registration.ts). `credentialId` is unique across the
///   deployment, and the identifier of a revoked passkey is never registered again.
/// - The first passkey a user holds gets a cooling-off window (`windowEndsAt`), during which its signatures are
///   pending. The window closes once: `windowOutcome` is `ran-out`, `ended-early` or `cancelled`
///   (hrn:node:hadronmemory.com:specs:cor:aut:040:07).
/// - `revokedAt` is set once. From then on every assertion from the passkey is refused. Every revocation also ends
///   the SignIn rows the passkey completed (hrn:node:hadronmemory.com:specs:cor:aut:040:08). A use of the cancel link
///   is also recorded with its time, IP address and user agent (`cancelledAt`, `cancelIp`, `cancelUserAgent`).
/// - An assertion counts only while `enrollmentRpId` equals the deployment's relying party id
///   (hrn:node:hadronmemory.com:specs:cor:aut:040:06). `counter` and `lastUsedAt` move forward on use and never
///   backwards.
/// - The trigger keeps the credential id, public key, owner and label unchanged and writes the times from the
///   platform clock. One change to the label is allowed: erasing the owner's account (`deleteUser`, which
///   keeps the user row, so the Restrict relation holds) replaces it with "Erased
///   passkey" and blanks the cancel IP address and user agent. The record itself stays, so that old signatures can
///   still be verified.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:aut:040:05. Background: #1631.
model PasskeyCredential {
  id                 String    @id @default(cuid())
  ownerId            String    @map("owner_id")
  /// Raw WebAuthn identifier bytes: encoding aliases cannot create duplicate records.
  credentialId       Bytes     @unique @map("credential_id")
  publicKey          Bytes     @map("public_key")
  algorithm          Int
  /// Random authenticator user handle, not an email, User.id or session bearer.
  userHandle         Bytes     @map("user_handle")
  /// The WebAuthn RP ID the credential was registered under (Eden #10470), recorded at
  /// enrollment and immutable. Never inferred from the current PASSKEY_RP_ID: an assertion
  /// counts only while it equals the deployment's RP ID (hrn:node:hadronmemory.com:specs:cor:aut:040:06).
  enrollmentRpId     String    @map("enrollment_rp_id")
  label              String
  registeredAt       DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("registered_at")
  lastUsedAt         DateTime? @map("last_used_at")
  revokedAt          DateTime? @map("revoked_at")
  /// WebAuthn's unsigned 32-bit counter does not fit a signed PostgreSQL Int.
  counter            BigInt    @default(0)
  transports         String[]  @default([])
  backupEligible     Boolean   @default(false) @map("backup_eligible")
  backedUp           Boolean   @default(false) @map("backed_up")
  /// First credential only: the verified sign-in method used for registration.
  registrationMethod String?   @map("registration_method")
  windowEndsAt       DateTime? @map("window_ends_at")
  windowEndedAt      DateTime? @map("window_ended_at")
  /// null while open (or not first); ran-out | ended-early | cancelled once closed.
  windowOutcome      String?   @map("window_outcome")
  /// SEC-9: provenance of a cancel-link use, distinct from other revocation routes.
  cancelledAt        DateTime? @map("cancelled_at")
  cancelIp           String?   @map("cancel_ip")
  cancelUserAgent    String?   @map("cancel_user_agent")

  owner             User                       @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  signatures        NodeSignature[]
  grantSignatures   GrantSignature[]
  signIns           SignIn[]
  cancelToken       PasskeyCancelToken?
  notice            PasskeyRegistrationNotice?
  vouchedCeremonies PasskeyCeremony[]          @relation("PasskeyCeremonyVouch")

  @@index([ownerId])
  @@map("passkey_credentials")
}

/// The record that a user deleted one of their own API keys. It keeps what can be kept once the key is gone: whose
/// key it was, which key, and when.
///
/// Relationships: belongs to one User and is deleted only with the user. `keyId` is a plain value with no foreign
/// key, because the UserApiKey row no longer exists.
///
/// Behaviour:
/// - Written once by `deleteUserApiKey`, in the transaction that deletes the key. Only the key's own user can delete
///   it.
/// - It stores the key's id and its masked preview (`keyPreview`), never the secret or its hash.
/// - `revokedKeyIds` are the keys the deletion itself revoked: the key, when it was live, and the live keys below it.
///   `mintedKeyIds` are the keys it had minted, whose link to it was cut; they stay, revoked, with no parent.
/// - A trigger refuses every update, and every delete while the user row exists
///   (prisma/user-api-key-deletion-invariants.sql).
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:070:03. Rule: hrn:node:hadronmemory.com:specs:cor:aut:010:02.
/// Background: #2659.
model UserApiKeyDeletion {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  keyId         String   @map("key_id")
  keyPreview    String   @map("key_preview")
  revokedKeyIds String[] @map("revoked_key_ids")
  mintedKeyIds  String[] @map("minted_key_ids")
  deletedAt     DateTime @default(now()) @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("user_api_key_deletions")
}

/// A record of one completed sign-in that can be ended later, together with everything that came from it. Its id is
/// the `sid` claim of the session token it publishes and the root of every handoff code, authorization code and API
/// key that descends from it, so ending the row ends exactly that lineage and nothing else.
///
/// Relationships: belongs to one User and is deleted with the user. `passkey` is the PasskeyCredential whose
/// assertion completed the sign-in (Restrict; a trigger requires it to belong to the same user). AuthHandoffCode,
/// AuthCode, UserApiKey and PendingEmailSignIn rows point back at it through the pair (`id`, `userId`), so a
/// descendant always has the same owner as its root.
///
/// Behaviour:
/// - The only writer is `createSignIn` (src/auth/signIn.ts). Its one caller is the completion step of the
///   server-hosted passkey sign-in page (src/api/passkeySignInRoutes.ts), which records `method` `email` and the
///   passkey that completed it.
/// - No sign-in route starts that page any more, because signing in never depends on a passkey
///   (hrn:node:hadronmemory.com:specs:cor:aut:030:03). A sign-in by email link, GitHub, Google or Apple therefore
///   creates no row, and its token carries no `sid`.
/// - A token that carries `sid` authenticates only while its row is not ended and `expiresAt` has not passed
///   (`verifyAuthenticatedJwt`). A UserApiKey whose root is ended does not authenticate either. A token or key with
///   no root is not affected.
/// - Revoking the passkey that completed a sign-in, through the owner's revocation or through the cancel link of a
///   first passkey, ends every sign-in that passkey completed in the same transaction (`endSignInsCompletedBy`;
///   hrn:node:hadronmemory.com:specs:cor:aut:040:08). `endedAt` and `endReason` are set, the unredeemed handoff and
///   authorization codes below it are marked redeemed, and the keys below it are revoked. A merge of two accounts
///   ends the source account's sign-ins.
/// - Triggers keep the rest fixed (prisma/signin-invariants.sql): the user, method, passkey and times never change, a
///   row is ended once, a descendant never changes its root, and a row that still has descendant keys cannot be
///   deleted.
///
/// Rules: hrn:node:hadronmemory.com:specs:cor:aut:030:03, hrn:node:hadronmemory.com:specs:cor:aut:040:08. Background:
/// #1897.
model SignIn {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  /// How the person arrived ('email'); the passkey that completed the sign-in is `completedByPasskeyId`.
  method               String
  completedByPasskeyId String?   @map("completed_by_passkey_id")
  completedAt          DateTime  @default(now()) @map("completed_at")
  expiresAt            DateTime  @map("expires_at")
  endedAt              DateTime? @map("ended_at")
  endReason            String?   @map("end_reason")

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  passkey   PasskeyCredential?   @relation(fields: [completedByPasskeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  handoffs  AuthHandoffCode[]
  authCodes AuthCode[]
  keys      UserApiKey[]
  pendings  PendingEmailSignIn[]

  @@unique([id, userId])
  @@index([userId])
  @@index([completedByPasskeyId])
  @@map("sign_ins")
}

/// A request for a person to sign the content of one node. Whoever may read the node, an agent included, creates the
/// request and hands its link to the person, who signs or declines on the signing page the server hosts.
///
/// Relationships: belongs to one Node and is deleted with it. A completed request has exactly one NodeSignature.
/// `namedSignerId`, `requesterUserId`, `requesterAppId`, `requesterWorkerId` and `requesterSessionId` are plain ids
/// with no foreign key: they are sealed history, and a foreign-key action would be a write that the guard trigger
/// refuses.
///
/// Behaviour:
/// - What the request pins is fixed at creation and never changes: the node, its `revision`, the approval hash of its
///   content and the payload version. The id is 128 random bits, so it cannot be guessed.
/// - `namedSignerId` is the one person who may sign or decline. Null means anyone who may sign the node, which is a
///   writer of its memory.
/// - `state` starts as `open` and ends exactly once: `completed`, `declined`, `expired`, `stale` (the content the
///   request pinned changed) or `withdrawn` (by the requester). Application code only names the end state
///   (src/lib/signing/requests.ts).
/// - The guard trigger (prisma/signing-invariants.sql) sets every timestamp from the database clock, enforces the
///   single end, lets a request complete only together with its signature record, and refuses a delete while the node
///   exists. Ended requests are kept for the node's lifetime.
///
/// Lifecycle: hrn:node:hadronmemory.com:specs:cor:dmo:130:03. Background: #1632.
model SigningRequest {
  /// 128 bits of randomness, base64url (plan SEC-8): never guessable.
  id                 String    @id
  nodeId             String    @map("node_id")
  revision           Int
  approvalHash       String    @map("approval_hash")
  payloadVersion     String    @map("payload_version")
  /// Null = any eligible signer (a writer of the node's memory).
  namedSignerId      String?   @map("named_signer_id")
  /// The requester ACCOUNT is requesterUserId, else requesterAppId (#10397).
  requesterUserId    String?   @map("requester_user_id")
  requesterAppId     String?   @map("requester_app_id")
  requesterWorkerId  String?   @map("requester_worker_id")
  requesterSessionId String?   @map("requester_session_id")
  /// open | completed | declined | expired | stale | withdrawn
  state              String    @default("open")
  createdAt          DateTime  @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @map("created_at")
  expiresAt          DateTime  @map("expires_at")
  endedAt            DateTime? @map("ended_at")

  node      Node           @relation(fields: [nodeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  signature NodeSignature?

  @@index([nodeId, createdAt])
  @@map("signing_requests")
}

/// The record that one person signed one node at one revision with a passkey. It holds the assertion exactly as the
/// authenticator returned it, so the signature can be verified again at any later time.
///
/// Relationships: belongs to one Node and is removed only with it (a hard delete of the node or of its memory).
/// `signingRequest` is the SigningRequest it completed, one record per request. `passkey` is the PasskeyCredential
/// that made it (Restrict). `stampSigningKey` is the StampSigningKey that verifies its stamp (Restrict). `signerId`
/// is a plain user id with no foreign key: sealed history. The signer is always a person.
///
/// Behaviour:
/// - Written once, by the signing ceremony, when a request completes. There is no update or delete operation, and the
///   guard trigger refuses both (`hadron_guard_node_signature`, prisma/signing-invariants.sql). The trigger also
///   requires an open request, the exact revision and approval hash the request pinned, the named signer when there
///   is one, and the signer's own unrevoked passkey.
/// - A signature's state is never stored. Every read works it out by verifying the stored assertion again
///   (src/lib/signing/state.ts).
/// - `rpId` is the relying party id the signature was made under. Verification uses it, never the current
///   configuration, so a change of domain does not invalidate old signatures.
/// - The stamp (`ceremonyStamp`, `stampKeyId`, `stampMemoryId`, `stampOwnerKind`, `stampOwnerId`) records what the
///   ceremony judged at signing: the node's memory, and the Agent or App the signer managed, if any. The tag is an
///   HMAC-SHA256 under a StampSigningKey over those values and the row's own identity, so none of them can be changed
///   or copied to another row without breaking it. All five are null on a row written before stamps existed, and such
///   a signature counts toward no requirement (hrn:node:hadronmemory.com:specs:cor:dmo:130:09).
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:dmo:130:07. Rule: hrn:node:hadronmemory.com:specs:cor:dmo:130:05.
/// Background: #1632, #2973.
model NodeSignature {
  id                  String   @id @default(cuid())
  nodeId              String   @map("node_id")
  /// The request it completed; one record per request.
  signingRequestId    String   @unique @map("signing_request_id")
  /// A person, always. Sealed history: no FK.
  signerId            String   @map("signer_id")
  passkeyCredentialId String   @map("passkey_credential_id")
  revision            Int
  approvalHash        String   @map("approval_hash")
  payloadVersion      String   @map("payload_version")
  /// The WebAuthn RP ID the signature was made under, from config at
  /// completion. Re-verification uses this, never the current PASSKEY_RP_ID,
  /// so a domain change cannot invalidate old signatures (#10469/#10470). The
  /// guard requires the assertion's rpIdHash to match it.
  rpId                String   @map("rp_id")
  authenticatorData   Bytes    @map("authenticator_data")
  clientDataJson      Bytes    @map("client_data_json")
  signature           Bytes
  verifiedAt          DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @map("verified_at")

  // #2973 C1 (cor:dmo:130:09, gate hold 6749839869 / 6750325233) — the at-signing
  // eligibility stamp: HMAC-SHA256 under a retained registry key
  // (`stamp_signing_keys`), written once by the ceremony at completion, beside the
  // signature, never part of the signed payload. The plain columns beside it are
  // the stamp's INPUT (what was attested); the tag binds them to the row's own
  // identity fields, so none can be altered without breaking the tag — and the
  // rows are append-only (`hadron_guard_node_signature` refuses every UPDATE).
  // All five columns are NULL together on rows written before the stamp existed
  // (the watermark): such a row's at-signing authority is unverifiable by
  // construction and never counts — cor:dmo:130:09 rev 9 (Holger's R11 ruling,
  // 2026-11-09) makes that the LAW, not a migration fence: the row keeps its visible
  // state but counts toward no requirement, whatever its signer's authority was then
  // or is now, and the node is signed again. A pre-stamp binary against this schema
  // (or a rollback to one) writes exactly these rows; the columns are nullable so
  // those writes succeed, and the law disposes of them.
  /// The stamp tag: HMAC-SHA256(key[stamp_key_id], canonical stamp input), 32 bytes.
  ceremonyStamp  Bytes?  @map("ceremony_stamp")
  /// Which retained registry key verifies the tag. Unknown ids never count.
  stampKeyId     Int?    @map("stamp_key_id")
  /// The node's memory AT SIGNING (the capture-memory binding of the #92963 fence).
  stampMemoryId  String? @map("stamp_memory_id")
  /// The Agent/App the completion judged the signer to manage, when they did
  /// (the manager grade). NULL = writer grade only — a lawful signature that
  /// does not count for `compiled-boot-prompt` (admission is never narrowed).
  stampOwnerKind String? @map("stamp_owner_kind")
  /// The judged Agent/App's id (see `stampOwnerKind`).
  stampOwnerId   String? @map("stamp_owner_id")

  node           Node              @relation(fields: [nodeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  signingRequest SigningRequest    @relation(fields: [signingRequestId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  passkey        PasskeyCredential @relation(fields: [passkeyCredentialId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Restrict: a key with stamps is retained forever (verification never retires).
  stampSigningKey StampSigningKey?  @relation(fields: [stampKeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([nodeId])
  @@map("node_signatures")
}

/// One version of an App's own data key, the key that the App's secrets are encrypted under. Each App has its own
/// key, so one App's key never decrypts another App's secrets.
///
/// Relationships: belongs to one App and is deleted with it. SecretVersion rows name the key version that encrypted
/// them (Restrict: a key version cannot be deleted while a version still uses it). The primary key is the pair
/// (`appId`, `keyVersion`).
///
/// Behaviour:
/// - Created on first need by src/lib/secrets/appKeys.ts: a random 32-byte key, stored only wrapped (AES-256-GCM)
///   under the platform root key `SECRET_ROOT_KEY`. The additional data of the wrap names the App and the key version
///   (`hadron:secret-app-key:v1:<appId>:<keyVersion>`), so a row copied to another App or version fails to unwrap.
/// - Everything fails closed: a missing root key, a row that does not unwrap, or a plaintext that is not exactly 32
///   bytes makes the key unusable, and every operation on the App's secrets is refused.
/// - An App has at most one active key, the one with `retiredAt` null (a partial unique index in
///   prisma/secret-app-keys-invariants.sql). A retired key encrypts nothing new and still decrypts the versions
///   written under it. No code retires a key today.
/// - `wrappedKey` is never selected for display and never logged. The raw key itself encrypts nothing: callers get
///   subkeys derived from it for one purpose each.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:sec:010:04. Background: #3991, #3996.
model SecretAppKey {
  appId      String    @map("app_id")
  keyVersion Int       @map("key_version")
  /// base64(iv[12] | gcm-tag[16] | ciphertext). Never selected for display, never logged.
  wrappedKey String    @map("wrapped_key")
  createdAt  DateTime  @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @map("created_at")
  /// A retired key stops encrypting; it still decrypts until no version uses it.
  retiredAt  DateTime? @map("retired_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)
  versions SecretVersion[]

  @@id([appId, keyVersion])
  @@map("secret_app_keys")
}

/// #4003 (S8 of #3991; FIT delta 2) — the key-check value of the ACTIVE secrets root, one row. A mint compares the
/// instance's root against it and refuses on a mismatch, so an instance still running the old root after a re-wrap
/// mints nothing. Recorded by the first mint when absent (after the newest App key, if any, unwraps under the
/// instance's root); after that moved only by the root re-wrap, in the same transaction as the keys. Holds no key material: an
/// HMAC under the root over a fixed label. `id` is always 1 (CHECK in prisma/secret-rotation-invariants.sql).
model SecretRootCheck {
  id         Int      @id @default(1)
  checkValue String   @map("check_value")
  updatedAt  DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @map("updated_at")

  @@map("secret_root_check")
}

/// One stored value of a secret that an App owns. Every store adds a new version; the newest one is the secret's
/// current value and the older ones are superseded.
///
/// Relationships: belongs to one Secret and is deleted with it. `appKey` is the SecretAppKey version that encrypted
/// it (Restrict). `writtenByUserId`, `writtenByWorkerId` and `writtenBySessionId` are plain ids that record who
/// stored it.
///
/// Behaviour:
/// - Written by the store path in src/lib/secrets/appSecrets.ts. A version is never edited; `versionNo` counts up per
///   secret and is unique with `secretId`.
/// - `valueEncrypted` is the value under a subkey of the App's key, bound to the secret and the version by its
///   additional data. The Prisma client leaves the column out of every default select; only the store path and the
///   server-side read select it by name.
/// - Storing a newer version stamps the earlier ones `supersededAt`. A secret keeps at most 50 versions: the oldest
///   superseded ones are deleted first, and the current one never is.
/// - A trigger requires the version's App to be the App that owns its secret (prisma/secret-versions-invariants.sql).
///   No secret outlives its App: deleting the App row deletes its secrets and their versions first.
/// - `sizeBytes` is the size of the stored plaintext JSON, the unit the size cap is counted in.
///
/// Lifecycle: hrn:node:hadronmemory.com:specs:cor:sec:010:03. Background: #3991, #3997.
model SecretVersion {
  id             String    @id @default(cuid())
  secretId       String    @map("secret_id")
  versionNo      Int       @map("version_no")
  /// base64(iv[12] | gcm-tag[16] | ciphertext) under the App key's encryption subkey, AAD `secretVersionAad`.
  valueEncrypted String    @map("value_encrypted")
  /// The App and the App key version that encrypted it; (app_id, key_version) restricts deletion of the key.
  appId          String    @map("app_id")
  keyVersion     Int       @map("key_version")
  /// Bytes of the stored plaintext JSON (the cap's unit).
  sizeBytes      Int       @map("size_bytes")
  writtenByUserId    String? @map("written_by_user_id")
  writtenByWorkerId  String? @map("written_by_worker_id")
  writtenBySessionId String? @map("written_by_session_id")
  writtenAt      DateTime  @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @map("written_at")
  supersededAt   DateTime? @map("superseded_at")

  secret Secret       @relation(fields: [secretId], references: [id], onDelete: Cascade)
  appKey SecretAppKey @relation(fields: [appId, keyVersion], references: [appId, keyVersion], onDelete: Restrict)

  @@unique([secretId, versionNo], map: "secret_versions_secret_version_uniq")
  @@map("secret_versions")
}

/// One entry in the audit trail of App secrets: who did what to which secret, when, and with what outcome. It is how
/// an auditor can list every store and change of a secret after the fact.
///
/// Relationships: none by foreign key. `ownerType` is always `app` today and `ownerId` is that App's id. `clientId`
/// is a column for the calling client's id that no code sets today. `ownerId`, `secretId`, `actorUserId`,
/// `workerId`, `sessionId` and `runId` are
/// plain values, so the trail outlives the secret and its App.
///
/// Behaviour:
/// - Written by `recordSecretEvent` (src/lib/secrets/appSecrets.ts) in the transaction of the act it records. `kind`
///   names the act (`STORE`, `VERSION`, `METADATA` or `DELETE`) and `outcome` its result. `secretName` and
///   `versionNo` are copied in, so the entry reads on its own.
/// - An entry never holds a value, a ciphertext or a fingerprint of one.
/// - A trigger refuses every update. It refuses a delete too, with one exception: the events of an App whose
///   SecretOwnerTombstone is at least a year old and which is no longer live (prisma/secret-versions-invariants.sql).
///   No code runs that purge today.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:sec:010:05. Background: #3991, #3997.
model SecretEvent {
  id          String   @id @default(cuid())
  ownerType   String   @map("owner_type")
  ownerId     String   @map("owner_id")
  secretId    String   @map("secret_id")
  secretName  String   @map("secret_name")
  clientId    String?  @map("client_id")
  versionNo   Int?     @map("version_no")
  kind        String
  outcome     String
  actorUserId String?  @map("actor_user_id")
  workerId    String?  @map("worker_id")
  sessionId   String?  @map("session_id")
  runId       String?  @map("run_id")
  at          DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)"))

  @@index([ownerType, ownerId, at], map: "secret_events_owner_at_idx")
  @@index([secretId, at], map: "secret_events_secret_at_idx")
  @@map("secret_events")
}

/// The recorded moment at which an App that had secret events was deleted. The one-year retention of that App's
/// SecretEvent rows is counted from it.
///
/// Relationships: none by foreign key. The primary key is the pair (`ownerType`, `ownerId`), a plain value, because
/// the row has to outlive the App it names.
///
/// Behaviour:
/// - Written once per deleted App that has events: by `deleteApp` when it soft-deletes the App, and by a trigger on
///   the hard delete of an App row when no tombstone exists yet. A later hard delete keeps the first time.
/// - A trigger refuses every update. It allows the delete only when the tombstone is at least a year old and the
///   owner has no events left, so a purge removes it last (prisma/secret-versions-invariants.sql).
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:sec:010:05. Background: #3997.
model SecretOwnerTombstone {
  ownerType String   @map("owner_type")
  ownerId   String   @map("owner_id")
  deletedAt DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @map("deleted_at")

  @@id([ownerType, ownerId])
  @@map("secret_owner_tombstones")
}

/// One key in the registry of keys that the platform uses to stamp a signature at signing time. The stamp on a
/// NodeSignature records what the signing ceremony judged about the signer, and this key is what makes that stamp
/// impossible to forge or copy by someone who can only write rows.
///
/// Relationships: NodeSignature rows name the key that verifies their stamp (`stampKeyId`, Restrict), so a key that
/// has stamps can never be deleted.
///
/// Behaviour:
/// - A key is 32 random bytes with one purpose. It is never derived from `HADRON_ENCRYPTION_KEY`: keeping an old root
///   key around would keep a key that decrypts everything, while an old stamp key can only verify stamps.
/// - `keyMaterial` is the key wrapped with AES-256-GCM under `HADRON_ENCRYPTION_KEY`, with the additional data
///   `hadron:stamp-key:v1:<id>`. A ciphertext copied in from any other use fails its tag, and a plaintext that is not
///   exactly 32 bytes makes the row unusable.
/// - Minting a stamp uses the newest key that is not retired, and creates the first key when there is none
///   (`mintStampSigningKey`, src/lib/signing/stampKeys.ts). A stamp names the key that must verify it; an unknown key
///   id never counts.
/// - Keys are kept for verification forever. `retiredAt` stops minting under a key only, and no code sets it today.
///   Changing the root key re-wraps the rows (`rewrapStampSigningKeys`) and never invalidates them.
///
/// Definition: hrn:node:hadronmemory.com:specs:cor:dmo:130:09. Background: #2973.
model StampSigningKey {
  id          Int       @id @default(autoincrement())
  /// base64(iv[12] | gcm-tag[16] | ciphertext), AES-256-GCM under
  /// `HADRON_ENCRYPTION_KEY` with the row's AAD; the plaintext must be exactly
  /// 32 bytes or the row is unusable (fail closed).
  keyMaterial String    @map("key_material")
  createdAt   DateTime  @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @map("created_at")
  /// Retires MINTING under this key only; verification never retires.
  retiredAt   DateTime? @map("retired_at")

  signatures NodeSignature[]

  @@map("stamp_signing_keys")
}

/// A short-lived, single-use code that stands in for a credential during one browser redirect, so that the long-lived
/// session token never appears in a URL the browser can see.
///
/// Relationships: belongs to one User and is deleted with the user. `signIn` is the SignIn a login code publishes,
/// when there is one. `orgId` and `flowId` are plain ids; `flowId` has no foreign key because the ConnectionFlow
/// outlives the code.
///
/// Behaviour:
/// - Two uses share the table (src/auth/authHandoff.ts). A `login` code is minted after a sign-in by email, GitHub,
///   Google or Apple; the portal's server redeems it at `POST /auth/session` for the session token and sets that as
///   an HttpOnly cookie. An `exchange_start` code is minted by a mailbox-connect start route for a signed-in caller
///   and redeemed by the provider's authorize route. Its stored `kind` also names the provider and the door that
///   started the flow, so a code minted for one provider cannot be redeemed at another.
/// - The raw code is handed out once. The row stores only its SHA-256 (`codeHash`, unique).
/// - It expires 2 minutes after it is minted. Redemption claims the row with a guarded update that requires
///   `redeemedAt` to be null and the code to be unexpired, so only one caller succeeds.
/// - `clientStateHash` is the SHA-256 of a nonce the portal set in the browser when the login started. When it is
///   set, the redeemer must present the matching nonce, so the browser that finishes a login is the one that started
///   it.
/// - `loginEvidence` is the verified time and method of the login, carried through to the token. A login code that
///   has a `signInId` is refused when that SignIn has been ended, and ending a SignIn marks its unredeemed codes
///   redeemed.
///
/// Background: #477, #505, #1897, #2897, #2913.
model AuthHandoffCode {
  id              String    @id @default(cuid())
  /// SHA-256 hash of the raw code handed to the browser/portal.
  codeHash        String    @unique @map("code_hash")
  /// 'login', or 'exchange_start' for a mailbox-connect start. An exchange_start kind also carries the provider and,
  /// for a start made through GraphQL, the origin: `exchange_start:<provider>[:graphql]` (src/auth/authHandoff.ts).
  kind            String
  userId          String    @map("user_id")
  /// Post-redemption destination path (login: portal path; exchange: return path).
  redirect        String?
  /// login only — whether the user was just provisioned (drives /app/setup).
  isNew           Boolean   @default(false) @map("is_new")
  /// Verified login evidence survives handoff; redemption must never refresh it.
  loginEvidence   Json?     @map("login_evidence")
  /// exchange_start only — the org the Exchange connection is being attached to.
  orgId           String?   @map("org_id")
  /// login+GitHub only — SHA-256 of the portal-set browser nonce; the redeemer
  /// must present the matching raw nonce (constant-time compared).
  clientStateHash String?   @map("client_state_hash")
  expiresAt       DateTime  @map("expires_at")
  redeemedAt      DateTime? @map("redeemed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  /// #1897: the recorded SignIn this handoff publishes (null = the sign-in wrote no SignIn row, which is every
  /// ordinary sign-in, hrn:node:hadronmemory.com:specs:cor:aut:030:03).
  signInId        String?   @map("sign_in_id")
  /// #2913: exchange_start (GraphQL origin) only — the ConnectionFlow this nonce belongs to. No FK: the flow outlives the nonce.
  flowId          String?   @map("flow_id")
  /// #2948: exchange_start (Google providers) only — the account hint the caller verified as their
  /// own connected address at the start, carried DB-backed to the authorize redirect where it
  /// becomes Google's login_hint. The hint NEVER rides a URL (only the final Google redirect),
  /// and the callback ignores it: the connection records the account Google authenticated.
  loginHint       String?   @map("login_hint")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  signIn SignIn? @relation(fields: [signInId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([signInId])
  @@map("auth_handoff_codes")
}

/// A sign-in with GitHub, Google or Apple that has been started and is waiting for the provider to call back. The row
/// carries the OAuth `state` value, and what the callback needs to finish, from the start route to the callback.
///
/// Relationships: none. There is no User yet: the row exists before the platform knows who is signing in.
///
/// Behaviour:
/// - Written by the start routes (`createPendingLoginState`, src/auth/pendingLoginState.ts) and kept in the database,
///   not in process memory, so a restart or a second server instance does not break a login that is under way.
/// - `state` is a random value, stored as it is, and is the primary key. The callback claims the row by deleting it,
///   in one statement that also matches `provider`. That makes it single use, and a state minted for one provider
///   cannot be claimed by another provider's callback.
/// - It expires 15 minutes after it is written. Expiry is checked after the claim, so an expired state is used up as
///   well. Each start also deletes the rows that have expired.
/// - `redirect` and `returnTo` say where to go after the login. `clientState` is the portal's browser nonce, stored
///   as it is and copied, hashed, onto the login AuthHandoffCode.
/// - `ceremonyNonceHash` (SHA-256 of the ceremony browser cookie) marks a state that is the sign-in step of a passkey
///   ceremony: it carries no `returnTo` or `clientState` (a CHECK), and its callback creates no session.
///   `providerNonceHash` is the SHA-256 of the OIDC nonce sent to Google or Apple; a CHECK requires it on new rows
///   for those two providers (prisma/login-nonce-invariants.sql).
///
/// Background: #477, #1631, #2204.
model PendingLoginState {
  /// The OAuth `state` CSRF token (random hex) — handed to the IdP at the
  /// start route and echoed back on the callback.
  state             String   @id
  /// 'github' | 'google' | 'apple' — a state minted for one provider can
  /// never be claimed by another provider's callback.
  provider          String
  /// Portal-local path to land on after login (portal-handoff flow).
  redirect          String?
  /// Spec 025 FR-007 Option-C server-local return path (cookie flow).
  returnTo          String?  @map("return_to")
  /// #477 session-fixation binding — the portal's browser nonce, stamped
  /// onto the login handoff code at the callback.
  clientState       String?  @map("client_state")
  /// #1631 PR1b: SHA-256 of the ceremony browser cookie when this state is a passkey ceremony's sign-in leg.
  /// Such a state carries no return_to or client_state (CHECK), and its callback mints no session.
  ceremonyNonceHash String?  @map("ceremony_nonce_hash")
  /// #2204: SHA-256 of the OIDC `nonce` sent to Google/Apple (binds the ID token to this attempt). NULL only for
  /// GitHub and for rows minted before #2204; `chk_pending_login_provider_nonce` (NOT VALID) refuses a new
  /// google/apple row without it. Distinct from `client_state` and `ceremony_nonce_hash`, which bind the browser.
  providerNonceHash String?  @map("provider_nonce_hash")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  // The lazy expiry sweep deletes WHERE expires_at < now() on every
  // unauthenticated start-route hit — keep it index-backed.
  @@index([expiresAt])
  @@map("pending_login_states")
}

// ─── Spec 040 — headless agent runs ─────────────────────────────────────────
// Design: D-2026-07-04 A–F over the 2026-05/06 design corpus (the spec-040 plan
// is retired; see git history). Spec: cor:agt:010 (+ cor:acl:040/:050).

/// Where a headless run is: PENDING until it starts, RUNNING while it executes, then one final state. COMPLETED
/// is a normal end; FAILED, TIMED_OUT and CANCELLED say why it stopped early. See `AppRun.status`.
enum AppRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  TIMED_OUT
  CANCELLED
}

/// What started a headless run: a schedule, a webhook call, a manual request, an integration event, or another
/// run. See `AppRun.triggerKind`.
enum AppRunTriggerKind {
  SCHEDULE
  WEBHOOK
  MANUAL
  INTEGRATION
  /// Fan-out (plan-spawn): child + callback runs minted by hadron_spawn;
  /// triggerId carries the parent run id.
  SPAWN
}

/// One headless run: an Agent's automation executed for an App with no person present, started by a schedule, a
/// webhook, a manual request, an integration event or another run. The row is the run's durable record, and it is
/// also what allows the run to go on: every action inside the run checks the row again.
///
/// Relationships: one foreign key to an owner, `agentId` to Agent (#3689): every run names an existing Agent, and
/// deleting an Agent row deletes its runs. `organizationId`, `appId`, `userId`, `triggerId` and `parentRunId` are plain
/// ids, so the database deletes nothing with them. ManualAutomationPin, WebFetchPollBinding and WebFetchEventReceipt
/// rows point at a run, and so does the record of the prompt a run was served (a foreign key in
/// prisma/served-prompt-invariants.sql).
///
/// Behaviour:
/// - Created only after the launch gate has passed (`mintAppRun`, src/jobs/appRuns.ts). No separate credential is
///   issued for a run.
/// - `userId` is the user the run acts on behalf of, taken from its trigger. Null means the run acts as the App alone
///   and reaches no personal memory (hrn:node:hadronmemory.com:specs:cor:agt:010:01).
/// - `triggerKind` and `triggerId` say what started it: SCHEDULE, WEBHOOK, MANUAL, INTEGRATION, or SPAWN for a run
///   another run started, in which case `triggerId` is the parent run's id.
/// - `policy`, `scopeSnapshot` and `registerSnapshot` are copied at creation, so a run does not change meaning when
///   someone edits a policy or a scope while it runs. The two snapshots are data only: every use intersects them with
///   what the run may reach at that moment.
/// - `budgetTokens` and `budgetActions` are what remains and are decremented as the run spends. Setting a budget to
///   zero, or `status` to CANCELLED, stops the run at its next action. `tokensSpent`, `actionsSpent` and
///   `costMicroCents` add up what was spent.
/// - `status` goes from PENDING to RUNNING and ends as COMPLETED, FAILED, TIMED_OUT or CANCELLED. `curNodeUrn` is
///   where the run is, `hops` the path it walked, `derivedLog` the derived prompt blocks each hop saw, and `failure`
///   what went wrong.
/// - `data` is the envelope of values that flow nodes extract as the run advances; `eventData` is the trigger's
///   payload and does not change. `spawn` is the state of a parent run that fanned out.
/// - The row is also the outbox for the "run requested" message: while `publishedAt` is null, a sweep publishes it
///   again.
///
/// Rules: hrn:node:hadronmemory.com:specs:cor:agt:010:01, hrn:node:hadronmemory.com:specs:cor:agt:010:02. Background:
/// #538, #832, #1719, #2047, #2438, #2439. Background (history, not law): the Spec Kit specs 040 and 049.
model AppRun {
  id                   String               @id
  organizationId       String               @map("organization_id")
  appId                String               @map("app_id")
  /// #3689 (hrn:node:hadronmemory.com:specs:cor:agt:010:01 rev 45): every run names an existing Agent. The DATABASE
  /// guarantees it: NOT NULL with a foreign key; an Agent hard delete removes its runs (gate R4). Mint refuses an
  /// agentless launch first, as BOOT_PROMPT_NOT_SET (hrn:node:hadronmemory.com:specs:cor:agt:040:07). The Prisma field
  /// stays OPTIONAL on purpose: a migration refused with HDPRF (#3770) is rolled back and this build then serves the old
  /// nullable column, whose retained agentless runs a required field cannot read (P2032). Tighten it only once the
  /// migration has applied everywhere (#3910 F1).
  agentId              String?              @map("agent_id")
  agent                Agent?               @relation("AppRunAgent", fields: [agentId], references: [id], onDelete: Cascade)
  /// On-behalf-of user (hrn:node:hadronmemory.com:specs:cor:agt:010:01, D-2026-07-04-C). NULL ⇒ pure App
  /// service identity — no personal/private reach.
  userId               String?              @map("user_id")
  triggerKind          AppRunTriggerKind    @map("trigger_kind")
  triggerId            String?              @map("trigger_id")
  /// #1719 R5b: owner-adopted complete graph; NULL fails closed at execution.
  automationPin        Json?                @map("automation_pin")
  manualAutomationPin  ManualAutomationPin?
  entryNodeUrn         String               @map("entry_node_urn")
  /// #2438: the entry node's stable id — what the run resolves by once the
  /// automation pin moved off literal URNs. NULL on runs minted before the
  /// column existed; those keep verifying under their stored pin's URN identity.
  entryNodeId          String?              @map("entry_node_id")
  eventData            Json?                @map("event_data")
  /// Run envelope (D-2026-05-09-013): the mutable bag of fields extracted
  /// by flow nodes as the walker advances. Bare field names — conditions
  /// address them through the evaluator's `message.data.*` scope prefix
  /// (plan-multi-node D-MN-1). `eventData` stays the immutable trigger
  /// payload; on key collision the envelope wins.
  data                 Json?
  /// Per-hop trail (#538): the walked path, one element per COMPLETED hop,
  /// appended in the same checkpoint/finish UPDATE the runner already
  /// writes. `[{node, edgeOut, startedAt, finishedAt, tokensSpent}]` —
  /// edgeOut is the routing edge taken FROM the hop (null on the last).
  /// Bounded by RUN_MAX_HOPS. A hop that FAILS mid-execution has no
  /// element; `curNodeUrn` + `failure` identify it.
  hops                 Json?
  /// #2047 (S10, hrn:node:hadronmemory.com:specs:cor:agt:040:03): the derived blocks each hop of the run saw, append-only, `[{hop, blocks}]`, where
  /// `blocks` is the full list and may be EMPTY (so a block going away is recorded too). An entry is written, guarded on
  /// RUNNING, before the hop's LLM call and only when the blocks differ from the last entry, so a hop that fails or is
  /// aborted (it gets no `hops` element) still shows what it saw. The blocks seen by hop n are the last entry with
  /// hop <= n. Run progress, readable by the run read gate; deliberately NOT part of the immutable boot record.
  derivedLog           Json?             @map("derived_log")
  /// PARENT-side fan-out state (plan-spawn D-SP-1): set by hadron_spawn —
  /// {processItem, itemKey, callback?, itemCallback?, total, dispatching?,
  /// callbackFiredAt?}. Its own column, NOT `data`: the parent's envelope
  /// checkpoint would clobber a mid-hop write there. callbackFiredAt is the
  /// exactly-once claim (D-SP-4, atomic SQL).
  spawn                Json?
  /// Run-layer allow-list snapshot (the narrowest chain link; plan §4).
  policy               Json?
  /// Remaining LLM tokens — live-decrement kill switch.
  budgetTokens         Int?                 @map("budget_tokens")
  /// Remaining tool/write actions — live-decrement kill switch.
  budgetActions        Int?                 @map("budget_actions")
  /// #832 — the budget this run was MINTED with, so a client can render
  /// "spent vs budget". `budgetTokens` above is what REMAINS. NULL on runs
  /// minted before the column existed.
  budgetTokensInitial  Int?                 @map("budget_tokens_initial")
  budgetActionsInitial Int?                 @map("budget_actions_initial")
  /// #832 — cumulative spend, incremented in the same write as the budget
  /// decrement. Deliberately NOT derived:
  ///   * a `hops` sum under-reports — a hop that failed mid-execution has no
  ///     element, which is exactly the run an operator is auditing;
  ///   * `initial - remaining` under-reports too — the decrement is CLAMPED
  ///     (`Math.min(spent, budget)`) so the remaining budget never goes
  ///     negative, and an overspending run would report exactly its budget.
  /// These counters are unclamped and therefore truthful in overage.
  ///
  /// NULLABLE with a default: new runs start at 0, while a run minted BEFORE
  /// the columns existed is genuinely UNKNOWN rather than zero — reporting 0
  /// for a run whose already-decremented budget proves otherwise would be a
  /// false total (PR #854 review, Codex P2). `tokens_spent` is backfilled from
  /// the hop trail where one exists; `actions_spent` has no such signal.
  ///
  /// A rejected tool-loop call counts the steps the SDK had already completed
  /// (#862); usage the SDK did not report (the failed step, or a step without
  /// counts) is not counted, so such a run can still under-report. See the
  /// GraphQL field docs.
  tokensSpent          Int?                 @default(0) @map("tokens_spent")
  actionsSpent         Int?                 @default(0) @map("actions_spent")
  /// #2439 — priced LLM cost of this run in micro-cents (1e-8 USD): the sum of
  /// its usage events' `costMicroCents`, incremented where each event is
  /// recorded. Unpriced events add nothing. NULL = UNKNOWN for a run minted
  /// before the column existed (no usage-event link to back-fill from); new
  /// runs start at 0.
  costMicroCents       BigInt?              @map("cost_micro_cents")
  status               AppRunStatus         @default(PENDING)
  curNodeUrn           String?              @map("cur_node_urn")
  /// Spec 049 Phase 3b (D-2026-09-13-004): the trigger's scope, SNAPSHOTTED at mint as
  /// its ordered memory-id list (as `policy` is snapshotted — a run must not change
  /// meaning because someone edited a scope mid-flight). SCOPE DATA ONLY: every
  /// consumer re-intersects it with the principal's CURRENT access (`resolveRunScope`);
  /// never an access grant that outlives a revoked membership. NULL ⇒ `app`.
  scopeSnapshot        Json?                @map("scope_snapshot")
  /// Spec 049 Phase 6 (D-2026-09-13-007): the attendee's resolved REGISTER at mint
  /// (Agent-in-App = agentId + appId), rows only — for the attention section (Phase 7).
  /// Same re-intersection rule as scopeSnapshot: the Channel watermarks are read
  /// live and the gates are evaluated on every use; never a grant. NULL ⇒ no attendee.
  registerSnapshot     Json?                @map("register_snapshot")
  parentRunId          String?              @map("parent_run_id")
  failure              Json?
  timeoutMs            Int?                 @map("timeout_ms")
  attempts             Int                  @default(0)
  publishedAt          DateTime?            @map("published_at")
  startedAt            DateTime?            @map("started_at")
  finishedAt           DateTime?            @map("finished_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  createdBy            String?              @map("created_by")

  webFetchPollBindings  WebFetchPollBinding[]  @relation("WebFetchPollSourceRun")
  webFetchEventReceipts WebFetchEventReceipt[] @relation("WebFetchEventRoutedRun")

  @@index([status, publishedAt])
  @@index([appId, createdAt])
  @@index([triggerId, status])
  @@index([agentId])
  @@index([parentRunId]) // spawn completion checks + child listings (plan-spawn)
  @@index([organizationId, createdAt])
  @@map("app_runs")
}

/// A trigger that starts a headless run on a timetable: either repeatedly, on a cron expression, or once at a set
/// time. Each time it is due, the scheduler creates one AppRun.
///
/// Relationships: `scope` is the optional Scope that its runs carry (SetNull). `organizationId`, `appId`, `agentId`
/// and `userId` are plain ids with no foreign key.
///
/// Behaviour:
/// - Created and edited through the schedule mutations (src/api/graphql/schema/resolvers.appRun.ts). `userId` is the
///   user its runs act on behalf of, captured at creation (hrn:node:hadronmemory.com:specs:cor:agt:010:01).
/// - Exactly one of `cron` and `runAt` is set (`chk_agent_schedule_cron_xor_run_at`). `cron` is a 5-field expression
///   evaluated in `timezone`.
/// - The scheduler (src/jobs/scheduler.ts) claims a due row (`enabled`, not deleted, `nextRunAt` passed) by moving
///   `nextRunAt` to the next occurrence in one guarded update, so only one instance starts the run. A one-shot
///   schedule is disabled by the claim. An overdue schedule runs once, not once for every missed slot, and a tick
///   that is skipped because the previous run is still going still moves `nextRunAt`.
/// - `entryNodeUrn` and `entryNodeId` name the automation's entry node. `automationPin` is the complete automation
///   its owner adopted; a null pin makes the run fail before it executes.
/// - `budgetTokens` and `budgetActions` are optional limits for each run; null uses the platform default. `policy` is
///   the trigger's own allow-list and `aiConfigName` its AI configuration override.
/// - Deleting is a soft delete (`deletedAt`).
///
/// Specs: hrn:node:hadronmemory.com:specs:cor:agt:010, hrn:node:hadronmemory.com:specs:cor:agt:010:01. Background:
/// #510, #1719, #2438, #2479.
model AgentSchedule {
  id             String    @id
  organizationId String    @map("organization_id")
  appId          String    @map("app_id")
  agentId        String?   @map("agent_id")
  /// On-behalf-of user, captured at creation (hrn:node:hadronmemory.com:specs:cor:agt:010:01).
  userId         String?   @map("user_id")
  name           String
  /// 5-field cron expression, evaluated in `timezone` — recurring
  /// schedules. XOR with `runAt` (chk_agent_schedule_cron_xor_run_at).
  cron           String?
  timezone       String    @default("UTC")
  /// One-shot: run once at this instant (#510). XOR with `cron`; the
  /// scheduler claim flips `enabled` to false instead of advancing
  /// `nextRunAt`. Misfire policy unchanged (overdue runs once).
  runAt          DateTime? @map("run_at")
  /// #1719 R5b: owner-adopted complete graph; NULL fails closed at execution.
  automationPin  Json?     @map("automation_pin")
  entryNodeUrn   String    @map("entry_node_urn")
  /// #2438: the entry node's stable id, stamped at adoption (and lazily at
  /// launch) — a same-memory rename/move of the entry keeps the trigger
  /// working; entryNodeUrn stays the immutable display/audit address.
  entryNodeId     String?   @map("entry_node_id")
  /// #2479: optional per-run limits; NULL uses the current platform default.
  budgetTokens   Int?      @map("budget_tokens")
  budgetActions  Int?      @map("budget_actions")
  eventData      Json?     @map("event_data")
  /// Trigger-layer allow-list (chain link; plan §4).
  policy         Json?
  /// Per-trigger AI-config override (name into the spec-036 walk).
  aiConfigName   String?   @map("ai_config_name")
  /// Spec 049 Phase 3b (D-2026-09-13-004) — the scope this trigger's runs carry, snapshotted at mint; NULL ⇒ `app`.
  scopeId        String?   @map("scope_id")
  enabled        Boolean   @default(true)
  lastRunAt      DateTime? @map("last_run_at")
  /// Next due time — the scheduler's work signal. A skipped overlap STILL
  /// advances this (plan §7; prevents back-to-back storms).
  nextRunAt      DateTime? @map("next_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")
  scope          Scope?    @relation(fields: [scopeId], references: [id], onDelete: SetNull)

  @@index([enabled, nextRunAt])
  @@index([appId, deletedAt])
  @@index([scopeId])
  @@map("agent_schedules")
}

/// A usage counter for one App or one organization: how much of one metered action has been used in the current day,
/// and the limit. It is the first of the two quota tiers, the continuous one.
///
/// Relationships: none by foreign key. `scopeKind` (`app` or `org`) and `scopeId` name the owner as plain values. One
/// row per owner, action and window.
///
/// Behaviour:
/// - The metered actions are `run.execute` (runs), `llm.tokens` (model tokens), `sms.send` and `email.send`. The only
///   `window` is `day`.
/// - A row is created on first use with the platform default as its `limit` (src/jobs/appRuns.ts). After that the
///   stored `limit` is what is enforced, and it can be changed per row (`setQuotaLimit`); 0 pauses the owner.
/// - `used` is checked at the launch gate and raised while a run executes. When `resetAt` has passed, the next touch
///   sets `used` back to 0 and moves `resetAt` to the next midnight UTC.
///
/// Rules: hrn:node:hadronmemory.com:specs:cor:acl:050:01, hrn:node:hadronmemory.com:specs:cor:acl:050:04.
model QuotaCounter {
  id        String   @id
  scopeKind String   @map("scope_kind")
  scopeId   String   @map("scope_id")
  action    String
  window    String
  used      Int      @default(0)
  limit     Int
  resetAt   DateTime @map("reset_at")

  @@unique([scopeKind, scopeId, action, window])
  @@map("quota_counters")
}

/// A ticket that allows one use of a sensitive action. It is the second of the two quota tiers: each use of the
/// action spends one ticket, and the table is the ledger that shows where every ticket went.
///
/// Relationships: none by foreign key. `organizationId`, `appId`, `mintedBy` and `consumedByRunId` are plain ids.
///
/// Behaviour:
/// - Tickets are minted in batches by a mutation (src/api/graphql/schema/resolvers.appRun.ts), for an organization or
///   for one App in it. Today only the action `comm.outbound` can be minted: anything that leaves the platform for
///   good, such as an email or a text message.
/// - A run that wants to perform the action must spend one (`consumeActionTicket`, src/jobs/appRuns.ts). A ticket of
///   the App is preferred over one of the whole organization. The claim is a guarded update that sets `consumedAt`
///   and `consumedByRunId`, so a ticket is spent once and names the run that spent it.
/// - A ticket past its `expiresAt` cannot be spent. When there is none to spend, the run skips the action and records
///   why.
///
/// Rules: hrn:node:hadronmemory.com:specs:cor:acl:050:01, hrn:node:hadronmemory.com:specs:cor:acl:050:04.
model ActionTicket {
  id              String    @id
  organizationId  String    @map("organization_id")
  appId           String?   @map("app_id")
  action          String
  mintedBy        String    @map("minted_by")
  note            String?
  consumedByRunId String?   @map("consumed_by_run_id")
  consumedAt      DateTime? @map("consumed_at")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([organizationId, action, consumedAt])
  @@map("action_tickets")
}

/// The price of one AI model from one provider, from a given moment on. The platform uses it to work out what a unit
/// of model usage cost, and what markup applies when that cost is charged to an organization's credits.
///
/// Relationships: none. UsageEvent rows store the cost that was computed from a price; they do not point at the price
/// row.
///
/// Behaviour:
/// - One row per `provider`, `model`, `tier` and `effectiveAt`. A lookup takes the newest row whose `effectiveAt` is
///   not after the time of the usage and that is not soft-deleted (`getAiModelPrice`, src/lib/metering/index.ts).
/// - A price change adds a new row and never edits an old one, so the rate in force at the time of the work stays on
///   record. A cost stored on a usage event is a snapshot and is never recomputed, which is why soft-deleting a wrong
///   row is safe.
/// - Prices are in micro-cents (1e-8 USD) per million tokens, separately for input and output. `markupBasisPoints` is
///   the markup at this tier (2500 = 25%); null falls back to `CREDIT_MARKUP_PERCENT`.
/// - `tier` is 1 to 3 and everything resolves tier 1 today. The columns are strings and integers with no enum or
///   CHECK; validation is in src/lib/metering.
/// - Managed by a platform admin (`setAiModelPrice`). A model with no price row gets no cost; the call itself is
///   never blocked.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:dmo:100:02. Background (history, not law): the Spec Kit spec 046.
model AiModelPrice {
  id                      String    @id
  provider                String
  model                   String
  /// Pricing tier 1-3 (Holger, 2026-07-11): reserved room for future
  /// product tiers carrying different markups per (provider, model)
  /// WITHOUT another AiModelPrice migration. Everything defaults to and
  /// resolves tier 1 until tiers become a real product concept; the
  /// semantics of 2/3 are deliberately undefined today. Validated 1-3 in
  /// code (setAiModelPrice / getAiModelPrice), no CHECK by convention.
  tier                    Int       @default(1)
  /// Micro-cents per 1M input tokens.
  inputMicroCentsPerMTok  BigInt    @map("input_micro_cents_per_mtok")
  /// Micro-cents per 1M output tokens.
  outputMicroCentsPerMTok BigInt    @map("output_micro_cents_per_mtok")
  /// Markup applied when debiting platform-key spend at THIS tier, in
  /// basis points (2500 = 25%) — integer-exact, no float money. NULL
  /// falls back to the CREDIT_MARKUP_PERCENT env (which this column
  /// supersedes). Effective-dated with the rest of the row.
  markupBasisPoints       Int?      @map("markup_basis_points")
  /// Row applies to events at/after this instant (until a later row).
  effectiveAt             DateTime  @map("effective_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  createdBy               String?   @map("created_by")
  updatedAt               DateTime? @updatedAt @map("updated_at")
  updatedBy               String?   @map("updated_by")
  deletedAt               DateTime? @map("deleted_at")
  deletedBy               String?   @map("deleted_by")

  @@unique([provider, model, tier, effectiveAt])
  @@index([provider, model, tier])
  @@map("ai_model_prices")
}

/// One entry in an organization's ledger of AI credits: an amount added or taken away. The balance of an organization
/// is the sum of its entries; no balance is stored anywhere.
///
/// Relationships: belongs to one Organization and is deleted with it. `sourceType` and `sourceId` name where the
/// entry came from as plain values, for example a UsageEvent or the administrator who granted it.
///
/// Behaviour:
/// - `kind` is `grant` (a positive amount), `debit` (negative) or `adjustment` (either). `amountMicroCents` is
///   signed, in micro-cents (1e-8 USD).
/// - Grants are written by a platform admin (`grantCredits`) and debits by usage metering (`debitCredits`,
///   src/lib/metering/index.ts). A debit is written only when `BILLING_DEBIT_ENABLED` is on, and only for usage on
///   the platform's own provider key (hrn:node:hadronmemory.com:specs:cor:dmo:100:03). No code writes an `adjustment`
///   today.
/// - Entries are never edited or reset. A correction is a new `adjustment` entry. Soft-deleting an entry is an
///   emergency measure for operators only; the balance leaves soft-deleted entries out.
/// - At most one entry per (`sourceType`, `sourceId`), so a payment notification that arrives twice produces one
///   entry. Entries with no source are not limited.
/// - `expiresAt` on a grant is stored and not enforced.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:dmo:100:04. Background (history, not law): the Spec Kit spec 046.
model CreditLedgerEntry {
  id               String    @id
  organizationId   String    @map("organization_id")
  /// 'grant' | 'debit' | 'adjustment' (validated in src/lib/metering).
  kind             String
  /// Signed micro-cents (1e-8 USD). Grants positive, debits negative.
  amountMicroCents BigInt    @map("amount_micro_cents")
  /// Grant expiry policy field (no enforcement in Phase 0).
  expiresAt        DateTime? @map("expires_at")
  /// Provenance: e.g. ('usage-event', <UsageEvent.id>), ('admin', <userId>),
  /// later ('payment', <processor ref>).
  sourceType       String?   @map("source_type")
  sourceId         String?   @map("source_id")
  note             String?
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Idempotency for at-least-once payment webhooks (hadrontool-billing):
  // one ledger row per (sourceType, sourceId); NULL-source rows unaffected
  // (Postgres unique treats NULLs as distinct).
  @@unique([sourceType, sourceId])
  @@index([organizationId, createdAt])
  @@map("credit_ledger_entries")
}

/// A trigger that starts a headless run when an outside system calls a URL. Each accepted call creates one AppRun.
///
/// Relationships: `scope` is the optional Scope that its runs carry (SetNull). `organizationId`, `appId`, `agentId`
/// and `userId` are plain ids with no foreign key.
///
/// Behaviour:
/// - The URL is `/hooks/<secret>/<name>?hpt=<token>` (src/api/webhooks.ts). `secret` is a random value, unique,
///   stored as it is, and is how the webhook is looked up, so the URL names no App or Agent.
/// - The `hpt` token is the second factor: a time-limited token the platform signs for this one webhook and shows
///   once, at creation or rotation. It is not stored. The secret alone is not enough: a call without a valid token is
///   refused.
/// - `userId` is the user its runs act on behalf of, captured at creation
///   (hrn:node:hadronmemory.com:specs:cor:agt:010:01).
/// - `entryNodeUrn` and `entryNodeId` name the automation's entry node. `automationPin` is the complete automation
///   its owner adopted; a null pin makes the run fail before it executes.
/// - `argsSchema` is a JSON Schema for the posted arguments. It is stored and not yet enforced.
/// - `budgetTokens` and `budgetActions` are optional limits for each run; null uses the platform default.
///   `lastCalledAt` is updated on each accepted call. Deleting is a soft delete.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:010:01. Background (history, not law): the Spec Kit spec 040.
/// Background: #1719, #2438, #2479.
model AgentWebhook {
  id             String    @id
  organizationId String    @map("organization_id")
  appId          String    @map("app_id")
  agentId        String?   @map("agent_id")
  /// On-behalf-of user, captured at creation (hrn:node:hadronmemory.com:specs:cor:agt:010:01).
  userId         String?   @map("user_id")
  name           String
  /// Opaque URL secret — unique lookup key, never reused across webhooks.
  secret         String    @unique
  /// JSON Schema for POST args (stored in v1; Ajv enforcement is follow-on).
  argsSchema     Json?     @map("args_schema")
  /// #1719 R5b: owner-adopted complete graph; NULL fails closed at execution.
  automationPin  Json?     @map("automation_pin")
  entryNodeUrn   String    @map("entry_node_urn")
  /// #2438: the entry node's stable id, stamped at adoption (and lazily at
  /// launch) — a same-memory rename/move of the entry keeps the trigger
  /// working; entryNodeUrn stays the immutable display/audit address.
  entryNodeId     String?   @map("entry_node_id")
  /// #2479: optional per-run limits; NULL uses the current platform default.
  budgetTokens   Int?      @map("budget_tokens")
  budgetActions  Int?      @map("budget_actions")
  eventData      Json?     @map("event_data")
  policy         Json?
  aiConfigName   String?   @map("ai_config_name")
  /// Spec 049 Phase 3b (D-2026-09-13-004) — the scope this trigger's runs carry, snapshotted at mint; NULL ⇒ `app`.
  scopeId        String?   @map("scope_id")
  enabled        Boolean   @default(true)
  lastCalledAt   DateTime? @map("last_called_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")
  scope          Scope?    @relation(fields: [scopeId], references: [id], onDelete: SetNull)

  @@index([appId, deletedAt])
  @@index([scopeId])
  @@map("agent_webhooks")
}

/// What one MCP client of one user has selected: its active App, memory, organization and scope. The row lets those
/// selections survive a server restart or a reconnect, which the in-process state of an MCP connection does not.
///
/// Relationships: belongs to one User and is deleted with the user. `app`, `memory`, `organization` and `scope` are
/// the selections, each optional and SetNull, so a deleted target reads as "nothing selected".
///
/// Behaviour:
/// - One row per user and `clientKey`, written by upsert when a selection changes (src/lib/mcpSessionState.ts).
///   `clientKey` is the client's own stable id, sent in the `X-Hadron-Client-Id` header. A client that sends none is
///   not stored at all and keeps its selections in memory only.
/// - The key is the client, not the MCP session id, because the session id is what does not survive. It is per client
///   and not per user, so that one person using several clients at once does not have one of them change the active
///   App of the others.
/// - The row remembers a choice and grants nothing. Each selection is authorized again when it is read: the App by
///   current participation, the memory by the memory read gate, the organization by current membership, the scope by
///   whether the caller can read it.
/// - The memory is stored by id, not by URN, so a rename does not lose it.
///
/// Background: #1005, #1009, #1012. Background (history, not law): the Spec Kit spec 049.
model McpSessionState {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  /// Caller-supplied stable client-instance id (`X-Hadron-Client-Id`). Opaque
  /// to the server; length-capped and trimmed at the boundary.
  clientKey String @map("client_key")

  /// The active App selection, or NULL if none. Re-authorized on every read.
  appId          String? @map("app_id")
  /// The active memory selection, stored as the PK rather than the URN so a
  /// rename cannot strand it. The URN is resolved on read.
  memoryId       String? @map("memory_id")
  /// Spec 049 Phase 1 (D-2026-09-13-003) — the EXPLICITLY selected active
  /// organization (`hadron_set_active_org`), or NULL if none. Distinct from
  /// the App's organization, which is derived from `appId` at read time and
  /// outranks this in the resolution ladder (`src/lib/auth/activeOrg.ts`).
  /// Re-authorized against current org membership on every read — a stored
  /// selection is a cache of a choice, never a grant.
  organizationId String? @map("organization_id")
  /// Spec 049 Phase 3 (D-2026-09-13-002) — the session's ACTIVE SCOPE
  /// (`hadron_set_active_scope`): rung 2 of the search ladder, outranked only
  /// by a scope named in the call. Re-authorized (readable) on every read.
  scopeId        String? @map("scope_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  app          App?          @relation(fields: [appId], references: [id], onDelete: SetNull)
  memory       Memory?       @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  scope        Scope?        @relation(fields: [scopeId], references: [id], onDelete: SetNull)

  /// One row per (user, client instance) — the upsert target.
  @@unique([userId, clientKey], map: "mcp_session_state_user_client_uniq")
  @@index([appId])
  @@index([memoryId])
  @@index([organizationId])
  @@index([scopeId])
  @@map("mcp_session_state")
}

/// Which kind of entity a {@link UrnAlias} addresses. The four stored-URN
/// entities can be renamed; a Node also needs its own alias when a move
/// rewrites its memory or loc without renaming either parent (#1391).
enum UrnAliasEntityType {
  ORGANIZATION
  MEMORY
  AGENT
  APP
  NODE
}

/// Why a {@link UrnAlias} row exists.
enum UrnAliasReason {
  /// A deliberate rename of the entity's own URN.
  RENAME
  /// The org-URN prefix rewrite cascaded onto a child row (#337).
  ORG_RENAME_CASCADE
  /// The pre-v2 URN this row was migrated FROM (#697) — backfilled from the
  /// per-table `legacy_urn` columns, which this table supersedes.
  V1_MIGRATION
}

/// A URN that an entity used to answer to. URNs are published in places that cannot be rewritten later (commit
/// trailers, pull requests, chat messages, exported documents), so when a rename or a move changes an entity's URN,
/// the old one is kept here and goes on resolving.
///
/// Relationships: none by foreign key. `entityType` (ORGANIZATION, MEMORY, AGENT, APP or NODE) and `entityId` name
/// the entity as plain values.
///
/// Behaviour:
/// - Written by `recordUrnRename` (src/lib/urnAlias.ts) in the same transaction as the rename. `reason` says why: a
///   rename of the entity itself, an organization rename that carried over to a child, or the URN an entity had
///   before the version 2 format.
/// - Organizations, memories, agents and Apps store their URN, and renaming one of them also changes every URN
///   composed from it, such as a node URN under a renamed memory. Aliasing those four covers that. A node gets its
///   own alias when a move changes its memory or loc while both parents keep their URNs.
/// - `urn` is stored in the normalized form the resolvers look up (prefix removed, `::` collapsed to `:`).
///   `replacedByUrn` is for the record only and is never matched.
/// - A live URN always wins: resolvers try the entity's own URN first and read this table only on a miss. An old URN
///   can be taken by a new entity, so two entities may have held the same URN at different times. The alias URN is
///   therefore not unique, and a lookup that matches more than one live entity is refused, not guessed.
/// - One row per URN and entity, so renaming back and forth adds no duplicates.
/// - A row stores no liveness and gives no access. The entity is read again through its normal gate, so an alias
///   never brings back a deleted entity and never shows one to a caller who may not see it.
///
/// Rules: hrn:node:hadronmemory.com:specs:cor:urn:030:01, hrn:node:hadronmemory.com:specs:cor:urn:030:02. Background:
/// #337, #697, #1079, #1391.
model UrnAlias {
  id String @id @default(cuid())

  /// The superseded URN, stored in the same normalized lookup form the
  /// resolvers compute (`hrn:`/`urn:` prefix stripped, `::` collapsed to `:`)
  /// — a raw spelling here would be unreachable from a normalized query.
  urn        String             @map("urn")
  entityType UrnAliasEntityType @map("entity_type")
  entityId   String             @map("entity_id")
  reason     UrnAliasReason

  /// The URN that replaced it — provenance only, never matched on. Null for a
  /// V1_MIGRATION backfill row, whose successor is the entity's current urn.
  replacedByUrn String? @map("replaced_by_urn")

  createdAt DateTime @default(now()) @map("created_at")
  /// Who performed the rename, when a principal was attributable.
  createdBy String?  @map("created_by")

  /// One alias row per (urn, entity) — a rename back and forth must not
  /// accumulate duplicates, which would read as an ambiguous lookup and start
  /// refusing a URN that resolves to exactly one entity.
  @@unique([urn, entityType, entityId], map: "urn_aliases_urn_entity_uniq")
  /// The lookup index: resolvers query by (urn, entityType).
  @@index([urn, entityType])
  /// Reverse lookup — "what did this entity used to be called".
  @@index([entityType, entityId])
  @@map("urn_aliases")
}

/// A named, ordered list of memories that a caller selects to narrow what a search or read looks at. A scope is a
/// lens: it changes what the caller is looking at, never what the caller may reach.
///
/// Relationships: owned by exactly one of an Organization, an Agent or an App, as three nullable foreign keys with a
/// CHECK (`chk_scope_owner`), and deleted with its owner. ScopeMemory rows hold its memories. McpSessionState,
/// AgentSchedule and AgentWebhook rows may point at a scope (SetNull).
///
/// Behaviour:
/// - Created and changed through the scope mutations (src/api/graphql/schema/resolvers.scope.ts); the rules are in
///   src/lib/scopes.ts.
/// - A scope selects memories only. It stores no filter and no retrieval settings; those stay per call.
/// - A scope never grants. Every use intersects its memories with the ones the caller can already read, and reports
///   how many were left out (hrn:node:hadronmemory.com:specs:cor:acl:120:01).
/// - `name` is unique per owner among rows that are not soft-deleted. The partial unique indexes are in
///   prisma/post-push.sql, because Prisma cannot express them and a plain unique would let a deleted scope block its
///   name forever.
/// - When several owners in an App's context have a scope of the same name, the App's wins over the Agent's, and the
///   Agent's over the organization's. The lists are never merged (hrn:node:hadronmemory.com:specs:cor:acl:120:03).
/// - The names `global` and `app` are reserved for the built-in views and are refused at creation
///   (hrn:node:hadronmemory.com:specs:cor:acl:120:02).
/// - A schedule or webhook that names a scope copies its memory list into each run at creation
///   (`AppRun.scopeSnapshot`).
///
/// Specs: hrn:node:hadronmemory.com:specs:cor:acl:120:00, hrn:node:hadronmemory.com:specs:cor:acl:120:01,
/// hrn:node:hadronmemory.com:specs:cor:acl:120:02, hrn:node:hadronmemory.com:specs:cor:acl:120:03. Background
/// (history, not law): the Spec Kit spec 049.
model Scope {
  id             String    @id @default(cuid())
  name           String
  description    String?
  organizationId String?   @map("organization_id")
  agentId        String?   @map("agent_id")
  appId          String?   @map("app_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent            Agent?            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  app              App?              @relation(fields: [appId], references: [id], onDelete: Cascade)
  memories         ScopeMemory[]
  mcpSessionStates McpSessionState[]
  agentSchedules   AgentSchedule[]
  agentWebhooks    AgentWebhook[]

  @@index([organizationId])
  @@index([agentId])
  @@index([appId])
  @@map("scopes")
}

/// One memory in a Scope's list, with its position in the list.
///
/// Relationships: joins Scope and Memory, one row per pair (the primary key), and is deleted with either, so a
/// deleted memory drops out of every scope.
///
/// Behaviour:
/// - It is a table and not a list of ids on the Scope, so that "which scopes include this memory" is a query.
/// - `position` is the 0-based order within the scope, unique per scope. The order is stored for operations where a
///   deliberate sequence matters; search ignores it (hrn:node:hadronmemory.com:specs:cor:acl:120:00).
/// - The model has no `id` column and is listed in `MODELS_WITHOUT_ID` (src/integrations/db/client.ts).
///
/// Spec: hrn:node:hadronmemory.com:specs:cor:acl:120:00. Background (history, not law): the Spec Kit spec 049.
model ScopeMemory {
  scopeId  String @map("scope_id")
  memoryId String @map("memory_id")
  /// 0-based order within the scope — the only thing the task-customization
  /// operation will consume; search ignores it (D-2026-09-13-005).
  position Int

  scope  Scope  @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@id([scopeId, memoryId])
  @@unique([scopeId, position])
  @@index([memoryId])
  @@map("scope_memories")
}

/// Spec 049 Phase 4 (D-2026-09-13-006) — what kind of feed a Channel is. `CHAT`
/// today; `BLOCKERS` / `TASKS` when built (D7 local, register session). Adding
/// a value that a CHECK references is TWO migration files (the Postgres
/// transaction rule).
enum ChannelKind {
  CHAT
}

/// A durable, ordered stream of messages that people and Agents post to, hosted in one memory at one reserved address
/// (for example `chats:team`). The server orders the messages and records who wrote each one. A channel is not a
/// chatbot conversation.
///
/// Relationships: belongs to the Memory that hosts it and is deleted with it. `chatRoot` is the Node at the channel's
/// address, one-to-one (`chatRootNodeId` is unique), and the channel is deleted with that node. An App may name a
/// channel as its default. RegisterEntry and ChannelReadState rows point at the channel and are deleted with it.
///
/// Behaviour:
/// - The row is a platform entity of its own, not the chat root node. Both are created together in one transaction,
///   so neither exists without the other and the address is protected before the first post
///   (hrn:node:hadronmemory.com:specs:cor:dmo:090:01).
/// - Creating the row reserves and protects `loc`. Every generic node write under it, and every subtree operation
///   that overlaps it, is refused (src/lib/protectedLoc.ts); posts go through the channel's own operations. This
///   table is the only source of address protection (hrn:node:hadronmemory.com:specs:cor:dmo:090:02).
/// - `lastSeq` and `lastMessageAt` are the channel's high-water mark. The message append writes them under its lock,
///   in the same transaction that allocates the sequence number. The difference between `lastSeq` and a reader's
///   `lastSeenSeq` is a distance between two marks, not a count of messages, because sequence numbers can have gaps.
/// - Deleting is a soft delete, in step with the chat root; the protection holds while either exists. Reusing the
///   address of a deleted channel marks the old transcript deleted, resets the marks and raises `incarnation`, so a
///   request that was resolved against the earlier channel cannot post to or delete the new one. Sequence numbers
///   continue above the old maximum, so a reader's kept cursor cannot hide a new message
///   (hrn:node:hadronmemory.com:specs:cor:dmo:090:03).
/// - A channel has no access rules of its own. Who may read and post is decided by the host memory
///   (hrn:node:hadronmemory.com:specs:cor:acl:030:01).
/// - `kind` is CHAT, the only kind today.
///
/// Specs: hrn:node:hadronmemory.com:specs:cor:dmo:090:01, hrn:node:hadronmemory.com:specs:cor:dmo:090:02,
/// hrn:node:hadronmemory.com:specs:cor:dmo:090:03, hrn:node:hadronmemory.com:specs:cor:acl:030:01. Background: #1047,
/// #1201. Background (history, not law): the Spec Kit spec 049.
model Channel {
  id             String      @id @default(cuid())
  memoryId       String      @map("memory_id")
  /// The reserved address of the chat root (e.g. `chats:team`).
  loc            String
  name           String
  kind           ChannelKind @default(CHAT)
  description    String?
  chatRootNodeId String      @unique @map("chat_root_node_id")
  lastSeq        Int         @default(0) @map("last_seq")
  lastMessageAt  DateTime?   @map("last_message_at")
  /// Monotonic identity of the live occupancy at this reserved address.
  /// Incremented when a tombstoned Channel is reused so requests resolved
  /// against the previous incarnation cannot post to or delete the new one.
  incarnation    Int         @default(1)
  createdAt      DateTime    @default(now()) @map("created_at")
  createdBy      String?     @map("created_by")
  updatedAt      DateTime?   @updatedAt @map("updated_at")
  updatedBy      String?     @map("updated_by")
  deletedAt      DateTime?   @map("deleted_at")
  deletedBy      String?     @map("deleted_by")

  memory          Memory             @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  chatRoot        Node               @relation("ChannelRoot", fields: [chatRootNodeId], references: [id], onDelete: Cascade)
  defaultOfApps   App[]              @relation("AppDefaultChannel")
  registerEntries RegisterEntry[]
  readStates      ChannelReadState[]

  /// One Channel per address.
  @@unique([memoryId, loc])
  @@index([memoryId])
  @@map("channels")
}

/// Spec 049 Phase 5 — what a register row declares about an attendee's
/// relationship to a Channel: INTENT, never permission (D-2026-09-13-008).
enum RegisterRole {
  WATCH
  POST
  BOTH
}

/// A statement that an attendee takes part in a Channel: it should be told about what is posted there, may post
/// there, or both. The register is how the platform knows which channels to bring to the attention of which Worker or
/// Agent.
///
/// Relationships: owned by exactly one of an Organization or an App (`chk_register_owner`) and deleted with it.
/// `channel` is the Channel it is about. The attendee is `attendeeWorker` when a Worker is cast, otherwise
/// `attendeeAgent`, an Agent in the owner's context. The row is deleted with the channel and with the attendee.
///
/// Behaviour:
/// - When both attendee columns are null, the entry means every attendee in the owner's context: the whole
///   organization for an organization's entry, the whole App for an App's entry.
/// - `role` is WATCH, POST or BOTH and states intent, never permission. The register grants nothing: whether an
///   attendee can read or post is decided by the channel's host memory when it is used.
/// - A row never starts a run. `mentionOnly` limits what counts as new for the attendee to messages that mention it.
/// - `installDefault` marks the row that installing an Agent created for the App's default channel
///   (src/lib/registerInstall.ts). An App may remove it, and uninstalling removes it.
/// - Entries are platform records, not content: they are left out of memory export and the git mirror.
/// - Among rows that are not soft-deleted there is one entry per owner, channel and attendee (partial unique indexes
///   in prisma/post-push.sql).
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:dmo:090:04. Background (history, not law): the Spec Kit spec 049.
model RegisterEntry {
  id               String       @id @default(cuid())
  organizationId   String?      @map("organization_id")
  appId            String?      @map("app_id")
  channelId        String       @map("channel_id")
  attendeeWorkerId String?      @map("attendee_worker_id")
  attendeeAgentId  String?      @map("attendee_agent_id")
  role             RegisterRole @default(BOTH)
  mentionOnly      Boolean      @default(false) @map("mention_only")
  /// The human's intent, free text (D1).
  description      String?
  /// D2 — the row install materialised for the App's default Channel; an App
  /// may remove it (D4), uninstall removes it.
  installDefault   Boolean      @default(false) @map("install_default")
  createdAt        DateTime     @default(now()) @map("created_at")
  createdBy        String?      @map("created_by")
  updatedAt        DateTime?    @updatedAt @map("updated_at")
  updatedBy        String?      @map("updated_by")
  deletedAt        DateTime?    @map("deleted_at")
  deletedBy        String?      @map("deleted_by")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  app            App?          @relation("RegisterOwnerApp", fields: [appId], references: [id], onDelete: Cascade)
  channel        Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  attendeeWorker Worker?       @relation("RegisterAttendeeWorker", fields: [attendeeWorkerId], references: [id], onDelete: Cascade)
  attendeeAgent  Agent?        @relation("RegisterAttendeeAgent", fields: [attendeeAgentId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([organizationId])
  @@index([appId])
  @@index([attendeeWorkerId])
  @@index([attendeeAgentId])
  @@map("register_entries")
}

/// How far one attendee has read in one Channel. What is unread is not stored anywhere: it is worked out from this
/// row's `lastSeenSeq` and the channel's `lastSeq`.
///
/// Relationships: the attendee is exactly one of a Worker (`workerId`) or an Agent in an App (`agentId` with
/// `appId`), enforced by `chk_read_state_attendee` and `chk_read_state_agent_app`. The row is deleted with the
/// Worker, the Agent, the App or the Channel.
///
/// Behaviour:
/// - The row is separate from RegisterEntry on purpose: what an attendee attends and how far it has read are
///   different facts. It is keyed on the attendee, not on the Agent alone, so two Workers cast from one Agent in one
///   App do not share a cursor.
/// - `advanceReadState` (src/lib/channelReadState.ts) creates the row or raises `lastSeenSeq`. It only ever moves
///   forward (`GREATEST`), so an older transaction cannot overwrite a newer cursor. Two runs at the same time may
///   both see the same messages as new: attention can be repeated, never skipped.
/// - `channelIncarnation` is the Channel incarnation the cursor was last raised under. Null means it is not known,
///   and it is never filled in afterwards.
/// - `lastCheckedAt` is when the worker last checked the channel through its own bound session, even when nothing was
///   new. Only `stampChannelCheck` writes it; a read by a person or by another worker does not.
/// - One row per worker and channel, and per agent, App and channel (partial unique indexes in prisma/post-push.sql).
///   Muting is session state and has no column here.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:dmo:090:06. Background: #2138, #2181. Background (history, not law): the
/// Spec Kit spec 049.
model ChannelReadState {
  id                 String    @id @default(cuid())
  workerId           String?   @map("worker_id")
  agentId            String?   @map("agent_id")
  appId              String?   @map("app_id")
  channelId          String    @map("channel_id")
  lastSeenSeq        Int       @default(0) @map("last_seen_seq")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  /// #2138 §3.1 — when the worker last CHECKED this channel through its own bound session (a page read, an
  /// inbox read or a mark-read, an empty one included). Stamped only by `stampChannelCheck`; a read by a
  /// person (asMe), by another worker or of another channel never moves it. NULL = never checked.
  lastCheckedAt      DateTime? @map("last_checked_at")
  /// #2181 — the Channel incarnation the stored cursor was last RAISED under. Written by `advanceReadState` in the
  /// same statement that creates the row or raises `lastSeenSeq` (an equal or lower mark changes neither). NULL =
  /// legacy or never advanced under a known incarnation; it is never backfilled and never relabelled, so a stale cursor
  /// is not presented as current.
  channelIncarnation Int?      @map("channel_incarnation")

  worker  Worker? @relation("ReadStateWorker", fields: [workerId], references: [id], onDelete: Cascade)
  agent   Agent?  @relation("ReadStateAgent", fields: [agentId], references: [id], onDelete: Cascade)
  app     App?    @relation("ReadStateApp", fields: [appId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([workerId])
  @@index([agentId, appId])
  @@map("channel_read_states")
}

// ─────────────────────────────────────────────────────────────────────────────
// #1325 (concept#74 L1.1, D-2026-09-24-002) — node kinds are PROCEDURE, held in
// a per-memory MemoryConfig; the object store (Memory.schema) keeps SHAPE.
// ─────────────────────────────────────────────────────────────────────────────

/// Who may write nodes of a role (D-2026-09-24-005). Enforced in the
/// authorization layer, never in a door (#1331 ALL/ADMIN, #1333 OWNER).
enum NodeRoleWriters {
  ALL
  OWNER
  ADMIN
}

/// Who runs a rule's validation task (D-2026-09-24-004): an agent in a
/// separate context, or the platform on a node-written trigger (#1332/#1335).
enum ContentValidator {
  AGENT
  PLATFORM
}

/// The rulebook of one memory: the holder of the rules that say, per node role, how nodes of that role are
/// written in this memory. A memory has exactly one rulebook. The rules themselves are the NodeRoleRule rows.
///
/// Relationships: belongs to one Memory (`memoryId` is unique) and is deleted with it. Its `rules` are
/// NodeRoleRule rows, deleted with the config. A rulebook is never shared between memories: the shared, owned
/// thing is a MemoryConfigTemplate, and a template's rules are copied in.
///
/// Behaviour:
/// - A memory with no row has the empty rulebook. No row is created with the memory and none is backfilled: the
///   first rule write creates the row in its own transaction, and until then a read returns an empty config
///   (src/api/graphql/schema/resolvers.memoryConfig.ts).
/// - Only the people who manage the memory may read or change it: the owner alone for a personal or private
///   memory, otherwise the shared memory-management gate. Anyone else gets the answer a missing memory gets.
/// - Enforcement does not go through that gate. A node write by any writer loads the rules directly
///   (src/lib/governedRole.ts, src/lib/nodeRoleWriters.ts, src/lib/authoringAttestation.ts).
/// - Cloning a memory copies its config and rules (src/controller/operations/cloneMemory.ts).
/// - `updatedAt` and `updatedBy` are stamped by every rule write.
///
/// Background: #1325.
model MemoryConfig {
  id        String    @id @default(cuid())
  memoryId  String    @unique @map("memory_id")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  memory Memory         @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  rules  NodeRoleRule[]

  @@map("memory_configs")
}

/// One rule of a memory's rulebook, for one node role. A rule matches the nodes of its memory whose `role` is
/// the rule's `role`, and says what a write of such a node must satisfy: which task the author must have
/// worked from, which task validates the content, and who may write the node at all.
///
/// Which nodes a rule matches: `role` is a role name or a dotted sub-role (`spec`, `spec.rule`). A node whose
/// role has no row of its own is governed by the nearest enabled ancestor (`spec.rule` falls back to `spec`),
/// unless that ancestor sets `strictSubRoles`: then a write that would produce an undeclared sub-role is
/// refused. The rule whose `role` is `task` governs every runnable node, whatever its role label. The rows are
/// also the list of roles the rulebook declares, so a row may exist with nothing set.
///
/// What a rule requires:
/// - `authorTask`: a write that authors a matching node must state the task it worked from and that task's
///   revision. A missing, wrong or stale claim is refused (src/lib/authoringAttestation.ts).
/// - `validationTask`: the task that content-validation reports on matching nodes name
///   (src/lib/contentValidationReport.ts). Reports are advisory and never block a write.
/// - `writers`: who may write matching nodes, on top of memory write access: `ALL` (no narrowing), `ADMIN`
///   (the owning organization's admins and owners, and the owning user) or `OWNER`. `OWNER` is not built:
///   every write that touches such a role is refused with ROLE_WRITERS_UNSUPPORTED
///   (src/lib/nodeRoleWriters.ts). The level is checked against the node's state before and after the write
///   (hrn:node:hadronmemory.com:specs:cor:acl:010:03).
/// - `descriptionNode` (a node that describes the role) and `validateBy` (who is meant to run the validation
///   task) are stored and returned by the config API. No other code reads them today.
///
/// Relationships: belongs to one MemoryConfig and is deleted with it; one rule per (`configId`, `role`).
/// `authorTask`, `validationTask` and `descriptionNode` point at Nodes by id, which may live in another memory.
/// The API accepts and shows them as URNs, and moving the node keeps the rule. `sourceTemplateId` is the
/// MemoryConfigTemplate the rule was copied from: a plain id with no foreign key, because a template is copied
/// in and never linked, so deleting a template must not rewrite the configs it was applied to.
///
/// Behaviour:
/// - A hard delete of a referenced task sets the reference to null. The `authorTaskRequired` or
///   `validationTaskRequired` marker stays set, so the rule fails closed instead of silently ceasing to require
///   the task. Cascade was rejected because it drops the rule; Restrict because it lets whoever references a
///   public task block its owner's deletes.
/// - `enabled` switches the rule off without deleting it. `locked` is set when a required template wrote the
///   rule; only an organization's admins may then change it.
/// - `revision` starts at 1 and rises by 1 on every update. A mutation that passes `expectedRevision` is refused
///   CONFLICT when it no longer matches.
/// - Written by the config API (resolvers.memoryConfig.ts), by applying a template
///   (resolvers.memoryConfigApply.ts), by an organization default at memory creation
///   (resolvers.memoryConfigOrgDefault.ts) and by a memory clone.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:acl:010:03. Background: #1322, #1325, #1328, #1331, #1333, #1334.
model NodeRoleRule {
  id                     String            @id @default(cuid())
  configId               String            @map("config_id")
  role                   String
  authorTaskId           String?           @map("author_task_id")
  authorTaskRequired     Boolean           @default(false) @map("author_task_required")
  validationTaskId       String?           @map("validation_task_id")
  validationTaskRequired Boolean           @default(false) @map("validation_task_required")
  descriptionNodeId      String?           @map("description_node_id")
  strictSubRoles         Boolean           @default(false) @map("strict_sub_roles")
  writers                NodeRoleWriters   @default(ALL)
  validateBy             ContentValidator? @map("validate_by")
  enabled                Boolean           @default(true)
  /// #1334 — the template this rule was copied from. Provenance only, no FK:
  /// a template is copied in, never live-linked, so deleting one must not
  /// rewrite the configs it was applied to.
  sourceTemplateId       String?           @map("source_template_id")
  /// #1334 — set by a REQUIRED template; only org admins may change the rule.
  locked                 Boolean           @default(false)
  /// Optimistic-concurrency counter (#1325, cli#716 Q1): starts at 1, +1 on
  /// every update; a mutation passing `expectedRevision` refuses CONFLICT when
  /// it no longer matches, so a stale read can never overwrite a newer write.
  revision               Int               @default(1)
  createdAt              DateTime          @default(now()) @map("created_at")
  createdBy              String?           @map("created_by")
  updatedAt              DateTime?         @updatedAt @map("updated_at")
  updatedBy              String?           @map("updated_by")

  config          MemoryConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  authorTask      Node?        @relation("NodeRoleRuleAuthorTask", fields: [authorTaskId], references: [id], onDelete: SetNull)
  validationTask  Node?        @relation("NodeRoleRuleValidationTask", fields: [validationTaskId], references: [id], onDelete: SetNull)
  descriptionNode Node?        @relation("NodeRoleRuleDescriptionNode", fields: [descriptionNodeId], references: [id], onDelete: SetNull)

  @@unique([configId, role])
  @@index([authorTaskId])
  @@index([validationTaskId])
  @@index([descriptionNodeId])
  @@map("node_role_rules")
}

/// A named, reusable rulebook that can be applied to many memories so they are configured alike. Applying a
/// template copies its rules into the memory's MemoryConfig; nothing links the memory to the template
/// afterwards.
///
/// Relationships: owned by exactly one of HadronServer, Organization, User (`ownerUser`) or App, through four
/// nullable foreign keys of which exactly one is set (CHECK `chk_memory_config_template_owner`). It is deleted
/// with its owner. Its rules are MemoryConfigTemplateRule rows. NodeRoleRule.`sourceTemplateId` and
/// MemoryConfigDefaultSkip name the template a rule or a skip came from.
///
/// Behaviour:
/// - Read and managed only by its owner's managers: a platform admin, the organization's admins, the user
///   alone, or the App's managers. Anyone else gets the answer a missing template gets
///   (src/api/graphql/schema/resolvers.memoryConfigTemplate.ts).
/// - Editing a template changes no memory until it is applied again. An update replaces the template's rules
///   as a whole in one transaction, and `revision` (the optimistic-concurrency counter) covers them.
/// - `required`: applying the template replaces a memory's existing rule for the same role and writes its rules
///   locked. A template that is not required leaves an existing rule in place (resolvers.memoryConfigApply.ts).
/// - `orgDefault`: an organization-owned template that is copied into every new `knowledge` or `group` memory
///   of the organization when `createMemory` creates it, and by nothing else. Only an organization-owned
///   template may set it (CHECK `chk_memory_config_template_org_default_org_only`). It is independent of
///   `required`.
/// - `name` is unique per owner among rows that are not deleted (partial unique indexes in
///   prisma/post-push.sql and the migration). `deleteMemoryConfigTemplate` is a soft delete (`deletedAt`).
///
/// Specs: hrn:node:hadronmemory.com:specs:cor:api:290. Background: #1325, #1334, #3426.
model MemoryConfigTemplate {
  id             String    @id @default(cuid())
  name           String
  description    String?
  required       Boolean   @default(false)
  /// #3426 — an org-owned template applied to every new org `knowledge`/`group` memory at its creation (`createMemory`
  /// only; never clone, extract or App sites). CHECK `chk_memory_config_template_org_default_org_only` (post-push.sql
  /// and the migration): org-owned only. Independent of `required`.
  orgDefault     Boolean   @default(false) @map("org_default")
  /// Optimistic-concurrency counter, as on NodeRoleRule. Rules are replaced
  /// wholesale with the template, so the template's revision covers them.
  revision       Int       @default(1)
  hadronServerId String?   @map("hadron_server_id")
  organizationId String?   @map("organization_id")
  ownerUserId    String?   @map("owner_user_id")
  appId          String?   @map("app_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  hadronServer HadronServer?              @relation(fields: [hadronServerId], references: [id], onDelete: Cascade)
  organization Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUser    User?                      @relation("MemoryConfigTemplateOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  app          App?                       @relation(fields: [appId], references: [id], onDelete: Cascade)
  rules        MemoryConfigTemplateRule[]
  defaultSkips MemoryConfigDefaultSkip[]

  @@index([organizationId, orgDefault])
  @@index([hadronServerId])
  @@index([organizationId])
  @@index([ownerUserId])
  @@index([appId])
  @@map("memory_config_templates")
}

/// One rule of a MemoryConfigTemplate, for one node role. It has the same meaning as a NodeRoleRule (which
/// nodes it matches, and the author task, validation task and writers level it requires of them), but it
/// governs nothing by itself: it takes effect only as the NodeRoleRule it is copied into when the template is
/// applied to a memory.
///
/// Relationships: belongs to one MemoryConfigTemplate and is deleted with it; one rule per (`templateId`,
/// `role`). `authorTask`, `validationTask` and `descriptionNode` point at Nodes by id. MemoryConfigDefaultSkip
/// rows point at the rule they skipped.
///
/// Behaviour: it has NodeRoleRule's columns without the ones that belong to a memory (`locked`,
/// `sourceTemplateId`, `revision` and the audit columns). A hard delete of a referenced task sets the
/// reference to null and leaves the `authorTaskRequired` or `validationTaskRequired` marker set, as on
/// NodeRoleRule. Applying a template whose rule has lost a required task this way is refused as a whole, and an
/// organization default plants such a rule so that it fails closed. Rules are written only together with their
/// template (src/api/graphql/schema/resolvers.memoryConfigTemplate.ts).
///
/// Background: #1325, #1334.
model MemoryConfigTemplateRule {
  id                     String            @id @default(cuid())
  templateId             String            @map("template_id")
  role                   String
  authorTaskId           String?           @map("author_task_id")
  authorTaskRequired     Boolean           @default(false) @map("author_task_required")
  validationTaskId       String?           @map("validation_task_id")
  validationTaskRequired Boolean           @default(false) @map("validation_task_required")
  descriptionNodeId      String?           @map("description_node_id")
  strictSubRoles         Boolean           @default(false) @map("strict_sub_roles")
  writers                NodeRoleWriters   @default(ALL)
  validateBy             ContentValidator? @map("validate_by")
  enabled                Boolean           @default(true)

  template        MemoryConfigTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  authorTask      Node?                @relation("TemplateRuleAuthorTask", fields: [authorTaskId], references: [id], onDelete: SetNull)
  validationTask  Node?                @relation("TemplateRuleValidationTask", fields: [validationTaskId], references: [id], onDelete: SetNull)
  descriptionNode Node?                @relation("TemplateRuleDescriptionNode", fields: [descriptionNodeId], references: [id], onDelete: SetNull)
  defaultSkips    MemoryConfigDefaultSkip[]

  @@unique([templateId, role])
  @@index([authorTaskId])
  @@index([validationTaskId])
  @@index([descriptionNodeId])
  @@map("memory_config_template_rules")
}

/// A record that one reference of an organization's default template rule was left out when a memory was
/// created. When a new memory receives its organization's default rules, a rule whose author task, validation
/// task or description node is deleted, is not readable by the organization, or is not a task, is not copied.
/// One row is written per such field, so the memory's managers can see what their memory did not get.
///
/// Relationships: belongs to the Memory that was created and is deleted with it. `template` and `templateRule`
/// point at the MemoryConfigTemplate and MemoryConfigTemplateRule that were skipped, and are set to null when
/// either is deleted.
///
/// Behaviour: written in the transaction that creates the memory, and only for a default that is not
/// `required` (a required default plants the rule so that it fails closed instead;
/// src/api/graphql/schema/resolvers.memoryConfigOrgDefault.ts). `field` is `authorTask`, `validationTask` or
/// `descriptionNode`. The row stores no task URN and no state: a read recomputes what the caller may see from
/// `templateRuleId`. It is readable only by those who may manage the memory's config. No application code
/// updates or deletes a row. `reason` says why the default was skipped; the one value written today is
/// `REFERENCE_UNAVAILABLE` (the referenced task is deleted, unreadable to the organization, or not a task).
///
/// Background: #3426.
model MemoryConfigDefaultSkip {
  id             String   @id @default(cuid())
  memoryId       String   @map("memory_id")
  templateId     String?  @map("template_id")
  templateRuleId String?  @map("template_rule_id")
  role           String
  /// "authorTask" | "validationTask" | "descriptionNode"
  field          String
  reason         String   @default("REFERENCE_UNAVAILABLE")
  createdAt      DateTime @default(now()) @map("created_at")

  memory       Memory                    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  template     MemoryConfigTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateRule MemoryConfigTemplateRule? @relation(fields: [templateRuleId], references: [id], onDelete: SetNull)

  @@index([memoryId])
  @@index([templateId])
  @@index([templateRuleId])
  @@map("memory_config_default_skips")
}

/// Whose authority an automation version runs with: a person's or the App's. See `AutomationVersion.tier`.
enum AutomationTier {
  PERSON
  APP
}

/// One entry in the history of consent to an automation: an approval, a decline or a revocation of the pin
/// that says which exact version of a trigger's automation may run. The table is the append-only audit trail
/// of who consented to what, and when.
///
/// Relationships: belongs to an App and is deleted with it. `triggerRef` (the id of the AgentSchedule or
/// AgentWebhook row, or the origin run's id for a manual trigger), `actorUserId` and `organizationId` are
/// plain values with no foreign key: the history must survive the deletion of a trigger and the erasure of a
/// user, and a foreign-key action would have to update a row that may not be updated.
///
/// Behaviour: written in the same transaction as the pin change, by `adoptionDoor` in
/// src/api/graphql/schema/resolvers.automationPin.ts and nowhere else. `action` is APPROVE, DECLINE or REVOKE
/// and `triggerKind` is SCHEDULE, WEBHOOK or MANUAL (CHECKs in prisma/automation-adoption-invariants.sql).
/// `pinHash` is the adopted hash on an approval, the hash of the removed pin on a revocation, and null on a
/// decline with nothing adopted. `organizationId` is the App's organization, null for a user-owned App. A
/// trigger refuses every update, and lets a delete through only once the App is gone.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:010:01. Background: #2441.
model AutomationAdoptionEvent {
  id             String   @id @default(cuid())
  appId          String   @map("app_id")
  /// The App's organization; null for a user-owned App.
  organizationId String?  @map("organization_id")
  /// SCHEDULE | WEBHOOK | MANUAL (CHECK in automation-adoption-invariants.sql).
  triggerKind    String   @map("trigger_kind")
  /// The trigger row id; for MANUAL, the origin run id. Plain text, no FK.
  triggerRef     String   @map("trigger_ref")
  /// APPROVE | DECLINE | REVOKE (CHECK).
  action         String
  actorUserId    String   @map("actor_user_id")
  /// APPROVE: the adopted hash. REVOKE: the hash of the removed pin. DECLINE
  /// with nothing adopted: null.
  pinHash        String?  @map("pin_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt])
  @@index([triggerKind, triggerRef, createdAt])
  @@map("automation_adoption_events")
}

/// Permission for an App's runs that act for no user to write nodes in one memory, under one loc prefix. A run
/// with no on-behalf-of user may write only where its App holds such a grant; this row is that grant.
///
/// Relationships: belongs to an App and to a Memory, and is deleted with either. `grantedBy` and `revokedBy`
/// are user ids with no foreign key: they are a sealed record of who acted and must survive the erasure of the
/// user. Every grant and revocation also writes an AppMemoryWriteGrantEvent.
///
/// Behaviour:
/// - At most one live grant per (App, memory, prefix): a partial unique index in
///   prisma/app-memory-write-grant-invariants.sql.
/// - `prefix` is required. It covers the loc itself and its descendants at a `:` boundary, so
///   `reports:progress` does not cover `reports:progressX`. It is judged on the destination loc, after `writeTo`
///   expansion, at the moment of each write (src/lib/appWriteGrant.ts).
/// - The grant allows node create and update only, and only for a userless run of that App. It never allows
///   delete, move, edge or settings writes, and never serves another App's run, a run for a user, an App key, a
///   worker session or a person.
/// - A row is never edited. It ends with a terminal `revokedAt` (trigger and CHECKs in the same SQL file).
/// - A person who manages the App and can write the memory sets a grant; whoever manages the App revokes it
///   (src/api/graphql/schema/resolvers.appWriteGrant.ts, the only writer).
/// - `registerNodeUrn` cites the register entry that records the grant. It is a citation, never evidence that
///   the entry exists.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:010:01. Background: #2484, #2435.
model AppMemoryWriteGrant {
  id              String    @id @default(cuid())
  appId           String    @map("app_id")
  memoryId        String    @map("memory_id")
  prefix          String
  registerNodeUrn String?   @map("register_node_urn")
  grantedBy       String    @map("granted_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  revokedBy       String?   @map("revoked_by")

  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt])
  @@index([memoryId])
  @@map("app_memory_write_grants")
}

/// One entry in the history of App memory write grants: that a grant was given or revoked, by whom, for which
/// App, memory and prefix. The table is the append-only audit trail of AppMemoryWriteGrant. It holds nothing
/// of any node's content.
///
/// Relationships: belongs to an App and is deleted with it. `memoryId`, `grantId` and `actorUserId` are plain
/// ids with no foreign key, so the history survives the deletion of the memory, the grant and the user.
///
/// Behaviour: written in the same transaction as the grant row's change, by the grant doors in
/// src/api/graphql/schema/resolvers.appWriteGrant.ts and nowhere else. `action` is GRANT or REVOKE (CHECK in
/// prisma/app-memory-write-grant-invariants.sql). A trigger refuses every update, and lets a delete through
/// only once the App is gone.
///
/// Background: #2484.
model AppMemoryWriteGrantEvent {
  id          String   @id @default(cuid())
  appId       String   @map("app_id")
  memoryId    String   @map("memory_id")
  grantId     String   @map("grant_id")
  prefix      String
  /// GRANT | REVOKE (CHECK in app-memory-write-grant-invariants.sql).
  action      String
  actorUserId String   @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt])
  @@index([grantId])
  @@map("app_memory_write_grant_events")
}

/// Permission for one automation to read one memory, or the part of it under one loc prefix, that its runs
/// could not otherwise read. The automation is the trigger a run executes for: an AgentSchedule or an
/// AgentWebhook row.
///
/// Relationships: belongs to an App and to a Memory, and is deleted with either. The trigger is named by
/// (`appId`, `triggerKind`, `triggerId`) with no foreign key, because it is one of two models; whether the
/// trigger is still live is judged at each read. `grantedBy` and `revokedBy` are user ids with no foreign key:
/// a sealed record that survives the erasure of the user. Every grant and revocation also writes an
/// AppAutomationReadGrantEvent.
///
/// Behaviour:
/// - `prefix` null means the whole memory; otherwise the loc itself and its descendants at a `:` boundary.
/// - The grant is keyed on the trigger row, so it carries over an edit and a re-adoption of the automation. It
///   ends when it is revoked or when the trigger is soft-deleted. Runs that descend from a trigger's run use
///   their root trigger's grants; a manual run has no trigger and so no grant.
/// - It only ever adds read access, and is consulted only by a run's `hadron_read_node` read, after the shared
///   read gate has refused (`runHoldsReadGrant`, src/lib/automationReadGrant.ts).
/// - A row is never edited. It ends with a terminal `revokedAt` (trigger and CHECKs in
///   prisma/app-automation-read-grant-invariants.sql, which also holds the partial unique index).
/// - Whoever manages the target memory (for an Agent's system memory, the Agent) gives a grant, as a person.
///   The App's managers or the target's manager revoke it
///   (src/api/graphql/schema/resolvers.automationReadGrant.ts, the only writer).
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:010:01. Background: #2883.
model AppAutomationReadGrant {
  id          String    @id @default(cuid())
  appId       String    @map("app_id")
  /// SCHEDULE | WEBHOOK (CHECK in app-automation-read-grant-invariants.sql).
  triggerKind String    @map("trigger_kind")
  triggerId   String    @map("trigger_id")
  memoryId    String    @map("memory_id")
  /// NULL = the whole memory; otherwise a loc prefix covering itself and its `:`-boundary descendants.
  prefix      String?
  grantedBy   String    @map("granted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedBy   String?   @map("revoked_by")

  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt])
  @@index([memoryId])
  @@index([appId, triggerKind, triggerId])
  @@map("app_automation_read_grants")
}

/// One entry in the history of automation read grants: that a grant was given or revoked, by whom, for which
/// App, trigger, memory and prefix. The table is the append-only audit trail of AppAutomationReadGrant. It
/// holds nothing of any node's content.
///
/// Relationships: belongs to an App and is deleted with it. `memoryId`, `grantId`, `triggerId` and
/// `actorUserId` are plain ids with no foreign key, so the history survives their deletion.
///
/// Behaviour: written in the same transaction as the grant row's change, by the grant doors in
/// src/api/graphql/schema/resolvers.automationReadGrant.ts and nowhere else. `action` is GRANT or REVOKE (CHECK
/// in prisma/app-automation-read-grant-invariants.sql).
///
/// Background: #2883.
model AppAutomationReadGrantEvent {
  id          String   @id @default(cuid())
  appId       String   @map("app_id")
  triggerKind String   @map("trigger_kind")
  triggerId   String   @map("trigger_id")
  memoryId    String   @map("memory_id")
  grantId     String   @map("grant_id")
  prefix      String?
  /// GRANT | REVOKE (CHECK in app-automation-read-grant-invariants.sql).
  action      String
  actorUserId String   @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt])
  @@index([grantId])
  @@map("app_automation_read_grant_events")
}

/// A file that a memory's Git mirror still owes its repository, because the last attempt to publish it failed.
/// When a memory is mirrored to Git, every node write is also pushed to the repository; that push can fail
/// after the database write has committed. This row records the failure, so the difference between the memory
/// and its repository is visible and can be retried.
///
/// Relationships: belongs to a Memory and is deleted with it. `nodeId` is a node id with no foreign key, on
/// purpose: a REMOVE row must survive the hard delete of its node.
///
/// Behaviour:
/// - One row per (memory, node, `kind`, `removeLoc`, `branch`), which is the primary key. A WRITE row is the
///   node's current file. A REMOVE row is an old path that a move left behind, named by `removeLoc`
///   (`removeLoc` is empty for WRITE). `branch` is the branch the attempt resolved to, empty only for older
///   rows written before the branch was recorded.
/// - A row exists only while the last settled attempt failed. A success deletes it, and so does an ordinary
///   write to a memory that is not mirrored (src/integrations/github/mirrorObligations.ts, the only writer).
/// - `attemptSeq` comes from the sequence `git_mirror_attempt_seq`, taken inside the per-memory checkout lock
///   and settled before the lock is released. A settle only applies over a lower `attemptSeq`, so a late
///   settle never overwrites a newer one.
/// - `state`: FAILED can be retried, NOT_CLONED means there is no local clone, EXHAUSTED means the retry sweep
///   reached its attempt cap (an ordinary write can still settle the row).
/// - `errorClass` is one of a fixed set of words (CHECK in prisma/git-mirror-obligation-invariants.sql). No
///   exception text, URL or token is ever stored.
/// - The sweep in src/jobs/sweepGitMirrorObligations.ts retries recorded failures with a growing delay and a
///   cap on attempts. It leaves encrypted and unconfigured memories untouched. Memory validation reports the
///   rows as findings (src/lib/memoryValidation.ts).
///
/// Background: #430, #3042.
model GitMirrorObligation {
  memoryId      String                   @map("memory_id")
  nodeId        String                   @map("node_id")
  kind          GitMirrorObligationKind
  removeLoc     String                   @default("") @map("remove_loc")
  /// #3042: resolved attempted branch; empty only for legacy unknown-branch debt.
  branch        String                   @default("")
  state         GitMirrorObligationState
  errorClass    String                   @map("error_class")
  attempts      Int                      @default(1)
  attemptSeq    BigInt                   @map("attempt_seq")
  lastAttemptAt DateTime                 @default(now()) @map("last_attempt_at")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@id([memoryId, nodeId, kind, removeLoc, branch])
  @@index([memoryId, state])
  @@map("git_mirror_obligations")
}

/// What a pending Git-mirror obligation owes the repository: WRITE a node's file or REMOVE it. See
/// GitMirrorObligation.
enum GitMirrorObligationKind {
  WRITE
  REMOVE

  @@map("git_mirror_obligation_kind")
}

/// FAILED = retryable failure; NOT_CLONED = no local clone; EXHAUSTED = sweep cap reached (ordinary writes still
/// settle).
enum GitMirrorObligationState {
  FAILED
  NOT_CLONED
  EXHAUSTED

  @@map("git_mirror_obligation_state")
}

/// One published version of an automation of an App: the compiled automation as canonical JSON, stored
/// unchangeably together with its hash, and the record of who approved or revoked it.
///
/// Relationships: belongs to an App and is deleted with it. `entrySourceNodeId` (the node the automation
/// starts from), `runAsUserId`, `publishedBy`, `approvedBy` and `revokedBy` are plain ids with no foreign key,
/// so the record keeps who acted after a node or a user is gone.
///
/// Behaviour:
/// - `number` counts versions per (App, entry node), starting at 1. `versionHash` is a SHA-256 hash of the
///   canonical JSON, and `sourceManifest` lists the source of each node of the compiled automation.
/// - `tier` says whose authority the automation runs with: PERSON has a `runAsUserId`, APP has none (CHECK
///   `chk_automation_shape`, prisma/automation-invariants.sql).
/// - The compiled code and its metadata never change (a trigger refuses it). Approval (`approvalHash`,
///   `approvedBy`, `approvedAt`, with the hash equal to `versionHash`) and revocation (`revokedBy`,
///   `revokedAt`) are each written once, and a revoked version cannot be approved. A new approval needs a new
///   version. Approval by a named person is a temporary bridge until passkey signatures take its place.
/// - A PERSON version is approved only by its run-as user; an APP version by the App's owner or an admin of
///   its organization.
/// - The only code that touches the table is src/lib/automation/versions.ts (`publishAutomationVersion`,
///   `approveAutomationVersion`, `revokeAutomationVersion`). No API operation calls those functions today and
///   no run reads the table: what a run may execute is settled by the adoption pin on its trigger (see
///   AutomationAdoptionEvent).
///
/// Background: #1655.
model AutomationVersion {
  id                String         @id @default(cuid())
  appId             String         @map("app_id")
  app               App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  number            Int
  entrySourceNodeId String         @map("entry_source_node_id")
  compiledJson      String         @map("compiled_json")
  versionHash       String         @map("version_hash")
  sourceManifest    Json           @map("source_manifest")
  tier              AutomationTier
  runAsUserId       String?        @map("run_as_user_id")
  publishedBy       String         @map("published_by")
  publishedAt       DateTime       @default(now()) @map("published_at")
  approvalHash      String?        @map("approval_hash")
  approvedBy        String?        @map("approved_by")
  approvedAt        DateTime?      @map("approved_at")
  revokedBy         String?        @map("revoked_by")
  revokedAt         DateTime?      @map("revoked_at")

  @@unique([appId, entrySourceNodeId, number])
  @@index([appId])
  @@map("automation_versions")
}

/// One piece of work in a team App: something an owner wants done and, once assigned, the worker or person who
/// is doing it. The platform records who owns it, who holds it, since when, and how it ended. It never reads
/// what the work is: `title` and `description` are the team's own words.
///
/// Relationships:
/// - Belongs to an App and is deleted with it.
/// - `parent` is the task this one is a child of, always in the same App; `children` are its child tasks.
///   Parentage is fixed at creation.
/// - `clonedFrom` is the task this one was cloned from, set to null if that task is deleted.
/// - The owner is a Worker or a User (`ownerWorker`, `ownerUser`), and so is the assignee (`assigneeWorker`,
///   `assigneeUser`). These four references are NO ACTION, not RESTRICT: a hard delete of the App removes its
///   workers and its tasks in one statement, and NO ACTION checks at the end of that statement, after both are
///   gone. A worker with tasks is otherwise in use (`deleteWorker` refuses WORKER_IN_USE).
/// - AgentTaskBlocker rows link it to the tasks that block it and the tasks it blocks. AgentTaskCounter rows
///   count the numbers issued under it. AgentTaskStopHold rows record when a stop signal kept it from being
///   assigned.
/// - `createdByRunId` is a plain id with no foreign key: a run is pruned long before its tasks are.
/// - AgentTeamEvent rows name the task by id with no foreign key, so the history outlives the task.
///
/// Behaviour:
/// - Shape (CHECK `chk_agent_tasks_shape`, prisma/agent-task-invariants.sql): exactly one owner and at most
///   one assignee, each a Worker or a User; the status vocabulary; a timestamp per status; a result only on a
///   finished task.
/// - `status` is `backlog`, `pending`, `started`, `finished` or `cancelled`. Whether a task is queued (pending
///   with no assignee, hrn:node:hadronmemory.com:specs:cor:agt:050:03) or waiting on its child tasks
///   (hrn:node:hadronmemory.com:specs:cor:agt:050:04) is worked out at read time and never stored.
/// - `taskNumber` and `handle` (for example `AT3.405.16`) are given once at creation and never change. Each App
///   has one reserved row, `AT0` ("No project"), which no operation changes; a task created with no parent and
///   not as a project becomes its child (hrn:node:hadronmemory.com:specs:cor:agt:050:01).
/// - The foreign key to the parent is NO ACTION: the database refuses to delete a task row that still has
///   child rows.
/// - `requirements` say which workers the matcher may choose for a task with no assignee.
/// - The result (`resultOutcome`, `resultSummary`, `resultEvidence`, `resultFindings`, `resultWorkedFromRoleTaskRefs`) is set only when the
///   task is finished.
/// - Tasks are created through `createAgentTask`, `createAgentTasks` and `cloneAgentTask`
///   (src/api/graphql/schema/resolvers.agentTask.ts) and assigned by hand or by the matcher
///   (src/lib/agentTasks/matcher.ts). The stall evaluator (src/jobs/taskStallEvaluator.ts) reads open tasks to
///   raise alarms. What happens to a task is recorded as AgentTeamEvent rows.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:050:01. Lifecycle:
/// hrn:node:hadronmemory.com:specs:cor:agt:050:02. Background: #1705.
model AgentTask {
  id                   String    @id @default(cuid())
  appId                String    @map("app_id")
  /// #2553: this task's own segment of its handle: the project number (counted per App) for a top-level row, else the
  /// number counted within its parent. Assigned once at creation from `agent_task_counters`, never changed or reissued.
  /// 0 is the reserved project `AT0` ("no project"). NOT NULL in the database (prisma/agent-task-number-invariants.sql,
  /// which also fills it for any writer that leaves it out); optional here only so a writer need not state it.
  taskNumber           BigInt?   @map("task_number")
  /// #2553: the full dotted handle (`AT3.405.16`), composed once at creation from the parent's handle and never
  /// recomputed: parentage is fixed at creation (a trigger refuses UPDATE of parent_task_id), so it always matches the tree.
  handle               String?
  /// What is asked, in the team's own words. Never read by the platform.
  title                String
  description          String?
  /// Opaque origin reference (an issue URL, a node URN). Not interpreted.
  source               String?
  /// #3125 S2 (V29, V46; hrn:node:hadronmemory.com:specs:cor:agt:120:02), amended by #4217: the claim on an outside item, set once at create. Held by at
  /// most ONE ACTIVE task (backlog, pending, started) within an App; a finished or cancelled task keeps its id without
  /// blocking a new claim. Through the partial unique index agent_tasks_app_external_id_uniq (raw SQL in
  /// agent-task-external-id-invariants.sql: Prisma cannot model a partial unique). Compared exactly as written.
  externalId           String?   @map("external_id")
  /// Null for a root task. Always in the same App (hrn:node:hadronmemory.com:specs:cor:agt:050:01).
  parentTaskId         String?   @map("parent_task_id")
  /// #2646 (hrn:node:hadronmemory.com:specs:cor:agt:050:02, What a clone does): the task this one was cloned from, set once at creation and never
  /// changed. Always in the same App (the clone is made in the source's App). Null for every task not made by a clone.
  clonedFromId         String?   @map("cloned_from_id")
  ownerWorkerId        String?   @map("owner_worker_id")
  ownerUserId          String?   @map("owner_user_id")
  /// Both null ⇒ queued while pending (hrn:node:hadronmemory.com:specs:cor:agt:050:03).
  assigneeWorkerId     String?   @map("assignee_worker_id")
  assigneeUserId       String?   @map("assignee_user_id")
  /// For the matcher (T3): `{ role?, familyIn?, familyNotIn?, excludeWorkerIds? }`.
  requirements         Json?
  /// #2829: reserve an opt-in match before create commits, so automatic runs cannot race it.
  matchPending         Boolean   @default(false) @map("match_pending")
  /// #3246 (hrn:node:hadronmemory.com:specs:cor:agt:060:10, ruling 0085 A): the sweep's claim on an interrupted reservation: one guarded write, so
  /// concurrent sweeps make the one attempt once. A claim older than the bound is reclaimable (its attempt died too).
  matchClaimedAt       DateTime? @map("match_claimed_at")
  /// A single-shot failure remains until assignment; cancellation clears it (hrn:node:hadronmemory.com:specs:cor:agt:050:01, ruling 0015).
  matchFailedAt        DateTime? @map("match_failed_at")
  matchFailedReason    String?   @map("match_failed_reason")
  /// #2420 (hrn:node:hadronmemory.com:specs:cor:agt:050:28): this task's OWN optional, platform-opaque JSON object (the team's namespaces: review
  /// schedule, complexity, a seat's reviewed head). Never inherited, never matcher or authorization input; written by
  /// the hrn:node:hadronmemory.com:specs:cor:agt:050:09 set and the task's assignee, validated against the Team Agent's `schema:task-properties`.
  properties           Json?
  /// 'backlog' | 'pending' | 'started' | 'finished' | 'cancelled' (hrn:node:hadronmemory.com:specs:cor:agt:050:02).
  /// 'backlog' (#1754): parked — no assignee, not matched, never waited on, no alarms.
  status               String    @default("pending")
  /// #2644: 1 is highest; existing tasks retain FIFO within default priority1.
  priority             Int       @default(1) @db.SmallInt
  /// Maintained transactionally with the blocker graph, never caller supplied.
  blocked              Boolean   @default(false)
  releasedAt           DateTime? @map("released_at")
  startBy              DateTime? @map("start_by")
  /// #2648 (hrn:node:hadronmemory.com:specs:cor:agt:050:14): the finish-by deadline. Set, it exempts the task from every stall window; one alarm
  /// when it passes with the task neither finished nor cancelled.
  finishBy             DateTime? @map("finish_by")
  startedAt            DateTime? @map("started_at")
  finishedAt           DateTime? @map("finished_at")
  cancelledAt          DateTime? @map("cancelled_at")
  /// The result (hrn:node:hadronmemory.com:specs:cor:agt:050:01) — set only on finish.
  resultOutcome        String?   @map("result_outcome")
  resultSummary        String?   @map("result_summary")
  resultEvidence       String?   @map("result_evidence")
  /// #2662: immutable ordered findings, set only with the finish result; null is legacy/omitted.
  resultFindings       Json?     @map("result_findings")
  /// #4414 (hrn:node:hadronmemory.com:specs:cor:agt:050:30): the role tasks the assignee followed, [{nodeId, urn, revision}] in the order given, set only with the
  /// finish result and immutable after it; null is legacy/omitted.
  resultWorkedFromRoleTaskRefs Json? @map("result_worked_from_role_task_refs")
  /// #2663: latest disposition for each finding, stored beside the immutable result (at most100).
  findingDispositions  Json      @default("[]") @map("finding_dispositions")
  /// Derived by the database trigger from resultFindings + findingDispositions; filter before SQL paging.
  unresolvedFindingIds String[]  @default([]) @map("unresolved_finding_ids")
  /// #2651 (hrn:node:hadronmemory.com:specs:cor:agt:050:29, hrn:node:hadronmemory.com:specs:cor:agt:050:01): the latest hand-back — its code (closed set, chk_agent_tasks_hand_back), optional
  /// text (<= 2,000 characters; never put into an event) and time. A later hand-back replaces all three.
  handBackReasonCode   String?   @map("hand_back_reason_code")
  handBackReasonText   String?   @map("hand_back_reason_text")
  handedBackAt         DateTime? @map("handed_back_at")
  tags                 String[]  @default([])
  /// #2649 (hrn:node:hadronmemory.com:specs:cor:agt:050:01 References, :09): the task's ordered typed references, a JSON array of
  /// {kind, target, label} (at most 20, chk_agent_tasks_references). Targets are stored as given and never resolved.
  /// Column named task_references: REFERENCES is reserved in SQL.
  references           Json      @default("[]") @map("task_references")
  /// Set by whoever assigns; T6 acts on it (hrn:node:hadronmemory.com:specs:cor:agt:050:10). False unless the assigner asks (R182, #2249): the
  /// default only reaches a raw insert, since every create path writes the resolved value.
  closeSessionWhenDone Boolean   @default(false) @map("close_session_when_done")
  /// #4291 (decision 5, settled B) — the task's own run settings, each optional: a family, an exact model OR a generic
  /// tier (high, mid, low), and an effort (never NOT_APPLICABLE). What a start for this task launches, before the
  /// worker's record; not a matching requirement. Validated at creation (src/lib/agentTasks/runSettings.ts).
  runFamily            String?      @map("run_family")
  runModel             String?      @map("run_model")
  runTier              String?      @map("run_tier")
  runEffort            EffortLevel? @map("run_effort")
  /// #4291 — the settings the run actually used: the assignee's newest open session's, read when the task was started.
  /// Null until started, for a person, or when that session reported none. Shown beside the task's own settings.
  appliedFamily        String?      @map("applied_family")
  appliedModel         String?      @map("applied_model")
  appliedEffort        EffortLevel? @map("applied_effort")
  /// The latest assignment, by hand or by the matcher, in the #1610 actor shape.
  assignedAt           DateTime? @map("assigned_at")
  assignedBy           String?   @map("assigned_by")
  assignedByWorkerId   String?   @map("assigned_by_worker_id")
  assignedByAgentId    String?   @map("assigned_by_agent_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  createdBy            String?   @map("created_by")
  createdByWorkerId    String?   @map("created_by_worker_id")
  createdByAgentId     String?   @map("created_by_agent_id")
  /// #1756 (hrn:node:hadronmemory.com:specs:cor:agt:050:06): the headless run that created the task, when one did.
  /// Then createdBy / createdByWorkerId / createdByAgentId are all null. A plain
  /// id, not a foreign key: a run is pruned long before its tasks are.
  createdByRunId       String?   @map("created_by_run_id")
  updatedAt            DateTime? @updatedAt @map("updated_at")
  updatedBy            String?   @map("updated_by")
  updatedByWorkerId    String?   @map("updated_by_worker_id")
  updatedByAgentId     String?   @map("updated_by_agent_id")

  app            App                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  parent         AgentTask?          @relation("AgentTaskParent", fields: [parentTaskId], references: [id], onDelete: NoAction)
  children       AgentTask[]         @relation("AgentTaskParent")
  clonedFrom     AgentTask?          @relation("AgentTaskClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones         AgentTask[]         @relation("AgentTaskClone")
  /// #2553: the counter of the numbers issued under this task.
  childCounters  AgentTaskCounter[]
  blockerLinks AgentTaskBlocker[] @relation("TaskBlockedBy")
  dependentLinks AgentTaskBlocker[] @relation("TaskBlocks")
  ownerWorker    Worker?             @relation("AgentTaskOwnerWorker", fields: [ownerWorkerId], references: [id], onDelete: NoAction)
  ownerUser      User?               @relation("AgentTaskOwnerUser", fields: [ownerUserId], references: [id], onDelete: NoAction)
  assigneeWorker Worker?             @relation("AgentTaskAssigneeWorker", fields: [assigneeWorkerId], references: [id], onDelete: NoAction)
  assigneeUser   User?               @relation("AgentTaskAssigneeUser", fields: [assigneeUserId], references: [id], onDelete: NoAction)
  /// #2022 — times stop signals kept this task from being assigned.
  stopHolds      AgentTaskStopHold[]

  @@index([appId, status, priority, createdAt, id])
  @@unique([appId, handle])
  @@index([appId, status])
  @@index([parentTaskId])
  @@index([clonedFromId])
  @@index([ownerWorkerId])
  @@index([ownerUserId])
  @@index([assigneeWorkerId])
  @@index([assigneeUserId])
  @@map("agent_tasks")
}

/// A dependency between two tasks of the same App: `task` may not proceed until `blocker` has ended. One row
/// is one edge of the App's blocker graph.
///
/// Relationships: joins two AgentTask rows, one row per pair (the primary key), and is deleted with either
/// task.
///
/// Behaviour: a trigger in prisma/task-blocker-invariants.sql keeps the graph valid. Both tasks must belong to
/// the same App, a task cannot block itself, a link that would close a cycle is refused, a link is never
/// updated, and links change only while the blocked task is `backlog` or `pending`. The same SQL file keeps
/// AgentTask.`blocked` and `releasedAt` in step with the links, so a blocker that is finished, cancelled or
/// removed releases the tasks it blocked. Links are written by src/lib/agentTasks/blockers.ts.
///
/// Entity spec (of the task): hrn:node:hadronmemory.com:specs:cor:agt:050:01. Background: #2644.
model AgentTaskBlocker {
  taskId String @map("task_id")
  blockerTaskId String @map("blocker_task_id")
  createdAt DateTime @default(now()) @map("created_at")
  task AgentTask @relation("TaskBlockedBy", fields: [taskId], references: [id], onDelete: Cascade)
  blocker AgentTask @relation("TaskBlocks", fields: [blockerTaskId], references: [id], onDelete: Cascade)
  @@id([taskId, blockerTaskId])
  @@index([blockerTaskId])
  @@map("agent_task_blockers")
}

/// The last number issued for the children of one parent task, or, with no parent, for the top-level tasks
/// (the projects) of an App. A task's handle such as `AT3.405.16` is built from these numbers: each new task
/// takes the next number under its parent. The reserved `AT0` row of an App is number 0, which no counter
/// issues.
///
/// Relationships: belongs to an App and is deleted with it. `parentTask` is the AgentTask whose children it
/// counts, and the row is deleted with that task. `parentTaskId` null is the App's own counter for top-level
/// tasks.
///
/// Behaviour: the task create increments the row, or inserts it at 1, in the creating transaction
/// (`INSERT ... ON CONFLICT DO UPDATE`, src/api/graphql/schema/resolvers.agentTask.ts). The counter is a table
/// of its own so that a create waits only for other creates under the same parent and never takes the App row
/// exclusively. A number is never reissued. There is one row per (App, parent); the one row per App with no
/// parent is enforced by a partial unique index in prisma/agent-task-number-invariants.sql, because NULLs are
/// distinct in the ordinary unique index.
///
/// Background: #2553.
model AgentTaskCounter {
  id           String  @id @default(cuid())
  appId        String  @map("app_id")
  parentTaskId String? @map("parent_task_id")
  lastNumber   BigInt  @map("last_number")

  app        App        @relation(fields: [appId], references: [id], onDelete: Cascade)
  parentTask AgentTask? @relation(fields: [parentTaskId], references: [id], onDelete: Cascade)

  @@unique([appId, parentTaskId])

  @@map("agent_task_counters")
}

/// One append-only record of something that happened in a team App's task work: a task created, assigned,
/// started, finished or cancelled, a worker's availability changed, a host operation's outcome, and so on. An
/// alarm is also an event, with `severity` set to `alarm`. The table is the team's history and the source the
/// roster, the wake computation and the alarm evaluators read.
///
/// Relationships:
/// - Belongs to an App and is deleted with it.
/// - `taskId`, the actor ids (`actorUserId`, `actorWorkerId`, `actorAgentId`, `actorRunId`, `actorAppKeyId`)
///   and the subject ids (`subjectWorkerId`, `subjectUserId`) are plain ids with no foreign key. They are a
///   sealed record of who acted and what it concerned, and a foreign-key action would have to update the row.
/// - An alarm has AgentTeamAlarmSchedule rows (who it wakes, and when) and at most one AlarmEscalationEnd.
/// - An alarm that is about no task has one episode row that points at it: DarkWorkerEpisode,
///   CoordinatorCadenceEpisode, PostLimitEpisode, StartFailingEpisode or HostSweepEpisode.
/// - WorkerDeliveryTaskEvent rows record the delivery of an event to a worker.
///
/// Behaviour:
/// - Never changed or removed. A trigger in prisma/agent-task-invariants.sql refuses every update except the
///   one-time acknowledgement of an alarm (`acknowledgedAt` and who), refuses an insert that arrives
///   acknowledged, and refuses a delete unless the App itself is gone.
/// - `payload` carries counts, outcomes, reasons and ids only, never message or description text.
/// - An alarm stores its `chain`, the owners it concerns as they stood when it was raised, nearest first.
/// - A stall alarm on a task carries `episodeStart`. The unique index on (`taskId`, `type`, `episodeStart`) is
///   what makes it one alarm per episode across concurrent evaluator passes. The index cannot do that for an
///   alarm with no task, which is why those have episode tables.
/// - `txId` is the id of the writing transaction, set by the database, so a reader can page in commit order.
/// - Most events are written by src/lib/agentTasks/events.ts. The modules that raise an alarm about no task
///   insert their own alarm rows (darkWorker.ts, coordinatorCadence.ts, postLimit.ts and sweepRuns.ts in
///   src/lib/agentTasks, and src/lib/desiredState/desiredStart.ts), and src/lib/stopSignals/notices.ts,
///   src/lib/hostOperations/sessionEnd.ts and src/lib/contextReset/contextReset.ts write events of their own.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:050:11. Background: #1705, #1706.
model AgentTeamEvent {
  id                     String    @id @default(cuid())
  appId                  String    @map("app_id")
  /// e.g. `task.created`, `task.assigned` (hrn:node:hadronmemory.com:specs:cor:agt:050:11).
  type                   String
  taskId                 String?   @map("task_id")
  /// Who acted, in the #1610 shape: the human credential, plus the Worker /
  /// Agent bound to the request's session.
  actorUserId            String?   @map("actor_user_id")
  actorWorkerId          String?   @map("actor_worker_id")
  actorAgentId           String?   @map("actor_agent_id")
  /// #1756: the headless run that acted, when one did; the other actor columns are then null.
  actorRunId             String?   @map("actor_run_id")
  /// #3132 (hrn:node:hadronmemory.com:specs:cor:agt:050:11, hrn:node:hadronmemory.com:specs:cor:agt:050:23): the App key that acted, when one did (its one task write is a claim); the other
  /// actor columns are then null. No FK: like the other actor ids, a sealed record of who acted at the time.
  actorAppKeyId          String?   @map("actor_app_key_id")
  /// The worker the event concerns, if any (e.g. the new assignee).
  subjectWorkerId        String?   @map("subject_worker_id")
  /// #3132 (rulings:0009): the PERSON the event concerns, when a key or run acted for one it cannot itself resolve
  /// (the assignee its claim named). Never the actor. No FK, sealed like the actor ids (not rewritten by a merge).
  subjectUserId          String?   @map("subject_user_id")
  /// null for an ordinary event, 'alarm' for an alarm.
  severity               String?
  /// Alarms only: the owner chain when raised, nearest first.
  chain                  Json?
  acknowledgedByUserId   String?   @map("acknowledged_by_user_id")
  acknowledgedByWorkerId String?   @map("acknowledged_by_worker_id")
  acknowledgedAt         DateTime? @map("acknowledged_at")
  payload                Json      @default("{}")
  createdAt              DateTime  @default(now()) @map("created_at")
  /// #4084 (Glen's blind P2 on server#4089): the id of the transaction that wrote the event, set by the database
  /// (`pg_current_xact_id()`), never by the application. `createdAt` is stamped when the row is written, not when it
  /// commits, so a reader that advances by `(createdAt, id)` can pass an event whose transaction commits later. A
  /// transaction id below the reader snapshot's xmin is final: every transaction that could still add a row has an id
  /// at or above it. agentTaskExternalIdChanges pages by `(txId, createdAt, id)` and serves only finished transactions,
  /// so a late commit is served late, never skipped. Rows written before this column existed hold `'0'`.
  /// #4111: NOT NULL (a NULL cursor key would compare NULL and empty every later page); the default stays, so a
  /// producer that omits it still gets a key. A logical restore re-keys it with `scripts/ops/restore-with-rebase`.
  txId                   Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()")) @map("tx_id")
  /// #1706 — stall alarms only: when the stall episode began (hrn:node:hadronmemory.com:specs:cor:agt:050:13),
  /// the instant of the move that began the condition, never the evaluator's
  /// clock. With `taskId` and `type` (the rule) it is the episode's key, and
  /// the unique index below is what makes "exactly one alarm per episode"
  /// hold across concurrent evaluator passes: a second insert of the same
  /// episode is ON CONFLICT DO NOTHING, not a read-then-write. NULL on every
  /// other event, and NULLs are distinct, so ordinary events never collide.
  episodeStart           DateTime? @map("episode_start")

  app        App                       @relation(fields: [appId], references: [id], onDelete: Cascade)
  wakes      AgentTeamAlarmSchedule[]
  deliveries WorkerDeliveryTaskEvent[]
  darkEpisode DarkWorkerEpisode?
  cadenceEpisode CoordinatorCadenceEpisode?
  postLimitEpisode PostLimitEpisode?
  startFailingEpisode StartFailingEpisode?
  hostSweepEpisode HostSweepEpisode?
  /// #3934 (V77): the recorded end of this alarm's escalation, written once by the evaluator pass or the acknowledgement.
  escalationEnd AlarmEscalationEnd?

  @@unique([taskId, type, episodeStart], map: "agent_team_events_episode_uniq")
  @@index([appId, createdAt])
  /// #4084: the changed-since read's commit-safe order (agentTaskExternalIdChanges).
  @@index([appId, txId, createdAt, id])
  @@index([taskId])
  /// #1707 — "assigned least recently" (hrn:node:hadronmemory.com:specs:cor:agt:060:06) reads a worker's
  /// latest assignment event.
  @@index([subjectWorkerId, createdAt])
  @@map("agent_team_events")
}

/// When each owner in an alarm's chain is to be woken about it. An alarm lists the owners it concerns, nearest
/// first; this table has one row per owner, with the time that owner falls due and whether they were woken.
/// It is how an unacknowledged alarm climbs from the nearest owner to the next.
///
/// Relationships: belongs to an AgentTeamEvent that is an alarm, and is deleted with it. `chainIndex` is the
/// owner's position in the alarm's `chain`; the pair is the primary key. It is a table of its own because the
/// alarm event cannot be updated.
///
/// Behaviour:
/// - The rows are written with the alarm, in the same transaction. The nearest owner (index 0) is woken at
///   once (`wokenAt` set), and owner i is due i windows later (`dueAt`).
/// - Each minute the stall evaluator (`wakeDueOwners`, src/lib/agentTasks/stall.ts) stamps `wokenAt` on every
///   row that is due while its alarm is still unacknowledged. Acknowledging the alarm stops every later row.
/// - If the alarm's own episode has ended (the condition no longer holds), the evaluator closes every row not
///   yet woken with `endedAt` instead. A row is woken or ended, never both
///   (`chk_agent_team_alarm_schedule_shape`).
/// - `wokenAt` records that the owner is due a wake. Delivering it is not done here: a worker's due wakes are
///   computed from these rows by src/lib/agentTasks/taskWakes.ts. A person in the chain is recorded as woken
///   the same way and is not delivered to; the timer runs on past them.
///
/// Rules: hrn:node:hadronmemory.com:specs:cor:agt:050:19, hrn:node:hadronmemory.com:specs:cor:agt:050:20.
/// Background: #1706, #2200.
model AgentTeamAlarmSchedule {
  eventId    String    @map("event_id")
  chainIndex Int       @map("chain_index")
  dueAt      DateTime  @map("due_at")
  wokenAt    DateTime? @map("woken_at")
  /// #2200 (R196) — when the escalation found that the alarm's OWN episode had ended (the task moved, so the
  /// condition no longer holds) and closed this row unwoken. Woken or ended, never both
  /// (chk_agent_team_alarm_schedule_shape); the alarm event, its chain and every `woken_at` stay as written.
  endedAt    DateTime? @map("ended_at")

  event AgentTeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, chainIndex])
  @@index([wokenAt, dueAt])
  @@map("agent_team_alarm_schedule")
}

/// #3775 A (hrn:node:hadronmemory.com:specs:cor:agt:050:32): the stall evaluator's pass bookkeeping, ONE platform-wide row (id `platform`). `lastPassAt`
/// is when the latest pass started; `lastGapEndedAt` is the start of the first pass after the latest gap (a pass that
/// began more than 5 minutes after the previous one), which floors the silence windows. Written only by
/// `recordStallPass` (conditional update on the `lastPassAt` it read, so two instances record one gap end).
model StallEvaluatorState {
  id             String    @id
  lastPassAt     DateTime  @map("last_pass_at")
  lastGapEndedAt DateTime? @map("last_gap_ended_at")

  @@map("stall_evaluator_state")
}

/// The recorded moment at which an alarm stopped escalating because the condition it was raised for had
/// ended. One row per alarm, written once. Reads use it to tell whether an alarm is still in effect: an alarm
/// is in effect while it is unacknowledged and has no row here.
///
/// Relationships: belongs to one AgentTeamEvent that is an alarm (`eventId` is the primary key) and is deleted
/// with it. It is a table of its own because the alarm event cannot be updated.
///
/// Behaviour:
/// - An alarm belongs to an episode: the period during which its condition holds. For a task alarm the
///   episode ends when the task moves; for an alarm about no task it ends when its episode row is closed (for
///   example DarkWorkerEpisode.`endedAt`). This row records that end for any kind of alarm.
/// - Written by the stall evaluator's pass (`recordEndedEscalations`, src/lib/agentTasks/stall.ts) for every
///   unacknowledged alarm whose episode it finds ended, and by an acknowledgement that finds the episode
///   already ended but not yet recorded (`freezeEndedEscalation`).
/// - `endedAt` is the earliest end the available history supports when the row is written. It can be up to one
///   evaluator pass late, and it never moves: a trigger refuses every update
///   (prisma/alarm-escalation-end-invariants.sql).
/// - A read takes the earlier of `endedAt` and the alarm's acknowledgement
///   (src/api/graphql/schema/resolvers.agentTask.ts).
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:050:20. Background: #3934.
model AlarmEscalationEnd {
  eventId    String   @id @map("event_id")
  endedAt    DateTime @map("ended_at")
  recordedAt DateTime @default(now()) @map("recorded_at")

  event AgentTeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("alarm_escalation_ends")
}

/// One period during which a worker was dark: it did not check its team channel when it was expected to, or
/// it left a wake that was due to it unacknowledged for too long. The row opens with the alarm raised about
/// the worker and is closed when the worker is no longer dark.
///
/// Episode pattern: an alarm is an AgentTeamEvent, which is append-only, and an alarm about no task cannot be
/// de-duplicated by that table's unique index. So each period during which the condition holds is one row
/// here, with at most one open row per worker, inserted in the same transaction as the alarm. That makes it
/// one alarm per episode, and gives the alarm an end.
///
/// Relationships: belongs to an App and to the Worker it is about, and is deleted with either. `event` is the
/// alarm raised with the episode (an AgentTeamEvent of type `alarm.dark-worker`, with no task), one to one.
///
/// Behaviour:
/// - The stall evaluator's pass (`evaluateDarkWorkers`, src/lib/agentTasks/darkWorker.ts, every minute) opens
///   an episode for a worker whose check status is OVERDUE, or that has a due wake unacknowledged for longer
///   than `App.deliveryDarkAlarmWindowSeconds`, and that has no open episode. `reason` (`overdue` or
///   `wake-unacked`) is the condition that opened it.
/// - A worker has a single open episode across both conditions (partial unique index in
///   prisma/dark-alarm-invariants.sql). The pass ends it (`endedAt`) when both conditions have cleared.
///   Uninstalling the App also ends its open episodes.
/// - `noticePostedAt` is set when the platform's one team-channel post for the episode was written. The post
///   is retried on each pass while the episode is open and not yet posted.
/// - AlarmEscalationEnd and the wake schedule read `endedAt` to stop the alarm's escalation.
///
/// Background: #2755.
model DarkWorkerEpisode {
  id       String    @id @default(cuid())
  appId    String    @map("app_id")
  workerId String    @map("worker_id")
  /// The task-less alarm raised with the episode (agent_team_events, type `alarm.dark-worker`).
  eventId  String    @unique @map("event_id")
  /// `overdue` | `wake-unacked`.
  reason   String
  openedAt DateTime  @map("opened_at")
  endedAt  DateTime? @map("ended_at")
  /// When the platform's one team-channel post for this episode was written; NULL until then (retried each pass while the episode is open).
  noticePostedAt DateTime? @map("notice_posted_at")

  app    App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  worker Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  event  AgentTeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([appId, endedAt])
  @@map("dark_worker_episodes")
}

/// One period during which a worker that is expected to hand out tasks was late doing so: it assigned no task
/// for 60 minutes while a worker it could have given work to was free. The row opens with the alarm raised
/// about the worker and is closed when the worker next assigns a task.
///
/// Which workers: a Worker whose `role` is the text `coordinator` (compared without regard to case) and that
/// is not retired. `role` is free text on Worker; this one value is what the platform reads to find the
/// workers whose assigning it times. The name of the model is historical and under review in #4375.
///
/// Episode pattern: an alarm is an AgentTeamEvent, which is append-only, and an alarm about no task cannot be
/// de-duplicated by that table's unique index. So each period during which the condition holds is one row
/// here, with at most one open row per worker, inserted in the same transaction as the alarm. That makes it
/// one alarm per episode, and gives the alarm an end.
///
/// Relationships: belongs to an App and to the Worker it is about, and is deleted with either. `event` is the
/// alarm raised with the episode (an AgentTeamEvent of type `alarm.coordinator-cadence`, with no task), one to
/// one.
///
/// Behaviour:
/// - The stall evaluator's pass (`evaluateCoordinatorCadence`, src/lib/agentTasks/coordinatorCadence.ts, every
///   minute) opens an episode when such a worker has made no assignment of its own for 60 minutes and at least
///   one worker in its lane is free for work. Its lane is the workers whose reporting line leads to it, and
///   the workers that report to no one. Another such worker, and a worker under a stop signal, never count as
///   free.
/// - Only a task the worker itself assigns or reassigns counts (an AgentTeamEvent of type `task.assigned` or
///   `task.reassigned` with the worker as actor). Assignments made by the matcher do not.
/// - The 60 minutes run from the latest of the worker's last own assignment, the start of its first session,
///   and the moment in CoordinatorCadenceClock.
/// - A worker is not judged late while its team is paused, it is paused itself, or it is under a stop signal.
///   Having no live session is not an exemption.
/// - At most one open row per worker (partial unique index in prisma/coordinator-cadence-invariants.sql). The
///   episode ends only at the worker's next own assignment, and `endedAt` is that assignment's time. A lane
///   worker turning busy, or the worker being paused, does not end it, so neither raises a second alarm.
/// - While the worker is exempt the 60 minutes keep running; only the judgment is skipped. A worker that comes
///   back after a long pause without having assigned anything can be judged late at once.
/// - AlarmEscalationEnd and the wake schedule read `endedAt` to stop the alarm's escalation.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:050:31. Background: #2763.
model CoordinatorCadenceEpisode {
  id       String    @id @default(cuid())
  appId    String    @map("app_id")
  workerId String    @map("worker_id")
  eventId  String    @unique @map("event_id")
  openedAt DateTime  @map("opened_at")
  endedAt  DateTime? @map("ended_at")

  app    App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  worker Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  event  AgentTeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([appId, endedAt])
  @@map("coordinator_cadence_episodes")
}

/// The moment the platform first saw a worker as one whose task assigning it times. One row per such worker.
/// It gives the worker a starting point for its 60-minute window, so that a worker the platform has only just
/// begun to watch is not reported late at once.
///
/// Which workers: a Worker whose `role` is the text `coordinator` (compared without regard to case) and that
/// is not retired. `role` is free text on Worker; this one value is what the platform reads to find the
/// workers that are expected to hand out tasks to others. The name of the model is historical and under review
/// in #4375.
///
/// What is timed: how long such a worker has gone without assigning or reassigning a task itself. When that
/// reaches 60 minutes while a worker it could give work to is free, the platform raises one alarm about it
/// and opens a CoordinatorCadenceEpisode. The 60 minutes run from the latest of three moments: the worker's
/// last own assignment, the start of its first session, and `observedAt` in this row.
///
/// A worker is not judged late while its team is paused, it is paused itself, or it is under a stop signal.
/// Having no live session is not an exemption. While the worker is exempt the 60 minutes keep running; only the
/// judgment is skipped.
///
/// Why the evaluator needs the row: the first two moments can be missing or old. A worker that never assigned
/// a task and never had a session has neither, and a worker that existed before the evaluator first ran can
/// have both far in the past. Without a recorded first sighting, such a worker would be late on the very first
/// pass. With it, the worker is not late until 60 minutes after the platform first saw it.
///
/// Relationships: belongs to the Worker it is about (`workerId` is the primary key) and to that worker's App,
/// and is deleted with either.
///
/// Behaviour: inserted by `observe` in src/lib/agentTasks/coordinatorCadence.ts, which the stall evaluator's
/// pass (src/jobs/taskStallEvaluator.ts, every minute) runs for each such worker when it decides whether the
/// worker is late, and again inside the transaction that raises the alarm. The insert is
/// `ON CONFLICT DO NOTHING`, so the first pass to see a worker sets `observedAt` and concurrent passes agree
/// on it. No code updates or deletes a row: a worker that stops being watched and is watched again later
/// keeps its first `observedAt`.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:050:31. Background: #2763.
model CoordinatorCadenceClock {
  workerId   String   @id @map("worker_id")
  appId      String   @map("app_id")
  observedAt DateTime @map("observed_at")

  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("coordinator_cadence_clocks")
}

/// One period, at most an hour long, during which the platform's attempts to start a worker kept failing. The
/// row opens with the alarm raised about the worker, and limits that alarm to one per hour.
///
/// Episode pattern: an alarm is an AgentTeamEvent, which is append-only, and an alarm about no task cannot be
/// de-duplicated by that table's unique index. So the alarm is tied to a row here, with at most one open row
/// per worker, inserted in the same transaction as the alarm. In this model the episode only de-duplicates:
/// closing it does not end the alarm, which stays in effect until it is acknowledged.
///
/// Relationships: belongs to an App and to the Worker it is about, and is deleted with either. `event` is the
/// alarm raised with the episode (an AgentTeamEvent of type `alarm.start-failing`, with no task), one to one.
///
/// Behaviour:
/// - The condition: the platform starts a long-lived worker that should be running and has no open session
///   (src/lib/desiredState/desiredStart.ts, a step of the matcher's one-minute pass). Three failed starts of
///   one worker within an hour stop these starts for it and call `raiseStartFailingAlarm`.
/// - That function opens an episode and raises the alarm to the worker's reporting line, unless the worker
///   already has an open episode (partial unique index in prisma/desired-start-invariants.sql).
/// - An episode is over an hour after it opened. `endedAt` is written as `openedAt` plus one hour by the next
///   call for the same worker, which then opens a new episode. So a worker that is still failing an hour later
///   is alarmed again.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:070:08. Background: #4231, #4229.
model StartFailingEpisode {
  id       String    @id @default(cuid())
  appId    String    @map("app_id")
  workerId String    @map("worker_id")
  eventId  String    @unique @map("event_id")
  openedAt DateTime  @map("opened_at")
  endedAt  DateTime? @map("ended_at")

  app    App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  worker Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  event  AgentTeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([appId, endedAt])
  @@map("start_failing_episodes")
}

/// One period, at most an hour long, that starts when a worker's team-chat post is refused by the posting
/// rate limit. The row opens with the alarm raised about the worker, and limits that alarm to one per hour.
///
/// Episode pattern: an alarm is an AgentTeamEvent, which is append-only, and an alarm about no task cannot be
/// de-duplicated by that table's unique index. So the alarm is tied to a row here, with at most one open row
/// per worker, inserted in the same transaction as the alarm. In this model the episode only de-duplicates:
/// closing it does not end the alarm, which stays open and keeps escalating until it is acknowledged.
///
/// Relationships: belongs to an App and to the Worker it is about, and is deleted with either. `event` is the
/// alarm raised with the episode (an AgentTeamEvent of type `alarm.post-limit`, with no task), one to one.
///
/// Behaviour:
/// - Not opened by an evaluator. The refusal itself calls `raisePostLimitAlarm`
///   (src/lib/agentTasks/postLimit.ts, from src/api/graphql/schema/resolvers.teamChat.ts), in a transaction of
///   its own that commits although the post is refused.
/// - The first refusal with no open episode opens one and raises the alarm to the worker's reporting line.
///   Later refusals within the hour raise nothing (partial unique index in prisma/post-limit-invariants.sql).
/// - An episode is over an hour after it opened. `endedAt` is written as `openedAt` plus one hour by the next
///   refusal, which then opens a new episode. Times are read on the database clock.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:020:14. Background: #2014.
model PostLimitEpisode {
  id       String    @id @default(cuid())
  appId    String    @map("app_id")
  workerId String    @map("worker_id")
  eventId  String    @unique @map("event_id")
  openedAt DateTime  @map("opened_at")
  endedAt  DateTime? @map("ended_at")

  app    App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  worker Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  event  AgentTeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([appId, endedAt])
  @@map("post_limit_episodes")
}

/// One run of a host's sweep, as the host reported it. A host is a machine that runs the workers of a team
/// App; its sweep runs about once a minute, plans changes to the workers it runs and, in apply mode, makes
/// them. This row is the report of one such run: when it ran, in which mode, and how many workers it planned
/// to change and what became of them.
///
/// Relationships: belongs to an App and is deleted with it. `hostId` is the host's id within the App (the
/// value on HostRegistration), a plain value with no foreign key.
///
/// Behaviour:
/// - Written once by the host's own key through `recordHostSweepRun`
///   (src/api/graphql/schema/resolvers.hostSweepRuns.ts, src/lib/agentTasks/sweepRuns.ts). `runKey` is the
///   host's own token for the run and is unique per (App, host): a report sent again is the same row and
///   changes nothing.
/// - `mode` is the sweep mode the run ran in. `planned`, `applied`, `skipped` and `failed` count workers.
///   `lines` holds at most 50 per-worker lines, each a worker token, an outcome and a reason code. No free
///   text is accepted anywhere in a report. Shape: prisma/host-sweep-invariants.sql.
/// - A run that applied or failed at least one change produces one summary post in the App's team chat, from
///   the platform. `postedAt` is claimed in the post's own transaction, so the run posts once. `summaryTriedAt`
///   records a post that was tried and did not land; the evaluator's pass retries it.
/// - Recording a run ends the host's open HostSweepEpisode. The stale-sweep check reads the newest
///   `recordedAt` per host: the platform's clock, never the host's `endedAt`.
/// - Readable by whoever may read the App's tasks and events. A host key reads only its own host's runs.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:070:09. Rule:
/// hrn:node:hadronmemory.com:specs:cor:agt:070:10. Background: #4233, #4229, #4255.
model HostSweepRun {
  id         String    @id
  appId      String    @map("app_id")
  hostId     String    @map("host_id")
  runKey     String    @map("run_key")
  startedAt  DateTime  @map("started_at")
  endedAt    DateTime  @map("ended_at")
  mode       SweepMode
  planned    Int
  applied    Int
  skipped    Int
  failed     Int
  lines      Json      @default("[]")
  recordedAt DateTime  @default(now()) @map("recorded_at")
  /// When the run's summary post was written; NULL for a run that needed none, or whose post has not run yet.
  postedAt   DateTime? @map("posted_at")
  /// When the retry pass last tried this run's post and did not land it (no chat, the host gap, a failed append). The retry queue
  /// orders untried runs first, so a run that cannot post goes to the back and never holds the scan (#4255 Clark F4).
  summaryTriedAt DateTime? @map("summary_tried_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, hostId, runKey], map: "host_sweep_runs_run_uniq")
  @@index([appId, hostId, recordedAt(sort: Desc)], map: "host_sweep_runs_host_recent_idx")
  @@map("host_sweep_runs")
}

/// One period during which a host's sweep had gone quiet: the platform last recorded a HostSweepRun for the
/// host more than five minutes ago, in an App whose sweep is switched on. The row opens with the alarm raised
/// about the host and is closed when the host reports again.
///
/// Episode pattern: an alarm is an AgentTeamEvent, which is append-only, and an alarm about no task cannot be
/// de-duplicated by that table's unique index. So each period during which the condition holds is one row
/// here, with at most one open row per (App, host), inserted in the same transaction as the alarm. That makes
/// it one alarm per episode, and gives the alarm an end.
///
/// Relationships: belongs to an App and is deleted with it. `hostId` is the host's id within the App, a plain
/// value with no foreign key. `event` is the alarm raised with the episode (an AgentTeamEvent of type
/// `alarm.stale-sweep`, with no task and no subject worker), one to one.
///
/// Behaviour:
/// - The stall evaluator's pass (`evaluateStaleSweeps`, src/lib/agentTasks/sweepRuns.ts, every minute) opens
///   an episode for a host of an App whose sweep mode is OBSERVE or APPLY, when the newest run the platform
///   recorded for it is older than five minutes and it has no open episode (partial unique index in
///   prisma/host-sweep-invariants.sql). The alarm goes to the App's managers.
/// - A host that never ran is judged from its registration, and a change of the App's sweep mode restarts the
///   clock, so switching the sweep on does not alarm in the same minute.
/// - The episode ends when the host records its next run, or when the App's sweep mode goes OFF (or the App is
///   deleted or uninstalled).
/// - AlarmEscalationEnd and the wake schedule read `endedAt` to stop the alarm's escalation.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:070:11. Background: #4233.
model HostSweepEpisode {
  id       String    @id @default(cuid())
  appId    String    @map("app_id")
  hostId   String    @map("host_id")
  eventId  String    @unique @map("event_id")
  openedAt DateTime  @map("opened_at")
  endedAt  DateTime? @map("ended_at")

  app   App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  event AgentTeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([appId, endedAt])
  @@map("host_sweep_episodes")
}

/// Whether one worker is available for work, and if not, why and until when. It is one of the inputs to
/// whether the matcher may give the worker a task. A worker with no row is available.
///
/// Relationships: belongs to one Worker (`workerId` is the primary key, so at most one row per worker) and is
/// deleted with it. `setByUserId`, `setByWorkerId`, `setByAgentId` and `setByHostId` are plain ids that record
/// who set it. `contextResetId` names the ContextReset that set a `resetting` mark, with no foreign key: both
/// rows go with their worker.
///
/// Behaviour:
/// - `state` is `available` or `unavailable`. An unavailable row has a `reason`: `stalled`, `out-of-tokens`,
///   `host-down`, `other` or `resetting`.
/// - The row is kept when the worker becomes available again, as the record of the last change.
/// - An `until` that has passed reads as available at once. The matcher's sweep then rewrites the row to
///   `available`, set by `lapse`, and writes one event.
/// - `setBy` names the kind of setter: `worker` (itself, only to unavailable), `holder`, `app-manager`,
///   `reports-to` (the worker it reports to, only to clear a `stalled` mark), `stall-rule` (a stall alarm
///   marked the stalled worker), `host` (a host that registered the worker, only `out-of-tokens` or
///   `host-down`, and it clears only its own marks), `lapse`, or `context-reset` (the platform's context
///   reset, which alone writes `resetting`).
/// - A `stalled` mark ends at the worker's next activity. A `resetting` mark ends at the worker's first
///   activity after `clearsOnActivityAfter`.
/// - Shape: `chk_worker_availability_shape` (prisma/agent-task-stall-invariants.sql). Written by
///   src/lib/agentTasks/availability.ts, src/lib/contextReset/contextReset.ts and the availability mutations.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:060:02. Rules:
/// hrn:node:hadronmemory.com:specs:cor:agt:060:07, hrn:node:hadronmemory.com:specs:cor:agt:060:08,
/// hrn:node:hadronmemory.com:specs:cor:agt:060:11, hrn:node:hadronmemory.com:specs:cor:agt:050:27.
/// Background: #1706, #1709, #1759, #1766, #2162.
model WorkerAvailability {
  workerId              String    @id @map("worker_id")
  /// 'available' | 'unavailable'.
  state                 String
  /// Unavailable only: 'stalled' | 'out-of-tokens' | 'host-down' | 'other'.
  reason                String?
  until                 DateTime?
  setAt                 DateTime  @map("set_at")
  setBy                 String    @map("set_by")
  setByUserId           String?   @map("set_by_user_id")
  setByWorkerId         String?   @map("set_by_worker_id")
  setByAgentId          String?   @map("set_by_agent_id")
  /// #1709 — the host whose key set this record (`setBy = host` only), so a
  /// host clears only its own marks (hrn:node:hadronmemory.com:specs:cor:agt:060:08).
  setByHostId           String?   @map("set_by_host_id")
  /// #2162 (hrn:node:hadronmemory.com:specs:cor:agt:050:27) — a `resetting` mark only: the instant the host reported the old agent stopped. The
  /// worker's first activity AFTER it ends the mark (the relaunched agent's first call); null while the old agent may
  /// still be running, when no activity ends it.
  clearsOnActivityAfter DateTime? @map("clears_on_activity_after")
  /// #2162 (hrn:node:hadronmemory.com:specs:cor:agt:050:27) — a `resetting` mark only, and always on one: the reset that claimed it. A reset moves or
  /// releases only its own mark, so an older reset still open after its lease lapsed never touches a newer one's.
  /// No FK: both rows go with their worker (cascade), and the shape CHECK pairs this with the reason.
  contextResetId        String?   @map("context_reset_id")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_availability")
}

/// A named list of model patterns, for example `large` = [`claude-opus-*`]. A task can require that the worker
/// it is matched to runs a model in a group, or does not. The platform gives the name and the patterns no
/// meaning of its own.
///
/// Relationships: owned by exactly one of an Agent (`agentId`) or an App (`appId`), and deleted with its owner
/// (CHECK `chk_model_group_owner`). `name` is unique per owner.
///
/// Behaviour:
/// - The team's Agent declares groups. An App may override a group of the same name, which replaces the whole
///   list, or add a group of its own.
/// - A group is resolved at match time, the App's row first and otherwise the Agent's
///   (src/lib/agentTasks/modelGroups.ts). It is never copied when the Agent is installed, so an edit by the
///   Agent reaches every App at once.
/// - `name` and every pattern are stored in lower case. Patterns are globs.
/// - A group is used for matching only. It is never an input to authorization.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:060:12. Background: #2831.
model ModelGroup {
  id        String    @id @default(cuid())
  name      String
  agentId   String?   @map("agent_id")
  appId     String?   @map("app_id")
  patterns  String[]
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  app   App?   @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([agentId, name])
  @@unique([appId, name])
  @@map("model_groups")
}

/// Whether one model family (for example `claude` or `codex`) is available for work in one App. It lets a team
/// pause every worker of a family at once: a worker whose family is unavailable is not available for work.
///
/// Relationships: belongs to an App and is deleted with it. At most one row per (App, `family`), the primary
/// key. `setByUserId`, `setByWorkerId` and `setByAgentId` are plain ids that record who set it.
///
/// Behaviour: with no row the family is available. `state` is `available` or `unavailable`, with an optional
/// `reason` and an optional `until`, after which the row reads as available. Only whoever manages the App sets
/// it (hrn:node:hadronmemory.com:specs:cor:agt:060:09). The matcher and the roster read it together with
/// WorkerAvailability (src/lib/agentTasks/availability.ts). Unlike a worker's record, a lapsed family record
/// is not rewritten by a sweep.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:060:03. Background: #1706.
model ModelFamilyAvailability {
  appId         String    @map("app_id")
  /// The model family, e.g. `claude`, `codex`, `glm` (hrn:node:hadronmemory.com:specs:cor:agt:060:04).
  family        String
  state         String
  reason        String?
  until         DateTime?
  setAt         DateTime  @map("set_at")
  setByUserId   String?   @map("set_by_user_id")
  setByWorkerId String?   @map("set_by_worker_id")
  setByAgentId  String?   @map("set_by_agent_id")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, family])
  @@map("model_family_availability")
}

/// One App's own settings for the time limits of its task work, in place of the platform's defaults: how long
/// a task may sit before an alarm is raised, and a few related limits for hosts and sessions.
///
/// Relationships: belongs to one App (`appId` is the primary key) and is deleted with it.
///
/// Behaviour:
/// - A null column, or no row, means the platform default.
/// - The four stall windows, in minutes: `notStartedMinutes` (an assigned task not started,
///   hrn:node:hadronmemory.com:specs:cor:agt:050:14), `noProgressMinutes` (a started task with no progress,
///   hrn:node:hadronmemory.com:specs:cor:agt:050:15), `ownerReactionMinutes` (an owner who does not react to a
///   finished child task, hrn:node:hadronmemory.com:specs:cor:agt:050:16) and `assignmentMinutes` (a task
///   nobody could be assigned, hrn:node:hadronmemory.com:specs:cor:agt:050:17). The defaults are
///   STALL_WINDOW_DEFAULTS in src/lib/agentTasks/stall.ts.
/// - `hostLapseCheckIns`: how many of a host's check-in intervals may pass before its HostRegistration lapses
///   (2 to 10, default 3).
/// - `sessionEndGraceMinutes`: how long a worker asked to end its session has before the platform ends it
///   through its host (1 to 1440, default 10; see TaskSessionEndRequest).
/// - `hostReportTimeoutMinutes`: how long a host has to report a HostOperation it collected before the
///   platform fails it (5 to 1440, default 60).
/// - Set by whoever manages the App (`setAgentTaskStallSchedule`). The values are tunables, not contract.
///
/// Background: #1706, #1709, #1763, #1881.
model AgentTaskStallSchedule {
  appId                    String   @id @map("app_id")
  notStartedMinutes        Int?     @map("not_started_minutes")
  noProgressMinutes        Int?     @map("no_progress_minutes")
  ownerReactionMinutes     Int?     @map("owner_reaction_minutes")
  assignmentMinutes        Int?     @map("assignment_minutes")
  /// #1763 (hrn:node:hadronmemory.com:specs:cor:agt:070:01) — how many of a host's own check-in intervals may
  /// pass without a refresh before its registration in this App lapses: 2 to
  /// 10 (chk_agent_task_stall_schedule_range); null is the default, 3.
  hostLapseCheckIns        Int?     @map("host_lapse_check_ins")
  /// #1709 (hrn:node:hadronmemory.com:specs:cor:agt:050:10) — how many minutes a worker asked to end its
  /// session on its task's finish or cancellation has before the platform ends
  /// it through its host: 1 to 1440; null is the default, 10.
  sessionEndGraceMinutes   Int?     @map("session_end_grace_minutes")
  /// #1881 (hrn:node:hadronmemory.com:specs:cor:agt:070:02) — how many minutes a host has to report an
  /// operation it collected before the platform fails it: 5 to 1440; null is
  /// the default, 60.
  hostReportTimeoutMinutes Int?     @map("host_report_timeout_minutes")
  updatedAt                DateTime @updatedAt @map("updated_at")
  updatedBy                String?  @map("updated_by")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("agent_task_stall_schedule")
}

/// A host's statement that it serves a team App. A host is a machine that runs the App's workers; it
/// registers itself, lists the workers it can launch, and keeps the registration alive by refreshing it. The
/// platform uses it to know where a worker with no session can be started.
///
/// Relationships: belongs to an App and is deleted with it. One row per (App, `hostId`). Its `workers` are
/// HostRegistrationWorker rows, one per worker the host can launch. TeamStopSignal rows of host scope name the
/// registration. HostOperation, HostSweepRun and HostWorkerAssignment name the same host by `hostId`, a plain
/// value.
///
/// Behaviour:
/// - The host's identity comes from its key, never from the request: `registerHost` takes the host id from
///   the `host:operate` scope of the calling App key, which names one App and one host
///   (hrn:node:hadronmemory.com:specs:cor:agt:070:04). The writer is src/lib/agentTasks/hosts.ts. `label` is
///   for display only.
/// - A registration is live while it was refreshed (`refreshedAt`) within a number of its own
///   `pollIntervalSeconds`. That number is the App's `hostLapseCheckIns` on AgentTaskStallSchedule, 2 to 10,
///   default 3. Liveness is worked out at read time.
/// - When a registration has lapsed, its workers stop counting as launchable through it. The matcher's sweep
///   (`sweepLostHosts`) writes one `host.lost` event and stamps `lostAt`. A refresh clears `lostAt`.
/// - `capabilities` are the capability-gated operation types the host declared it performs. A host is never
///   issued such a type unless its live registration lists it; today the only one is `worker.reset-context`.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:070:01. Rule:
/// hrn:node:hadronmemory.com:specs:cor:agt:070:04. Background: #1707, #1709, #1763, #2162.
model HostRegistration {
  id                  String    @id @default(cuid())
  appId               String    @map("app_id")
  hostId              String    @map("host_id")
  label               String
  pollIntervalSeconds Int       @map("poll_interval_seconds")
  registeredAt        DateTime  @default(now()) @map("registered_at")
  refreshedAt         DateTime  @map("refreshed_at")
  lostAt              DateTime? @map("lost_at")
  /// #2162 (hrn:node:hadronmemory.com:specs:cor:agt:070:01) — the capability-gated operation types this host declared it performs. A host
  /// is never issued such a type unless its live registration lists it; today that is only `worker.reset-context`.
  capabilities        String[]  @default([])

  app         App                      @relation(fields: [appId], references: [id], onDelete: Cascade)
  workers     HostRegistrationWorker[]
  /// #2022 — host-scope stop signals naming this registration.
  stopSignals TeamStopSignal[]

  @@unique([appId, hostId], map: "host_registrations_app_host_uniq")
  @@map("host_registrations")
}

/// One worker that a registered host says it can launch, with the model family the worker would run as
/// there. The rows of a registration are the list of workers the platform may start on that host.
///
/// Relationships: joins a HostRegistration and a Worker, one row per pair (the primary key), and is deleted
/// with either. A worker may be listed by several hosts.
///
/// Behaviour: written with the registration by src/lib/agentTasks/hosts.ts; a refresh replaces the list.
/// `family` is the model family. `worktrees` are the worker's existing working directories on that host, as
/// name tokens the host resolves from its own configuration, never paths the platform invents. A worker is
/// started only in one of them, and an empty list means it has none there
/// (hrn:node:hadronmemory.com:specs:cor:agt:070:06).
///
/// Entity spec (of the registration): hrn:node:hadronmemory.com:specs:cor:agt:070:01. Background: #1707, #1709.
model HostRegistrationWorker {
  registrationId String   @map("registration_id")
  workerId       String   @map("worker_id")
  family         String
  /// #1709 — the worker's existing worktrees on this host, as the host names
  /// them (tokens the host resolves from its own configuration, never paths the
  /// platform invents). A worker is started only in one of these
  /// (hrn:node:hadronmemory.com:specs:cor:agt:070:06, hrn:node:hadronmemory.com:specs:cor:agt:070:08); empty means it has none here.
  worktrees      String[] @default([])

  registration HostRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  worker       Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([registrationId, workerId])
  @@index([workerId])
  @@map("host_registration_workers")
}

/// The platform's own statement that a host of a team App runs a given worker, and how: the working directory
/// the worker runs in on that host and the launcher settings to start it with. It is the counterpart of
/// HostRegistrationWorker, where the host states what it can launch.
///
/// Relationships: belongs to an App and to a Worker of that same App, and is deleted with either. The foreign
/// key covers the worker and its App together, so an assignment can only name a worker of its own App, and a
/// worker with assignments cannot move to another App. `hostId` is the host's id within the App, a plain
/// value. One row per (App, worker, host). `createdByUserId` is a plain id that outlives the account.
///
/// Behaviour:
/// - Every field a host acts on is a name token the host resolves through its own configuration: `workdir`
///   (a worktree name, or a plain directory name for a worker without Git), `family`, `model`, `effort` and
///   `accountProfile`. Never a path, a command or a credential
///   (hrn:node:hadronmemory.com:specs:cor:agt:070:03). Shape: prisma/host-assignment-invariants.sql.
/// - Set and removed by whoever manages the App (src/api/graphql/schema/resolvers.hostAssignment.ts). No App
///   key writes one: a host never assigns itself a worker.
/// - While the App's `hostSetupSource` is `host` (the default), assignments are only a record. Once it is
///   `server`, a host may register only the workers assigned to it, a worker is launchable through a host only
///   while it is assigned there and the host's live registration lists it with the assigned `workdir`, and a
///   start uses the assignment's `workdir` and `family` (src/lib/hostOperations/assignments.ts).
/// - An assignment of a retired worker is not in effect.
///
/// Entity spec (of the registration): hrn:node:hadronmemory.com:specs:cor:agt:070:01. Rule:
/// hrn:node:hadronmemory.com:specs:cor:agt:070:03. Background: #4222, #4229, #4230.
model HostWorkerAssignment {
  id              String   @id
  appId           String   @map("app_id")
  hostId          String   @map("host_id")
  workerId        String   @map("worker_id")
  workdir         String
  family          String
  model           String?
  /// #4230 (S1b, decision G1): the launcher profile is typed fields, never a command. family above, model, and these two.
  effort          String?
  /// The host-local account the launcher runs under (a token the host maps to its launcher; never a path or credential).
  accountProfile  String?  @map("account_profile")
  /// The person who made the assignment (a plain id, like a host operation's issuer: it outlives the account).
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")

  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// The worker AND its App (#4241 blind review, Diego P2): an assignment names only a worker of its own App, and a worker
  /// that has assignments keeps its App (onUpdate NoAction). Foreign-key checks see committed rows at every isolation
  /// level, so this holds when an insert and a move race.
  worker Worker @relation(fields: [workerId, appId], references: [id, appId], onDelete: Cascade, onUpdate: NoAction, map: "host_worker_assignments_worker_app_fkey")

  @@unique([appId, workerId, hostId], map: "host_worker_assignments_app_worker_host_uniq")
  @@index([appId, hostId])
  @@index([workerId])
  @@map("host_worker_assignments")
}

/// One instruction the platform issued to one host of a team App, for one worker: for example start this
/// worker, end its session, or create a worktree. The host collects the operation, carries it out and reports
/// the outcome. This is the only way the platform asks a host to do anything.
///
/// Relationships: belongs to an App and to the Worker the operation is for, and is deleted with either.
/// `hostId` is the host's id within the App, a plain value. The issuer ids (`issuedByUserId`,
/// `issuedByWorkerId`, `issuedByAgentId`) and `holdUserId` are plain ids. A LaunchGrant, a ContextReset and a
/// TaskSessionEndRequest name the operation that serves them by id.
///
/// Behaviour:
/// - `type` is one of a closed set (`worktree.create`, `worker.start`, `worker.deliver`, `worker.end`,
///   `worktree.remove`, `worker.reset-context`) and `args` are its typed arguments, validated when the
///   operation is issued (src/lib/hostOperations/types.ts). There is no free-form type and no shell command
///   (hrn:node:hadronmemory.com:specs:cor:agt:070:03).
/// - `status` moves `issued`, then `collected` (the host took it), then `succeeded` or `failed` (the host
///   reported; a failure carries `failureReason`). Each outcome also writes a `host.operation.succeeded` or
///   `host.operation.failed` AgentTeamEvent. A collected operation with no report is failed by the stall
///   evaluator's pass after the App's report timeout (src/lib/hostOperations/settle.ts).
/// - Only the host it names collects or reports it, through that host's key
///   (hrn:node:hadronmemory.com:specs:cor:agt:070:04).
/// - `issuedBy` is `user`, `worker` (through its session) or `platform`. `issuedReason` says why the platform
///   issued it when that is not a task: `DESIRED_RUNNING` for the start of a long-lived worker that should run
///   and has no session.
/// - For a `worker.start`, `holdUserId` and `holdAt` record the hold on the worker that authorized the start.
///   A launch grant is minted, and a session bound, only while the worker's hold is still exactly that one.
/// - Shape: prisma/host-operation-invariants.sql and prisma/desired-start-invariants.sql.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:070:02. Rules:
/// hrn:node:hadronmemory.com:specs:cor:agt:070:03, hrn:node:hadronmemory.com:specs:cor:agt:070:04.
/// Background: #1709, #1881, #1883, #4231.
model HostOperation {
  id               String    @id
  appId            String    @map("app_id")
  hostId           String    @map("host_id")
  type             String
  args             Json
  /// The worker the operation is for; every type names one.
  workerId         String    @map("worker_id")
  status           String    @default("issued")
  /// `user` | `worker` | `platform`.
  issuedBy         String    @map("issued_by")
  issuedByUserId   String?   @map("issued_by_user_id")
  issuedByWorkerId String?   @map("issued_by_worker_id")
  issuedByAgentId  String?   @map("issued_by_agent_id")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  collectedAt      DateTime? @map("collected_at")
  finishedAt       DateTime? @map("finished_at")
  /// The typed result a success reports (e.g. the created worktree).
  result           Json?
  /// Why it failed, as the host said it; failures only.
  failureReason    String?   @map("failure_reason")
  /// #1709 slice 2 (#1883 review, Diego P2-1) — `worker.start` only: the hold
  /// that authorized the start, as (holder, held-at) when it was issued. A
  /// grant is minted, and a bind made, only while the worker's hold is still
  /// exactly this one: a release and re-hold changes `heldAt`, a move or an
  /// account merge changes the holder (Holger via Vera #10775).
  holdUserId       String?   @map("hold_user_id")
  holdAt           DateTime? @map("hold_at")
  /// #4231 (S8 of #4229) — why the platform issued it, when that is not a task: `DESIRED_RUNNING` for the start of a
  /// long-lived worker that should run and has no session (hrn:node:hadronmemory.com:specs:cor:agt:070:05 S7). Null for every other
  /// operation. Shape: prisma/desired-start-invariants.sql.
  issuedReason     String?   @map("issued_reason")

  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([appId, hostId, status])
  @@index([workerId])
  @@map("host_operations")
}

/// A short-lived note that lets a worker's agent find its way back to its worker after it deliberately
/// resets its context. Before the reset, the session's own driver writes a claim; the fresh context then
/// recovers the worker with one call and no arguments, and needs no local binding file.
///
/// Relationships: belongs to an App and is deleted with it. `sessionId`, `workerId`, `holderUserId` and
/// `resumedSessionId` are plain ids with no foreign key.
///
/// Behaviour:
/// - Written by `writeResumeClaim` (src/lib/resumeClaims.ts), which the session mutations in
///   src/api/graphql/schema/resolvers.mutation.session.ts call (`createResumeClaim` is one). Two kinds of
///   reset write one. A shed clears the worker's context and keeps its session open. A rotation ends the session
///   with a handoff, and the worker starts a new one.
/// - It lives 60 seconds from the write (`expiresAt`, RESUME_CLAIM_TTL_MS), judged on the database clock.
/// - Single use: redeeming is one guarded update that sets `consumedAt`, so of two racing redemptions exactly
///   one wins. `resumedSessionId` is the session the redemption bound: the claimed one when it was still open,
///   otherwise a new session started for its worker.
/// - Only its holder can redeem it, and that is judged by the caller's own token, never by anything the
///   caller presents. The claim carries no secret and its id is never shown, so a caller who is not the holder
///   has nothing to present and learns nothing.
/// - A newer claim for the same session replaces an unused older one (`revokedAt`).
/// - It authorizes nothing the holder could not already do by naming the worker. It works like a LaunchGrant,
///   without a token.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:020:03. Background: #1956.
model ResumeClaim {
  id               String    @id
  appId            String    @map("app_id")
  sessionId        String    @map("session_id")
  workerId         String    @map("worker_id")
  holderUserId     String    @map("holder_user_id")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at")
  /// The session the redemption bound: the claimed one when it was still open,
  /// or the new session started for its worker when it had ended.
  resumedSessionId String?   @map("resumed_session_id")
  /// Set when a newer claim for the same session replaced this one unused.
  revokedAt        DateTime? @map("revoked_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([holderUserId, expiresAt])
  @@index([sessionId])
  @@map("resume_claims")
}

/// A single-use proof that a host hands to the agent it starts, so that the agent can open an ordinary worker
/// session for the worker it was started as. The agent redeems it at `startSession`.
///
/// Relationships: belongs to an App and is deleted with it. `operationId` is the `worker.start` HostOperation
/// it was minted for, and `workerId`, `hostId`, `taskId`, `holderUserId` and `sessionId` are what it is bound
/// to. All are plain ids with no foreign key.
///
/// Behaviour:
/// - Minted when the host collects a `worker.start` operation (src/lib/hostOperations/launch.ts), so that no
///   secret is stored in the operation. Only a hash of the token is stored (`tokenHash`, unique).
/// - It is bound to the worker, the host, the task (if any) and the holder of the worker, and lives 10 minutes
///   (`expiresAt`, LAUNCH_GRANT_TTL_MS).
/// - Only the holder can redeem it, and that is judged by the caller's own token, never by the grant. It is
///   consumed in one guarded update (`consumedAt`, with the `sessionId` it opened). A host key can never redeem
///   it.
/// - Collecting the same operation again revokes the grant that was not consumed (`revokedAt`) before a new
///   one is minted. An operation that ends as failed also revokes it.
/// - It is never a credential: it authorizes nothing the holder's own token does not.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:020:03. Background: #1709, #1883.
model LaunchGrant {
  id           String    @id
  appId        String    @map("app_id")
  operationId  String    @map("operation_id")
  workerId     String    @map("worker_id")
  hostId       String    @map("host_id")
  taskId       String?   @map("task_id")
  holderUserId String    @map("holder_user_id")
  tokenHash    String    @unique @map("token_hash")
  issuedAt     DateTime  @default(now()) @map("issued_at")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  sessionId    String?   @map("session_id")
  revokedAt    DateTime? @map("revoked_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@map("launch_grants")
}

/// One reset of a worker's context: the worker's agent is stopped and started again by its host so that it
/// continues with a fresh context, while its session and its binding to the worker stay as they are. The row
/// is the state of that procedure, step by step.
///
/// Relationships: belongs to an App and to the Worker being reset, and is deleted with either. `sessionId` is
/// the worker's session that was open when the reset was requested, `taskId` the task whose end caused it
/// (unique: a task ends once; null for a reset that belongs to no task), `hostId` the host it was issued to,
/// and `hostOperationId` its `worker.reset-context` HostOperation (unique). All are plain ids with no foreign
/// key. WorkerAvailability.`contextResetId` names the reset that holds a worker's `resetting` mark.
///
/// Behaviour:
/// - `cause` is `task-end` (a task the worker had started finished or was cancelled, and its Agent has
///   `resetContextAfterTask` on) or `context-cap` (the worker is over its Agent's context cap). It never
///   changes (`trg_context_resets_cause_immutable`), and `chk_context_resets_cause` ties it to `taskId`.
/// - `phase` only moves forward: requested, claimed, checkpointed, stop-granted, agent-stopped, relaunched,
///   done; or to `refused` or `failed`, with a `reason` from a closed set (src/lib/contextReset/types.ts).
/// - With no live host that registers the worker and declared the capability, the reset is recorded failed
///   with HOST_UNSUPPORTED and nothing is issued (`hostId` null).
/// - The host drives the steps with its key. Each step names the reset's `epoch`, which moves at the claim and
///   at every cancellation, so a step that names an older epoch is refused STALE_EPOCH.
/// - While a reset is claimed the worker is marked unavailable with reason `resetting`, so no task is assigned
///   to it. The mark lapses by itself with the step's lease.
/// - The host operation keeps its own status; this row is the reset's protocol state. The stall evaluator's
///   pass ends a reset whose lease lapsed, whose session ended or whose operation settled.
/// - A reset never reads or writes the task's outcome, and never ends, starts or rebinds a session.
/// - Written only by src/lib/contextReset/contextReset.ts.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:050:27. Background: #2162, #4225.
model ContextReset {
  id                   String    @id
  appId                String    @map("app_id")
  workerId             String    @map("worker_id")
  /// The worker's session open when the task ended: the fence the claim re-checks.
  sessionId            String    @map("session_id")
  /// Null for a `context-cap` reset (#4225): it belongs to no task. `chk_context_resets_cause` ties the two together.
  taskId               String?   @unique @map("task_id")
  /// #4225: what asked for the reset: `task-end` (a task's finish or cancel, hrn:node:hadronmemory.com:specs:cor:agt:050:27 part 2) or `context-cap` (the
  /// Agent's cap, part 12). Never changes (`trg_context_resets_cause_immutable`).
  cause                String    @default("task-end")
  /// The host the reset was issued to; null when no capable live host registered the worker (HOST_UNSUPPORTED).
  hostId               String?   @map("host_id")
  hostOperationId      String?   @unique @map("host_operation_id")
  phase                String
  /// Refused or failed only: a word from the closed set (src/lib/contextReset/types.ts).
  reason               String?
  epoch                Int       @default(0)
  requestedAt          DateTime  @map("requested_at")
  claimedAt            DateTime? @map("claimed_at")
  /// The agent process the host observed at claim: `{pid, startTime}`.
  claimProcess         Json?     @map("claim_process")
  /// `{checkpointNodeId, sessionId, taskId}`, registered before any process control.
  recoveryRef          Json?     @map("recovery_ref")
  recoveryRegisteredAt DateTime? @map("recovery_registered_at")
  stopGrantedAt        DateTime? @map("stop_granted_at")
  stopLeaseMs          Int?      @map("stop_lease_ms")
  agentStoppedAt       DateTime? @map("agent_stopped_at")
  relaunchedAt         DateTime? @map("relaunched_at")
  relaunchProcess      Json?     @map("relaunch_process")
  /// When a cancellation found a stop lease outstanding: the mark lifts no earlier than this.
  releasePendingAt     DateTime? @map("release_pending_at")
  endedAt              DateTime? @map("ended_at")

  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, phase])
  @@index([phase])
  @@map("context_resets")
}

/// A request that a worker end its session because its task is over. When a task that asks for it finishes or
/// is cancelled while its worker assignee has an open session, the worker is asked to end that session; if it
/// has not done so after a grace period, the platform ends the session through the worker's host.
///
/// Relationships: belongs to an App and is deleted with it. `taskId`, `workerId` (the worker that is asked),
/// `sessionId` (the one session that may be ended), `eventId` (the `task.session-end-requested` AgentTeamEvent
/// the request wrote), `requestedByWorkerId` and `operationId` (the `worker.end` HostOperation, if one was
/// issued) are plain ids with no foreign key.
///
/// Behaviour:
/// - Written by src/lib/hostOperations/sessionEnd.ts in the transaction that ends the task, when the task has
///   `closeSessionWhenDone`. For a worker whose Agent is short-lived the flag is not read: the worker is asked
///   when the last open task assigned to it ends, is reassigned away from it, or is handed back.
/// - `taskId` is not unique. A task can have several requests over its life: one each time it ends under a
///   worker or leaves a short-lived one.
/// - The worker is asked first. At `dueAt` (the App's grace, default 10 minutes, see AgentTaskStallSchedule)
///   the stall evaluator's pass resolves the request: `ended` (the session has ended, by the worker or
///   otherwise), `end-issued` (still open, so the platform issued `worker.end` for that exact session to a
///   live host that registers the worker), or `no-live-host` (still open and no live host: nothing more
///   happens).
/// - Only `sessionId` is ever ended. A session the worker binds later is never touched.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:050:10. Background: #1709, #4223, #4265.
model TaskSessionEndRequest {
  id                  String    @id
  appId               String    @map("app_id")
  /// #4223: not unique. A task asks each time it ends under a worker or is reassigned away from a short-lived one.
  taskId              String    @map("task_id")
  workerId            String    @map("worker_id")
  sessionId           String    @map("session_id")
  /// The `task.session-end-requested` event this request wrote.
  eventId             String    @map("event_id")
  /// The worker that finished or cancelled the task, when a worker did.
  requestedByWorkerId String?   @map("requested_by_worker_id")
  requestedAt         DateTime  @map("requested_at")
  dueAt               DateTime  @map("due_at")
  resolvedAt          DateTime? @map("resolved_at")
  /// `ended` | `end-issued` | `no-live-host`; null while open.
  resolution          String?
  operationId         String?   @map("operation_id")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, dueAt])
  @@index([workerId])
  @@index([taskId])
  @@map("task_session_end_requests")
}

/// One use of a host key: the record that a host's App key did something, what, for which App and host, and
/// when. Every use of a host key is recorded, so the people who manage the App can see what their hosts did.
///
/// Relationships: belongs to the AppKey that was used and is deleted with it. `appId`, `hostId` and
/// `operationId` are plain values with no foreign key.
///
/// Behaviour:
/// - Written by src/lib/hostOperations/hostKey.ts. A use that changes something is recorded in the caller's
///   transaction, so it commits exactly when the use does. A read, or a call that was refused, is recorded in
///   a write of its own, so the refused call's rollback keeps it; `refusedCode` is then the refusal's code.
/// - `action` says what the key did, for example `register`, `collect`, `report`, `availability`, `read` or
///   `session` (the full set is `HostKeyAction` in that file). `operationId` names the operation a report was
///   about, and `count` how many operations a collection returned or workers a registration listed.
/// - Only whoever manages the App can read what its keys did
///   (src/api/graphql/schema/resolvers.hostOperation.ts).
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:070:07. Background: #1709, #1881.
model HostKeyUse {
  id          String   @id
  appKeyId    String   @map("app_key_id")
  appId       String   @map("app_id")
  hostId      String   @map("host_id")
  /// `register` | `collect` | `report` | `availability` | `read` (#1881: the
  /// App's host registrations or host-operations listing, read with the key;
  /// #2931: its host's tickers, `count` the rows returned) |
  /// `session` (#1969: a refused session write, always with a refusedCode; #4292: also
  /// endAgentlessSession, accepted with refusedCode null and `count` 1 when it ended the session, else 0).
  action      String
  operationId String?  @map("operation_id")
  count       Int?
  /// #1881 (hrn:node:hadronmemory.com:specs:cor:agt:070:07, Holger #10849): the refusal's code when the call
  /// was refused, written apart from the refused call so its rollback keeps it.
  refusedCode String?  @map("refused_code")
  usedAt      DateTime @default(now()) @map("used_at")

  appKey AppKey @relation(fields: [appKeyId], references: [id], onDelete: Cascade)

  @@index([appKeyId, usedAt])
  @@map("host_key_uses")
}

/// The current consent for one manually started run: the record of exactly which automation a person approved
/// that run to execute. An automation is the set of flow nodes and edges a run walks, plus the identities of the
/// model and tool registrations it uses; the pin holds their hashes. A schedule or a webhook keeps its consent on
/// its own row (`automationPin`); a manual run has no trigger row, so its consent lives here.
///
/// Relationships: one row per AppRun (`runId` is the primary key) and deleted with it. `adoptedBy` is the id of
/// the user who approved, stored as a plain value.
///
/// Behaviour:
/// - Creating a manual run writes the row with the pin captured at launch (src/jobs/appRuns.ts).
/// - Approving or re-adopting the run's automation replaces `pin` and stamps `adoptedAt` and `adoptedBy`;
///   declining an adopted one deletes the row. Both go through the adoption door in
///   src/api/graphql/schema/resolvers.automationPin.ts, which writes an AutomationAdoptionEvent in the same
///   transaction.
/// - The row can change, while `AppRun.automationPin` is the snapshot taken when the run was created and never
///   changes. That is why the two are kept apart.
/// - A run started by an event that traces back to a manual run takes its pin from here, so it runs under the
///   consent as it is now (`currentOriginPin`, src/lib/automation/pins.ts).
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:010:01. Background: #1719, #2438, #2441.
model ManualAutomationPin {
  runId     String   @id @map("run_id")
  pin       Json
  adoptedAt DateTime @default(now()) @map("adopted_at")
  adoptedBy String?  @map("adopted_by")
  run       AppRun   @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("manual_automation_pins")
}

/// A named wake schedule that one team App owns. A ticker fires at a fixed cadence, and each time it fires it
/// may wake the workers subscribed to it, so that they look at their team channel or do a regular piece of work.
///
/// How the pieces fit: a ticker fires on its cadence; a TickerSubscription says which worker it wakes; the caller
/// that delivers wakes (a host's App key, the worker's holder or whoever manages the App) reads the wakes that
/// are due, delivers them and acknowledges them; WorkerDeliveryTick records the last tick acknowledged for a
/// worker; AppWakeDay counts the acknowledged wakes against the App's daily budget.
///
/// Relationships: belongs to one App and is deleted with it. Has many TickerSubscription and WorkerDeliveryTick
/// rows. The owner is exactly one of a user (`ownerUserId`) or a Worker (`ownerWorkerId`); both are plain ids.
/// `sourceTemplateId` names the AgentTickerTemplate a generated ticker was made from, as a plain id with no
/// foreign key, so that removing a template never reaches the tickers made from it.
///
/// Behaviour:
/// - Ticks are computed, never stored: tick k falls at `anchorAt` plus k times `cadenceSeconds`
///   (hrn:node:hadronmemory.com:specs:cor:agt:080:06). The cadence is at most one day.
/// - `reasons` says when a tick wakes a subscriber: `read-team-channel` (there is relevant unread in the
///   ticker's channels), `every-tick` (always) or `live-check` (the worker has not checked its team channel
///   within the cadence). Any one is enough; a ticker with no reasons never fires. `quietHours` and `enabled`
///   switch firing off.
/// - The name is unique among the App's live tickers, ignoring case, and can be reused after a delete (partial
///   index `tickers_app_name_live_uniq`). The slug is permanent: unique within the App for ever, deleted rows
///   included (`tickers_app_slug_uniq`), so a re-created `engineering` gets `engineering-2`.
/// - The owner is taken from the caller that creates the ticker, never from an argument (CHECK
///   `chk_tickers_shape`, prisma/ticker-invariants.sql).
/// - Deleting is a soft delete (`deletedAt`) that also ends the ticker's live subscriptions.
/// - Casting a Worker from an Agent creates one ticker per AgentTickerTemplate of that Agent, owned by the new
///   worker. Such a ticker carries `sourceTemplateId`, `sourceTemplateRevision` and `generatedForWorkerId`, all
///   three or none, and there is at most one live generated ticker per worker and template (partial index
///   `tickers_generated_live_uniq`).
/// - Tickers are created, edited and deleted through src/api/graphql/schema/resolvers.ticker.ts and read by the
///   due-wake calculation (src/lib/tickers/dueWakes.ts).
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:080:01. Background: #1747, #2024, #2096.
model Ticker {
  id                String    @id @default(cuid())
  appId             String    @map("app_id")
  name              String
  slug              String
  /// Permanent action-register code, snapped from the template name for generated tickers.
  tickCode          String    @map("tick_code")
  cadenceSeconds    Int       @map("cadence_seconds")
  anchorAt          DateTime  @default(now()) @map("anchor_at")
  /// `{ timezone, windows: [{ days: [1..7], from: "22:00", to: "07:00" }] }`.
  quietHours        Json?     @map("quiet_hours")
  /// Null = every channel the subscriber watches. Not a grant (hrn:node:hadronmemory.com:specs:cor:agt:080:01).
  channelIds        String[]  @default([]) @map("channel_ids")
  /// 'ALL' | 'MENTIONS'.
  relevance         String    @default("ALL")
  /// #2068 (hrn:node:hadronmemory.com:specs:cor:agt:080:01, hrn:node:hadronmemory.com:specs:cor:agt:080:10, R49): why the ticker fires, a closed set: 'read-team-channel' (relevant unread, as before) and
  /// 'every-tick' (unconditional), and 'live-check' (#2138: the worker has not checked its team channel within the ticker's cadence,
  /// whatever is unread; never for a worker not expected to check). Empty = never fires; any-of when several (R54).
  reasons           String[]  @default(["read-team-channel"]) @map("reasons")
  enabled           Boolean   @default(true)
  ownerUserId       String?   @map("owner_user_id")
  ownerWorkerId     String?   @map("owner_worker_id")
  /// #2024 (S8): set only on a ticker the platform generated at cast from an Agent ticker template. The template
  /// is a plain reference (no FK, so removing a template never cascades into runtime state) and the revision is
  /// the one the ticker was made from; `generatedForWorkerId` is the worker it was made for. A partial unique
  /// (generatedForWorkerId, sourceTemplateId) over live rows makes a retried cast unable to mint a second live instance.
  sourceTemplateId       String? @map("source_template_id")
  sourceTemplateRevision Int?    @map("source_template_revision")
  generatedForWorkerId   String? @map("generated_for_worker_id")
  /// #2429 (hrn:node:hadronmemory.com:specs:cor:dmo:050:11): set by every accepted `updateTicker` on a GENERATED ticker, whatever the fields and even when
  /// the values end up unchanged (it fails toward blocking). An edited generated ticker is no longer the cast's own
  /// bookkeeping, so it counts as a reference and blocks the miscast repair. Soft-deletes are not edits.
  editedAt               DateTime? @map("edited_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by")
  createdByWorkerId String?   @map("created_by_worker_id")
  createdByAgentId  String?   @map("created_by_agent_id")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")
  updatedByWorkerId String?   @map("updated_by_worker_id")
  updatedByAgentId  String?   @map("updated_by_agent_id")
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by")
  deletedByWorkerId String?   @map("deleted_by_worker_id")
  deletedByAgentId  String?   @map("deleted_by_agent_id")

  app           App                  @relation(fields: [appId], references: [id], onDelete: Cascade)
  subscriptions TickerSubscription[]
  deliveryTicks WorkerDeliveryTick[]

  @@unique([appId, slug], map: "tickers_app_slug_uniq")
  // #2096: ONE LIVE generated ticker per (worker, template) — enforced by the PARTIAL unique index
  // `tickers_generated_live_uniq WHERE generated_for_worker_id IS NOT NULL AND deleted_at IS NULL` (raw SQL: the
  // 20261030120000 migration + prisma/ticker-generated-live-unique.sql via post-push.sql + src/test/globalSetup.ts,
  // which must stay in sync). A @@unique would be non-partial and make a soft-deleted generated ticker block its
  // recreation by the apply operation (the slack_connections / apps_urn_active_uniq precedent).
  @@index([generatedForWorkerId, sourceTemplateId], map: "tickers_generated_idx")
  @@index([appId, deletedAt])
  @@map("tickers")
}

/// One ticker that an Agent declares for every worker cast from it, for example a 10-minute base tick. The
/// template lives on the Agent, so that casting a worker into any App gives the worker its tickers with no setup
/// in that App.
///
/// Relationships: belongs to one Agent and is deleted with it. A Ticker made from a template records the
/// template's id and revision (`Ticker.sourceTemplateId`, `Ticker.sourceTemplateRevision`) as plain values, not
/// as a foreign key.
///
/// Behaviour:
/// - Casting a Worker from the Agent creates one Ticker per live template, owned by the new worker, and
///   subscribes the worker to it, in the cast's own transaction
///   (hrn:node:hadronmemory.com:specs:cor:agt:080:34). It is a snapshot: a later edit or removal of the template
///   reaches only later casts.
/// - `cadenceSeconds` is the cadence asked for; the cast raises it to the App's minimum cadence when it is
///   faster.
/// - A template is identified by `id`, never by its name or position. `revision` counts edits, and a writer that
///   sends an older revision is refused. `shapeVersion` names the shape of the row; only shape 1 exists.
/// - Live names are unique within the Agent, ignoring case. `reasons` holds at least one value from the closed
///   set a Ticker uses. Both, and the other bounds, are CHECKs and an index in
///   prisma/agent-ticker-template-invariants.sql.
/// - Removing a template is a soft delete; the row stays because generated tickers still name it.
/// - Written by whoever may edit the Agent (src/api/graphql/schema/resolvers.agentTickerTemplate.ts).
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:080:33. Background: #2024.
model AgentTickerTemplate {
  id             String    @id @default(cuid())
  agentId        String    @map("agent_id")
  revision       Int       @default(1)
  shapeVersion   Int       @default(1) @map("shape_version")
  name           String
  /// Requested cadence; the cast clamps it up to the App's floor (R92).
  cadenceSeconds Int       @map("cadence_seconds")
  quietHours     Json?     @map("quiet_hours")
  /// 'ALL' | 'MENTIONS'.
  relevance      String    @default("ALL")
  /// Closed set, non-empty: 'read-team-channel' | 'every-tick' | 'live-check' (a template with none would never fire).
  reasons        String[]  @default(["read-team-channel"]) @map("reasons")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, deletedAt])
  @@map("agent_ticker_templates")
}

/// One worker's subscription to one ticker: it says that the ticker's ticks may wake this worker. Without a live
/// subscription a ticker never wakes a worker.
///
/// Relationships: joins Ticker and Worker. Only the hard delete of the ticker or the worker row removes it;
/// otherwise a subscription is ended and its row is kept (see Behaviour). The worker must belong to the ticker's
/// App (trigger `trg_ticker_subscriptions_same_app`, prisma/ticker-invariants.sql). `viaGrantId` and
/// `viaGrantPersonId`, and their `ended…` twins, are plain ids that record that the change was made by a worker
/// using its AppGrant, and which person was behind that worker's session.
///
/// Behaviour:
/// - There is at most one live row per ticker and worker (partial index `ticker_subscriptions_live_uniq`). A row
///   is live while `endedAt` is null.
/// - Rows are history: a subscription is ended, never deleted. `endedReason` is `UNSUBSCRIBED`, `WORKER_RETIRED`
///   or `TICKER_DELETED`. A worker going quiet never ends a subscription.
/// - Written by the subscribe and unsubscribe calls, by deleting a ticker, by retiring a worker, and by the cast
///   that subscribes a new worker to the tickers generated for it.
/// - Read by the due-wake calculation (src/lib/tickers/dueWakes.ts) and the worker's check status.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:080:02. Background: #1747.
model TickerSubscription {
  id                    String    @id @default(cuid())
  tickerId              String    @map("ticker_id")
  workerId              String    @map("worker_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  createdBy             String?   @map("created_by")
  createdByWorkerId     String?   @map("created_by_worker_id")
  createdByAgentId      String?   @map("created_by_agent_id")
  viaGrantId            String?   @map("via_grant_id")
  viaGrantPersonId      String?   @map("via_grant_person_id")
  endedAt               DateTime? @map("ended_at")
  endedBy               String?   @map("ended_by")
  endedByWorkerId       String?   @map("ended_by_worker_id")
  endedByAgentId        String?   @map("ended_by_agent_id")
  endedViaGrantId       String?   @map("ended_via_grant_id")
  endedViaGrantPersonId String?   @map("ended_via_grant_person_id")
  endedReason           String?   @map("ended_reason")

  ticker Ticker @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([tickerId])
  @@map("ticker_subscriptions")
}

/// One worker's own wake settings: whether a mention wakes it at once, and an optional pause during which
/// nothing wakes it.
///
/// Relationships: at most one row per Worker (`workerId` is the primary key), deleted with it. The `updatedBy…`
/// columns are plain ids of who made the last change.
///
/// Behaviour:
/// - The row is created on the first change (`setWorkerWakeSettings`); a worker with no row has the defaults.
/// - `mentions` is `IMMEDIATE` or `OFF` (CHECK `chk_worker_wake_settings_shape`). There is no setting that holds
///   mentions back until the next tick.
/// - `pausedUntil` belongs to the worker, not to a session: it covers every session of that worker. A paused
///   worker is due no wake (hrn:node:hadronmemory.com:specs:cor:agt:080:11).
/// - `exemptEndedAt` records when a running pause was ended on purpose, because clearing `pausedUntil` erases
///   the only time that said when the pause ended. The name comes from what a pause is to the alarms: a paused
///   worker is exempt from them, and this is when that exemption ended.
/// - Changed by the worker itself, its holder or whoever manages the App. Read by the due-wake calculation, the
///   worker's check status and the roster.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:080:03. Background: #1747, #2755.
model WorkerWakeSettings {
  workerId          String    @id @map("worker_id")
  mentions          String    @default("IMMEDIATE")
  pausedUntil       DateTime? @map("paused_until")
  /// #2755 — when an ACTIVE pause was ended on purpose (clearPause), which erases
  /// the only timestamp that said when the exemption ended. Natural expiry needs none (its own end stays stored).
  exemptEndedAt     DateTime? @map("exempt_ended_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")
  updatedByWorkerId String?   @map("updated_by_worker_id")
  updatedByAgentId  String?   @map("updated_by_agent_id")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_wake_settings")
}

/// How far the messages of one channel have been delivered to one worker: the sequence number of the newest
/// message whose text reached it. It is what stops the same messages being delivered to the worker twice.
///
/// Relationships: one row per Worker and channel (the primary key), deleted with the worker. `channelId` is a
/// plain id with no foreign key. The `ackedBy…` columns are plain ids of who acknowledged the newest delivery: a
/// person, the worker whose session it was, or an App key.
///
/// Behaviour:
/// - `deliveredThroughSeq` only rises. It starts again only when the channel is recreated, which
///   `channelIncarnation` records.
/// - The one writer is `raiseDeliveryMark` (src/lib/workerMarks.ts). It runs when a delivery that carried the
///   messages' text is acknowledged, and when the worker reads its own mentions.
/// - Acknowledging a wake that carried no text does not move it; that is recorded in WorkerWakeAck.
/// - What is still waiting for a worker is worked out from the messages above this mark and its read position;
///   there is no stored list of waiting messages.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:080:04. Rule:
/// hrn:node:hadronmemory.com:specs:cor:agt:080:16. Background: #1747, #2017, #2018, #2072.
model WorkerDeliveryChannel {
  workerId            String   @map("worker_id")
  channelId           String   @map("channel_id")
  channelIncarnation  Int      @default(0) @map("channel_incarnation")
  deliveredThroughSeq Int      @map("delivered_through_seq")
  deliveredAt         DateTime @map("delivered_at")
  /// Who acknowledged the newest wake (hrn:node:hadronmemory.com:specs:cor:agt:080:16): a person, a worker's
  /// session behind them, or a bare App key (S3).
  ackedByUserId       String?  @map("acked_by_user_id")
  ackedByWorkerId     String?  @map("acked_by_worker_id")
  ackedByAppKeyId     String?  @map("acked_by_app_key_id")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([workerId, channelId])
  @@map("worker_delivery_channels")
}

/// The receipt that one wake was delivered to one worker. A wake is a nudge that carries no message text, so
/// acknowledging it moves no message mark; this row is what the acknowledgement records instead.
///
/// Relationships: one row per Worker and wake key (the primary key), deleted with the worker. `wakeKey`
/// identifies the wake: a hash of the channel ranges, ticks and task events it named. The `ackedBy…` columns are
/// plain ids of who acknowledged: a person, a worker's session or an App key.
///
/// Behaviour:
/// - Written only by `acknowledgeWakes` (src/lib/tickers/acknowledge.ts).
/// - `ackedAt` is the clock for the limit on how often a worker can be woken
///   (hrn:node:hadronmemory.com:specs:cor:agt:080:13): the next wake waits until the App's minimum cadence has
///   passed since the newest receipt.
/// - The row also decides whether an acknowledgement counts as a new delivery, and so whether it is charged to
///   the App's daily budget (hrn:node:hadronmemory.com:specs:cor:agt:080:15). It is rewritten only by a wake
///   issued after both `ackedAt` and `issuedAt`. A repeated acknowledgement, or one for an older wake, changes
///   nothing. The same wake offered again later counts again.
/// - `issuedAt` is the issue time of the wake that was accepted. It is null on rows written before the column
///   existed; for those the comparison uses `ackedAt`.
/// - When a later wake absorbed earlier ones, their keys get this receipt too, so that a late acknowledgement
///   of an earlier wake is not charged again.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:080:04. Background: #2072, #2069, #3022.
model WorkerWakeAck {
  workerId        String   @map("worker_id")
  wakeKey         String   @map("wake_key")
  ackedAt         DateTime @map("acked_at")
  /// #3022: issue time that spent/covered this key; absorbed keys inherit the descendant's issue time.
  /// NULL is an old writer's receipt: replay comparison falls back to ackedAt.
  issuedAt        DateTime? @map("issued_at")
  ackedByUserId   String?  @map("acked_by_user_id")
  ackedByWorkerId String?  @map("acked_by_worker_id")
  ackedByAppKeyId String?  @map("acked_by_app_key_id")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([workerId, wakeKey])
  @@index([workerId, ackedAt])
  @@map("worker_wake_acks")
}

/// The last tick of one ticker that was delivered to one worker and acknowledged. It is what stops the same
/// tick waking the worker twice, and it records whether the worker answered the wake by checking its channel.
///
/// Relationships: one row per Worker and Ticker (the primary key), deleted with either. The `ackedBy…` columns
/// are plain ids of who acknowledged: a person, a worker's session or an App key.
///
/// Behaviour:
/// - Written by `acknowledgeWakes` (src/lib/tickers/acknowledge.ts) for each tick the acknowledged wake named.
///   `lastAckedTick` is the tick's number and only rises; `ackedAt` and the `ackedBy…` columns change only when
///   it rises.
/// - `respondedAt` is when the worker last checked a channel the ticker covers after that wake was issued, and
///   null until it does. The channel check writes it (src/lib/channelReadState.ts) and a newer delivery clears
///   it, unless the response was made at or after the newer wake was issued, in which case it is kept as that
///   wake's response (src/lib/tickers/acknowledge.ts). The worker's check status reads it to decide whether the
///   worker is overdue
///   (hrn:node:hadronmemory.com:specs:cor:agt:100:03).
/// - The due-wake calculation reads the row to find the oldest tick not yet acknowledged.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:080:04. Background: #1747, #3509, #3680.
model WorkerDeliveryTick {
  workerId        String   @map("worker_id")
  tickerId        String   @map("ticker_id")
  lastAckedTick   Int      @map("last_acked_tick")
  ackedAt         DateTime @map("acked_at")
  ackedByUserId   String?  @map("acked_by_user_id")
  ackedByWorkerId String?  @map("acked_by_worker_id")
  ackedByAppKeyId String?  @map("acked_by_app_key_id")
  /// #3509 (hrn:node:hadronmemory.com:specs:cor:agt:100:03, hrn:node:hadronmemory.com:specs:cor:agt:080:04): when the worker last CHECKED a channel this ticker covers after the wake
  /// `ackedAt` records; null = not yet. Written by the check (DB clock), cleared by a newer delivery. Latest wake only.
  respondedAt     DateTime? @map("responded_at")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  ticker Ticker @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@id([workerId, tickerId])
  @@map("worker_delivery_ticks")
}

/// The receipt that the nudge for one team event reached one worker. Team events are things such as a task
/// being assigned, a stall alarm or a stop-signal notice; each one that should wake a worker stays due until
/// this row says it was delivered.
///
/// Relationships: one row per Worker, AgentTeamEvent and `chainIndex` (the primary key), deleted with the
/// worker or the event. The `ackedBy…` columns are plain ids of who acknowledged the delivery.
///
/// Behaviour:
/// - `chainIndex` is 0 for an ordinary event. For an alarm it is the position, in the alarm's chain of owners,
///   of the worker that was woken.
/// - `deliveredAt` is set only by `acknowledgeWakes`, from a wake that named the event, and only once.
/// - It is a receipt of delivery and never an acknowledgement of the alarm: acknowledging an alarm is a
///   separate act that stops its escalation (hrn:node:hadronmemory.com:specs:cor:agt:050:20).
/// - `undeliverableAt` is set by the stall evaluator when the worker is dormant, with `undeliverableReason`
///   `dormant` (hrn:node:hadronmemory.com:specs:cor:agt:080:11). A later delivery still sets `deliveredAt`.
/// - Stop-signal notices are delivered through the same receipt, at `chainIndex` 0
///   (hrn:node:hadronmemory.com:specs:cor:agt:090:04).
///
/// Background: #1708, #2022.
model WorkerDeliveryTaskEvent {
  workerId            String    @map("worker_id")
  eventId             String    @map("event_id")
  chainIndex          Int       @default(0) @map("chain_index")
  deliveredAt         DateTime? @map("delivered_at")
  ackedByUserId       String?   @map("acked_by_user_id")
  ackedByWorkerId     String?   @map("acked_by_worker_id")
  ackedByAppKeyId     String?   @map("acked_by_app_key_id")
  undeliverableAt     DateTime? @map("undeliverable_at")
  /// 'dormant' — the only reason this slice records.
  undeliverableReason String?   @map("undeliverable_reason")

  worker Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  event  AgentTeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([workerId, eventId, chainIndex])
  @@index([workerId, deliveredAt])
  @@index([eventId])
  @@map("worker_delivery_task_events")
}

/// The count of wakes delivered in one App on one UTC day. Each App has a daily wake budget; this row is the
/// counter the budget is checked against.
///
/// Relationships: one row per App and day (the primary key), deleted with the App.
///
/// Behaviour:
/// - `wakes` rises by one each time `acknowledgeWakes` records a delivered wake that is not exempt. A wake is
///   exempt when a mention by whoever manages the App caused it.
/// - When the budget is spent, further wakes are withheld and stay due. The platform then posts one notice in
///   the App's team chat for that day; `noticePostedAt` is the claim that makes it one. The claim is taken in
///   the same transaction as the post (src/api/graphql/schema/resolvers.wake.ts).
/// - The due-wake calculation adds this count to the App's outstanding AppWakeReservation rows before it hands
///   out a wake.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:080:15. Background: #1748.
model AppWakeDay {
  appId          String    @map("app_id")
  day            DateTime  @map("day") @db.Date
  wakes          Int       @default(0)
  noticePostedAt DateTime? @map("notice_posted_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, day])
  @@map("app_wake_days")
}

/// A wake that was handed out for one worker and has not been acknowledged yet. It holds a place in the App's
/// daily wake budget until the wake is acknowledged or lapses, so that callers reading at the same time cannot
/// between them hand out more wakes than the budget allows.
///
/// Relationships: at most one row per Worker (`workerId` is the primary key); belongs to the worker's App and is
/// deleted with either.
///
/// Behaviour:
/// - The due-wake read writes the row when it issues a wake that is not exempt from the budget
///   (src/lib/tickers/dueWakes.ts). It counts against the day's budget for 15 minutes from `reservedAt`, which
///   is as long as the wake can still be acknowledged.
/// - `wake` is the wake itself. A second read inside that time hands out the same wake again, exactly.
/// - `wakeKey` identifies the wake (see WorkerWakeAck). An acknowledgement removes only the reservation that
///   carries its own key, so an old wake acknowledged late cannot cancel the place a newer wake holds.
/// - `absorbedKeys` lists earlier wakes that this one took in when another reason fell due. They share this one
///   place in the budget and are not charged again (hrn:node:hadronmemory.com:specs:cor:agt:080:12).
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:080:15. Background: #1748, #2069.
model AppWakeReservation {
  workerId     String   @id @map("worker_id")
  appId        String   @map("app_id")
  reservedAt   DateTime @map("reserved_at")
  /// Which wake it was reserved for (the proof's channels, seqs and ticks, hashed): an acknowledgement spends only the
  /// reservation of the wake it delivers, so an old proof replayed cannot cancel a newer wake's allowance.
  wakeKey      String   @map("wake_key")
  /// The wake itself, so an outstanding one is handed out again, exactly, until it is consumed or lapses.
  wake         Json     @map("wake")
  /// #2069: the wake keys this reservation absorbed (a tick or task that fell due after them). An earlier proof whose key
  /// is listed shares this reservation's allowance and is not charged again; any other proof is unrelated to it.
  absorbedKeys String[] @default([]) @map("absorbed_keys")

  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([appId, reservedAt])
  @@map("app_wake_reservations")
}

/// An instruction to stop work, kept in a team App, that the platform enforces for the workers it covers until
/// it ends. It is how a person stops one worker, a whole team or everything on one host.
///
/// Relationships: belongs to one App. A signal of scope `worker` or `team` names a Worker (`targetWorker`; a
/// team is named by the worker at its head); a signal of scope `host` names a HostRegistration (`targetHost`).
/// The row is deleted with its App or its target. It has many TeamStopCoverage rows. `setByUserId`,
/// `setByAppKeyId`, `endedByUserId` and `endedByAppKeyId` are plain ids.
///
/// Behaviour:
/// - `level` is `pause-dispatch`, `pause` or `halt`; `scope` is `worker`, `team` or `host`. The target must
///   belong to the signal's App (trigger `trg_team_stop_signals_same_app`).
/// - It is set by exactly one of a person or a host's App key, never both. Whoever manages the App may set any
///   signal; a host key may set only a `halt` on its own host.
/// - It is live while `endedAt` is null and `until`, when given, has not passed. At `until` the signal has
///   ended, even before the sweep records it (hrn:node:hadronmemory.com:specs:cor:agt:090:05).
/// - The level, scope, target, setter, set time and `until` never change. The end is recorded once: `endKind`
///   is `lifted` (with who lifted it) or `expired`. A trigger enforces both
///   (prisma/stop-signal-invariants.sql).
/// - Several live signals can cover one worker, and each applies. Which workers a signal covers is worked out
///   each time it is checked (hrn:node:hadronmemory.com:specs:cor:agt:090:02).
/// - The row holds no free text.
/// - Written by src/lib/stopSignals/lifecycle.ts; read on every assignment, tick and stall pass.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:090:01. Background: #2022.
model TeamStopSignal {
  id                       String    @id
  appId                    String    @map("app_id")
  level                    String
  scope                    String
  targetWorkerId           String?   @map("target_worker_id")
  targetHostRegistrationId String?   @map("target_host_registration_id")
  setAt                    DateTime  @map("set_at")
  until                    DateTime?
  setByUserId              String?   @map("set_by_user_id")
  setByAppKeyId            String?   @map("set_by_app_key_id")
  endedAt                  DateTime? @map("ended_at")
  /// `lifted` | `expired`.
  endKind                  String?   @map("end_kind")
  endedByUserId            String?   @map("ended_by_user_id")
  endedByAppKeyId          String?   @map("ended_by_app_key_id")

  app          App                @relation(fields: [appId], references: [id], onDelete: Cascade)
  targetWorker Worker?            @relation(fields: [targetWorkerId], references: [id], onDelete: Cascade)
  targetHost   HostRegistration?  @relation(fields: [targetHostRegistrationId], references: [id], onDelete: Cascade)
  coverage     TeamStopCoverage[]

  @@index([appId, setAt, id])
  @@index([targetWorkerId])
  @@index([targetHostRegistrationId])
  @@map("team_stop_signals")
}

/// The latest time at which the caller that delivers wakes for one serving lane of an App said that it also
/// delivers stop-signal notices. A stop signal may be set only while every worker it would cover is on a lane
/// with a recent declaration, so that no worker is stopped without being told.
///
/// Relationships: one row per App and lane (the primary key), deleted with the App. `lane` is deliberately not a
/// foreign key: it is either the id of a HostRegistration or the literal `unhosted`, and a row left behind by a
/// deleted registration is never read.
///
/// Behaviour:
/// - A due-wake read that passes `accepts: [STOP]` and covers its whole lane upserts the row
///   (`recordStopConsumerDeclaration`, src/lib/stopSignals/delivery.ts). A host's App key declares the lane of
///   its own live registration. A key that is not a host key, and a person who manages the App, declare
///   `unhosted`, the lane of the workers that no live registration lists.
/// - A declaration counts for STOP_CONSUMER_FRESH_SECONDS (600 by default). Setting a stop signal is refused
///   while any worker it would cover has no lane with a declaration that recent
///   (hrn:node:hadronmemory.com:specs:cor:agt:090:04).
/// - Enforcing a stop signal never reads this table.
///
/// Background: #2169.
model StopConsumerDeclaration {
  appId      String   @map("app_id")
  lane       String
  declaredAt DateTime @map("declared_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, lane])
  @@map("stop_consumer_declarations")
}

/// One period during which one stop signal covered one worker. The rows are the history of who was stopped and
/// when; the stall clocks and the notices need that history after the fact.
///
/// Relationships: belongs to one TeamStopSignal and is deleted with it. `workerId` and `appId` are plain ids
/// with no foreign key.
///
/// Behaviour:
/// - Enforcement never reads these rows: whether a signal covers a worker now is worked out live from the
///   reporting lines and the host registration (hrn:node:hadronmemory.com:specs:cor:agt:090:02).
/// - `reconcileStopCoverage` (src/lib/stopSignals/lifecycle.ts) is the only writer. Under the App's stop lock it
///   compares live coverage with the open periods, closes the ones that no longer hold (`leftAt`), opens the
///   new ones, and sends each worker the notice for the change.
/// - There is at most one open period per signal and worker (partial index `team_stop_coverage_open_uniq`,
///   prisma/stop-signal-invariants.sql).
/// - A period ends at the earliest of `leftAt`, the signal's end and the signal's `until`.
/// - Read by the stall rules, which do not count stopped time, and by the worker's check status.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:090:04. Background: #2022.
model TeamStopCoverage {
  id        String    @id
  appId     String    @map("app_id")
  signalId  String    @map("signal_id")
  workerId  String    @map("worker_id")
  enteredAt DateTime  @map("entered_at")
  leftAt    DateTime? @map("left_at")

  signal TeamStopSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([workerId, enteredAt])
  @@index([signalId])
  @@index([appId])
  @@map("team_stop_coverage")
}

/// The latest result of trying to match a queued task to a worker, for one App and one combination of model
/// family, tier and role. It tells readers whether tasks that ask for that combination are finding a worker.
///
/// Relationships: one row per App and combination (the primary key), deleted with the App. A dimension that the
/// task's requirements leave open is stored as the empty string, so that the key holds no null.
///
/// Behaviour:
/// - The matcher upserts the row each time a match reaches a result (`recordMatchOutcome`,
///   src/lib/agentTasks/matchOutcomes.ts), for every combination the task's requirements name. There is no log
///   of earlier outcomes, and nothing is kept per candidate worker.
/// - `outcome` is `MATCHED` or `NO_WORKER`; `reason` is the coarse reason of a `NO_WORKER`.
/// - `failingSince` is the first `NO_WORKER` of the current run of failures; a `MATCHED` clears it.
///   `lastMatchedAt` orders outcomes that arrive late.
/// - Times come from the database clock, at microsecond precision.
/// - The matcher's sweep deletes rows older than 168 hours.
/// - `latestMatchOutcomes` is the only read. No resolver calls it yet.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:060:13. Background: #3825, #3883.
model AgentMatchOutcome {
  appId         String    @map("app_id")
  family        String    @default("")
  tier          String    @default("")
  role          String    @default("")
  /// 'MATCHED' | 'NO_WORKER'.
  outcome       String
  /// The coarse MatchFailureReason of a NO_WORKER outcome; null for MATCHED.
  reason        String?
  /// Database clock, microseconds (a stamp is never truncated to a millisecond, so two decisions rarely tie).
  decidedAt     DateTime  @map("decided_at") @db.Timestamp(6)
  failingSince  DateTime? @map("failing_since") @db.Timestamp(6)
  /// The newest MATCHED decision seen, including one that arrived after a newer outcome; it orders late writes against
  /// the streak (#3825 follow-up). The migration seeds a pre-existing NO_WORKER row with its latest failure instead: the
  /// floor no older late failure joins (#3883). Never read outside `recordMatchOutcome`.
  lastMatchedAt DateTime? @map("last_matched_at") @db.Timestamp(6)

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, family, tier, role])
  @@index([decidedAt])
  @@map("agent_match_outcomes")
}

/// One period during which stop signals were the reason a queued task could not be assigned: every worker that
/// could otherwise take it was covered by a live stop signal, or the worker that created it was under a `pause`
/// or `halt`. The alarm for a task nobody could be assigned does not count this time.
///
/// Relationships: belongs to one AgentTask and is deleted with it. `appId` is a plain id.
///
/// Behaviour:
/// - The matcher opens and closes holds after each matching pass (`recordStopHolds`,
///   src/lib/agentTasks/matcher.ts): it opens one for each queued task that stop signals are holding back, and
///   closes the open hold of every other task.
/// - There is at most one open hold per task (partial index `agent_task_stop_holds_open_uniq`,
///   prisma/stop-signal-invariants.sql). A hold is open while `endedAt` is null.
/// - The stall rules read the holds and leave their time out of the wait that raises the alarm
///   (src/lib/agentTasks/stall.ts). A task that nobody can take for another reason keeps counting.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:050:17. Background: #2022.
model AgentTaskStopHold {
  id        String    @id
  appId     String    @map("app_id")
  taskId    String    @map("task_id")
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
  @@map("agent_task_stop_holds")
}

/// A narrow, named permission that whoever manages an App gives to one worker of that App, so that the worker
/// can do one kind of thing without managing the App. It is separate from Grant, the signed grant for a
/// registered action.
///
/// Relationships: belongs to one App and to one Worker (`grantee`), and is deleted with either. The worker must
/// be in the same App. `grantedBy` and `revokedBy` are plain user ids.
///
/// Behaviour:
/// - `name` comes from a closed list (CHECK `chk_app_grants_shape`, prisma/ticker-invariants.sql):
///   `ticker.subscribe-workers` lets the worker subscribe other workers to tickers, and lets its `@all` and
///   `@team` mentions wake everyone at once when a person is behind its session; `workers.staff` lets the
///   worker's session use the staffing calls, and `app.members` the member calls, without a per-call
///   instruction from its holder. In each case the holder must still have the right.
/// - There is at most one live row per App, worker and name (partial index `app_grants_live_uniq`). A row is
///   live while `revokedAt` is null; revoking keeps the row.
/// - Only whoever manages the App gives or revokes a grant, and giving is done by a person as themselves. A
///   retired worker cannot be given one.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:agt:080:24. Background: #1747, #3308.
model AppGrant {
  id              String    @id @default(cuid())
  appId           String    @map("app_id")
  granteeWorkerId String    @map("grantee_worker_id")
  name            String
  grantedAt       DateTime  @default(now()) @map("granted_at")
  grantedBy       String?   @map("granted_by")
  revokedAt       DateTime? @map("revoked_at")
  revokedBy       String?   @map("revoked_by")

  app     App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  grantee Worker @relation(fields: [granteeWorkerId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([granteeWorkerId])
  @@map("app_grants")
}

/// One extra permission that an App key holds. A plain App key cannot use certain calls; a scope switches one
/// group of them on for that key.
///
/// Relationships: belongs to one AppKey and is deleted with it. `grantedByUserId` and `revokedByUserId` are
/// plain user ids.
///
/// Behaviour:
/// - `scope` comes from a closed list (CHECK `chk_app_key_scopes_shape`, prisma/app-key-scope-invariants.sql):
///   `attention:deliver`, which reading and acknowledging due wakes require, and `host:operate`, which makes
///   the key a host key.
/// - `hostId` names the one host a `host:operate` scope is bound to. It is required for that scope and absent
///   for every other (hrn:node:hadronmemory.com:specs:cor:agt:070:04).
/// - A key holds a scope at most once (partial index `app_key_scopes_live_uniq`). A revoked row stays as the
///   record of who gave the scope and who took it back.
/// - Only whoever manages the App gives or revokes a scope. A new key holds none, and a rotated key is a new
///   key.
/// - Every call that a scope gates reads the row from the database at that call; it is never cached in the
///   request's credentials. A revocation therefore takes effect at the key's next call
///   (hrn:node:hadronmemory.com:specs:cor:aut:010:04).
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:aut:010:03. Background: #1749, #1709.
model AppKeyScope {
  id              String    @id
  appKeyId        String    @map("app_key_id")
  scope           String
  grantedByUserId String    @map("granted_by_user_id")
  grantedAt       DateTime  @default(now()) @map("granted_at")
  revokedByUserId String?   @map("revoked_by_user_id")
  revokedAt       DateTime? @map("revoked_at")
  /// #1709 — the one host a `host:operate` scope is bound to (hrn:node:hadronmemory.com:specs:cor:agt:070:04):
  /// required for that scope, absent for every other (chk_app_key_scopes_shape).
  hostId          String?   @map("host_id")

  appKey AppKey @relation(fields: [appKeyId], references: [id], onDelete: Cascade)

  @@index([appKeyId])
  @@map("app_key_scopes")
}

/// A record that an App key read the due wakes of its App: which key, how many workers the answer showed, and
/// when. It is the audit trail of what a key that delivers wakes has looked at.
///
/// Relationships: belongs to one AppKey and is deleted with it. `appId` is a plain id.
///
/// Behaviour: one row is written for every due-wake read an App key makes, also when nothing was due, in the
/// transaction that decides the key may be given the answer (`decideKeyAnswer`,
/// src/api/graphql/schema/resolvers.wake.ts). A read by a person writes no row. Nothing in the server reads
/// the table.
///
/// Rules: hrn:node:hadronmemory.com:specs:cor:agt:080:22, hrn:node:hadronmemory.com:specs:cor:agt:080:23.
/// Background: #1749.
model AppKeyWakeRead {
  id          String   @id
  appKeyId    String   @map("app_key_id")
  appId       String   @map("app_id")
  workerCount Int      @map("worker_count")
  readAt      DateTime @default(now()) @map("read_at")

  appKey AppKey @relation(fields: [appKeyId], references: [id], onDelete: Cascade)

  @@index([appKeyId, readAt])
  @@map("app_key_wake_reads")
}

/// A record that a platform administrator erased another user's account: who did it, whose account, the reason
/// given, and when.
///
/// Relationships: has at most one UserDeletionNotice. `actorUserId` and `targetUserId` are plain values,
/// deliberately not foreign keys, so that the record outlives everything the erasure deletes. There is at most
/// one row per erased account (`targetUserId` is unique).
///
/// Behaviour:
/// - Written by `deleteUserAccount` (src/controller/operations/deleteUser.ts) only when the caller gives a
///   reason, which is the case of an administrator erasing someone else. A user deleting their own account
///   writes no row.
/// - The row is written in the erasure's own SERIALIZABLE transaction, so the audit and the erasure commit or
///   roll back together.
/// - The table is append-only: a trigger refuses every update and delete (`user_deletion_audits_immutable`,
///   prisma/post-push.sql). `reason` is trimmed and 1 to 500 characters long (CHECK).
/// - No API returns these rows.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:aut:020:03. Background: #1647.
model UserDeletionAudit {
  id           String   @id @map("id")
  actorUserId  String   @map("actor_user_id")
  targetUserId String   @unique @map("target_user_id")
  reason       String
  completedAt  DateTime @default(now()) @map("completed_at")

  notice UserDeletionNotice?

  @@map("user_deletion_audits")
}

/// Delivery state of the notice sent after an administrator erased a user's account: PENDING until sent, then
/// SENT, FAILED after the retries, or UNAVAILABLE when there is no address or no mail sender. See
/// UserDeletionNotice.
enum UserDeletionNoticeStatus {
  PENDING
  SENT
  FAILED
  UNAVAILABLE
}

/// The pending email that tells a user their account was erased by an administrator. The row is written with
/// the erasure and sent afterwards, so that the notice is not lost if sending fails at that moment.
///
/// Relationships: one row per UserDeletionAudit (`auditId` is the primary key), deleted with that audit row.
///
/// Behaviour:
/// - Written in the erasure's transaction, next to the audit row. The recipient's address is read before the
///   account is scrubbed and stored encrypted in `recipientCiphertext`. With no address the row starts as
///   `UNAVAILABLE`.
/// - A job sends the notice after the commit (src/jobs/sendUserDeletionNotices.ts): `PENDING` becomes `SENT`
///   when the mail provider accepts it, a failure is retried up to 3 times and then becomes `FAILED`, and with
///   no mail sender configured the row becomes `UNAVAILABLE`.
/// - `leaseUntil` and `claimToken` give one pass the exclusive right to send. Delivery is at least once: a
///   lease that runs out during a send can allow a second send.
/// - The ciphertext is cleared at every final state.
/// - The notice text never carries the reason recorded in the audit.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:aut:020:03. Background: #1647.
model UserDeletionNotice {
  auditId             String                   @id @map("audit_id")
  status              UserDeletionNoticeStatus @default(PENDING)
  recipientCiphertext String?                  @map("recipient_ciphertext")
  attempts            Int                      @default(0)
  /// Exclusive send lease: while `leaseUntil` is in the future only the holder of `claimToken` is sending.
  leaseUntil          DateTime?                @map("lease_until")
  claimToken          String?                  @map("claim_token")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  audit UserDeletionAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("user_deletion_notices")
}

/// A version counter per worker, used only to make two kinds of transaction collide: one that writes a new
/// reference to a worker, and one that deletes that worker. It is internal coordination data, not a record of
/// anything.
///
/// Relationships: none. `subjectId` is a Worker id stored as a plain value, with no foreign key, and the row is
/// kept after the worker is deleted.
///
/// Behaviour:
/// - A trigger on each table that can name a worker (`worker_reference_fence_1162`,
///   prisma/worker-reference-invariants.sql) raises `version` when a row starts to name a worker, a session of a
///   worker or a worker's working memory, and then refuses the write if that worker does not exist.
/// - Deleting a worker that was cast by mistake raises the same counter after it locks the worker
///   (src/api/graphql/schema/resolvers.worker.ts). The two writes touch the same row, so a writer that started
///   before the deletion cannot commit a reference to a worker that is gone.
/// - No API reads or returns the table.
///
/// Specs: hrn:node:hadronmemory.com:specs:cor:dmo:050:11 (a worker that is referenced is never hard deleted).
/// Background: #1162.
model WorkerReferenceFence {
  subjectId String @id @map("subject_id")
  version   BigInt @default(0)

  @@map("worker_reference_fences")
}

/// What a boot prompt was served to: a worker session at its bind (BIND), a chatbot chat (CHAT) or a headless
/// run (RUN). See ServedPrompt.
enum ServedPromptKind {
  BIND
  CHAT
  RUN
}

/// Which boot-prompt pointer supplied a served prompt: the worker's own, the installation's (APP_AGENT) or the
/// Agent's. See `ServedPrompt.pointerLevel`.
enum ServedPromptPointerLevel {
  WORKER
  APP_AGENT
  AGENT
}

/// A record of the boot prompt that one worker session, one chatbot chat or one headless run was given: which
/// compiled prompt, which revision of it, what that revision was compiled from, and the values the platform
/// variables were filled with. It lets a reader see later exactly what an agent was told.
///
/// Relationships: the owner is exactly one of a Session (`sessionId`, kind `BIND`), a chat node (`chatId`, kind
/// `CHAT`) or an AppRun (`runId`, kind `RUN`), and the record is deleted with its owner. Those foreign keys, and
/// the rule that the record's App, Agent and worker are its owner's own, are declared in SQL
/// (prisma/served-prompt-invariants.sql), not in this model. `agentId`, and `workerId` when a worker was served,
/// say whose prompt it was; `pointerLevel` says which boot-prompt pointer supplied it: the worker's own, the
/// installation's (`APP_AGENT`) or the Agent's. `compiledNodeId` is deliberately not a foreign key:
/// the record outlives a compiled node that is deleted and then shows the revision as pruned.
///
/// Behaviour:
/// - `recordServedPrompt` (src/lib/bootPrompt/serve.ts) writes the row in the transaction that creates the
///   owner.
/// - A bind and a run have one record. A chat records again, with the next `ordinal`, when its served revision
///   or its filled variables change.
/// - A revision is identified by `compiledNodeId` and `servedRevSeq` (`Node.revSeq`). `provenance` is copied
///   from that revision when it is served, so a later recompile never rewrites it.
/// - The record holds no prompt text and no derived blocks.
/// - It is immutable: a trigger refuses every update, and a delete is allowed only once the owner row is gone.
/// - `appId` is null only for a chat held in a memory that no App owns.
/// - Read by whoever may read the worker's internals or the run; for a chat, by whoever manages its App. The
///   pruning of node revisions also reads it: the revision an open session or an unfinished run was served is
///   kept.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:040:03. Background: #2047, #3096.
model ServedPrompt {
  id                  String                   @id
  kind                ServedPromptKind
  sessionId           String?                  @map("session_id")
  chatId              String?                  @map("chat_id")
  runId               String?                  @map("run_id")
  /// 1 for a bind or a run; a chat records again when its served revision or filled variables change (R37, #3096), counting up.
  ordinal             Int                      @default(1)
  /// Null only for a chat held in a memory no App owns (chk_served_prompts_app, prisma/served-prompt-app-invariants.sql).
  appId               String?                  @map("app_id")
  agentId             String                   @map("agent_id")
  workerId            String?                  @map("worker_id")
  pointerLevel        ServedPromptPointerLevel @map("pointer_level")
  compiledNodeId      String                   @map("compiled_node_id")
  servedRevSeq        Int                      @map("served_rev_seq")
  /// The compile revision that owns the provenance: the greatest compile revSeq at or below the served one (a
  /// metadata-only revision above a compile advances revSeq but not the provenance).
  provenanceRevSeq    Int                      @map("provenance_rev_seq")
  compiledContentHash String                   @map("compiled_content_hash")
  /// `[{nodeId, revSeq, hash}]`, read through its own cursor field, never in one response.
  provenance          Json                     @default("[]")
  variables           Json                     @default("{}")
  servedAt            DateTime                 @default(now()) @map("served_at")

  @@index([compiledNodeId, servedRevSeq])
  @@map("served_prompts")
}

/// A record that an Agent was cloned: who cloned it, which Agent was the source, which new Agent was made, for
/// which organization, and how much was copied.
///
/// Relationships: none by foreign key. `actorUserId`, `sourceAgentId`, `newAgentId`, `targetOrgId` and
/// `targetUserId` are plain values, so that the record outlives the Agents, organizations and users it names.
///
/// Behaviour:
/// - `cloneAgent` (src/lib/agentClone/cloneAgent.ts) writes the row in the clone's own transaction, so the
///   record and the copy commit or roll back together.
/// - Exactly one of `targetOrgId` and `targetUserId` is set (CHECK `chk_agent_clone_audit_one_target`). The
///   code sets `targetOrgId` only.
/// - The counts are what the copy of the system memory contained: nodes, edges, edges left out, imports and
///   links.
/// - The table is append-only: a trigger refuses every update and delete (`agent_clone_audits_immutable`,
///   prisma/post-push.sql).
/// - No API returns the rows. `Agent.clonedFromAgentRef` reads them to find a clone's source by id, and shows
///   that source only to a caller who may read it.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:dmo:050:18. Background: #2245, #2281.
model AgentCloneAudit {
  id                String   @id @map("id")
  actorUserId       String?  @map("actor_user_id")
  sourceAgentId     String   @map("source_agent_id")
  newAgentId        String   @map("new_agent_id")
  targetOrgId       String?  @map("target_org_id")
  targetUserId      String?  @map("target_user_id")
  nodeCount         Int      @map("node_count")
  edgeCount         Int      @map("edge_count")
  skippedEdgeCount  Int      @map("skipped_edge_count")
  importCount       Int      @map("import_count")
  linkCount         Int      @map("link_count")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([sourceAgentId])
  @@map("agent_clone_audits")
}

/// A trace left on a node when one of its outgoing edges disappeared because the node it pointed at was hard
/// deleted. Without it, the source node would lose an edge with no sign that it ever had one.
///
/// Relationships: belongs to the source Node and is deleted with it. `targetId`, `targetMemoryId`, `targetLoc`,
/// `edgeId` and `edgeLoc` are plain values: the target and the edge are gone by the time anyone reads the row.
/// `memoryId` is the memory the source was in when the edge was removed, because a node can be moved later.
///
/// Behaviour:
/// - The hard delete of a node writes one row for each edge that pointed at it from a node that survives
///   (src/api/graphql/schema/resolvers.mutation.node.ts). Edges the platform owns, such as comment and include
///   edges, are not recorded.
/// - `reason` is `TARGET_HARD_DELETED`, the only value today. `removedBy` is the same value `Node.deletedBy`
///   would carry.
/// - It is deliberately not a NodeRevision: a node's revisions stay snapshots of its own fields.
/// - Read by the `nodeEdgeRemovals` query, which shows a row only where the caller may read the memory it was
///   recorded in, and hides the target's address where the caller cannot read the target's memory.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:dmo:010:04. Background: #2517.
model NodeEdgeRemoval {
  id             String   @id @default(cuid())
  sourceId       String   @map("source_id")
  /// The source's memory when the edge was removed (a node can later be moved).
  memoryId       String   @map("memory_id")
  edgeId         String   @map("edge_id")
  edgeLoc        String   @map("edge_loc")
  edgeName       String?  @map("edge_name")
  targetId       String   @map("target_id")
  targetMemoryId String   @map("target_memory_id")
  targetLoc      String   @map("target_loc")
  /// Why the edge went: today only `TARGET_HARD_DELETED`.
  reason         String
  /// Same value `Node.deletedBy` would carry (user, app or client id), null when unattributed.
  removedBy      String?  @map("removed_by")
  createdAt      DateTime @default(now()) @map("created_at")

  source Node @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, createdAt])
  @@map("node_edge_removals")
}

/// A record that someone switched the public link of one asset on or off: who, when, and from what to what.
/// The public link lets anyone who has the asset's link download it without signing in.
///
/// Relationships: none by foreign key. `assetId`, `memoryId` and `actorUserId` are plain values, so that the
/// record outlives the asset, which is hard deleted after its retention period, and the user.
///
/// Behaviour:
/// - Every successful call of the switch writes one row, in the same transaction that sets
///   `Asset.publicLinkEnabled` (src/lib/asset/publicLink.ts), also when the value did not change: `enabled` is
///   the new value and `previouslyEnabled` the old one.
/// - Only whoever manages the asset's memory can make the switch.
/// - The code only inserts rows. No trigger enforces that, and no API returns the rows.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:dmo:060:15. Background: #1667.
model AssetPublicLinkAudit {
  id                String   @id @map("id")
  assetId           String   @map("asset_id")
  memoryId          String   @map("memory_id")
  actorUserId       String   @map("actor_user_id")
  enabled           Boolean
  previouslyEnabled Boolean  @map("previously_enabled")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([assetId, createdAt])
  @@map("asset_public_link_audits")
}

/// One include tag found in one node's text. An include is a reference to another node whose text is put in
/// its place when the node is read. The row holds the tag's structure: where it points and what it asks for.
/// The table is an index of who includes what, kept so that the pruning of old revisions can find the revisions
/// that includes rely on without reading or decrypting any node text.
///
/// Relationships: belongs to the including Node (`includer`) and is deleted with it. `targetMemoryId` and
/// `targetLoc` name the target as resolved when the row was written. There is deliberately no foreign key to
/// the target: the address the source wrote must survive the deletion of the target or of the edge.
///
/// Behaviour:
/// - `ordinal` is the tag's position in the node's text; `kind` says whether `reference` is a loc or a node
///   URN. `pinnedRevNo`, `requiresApproved` and `requiresSigned` are the tag's settings.
/// - The row is plaintext structural metadata. It never holds text from the node.
/// - `replaceStructuralReferences` (src/lib/includes/structuralReferences.ts) replaces all rows of a node
///   together with its IncludeSourceCoverage row. `reliedRevisionsOf` reads the rows by target.
/// - No code path of the running server calls either function yet, so the table is empty outside tests.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:dmo:150:07. Background: #2063.
model IncludeReference {
  id                 String  @id @default(cuid())
  includerId         String  @map("includer_id")
  ordinal            Int
  kind               IncludeReferenceKind
  reference          String
  targetMemoryId     String? @map("target_memory_id")
  targetLoc          String? @map("target_loc")
  pinnedRevNo        Int?    @map("pinned_rev_no")
  requiresApproved   Boolean @default(false) @map("requires_approved")
  requiresSigned     Boolean @default(false) @map("requires_signed")
  metadataGeneration Int     @map("metadata_generation")
  includer           Node    @relation(fields: [includerId], references: [id], onDelete: Cascade)

  @@unique([includerId, ordinal])
  @@index([targetMemoryId, targetLoc])
  @@index([targetMemoryId, reference])
  @@map("include_references")
}

/// How an include tag names its target: by `loc` inside the same memory, or by full `urn`. See IncludeReference.
enum IncludeReferenceKind {
  loc
  urn
}

/// The coverage state of one source node's include tags. The values are described on IncludeSourceCoverage.
enum IncludeSourceCoverageState {
  COMPLETE_EMPTY
  COMPLETE_TAGS
  NEEDS_AUTHORIZED_REWRITE
}

/// The statement that one node's include tags were captured in full, and for which state of the node. A node
/// with no tags gets a row too, so that "no rows in IncludeReference" can be told apart from "never looked at".
///
/// Relationships: at most one row per Node (`includerId` is unique), deleted only when that node is purged. A
/// soft-deleted node keeps its row.
///
/// Behaviour:
/// - The row pins what was parsed: the node's revision, memory and loc, a fingerprint of the stored content
///   bytes (the ciphertext when the memory is encrypted, never a plaintext copy), the parser version, and the
///   number of IncludeReference rows.
/// - `state` is `COMPLETE_EMPTY`, `COMPLETE_TAGS` or `NEEDS_AUTHORIZED_REWRITE`.
/// - `replaceStructuralReferences` (src/lib/includes/structuralReferences.ts) upserts it with the node's
///   references. `verifyIncludeCoverage` checks every node against its row and passes only when all of them are
///   current.
/// - No code path of the running server calls either function yet, so the table is empty outside tests.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:dmo:150:07. Background: #2063.
model IncludeSourceCoverage {
  id                       String @id @default(cuid())
  includerId               String @unique @map("includer_id")
  sourceRevision           Int    @map("source_revision")
  sourceMemoryId           String @map("source_memory_id")
  sourceLoc                String @map("source_loc")
  sourceContentFingerprint String @map("source_content_fingerprint")
  sourceEncrypted          Boolean @map("source_encrypted")
  parserVersion            Int    @map("parser_version")
  metadataGeneration       Int    @map("metadata_generation")
  referenceCount           Int    @map("reference_count")
  state                    IncludeSourceCoverageState
  includer                 Node   @relation(fields: [includerId], references: [id], onDelete: Cascade)

  @@map("include_source_coverage")
}

/// The stage of the include-retention generation. The values are described on IncludeRetentionGeneration.
enum IncludeRetentionState {
  PREPARING
  BACKFILLING
  VERIFYING
  ACTIVE
  BLOCKED
}

/// The single row that says whether the index of include tags (IncludeReference and IncludeSourceCoverage) is
/// complete and may be relied on. Until it says so, nothing may use the index to decide which revisions to
/// keep.
///
/// Relationships: none. There is one row at most, with the fixed id `singleton`.
///
/// Behaviour:
/// - `state` is `PREPARING`, `BACKFILLING`, `VERIFYING`, `ACTIVE` or `BLOCKED`. The index counts as usable only
///   when the row exists, is `ACTIVE`, carries the schema and parser versions the code expects, and its
///   `verifiedBindingGeneration` equals its `bindingGeneration`. Otherwise the readers refuse with
///   `INCLUDE_RETENTION_INACTIVE`.
/// - `metadataGeneration` is stamped on every IncludeReference and IncludeSourceCoverage row written under it.
///   The counters and cursors are for a backfill.
/// - Nothing creates or changes the row today: there is no activator, no operator command and no backfill, so
///   the row is absent and the index is inactive.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:dmo:150:07. Background: #2063.
model IncludeRetentionGeneration {
  id                        String @id @default("singleton")
  schemaVersion             Int @default(1) @map("schema_version")
  parserVersion             Int @default(1) @map("parser_version")
  metadataGeneration        Int @default(1) @map("metadata_generation")
  state                     IncludeRetentionState @default(PREPARING)
  sourceHighWaterId         String? @map("source_high_water_id")
  replayCursor              String? @map("replay_cursor")
  bindingGeneration         Int @default(0) @map("binding_generation")
  verifiedBindingGeneration Int? @map("verified_binding_generation")
  sourceCount               Int @default(0) @map("source_count")
  coveredCount              Int @default(0) @map("covered_count")
  blockedCount              Int @default(0) @map("blocked_count")

  @@map("include_retention_generation")
}

/// The request limits for one class of API calls. The platform sorts rate-limited calls into five classes
/// (`CREDENTIALS`, `OUTBOUND`, `WRITES`, `FAN_OUT_READS`, `OTHER_READS`), and each class has one row.
///
/// Relationships: none. `fieldClass` is the primary key. RateLimitBucket and RateLimitPolicyAudit name a class
/// by the same value.
///
/// Behaviour:
/// - A call may be counted against up to three subjects: its principal (a user or an App), its key and its IP
///   address. `principalLimit`, `keyLimit` and `ipLimit` are how many calls each may make in one window of
///   `windowSeconds`.
/// - `enforcementMode` is `LOG_ONLY` (a call over the limit is logged and let through) or `ENFORCING` (it is
///   refused with `RATE_LIMITED`). New rows start as `LOG_ONLY`.
/// - The server creates the rows once, from built-in defaults that environment variables can override, and
///   never overwrites a row afterwards (`seedRateConfig`, src/lib/rateLimit/index.ts).
/// - Only a platform administrator changes a row (`setRateLimitPolicy`). `version` rises with each change, and
///   a change must name the version it read. Each change writes a RateLimitPolicyAudit row. The window and
///   `retentionSeconds` cannot be changed.
/// - Every admission reads the row (`admitRateInTx`).
///
/// Background: #1793.
model RateLimitPolicy {
  fieldClass      String   @id @map("field_class")
  principalLimit  Int      @map("principal_limit")
  keyLimit        Int      @map("key_limit")
  ipLimit         Int      @map("ip_limit")
  windowSeconds   Int      @map("window_seconds")
  retentionSeconds Int     @default(86400) @map("retention_seconds")
  enforcementMode String   @default("LOG_ONLY") @map("enforcement_mode")
  version         Int      @default(1)
  updatedAt       DateTime @default(now()) @map("updated_at")
  @@map("rate_limit_policies")
}

/// The count of calls one subject made in one class during one time window. It is the counter a request is
/// checked against before it is let through.
///
/// Relationships: none by foreign key. `fieldClass` names a RateLimitPolicy. There is one row per class,
/// dimension, subject and window start.
///
/// Behaviour:
/// - `dimension` is `principal`, `key` or `ip`. `subject` is never the user id, key id or address itself: it is
///   a keyed hash (HMAC) of it, prefixed with the id of the hashing key, so the table holds no identity.
/// - An admission adds one to the row of each subject of the call, creating the row when needed
///   (`admitRateInTx`, src/lib/rateLimit/index.ts). It takes an advisory lock per subject first; the lock does
///   not depend on the window, so it also protects a row that does not exist yet.
/// - While two hashing keys are valid at once, a subject has one row per key and the larger count decides.
/// - `expiresAt` is one day after the window ends. A cleanup loop deletes expired rows in batches
///   (`cleanupRateBuckets`).
///
/// Background: #1793.
model RateLimitBucket {
  id          String   @id
  fieldClass  String   @map("field_class")
  dimension   String
  subject     String
  windowStart DateTime @map("window_start")
  used        BigInt
  expiresAt   DateTime @map("expires_at")
  @@unique([fieldClass, dimension, subject, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

/// The record of which secret keys are used to hash the subjects in RateLimitBucket. It holds the ids of the
/// keys and a fingerprint of each, never a key itself; the keys come from the server's environment. It lets
/// every server process check that it hashes with the same keys as the others.
///
/// Relationships: none. There is one row, with the id `global`.
///
/// Behaviour:
/// - The server creates the row at first use with the current key (`seedRateConfig`,
///   src/lib/rateLimit/index.ts). Every admission and the readiness check compare the keys in the environment
///   with `keyIds` and `fingerprints` and refuse to serve when they differ.
/// - `keyIds` holds one key, or two while a key is being replaced. `beginRateKeyOverlap` adds the new key and
///   sets `overlapStartedAt`; `retireRateKey` removes the old one, and only after 24 hours
///   (src/lib/rateLimit/lifecycle.ts). No API calls these two functions; they are for an operator.
/// - `version` rises with each change.
///
/// Background: #1793.
model RateLimitManifest {
  id                String   @id
  keyIds            String[] @map("key_ids")
  fingerprints      Json
  overlapStartedAt  DateTime? @map("overlap_started_at")
  version           Int      @default(1)
  @@map("rate_limit_manifests")
}

/// A record that a platform administrator changed the limits of one rate-limit class: who, when, the values
/// before and after, and the reference the administrator gave for the change.
///
/// Relationships: none by foreign key. `fieldClass` names a RateLimitPolicy and `actorId` is a user id, both as
/// plain values.
///
/// Behaviour:
/// - `setRateLimitPolicy` (src/api/graphql/schema/resolvers.rateLimit.ts) writes one row in the same
///   transaction as the change. A call that changes nothing writes no row.
/// - Only a platform administrator signed in as themselves can make the change: an App key, a session, an
///   impersonation and a headless run are refused.
/// - `before` and `after` are the policy's settings. The row holds no subject, no counter and no secret.
/// - The code only inserts rows. No trigger enforces that, and no API returns the rows.
///
/// Background: #1793.
model RateLimitPolicyAudit {
  id              String   @id
  fieldClass      String   @map("field_class")
  actorId         String   @map("actor_id")
  before          Json
  after           Json
  changeReference String   @map("change_reference")
  createdAt       DateTime @default(now()) @map("created_at")
  @@map("rate_limit_policy_audits")
}

/// A permission for the headless runs of one automation (one schedule or one webhook of an App) to read that
/// App's roster and tasks. Without it a run cannot read them. It is given per automation and is never a
/// permission for the whole App.
///
/// Relationships: belongs to one App and is deleted with it. `triggerId` is the id of an AgentSchedule or an
/// AgentWebhook, chosen by `triggerKind`, as a plain value. `grantedBy` and `revokedBy` are plain user ids.
///
/// Behaviour:
/// - Given by a person who manages the App, as themselves (`setAutomationTeamSnapshotGrant`); revoked by
///   whoever manages the App. Each writes an AppAutomationTeamSnapshotGrantEvent in the same transaction.
/// - There is at most one live row per App and trigger (partial index
///   `app_automation_team_snapshot_grants_live_uq`). A revoked row stays and does not block a new one.
/// - A row never changes except that it is revoked once, and it is deleted only with its App; a trigger
///   enforces both (prisma/app-automation-team-snapshot-grant-invariants.sql).
/// - The read is allowed only for a running run of that App whose root trigger still exists and holds a live
///   grant. This is checked again at every read (`runMayReadTeam`, src/lib/auth/runTeamRead.ts). The grant
///   gives reading only.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:agt:050:23. Background: #3350, #2925.
model AppAutomationTeamSnapshotGrant {
  id          String    @id @default(cuid())
  appId       String    @map("app_id")
  triggerKind String    @map("trigger_kind")
  triggerId   String    @map("trigger_id")
  grantedBy   String    @map("granted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedBy   String?   @map("revoked_by")
  app         App       @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt], map: "automation_team_snapshot_grants_app_created_idx")
  @@map("app_automation_team_snapshot_grants")
}

/// A record that a team snapshot grant was given or revoked: which automation, which grant, who did it and
/// when. It is the history of AppAutomationTeamSnapshotGrant.
///
/// Relationships: belongs to one App and is deleted with it. `grantId`, `triggerId` and `actorUserId` are plain
/// values with no foreign key, so that they stay readable after the user is erased or the trigger is deleted.
///
/// Behaviour:
/// - `action` is `GRANT` or `REVOKE`. One row is written for each grant created and each grant revoked, in the
///   same transaction (src/api/graphql/schema/resolvers.runTeamSnapshot.ts). A call that changes nothing writes
///   no row.
/// - The actor is a person who manages the App.
/// - The row holds ids only, no content.
/// - The table is append-only: a trigger refuses every update, and refuses a delete while the App exists
///   (prisma/app-automation-team-snapshot-grant-invariants.sql).
///
/// Background: #3350.
model AppAutomationTeamSnapshotGrantEvent {
  id          String   @id @default(cuid())
  appId       String   @map("app_id")
  triggerKind String   @map("trigger_kind")
  triggerId   String   @map("trigger_id")
  grantId     String   @map("grant_id")
  action      String
  actorUserId String   @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt], map: "automation_team_snapshot_events_app_created_idx")
  @@index([grantId], map: "automation_team_snapshot_events_grant_idx")
  @@map("app_automation_team_snapshot_grant_events")
}

/// The message count and the time of the last message of one chat. A chat is a root node with its messages
/// below it; these two values change with every message, so they are kept here and not on the node, where each
/// change would make a new revision.
///
/// Relationships: one row per chat root Node (`chatRootNodeId` is the primary key), deleted when that node is
/// hard deleted.
///
/// Behaviour:
/// - The row is created with the chat. Appending a message sets `messageCount` to the message's sequence number
///   and `lastMessageAt` to now (src/lib/chatRoot.ts).
/// - Deleting a message does not lower the count.
/// - For a chat made before this table existed, the row is created on the first write from the values that
///   were stored in the node's data, and those keys are then removed from the node
///   (src/lib/chatRootCounters.ts).
/// - The values are plaintext, also in an encrypted memory
///   (hrn:node:hadronmemory.com:specs:cor:sec:040:03). A read answers 0 and null while the memory is locked.
///
/// Background: #3496.
model ChatRootCounter {
  chatRootNodeId String @id @map("chat_root_node_id")
  messageCount Int @default(0) @map("message_count")
  lastMessageAt DateTime? @map("last_message_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  chatRoot Node @relation(fields: [chatRootNodeId], references: [id], onDelete: Cascade)
  @@map("chat_root_counters")
}

/// The working state of the conversation engine for one chat: which conversation and stage the chat is in,
/// which conversations it completed, its route history, its goal stack and the last time it went off track.
/// It changes on every turn, so it is kept here and not on the chat's node, where each change would make a new
/// revision.
///
/// Relationships: one row per chat root Node (`chatRootNodeId` is the primary key), deleted with it.
///
/// Behaviour:
/// - `state` is a JSON object with only those keys. In an encrypted memory it is stored encrypted, in the same
///   way as a node's data.
/// - The row is created with the chat. For a chat made before this table existed, it is created on the first
///   write from the values that were stored in the node's data (src/lib/chatRootEngineState.ts).
/// - A chat turn reads and writes it under the chat root's lock. A read never creates or repairs the row.
/// - Copying a memory copies the rows of its chats, and encrypting a memory encrypts them.
///
/// Background: #3501, #3557.
model ChatRootEngineState {
  chatRootNodeId String @id @map("chat_root_node_id")
  state Json
  updatedAt DateTime @updatedAt @map("updated_at")
  chatRoot Node @relation(fields: [chatRootNodeId], references: [id], onDelete: Cascade)
  @@map("chat_root_engine_states")
}

/// A permission for one holder to perform one registered action, with stated values, within one App. A worker
/// or an agent asks for a grant; it allows nothing until a person who may do the thing themselves signs it with
/// a passkey. It is how an agent gets leave for a specific act, such as creating one schedule, without holding
/// a standing right.
///
/// Relationships:
/// - `app` is the App the grant is valid in; deleting the App deletes its grants.
/// - The holder is exactly one of `userId`, `agentId`, `workerId` or `granteeAppId` (CHECK
///   `chk_grants_exactly_one_holder`). These are plain ids with no foreign key: when the holder goes the grant
///   ends and the record stays, so the id must outlive the row it names.
/// - `actionDef` is the Action the grant allows. An Action that a grant names cannot be deleted.
/// - `issuer` is the User whose signature activated the grant. The link is set to null when that account is
///   erased; the grant and its reason stay (hrn:node:hadronmemory.com:specs:cor:acl:140:08).
/// - `signature` is the GrantSignature that activated it. The grant has many GrantSigningRequest and
///   GrantSignature rows, and its history is in GrantEvent.
/// - `requestedByUserId`, `requestedByWorkerId` and `requestedBySessionId` say who asked for it, as plain ids.
///   (GrantSigningRequest names the same idea `requester…`; both spellings are the real column names.)
///
/// Behaviour:
/// - Creating a grant only asks for one. `createGrant` (src/lib/grants/create.ts) is the one writer. Its
///   callers are a worker's session, for the worker itself or its role agent, and a person who manages the App,
///   for a worker of the App or an agent installed in it. The code creates worker and agent holders only.
/// - A row arrives pending: not activated, not verified, not signed, not revoked and not used. The database
///   refuses any other insert, and an insert whose holder does not exist or has gone.
/// - It activates once, when a person signs it. The signer must be allowed to issue the action
///   (`Action.issuerRule`) and becomes the issuer. `activatedAt`, `verificationKind`, `verifiedBy` and
///   `signatureId` are set together and never change again
///   (hrn:node:hadronmemory.com:specs:cor:acl:140:07, hrn:node:hadronmemory.com:specs:cor:acl:140:04).
/// - Whether a grant allows anything is worked out at each use and never stored (src/lib/grants/live.ts). It
///   must be activated, not revoked, its holder not gone, its App not deleted, started (`startsAt`), not expired
///   (`expiresAt`), below `maxUses`, and inside the limits of its Action.
/// - `values` holds one value per parameter of the action: a single id, a list or a wildcard, where the action
///   accepts it. The grant covers an act only on the thing its values name
///   (hrn:node:hadronmemory.com:specs:cor:acl:140:10).
/// - Using a grant adds one to `useCount` under the row's lock, in the transaction of the act it allows, and
///   writes a `USE` GrantEvent. A grant with `maxUses` 1 is single-use: its first use spends it.
/// - A grant reaches its holder only. A grant held by an agent also reaches that agent's live workers in the
///   App, for the actions that say so (hrn:node:hadronmemory.com:specs:cor:acl:140:06).
/// - It ends once, and the first end stands. A person revokes it (`revokedAt` with `revokedBy`); the requester
///   withdraws a grant that was never activated (`withdrawnAt`, equal to `revokedAt`); or its holder goes
///   (`holderDepartedAt`: a person erased or leaving the App's organization, a worker retired or deleted, an
///   agent deleted or no longer installed in the App).
/// - Apart from those moves a row is never edited. A user merge moves the person links from the merged account
///   to the surviving one. A trigger enforces all of this (prisma/grant-invariants.sql).
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:acl:140:01. Lifecycle:
/// hrn:node:hadronmemory.com:specs:cor:acl:140:03. Rule: hrn:node:hadronmemory.com:specs:cor:acl:140:05.
/// Background: #3668, #3690, #3711, #3483, #4173.
model Grant {
  id                    String    @id @default(cuid())
  appId                 String    @map("app_id")
  /// The holder: exactly one of these four (chk_grants_exactly_one_holder). SEALED ids, no foreign key (#3690 S2a-h): when the
  /// holder goes the grant ends and the record stays (hrn:node:hadronmemory.com:specs:cor:acl:140:03, ruling 0255 item 3), so the id must survive the row it
  /// names, and the CHECK forbids the SET NULL a foreign key would need. The kind is the column that is set. Integrity at
  /// insert is the guard trigger's (the holder must exist and not be gone); the ending is `holderDepartedAt`.
  userId                String?   @map("user_id")
  agentId               String?   @map("agent_id")
  workerId              String?   @map("worker_id")
  granteeAppId          String?   @map("grantee_app_id")
  /// Who issued it. Set to NULL when that account is erased (hrn:node:hadronmemory.com:specs:cor:acl:140:08); the reason stays.
  issuerUserId          String?   @map("issuer_user_id")
  /// Who asked for it. FK-free sealed ids (a merge moves the user link; the worker and session are fenced, #1162).
  requestedByUserId     String?   @map("requested_by_user_id")
  requestedByWorkerId   String?   @map("requested_by_worker_id")
  requestedBySessionId  String?   @map("requested_by_session_id")
  /// A registered action (FK): there is no free-text or recorded-only stand-in.
  action                String
  /// The values the grant allows (a single value, a list or a wildcard); never a secret.
  values                Json      @map("action_values")
  startsAt              DateTime? @map("starts_at")
  expiresAt             DateTime? @map("expires_at")
  maxUses               Int?      @map("max_uses")
  useCount              Int       @default(0) @map("use_count")
  reason                String
  version               Int       @default(1)
  /// Phase 2 (signing). Always NULL on a new row (INSERT guard); a pending row allows nothing.
  activatedAt           DateTime? @map("activated_at")
  verificationKind      String?   @map("verification_kind")
  verifiedBy            String?   @map("verified_by")
  /// #3649 slice B: the signature that activated it (set by slice C's activation, never by a write surface). A signature
  /// activates one grant, so the column is unique.
  signatureId           String?   @unique @map("signature_id")
  revokedAt             DateTime? @map("revoked_at")
  revokedBy             String?   @map("revoked_by")
  /// #4173 (hrn:node:hadronmemory.com:specs:cor:acl:140:03): the withdrawal marker, a FACT like `revokedAt` and never a state column. Equal to `revokedAt`, set once with
  /// the revoke stamp, on a never-activated row only. Rows withdrawn before #4173 have none and read as revoked.
  withdrawnAt           DateTime? @map("withdrawn_at")
  /// #3690 (S2a-h, hrn:node:hadronmemory.com:specs:cor:acl:140:03): when the HOLDER went (a person erased, a worker retired or deleted, an agent or an App
  /// deleted). A FACT, like `revokedAt`, never a state label: the live check reads it, and nothing names the ended state.
  /// Stamped once, and only on a grant not already ended (prisma/grant-invariants.sql); the holder id above stays.
  holderDepartedAt      DateTime? @map("holder_departed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  app         App     @relation("GrantApp", fields: [appId], references: [id], onDelete: Cascade)
  issuer      User?   @relation("GrantIssuer", fields: [issuerUserId], references: [id], onDelete: SetNull)
  actionDef   Action  @relation(fields: [action], references: [name], onDelete: Restrict, onUpdate: Restrict)
  signature   GrantSignature? @relation("GrantActivation", fields: [signatureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  signingRequests GrantSigningRequest[]
  signatures      GrantSignature[] @relation("GrantSignatures")
  secretReadClient SecretReadClient?

  @@index([appId, createdAt])
  @@index([userId])
  @@index([agentId])
  @@index([workerId])
  @@index([granteeAppId])
  @@index([action])
  @@map("grants")
}

/// #3998 (S3 of #3991) — the ASSOCIATION between one grant and one App secret: which secret a `secret.reveal` grant reads.
/// It carries NO window, budget, mark or counter (plan R1): the grant row is the counter and the judge, and every one of
/// those is read from it. The id is 128 bits of randomness (base64url), the handle the holder presents. `secretId` is
/// sealed, with no foreign key, so a deleted secret's id never reaches a new secret of the same name (R2); the only end
/// this row stores is one the grant cannot express (`SECRET_DELETED`, and `PROTECTED` from S4), set once by a trigger or
/// the protection ceremony (prisma/secret-read-clients-invariants.sql). Cascades only with its grant.
model SecretReadClient {
  id           String    @id
  grantId      String    @unique @map("grant_id")
  appId        String    @map("app_id")
  secretId     String    @map("secret_id")
  /// The secret's name when the client was issued: display only, never a lookup key.
  secretName   String    @map("secret_name")
  /// The issuing person, sealed (no FK; erasure keeps the history). The grant's own issuer link is nulled on erasure.
  issuerUserId String?   @map("issuer_user_id")
  /// The grant's issuer is its person holder. Stored once so S4's protection change and read check can query it.
  selfIssued   Boolean   @map("self_issued")
  /// SECRET_DELETED | PROTECTED, set together with `endedAt`, once.
  endReason    String?   @map("end_reason")
  endedAt      DateTime? @map("ended_at")
  createdAt    DateTime  @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @map("created_at")

  grant Grant @relation(fields: [grantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  app   App   @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, secretId])
  @@index([issuerUserId])
  @@map("secret_read_clients")
}

/// A request for a person to sign one pending Grant. It is what the signing page opens: it fixes exactly which
/// grant, and which version of its terms, the person is asked to sign.
///
/// Relationships: belongs to one Grant and is deleted only with it. Has at most one GrantSignature, the one
/// that completed it. `requesterUserId`, `requesterAppId`, `requesterWorkerId` and `requesterSessionId` are
/// plain ids with no foreign key; they are kept as history.
///
/// Behaviour:
/// - `id` is 128 random bits, so it cannot be guessed.
/// - `grantId`, `version`, `termsHash` and `payloadVersion` are fixed when the request is created and never
///   change. `termsHash` is a hash of the grant's terms: its App, holder, action, values, start, expiry, count
///   and reason (hrn:node:hadronmemory.com:specs:cor:acl:140:09).
/// - A request can be created only for a grant that is still pending, at the grant's current version.
/// - It names no signer. Whoever signs must be allowed to issue the grant, which is judged when they sign
///   (hrn:node:hadronmemory.com:specs:cor:acl:140:04).
/// - `state` starts as `open` and ends exactly once: `completed` (signed), `declined` (the person refused),
///   `expired` (`expiresAt` passed), `withdrawn` (the account that asked took it back) or `stale`.
/// - A request goes `stale` when its grant is revoked, loses its holder, changes its terms, or is activated
///   through another request, so that no request completes over terms the person was not shown.
/// - Every time is the database clock. A trigger sets the times and enforces the fixed fields and the single
///   end (prisma/grant-signing-invariants.sql).
/// - Written by src/lib/signing/grantRequests.ts and src/lib/signing/grantCeremony.ts.
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:acl:140:07. Background: #3649.
model GrantSigningRequest {
  /// 128 bits of randomness, base64url: never guessable (the node-signing id mint).
  id                 String    @id
  grantId            String    @map("grant_id")
  /// The grant record's version and terms hash as the requester read them; completion requires both still to match.
  version            Int
  termsHash          String    @map("terms_hash")
  payloadVersion     String    @map("payload_version")
  /// The requester ACCOUNT is requesterUserId, else requesterAppId (the node-signing rule).
  requesterUserId    String?   @map("requester_user_id")
  requesterAppId     String?   @map("requester_app_id")
  requesterWorkerId  String?   @map("requester_worker_id")
  requesterSessionId String?   @map("requester_session_id")
  /// open | completed | declined | expired | stale | withdrawn
  state              String    @default("open")
  createdAt          DateTime  @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @map("created_at")
  expiresAt          DateTime  @map("expires_at")
  endedAt            DateTime? @map("ended_at")
  /// #4546: latest verified ineligible proof on an open request; no signer identity and no state change.
  lastRefusedAt      DateTime? @map("last_refused_at")

  grant     Grant           @relation(fields: [grantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  signature GrantSignature?

  @@index([grantId, createdAt])
  @@map("grant_signing_requests")
}

/// The record of one person's passkey signature on one Grant. It proves that this person, with this passkey,
/// signed exactly these terms of this grant in answer to this signing request. Recording it is what activates
/// the grant.
///
/// Relationships: belongs to one Grant (`grant`) and to the GrantSigningRequest it completed, one signature per
/// request; it is deleted only with the grant. `passkey` is the PasskeyCredential that signed, and that
/// credential cannot be deleted while the signature exists. `activatedGrant` is the Grant whose `signatureId`
/// names this row. `signerId` is the person's user id as a plain value with no foreign key.
///
/// Behaviour:
/// - The signing ceremony inserts the row (`completeGrantSigning`, src/lib/signing/grantCeremony.ts). In one
///   transaction it verifies the passkey assertion, records the signature, completes the request and activates
///   the grant, with the signer as issuer.
/// - The database accepts the row only against an open, unexpired request whose `version`, `termsHash` and
///   `payloadVersion` it repeats, from the signer's own unrevoked passkey, on a grant that is still pending.
/// - What the passkey signed is the SHA-256 of a payload that names the grant, its version, its terms hash and
///   the request (hrn:node:hadronmemory.com:specs:cor:acl:140:09). `authenticatorData`, `clientDataJson`,
///   `signature` and `rpId` are kept so that the signature can be verified again at any later read.
/// - `holderKind` and `holderId` are the holder as it was signed. A user merge can later move the grant's
///   holder link, and a later read must rebuild the terms the person signed, not the row as it is now.
/// - The row is never updated (prisma/grant-signing-invariants.sql). Whether a signature is current, earlier or
///   invalid is worked out at each read and never stored (src/lib/signing/grantStatus.ts).
///
/// Rule: hrn:node:hadronmemory.com:specs:cor:acl:140:07. Background: #3649, #3827.
model GrantSignature {
  id                  String   @id @default(cuid())
  grantId             String   @map("grant_id")
  /// The request it completed; one record per request.
  signingRequestId    String   @unique @map("signing_request_id")
  /// A person, always. Sealed history: no FK.
  signerId            String   @map("signer_id")
  passkeyCredentialId String   @map("passkey_credential_id")
  version             Int
  termsHash           String   @map("terms_hash")
  /// The holder as signed: user | agent | worker | app, and its id.
  holderKind          String   @map("holder_kind")
  holderId            String   @map("holder_id")
  payloadVersion      String   @map("payload_version")
  /// The WebAuthn RP ID the signature was made under (re-verification uses it, never the current config).
  rpId                String   @map("rp_id")
  authenticatorData   Bytes    @map("authenticator_data")
  clientDataJson      Bytes    @map("client_data_json")
  signature           Bytes
  verifiedAt          DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @map("verified_at")

  grant          Grant               @relation("GrantSignatures", fields: [grantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  signingRequest GrantSigningRequest @relation(fields: [signingRequestId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  passkey        PasskeyCredential   @relation(fields: [passkeyCredentialId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activatedGrant Grant?              @relation("GrantActivation")

  @@index([grantId])
  @@map("grant_signatures")
}

/// One entry in the history of a Grant: what happened to it, when, and who did it.
///
/// Relationships: belongs to one App and is deleted with it. `grantId` names a Grant as a plain value with no
/// foreign key; a trigger checks at insert that the grant exists and is in the event's App. `actorUserId`,
/// `workerId`, `sessionId` and `runId` are plain ids, kept as history.
///
/// Behaviour:
/// - `action` is `CREATE`, `ACTIVATE`, `REVOKE`, `WITHDRAW` or `USE` (CHECK `chk_grant_events_shape`,
///   prisma/grant-invariants.sql).
/// - `ACTIVATE` is written when a person's signature activates the grant and names the signer. `REVOKE` and
///   `WITHDRAW` are written when a person ends the grant and name that person and, when the act came through a
///   worker's session, the worker and session. `USE` is written each time the grant is used and names the
///   worker and session that used it. Each is written in the transaction of the act it records.
/// - No code writes a `CREATE` event today, and a grant that ends because its holder went gets no event.
/// - `at` is the database clock.
/// - The table is append-only: a trigger refuses every update, and refuses a delete while the App exists.
/// - For an action that limits its uses, the check of whether a grant is spent also counts the grant's `USE`
///   events (src/lib/grants/cover.ts).
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:acl:140:01. Background: #3668, #4173.
model GrantEvent {
  id           String   @id @default(cuid())
  grantId      String   @map("grant_id")
  appId        String   @map("app_id")
  /// CREATE | ACTIVATE | REVOKE | USE (CHECK in grant-invariants.sql).
  action       String
  at           DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @db.Timestamp(3)
  actorUserId  String?  @map("actor_user_id")
  workerId     String?  @map("worker_id")
  sessionId    String?  @map("session_id")
  runId        String?  @map("run_id")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, at])
  @@index([grantId])
  @@map("grant_events")
}

/// One thing a Grant can allow, such as creating a schedule. The platform keeps the list of actions so that
/// people, agents and the server all read the same list of what can be granted.
///
/// Relationships: has many Grant rows, each of which names its action by `name`. An action that a grant names
/// cannot be deleted or renamed.
///
/// Behaviour:
/// - The list lives in the server's code (`PLATFORM_ACTIONS`, src/lib/grants/actions.ts). An upsert writes it
///   to this table at deploy (scripts/db/upsert-actions.ts): it inserts what is missing, updates what differs
///   and never deletes a row.
/// - Nothing else writes the table. No GraphQL, MCP, CLI or run-tool call does, and the role the server runs
///   as has no insert, update or delete right on it (prisma/runtime-role.sql). An agent's author therefore
///   cannot invent an action.
/// - The list holds `schedule.create`, `webhook.create`, `bootprompt.source.edit` and
///   `bootprompt.compile.approve`.
/// - `parameters` names each value a grant of the action must carry, its type, and whether it refuses a
///   wildcard.
/// - `issuerRule` is a closed key that the server maps to a function that decides who may issue a grant of the
///   action, which is whoever may do the thing themselves (src/lib/grants/issuers.ts). It is never SQL or code.
/// - `enforcement` says what enforces the action: `SERVER`, `CREDENTIAL`, `HARNESS_INSTRUCTION` or
///   `RECORDED_ONLY`.
/// - `summaryTemplate` is the plain sentence shown to the person who signs, filled from the App and the grant's
///   values.
/// - `maxUses` and `lifetimeSeconds` are limits that apply to every grant of the action; a grant's own count
///   and expiry can only narrow them.
///
/// Entity spec: hrn:node:hadronmemory.com:specs:cor:acl:140:02. Background: #3668, #3707, #4163.
model Action {
  name            String   @id
  /// PLATFORM now; a tool's id later (phase 5).
  source          String   @default("PLATFORM")
  /// [{ name, type, refusesWildcard }]
  parameters      Json
  tool            String?
  /// SERVER | CREDENTIAL | HARNESS_INSTRUCTION | RECORDED_ONLY (CHECK in grant-invariants.sql).
  enforcement     String
  /// A closed key the server maps to a gate function; never SQL or code.
  issuerRule      String   @map("issuer_rule")
  summaryTemplate String   @map("summary_template")
  /// #4163: a limit on uses that applies to every grant of this action (NULL: none). A grant's own max_uses can only narrow it.
  maxUses         Int?     @map("max_uses")
  /// #4163: a limit on lifetime from activation, in seconds, for every grant of this action (NULL: none). A grant's own expiry can only narrow it.
  lifetimeSeconds Int?     @map("lifetime_seconds")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  grants Grant[]

  @@map("actions")
}
