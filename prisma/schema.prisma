generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A node in the Hadron graph.
// loc is the canonical dotted path, e.g. "micromentor-org.mmdata.models"
// namespace is the first two segments, e.g. "micromentor-org.mmdata" — identifies
// which repo owns this node.
model Node {
  id          String   @id // UUIDv7 (no hyphens) from node.yaml — stable across moves
  loc         String   @unique
  name        String
  alias       String?
  description String?
  content     String?  // topic.md full text
  contentHash String?  // SHA256(yaml+topic.md)[0:8] for change detection
  tags        String[] // e.g. ["action", "generate"]
  namespace   String   // e.g. "micromentor-org.mmdata"
  ownerRepo   String   // GitHub repo slug that contributed this node, e.g. "micromentor/mmdata"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outgoingEdges Edge[]        @relation("SourceNode")
  incomingEdges Edge[]        @relation("TargetNode")
  pendingEdges  PendingEdge[]
  usageEvents   UsageEvent[]

  @@index([namespace])
}

// Directed edge between two nodes.
model Edge {
  id       String  @id @default(cuid())
  sourceId String
  targetId String
  label    String? // optional relationship label

  source Node @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target Node @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([targetId])
}

// Edge whose target node hasn't been synced yet.
// Stored without a FK on targetId; converted to a real Edge when the target arrives.
model PendingEdge {
  id       String  @id @default(cuid())
  sourceId String
  targetId String  // intended target node id — NOT a FK
  label    String?

  source Node @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([targetId])
}

// A single AI/agent/chatbot session — the unit of outcome tracking.
// The id is set by the caller (from h-start-session or equivalent) so that
// events can reference it before it is created on the server.
model Session {
  id            String    @id // caller-generated, e.g. UUID from h-start-session
  type          String    @default("developer") // "developer" | "chatbot" | "automation" | "edge"
  clientId      String?   // API key label or "github-oauth:<login>"
  repo          String?   // git repo slug, e.g. "micromentor/mmdata"
  branch        String?   // git branch name at session start
  prNumber      Int?      // GitHub PR number, set when known
  customerId    String?   // tenant/customer identifier (for chatbot sessions)
  language      String?   // spoken language ("en", "es") or programming language ("typescript")
  llmModel      String?   // model used, e.g. "claude-sonnet-4-6", "gpt-4o"
  inputTokens   Int?      // prompt tokens (priced differently from output)
  outputTokens  Int?      // completion tokens
  turnCount     Int?      // number of human↔AI exchanges
  errorCount    Int?      // number of failed tool calls or action runs
  parentSessionId String? // vertical: this session was spawned by another (sub-agent)
  prevSessionId   String? // horizontal: this session continues a prior session (same work thread)
  summary       String?   // short text composed by the AI at h-end-session
  outcome       Float?    // 0.0–1.0, reported externally after the fact
  outcomeRef    String?   // GUID or URL of the authoritative outcome record
  outcomeMeta   Json?     // domain-specific outcome detail blob
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  autoExpiredAt DateTime?

  events       UsageEvent[]
  parent       Session?   @relation("SubAgentSessions", fields: [parentSessionId], references: [id], onDelete: SetNull)
  subSessions  Session[]  @relation("SubAgentSessions")
  prev         Session?   @relation("SessionChain", fields: [prevSessionId], references: [id], onDelete: SetNull)
  nextSessions Session[]  @relation("SessionChain")

  @@index([type])
  @@index([repo])
  @@index([customerId])
  @@index([startedAt])
  @@index([parentSessionId])
  @@index([prevSessionId])
}

// Every operation is recorded here.
model UsageEvent {
  id         String   @id @default(cuid())
  type       String   // "read" | "write" | "action-run" | "edge-traversal" | "session-summary"
  nodeLoc    String?  // stored directly so it survives node deletion
  nodeId     String?
  actionArgs Json?    // key-value args when type = "action-run"
  clientId   String?  // API key label, "github-oauth:<login>", or "github-app"
  sessionId  String?  // FK to Session
  createdAt  DateTime @default(now())

  node    Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([nodeLoc])
  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
}

// A machine client — workstation, cloud host, IoT device, or AI agent.
// Authenticates via API key. The raw key is shown once at creation; only its bcrypt hash is stored.
model Client {
  id             String      @id @default(cuid())
  label          String      @unique // human-readable name, e.g. "mmdata-ci"
  keyHash        String      // bcrypt hash of the opaque token
  type           ClientType  @default(WORKSTATION)
  description    String?
  roles          Role[]      @default([READER])
  namespace      String?     // for CONTRIBUTOR: restricts write access to this namespace prefix
  organizationId String?     // optional: scopes this client to one organization
  userId         String?     // optional: the user who owns this client; null for IoT/org-owned
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  lastUsedAt     DateTime?

  organization       Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user               User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  graphSubscriptions ClientGraphSubscription[]
}

// GitHub OAuth users — cached after first login.
model User {
  id        String   @id @default(cuid())
  githubId  Int      @unique
  login     String   // GitHub username
  name      String?  // display name from GitHub profile
  email     String?  @unique // email address for invite matching
  avatarUrl String?  // GitHub avatar URL
  roles     Role[]   @default([READER])
  canInvite Boolean  @default(false) // whether this user can send org invitations
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        OrganizationMember[]
  clients            Client[]
  ownedOrganizations Organization[] @relation("OwnedOrganizations")
  ownedGraphs        HadronGraph[]  @relation("OwnedGraphs")
  sentInvites        OrgInvite[]    @relation("SentInvites")
}

// A top-level organization (company or team) that owns one or more graphs.
model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique // URL-safe identifier, e.g. "micromentor-org"
  githubInstallationId Int?      @unique // set when the GitHub App is installed for this org
  ownerId              String?   // User who created/owns this org
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  owner         User?                     @relation("OwnedOrganizations", fields: [ownerId], references: [id], onDelete: SetNull)
  members       OrganizationMember[]
  graphs        HadronGraph[]
  clients       Client[]
  subscriptions HadronGraphSubscription[]
  invites       OrgInvite[]
}

// Per-organization membership and role for a user.
model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(READER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// A Hadron graph config — replaces .hadron-controller.yaml entries.
// Each record describes one GitHub repo to sync.
model HadronGraph {
  id             String    @id @default(cuid())
  organizationId String
  ownerId        String?   // User who created this graph config
  name           String    // graph key, e.g. "micromentor-org/mmdata"
  source         String?   // git clone URL; null = DB-only mode (no git sync/push)
  readBranch     String?   // branch to clone/pull from; defaults to repo default
  writeBranch    String?   // branch for node mutations; defaults to "hadron-updates"
  visibility     String    @default("PRIVATE") // "PUBLIC" | "PRIVATE"
  version        String?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner               User?                     @relation("OwnedGraphs", fields: [ownerId], references: [id], onDelete: SetNull)
  subscriptions       HadronGraphSubscription[]
  clientSubscriptions ClientGraphSubscription[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// A client's subscription to a specific graph — controls which graphs the client syncs.
// Empty subscriptions = no graphs (explicit opt-in required).
model ClientGraphSubscription {
  id               String   @id @default(cuid())
  clientId         String
  graphId          String
  subscriptionType String   @default("READ_ONLY") // "READ_ONLY" | "READ_WRITE"
  namespace        String?  // optional: namespace restriction for this subscription
  createdAt        DateTime @default(now())

  client Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  graph  HadronGraph @relation(fields: [graphId],  references: [id], onDelete: Cascade)

  @@unique([clientId, graphId])
  @@index([graphId])
}

// An organization's subscription to a graph it does not own.
// The owning organization always has implicit full access.
model HadronGraphSubscription {
  id             String   @id @default(cuid())
  graphId        String
  organizationId String   // subscriber org (not the owner)
  role           String   @default("READER") // "READER" | "CONTRIBUTOR"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  graph        HadronGraph  @relation(fields: [graphId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([graphId, organizationId])
  @@index([organizationId])
}

// An invitation to join an organization, sent by email.
model OrgInvite {
  id          String       @id @default(cuid())
  orgId       String
  email       String       // invitee email address
  invitedById String       // User who sent the invite
  status      InviteStatus @default(PENDING)
  token       String?      @unique // for users without an account (future invite-link flow)
  createdAt   DateTime     @default(now())
  expiresAt   DateTime

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([orgId, email, status]) // prevent duplicate pending invites per org+email
  @@index([email])
  @@index([token])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum Role {
  ADMIN
  CONTRIBUTOR
  READER
}

enum OrgRole {
  ADMIN
  CONTRIBUTOR
  READER
}

enum ClientType {
  WORKSTATION
  CLOUD
  IOT
  AGENT
}
