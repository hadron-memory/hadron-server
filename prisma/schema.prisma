generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  // 033-rag-vector-retrieval: postgresqlExtensions is still a preview feature
  // in Prisma 6.x; enables the `extensions` block below so `prisma db push` /
  // `migrate` manage `CREATE EXTENSION vector` (pgvector).
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // 033-rag-vector-retrieval: pgvector. db push/migrate runs CREATE EXTENSION
  // vector before creating the vector(768) column on node_embeddings.
  extensions = [vector]
}

// ─── Hadron entity model ──────────────────────────────────────────────
//
// This schema is the **canonical** source of entity definitions for the
// Hadron platform. The legacy Entities.md (in the sister `hadron-concept`
// repo, at hadron-specs/General/Entities.md) was folded into this file on
// 2026-05-11 and deleted; do not recreate it.
//
// Cross-repo references below cite paths in sister repos by repo name
// (e.g. `hadron-concept/...`, `hadron-docs/...`). Those trees do not live
// in this repository.
//
// Shared audit fields
// -------------------
// Every model below carries the same audit columns (not re-described per
// field to keep the file readable):
//   createdAt, createdBy   — set at row insert (createdBy is fk-ish to
//                            User.id but unconstrained for system writes)
//   updatedAt, updatedBy   — set on every update (Prisma @updatedAt)
//   deletedAt, deletedBy   — soft-delete marker; null = live row
// A handful of tables (AppMember, AgentSubscription, AgentOrgGrant) omit
// deletedAt/deletedBy on purpose — soft-delete is redundant there because
// the row has a richer lifecycle field (revokedAt) or is a pure join with
// no meaningful "soft-deleted" state. Each such table calls this out in
// its model-level doc.
//
// URN convention
// --------------
// Globally addressable entities (Organization, Memory, Agent, App) carry
// both a `urn` (unique, stable, colon-delimited identifier) and a `name`
// (human-friendly display label, not unique). Colon is the structural
// delimiter. URN shapes:
//   - Organization: `<domain>`               e.g. "baragaun.com"
//   - Memory:       `<org>:<slug>`           e.g. "baragaun.com:secureid"
//   - Agent:        `<org>:<slug>`           e.g. "micromentor.org:juno"
//   - App:          `<org>:<slug>`           e.g. "baragaun.com:internal-ops"
//   - Node:         `<memory.urn>:<loc>`     computed, NOT stored
//   - Asset:        `<memory.urn>:assets:<asset.id>`
// Full scheme: `hadron-concept/hadron-specs/General/URN.md` (sister repo).
//
// Table naming
// ------------
// All model `@@map(...)` names are explicit snake_case. Most are plural
// (`users`, `organizations`, `memories`), but some are singular by
// convention — `hadron_server`, `server_log`, `memory_log`, `app_log`,
// `waiting_list`. Prisma would default to PascalCase otherwise; the
// explicit map keeps the SQL surface stable across model renames.

// ─── Enums ─────────────────────────────────────────────────────────────

/// Global / organization-membership role. Used on OrgMember.role,
/// MemorySubscription.role, and the *Invitation roles. Hierarchy:
/// OWNER > ADMIN > CONTRIBUTOR > READER. Invitations cannot grant a
/// role higher than the sender's own. **Note**: MemorySubscription /
/// OrgMemberInvitation / UserInvitation use this full enum at the
/// column level, but the intended grant set is narrower (typically
/// CONTRIBUTOR | READER for subscriptions; admin | contributor |
/// reader for invitations). Tightening the column is reserved for a
/// future cleanup spec.
enum Role {
  OWNER
  ADMIN
  CONTRIBUTOR
  READER
}

/// Per-App default role assigned to new members when no Agent
/// `installation_policy.memberRoles` override applies. Free-form
/// AppMember.role strings (validated against installation_policy) are
/// distinct from this enum — the enum survives mainly for legacy
/// App.role storage.
enum AppMembershipRole {
  OWNER
  ADMIN
  CONTRIBUTOR
  READER
}

/// **Deprecated** in favor of App.surfaces (008-agent-installation
/// R-4). Kept to avoid spurious portal churn; a follow-up cleanup
/// spec will drop it.
enum AppType {
  WORKSTATION
  CHATBOT
  AGENT
  AUTOMATION
  CLOUD
  IOT
}

/// Reserved enum — declared but not currently referenced by any
/// column. A 2026-Q3 marketplace-licensing spec is expected to wire
/// this into MemorySubscription. Flagged for cleanup-if-not-used.
enum SubscriptionType {
  READ_ONLY
  READ_WRITE
}

/// Coarse classification of a Session: who/what is driving it.
///   DEVELOPER  — interactive coding session (Claude Code, Cursor, …)
///   CHATBOT    — end-user chat through an App (e.g. Juno)
///   AUTOMATION — non-interactive run (cron, CI, scripted agent)
///   EDGE       — triggered by an Edge condition firing
enum SessionType {
  DEVELOPER
  CHATBOT
  AUTOMATION
  EDGE
}

/// State machine for Memory git-sync and ExchangeConnection mailbox
/// sync. Transitions: PENDING → SYNCING → OK | ERROR; ERROR rows can
/// re-enter SYNCING on retry.
enum SyncStatus {
  PENDING
  SYNCING
  OK
  ERROR
}

/// How a User authenticated. APP is reserved for users provisioned
/// via App-scoped flows (e.g. chatbot `createAppUser`); GOOGLE landed
/// with Sign-in-with-Google (#581), APPLE with Sign-in-with-Apple
/// (#584); MICROSOFT is reserved for future SSO.
enum IdentityProvider {
  GITHUB
  EMAIL
  APP
  GOOGLE
  MICROSOFT
  APPLE
}

/// App-level policy for whether the App may create new platform Users
/// on-the-fly when a chatbot session arrives with a previously-unseen
/// external id.
///   DENY     — never create; reject the request
///   EXPLICIT — only via the `createAppUser` mutation
///   IMPLICIT — auto-create on first contact (used by Workstation apps)
enum CreateUserPermission {
  DENY
  EXPLICIT
  IMPLICIT
}

/// App-level policy for how to resolve "which User is this?" from the
/// incoming session credential.
///   USER_ID — the App passes our internal User.id (default; trust-the-caller)
///   SECRET  — the App passes a per-user secret we look up
enum IdentifyUserMethod {
  USER_ID
  SECRET
}

/// **Largely legacy**. The Agent.type field below carries the coarse
/// behavior hint (ASSISTANT vs CHATBOT). Post-008-agent-installation
/// most behavior is driven by surfaces / installation_policy /
/// memory_provisioning, not this enum. Kept for backward-compat with
/// portal listings; a follow-up cleanup spec may collapse it.
enum AgentType {
  ASSISTANT
  CHATBOT
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// Tag for MemoryLogEntry rows to support filtered tail views in
/// hadron-portal (e.g. "show me only sync errors for this memory").
enum MemoryLogEventType {
  SYNC
  LICENSE
  EDGE
  OTHER
}

/// Memory visibility — **035-visibility-enum-cleanup**. Meaningful only
/// for `knowledge` (PUBLIC/ORGANIZATION) and `group` (GROUP); NULL for
/// every other class. The `PERSONAL`/`PRIVATE` values were dropped (spec
/// 034 moved privacy onto the `personal`/`private` CLASS). The
/// `chk_memory_visibility_class` CHECK forbids a non-null visibility on
/// any class other than knowledge/group.
enum MemoryVisibility {
  PUBLIC
  ORGANIZATION
  /// 023-app-shape: bidirectional with `MemoryClass.group`. Enforced by
  /// the `chk_memory_group_visibility` CHECK constraint:
  /// `class = 'group' ⇔ visibility = 'GROUP'`.
  GROUP
}

/// Agent visibility — **035-visibility-enum-cleanup** split this off the
/// shared `MemoryVisibility` enum. `PERSONAL` is the creator-only draft
/// state (named PERSONAL, not PRIVATE, so it never collides with the
/// memory `private` class). `Organization.agents` filters on it;
/// `createAgent` defaults to it.
enum AgentVisibility {
  PUBLIC
  ORGANIZATION
  PERSONAL
}

/// Per-Memory typology — formalized in 005-agent-subscription
/// (2026-04-30); per-class governance refined in 008-agent-installation
/// (2026-05-02), re-keyed onto `class` by 034-memory-class-access.
/// `personal`/`private`-class memories MUST have Memory.userId set
/// (chk_personal_visibility_user). `app`-class MUST have Memory.appId set;
/// `personal`/`private` MAY have it (set when app-scoped, NULL when
/// free-standing); `system`/`knowledge`/`group` MUST NOT
/// (chk_memory_class_app_id, relaxed by spec 034).
///
///   system     — the Agent's own definition (one per Agent, linked via
///                Agent.systemMemoryId). Universally read-only from any
///                App context post-008 (DEVELOP-from-App is dropped per
///                R-10). Edits happen in the Agent ownership surface.
///   app        — records the App writes through the Agent (chat history,
///                extracted facts, generated artifacts). Keyed on
///                (app_id, agent_id) for shared-app-memory Agents,
///                (app_id, agent_id, user_id) for per-user-app-memory.
///                Spec 017 (2026-05-12): app-class memories named
///                `${app.urn}:${agentSlug}:shared` are the v1 home for
///                SHARED chats (chats readable by every AppMember of
///                the App). Keyed per-(App, Agent) so the multi-Agent
///                App from 2026-05-12-user-installing-app §3 — where
///                one App can install N Agents under the reintroduced
///                AppAgent join — gives each installed Agent its own
///                shared memory. Lazy-provisioned by
///                `findOrCreateAppClassMemory` on the first shared
///                chat for an (App, Agent) pair.
///   knowledge  — reference content the Agent reads from. Per-Agent
///                (not per-App); two installs of the same Agent share
///                the same knowledge memory.
///   personal   — per-user records owned by Memory.userId. App-scoped by
///                (app_id, agent_id, user_id) when provisioned inside an
///                app (the per-App pivot gives Mike-on-two-orgs clean
///                isolation), OR free-standing (app_id/agent NULL) when a
///                user creates it directly (spec 034). Strict ownership.
///   private    — single-owner, owner-only (no MemoryShare path, no
///                ADMIN/OWNER bypass). Spec 034 (#242) made it
///                user-creatable via createMemory — free-standing or
///                app-scoped. May opt into encrypt-at-rest, but the
///                encryption implementation is a deferred follow-up, so
///                **do not rely on at-rest encryption for secrets yet.**
enum MemoryClass {
  system
  app
  knowledge
  personal
  /// 023-app-shape: symmetric team-shared memory. Governance is by
  /// `MemoryMember` (list of users with roles `reader | writer | owner`),
  /// not by a single Memory.userId owner. `Memory.userId IS NULL` for
  /// group-class rows (enforced by `chk_memory_group_no_owner`). The
  /// bidirectional invariant `class = 'group' ⇔ visibility = 'GROUP'`
  /// is enforced by `chk_memory_group_visibility`.
  group
  private
}

/// 023-app-shape: role on a `MemoryShare` row (asymmetric cross-user
/// grant for personal-class memory). `reader` permits read; `writer`
/// permits read and write.
enum MemoryShareRole {
  reader
  writer
}

/// 023-app-shape: role on a `MemoryMember` row (symmetric membership
/// for group-class memory). `reader` permits read; `writer` permits
/// read and write; `owner` adds management capabilities (add/remove
/// members, change roles, delete/rename/configure the Memory) per
/// spec 023 FR-036. The platform protects against zero-owner states:
/// removing or demoting the sole remaining `owner` is rejected with
/// `LAST_OWNER_PROTECTED` (FR-038).
enum MemoryMemberRole {
  reader
  writer
  owner
}

/// Asset virus-scan state. Downloads are gated on CLEAN. Transitions:
/// PENDING → CLEAN | BLOCKED.
enum AssetScanStatus {
  PENDING
  CLEAN
  BLOCKED
}

// ─── Models ────────────────────────────────────────────────────────────

/// A person who uses Hadron, authenticated via GitHub OAuth (or email
/// in future). N:N to Organization via OrgMember. (Spec 048: signup no
/// longer auto-creates a personal organization — an individual owns
/// Apps/Agents/Memories directly via spec 047 user-owned tenancy.)
///
/// **Invitation chain**: UserInvitationActivation links each User back
/// to their UserInvitation, whose senderUserId points to the inviter,
/// recursively up to the root (senderUserId IS NULL = system seed from
/// Baragaun).
///
/// **Referral quota** (`maxReferrals`): the maximum number of new
/// platform users this user is allowed to onboard. Unaccepted
/// invitations don't count; the count is on accepted activations only.
/// Quota is tracked transitively up the chain — if A invites B and B
/// invites C, both A's and B's quotas decrement when C joins. When
/// sending an invite, `UserInvitation.maxActivations` must not exceed
/// the minimum free quota across the inviter's referral chain. There
/// is a known race condition: if a referral starts onboarding and the
/// "create account" request would push the chain over quota, the
/// account is still created (don't block a real human on a counter).
model User {
  id               String            @id @default(cuid())
  /// Unique username, e.g. "holger"; displayed as `@holger` in UI and node
  /// frontmatter `author` field, and the owner namespace of a user-owned
  /// App/Agent/Memory URN (spec 047). NOT NULL (all users backfilled 2026-07-14):
  /// every real signup path assigns one via `generateUniqueHandle`; the
  /// DB-generated random default is a backstop for handle-omitting inserts
  /// (test fixtures) so those need no churn. Case-insensitive uniqueness is the
  /// `users_handle_lower_uniq` functional index (post-push.sql); the `@unique`
  /// here is the plain case-sensitive one.
  handle           String            @unique @default(dbgenerated("\"left\"(md5((random())::text), 12)"))
  /// User-layer action-policy link (cor:acl:040:02) — constrains runs made
  /// on-behalf-of this user. Same allow-list shape as Organization.policy;
  /// NULL = no restriction. Self-authored (updateMyPolicy).
  policy           Json?
  /// GitHub numeric account id.
  githubId         Int?              @unique @map("github_id")
  /// GitHub login.
  githubUsername   String?           @unique @map("github_username")
  /// Google account id — the OIDC `sub` claim (#581). A string of digits,
  /// but stored as text: Google documents it as an opaque string and it
  /// can exceed 2^53.
  googleId         String?           @unique @map("google_id")
  /// Apple account id — the Sign-in-with-Apple `sub` claim (#584). An
  /// opaque team-scoped string (e.g. "001234.abcd1234ef….0102").
  appleId          String?           @unique @map("apple_id")
  identityProvider IdentityProvider? @map("identity_provider")
  // 005-agent-subscription discovery (2026-04-30): R-5 in research.md
  // proposed dropping `externalId`, but the implementation found that
  // `createAppUser` and `startAgentSession` use it as the lookup key
  // for "find the existing User this chatbot already provisioned for
  // external-7." Dropping it would force every chatbot call to create
  // a new User row (no idempotency) or require the chatbot to track
  // the hadron user-id itself on every call. That requires a separate
  // design discussion — restored `externalId` for now; deferred the
  // drop. See spec.md §"Assumptions" for the deferral note.
  /// App-scoped external user id. Composite-unique with `externalAppId`.
  externalId       String?           @map("external_id")
  /// The App that minted this externalId. Forms a (App, externalId)
  /// idempotency key for chatbot user provisioning.
  externalAppId    String?           @map("external_app_id")
  /// When this app-scoped external identity was linked to the
  /// platform User (i.e. when the chatbot user "graduated" to a real
  /// account).
  linkedAt         DateTime?         @map("linked_at")
  name             String?
  /// Used for invite matching and email-based auth.
  email            String?           @unique
  avatarUrl        String?           @map("avatar_url")
  /// Global platform roles (not org-scoped). Default `[READER]`.
  roles            Role[]            @default([READER])
  /// Maximum number of new platform users this user can onboard. See
  /// the model-level doc for the referral-quota semantics.
  maxReferrals     Int?              @map("max_referrals")
  createdAt        DateTime          @default(now()) @map("created_at")
  createdBy        String?           @map("created_by")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  updatedBy        String?           @map("updated_by")
  deletedAt        DateTime?         @map("deleted_at")
  deletedBy        String?           @map("deleted_by")

  memberships               OrgMember[]
  sentInvitations           UserInvitation[]           @relation("SentInvitations")
  invitationActivations     UserInvitationActivation[]
  receivedMemberInvitations OrgMemberInvitation[]      @relation("ReceivedMemberInvitations")
  pendingSetup              PendingSetup?
  exchangeConnections       ExchangeConnection[]
  connectionGrantsByUser    ConnectionGrant[]          @relation("ConnectionGrantsByUser")
  principalGrants           PrincipalGrant[]           @relation("UserPrincipalGrants")
  externalApp               App?                       @relation(fields: [externalAppId], references: [id], onDelete: SetNull)
  sessions                  Session[]                  @relation("SessionUser")
  ownedMemories             Memory[]                   @relation("UserMemoriesOwned")
  // spec 047 (Phase 2b): entities this user is the TENANT owner of (user-owned
  // App/Agent/Memory). `ownedMemories` above is the personal/private strict
  // owner (Memory.userId) — a DIFFERENT relation from `tenantMemories` here.
  ownedApps                 App[]                      @relation("AppOwner")
  ownedAgents               Agent[]                    @relation("AgentOwner")
  tenantMemories            Memory[]                   @relation("MemoryTenantOwner")
  agentSubscriptions        AgentSubscription[]        @relation("UserAgentSubscriptions")
  appMemberships            AppMember[]                @relation("UserAppMemberships")
  // 023-app-shape: per-Memory authorization back-relations.
  memorySharesGranted       MemoryShare[]              @relation("MemorySharesGranted")
  memorySharesByGrantor     MemoryShare[]              @relation("MemorySharesByGrantor")
  memoryMemberships         MemoryMember[]             @relation("MemoryMemberships")
  // 025-oauth-for-mcp: user-level credential + OAuth back-relations.
  userApiKeys               UserApiKey[]
  authCodes                 AuthCode[]
  authHandoffCodes          AuthHandoffCode[]
  // #620: revisions this user approved (NodeRevision.approvedBy).
  approvedNodeRevisions     NodeRevision[]             @relation("NodeRevisionApprover")
  // 046-usage-metering: billing attribution back-relation.
  usageEvents               UsageEvent[]
  // #772: the user's placed /app/dashboard widgets (user-scoped layout config).
  dashboardWidgets          DashboardWidget[]
  // #806: the user's SAVED widget configurations (a palette, not a placement).
  dashboardWidgetPresets    DashboardWidgetPreset[]
  // #692 — the user's root principal in the unified pool (handle is the
  // denormalized read source-of-truth, kept in sync at mint).
  principalId               String?                    @unique @map("principal_id")
  principal                 Principal?                 @relation("UserPrincipal", fields: [principalId], references: [id], onDelete: SetNull)

  @@unique([externalAppId, externalId])
  @@map("users")
}

/// The kinds of widget that can be placed on a user's /app/dashboard grid
/// (#772). Add a member when a new widget ships; each type has a server-side
/// data provider feeding the combined `dashboardWidgetData` query.
enum DashboardWidgetType {
  MEMORY_STATS
  AGENT_STATS
  USAGE_ACTIVITY
}

/// A widget the user has placed on their /app/dashboard grid (#772) —
/// user-scoped layout configuration, one row per placed widget, ordered by
/// `position`. Owner-only: no org, no sharing. The whole set is read via
/// `dashboardWidgets` and replaced atomically via `setDashboardWidgets`.
model DashboardWidget {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  type      DashboardWidgetType
  /// Columns to span on the 12-col desktop grid (clamped on smaller screens).
  span      Int                 @default(4)
  /// Rows to span on the fixed-height row grid (#788; clamped server-side to 1-4).
  rowSpan   Int                 @default(1) @map("row_span")
  /// Widget-instance settings, shape widget-defined (#788) — e.g. a stats
  /// widget scoped to one org. Stored + round-tripped only; no server-side
  /// behavior until dashboardWidgetData goes per-instance.
  config    Json?
  /// 0-based sort order among the user's widgets.
  position  Int                 @default(0)
  createdAt DateTime            @default(now()) @map("created_at")
  createdBy String?             @map("created_by")
  updatedAt DateTime            @updatedAt @map("updated_at")
  updatedBy String?             @map("updated_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@map("dashboard_widgets")
}

/// A named, user-scoped widget configuration (#806) — a palette entry the
/// portal COPIES into a placement's `config` on apply. Deliberately not a live
/// link: editing a preset never reaches back into placements already seeded
/// from it, and deleting one never orphans a placement. Generic over widget
/// types so the next configurable widget inherits the mechanism.
///
/// Owner-only in every direction, like DashboardWidget: no org, no sharing.
model DashboardWidgetPreset {
  id     String              @id @default(cuid())
  userId String              @map("user_id")
  type   DashboardWidgetType
  /// Display name, unique per (user, type). Trimmed, 1-60 chars.
  name   String
  /// The saved settings, shape widget-defined — same 4KB cap and plain-object
  /// guard as a placement's `config`, since it becomes one verbatim.
  config Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, name])
  @@index([userId, type])
  @@map("dashboard_widget_presets")
}

/// A company, team, or group that owns memories and has members.
/// Must have at least one OrgMember with role OWNER (can have many).
model Organization {
  id                           String    @id @default(cuid())
  name                         String
  /// The organization's domain name, e.g. "baragaun.com",
  /// "micromentor.org". Serves as the namespace for all resources
  /// owned by this org (URN prefix).
  urn                          String    @unique
  /// Opt-in marketplace catalogue flag (cor:acl:080:04): whether this org is
  /// advertised in the marketplace browse. DISTINCT from access/visibility —
  /// it governs advertisement, not who may read the org. Contributes to
  /// non-member discoverability (cor:acl:080:02). (Spec 048 dropped the former
  /// `isVisible` listing flag with the auto-personal org — every org now lists.)
  listedOnMarketplace          Boolean   @default(false) @map("listed_on_marketplace")
  /// GitHub App installation id. Used to mint ephemeral tokens
  /// (1-hour expiry) for memory git-sync against repos within this
  /// installation's scope.
  githubInstallationId         Int?      @unique @map("github_installation_id")
  githubAppId                  String?   @map("github_app_id")
  /// AES-256-GCM-encrypted GitHub App private key. Plaintext never
  /// stored or shown after initial entry. Encryption key:
  /// HADRON_ENCRYPTION_KEY env var.
  githubAppPrivateKeyEncrypted String?   @map("github_app_private_key_encrypted")
  createdAt                    DateTime  @default(now()) @map("created_at")
  createdBy                    String?   @map("created_by")
  updatedAt                    DateTime  @updatedAt @map("updated_at")
  updatedBy                    String?   @map("updated_by")
  deletedAt                    DateTime? @map("deleted_at")
  deletedBy                    String?   @map("deleted_by")

  members         OrgMember[]
  memories        Memory[]
  agents          Agent[]
  subscriptions   MemorySubscription[]
  principalGrants PrincipalGrant[]
  /// Org-layer action-policy link of the conjunctive chain (cor:acl:040:02):
  /// allow-list JSON `{ "allow": ["action", "prefix.*", "*"] }`. NULL = no
  /// restriction (the layer is absent, not deny-all). Snapshotted into
  /// AppRun.policy at mint — edits apply to FUTURE runs only.
  policy          Json?

  invitations            UserInvitation[]        @relation("OrgInvitations")
  exchangeConnections    ExchangeConnection[]
  slackConnections       SlackConnection[]
  mcpServers             McpServer[]
  homeAssistantInstances HomeAssistantInstance[]
  resendSender           ResendSender?
  // 046-usage-metering: billing back-relations.
  usageEvents            UsageEvent[]
  creditLedgerEntries    CreditLedgerEntry[]
  apps                   App[]
  agentOrgGrants         AgentOrgGrant[]
  aiServiceConfigs       AiServiceConfig[]
  // #692 — the org's root principal in the unified pool (urn is the denormalized
  // read source-of-truth, kept in sync at mint).
  principalId            String?                 @unique @map("principal_id")
  principal              Principal?              @relation("OrgPrincipal", fields: [principalId], references: [id], onDelete: SetNull)

  @@map("organizations")
}

/// #692 — the unified per-server PRINCIPAL POOL. One row per root name (a user
/// handle OR an organization name), enforcing CROSS-KIND uniqueness by
/// constraint so a URN `<root>` atom resolves to exactly one principal without
/// an `@` sigil or kind marker (GitHub's model). Users and Organizations FK
/// into this; their own `handle` / `urn` columns stay the denormalized read
/// source-of-truth, kept in sync inside the mint transaction.
///
/// A released root name is TOMBSTONED (`status = 'released'`, the owning
/// user/org detached) — the row is kept, and the `name @unique` spans ALL
/// statuses, so a released name is reserved FOREVER (indefinite, no recycling —
/// the identity guarantee the `@`-sigil rename-safety is replaced by). Reserved
/// platform words (`hadron`, `platform`, …) are pre-seeded rows with
/// `status = 'reserved'`. `name` is written lowercased everywhere, so the plain
/// (Prisma-modeled) unique doubles as case-insensitive and backs `findUnique`.
model Principal {
  id         String    @id @default(cuid())
  /// The canonical root name, stored lowercase. `@unique` is a plain (case-
  /// sensitive) index, which is sufficient because every write lowercases the
  /// name (mintPrincipal + the migration backfill) — so it is effectively
  /// case-insensitive AND index-backed for the `findUnique` availability probe.
  /// Spans ALL statuses (no status filter), so a `released` tombstone reserves
  /// its name forever (indefinite, no recycling).
  name       String    @unique
  /// 'user' | 'org' | 'platform'.
  kind       String
  /// 'active' | 'released' (tombstone) | 'reserved' (platform word).
  status     String    @default("active")
  releasedAt DateTime? @map("released_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user         User?         @relation("UserPrincipal")
  organization Organization? @relation("OrgPrincipal")

  @@map("principals")
}

/// Associates a User with an Organization. To remove a User from an
/// Organization, delete the OrgMember row. Must NOT delete the
/// OrgMember if it is the only one with role OWNER (enforced at the
/// resolver, not the schema).
model OrgMember {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  role           Role      @default(READER)
  /// Whether this member can invite other existing platform users to
  /// the organization. Inviting a *new* platform user (UserInvitation)
  /// is governed separately by User.maxReferrals.
  canInvite      Boolean   @default(false) @map("can_invite")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentMemberInvitations OrgMemberInvitation[] @relation("SentByMember")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("org_members")
}

/// A Hadron knowledge graph, owned by an Organization. The four-way
/// `class` field (system / app / knowledge / personal) governs
/// addressing and access — see the MemoryClass enum doc.
///
/// **Git-backed memories** — the root `node.yaml` in the repo is the
/// **memory manifest**, declaring the memory's urn and marketplace
/// metadata. On import the server reads this manifest and creates or
/// updates the Memory row. The org portion of the URN must match an
/// existing Organization on the server.
///
/// **Git authentication** — the server first tries the owning
/// Organization's `githubInstallationId` to mint ephemeral tokens
/// (1-hour expiry). If the repo is outside the GitHub App's scope
/// (different GitHub org, personal repo, GitLab, etc.), the server
/// falls back to `sourceTokenEncrypted`. The GitHub App's private key
/// (used to sign JWT requests for installation tokens) lives in the
/// server's environment/secrets manager — not in the database. For
/// the SaaS server, Baragaun manages this key.
///
/// **Token encryption** — `sourceTokenEncrypted` uses AES-256-GCM
/// with a symmetric key from the server's environment
/// (HADRON_ENCRYPTION_KEY). Plaintext never stored or shown after
/// initial entry. To replace an expired/revoked token, the user
/// pastes a new one (overwrites the old encrypted value). Key
/// rotation: re-encrypt all stored tokens with the new key in a
/// single migration.
model Memory {
  id                  String  @id @default(cuid())
  organizationId      String? @map("organization_id")
  /// The user TENANT owner of a user-owned Memory (rooted on the bare
  /// `<handle>` — #697 v2, no `@` sigil). DISTINCT from `userId` (the
  /// personal/private strict-owner). The exactly-one-of
  /// `organizationId`/`ownerUserId` XOR is ENFORCED — `chk_memory_owner_xor` in
  /// post-push.sql: `(organization_id IS NULL) <> (owner_user_id IS NULL)` — so
  /// exactly one is non-null (the URN backfill dispatches owner KIND off it;
  /// don't add a redundant ambiguity branch).
  ownerUserId         String? @map("owner_user_id")
  ownerUser           User?   @relation("MemoryTenantOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  // 008-agent-installation (2026-05-02), relaxed by 034-memory-class-access and
  // #653: App pivot. Required for class='app'; OPTIONAL for knowledge/group/
  // personal/private (set when app-scoped, NULL when free-standing); forbidden
  // for class='system'. Enforced by the chk_memory_class_app_id CHECK constraint.
  /// The App this memory belongs to. Required when `class` is `app`; optional
  /// for `knowledge`/`group`/`personal`/`private` (set when app-scoped, NULL
  /// when free-standing); NULL for `system`. Enforced by chk_memory_class_app_id
  /// (#653 allowed knowledge + group to attach to an App).
  appId               String? @map("app_id")
  // 005-agent-subscription (2026-04-30), re-keyed onto class by 034: explicit
  // User owner for personal/private-class memories. NULL otherwise. Postgres
  // CHECK enforces: class IN ('personal','private') ⇔ userId IS NOT NULL.
  /// Owning user for personal/private-class memories. Bidirectional invariant
  /// (CHECK chk_personal_visibility_user): `class IN ('personal','private')`
  /// ⇔ `userId IS NOT NULL`.
  userId              String? @map("user_id")
  /// Legacy 005 Agent-pivot for personal memories. **Retained for
  /// backward-compat queries** (008 R-3); not consulted by post-008
  /// access-control, which uses `appId` directly. A future cleanup
  /// spec may collapse it.
  userMemoryOfAgentId String? @map("user_memory_of_agent_id")

  /// Globally unique identifier, e.g. "baragaun.com:secureid".
  /// Derived from `org.urn + ":" + slug`.
  urn                  String            @unique
  /// Human-friendly display name, e.g. "SecureID Service".
  name                 String
  /// One-line summary for marketplace listings and search results.
  shortDescription     String?           @map("short_description")
  /// Full description (markdown); shown when expanding a listing.
  description          String?
  /// Free-form structured metadata for this memory — a client-defined
  /// JSON bag with no server-side semantics. Written via the GraphQL
  /// createMemory / updateMemory mutations; surfaced read-only over MCP
  /// (h-list-memories renders it as a `data:` line). The MCP surface has
  /// no memory-mutation tool, so writes stay GraphQL-only. NULL when unset.
  data                 Json?
  /// #725 — opt-in per-memory PROPERTY SCHEMA (structured storage): the
  /// collections (object types) this memory declares and each one's typed
  /// fields. A dedicated column (NOT nested in `data`) so a schema'd memory is
  /// visible at a glance. Shape + well-formedness validated by
  /// src/lib/memorySchema.ts; authored via updateMemory (GraphQL/portal),
  /// read-only over MCP for discovery. NULL ⇒ no schema (unstructured). Node
  /// `properties`/`objectType` are validated against it in the enforcement
  /// phase (a later PR) — free-form until then.
  schema               Json?
  /// Classification tags for search and filtering.
  tags                 String[]
  /// License identifier (e.g. "MIT", "CC-BY-4.0", "proprietary").
  license              String?
  /// Primary category (e.g. "Developer Tools").
  category0            String?           @map("category_0")
  /// Secondary category (e.g. "Backend").
  category1            String?           @map("category_1")
  /// Tertiary category (e.g. "Node.js").
  category2            String?           @map("category_2")
  /// Square icon/logo URL for listings.
  iconUrl              String?           @map("icon_url")
  /// Banner image URL for the detail page.
  heroUrl              String?           @map("hero_url")
  /// External homepage or documentation URL.
  homeUrl              String?           @map("home_url")
  /// Git clone URL; null = DB-only mode (no git backing).
  source               String?
  /// AES-256-GCM-encrypted access token for repos not covered by the
  /// org's GitHub App installation (e.g. personal repos, GitLab,
  /// Bitbucket). Plaintext never stored or displayed after initial entry.
  sourceTokenEncrypted String?           @map("source_token_encrypted")
  /// Expiry of the stored token; server warns via MemoryLogEntry
  /// before expiration.
  sourceTokenExpiresAt DateTime?         @map("source_token_expires_at")
  /// Branch to clone/pull from (default: repo default branch).
  readBranch           String?           @map("read_branch")
  /// Branch for mutations (default: "hadron-updates").
  writeBranch          String?           @map("write_branch")
  /// 035-visibility-enum-cleanup: nullable, no default. Set only for
  /// `knowledge` (PUBLIC/ORGANIZATION) and `group` (GROUP); NULL for
  /// system/app/personal/private (enforced by chk_memory_visibility_class).
  visibility           MemoryVisibility?
  /// Opt-in marketplace catalogue flag (cor:acl:080:04): whether this memory is
  /// advertised in the marketplace browse. DISTINCT from `visibility` — PUBLIC
  /// governs access (reachable by URN), this governs advertisement. "Unlisted
  /// but public" is valid; contributes to the owner org's discoverability
  /// (cor:acl:080:02).
  listedOnMarketplace  Boolean           @default(false) @map("listed_on_marketplace")
  /// Whether the memory's contents (including asset bytes) are
  /// encrypted at rest using AES-256-GCM under HADRON_ENCRYPTION_KEY.
  isEncrypted          Boolean           @default(false) @map("is_encrypted")
  // 005-agent-subscription (2026-04-30): four-way memory typology. Required
  // post-migration; backfilled by the migration's UPDATE statements.
  /// Per-class governance — see MemoryClass enum doc for the four
  /// classes and their addressing rules.
  class                MemoryClass
  /// When an anonymous (pre-account-creation) memory expires and is
  /// reaped by the janitor. NULL for non-anonymous memories.
  anonymousExpiresAt   DateTime?         @map("anonymous_expires_at")
  /// If true, any subscription must have a valid MemoryLicense.
  requiresLicense      Boolean           @default(false) @map("requires_license")
  /// Last successful git sync.
  lastSyncedAt         DateTime?         @map("last_synced_at")
  syncStatus           SyncStatus        @default(PENDING) @map("sync_status")
  /// Error message from the last failed sync.
  syncError            String?           @map("sync_error")
  /// Number of unresolved PendingEdge records (denormalized for
  /// dashboard display).
  pendingEdgeCount     Int               @default(0) @map("pending_edge_count")
  // 006-asset-upload-redesign (2026-05-01): per-memory upload acceptance
  // flag. Default true at the column level; system-class memories must
  // opt out explicitly at creation time. Migration backfilled existing
  // rows by class (system → false; app/knowledge/personal → true).
  /// Whether this memory accepts asset uploads. system-class memories
  /// typically opt out.
  acceptsUploads       Boolean           @default(true) @map("accepts_uploads")
  // ─── 033-rag-vector-retrieval: per-memory vector-index config ───
  /// Opt-in: when true, this memory's nodes are vector-indexed. DB default is
  /// `false`; the **class-derived default** is applied at createMemory — a
  /// `knowledge`-class, non-encrypted memory is created with `true`, all other
  /// classes and any encrypted memory stay `false` (FR-001). Flippable per memory.
  vectorIndexEnabled   Boolean           @default(false) @map("vector_index_enabled")
  /// What the vector index is built from. Memory property, NOT a query
  /// parameter (FR-002). Only meaningful when vectorIndexEnabled.
  embeddingSource      EmbeddingSource   @default(abstract) @map("embedding_source")
  /// Per-memory chunking dials (FR-003). NULL ⇒ platform default (512 / 64).
  /// Consulted only when embeddingSource includes chunks.
  chunkTokens          Int?              @map("chunk_tokens")
  chunkOverlap         Int?              @map("chunk_overlap")
  /// Force fixed-size chunking, bypassing structure-aware (FR-015).
  forceFixedSize       Boolean           @default(false) @map("force_fixed_size")
  /// #621 — cap on how many NodeRevision rows are kept per node in this
  /// memory. On each new revision the oldest overflow is pruned. Must be >= 1
  /// (chk_memory_max_rev_count_positive); default 10.
  maxRevCount          Int               @default(10) @map("max_rev_count")
  /// Spec 041 (D-2026-07-06-B) — passphrase-derivation material for a
  /// caller-held-key encrypted memory. Parameters, NOT secrets: salt
  /// (base64) + scrypt params. NULL when the memory was encrypted with a
  /// raw data key (no passphrase) or is not encrypted.
  kdfSalt              String?           @map("kdf_salt")
  kdfParams            Json?             @map("kdf_params")
  /// enc:v1 encryption of a fixed check string under the data key — lets
  /// every unlock verify the supplied key WITHOUT touching node rows
  /// (wrong passphrase = typed WRONG_KEY, never garbage plaintext). The
  /// server still never holds the key itself.
  keyVerifier          String?           @map("key_verifier")

  /// Timestamp the owner acknowledged the embedding-inversion disclosure for an
  /// ENCRYPTED memory (FR-026). NULL ⇒ not acknowledged. Gates encrypted-memory
  /// indexing via chk_memory_vector_encrypted_ack.
  vectorIndexEncryptedAckAt DateTime? @map("vector_index_encrypted_ack_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  createdBy                 String?   @map("created_by")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  updatedBy                 String?   @map("updated_by")
  deletedAt                 DateTime? @map("deleted_at")
  deletedBy                 String?   @map("deleted_by")

  organization             Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodes                    Node[]
  edges                    Edge[] // first-class edges, scoped via denormalized memoryId
  embeddings               NodeEmbedding[] // 033: per-memory vectors (denormalized memoryId)
  assets                   Asset[]
  subscriptions            MemorySubscription[]
  agentItems               AgentMemoryItem[]
  licenses                 MemoryLicense[]
  /// Online URN-shape migration gate (spec 021 FR-032, repurposed for the #697
  /// v1→v2 emission flip). Null = pre-normalization row; set = row normalized
  /// onto the flat v2 form (`<root>:<slug>`, single colon). Transient.
  /// TODO(spec-021-cleanup): drop once the FR-032 migration completes.
  urnNormalizedAt          DateTime?            @map("urn_normalized_at")
  /// Spec 021 sentinel for data-defect rows during the FR-032 migration.
  /// TODO(spec-021-cleanup): drop alongside urnNormalizedAt.
  urnMigrationFailedReason String?              @map("urn_migration_failed_reason")
  /// #697 stored alias map: the pre-v2 (v1) URN this row was migrated FROM.
  /// Null until the online migration flips `urn` to the flat v2 form; then a
  /// legacy input (wikilink, export, external link) resolves to this row by
  /// matching `legacyUrn`. Indexed, non-unique — resolution disambiguates a
  /// rare collision to the live row, else a typed error. Transient with the
  /// migration; TODO(#697-cleanup): drop once every reference is v2-native.
  legacyUrn                String?              @map("legacy_urn")

  logEntries        MemoryLogEntry[]
  userMemoryOfAgent Agent?           @relation("UserMemoriesOfAgent", fields: [userMemoryOfAgentId], references: [id], onDelete: SetNull)
  user              User?            @relation("UserMemoriesOwned", fields: [userId], references: [id], onDelete: SetNull)
  // 008-agent-installation: hard App deletion cascades to its personal/app
  // memories (per data-model.md "Cascade behavior"). The CHECK constraint
  // prohibits app_id IS NULL for class IN ('app', 'personal'), so SET NULL
  // would leave the row in an invalid state on delete. AppMember removal
  // (orphan retention per FR-015) is independent — that's a row delete in
  // app_members, not in apps.
  app               App?             @relation("AppMemories", fields: [appId], references: [id], onDelete: Cascade)
  sessions          Session[]        @relation("SessionMemory")
  // 023-app-shape: per-Memory authorization primitives.
  // `shares`      — populated only when `class = 'personal'` (FR-018);
  //                 cross-user grants (asymmetric).
  // `memberships` — populated only when `class = 'group'` (FR-027);
  //                 symmetric team membership.
  shares            MemoryShare[]
  memberships       MemoryMember[]

  @@index([organizationId])
  @@index([userMemoryOfAgentId])
  @@index([anonymousExpiresAt])
  @@index([userId])
  @@index([appId])
  @@index([ownerUserId])
  @@index([legacyUrn])
  @@map("memories")
}

/// A user-uploaded file (document, image) bound to a Memory. Bytes
/// live in object storage (Cloudflare R2 in v1; MinIO for local dev);
/// this row carries metadata, the storage pointer, and virus-scan
/// state. Spec: `hadron-concept/spec-kits/specs/004-asset-upload/spec.md` (sister repo).
///
/// **Why a separate table (not a `nodeType`)**: normalization (asset
/// and node schemas diverge), scale (raw-material assets shouldn't
/// bloat the knowledge-node table), and FK-shape (containment is
/// foreign-key-shaped, not graph-shaped). See
/// `hadron-concept/design-discussions/hadron-platform/2026-04-28-asset-upload-design/010-summary.md`
/// (sister repo) §"Why this summary supersedes 007-summary.md".
///
/// **URN form**: `<memory.urn>:assets:<asset.id>` resolves to this row.
///
/// **Cross-references from nodes** are reserved for a future spec —
/// `Node.attachedAssetId?` (one-asset case) or a `node_assets` join
/// (many-to-many). Not in v1.
model Asset {
  id          String          @id @default(cuid())
  // 006-asset-upload-redesign (2026-05-01): nullable to support staging.
  // An asset with memoryId IS NULL is "staged" — uploaded but not yet
  // attached to a memory. Janitor sweeps staged assets past the 24h TTL.
  /// The Memory this asset belongs to; NULL while the asset is staged
  /// (uploaded but not yet attached). Janitor sweeps staged assets
  /// past the 24h TTL.
  memoryId    String?         @map("memory_id")
  /// Original filename as supplied by the user. Never appears in
  /// `storageKey`.
  filename    String
  /// RFC 6838 type/subtype.
  mimeType    String          @map("mime_type")
  /// Verified at complete-upload time against `HeadObject.contentLength`.
  sizeBytes   Int             @map("size_bytes")
  // Object-store key. Encrypted at rest (AES-256-GCM under
  // HADRON_ENCRYPTION_KEY) when the memory is encrypted; plaintext
  // otherwise. See src/lib/asset/encryption.ts.
  /// Object-store key shape: `{orgUrn}/{memoryUrn-segment}/{assetId}.{ext}`.
  /// Encrypted at rest when the memory is encrypted; plaintext otherwise.
  storageKey  String          @unique @map("storage_key")
  /// Virus scan state. Downloads gated on CLEAN.
  scanStatus  AssetScanStatus @default(PENDING) @map("scan_status")
  /// Optional; agent- or user-provided.
  description String?
  uploadedAt  DateTime        @default(now()) @map("uploaded_at")
  /// fk to User.id — who uploaded. NULL when the asset was created
  /// server-side by an app run with no on-behalf-of user
  /// (hadron_store_file); the run id is recorded on the asset's
  /// reference node and in the audit log.
  uploadedBy  String?         @map("uploaded_by")
  /// Soft-delete marker. Janitor sweeps R2 object + hard-deletes
  /// after 24h.
  deletedAt   DateTime?       @map("deleted_at")

  memory Memory? @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId, scanStatus, uploadedAt(sort: Desc)])
  // 006-asset-upload-redesign: two partial indexes for staged assets
  // (WHERE memory_id IS NULL) live in the migration SQL only — Prisma
  // schema syntax can't express WHERE clauses on @@index. See
  // prisma/migrations/20260501000000_memory_uploads_and_staged_assets/migration.sql:
  //   - assets_uploaded_by_staged_idx (per-user staged listing)
  //   - assets_staged_uploaded_at_idx (janitor TTL sweep)
  @@map("assets")
}

/// A single node in a Memory. `loc` is the colon-delimited path
/// within the memory (e.g. `auth:tokens`), memory-relative. The full
/// URN is computed `memory.urn + ":" + loc` (e.g.
/// `baragaun.com:secureid:auth:tokens`) and **not stored**. `id` is
/// optional in YAML; the server assigns it on import if missing.
///
/// **Node types** define the node's role in the memory:
///   - `info` (default)  — living knowledge: specs, guides, facts.
///                         Shown in tree, normal search priority.
///   - `abstract`        — condensed knowledge: summaries, TL;DRs,
///                         paper abstracts. Highest search priority.
///                         May be the only representation if the source
///                         is archived.
///   - `reference`       — external source: papers, URLs, legislation,
///                         books. Carries metadata (DOI, ISBN, URL) in
///                         `data`.
///   - `record`          — immutable history: chat messages, session
///                         logs. Hidden in tree by default, low search
///                         priority.
///   - `system`          — agent configuration: conversation designs,
///                         stages, prompt templates, partials. Hidden
///                         in tree, excluded from search.
/// (The earlier `asset` node-type was promoted to its own Asset table
/// in spec 004-asset-upload.)
///
/// **Column type is `String` (not enum)** because the running schema
/// pre-dates the formalization; the intended-values list above is the
/// contract — tightening to a Prisma enum is reserved for a future
/// cleanup spec.
///
/// **Chat-root `data.scope`** (spec 017, 2026-05-12) — chat-root nodes
/// (loc `chats:<id>`, depth 2, nodeType `record`) carry a `scope` field
/// in `data` recording the chat's visibility tier (`private` | `shared`).
/// Set at chat creation and immutable thereafter (FR-002).
/// Denormalized from `Memory.class` for chat-list query performance;
/// MUST stay consistent with the holding memory's class per the
/// invariant validator in `src/api/graphql/schema/chat-scope.ts`.
model Node {
  /// UUIDv7 from `node.yaml` when supplied by the importer (stable across
  /// moves); falls back to `cuid()` for inserts that omit `id`.
  id                 String    @id @default(cuid())
  memoryId           String    @map("memory_id")
  /// See the node-types list in the model doc. Default `info`.
  nodeType           String    @default("info") @map("node_type")
  /// #725 — collection discriminator (the MongoDB-collection equivalent): which
  /// domain object this node is an instance of, e.g. "competitor" / "insight".
  /// Orthogonal to `nodeType` (the platform-kind axis). NULL for an ordinary
  /// node. When set on a schema-governed memory it must name a declared object
  /// type (enforced at write time — a later phase); free-form until then.
  objectType         String?   @map("object_type")
  /// Human-friendly display name of this node.
  name               String
  /// Alternative name.
  alias              String?
  /// Colon-delimited path within the memory (e.g. "auth:tokens").
  loc                String
  isLink             Boolean   @default(false) @map("is_link")
  description        String?
  /// Paragraph-length summary of this node. Cap is 2000 characters,
  /// enforced at the API boundary (not as a DB CHECK — caps are
  /// validation, not invariants). Surfacing rules across MCP tools
  /// (find/read/list/validate), the `Source: abstract-fallback` marker
  /// on `h-read-node` content-scope fallback, and the RAG-substrate
  /// motivation are documented in spec 031 (FR-005 + edge cases). That
  /// is the load-bearing reference; this comment is the cold-read
  /// pointer for someone scanning the schema.
  abstract           String?
  /// The topic content (topic.md full text).
  content            String?
  /// SHA256(yaml+md)[0:8] for change detection. Set by external
  /// producers (YAML frontmatter via importer, Git sync). UNCHANGED by
  /// spec 032 — that spec adds `abstractOriginHash` below as a separate
  /// column with its own domain (SHA256(content)[0:8]); the two are
  /// never compared against each other.
  contentHash        String?   @map("content_hash")
  /// Spec 032 — fingerprint of `content` value at the time `abstract`
  /// was authored. SHA-256 of plaintext content truncated to 8 hex
  /// chars (same width as `contentHash`, different domain). At read
  /// time, compared against `computeContentHash(node.content)` (via
  /// `src/lib/contentHash.ts`) to detect staleness; when the two
  /// values differ AND `abstractOriginHash` is non-null, the abstract
  /// may not reflect current content. Surfaced by `h-read-node`'s
  /// `Source: abstract-stale` marker, `h-validate`'s `[stale-abstract]`
  /// warning, and the upcoming RAG layer. System-managed: never
  /// settable via GraphQL `NodeInput`.
  abstractOriginHash String?   @map("abstract_origin_hash")
  // ─── 033-rag-vector-retrieval: durable embedding-queue markers ───
  /// Set when this node needs (re-)embedding; cleared on success. The single
  /// work signal the embedding worker drains (FR-006/FR-007). Operational
  /// state only — intentionally NOT versioned on NodeRevision.
  embeddingPendingAt DateTime? @map("embedding_pending_at")
  /// Set when an embed attempt failed (record, not a work signal). Transient
  /// failures keep pending set for retry; permanent failures clear pending (FR-009).
  embeddingFailedAt  DateTime? @map("embedding_failed_at")
  /// Attempt counter for backoff / give-up. Non-null; reset to 0 on success/revoke.
  embeddingAttempts  Int       @default(0) @map("embedding_attempts")
  /// Last embed error (diagnosability; surfaced by h-validate).
  embeddingError     String?   @map("embedding_error")
  /// Number of input tokens.
  tokens             Int?
  /// Classification tags.
  tags               String[]
  /// Typed key-value structured data; queryable via the API.
  properties         Json?
  /// Structured JSON on the node; used for template-variable
  /// resolution, user profiles, extracted facts, reference metadata.
  /// Returned by `h-get-data`, set by `h-set-data`.
  data               Json?
  /// Sort order among sibling nodes (lower values come first); used
  /// by `h-read-next-node` and portal drag-and-drop reordering.
  seq                Int?
  /// GitHub repo slug (e.g. "micromentor/mmdata").
  ownerRepo          String?   @map("owner_repo")
  /// If true, this node can be executed as a task.
  isRunnable         Boolean?  @map("is_runnable")
  /// LLM model that created or last modified this node (e.g.
  /// "claude-opus-4-6", "gpt-4o").
  llmModel           String?   @map("llm_model")
  /// AI agent tool that created or last modified this node (e.g.
  /// "claude-code", "cursor", "hadron-portal").
  aiAgent            String?   @map("ai_agent")
  /// #696: the per-node revision counter. Atomically incremented (the
  /// QuotaCounter pattern) inside the tx that writes each NodeRevision, so the
  /// value it yields is that snapshot's monotonic `revNo` — race-safe, unlike a
  /// read-max-then-+1. Backfilled to the node's current revision count.
  revSeq             Int       @default(0) @map("rev_seq")
  createdAt          DateTime  @default(now()) @map("created_at")
  createdBy          String?   @map("created_by")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  updatedBy          String?   @map("updated_by")
  deletedAt          DateTime? @map("deleted_at")
  deletedBy          String?   @map("deleted_by")

  memory        Memory          @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  outgoingEdges Edge[]          @relation("SourceNode")
  incomingEdges Edge[]          @relation("TargetNode")
  pendingEdges  PendingEdge[]
  usageEvents   UsageEvent[]
  revisions     NodeRevision[]
  embeddings    NodeEmbedding[] // 033: 1 abstract row + N chunk rows; Cascade delete

  @@unique([loc, memoryId])
  @@index([loc])
  @@index([memoryId])
  // Graph-view scale path (#466): memoryNodes runs
  // `WHERE memory_id = ? ORDER BY loc LIMIT/OFFSET`. This composite lets
  // Postgres seek to the memory's rows AND return them loc-ordered without a
  // separate sort or a full loc-index scan across other memories.
  @@index([memoryId, loc])
  // #725 — "list all nodes of collection X in this memory" (the objectType
  // facet). objectType is NULL for most nodes; the composite seeks a memory's
  // typed rows directly.
  @@index([memoryId, objectType])
  @@map("nodes")
}

/// 033-rag-vector-retrieval: what a memory's vector index is built from
/// (per-memory property, not a query parameter — FR-002).
enum EmbeddingSource {
  abstract // default — embed Node.abstract
  contentChunks @map("content_chunks") // embed content chunks
  both // embed both
}

/// 033-rag-vector-retrieval: kind of a stored vector.
enum EmbeddingKind {
  abstract // one row per node — vector of Node.abstract
  chunk // N rows per node — vector of one content chunk
}

/// 033-rag-vector-retrieval: a stored embedding vector for a node's abstract
/// or one of its content chunks. Vectors are computed on plaintext at write
/// time (FR-027) and stored plaintext (pgvector). The `embedding` column is
/// `Unsupported("vector(768)")` — Prisma has no native vector type, so it is
/// NEVER read/written through the generated client; all access is raw SQL
/// (`$queryRaw`/`$executeRaw`). The HNSW index + abstract partial-unique index
/// live in the migration + post-push.sql (not expressible in Prisma schema).
model NodeEmbedding {
  id         String                      @id @default(cuid())
  nodeId     String                      @map("node_id")
  /// Denormalized for fast per-memory similarity filtering (search filters by
  /// memory before ORDER BY distance).
  memoryId   String                      @map("memory_id")
  kind       EmbeddingKind
  /// Embedding provider — "local" | "openai" | "voyage" … v1 is always "local".
  provider   String
  /// Stored model id (FR-014) — e.g. "nomic-embed-text-v1.5". Forward-compat
  /// for a deliberate re-embed when the platform model changes.
  model      String
  /// Vector dimension (sanity / forward-compat guard).
  dim        Int
  // ── chunk-only locators (NULL for kind = abstract); FR-016 ──
  chunkIndex Int?                        @map("chunk_index")
  charStart  Int?                        @map("char_start")
  charEnd    Int?                        @map("char_end")
  chunkText  String?                     @map("chunk_text")
  // ── the vector — pgvector; Prisma has no native type ──
  // Declared OPTIONAL (and nullable in the DB) on purpose: a REQUIRED Unsupported
  // field drops the model from Prisma's client create/upsert and breaks the
  // $allModels extension in src/integrations/db/client.ts. Keeping schema and DB
  // both nullable means migrations and schema.prisma agree (the migration-smoke
  // test). Rows are only ever inserted via raw SQL, which always supplies the
  // vector, so a NULL embedding never occurs in practice.
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now()) @map("created_at")

  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([nodeId, kind, chunkIndex]) // dedupes CHUNK rows; abstract uniqueness via partial index (post-push.sql)
  @@index([nodeId])
  @@index([memoryId])
  @@map("node_embeddings")
}

/// Directed edge between two Nodes. The `label` describes the
/// relationship — e.g. "imports", "depends_on", "related-to", "cites",
/// "abstract-of". An edge whose target is not yet synced lives in
/// PendingEdge until the target arrives.
/// A directed Node→Node relation, upgraded to a first-class, addressable
/// entity (it has its own URN `hrn:edge:<root>:<memory>:<loc>`). Edges
/// drive task execution/automation and the chatbot/conversation platform,
/// not just describe graph relationships.
model Edge {
  id          String    @id @default(cuid())
  /// Denormalized from the SOURCE node's memory so `loc` can be made
  /// unique within a memory (a unique index can't span the source-node
  /// table). For cross-memory edges this is the source's memory.
  memoryId    String    @map("memory_id")
  sourceId    String    @map("source_id")
  targetId    String    @map("target_id")
  /// Colon-delimited path within the memory — the edge's identity and
  /// the suffix of its URN (`hrn:edge:<root>:<memory>:<loc>`). Required;
  /// derived from the endpoints + name when not authored (see
  /// `src/lib/edgeLoc.ts`). Mirrors `Node.loc`.
  loc         String
  /// Free-form relationship name (e.g. imports, depends_on, abstract-of).
  /// Optional since spec-037 — `loc` is now the identity. (Was `label`.)
  name        String?
  /// Human-readable description of the edge (parity with `Node.description`).
  description String?
  /// If true, this edge can be executed/run (task automation, conversation
  /// transitions). Mirrors `Node.isRunnable`.
  isRunnable  Boolean?  @map("is_runnable")
  // Edge-condition spec: JSONLogic gating expression. Null = always fires.
  // Validated server-side at save and evaluate time. See
  // src/lib/edge-conditions/.
  /// JSONLogic gating expression evaluated by the shared
  /// edge-condition evaluator at edge-resolution time. NULL means the
  /// edge always fires. Validated against the v1 operator subset and
  /// the five variable scopes (`memory.*`, `chat.*`, `agent.*`,
  /// `message.data.*`, `now()` / `today()`). Spec:
  /// `hadron-concept/spec-kits/specs/001-edge-condition-spec/spec.md`
  /// (sister repo). User docs:
  /// https://docs.hadronmemory.com/reference/edge-conditions/.
  condition   Json?
  // Stable ordering hook (lower = earlier). Future agent-exceptions
  // feature uses this so handler edges can sit at the top of the
  // resolution order without re-architecting.
  /// Resolution-order hook for edges sharing a source node; lower
  /// fires first, ties broken by insertion order. Reserved space for
  /// the future agent-exceptions feature to slot handler edges at the
  /// top.
  priority    Int       @default(0)
  /// Free-form structured payload on the edge (e.g. transition
  /// metadata for conversation-design edges).
  data        Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  source Node   @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target Node   @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([loc, memoryId])
  @@index([memoryId])
  @@index([targetId])
  // Graph-view scale path (#466): memoryEdges runs
  // `WHERE memory_id = ? ORDER BY loc LIMIT/OFFSET` (plus endpoint-liveness
  // joins). Same memory-scoped, loc-ordered seek as nodes_memory_id_loc_idx.
  @@index([memoryId, loc])
  @@map("edges")
}

/// An edge whose target Node has not been synced yet; stored without
/// a foreign key to the target. When the target Node is synced, the
/// PendingEdge is converted to a regular Edge.
model PendingEdge {
  id        String    @id @default(cuid())
  sourceId  String    @map("source_id")
  /// Intended target node id — **NOT a foreign key**; resolved at
  /// promotion time.
  targetId  String    @map("target_id")
  /// Edge loc carried so an authored loc survives until promotion; the
  /// promoted Edge derives one when this is null. (Mirrors `Edge.loc`.)
  loc       String?
  /// Free-form relationship name (was `label`).
  name      String?
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  source Node @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([targetId])
  @@map("pending_edges")
}

/// Tracks a unit of work by an App: an AI/agent conversation, a
/// chatbot interaction, an automation run. Sessions are the top-level
/// tracking concept; UsageEvent rows are recorded within a session.
model Session {
  id              String      @id // caller-generated (e.g. UUID from h-start-session)
  type            SessionType @default(DEVELOPER)
  appId           String?     @map("app_id")
  /// The User this session is attributed to (typically the end-user
  /// in a chatbot/automation session; the developer in a DEVELOPER
  /// session).
  userId          String?     @map("user_id")
  /// The Agent driving the session (NULL for free-form developer
  /// sessions not tied to a specific Agent).
  agentId         String?     @map("agent_id")
  /// The active write-memory for this session, when there's an
  /// unambiguous one. Resolves the multi-writable-memory ambiguity.
  memoryId        String?     @map("memory_id")
  /// Hard expiry; the janitor reaps sessions past this point.
  expiresAt       DateTime?   @map("expires_at")
  /// Git repo slug.
  repo            String?
  /// Git branch name at session start.
  branch          String?
  /// GitHub PR number.
  prNumber        Int?        @map("pr_number")
  /// Tenant/customer identifier (free-form, supplied by the App).
  customerId      String?     @map("customer_id")
  /// Spoken ("en", "es") or programming language.
  language        String?
  /// The execution plan, when one was prepared.
  plan            String?
  /// LLM model used (e.g. "claude-opus-4-6").
  llmModel        String?     @map("llm_model")
  /// Total prompt tokens across the session.
  inputTokens     Int?        @map("input_tokens")
  /// Total completion tokens across the session.
  outputTokens    Int?        @map("output_tokens")
  /// Number of human-AI exchanges.
  turnCount       Int?        @map("turn_count")
  /// Failed tool calls / action runs.
  errorCount      Int?        @map("error_count")
  /// Sub-agent vertical relation (this session was spawned by a parent).
  parentSessionId String?     @map("parent_session_id")
  /// Chain horizontal relation (linked journey — this session
  /// continues from a previous one).
  prevSessionId   String?     @map("prev_session_id")
  /// AI-composed summary at session end.
  summary         String?
  /// 0.0-1.0, reported externally.
  outcome         Float?
  /// GUID or URL of authoritative outcome record.
  outcomeRef      String?     @map("outcome_ref")
  /// Domain-specific outcome detail.
  outcomeMeta     Json?       @map("outcome_meta")
  startedAt       DateTime    @default(now()) @map("started_at")
  endedAt         DateTime?   @map("ended_at")
  /// Set if the session was auto-expired due to inactivity (vs.
  /// explicitly ended).
  autoExpiredAt   DateTime?   @map("auto_expired_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  createdBy       String?     @map("created_by")
  updatedAt       DateTime?   @updatedAt @map("updated_at")
  updatedBy       String?     @map("updated_by")
  deletedAt       DateTime?   @map("deleted_at")
  deletedBy       String?     @map("deleted_by")

  events       UsageEvent[]
  parent       Session?     @relation("SubAgentSessions", fields: [parentSessionId], references: [id], onDelete: SetNull)
  subSessions  Session[]    @relation("SubAgentSessions")
  prev         Session?     @relation("SessionChain", fields: [prevSessionId], references: [id], onDelete: SetNull)
  nextSessions Session[]    @relation("SessionChain")
  app          App?         @relation(fields: [appId], references: [id], onDelete: SetNull)
  user         User?        @relation("SessionUser", fields: [userId], references: [id], onDelete: SetNull)
  agent        Agent?       @relation("SessionAgent", fields: [agentId], references: [id], onDelete: SetNull)
  memory       Memory?      @relation("SessionMemory", fields: [memoryId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([repo])
  @@index([customerId])
  @@index([startedAt])
  @@index([parentSessionId])
  @@index([prevSessionId])
  @@index([appId, userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Record of a single operation within a Session (read, write,
/// action run, edge traversal, session summary).
///
/// **Column `type` is `String` (not enum)** — intended values:
/// `read | write | action-run | edge-traversal | session-summary`.
/// Tightening to a Prisma enum is reserved for a future cleanup spec.
model UsageEvent {
  id             String    @id @default(cuid())
  type           String
  /// Stored directly so the event survives node deletion.
  nodeLoc        String?   @map("node_loc")
  /// Set null on node deletion.
  nodeId         String?   @map("node_id")
  /// Memory the event is attributed to (#796). Stored DIRECTLY at write time
  /// like `nodeLoc` — deliberately NO relation, unlike this model's five other
  /// FKs. Those are all `SetNull`, and memory-scoped analytics used to reach
  /// the memory by joining through `node`, so deleting a node silently erased
  /// the event from its memory's history. A `SetNull` FK here would recreate
  /// that loss one level up (on memory deletion), which is exactly what this
  /// column exists to prevent.
  memoryId       String?   @map("memory_id")
  /// Set null on session deletion.
  sessionId      String?   @map("session_id")
  /// The App that authored this event.
  appId          String?   @map("app_id")
  /// Key-value args when `type = 'action-run'`.
  actionArgs     Json?     @map("action_args")
  /// LLM model used for this specific event.
  model          String?
  /// Input tokens consumed.
  tokensIn       Int?      @map("tokens_in")
  /// Output tokens generated.
  tokensOut      Int?      @map("tokens_out")
  // ── 046-usage-metering (billing Phase 0) ──────────────────────────────
  /// The on-behalf-of user (billing attribution). Nullable — pure-App
  /// service runs have no user. Distinct from the audit `createdBy` string.
  userId         String?   @map("user_id")
  /// The billable organization. Set on every metered event so ledger
  /// attribution never needs a join through App.
  organizationId String?   @map("organization_id")
  /// LLM provider that served the call — `model` alone is ambiguous
  /// across providers (e.g. claude via anthropic vs bedrock).
  provider       String?
  /// AiConfigOwnerType of the API key that served the call
  /// (HADRON_SERVER | ORGANIZATION | APP | AGENT). Only HADRON_SERVER
  /// spend is platform-paid and thus debitable; BYOK is observability-only.
  keyOwnerType   String?   @map("key_owner_type")
  /// Provider cost snapshot in micro-cents (1e-8 USD), computed from the
  /// AiModelPrice row effective at event time. NULL = no price known (or the
  /// event carries no tokens). Never recomputed — prices change (FR-003).
  costMicroCents BigInt?   @map("cost_micro_cents")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  node         Node?         @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  session      Session?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  app          App?          @relation(fields: [appId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([nodeLoc])
  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
  @@index([appId])
  /// #796 — the two `usageActivity` scopes. Both are composite on `createdAt`
  /// so the bucketed aggregation is an index range scan; the composite
  /// `(userId, createdAt)` also prefix-covers the plain `userId` lookups the
  /// bare index used to serve, so that one was dropped.
  @@index([userId, createdAt])
  @@index([memoryId, createdAt])
  @@index([organizationId, createdAt])
  @@map("usage_events")
}

/// **The Agent definition** — what a Builder creates and what the
/// marketplace sells. One Agent row holds the canonical conversation
/// design (system memory), the default AI config, the declared
/// memory-provisioning policy, and the declared installation policy.
/// Spec: 008-agent-installation (2026-05-02).
///
/// An **App** is the *deployment* of an Agent in some org. The Agent
/// is what is shared across installations; the App is what
/// authenticates, holds members, and accumulates per-deployment data.
/// (PWA analogy: you build an Agent, and when someone installs it,
/// the running instance is called an App.)
///
/// Examples: "Mealplan" (the Agent your family meal planner is built
/// from), "Juno" (the mentee chat agent shared across MicroMentor
/// orgs).
model Agent {
  id                   String          @id @default(cuid())
  organizationId       String?         @map("organization_id")
  /// User owner of a user-owned Agent (rooted on the bare `<handle>` — #697 v2,
  /// no `@` sigil). The org/owner XOR is ENFORCED — `chk_agent_owner_xor` in
  /// post-push.sql: `(organization_id IS NULL) <> (owner_user_id IS NULL)` — so
  /// exactly one of `organizationId`/`ownerUserId` is non-null.
  ownerUserId          String?         @map("owner_user_id")
  ownerUser            User?           @relation("AgentOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// Globally unique identifier (e.g. "micromentor.org:juno");
  /// derived from `org.urn + ":" + slug`.
  urn                  String          @unique
  /// Display name of this agent.
  name                 String
  description          String?
  /// System prompt sent to the LLM at session start.
  systemPrompt         String?         @map("system_prompt")
  /// Memory containing conversation designs (stages, prompts,
  /// partials). Universally read-only from any App context post-008
  /// (DEVELOP-from-App is dropped per R-10); edits happen in the
  /// Agent ownership surface.
  systemMemoryId       String?         @map("system_memory_id")
  /// PUBLIC | ORGANIZATION | PERSONAL (035-visibility-enum-cleanup gave
  /// agents their own enum). PERSONAL is the creator-only draft state.
  visibility           AgentVisibility @default(PERSONAL)
  /// Opt-in marketplace catalogue flag (cor:acl:080:04): whether this agent is
  /// advertised in the marketplace browse. DISTINCT from `visibility` — PUBLIC
  /// governs access, this governs advertisement. Contributes to the owner org's
  /// discoverability (cor:acl:080:02) only when that org is activated.
  listedOnMarketplace  Boolean         @default(false) @map("listed_on_marketplace")
  /// Coarse behavior hint — see AgentType enum doc. Largely legacy
  /// post-008.
  type                 AgentType       @default(ASSISTANT)
  /// Surfaces this Agent is designed for (free-form per 008 R-9; v1
  /// known values: 'chat', 'slack', 'mcp', 'web'). Distinct from the
  /// per-App `surfaces` — this is the *design-time* declaration.
  surfaces             String[]        @default([])
  // 036-ai-service-config: the legacy ai_provider/ai_model/
  // ai_api_key_encrypted/ai_api_key_preview columns were dropped in favor
  // of Agent-owned AiServiceConfig rows (the Agent's design-time default
  // lives in its config named 'default'; an App-owned config overrides at
  // deploy time per the resolution walk).
  /// Loc of the currently-published revision of the Agent's system
  /// memory. Lets the Builder ship draft revisions without affecting
  /// running Apps.
  publishedRevisionLoc String?         @map("published_revision_loc")
  /// Optimistic editor-lock owner (one Builder at a time can hold the
  /// edit lock on the system memory).
  editorLockUserId     String?         @map("editor_lock_user_id")
  /// When the editor lock expires (auto-released on stale).
  editorLockExpiresAt  DateTime?       @map("editor_lock_expires_at")
  /// Agent working state (per-user data like family budget,
  /// preferences); automatically available to the LLM as context.
  properties           Json?
  // 008-agent-installation (2026-05-02): Agent declares per-deployment memory
  // provisioning shape. Schema: { appMemory: 'shared' | 'user' | 'none' }.
  // Personal-class provisioning is implicit (lazy on first user-attributed write).
  /// Declares how this Agent expects per-App memory to be
  /// provisioned. Shape: `{ appMemory: 'shared' | 'user' | 'none' }`.
  /// `personalMemory` provisioning is implicit (lazy-create on first
  /// user-attributed write). 008-agent-installation FR-008.
  memoryProvisioning   Json            @default("{\"appMemory\": \"shared\"}") @map("memory_provisioning")
  // 008-agent-installation (2026-05-02): Agent declares membership constraints.
  // Schema: { maxMembers: number | 'unlimited', memberRoles: string[] }.
  // Enforced at AppMember invite-acceptance time.
  /// Declares membership constraints for any App that installs this
  /// Agent. Shape: `{ maxMembers: number | 'unlimited', memberRoles:
  /// string[] }`. `maxMembers` enforced at AppMember
  /// invite-acceptance time. 008-agent-installation FR-009.
  installationPolicy   Json            @default("{\"maxMembers\": \"unlimited\", \"memberRoles\": [\"owner\"]}") @map("installation_policy")
  createdAt            DateTime        @default(now()) @map("created_at")
  createdBy            String?         @map("created_by")
  updatedAt            DateTime?       @updatedAt @map("updated_at")
  updatedBy            String?         @map("updated_by")
  deletedAt            DateTime?       @map("deleted_at")
  deletedBy            String?         @map("deleted_by")

  /// Online URN-shape migration gate (spec 021 FR-032, repurposed for the #697
  /// v1→v2 emission flip). Null = pre-normalization row; set = row normalized
  /// onto the flat v2 form (`<root>:<slug>`, single colon). Transient.
  /// TODO(spec-021-cleanup): drop once the FR-032 migration completes.
  urnNormalizedAt          DateTime? @map("urn_normalized_at")
  /// Spec 021 sentinel for data-defect rows during the FR-032 migration.
  /// TODO(spec-021-cleanup): drop alongside urnNormalizedAt.
  urnMigrationFailedReason String?   @map("urn_migration_failed_reason")
  /// #697 stored alias map: the pre-v2 (v1) URN this row was migrated FROM
  /// (see Memory.legacyUrn). Null until the online migration flips `urn` to v2.
  legacyUrn                String?   @map("legacy_urn")

  organization      Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memoryItems       AgentMemoryItem[]
  userMemories      Memory[]            @relation("UserMemoriesOfAgent")
  sessions          Session[]           @relation("SessionAgent")
  userSubscriptions AgentSubscription[] @relation("AgentUserSubscriptions")
  // 023-app-shape Phase 2b: App↔Agent goes through `AppAgent` (N:M).
  // The direct `App[]` back-relation is gone (dropped with App.agentId).
  appAgents         AppAgent[]
  imports           AgentImport[]       @relation("ParentAgent")
  importedBy        AgentImport[]       @relation("ImportedAgent")
  orgGrants         AgentOrgGrant[]
  aiServiceConfigs  AiServiceConfig[]

  @@index([ownerUserId])
  @@index([legacyUrn])
  @@map("agents")
}

/// Associates a Memory with an Agent, with a per-memory access level.
/// The Agent controls which memories are read-only vs read-write
/// per-attached-memory. After 005-agent-subscription,
/// `AgentMemoryItem.role` is the sole per-knowledge-memory write cap
/// (the AppAgent-level cap was first relaxed in 005, then the
/// AppAgent join itself was dropped in 008-agent-installation).
model AgentMemoryItem {
  id        String    @id @default(cuid())
  agentId   String    @map("agent_id")
  memoryId  String    @map("memory_id")
  /// `"read"` or `"read-write"`. Default `"read"`. Controls whether
  /// the Agent can write to this memory.
  role      String    @default("read")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([agentId, memoryId])
  @@map("agent_memory_items")
}

/// Commercial usage grant of a Memory; defines capacity and terms.
/// Consumed via MemorySubscription.licenseId.
model MemoryLicense {
  id          String    @id @default(cuid())
  memoryId    String    @map("memory_id")
  /// **Column type is `String` (not enum)** — intended values:
  /// `user | app | organization`.
  licenseType String    @map("license_type")
  /// Number of consumers allowed to use this license.
  seats       Int
  validFrom   DateTime  @map("valid_from")
  validUntil  DateTime  @map("valid_until")
  /// One or more license keys.
  licenseKeys String[]  @map("license_keys")
  /// Usage terms & conditions.
  terms       String
  /// If true, the memory will be merged into the blended graph for
  /// the consumer.
  activated   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  memory        Memory               @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  subscriptions MemorySubscription[]

  @@map("memory_licenses")
}

/// An Organization subscribes to another Organization's Memory.
/// Governed by a MemoryLicense when the memory requires one.
///
/// **Access evaluation order** (cross-org chain — extended in
/// 005-agent-subscription with the App↔Agent and User↔Agent gates;
/// 008-agent-installation added AgentOrgGrant; 023-app-shape replaced the
/// direct `App.agentId` with the `AppAgent` join (an App can install N Agents)):
///   1. **App ↔ Agent** — the App has the Agent installed (an `AppAgent`
///      row links them) AND `Agent.visibility` allows the App's org.
///      Cross-org installs (`App.organizationId != Agent.organizationId`)
///      additionally require an active `AgentOrgGrant(App.organizationId,
///      agentId)`. Same-org installs auto-pass.
///   2. **Agent ↔ Memory (knowledge / app / system)** — current
///      implementation (`src/mcp/access-control.ts#foldAgentIntoAccessMap`):
///      `AgentMemoryItem(agent, memory)` exists OR memory is the
///      Agent's `systemMemoryId`. When cross-org for knowledge:
///      `MemorySubscription(orgB, memory)` AND any required
///      `MemoryLicense` valid (not expired, seats available).
///      **Known gap** (tracked in
///      [issue #115](https://github.com/hadron-memory/hadron-server/issues/115)):
///      this gate does NOT auto-grant access to app-class memories
///      where `memory.appId = App.id` AND `memory.class = 'app'`.
///      Today an explicit `AgentMemoryItem` row is required for
///      app-class memories to be reachable through the MCP/GraphQL
///      gates. The spec called for auto-grant; the implementation
///      currently does not.
///   3. **User ↔ Agent (personal-class memory only)** —
///      `AgentSubscription(user, agentId)` exists AND active per
///      the predicate, AND `Memory.appId = App.id` (the per-App
///      isolation that User Story 2 hangs on — a session through App
///      A cannot read the personal memory at `(B.id, user.id)` for
///      some other App B of the same Agent).
///   4. **Effective role** — most restrictive of
///      `AgentMemoryItem.role` and `MemorySubscription.role`. (The
///      legacy `AppAgent.role` is dropped post-008 — system memory is
///      universally read-only from any App.) `personal`/`private`-class
///      memories enforce strict ownership *additionally*: even an
///      ADMIN/OWNER who would otherwise satisfy gate 2 cannot read a
///      `personal`/`private` memory they do not own (FR-016).
///
/// **Worked example** (the four-org Juno scenario, 008 vocabulary):
/// an App in `OrgA` deploys Juno (Agent in `OrgB` with
/// visibility=ORGANIZATION since Alice is a Micromentor org-member;
/// or PUBLIC for marketplace shape) which references a knowledge
/// Memory in `OrgC`. The cross-org App↔Agent gate is satisfied by an
/// active `AgentOrgGrant(OrgA, juno)`. End-user Alice (personal org
/// `personal-alice`) chats through that App; her records land in a
/// personal Memory at `(App.id, alice.id)` (`Memory.userId = alice`,
/// `Memory.appId = App.id`, `class = personal`, `visibility = null`).
/// The cross-org write into Alice's
/// personal memory is granted by `AgentSubscription(alice, juno)` —
/// without it, Juno has zero access. If Alice installs Juno into a
/// *second* App (different Org), her records there go to a separate
/// `(B.id, alice.id)` row — fully isolated from the OrgA installation.
/// Each gate above must clear in order; failure denies at the right
/// layer with a typed error.
model MemorySubscription {
  id             String    @id @default(cuid())
  memoryId       String    @map("memory_id")
  /// The subscribing organization (not the owner).
  organizationId String    @map("organization_id")
  licenseId      String?   @map("license_id")
  /// Column type is the full `Role` enum, but the intended grant set
  /// is `CONTRIBUTOR | READER` (reader = read-only, contributor =
  /// read-write). Tightening reserved for a future cleanup spec.
  role           Role      @default(READER)
  /// If true, the memory will be merged into the blended graph for
  /// the subscriber.
  activated      Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  memory       Memory         @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  license      MemoryLicense? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@unique([memoryId, organizationId])
  @@index([organizationId])
  @@map("memory_subscriptions")
}

/// Represents a running Hadron server instance (SaaS or self-hosted).
/// Each organization connects to one server; a server serves one or
/// many organizations.
model HadronServer {
  id              String    @id @default(cuid())
  /// The organization that owns/operates this server; NULL for the
  /// Baragaun SaaS server.
  organizationId  String?   @map("organization_id")
  /// Base URL of this server (e.g. "https://server.hadrongraph.io").
  url             String
  /// Minimum level for ServerLogEntry records.
  logLevel        LogLevel  @default(ERROR) @map("log_level")
  /// Deployed software version.
  version         String?
  /// Last health-check timestamp.
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  logEntries       ServerLogEntry[]
  aiServiceConfigs AiServiceConfig[]

  @@map("hadron_server")
}

/// Named AI service configuration (spec 036). Owned by exactly one of
/// HadronServer / Organization / App / Agent — enforced by the Postgres
/// CHECK `chk_ai_service_config_owner` (see prisma/post-push.sql; Prisma
/// cannot express it). Resolved by name walking App -> Agent -> Org (of
/// the App, else of the Agent) -> HadronServer; the first ENABLED config
/// with the requested name wins. Well-known fallback name: 'default'
/// (conventional extras: 'fast', 'frontier'). Name is unique per owner
/// via four partial unique indexes (also post-push.sql). Replaces the
/// legacy Agent.ai_* / App.ai_* columns, which the 036 migration dropped
/// without backfill (stored values confirmed disposable 2026-06-11).
model AiServiceConfig {
  id              String    @id @default(cuid())
  /// Lookup name used by the resolution walk; lower-case canonical.
  name            String
  // Owner FKs — exactly one non-null (chk_ai_service_config_owner).
  hadronServerId  String?   @map("hadron_server_id")
  organizationId  String?   @map("organization_id")
  appId           String?   @map("app_id")
  agentId         String?   @map("agent_id")
  /// Provider identifier; v1 known: 'anthropic' | 'openai' | 'glm' |
  /// 'bedrock'. Validated against the registry in src/lib/aiConfig.ts.
  provider        String
  /// Model identifier, passed verbatim to the provider.
  model           String
  /// AES-256-GCM-encrypted API key (src/lib/tokenCrypto.ts encryptToken).
  /// For 'bedrock' this is a JSON-encoded {accessKeyId, secretAccessKey,
  /// region} triple, stored opaque.
  apiKeyEncrypted String?   @map("api_key_encrypted")
  /// Ellipsis + last 4 chars of the raw key for masked display.
  apiKeyPreview   String?   @map("api_key_preview")
  /// Provider-specific knobs (maxTokens, thinking, effort, baseUrl, ...).
  /// Validated per provider by zod in src/lib/aiConfig.ts.
  params          Json?
  /// Disabled configs are skipped by resolution (walk continues outward).
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")

  hadronServer HadronServer? @relation(fields: [hadronServerId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  app          App?          @relation(fields: [appId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([hadronServerId])
  @@index([organizationId])
  @@index([appId])
  @@index([agentId])
  @@map("ai_service_configs")
}

/// Log entry for the Hadron server, surfaced in hadron-portal for
/// troubleshooting. Examples: memory sync failures, GitHub App
/// errors, system-level events.
model ServerLogEntry {
  id        String    @id @default(cuid())
  serverId  String    @map("server_id")
  level     LogLevel
  /// Set if the log relates to a specific memory.
  memoryId  String?   @map("memory_id")
  /// Human-readable log message.
  message   String
  /// Structured context (stack trace, request/response, etc.).
  detail    Json?
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  server HadronServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([level])
  @@index([createdAt])
  @@map("server_log")
}

/// Log entry for a specific memory, surfaced in hadron-portal for
/// troubleshooting. Examples: sync failures, license expirations,
/// pending edge resolution, branch conflicts.
model MemoryLogEntry {
  id        String             @id @default(cuid())
  memoryId  String             @map("memory_id")
  level     LogLevel
  /// Categorizes the log for filtering.
  eventType MemoryLogEventType @map("event_type")
  /// Human-readable log message.
  message   String
  /// Structured context (sync diff, expired license details, etc.).
  detail    Json?
  createdAt DateTime           @default(now()) @map("created_at")
  createdBy String?            @map("created_by")
  updatedAt DateTime?          @updatedAt @map("updated_at")
  updatedBy String?            @map("updated_by")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([level])
  @@index([eventType])
  @@index([createdAt])
  @@map("memory_log")
}

/// An invitation sent to an existing platform User to join an
/// Organization. The `role` cannot be higher than that of the sender.
/// (Contrast with UserInvitation, which is for inviting *new* platform
/// users.)
model OrgMemberInvitation {
  id              String    @id @default(cuid())
  /// fk to OrgMember.id — the sender of the invitation.
  memberUserId    String    @map("member_user_id")
  /// fk to User.id — the recipient (an existing platform user).
  recipientUserId String    @map("recipient_user_id")
  /// Column type is the full `Role` enum, but the intended grant set
  /// is `ADMIN | CONTRIBUTOR | READER` (you can't invite someone as
  /// OWNER — promotion happens via a separate transfer flow).
  role            Role      @default(READER)
  /// When this invitation expires.
  expiresAt       DateTime? @map("expires_at")
  /// When the recipient accepted the invitation.
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  sender    OrgMember @relation("SentByMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  recipient User      @relation("ReceivedMemberInvitations", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@map("org_member_invitations")
}

/// Invitation sent out to one or more persons that do not yet have a
/// user account. If `maxActivations = 1` this invitation is
/// single-use. If `email` or `githubUsername` is given, the new user
/// is validated against this — which essentially locks the identity
/// of the new person and sets `maxActivations` to 1.
///
/// **Quota** is tracked on `User.maxReferrals`, not on the invitation.
/// When a new user is created from this invitation, their
/// `maxReferrals` is set by the onboarding process (e.g. from the
/// sender's remaining quota or a system default).
///
/// **Race conditions**: if a referral arrives at the landing page
/// after activations exceed `maxActivations`, the page shows
/// "The invitation has expired. Please contact the sender." If
/// onboarding has *started* and the create-account request would push
/// the count above the cap, the account is still created (don't block
/// a real human on a counter).
///
/// **Role bounds**: `userRole` cannot be higher than the sender's;
/// `memberRole` cannot be higher than the sender's OrgMember role in
/// the target org.
model UserInvitation {
  id             String    @id @default(cuid())
  /// fk to User.id — the sender; NULL for system/seed invitations
  /// from Baragaun.
  senderUserId   String?   @map("sender_user_id")
  /// If the new user should be added to an organization on signup.
  organizationId String?   @map("organization_id")
  /// Random string to get a unique invite URL.
  slug           String    @unique
  /// Column type is the full `Role` enum, but the intended set is
  /// `ADMIN | null` (most invites grant no global role).
  userRole       Role?     @map("user_role")
  /// Column type is the full `Role` enum, but the intended grant set
  /// is `ADMIN | CONTRIBUTOR | READER`.
  memberRole     Role      @default(READER) @map("member_role")
  /// fk to User.id — set when the invitation is accepted and a User
  /// is created.
  newUserId      String?   @map("new_user_id")
  /// Recipient's name.
  name           String?
  email          String?
  githubUsername String?   @map("github_username")
  phoneNumber    String?   @map("phone_number")
  /// Maximum number of times this invitation can be accepted by a
  /// new recipient; current count is determined from
  /// UserInvitationActivation rows.
  maxActivations Int?      @map("max_activations")
  expiresAt      DateTime? @map("expires_at")
  /// When this invitation was accepted and the new User was created.
  /// (For multi-use invites this is set on the *first* acceptance.)
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  sender       User?                      @relation("SentInvitations", fields: [senderUserId], references: [id], onDelete: SetNull)
  organization Organization?              @relation("OrgInvitations", fields: [organizationId], references: [id], onDelete: SetNull)
  activations  UserInvitationActivation[]

  @@map("user_invitations")
}

/// One row per User created in response to a UserInvitation. Role
/// bounds match UserInvitation's: `userRole` and `memberRole` cannot
/// exceed the sender's at activation time.
model UserInvitationActivation {
  id           String    @id @default(cuid())
  /// The invitation that was accepted.
  invitationId String    @map("invitation_id")
  /// The newly created User.
  userId       String    @map("user_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  invitation UserInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_invitation_activations")
}

/// Temporary token for email verification during signup.
model EmailVerificationToken {
  id              String    @id @default(cuid())
  email           String
  token           String    @unique
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  /// #505 session-fixation binding: SHA-256 of the browser nonce the portal set
  /// (HttpOnly cookie) when the magic link was REQUESTED. Carried into the login
  /// handoff code's clientStateHash at verify time so the browser that redeems
  /// must be the one that requested the link. NOT NULL in practice (POST
  /// /auth/email requires clientState); nullable only for forward-compat.
  clientStateHash String?   @map("client_state_hash")

  @@index([email])
  @@map("email_verification_tokens")
}

/// A versioned snapshot of a Node's content. Written every time a
/// Node is updated, so the full history is recoverable.
model NodeRevision {
  id                 String   @id @default(cuid())
  nodeId             String   @map("node_id")
  /// Memory this snapshot's content belonged to at capture time. A node
  /// can be MOVED across memories (moveNode keeps the stable id), so gating
  /// revision history by the node's CURRENT memory alone would leak snapshots
  /// captured while the node lived in a memory the caller can't read (#602 /
  /// Codex P1). Every snapshot site stamps this; nullable only for legacy
  /// rows predating the column (backfilled to the node's current memory —
  /// the read gate treats NULL as the current memory).
  memoryId           String?  @map("memory_id")
  loc                String
  name               String
  alias              String?
  description        String?
  /// Paragraph summary at the time of the snapshot. Spec 031.
  /// Added in the US1 implementation when the live `Node.abstract`
  /// column landed — revision history would otherwise silently drop
  /// abstract edits.
  abstract           String?
  /// Spec 032 — snapshot of `Node.abstractOriginHash` at the time of
  /// revision capture. Restored verbatim by `restoreNodeRevision`;
  /// legacy revisions (pre-spec) have NULL here, which short-circuits
  /// the staleness check on the live row after restore (no false
  /// positives).
  abstractOriginHash String?  @map("abstract_origin_hash")
  content            String?
  tags               String[]
  // ─── #620: full curated-subset snapshot of the Node's content fields.
  // NULL `nodeType` marks a LEGACY row captured before these columns
  // existed (nodeType is non-null on Node, so every post-#620 snapshot
  // sets it) — restoreNodeRevision keys on that sentinel to leave the
  // live node's values for these fields untouched when restoring a
  // legacy snapshot, instead of wiping them to NULL. Deliberately NOT
  // versioned: embedding* (operational state), tokens (derived from
  // content), contentHash + ownerRepo (external-sync provenance), and
  // the created/updated/deleted audit stamps.
  nodeType           String?  @map("node_type")
  /// #725 — collection discriminator at capture time (parity with nodeType).
  objectType         String?  @map("object_type")
  isLink             Boolean? @map("is_link")
  properties         Json?
  data               Json?
  seq                Int?
  isRunnable         Boolean? @map("is_runnable")
  llmModel           String?  @map("llm_model")
  aiAgent            String?  @map("ai_agent")
  /// #620: the User.id of the editor, when a user is known — nothing
  /// else goes here anymore. Historically this column was overloaded
  /// (`reason ?? clientId ?? userId`, so it held edit rationales, OAuth
  /// identity strings like "github:<login>", or a User id); the #620
  /// migration moved identity strings to `editedByInfo`, rationales to
  /// `revLabel`, and backfilled from `createdBy` where that held a User id.
  editedBy           String?  @map("edited_by")
  /// #620: what we know about the editor when no User.id is available.
  /// Identity-string forms in the wild: "github:<login>" / "email:<addr>"
  /// / "user:<id>" (AuthContext.clientId) and "app:<App.id>" (App-key
  /// principals).
  editedByInfo       String?  @map("edited_by_info")
  /// #620: user-settable label for this revision (updateNodeRevision
  /// mutation; REV_LABEL_MAX_LEN cap). Also captures the #88 `reason`
  /// arg at snapshot time — the edit rationale that previously squatted
  /// in `editedBy` (legacy reasons were migrated here).
  revLabel           String?  @map("rev_label")
  /// #620: which node fields the edit that took this snapshot changed
  /// (e.g. ["abstract","tags"]). The snapshot itself is the PRE-edit
  /// state, so `changes` describes the delta between this snapshot and
  /// the state that replaced it. Empty for legacy rows (NULL reads as []).
  changes            String[]
  /// #620: reserved — User who approved this revision. No write surface
  /// yet; the approve flow lands later.
  approvedBy         String?  @map("approved_by")
  /// #696: per-node MONOTONIC revision number (1, 2, 3, …) — the stable atom
  /// in the `hrn:noderev:<root>:<mem>:<loc...>:<rev>` URN (rendered `r<N>`).
  /// Minted race-safely from `Node.revSeq` (atomic increment) inside the same
  /// tx that inserts the snapshot. Nullable only for legacy rows predating the
  /// column (backfilled per-node by createdAt order in the migration).
  revNo              Int?     @map("rev_no")
  createdBy          String?  @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")

  node           Node  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  approvedByUser User? @relation("NodeRevisionApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  /// #696: resolve a noderev URN by its per-node revision number.
  @@unique([nodeId, revNo], map: "node_revisions_node_rev_no_uniq")
  @@index([nodeId, createdAt])
  @@map("node_revisions")
}

/// Temporary record holding an encrypted API key for a newly
/// provisioned workspace, consumed during first-time setup. The raw
/// key is the `hdr_app_<…>` value, shown once via `/setup/info`.
model PendingSetup {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  /// The workspace's App; ON DELETE CASCADE.
  appId           String   @map("app_id")
  /// AES-256-GCM-encrypted raw API key.
  rawKeyEncrypted String   @map("raw_key_encrypted")
  consumed        Boolean  @default(false)
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  app  App  @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("pending_setups")
}

/// A connected email mailbox (identity record). Provider state — refresh
/// tokens, Graph subscriptions — lives in the provider capability tool
/// (hadrontool-ms-exchange, #396); mail operations route through
/// src/lib/emailClient.ts using `toolConnectionId`.
model ExchangeConnection {
  id                    String     @id @default(cuid())
  organizationId        String     @map("organization_id")
  userId                String     @map("user_id")
  /// The mailbox/account email address; (organizationId, provider,
  /// mailboxEmail) is unique — provider-scoped so a calendar connection
  /// (provider 'google-cal') for the same Google account COEXISTS with its
  /// mail connection instead of overwriting it (PR-638 Codex P1).
  mailboxEmail          String     @map("mailbox_email")
  displayName           String?    @map("display_name")
  /// Email provider backing this connection — the emailClient dispatch key
  /// (#396: one capability tool per provider; 'ms-exchange' today).
  provider              String     @default("ms-exchange")
  /// The provider tool's connection id. NULL only for legacy rows whose
  /// token hasn't been transferred yet (scripts/admin-transfer-exchange-tokens.ts).
  toolConnectionId      String?    @map("tool_connection_id")
  /// LEGACY (#396): AES-256-GCM-encrypted MS Graph refresh token, kept (NULL
  /// for new rows) only as the rollback path until the one-time core→tool
  /// transfer is verified; a follow-up migration drops it.
  refreshTokenEncrypted String?    @map("refresh_token_encrypted")
  /// Soft toggle — operator can pause sync without removing the
  /// connection.
  syncEnabled           Boolean    @default(true) @map("sync_enabled")
  syncStatus            SyncStatus @default(PENDING) @map("sync_status")
  lastSyncAt            DateTime?  @map("last_sync_at")
  /// Error message from the last failed sync.
  lastError             String?    @map("last_error")
  /// MS Graph change-notification subscription id.
  webhookSubscriptionId String?    @map("webhook_subscription_id")
  /// Subscription expiry — MS Graph webhooks are short-lived; the
  /// renewer cron job watches this column.
  webhookExpiresAt      DateTime?  @map("webhook_expires_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  createdBy             String?    @map("created_by")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  updatedBy             String?    @map("updated_by")
  deletedAt             DateTime?  @map("deleted_at")
  deletedBy             String?    @map("deleted_by")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionGrants ConnectionGrant[]

  @@unique([organizationId, provider, mailboxEmail])
  @@index([userId])
  // The email-events ingress resolves connections by the tool's id on every
  // inbound email — this lookup must be indexed (#396 Phase 4).
  @@index([toolConnectionId])
  @@map("exchange_connections")
}

/// User→App scoped delegation on a user-owned connection (spec-042 Track B,
/// #593; supersedes the deferred AgentEmailGrant). Lets a connection's OWNER
/// grant a specific App install scoped access (e.g. `mail.read`) to their
/// mailbox/calendar. Enforced in `requireEmailConnection` (owner OR live grant
/// covering the operation's scope).
///
/// - Grantee is the App INSTALL (`granteeAppId`), never the Agent — one Agent
///   in two Apps/orgs is two trust contexts (the Juno fixture).
/// - Owner-only create/revoke, no org-admin bypass. Revoke is a SOFT delete;
///   liveness lookups use `findFirst` + `deletedAt: null` (never `findUnique`).
/// - Cross-org is intended: connection org and grantee-App org may differ; the
///   grant row is the sole authority.
/// - Multiple live grants per (connection, App) are valid — union-of-scopes —
///   so there is deliberately no unique constraint on the pair.
model ConnectionGrant {
  id              String    @id @default(cuid())
  connectionId    String    @map("connection_id")
  /// The App install this grant delegates to (the grantee = `ctx.appId`).
  granteeAppId    String    @map("grantee_app_id")
  /// The connection owner who created the grant (owner-only create).
  grantedByUserId String    @map("granted_by_user_id")
  /// Operation scopes covered — subset of {mail.read, mail.send,
  /// calendar.freebusy, calendar.read}. See src/lib/emailOperationScopes.ts.
  scopes          String[]  @default([])
  /// Optional expiry; NULL = perpetual until revoked.
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  connection ExchangeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  granteeApp App                @relation("AppConnectionGrants", fields: [granteeAppId], references: [id], onDelete: Cascade)
  grantedBy  User               @relation("ConnectionGrantsByUser", fields: [grantedByUserId], references: [id], onDelete: Cascade)

  // Composite on the gate's hot lookup (connectionId + granteeAppId). The
  // connectionId-leading order still serves the ExchangeConnection cascade
  // delete, so no separate single-column index is needed (PR-599 review).
  @@index([connectionId, granteeAppId])
  @@index([granteeAppId])
  @@index([grantedByUserId])
  @@map("connection_grants")
}

/// An individual action grant — the ADDITIVE half of the grant model
/// (design:grant-model; evaluated by @hadron-memory/access-control as a
/// PrincipalGrantLike). Hands one principal extra management actions
/// within one organization WITHOUT changing their OrgMember role: the
/// gate's effective allow-set is union(role bundle, live grants).
/// Multiple live grants per (principal, org) are valid = union-of-actions
/// (no unique constraint — the ConnectionGrant precedent). Revocation is
/// soft delete; expiry optional (NULL = perpetual). Liveness (deletedAt +
/// expiresAt) is filtered IN the gate's query, never after it.
model PrincipalGrant {
  id             String    @id @default(cuid())
  /// 'USER' (v1). Reserved for future app/agent principals.
  principalType  String    @default("USER") @map("principal_type")
  /// The granted user (v1: principalType='USER').
  principalId    String    @map("principal_id")
  organizationId String    @map("organization_id")
  /// Allowed actions — the access-control matcher grammar: exact
  /// ('memory.clone'), prefix ('memory.*'), or '*'.
  actions        String[]  @default([])
  /// Optional expiry; NULL = perpetual until revoked.
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  principal    User         @relation("UserPrincipalGrants", fields: [principalId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Composite on the gate's hot lookup (principal + org); principal-leading
  // order also serves the User cascade delete.
  @@index([principalId, organizationId])
  @@index([organizationId])
  @@map("principal_grants")
}

/// One Slack workspace install of the Hadron Slack app (spec 043).
/// Org-owned at WORKSPACE granularity (decision 1) — unlike the App-owned
/// TelegramConnection design and the user-owned ExchangeConnection.
/// `defaultAppId` names the Hadron App that serves /hadron commands from
/// this workspace; per-channel App overrides are a later binding table.
/// The tokens live ENCRYPTED IN THE TOOL (hadrontool-slack) — core stores
/// identity only, and no token ever appears in a GraphQL field.
model SlackConnection {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  /// The Hadron App that serves commands from this workspace.
  defaultAppId     String    @map("default_app_id")
  /// The slackClient dispatch key ('slack' today).
  provider         String    @default("slack")
  /// The provider tool's connection id — the ops-call handle and the
  /// events-ingress resolution key.
  toolConnectionId String    @map("tool_connection_id")
  /// Slack workspace (team) id, e.g. "T0123456789".
  teamId           String    @map("team_id")
  teamName         String    @map("team_name")
  /// The bot's Slack USER id ("U…") — the sender on messages it posts.
  botUserId        String    @map("bot_user_id")
  /// The bot's BOT id ("B…") — what bot message EVENTS carry as `bot_id`.
  /// Distinct from botUserId; the bridge loop filter needs BOTH (spec 043
  /// decision 8, PR #594 review). Don't "simplify" to one column.
  botId            String    @map("bot_id")
  /// 'ACTIVE' | 'ERROR' — mirrors the tool's connection-status vocabulary
  /// (there is no sync loop here, so SyncStatus does not apply).
  status           String    @default("ACTIVE")
  /// Error message from the last permanent provider failure.
  lastError        String?   @map("last_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultApp   App          @relation(fields: [defaultAppId], references: [id], onDelete: Cascade)

  // The slack-events ingress resolves connections by the tool's id on every
  // inbound event — the routing key must be 1:1, so this is UNIQUE (PR #600
  // review): two rows sharing a tool id would make dispatch ambiguous and
  // risk cross-org misdelivery. Every registration mints a fresh tool id,
  // so soft-deleted history rows never collide.
  @@unique([toolConnectionId])
  // One LIVE connection per (org, workspace) — enforced by the PARTIAL
  // unique index `slack_connections_org_team_active_uniq WHERE deleted_at
  // IS NULL` (raw SQL: the 043 migration + prisma/post-push.sql +
  // src/test/globalSetup.ts, which must stay in sync). Prisma's @@unique
  // would be non-partial and make a soft-deleted row block workspace
  // re-registration forever — the apps_urn_active_uniq precedent.
  @@index([organizationId, teamId])
  @@index([defaultAppId])
  @@map("slack_connections")
}

/// Envelope-dedupe receipts for the at-least-once Slack events ingress
/// (spec 043 decision 5): the tool's persist-before-ack inbox may deliver
/// an event more than once (a crash between core's 2xx and the tool's row
/// delete), so dispatch INSERTs here first and drops duplicates on
/// conflict. `connectionId` is the TOOL's connection id — dedupe runs
/// before resolution, so no FK by design.
model SlackEventReceipt {
  id           String   @id @default(cuid())
  connectionId String   @map("connection_id")
  envelopeId   String   @map("envelope_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([connectionId, envelopeId])
  @@index([createdAt])
  @@map("slack_event_receipts")
}

/// Core-owned routing/audit binding for a sidecar-owned webfetch poll job.
/// Poll state, scheduling, snapshots, and credentials remain in the sidecar;
/// this immutable snapshot answers which already-authorized run principal an
/// at-least-once event may wake.
model WebFetchPollBinding {
  jobId              String    @id @map("job_id")
  sourceRunId        String    @map("source_run_id")
  organizationId     String    @map("organization_id")
  appId              String    @map("app_id")
  agentId            String?   @map("agent_id")
  userId             String?   @map("user_id")
  entryNodeUrn       String    @map("entry_node_urn")
  policy             Json?
  /// The resolved `Secret` row a credentialed poll used (#677 — audit
  /// provenance; supersedes the #628 credentials_node_urn node scheme).
  credentialSecretId String?   @map("credential_secret_id")
  /// Query- and fragment-free URL for audit/event-origin validation.
  url                String
  cancelledAt        DateTime? @map("cancelled_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  sourceRun AppRun @relation("WebFetchPollSourceRun", fields: [sourceRunId], references: [id], onDelete: Cascade)

  @@index([organizationId, appId, cancelledAt])
  @@index([sourceRunId])
  @@map("webfetch_poll_bindings")
}

/// Durable completed-dispatch receipt for the at-least-once webfetch event
/// ingress. An absent snapshot hash is represented by the empty string so the
/// compound unique key remains effective under Postgres NULL semantics.
model WebFetchEventReceipt {
  id           String   @id @default(cuid())
  jobId        String   @map("job_id")
  snapshotHash String   @default("") @map("snapshot_hash")
  kind         String
  routedRunId  String   @map("routed_run_id")
  createdAt    DateTime @default(now()) @map("created_at")

  routedRun AppRun @relation("WebFetchEventRoutedRun", fields: [routedRunId], references: [id], onDelete: Cascade)

  @@unique([jobId, snapshotHash, kind])
  @@index([createdAt])
  @@index([routedRunId])
  @@map("webfetch_event_receipts")
}

/// Registered EXTERNAL MCP server — the org-scoped registry behind the
/// hadrontool-mcp conduit (headless runs calling third-party MCP tools).
/// The conduit tool is stateless and Hadron-blind (cor:int:030:01); core
/// owns identity, governance, and the encrypted static headers. A run
/// reaches a server's tool via the run-tool name `mcp__<slug>__<tool>`,
/// and every call is gated by the policy chain as `tool.mcp__<slug>__<tool>`
/// plus the run's action budget — this row grants nothing by itself.
model McpServer {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  /// Run-tool name segment (`mcp__<slug>__<tool>`); lowercase [a-z0-9-],
  /// unique per org. Keep it short — provider tool-name caps are ~64 chars.
  slug             String
  name             String
  /// Streamable-HTTP MCP endpoint URL. The conduit refuses private-network
  /// hosts unless explicitly allowed (SSRF guard, dev only).
  url              String
  /// AES-256-GCM-encrypted JSON object of static request headers
  /// (src/lib/tokenCrypto.ts), e.g. {"Authorization":"Bearer ..."} —
  /// v1 auth posture (no OAuth). WRITE-ONLY on the API surface: resolvers
  /// expose only a hasHeaders boolean, never the value.
  headersEncrypted String?  @map("headers_encrypted")
  /// Exposed-tool allowlist; empty = every tool the server advertises.
  toolAllowlist    String[] @default([]) @map("tool_allowlist")
  /// Disabled servers fail run-tool resolution loud (unknown tool), same
  /// posture as an unregistered slug.
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  createdBy        String?  @map("created_by")
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedBy        String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Hard delete by design: a registry row is config, not audit history —
  // deleting one makes referencing runs fail their hop loud, which is the
  // wanted signal. No deletedAt ⇒ a plain (non-partial) unique works.
  @@unique([organizationId, slug], map: "mcp_servers_org_slug_uniq")
  @@map("mcp_servers")
}

/// One named, owner-scoped secret — the general secret store (#677).
/// Polymorphic owner (`user` | `org` | `app` | `memory`) — deliberately no
/// FK: entitlement is checked at resolution time under the caller/run
/// principal, and a dangling owner simply never resolves. A bare name
/// resolves via the CSS cascade, most-specific-first: memory → app → user
/// → org. `kind` is extensible (`generic` opaque; `webfetch-auth` typed:
/// metadata `{ type, urlPrefix }`, origin-bound at use).
model Secret {
  id             String   @id @default(cuid())
  ownerType      String   @map("owner_type") // 'user' | 'org' | 'app' | 'memory'
  ownerId        String   @map("owner_id")
  /// Cascade-resolution key; unique per owner; lowercase [a-z0-9-], max 64.
  name           String
  kind           String
  /// The NON-secret, inspectable half — safe on every read surface. A
  /// reader can see THAT a secret exists and (webfetch-auth) WHERE it
  /// applies without decrypting.
  metadata       Json     @default("{}")
  /// encryptToken(JSON.stringify(payload)) — AES-256-GCM under the platform
  /// key (src/lib/tokenCrypto.ts). NEVER selected into a read surface:
  /// redaction by construction, same as the aiConfig / HA / Resend / MCP
  /// registries. Rotation is overwrite (updateSecret), no versioning (v1).
  valueEncrypted String   @map("value_encrypted")
  /// Key-rotation lineage headroom; unused (null) while HADRON_ENCRYPTION_KEY
  /// is the only key.
  keyId          String?  @map("key_id")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String?  @map("created_by")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedBy      String?  @map("updated_by")

  // Hard delete by design (registry-row posture): a deleted secret makes
  // referencing runs fail their resolution loud — the wanted signal.
  // The unique doubles as the (ownerType, ownerId) lookup index.
  @@unique([ownerType, ownerId, name], map: "secrets_owner_name_uniq")
  @@map("secrets")
}

/// One registered Home Assistant instance — the org-scoped registry behind
/// the hadrontool-home-assistant capability tool (hadron-server#640). Same
/// posture as McpServer: the row grants nothing by itself (every run-time
/// call walks the policy chain as `tool.ha__<slug>__<op>` + action budget),
/// hard delete by design, slug immutable because flow nodes reference it
/// inside data.tools names.
model HomeAssistantInstance {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// Run-tool name segment (`ha__<slug>__<op>`); lowercase [a-z0-9-],
  /// unique per org. Keep it short — provider tool-name caps are ~64 chars.
  slug           String
  name           String
  /// Home Assistant base URL (e.g. https://ha.example.com or a Nabu Casa
  /// remote URL). The tool refuses private-network hosts unless its
  /// HA_TOOL_ALLOW_PRIVATE_NETWORKS flag is set (self-hosted posture).
  url            String
  /// AES-256-GCM-encrypted long-lived access token
  /// (src/lib/tokenCrypto.ts). WRITE-ONLY on the API surface: resolvers
  /// never return it; update replaces it.
  tokenEncrypted String   @map("token_encrypted")
  /// Exposed-op allowlist over the closed HA_OPS catalog; empty = every op.
  /// Lets an admin register a READ-ONLY instance (no call_service).
  opAllowlist    String[] @default([]) @map("op_allowlist")
  /// Disabled instances fail run-tool resolution loud (unknown tool), same
  /// posture as an unregistered slug.
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String?  @map("created_by")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedBy      String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug], map: "home_assistant_instances_org_slug_uniq")
  @@map("home_assistant_instances")
}

/// One BYO Resend sender for an organization. Core owns and encrypts the API
/// key; the stateless hadrontool-resend sidecar receives it only for an
/// already-authorized send. One sender per org keeps credential selection
/// deterministic and outside model control.
model ResendSender {
  id              String   @id @default(cuid())
  organizationId  String   @unique(map: "resend_senders_organization_id_uniq") @map("organization_id")
  /// Fixed sender identity accepted by Resend, e.g.
  /// `Hadron Agent <agent@example.com>`. Not secret.
  fromAddress     String   @map("from_address")
  /// AES-256-GCM-encrypted Resend sending-access API key
  /// (src/lib/tokenCrypto.ts). WRITE-ONLY on the API surface.
  apiKeyEncrypted String   @map("api_key_encrypted")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String?  @map("created_by")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("resend_senders")
}

/// Pre-launch waitlist signup capture from the marketing site. Holds
/// an email plus an optional free-form "what features would you most
/// want?" answer. Not connected to User (signups happen before the
/// user has an account).
model WaitingListItem {
  id                String   @id @default(cuid())
  email             String
  requestedFeatures String?  @map("requested_features")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("waiting_list")
}

// ─── Multi-user agent: Apps ────────────────────────────────────────────

/// **The runtime deployment of an Agent in some Organization** — what
/// someone installs when they pick an Agent off the marketplace (or
/// install one from their own org). Holds credentials, surfaces,
/// optional AI override, members, and per-deployment memory pivots.
/// Per Constitution Technology Invariant #6, this is also the unified
/// caller-identity entity that authenticates against the Hadron platform.
///
/// Per (org, Agent) install: typically one App per pair. Multi-install
/// of the same Agent across orgs is supported and explicitly isolates
/// app- and personal-class memory at `(app_id, …)` keys.
///
/// **Auth credentials** live on AppKey rows (one or many per App,
/// independently revocable). The wire-token prefix `hdr_app_` and the
/// `appKey` developer-facing identifier are deliberately preserved by
/// 008 — there is no rename.
///
/// 008-agent-installation drops the `AppAgent` join: an App now
/// references its Agent directly via `agentId`. The legacy
/// OPERATE/DEVELOP role distinction is removed (system memory is
/// universally read-only from any App context — DEVELOP-from-App is
/// gone per R-10).
///
/// **Cascade behavior**: hard App deletion cascades to AppKey,
/// AppLogEntry, AppMember, and the App's `app`/`personal`-class Memory
/// rows. The orphan-retention behavior in 008 FR-015 (personal memory
/// survives an AppMember removal) is independent — it's a row delete
/// in `app_members`, not in `apps`.
model App {
  id                    String               @id @default(cuid())
  /// Display name.
  name                  String
  /// App-layer action-policy link (cor:acl:040:02) — same allow-list shape
  /// as Organization.policy; NULL = no restriction. Org-admin-authored
  /// (updateApp). Snapshotted into AppRun.policy at mint.
  policy                Json?
  /// Globally unique identifier; derived from `org.urn + ":" + slug`.
  ///
  /// **Spec 021 (FR-027) — uniqueness is now PARTIAL.** The DB-level
  /// constraint is `apps_urn_active_uniq WHERE uninstalled_at IS NULL`
  /// (declared in the 021 migration). The same URN can legitimately
  /// appear on multiple rows: one active (`uninstalledAt IS NULL`)
  /// plus N uninstalled history rows. Prisma's field-level `@unique`
  /// declaration was REMOVED because it would generate a non-partial
  /// global unique index that fights with the migration.
  ///
  /// Callers MUST use `findFirst({ where: { urn, uninstalledAt: null } })`
  /// for active-row resolution per FR-028 resolution precedence; the
  /// `findUnique` callers in `resolvers.ts` were migrated to this
  /// pattern in PR #124.
  urn                   String
  organizationId        String?              @map("organization_id")
  /// User owner of a user-owned App (rooted on the bare `<handle>` — #697 v2, no
  /// `@` sigil). The org/owner XOR is ENFORCED — `chk_app_owner_xor` in
  /// post-push.sql: `(organization_id IS NULL) <> (owner_user_id IS NULL)` — so
  /// exactly one of `organizationId`/`ownerUserId` is non-null.
  ownerUserId           String?              @map("owner_user_id")
  ownerUser             User?                @relation("AppOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createUserPermission  CreateUserPermission @default(EXPLICIT) @map("create_user_permission")
  identifyUserMethod    IdentifyUserMethod   @default(USER_ID) @map("identify_user_method")
  sessionTimeoutSeconds Int                  @default(900) @map("session_timeout_seconds")
  anonymousTtlDays      Int                  @default(7) @map("anonymous_ttl_days")
  /// **Deprecated** — superseded by `surfaces`. Scheduled for removal
  /// in a follow-up cleanup spec (per 008 R-4); kept in place to
  /// avoid spurious portal churn.
  appType               AppType              @default(WORKSTATION) @map("app_type")
  /// Default member role applied when the Agent's
  /// `installation_policy.memberRoles` doesn't apply.
  role                  AppMembershipRole    @default(READER)
  description           String?
  /// **Deprecated** — superseded by `Agent.systemMemoryId` +
  /// `Agent.systemPrompt`. Scheduled for removal in a follow-up
  /// cleanup spec (per 008 R-4).
  systemPrompt          String?              @map("system_prompt")
  /// Tools this App's agent can access; default `[]`.
  agentTools            String[]             @default([]) @map("agent_tools")
  // 036-ai-service-config: the legacy ai_provider/ai_model/
  // ai_api_key_encrypted columns were dropped in favor of App-owned
  // AiServiceConfig rows (an App-owned config is the deploy-time override
  // that wins over the Agent's default in the resolution walk).
  expiresAt             DateTime?            @map("expires_at")
  // 008-agent-installation introduced a direct App→Agent FK; 023-app-shape
  // Phase 2b dropped it in favor of the reintroduced N:M `AppAgent` join
  // (multi-Agent App per US1). The GraphQL `App.agentId` and `App.agent`
  // fields are kept as soft-deprecated convenience reads, resolved via
  // the first AppAgent row by helpers in `src/lib/appAgent.ts`.
  /// Migrated from the dropped `app_agents.training_mode`. Sessions
  /// through this App are flagged as training data for the Agent's
  /// owner to review. 008-agent-installation FR-022.
  trainingMode          Boolean              @default(false) @map("training_mode")
  /// Free-form per 008 R-9; v1 known values: `'chat'`, `'slack'`,
  /// `'mcp'`, `'web'`. Surface enforcement (which features are gated
  /// on which surfaces) is handled by the portal/app code; chat-tab
  /// gating in hadron-portal#187 reads `surfaces.includes('chat')`.
  /// 008-agent-installation FR-014.
  surfaces              String[]             @default(["chat"])
  // Standard audit fields
  createdAt             DateTime             @default(now()) @map("created_at")
  createdBy             String?              @map("created_by")
  updatedAt             DateTime?            @updatedAt @map("updated_at")
  updatedBy             String?              @map("updated_by")
  deletedAt             DateTime?            @map("deleted_at")
  deletedBy             String?              @map("deleted_by")

  /// Soft-uninstall timestamp per spec 021 FR-025. Null = active install;
  /// set = uninstalled (read-only, write-rejected with "app uninstalled"
  /// error including cascade to child agents/memories/nodes per FR-026).
  /// Reinstall after soft-uninstall is allowed via the partial unique index
  /// `apps_urn_active_uniq WHERE uninstalled_at IS NULL` (declared in the
  /// 021 migration; supersedes Prisma's @unique on urn at the DB level).
  uninstalledAt            DateTime? @map("uninstalled_at")
  /// Online URN-shape migration gate (spec 021 FR-032, repurposed for the #697
  /// v1→v2 emission flip; transient). Null = pre-normalization row (read
  /// through the legacy parser); set = row normalized onto the flat v2 form
  /// (`<root>:<slug>`, single colon). Dropped once 100% of rows are migrated.
  /// TODO(spec-021-cleanup): drop this column once the FR-032 migration
  /// completes — tracked under the spec-021 cleanup follow-up. The
  /// `apps_urn_migration_pending_idx` partial index goes with it.
  urnNormalizedAt          DateTime? @map("urn_normalized_at")
  /// Spec 021 sentinel for data-defect rows during the FR-032 migration.
  /// Non-null = the row's urn failed normalization; the migration job
  /// skips it on subsequent passes (avoids infinite retry). Transient;
  /// dropped with urnNormalizedAt.
  /// TODO(spec-021-cleanup): drop alongside urnNormalizedAt.
  urnMigrationFailedReason String?   @map("urn_migration_failed_reason")
  /// #697 stored alias map: the pre-v2 (v1) URN this row was migrated FROM
  /// (see Memory.legacyUrn). Null until the online migration flips `urn` to v2.
  legacyUrn                String?   @map("legacy_urn")

  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 023-app-shape Phase 2b: App↔Agent is N:M through AppAgent. The
  // direct `agent` relation is gone (dropped with `agentId`).
  appAgents        AppAgent[]
  keys             AppKey[]
  members          AppMember[]
  memories         Memory[]          @relation("AppMemories")
  users            User[]
  sessions         Session[]
  logEntries       AppLogEntry[]
  usageEvents      UsageEvent[]
  pendingSetups    PendingSetup[]
  aiServiceConfigs AiServiceConfig[]
  connectionGrants ConnectionGrant[] @relation("AppConnectionGrants")
  slackConnections SlackConnection[]

  @@index([organizationId])
  // Spec 021 FR-027: keep `urn` lookups index-served. The DB-level
  // partial unique index `apps_urn_active_uniq` already covers active-row
  // queries; this @@index makes lookups across the full history (active
  // + uninstalled) also index-served. Prisma generates a non-unique
  // btree index on `urn`.
  @@index([urn])
  @@index([ownerUserId])
  @@index([legacyUrn])
  @@map("apps")
}

/// An API key for an App, independently revocable; multiple keys per
/// App. The raw key carries the canonical `hdr_app_` prefix and is
/// shown once at creation; only the SHA-256 hash is stored. (SHA-256,
/// not bcrypt — bcrypt's per-hash salt would prevent the
/// constant-time keyHash lookup the auth resolver does. The raw key
/// is a 256-bit random value, so dictionary attacks against the hash
/// are not a concern.)
///
/// **Auth path**: the resolver at `src/middleware/auth.ts` accepts
/// `hdr_app_`-prefixed bearer tokens, looks up the AppKey by SHA-256
/// hash, and resolves the principal to the parent App. Memory access
/// is then gated by `src/mcp/access-control.ts`, which reads
/// `App.agentId` directly (the legacy AppAgent join was dropped in
/// 008-agent-installation) and folds the Agent's `systemMemoryId` +
/// `memoryItems` into the access map.
///
/// **Client config field**: hadron-client reads the AppKey value from
/// the `appKey` field of `.hadron/config.json`. The env var name
/// `HADRON_CLIENT_KEY` describes location (the client process), not
/// the entity.
model AppKey {
  id         String    @id @default(cuid())
  appId      String    @map("app_id")
  /// SHA-256 hash of the raw `hdr_app_<…>` key.
  keyHash    String    @unique @map("key_hash")
  /// Last 4 characters of the raw key for masked display.
  keyPreview String    @map("key_preview")
  /// Human-friendly name for this key.
  label      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@map("app_keys")
}

/// The User↔App membership join with a per-member role. Spec:
/// 008-agent-installation FR-004.
///
/// **Per-User lifecycle is reserved for a future spec** — there is no
/// `revokedAt` / `expiresAt` column. Removing a member is a row delete;
/// the user's personal-class Memory at `(app_id, user.id)` is
/// **retained by default** as an orphan (FR-015) and re-attaches
/// automatically if the user later rejoins the *same* App.
///
/// **No deletedAt** — soft-delete is meaningless for a pure join.
// 008-agent-installation (2026-05-02): User↔App membership join.
// Per-User lifecycle is reserved for a future spec — there is no
// revoked_at / expires_at column. Removing a member is a row delete.
// The user's personal-class Memory at (app_id, user.id) survives the
// row delete (orphan retention per FR-015).
model AppMember {
  appId     String    @map("app_id")
  userId    String    @map("user_id")
  // Free-form string per R-7. Validated at write-time against the parent
  // Agent's installation_policy.memberRoles (e.g., ['owner', 'guide']).
  /// Free-form string validated at write-time against the parent
  /// Agent's `installation_policy.memberRoles` (per 008 R-7). Examples:
  /// `'owner'`, `'guide'`, `'cook'`. `installation_policy.maxMembers`
  /// is enforced at invite-acceptance time (per FR-016).
  role      String
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  app  App  @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User @relation("UserAppMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([appId, userId])
  @@index([userId])
  @@map("app_members")
}

/// The Org↔Agent license — authorizes an Org to (a) create Apps that
/// deploy this Agent, and (b) bundle this Agent in `AgentImport` edges
/// of Agents the Org owns. Spec: 008-agent-installation FR-006 / R-2.
///
/// Sibling to `AgentSubscription` (User↔Agent, from 005). Both share
/// the lifecycle field shape (`activatedAt`, `expiresAt`, `revokedAt`,
/// `revokedBy`) and the same active-status predicate. The two-table
/// split (rather than a polymorphic `subjectType` + `subjectId`)
/// preserves typed FK integrity and per-table indexing clarity.
///
/// For **same-org installs** (an Org deploying its own Agent), the
/// grant is auto-provisioned by `ensureAgentOrgGrant` on first
/// contact. **Cross-org installs** require an explicit grant; the v1
/// surface auto-provisions on first contact (the marketplace UX for
/// explicit subscribe lands in a future spec).
///
/// **No deletedAt** — soft-delete is redundant with the
/// `revokedAt` lifecycle.
///
/// **Active-status predicate** (shared with `AgentSubscription` via
/// the `isLifecycleActive` helper):
///
///     activatedAt IS NOT NULL
///       AND revokedAt IS NULL
///       AND (expiresAt IS NULL OR expiresAt > now())
// 008-agent-installation (2026-05-02): Org↔Agent license. Authorizes
// (a) creating an App in org_id that uses agent_id, and (b) bundling
// agent_id as an AgentImport in another Agent that org_id owns. Sibling
// to AgentSubscription (User↔Agent, from 005); shares the lifecycle
// shape and the isLifecycleActive predicate.
model AgentOrgGrant {
  orgId       String    @map("org_id")
  agentId     String    @map("agent_id")
  /// v1 default: `now()` on creation since billing is out of scope.
  activatedAt DateTime? @map("activated_at")
  expiresAt   DateTime? @map("expires_at")
  /// Set by an ADMIN/OWNER of the Agent's owning org via
  /// `revokeAgentOrgGrant`.
  revokedAt   DateTime? @map("revoked_at")
  /// fk to User.id — audit trail for who revoked.
  revokedBy   String?   @map("revoked_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  imports      AgentImport[]

  @@id([orgId, agentId])
  @@index([agentId])
  @@map("agent_org_grants")
}

/// A directed dependency edge between two Agents — "Agent A imports
/// Agent B as a dep." Spec: 008-agent-installation FR-005 / User Story 3.
///
/// Installing the parent (a row in `apps` with `agentId = parent`)
/// cascade-installs required deps (creates additional Apps in the
/// same org, one per dep). Optional deps install only if the caller
/// passes `installOptional`.
///
/// v1 enforces **1-level imports only** — the dep itself must NOT be
/// a parent of any AgentImport. Cycles are trivially blocked at write
/// time (`parentAgentId != importedAgentId`).
// 008-agent-installation (2026-05-02): directed Agent→Agent dependency
// edge. v1 enforces 1-level imports only (the dep itself must not be
// a parent of any AgentImport). The composite FK to AgentOrgGrant is
// the Builder-grant authorizing this import — the spec named this
// agent_subscription_id (FR-005); R-2 renamed it to the new sibling
// table since the universal-grant role lives on AgentOrgGrant for
// org-level grants, not AgentSubscription (which stays User↔Agent).
model AgentImport {
  /// The Agent that does the importing (the "Suite"). ON DELETE
  /// CASCADE.
  parentAgentId        String   @map("parent_agent_id")
  /// The dep Agent. ON DELETE RESTRICT — deleting it would
  /// invalidate every Suite that depends on it; operators must
  /// remove the import edge first.
  importedAgentId      String   @map("imported_agent_id")
  /// Sparse-int ordering (per 008 R-8). Builders set values like
  /// 100, 200, 300 to allow easy reordering without renumbering.
  position             Int
  /// Hard dep vs optional. Default `true`.
  required             Boolean  @default(true)
  /// Composite fk to `AgentOrgGrant(orgId, agentId)` (ON DELETE
  /// RESTRICT) — the Builder grant authorizing this import. Spec
  /// FR-005 named this column `agent_subscription_id`; renamed per
  /// 008 R-2 since the universal-grant role for org-level grants
  /// lives on the new `AgentOrgGrant` sibling, not `AgentSubscription`.
  agentOrgGrantOrgId   String   @map("agent_org_grant_org_id")
  agentOrgGrantAgentId String   @map("agent_org_grant_agent_id")
  createdAt            DateTime @default(now()) @map("created_at")
  createdBy            String?  @map("created_by")

  parentAgent   Agent         @relation("ParentAgent", fields: [parentAgentId], references: [id], onDelete: Cascade)
  importedAgent Agent         @relation("ImportedAgent", fields: [importedAgentId], references: [id], onDelete: Restrict)
  agentOrgGrant AgentOrgGrant @relation(fields: [agentOrgGrantOrgId, agentOrgGrantAgentId], references: [orgId, agentId], onDelete: Restrict)

  @@id([parentAgentId, importedAgentId])
  @@unique([parentAgentId, position]) // prevents two imports at the same position under the same parent
  @@index([importedAgentId])
  @@map("agent_imports")
}

/// The User-side license: "this user is authorized to use this agent."
/// Auto-provisioned on first user-attributed contact (per
/// `controller/operations/ensureAgentSubscription.ts`); revocable by
/// an ADMIN/OWNER of the Agent's owning org. Authorizes the cross-org
/// write from the Agent into the user's *personal*-class Memory.
///
/// Sibling to `AgentOrgGrant` (Org↔Agent, added in
/// 008-agent-installation). Both share the lifecycle field shape and
/// the same `isLifecycleActive` predicate; AgentSubscription
/// continues to express User↔Agent grants while AgentOrgGrant covers
/// Org↔Agent (App-creation + import-bundling) grants.
///
/// Spec: 005-agent-subscription (2026-04-30). Composite primary key
/// on `(userId, agentId)`.
///
/// **No deletedAt** — soft-delete is redundant with `revokedAt`.
///
/// **Active-status predicate** (used by the access-resolver):
///
///     activatedAt IS NOT NULL
///       AND revokedAt IS NULL
///       AND (expiresAt IS NULL OR expiresAt > now())
///
/// **Revocation behavior** (per FR-028 / FR-029): when revoked, the
/// user's personal Memory of the Agent is **retained** by default —
/// the user owns it, may want to keep their notes after a class ends.
/// The Agent loses write access (per FR-019); the user retains read
/// access via direct authenticated queries. The
/// `Memory.userMemoryOfAgentId` pivot is preserved so the memory
/// remains identifiable as "originally from Agent X." **Single
/// exception**: if the personal Memory has zero nodes at revocation
/// time, the platform may hard-delete it alongside the
/// AgentSubscription (avoids orphan accumulation).
// User-side license expressing "this user is authorized to use this agent."
// Auto-provisioned on first user-attributed contact (per
// `controller/operations/ensureAgentSubscription.ts`); revocable by an
// ADMIN/OWNER of the Agent's owning org. Spec: 005-agent-subscription
// (2026-04-30). Authorizes the cross-org write from the Agent into the
// user's personal-class Memory.
model AgentSubscription {
  userId      String    @map("user_id")
  agentId     String    @map("agent_id")
  // Lifecycle. v1 default: activatedAt = now() on creation. Future billing
  // work introduces a deferred-activation path (activatedAt = null until
  // payment confirms).
  /// v1 default: `now()` on creation since billing is out of scope;
  /// future billing introduces a deferred-activation path
  /// (activatedAt = null until payment confirms).
  activatedAt DateTime? @map("activated_at") @db.Timestamptz()
  /// Time-bounded subscriptions; NULL for non-expiring.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz()
  /// Set by an ADMIN/OWNER of the Agent's owning org via
  /// `revokeAgentSubscription`.
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz()
  /// fk to User.id — audit trail.
  revokedBy   String?   @map("revoked_by")
  // Standard audit fields. (No deletedAt — soft-delete is redundant with
  // the revokedAt lifecycle; if a row needs to truly disappear it's a
  // hard delete.)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz()
  updatedBy   String?   @map("updated_by")

  user  User  @relation("UserAgentSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  agent Agent @relation("AgentUserSubscriptions", fields: [agentId], references: [id], onDelete: Cascade)

  @@id([userId, agentId])
  @@index([agentId])
  @@map("agent_subscriptions")
}

/// Log entry for a specific App, surfaced in hadron-portal for
/// troubleshooting.
model AppLogEntry {
  id        String    @id @default(cuid())
  appId     String    @map("app_id")
  level     LogLevel
  memoryId  String?   @map("memory_id")
  sessionId String?   @map("session_id")
  /// Human-readable log message.
  message   String
  /// Structured context.
  detail    Json?
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([appId, createdAt])
  @@index([level])
  @@index([createdAt])
  @@map("app_log")
}

// ─── 023-app-shape: multi-Agent App + per-Memory authorization ─────────

/// N:M join between `App` and `Agent`, reintroduced by spec 023.
///
/// **No `role` column** — system memory is read-only to every App
/// regardless (the pre-008 OPERATE/DEVELOP distinction stays deleted
/// per spec 023 FR-003). **No `trainingMode` column** — training mode
/// is a per-App setting and lives on `App.trainingMode` (spec 023
/// FR-001; deviates from the 2026-05-12-user-installing-app summary
/// §3 to avoid per-Agent conflicts on an App-wide setting).
///
/// **Transition note**: `App.agentId` was dropped and consumers
/// retrofitted in Phase 2b ([hadron-server#129](https://github.com/hadron-memory/hadron-server/pull/129),
/// 2026-05-17). Install flows go through the `installAgentIntoApp`
/// mutation (spec 023 US1, [hadron-server#130](https://github.com/hadron-memory/hadron-server/pull/130))
/// which writes an `AppAgent` row.
///
/// **Cascade behavior**: hard `App` or `Agent` deletion cascades to
/// the `AppAgent` row. Uninstalling an Agent from an App (deleting
/// the row) does NOT cascade-delete the (app_id, agent_id, *) memories
/// (FR-005; orphan retention preserved). Duplicate inserts for the
/// same (app_id, agent_id) are rejected by the composite PK.
model AppAgent {
  appId     String    @map("app_id")
  agentId   String    @map("agent_id")
  // Audit fields mirror AppMember (no soft-delete). Uninstall is a
  // hard row delete; predicate lookups use `findUnique` on the
  // composite PK with no filter.
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  app   App   @relation(fields: [appId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([appId, agentId])
  @@index([agentId])
  @@map("app_agents")
}

/// Asymmetric cross-user grant for personal-class memory (spec 023
/// US3 / FR-017–FR-022). Composite PK `(memoryId, granteeId)` — one
/// row per (Memory, grantee).
///
/// **Scope**: applies ONLY to personal-class Memories (FR-018).
/// Application-layer guard in `createMemoryShare.ts` enforces this.
///
/// **Grantor semantics** (FR-019): `grantorId` is the **principal**
/// (`Memory.userId`), recorded explicitly so the row is
/// self-describing without a JOIN to `memories` at read time. The
/// API actor (which may be an App backend acting on the principal's
/// behalf) is recorded in `createdBy`.
///
/// **No time-window** (FR-021): isolation between grantees over time
/// is modeled by creating a new personal Memory per pairing — not by
/// time-slicing one Memory.
model MemoryShare {
  memoryId  String          @map("memory_id")
  granteeId String          @map("grantee_id")
  grantorId String          @map("grantor_id")
  role      MemoryShareRole
  // Audit fields (no soft-delete). Revoke is a hard row delete (FR-022);
  // predicate lookups use `findUnique` on the composite PK.
  createdAt DateTime        @default(now()) @map("created_at")
  createdBy String?         @map("created_by")
  updatedAt DateTime?       @updatedAt @map("updated_at")
  updatedBy String?         @map("updated_by")

  memory  Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  grantee User   @relation("MemorySharesGranted", fields: [granteeId], references: [id], onDelete: Cascade)
  grantor User   @relation("MemorySharesByGrantor", fields: [grantorId], references: [id], onDelete: Cascade)

  @@id([memoryId, granteeId])
  @@index([granteeId])
  @@index([grantorId])
  @@map("memory_shares")
}

/// Symmetric team membership for group-class memory (spec 023 US4 /
/// FR-026–FR-031). Composite PK `(memoryId, userId)` — one row per
/// (Memory, member).
///
/// **Scope**: applies ONLY to group-class Memories (FR-027).
/// Application-layer guard in `addMemoryMember.ts` enforces this.
///
/// **Role capabilities**:
///   `reader` — read.
///   `writer` — read + write nodes within the Memory.
///   `owner`  — read + write + manage member list, delete/rename the
///              Memory, change Memory configuration (FR-036).
///
/// **Last-owner protection** (FR-038): the platform rejects removal
/// or demotion of the sole remaining `owner`. The MemoryMember row
/// can still be deleted; the operation-layer guard enforces the
/// invariant (`removeMemoryMember.ts`, `updateMemoryMemberRole.ts`).
/// FR-031: removing the last non-owner does NOT delete the Memory.
model MemoryMember {
  memoryId  String           @map("memory_id")
  userId    String           @map("user_id")
  role      MemoryMemberRole
  // Audit fields (no soft-delete). Remove is a hard row delete (FR-038
  // protects the last owner; non-owner removal is unrestricted);
  // predicate lookups use `findUnique` on the composite PK.
  createdAt DateTime         @default(now()) @map("created_at")
  createdBy String?          @map("created_by")
  updatedAt DateTime?        @updatedAt @map("updated_at")
  updatedBy String?          @map("updated_by")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user   User   @relation("MemoryMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([memoryId, userId])
  @@index([userId])
  @@map("memory_members")
}

/// User-owned API key — the credential primitive for user-scoped MCP
/// access (spec 025-oauth-for-mcp; D-2026-05-13-001, D-2026-05-17-001).
/// Mirrors AppKey but resolves to a User instead of an App. The raw key is
/// `hdr_user_<…>`; we store SHA-256 (not bcrypt) for the same reason
/// AppKey does — direct hash lookup needs a deterministic hash, and the
/// 256-bit raw key (32 bytes / 64 hex chars) already makes dictionary
/// attacks irrelevant.
///
/// Tokens issued by the OAuth /token endpoint share this shape and storage
/// path so a single `resolveUserApiKey` middleware validates both
/// portal-minted and OAuth-issued tokens (FR-015). The path the key
/// arrived through is recorded in `issuedVia` (not `createdBy`); see the
/// column docstrings.
///
/// **Audit fields omitted (matches AppKey precedent):** no `updatedAt` /
/// `updatedBy` / `deletedAt` / `deletedBy`. UserApiKey rows are
/// append-once with a single terminal state transition (revoked);
/// `revokedAt` carries the lifecycle info, and there is no edit
/// operation. Soft-delete is meaningless for a revocable credential.
model UserApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  /// SHA-256 hash of the raw `hdr_user_<…>` key.
  keyHash    String    @unique @map("key_hash")
  /// Last 4 characters of the raw key for masked display.
  keyPreview String    @map("key_preview")
  /// Human-friendly name for this key.
  label      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Actor that minted this key. Schema-wide convention: `User.id` of
  /// the actor. For self-service v1 this equals `userId`; the column
  /// exists for future admin-issued paths (where actor != owner).
  createdBy  String?   @map("created_by")
  /// Issuance-path discriminator: `'portal'` for createUserApiKey
  /// GraphQL mutation; `'oauth:<client_id>'` for /oauth/token-issued
  /// tokens. Distinct from `createdBy` so the audit-actor convention
  /// is preserved.
  issuedVia  String?   @map("issued_via")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_api_keys")
}

/// OAuth 2.1 client registry (spec 025-oauth-for-mcp; D-2026-05-17-002).
/// Rows are populated by `POST /oauth/register` (RFC 7591 DCR) or seeded
/// explicitly. Public clients only (no `clientSecret`); PKCE S256 is the
/// auth proof. Per Q-025-001, only the `'test'` row will be seeded by
/// `prisma/seed.ts` (spec 025 task T009 — not yet in this PR);
/// `'claude-desktop'` and other real clients self-register via DCR.
///
/// **PK note:** `clientId` is the PK (no separate cuid `id`) because
/// `clientId` is the natural key — it's the public, immutable identifier
/// the client sends on every `/authorize` / `/token` request and is
/// referenced by `AuthCode.clientId` as the FK target. Precedent for a
/// non-cuid PK: `Session.id` is caller-generated. Diverges from PR 137's
/// reference (which carried a separate cuid `id`) — see
/// `spec-kits/specs/025-oauth-for-mcp/data-model.md` §OAuthClient.
///
/// Carries the full standard audit-field set per the schema-top
/// convention because edit / delete affordances are anticipated (admin
/// "rename a client", "rotate redirect URIs", etc.); v1 has no such
/// surface, but the columns are cheap to add now and would otherwise
/// need a backfill later.
model OAuthClient {
  /// The public client identifier. DCR-registered:
  /// `dcr_<32 hex>` (16 bytes / 128 bits). Seeded fixtures use stable
  /// identifiers like `'test'`. Primary key.
  clientId     String    @id @map("client_id")
  clientName   String    @map("client_name")
  /// Allowed redirect URIs. /authorize must reject any redirect_uri
  /// not present here (OAuth 2.1 §3.1.2).
  redirectUris String[]  @map("redirect_uris")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  authCodes AuthCode[]

  @@map("oauth_clients")
}

/// Short-lived OAuth authorization code (spec 025-oauth-for-mcp;
/// RFC 6749 §4.1). Issued by `POST /oauth/authorize` on
/// `decision=approve`, redeemed once at `POST /oauth/token`. Stores PKCE
/// S256 challenge + RFC 8707 resource indicators for verification at
/// redemption. Single-use via race-safe `updateMany`-with-conditional
/// `redeemedAt: null` pattern (FR-013). PKCE / resource mismatch at
/// /token also marks `redeemedAt` to prevent probing.
///
/// **Code storage:** the raw code value is hashed (SHA-256) before
/// storage, matching `AppKey.keyHash` and `UserApiKey.keyHash` — auth
/// codes are credentials in their 10-minute redemption window and should
/// not be plaintext in the DB. `/oauth/authorize` returns the raw code
/// to the client; `/oauth/token` hashes the supplied code and looks up
/// by hash. Diverges from PR 137's reference (which stored plaintext)
/// — see `spec-kits/specs/025-oauth-for-mcp/contracts/oauth-endpoints.md`
/// §`POST /oauth/token`.
///
/// **Audit fields omitted (matches AppKey precedent):** no `updatedAt` /
/// `updatedBy` / `deletedAt` / `deletedBy`. AuthCode rows are append-once
/// with two terminal state transitions (redeemed / expired); `redeemedAt`
/// and `expiresAt` carry the lifecycle info. Soft-delete is meaningless
/// for a single-use, expiring credential.
model AuthCode {
  id            String    @id @default(cuid())
  /// SHA-256 hash of the raw code value handed to the client. Looked up
  /// by hash at /token to avoid plaintext credentials in the DB.
  codeHash      String    @unique @map("code_hash")
  clientId      String    @map("client_id")
  userId        String    @map("user_id")
  redirectUri   String    @map("redirect_uri")
  /// PKCE S256 challenge value (base64url, no padding).
  codeChallenge String    @map("code_challenge")
  /// RFC 8707 resource indicator(s) captured at /authorize. Multi-valued
  /// per RFC 8707 §2; v1 MCP usage populates a single element (the MCP
  /// endpoint URL). Application enforces ≥1 element.
  resource      String[]
  expiresAt     DateTime  @map("expires_at")
  redeemedAt    DateTime? @map("redeemed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  /// Actor that initiated the /authorize request that minted this code.
  /// Resolves to the signed-in User; equals `userId` in self-service v1.
  createdBy     String?   @map("created_by")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@map("auth_codes")
}

/// Short-lived, single-use handoff codes that keep the session JWT out of
/// browser-visible URLs (#477). Two kinds share the same shape:
///   - 'login'          — minted after GitHub/email auth; the portal's server
///                        `load` redeems it at POST /auth/session for the JWT,
///                        which it sets as an HttpOnly cookie. For the GitHub
///                        flow `clientStateHash` binds the finishing browser to
///                        the login it started (session-fixation defense); the
///                        email flow leaves it null (magic links open cross-device).
///   - 'exchange_start' — minted by POST /auth/microsoft/start (Bearer-authed,
///                        server-to-server) so the long-lived JWT never rides in
///                        the /auth/microsoft redirect URL.
/// The raw code is only ever handed out once; the DB stores its SHA-256 hash.
/// Single use is enforced by an atomic `updateMany(redeemedAt: null)` claim,
/// mirroring AuthCode. DB-backed (not in-memory) so it survives multi-worker
/// deploys, unlike the legacy pendingStates maps.
model AuthHandoffCode {
  id              String    @id @default(cuid())
  /// SHA-256 hash of the raw code handed to the browser/portal.
  codeHash        String    @unique @map("code_hash")
  /// 'login' | 'exchange_start'.
  kind            String
  userId          String    @map("user_id")
  /// Post-redemption destination path (login: portal path; exchange: return path).
  redirect        String?
  /// login only — whether the user was just provisioned (drives /app/setup).
  isNew           Boolean   @default(false) @map("is_new")
  /// exchange_start only — the org the Exchange connection is being attached to.
  orgId           String?   @map("org_id")
  /// login+GitHub only — SHA-256 of the portal-set browser nonce; the redeemer
  /// must present the matching raw nonce (constant-time compared).
  clientStateHash String?   @map("client_state_hash")
  expiresAt       DateTime  @map("expires_at")
  redeemedAt      DateTime? @map("redeemed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_handoff_codes")
}

// ─── Spec 040 — headless agent runs ─────────────────────────────────────────
// Plan: specs/040-headless-runs/plan.md (D-2026-07-04 A–F over the 2026-05/06
// design corpus). Spec: cor:agt:010 (+ cor:acl:040/:050).

enum AppRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  TIMED_OUT
  CANCELLED
}

enum AppRunTriggerKind {
  SCHEDULE
  WEBHOOK
  MANUAL
  INTEGRATION
  /// Fan-out (plan-spawn): child + callback runs minted by hadron_spawn;
  /// triggerId carries the parent run id.
  SPAWN
}

/// One headless run (cor:agt:010:02). Simultaneously the audit record AND —
/// v1, D-2026-07-04-D — the activation: created only after the launch gate
/// passes; every action inside the run re-checks status + policy and
/// decrements the live budgets; zeroing a budget or setting CANCELLED halts
/// the run at its next action (the kill switch). Also the outbox row for
/// run.requested.v1 (publishedAt NULL ⇒ sweep republishes).
model AppRun {
  id             String            @id
  organizationId String            @map("organization_id")
  appId          String            @map("app_id")
  agentId        String?           @map("agent_id")
  /// On-behalf-of user (cor:agt:010:01, D-2026-07-04-C). NULL ⇒ pure App
  /// service identity — no personal/private reach.
  userId         String?           @map("user_id")
  triggerKind    AppRunTriggerKind @map("trigger_kind")
  triggerId      String?           @map("trigger_id")
  entryNodeUrn   String            @map("entry_node_urn")
  eventData      Json?             @map("event_data")
  /// Run envelope (D-2026-05-09-013): the mutable bag of fields extracted
  /// by flow nodes as the walker advances. Bare field names — conditions
  /// address them through the evaluator's `message.data.*` scope prefix
  /// (plan-multi-node D-MN-1). `eventData` stays the immutable trigger
  /// payload; on key collision the envelope wins.
  data           Json?
  /// Per-hop trail (#538): the walked path, one element per COMPLETED hop,
  /// appended in the same checkpoint/finish UPDATE the runner already
  /// writes. `[{node, edgeOut, startedAt, finishedAt, tokensSpent}]` —
  /// edgeOut is the routing edge taken FROM the hop (null on the last).
  /// Bounded by RUN_MAX_HOPS. A hop that FAILS mid-execution has no
  /// element; `curNodeUrn` + `failure` identify it.
  hops           Json?
  /// PARENT-side fan-out state (plan-spawn D-SP-1): set by hadron_spawn —
  /// {processItem, itemKey, callback?, itemCallback?, total, dispatching?,
  /// callbackFiredAt?}. Its own column, NOT `data`: the parent's envelope
  /// checkpoint would clobber a mid-hop write there. callbackFiredAt is the
  /// exactly-once claim (D-SP-4, atomic SQL).
  spawn          Json?
  /// Run-layer allow-list snapshot (the narrowest chain link; plan §4).
  policy         Json?
  /// Remaining LLM tokens — live-decrement kill switch.
  budgetTokens   Int?              @map("budget_tokens")
  /// Remaining tool/write actions — live-decrement kill switch.
  budgetActions  Int?              @map("budget_actions")
  /// #832 — the budget this run was MINTED with, so a client can render
  /// "spent vs budget". `budgetTokens` above is what REMAINS. NULL on runs
  /// minted before the column existed.
  budgetTokensInitial  Int?        @map("budget_tokens_initial")
  budgetActionsInitial Int?        @map("budget_actions_initial")
  /// #832 — cumulative spend, incremented in the same write as the budget
  /// decrement. Deliberately NOT derived:
  ///   * a `hops` sum under-reports — a hop that failed mid-execution has no
  ///     element, which is exactly the run an operator is auditing;
  ///   * `initial - remaining` under-reports too — the decrement is CLAMPED
  ///     (`Math.min(spent, budget)`) so the remaining budget never goes
  ///     negative, and an overspending run would report exactly its budget.
  /// These counters are unclamped and therefore truthful in overage.
  ///
  /// NULLABLE with a default: new runs start at 0, while a run minted BEFORE
  /// the columns existed is genuinely UNKNOWN rather than zero — reporting 0
  /// for a run whose already-decremented budget proves otherwise would be a
  /// false total (PR #854 review, Codex P2). `tokens_spent` is backfilled from
  /// the hop trail where one exists; `actions_spent` has no such signal.
  ///
  /// KNOWN GAP: a hop aborted by the tool loop (ToolDenied / ToolExecution /
  /// AuthorFail) does not increment. The provider has already billed that
  /// call, but generateWithTools discards the accumulated usage when a tool
  /// throws, so the number is not available at the failure site. Tracked
  /// separately; see the GraphQL field docs.
  tokensSpent    Int?              @default(0) @map("tokens_spent")
  actionsSpent   Int?              @default(0) @map("actions_spent")
  status         AppRunStatus      @default(PENDING)
  curNodeUrn     String?           @map("cur_node_urn")
  parentRunId    String?           @map("parent_run_id")
  failure        Json?
  timeoutMs      Int?              @map("timeout_ms")
  attempts       Int               @default(0)
  publishedAt    DateTime?         @map("published_at")
  startedAt      DateTime?         @map("started_at")
  finishedAt     DateTime?         @map("finished_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  createdBy      String?           @map("created_by")

  webFetchPollBindings  WebFetchPollBinding[]  @relation("WebFetchPollSourceRun")
  webFetchEventReceipts WebFetchEventReceipt[] @relation("WebFetchEventRoutedRun")

  @@index([status, publishedAt])
  @@index([appId, createdAt])
  @@index([triggerId, status])
  @@index([parentRunId]) // spawn completion checks + child listings (plan-spawn)
  @@index([organizationId, createdAt])
  @@map("app_runs")
}

/// Recurring trigger (cor:agt:010, D-2026-07-04-E) — per-kind table
/// mirroring the decided AgentWebhook shape. The scheduler claims rows by
/// (enabled, nextRunAt) and mints an AppRun per due tick.
model AgentSchedule {
  id             String    @id
  organizationId String    @map("organization_id")
  appId          String    @map("app_id")
  agentId        String?   @map("agent_id")
  /// On-behalf-of user, captured at creation (cor:agt:010:01).
  userId         String?   @map("user_id")
  name           String
  /// 5-field cron expression, evaluated in `timezone` — recurring
  /// schedules. XOR with `runAt` (chk_agent_schedule_cron_xor_run_at).
  cron           String?
  timezone       String    @default("UTC")
  /// One-shot: run once at this instant (#510). XOR with `cron`; the
  /// scheduler claim flips `enabled` to false instead of advancing
  /// `nextRunAt`. Misfire policy unchanged (overdue runs once).
  runAt          DateTime? @map("run_at")
  entryNodeUrn   String    @map("entry_node_urn")
  eventData      Json?     @map("event_data")
  /// Trigger-layer allow-list (chain link; plan §4).
  policy         Json?
  /// Per-trigger AI-config override (name into the spec-036 walk).
  aiConfigName   String?   @map("ai_config_name")
  enabled        Boolean   @default(true)
  lastRunAt      DateTime? @map("last_run_at")
  /// Next due time — the scheduler's work signal. A skipped overlap STILL
  /// advances this (plan §7; prevents back-to-back storms).
  nextRunAt      DateTime? @map("next_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  @@index([enabled, nextRunAt])
  @@index([appId, deletedAt])
  @@map("agent_schedules")
}

/// Continuous quota tier (cor:acl:050:01/:04): windowed counters per App and
/// per org for run.execute + llm.tokens. Checked at the launch gate and
/// decremented live during runs.
model QuotaCounter {
  id        String   @id
  scopeKind String   @map("scope_kind")
  scopeId   String   @map("scope_id")
  action    String
  window    String
  used      Int      @default(0)
  limit     Int
  resetAt   DateTime @map("reset_at")

  @@unique([scopeKind, scopeId, action, window])
  @@map("quota_counters")
}

/// Consumable quota tier (cor:acl:050:01/:04): TAN-style tickets, v1 required
/// only for the outbound-communication action class. The ledger answers
/// "where did they all go?" — every consumption names the run.
model ActionTicket {
  id              String    @id
  organizationId  String    @map("organization_id")
  appId           String?   @map("app_id")
  action          String
  mintedBy        String    @map("minted_by")
  note            String?
  consumedByRunId String?   @map("consumed_by_run_id")
  consumedAt      DateTime? @map("consumed_at")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([organizationId, action, consumedAt])
  @@map("action_tickets")
}

/// Provider price row for one (provider, model, tier) triple — the rate
/// source for UsageEvent.costMicroCents AND the debit markup (spec 046
/// FR-002/FR-003). Effective-dated: lookup takes the latest
/// `effectiveAt <= eventTime` with `deletedAt IS NULL`; price changes
/// append a new row, never mutate an old one (historical costs stay
/// auditable — stamped costs are snapshots, so soft-deleting a mispriced
/// row is safe and is the "retire" lever). Prices are in micro-cents
/// (1e-8 USD) per MILLION tokens — e.g. $3/MTok input = 30_000_000.
/// Operator-managed via `setAiModelPrice` (platform admin); an absent
/// triple means "no cost computed", never a blocked call.
/// String columns, no enums — validation lives in src/lib/metering.
model AiModelPrice {
  id                      String    @id
  provider                String
  model                   String
  /// Pricing tier 1-3 (Holger, 2026-07-11): reserved room for future
  /// product tiers carrying different markups per (provider, model)
  /// WITHOUT another AiModelPrice migration. Everything defaults to and
  /// resolves tier 1 until tiers become a real product concept; the
  /// semantics of 2/3 are deliberately undefined today. Validated 1-3 in
  /// code (setAiModelPrice / getAiModelPrice), no CHECK by convention.
  tier                    Int       @default(1)
  /// Micro-cents per 1M input tokens.
  inputMicroCentsPerMTok  BigInt    @map("input_micro_cents_per_mtok")
  /// Micro-cents per 1M output tokens.
  outputMicroCentsPerMTok BigInt    @map("output_micro_cents_per_mtok")
  /// Markup applied when debiting platform-key spend at THIS tier, in
  /// basis points (2500 = 25%) — integer-exact, no float money. NULL
  /// falls back to the CREDIT_MARKUP_PERCENT env (which this column
  /// supersedes). Effective-dated with the rest of the row.
  markupBasisPoints       Int?      @map("markup_basis_points")
  /// Row applies to events at/after this instant (until a later row).
  effectiveAt             DateTime  @map("effective_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  createdBy               String?   @map("created_by")
  updatedAt               DateTime? @updatedAt @map("updated_at")
  updatedBy               String?   @map("updated_by")
  deletedAt               DateTime? @map("deleted_at")
  deletedBy               String?   @map("deleted_by")

  @@unique([provider, model, tier, effectiveAt])
  @@index([provider, model, tier])
  @@map("ai_model_prices")
}

/// Append-only monetary ledger for an organization's AI credits (spec 046
/// FR-005). Signed amounts: grants +, debits −, adjustments ±; balance is
/// SUM(amountMicroCents). Rows are NEVER mutated, deleted, or reset — this
/// is the durable billing record (unlike QuotaCounter's daily counters).
/// `expiresAt` on grants is stored policy only in Phase 0 (jurisdictions
/// restrict prepaid expiry — see the spec's legal notes); FIFO expiry
/// enforcement is a later phase. Automatic usage debits are gated by
/// BILLING_DEBIT_ENABLED and apply only to platform-key spend (FR-004/006).
/// Audit columns follow the schema-wide convention; the SANCTIONED
/// correction is an `adjustment` row — soft-delete is break-glass ops only
/// (balance and reads exclude soft-deleted rows, codebase-wide semantic).
model CreditLedgerEntry {
  id               String    @id
  organizationId   String    @map("organization_id")
  /// 'grant' | 'debit' | 'adjustment' (validated in src/lib/metering).
  kind             String
  /// Signed micro-cents (1e-8 USD). Grants positive, debits negative.
  amountMicroCents BigInt    @map("amount_micro_cents")
  /// Grant expiry policy field (no enforcement in Phase 0).
  expiresAt        DateTime? @map("expires_at")
  /// Provenance: e.g. ('usage-event', <UsageEvent.id>), ('admin', <userId>),
  /// later ('payment', <processor ref>).
  sourceType       String?   @map("source_type")
  sourceId         String?   @map("source_id")
  note             String?
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Idempotency for at-least-once payment webhooks (hadrontool-billing):
  // one ledger row per (sourceType, sourceId); NULL-source rows unaffected
  // (Postgres unique treats NULLs as distinct).
  @@unique([sourceType, sourceId])
  @@index([organizationId, createdAt])
  @@map("credit_ledger_entries")
}

/// Webhook trigger (D-2026-05-02, spec 040 plan §8) — per-kind table like
/// AgentSchedule. URL shape: /hooks/<secret>/<name>?hpt=<platform JWT>.
/// The opaque secret is the lookup key (no app/agent IDs in the URL);
/// the time-limited platform JWT is the second factor — a leaked URL is
/// useless without it (D-2026-05-02-006).
model AgentWebhook {
  id             String    @id
  organizationId String    @map("organization_id")
  appId          String    @map("app_id")
  agentId        String?   @map("agent_id")
  /// On-behalf-of user, captured at creation (cor:agt:010:01).
  userId         String?   @map("user_id")
  name           String
  /// Opaque URL secret — unique lookup key, never reused across webhooks.
  secret         String    @unique
  /// JSON Schema for POST args (stored in v1; Ajv enforcement is follow-on).
  argsSchema     Json?     @map("args_schema")
  entryNodeUrn   String    @map("entry_node_urn")
  eventData      Json?     @map("event_data")
  policy         Json?
  aiConfigName   String?   @map("ai_config_name")
  enabled        Boolean   @default(true)
  lastCalledAt   DateTime? @map("last_called_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  @@index([appId, deletedAt])
  @@map("agent_webhooks")
}
