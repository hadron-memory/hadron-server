generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  CONTRIBUTOR
  READER
}

enum ClientType {
  WORKSTATION
  AGENT
  AUTOMATION
  CLOUD
  IOT
}

enum SubscriptionType {
  READ_ONLY
  READ_WRITE
}

enum SessionType {
  DEVELOPER
  CHATBOT
  AUTOMATION
  EDGE
}

enum SyncStatus {
  PENDING
  SYNCING
  OK
  ERROR
}

enum IdentityProvider {
  GITHUB
  EMAIL
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum MemoryLogEventType {
  SYNC
  LICENSE
  EDGE
  OTHER
}

enum Visibility {
  PUBLIC
  PRIVATE
}

// ─── Models ────────────────────────────────────────────────────────────

model User {
  id               String            @id @default(cuid())
  githubId         Int?              @unique @map("github_id")
  githubUsername    String?           @unique @map("github_username")
  identityProvider IdentityProvider? @map("identity_provider")
  name             String?
  email            String?           @unique
  avatarUrl        String?           @map("avatar_url")
  roles            Role[]            @default([READER])
  maxReferrals     Int?              @map("max_referrals")
  createdAt        DateTime          @default(now()) @map("created_at")
  createdBy        String?           @map("created_by")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  updatedBy        String?           @map("updated_by")
  deletedAt        DateTime?         @map("deleted_at")
  deletedBy        String?           @map("deleted_by")

  memberships               OrgMember[]
  clients                   Client[]
  sentInvitations           UserInvitation[]           @relation("SentInvitations")
  invitationActivations     UserInvitationActivation[]
  receivedMemberInvitations OrgMemberInvitation[]      @relation("ReceivedMemberInvitations")
  pendingSetup              PendingSetup?

  @@map("users")
}

model Organization {
  id                           String   @id @default(cuid())
  name                         String
  domain                       String   @unique
  isVisible                    Boolean? @map("is_visible")
  githubInstallationId         Int?     @unique @map("github_installation_id")
  githubAppId                  String?  @map("github_app_id")
  githubAppPrivateKeyEncrypted String?  @map("github_app_private_key_encrypted")
  createdAt                    DateTime @default(now()) @map("created_at")
  createdBy                    String?  @map("created_by")
  updatedAt                    DateTime @updatedAt @map("updated_at")
  updatedBy                    String?  @map("updated_by")
  deletedAt                    DateTime? @map("deleted_at")
  deletedBy                    String?  @map("deleted_by")

  members       OrgMember[]
  memories      Memory[]
  clients       Client[]
  memoryBundles MemoryBundle[]
  subscriptions MemorySubscription[]
  invitations   UserInvitation[]     @relation("OrgInvitations")

  @@map("organizations")
}

model OrgMember {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           Role     @default(READER)
  canInvite      Boolean  @default(false) @map("can_invite")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String?  @map("created_by")
  updatedAt      DateTime? @map("updated_at")
  updatedBy      String?  @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?  @map("deleted_by")

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentMemberInvitations OrgMemberInvitation[] @relation("SentByMember")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("org_members")
}

model Client {
  id             String     @id @default(cuid())
  userId         String?    @map("user_id")
  organizationId String?    @map("organization_id")
  clientType     ClientType @default(WORKSTATION) @map("client_type")
  label          String
  keyHash        String     @map("key_hash")
  apiKeyShown    Boolean    @default(false) @map("api_key_shown")
  role           Role       @default(READER)
  namespace      String?
  description    String?
  expiresAt      DateTime?  @map("expires_at")
  lastUsedAt     DateTime?  @map("last_used_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  createdBy      String?    @map("created_by")
  updatedAt      DateTime?  @map("updated_at")
  updatedBy      String?    @map("updated_by")
  deletedAt      DateTime?  @map("deleted_at")
  deletedBy      String?    @map("deleted_by")

  user                User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization        Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  bundleSubscriptions ClientBundleSubscription[]
  sessions            Session[]
  usageEvents         UsageEvent[]
  logEntries          ClientLogEntry[]

  @@unique([organizationId, label])
  @@unique([userId, label])
  @@map("clients")
}

model ClientBundleSubscription {
  id               String           @id @default(cuid())
  clientId         String           @map("client_id")
  bundleId         String           @map("bundle_id")
  subscriptionType SubscriptionType @default(READ_ONLY) @map("subscription_type")
  trainingMode     Boolean          @default(false) @map("training_mode")
  createdAt        DateTime         @default(now()) @map("created_at")
  createdBy        String?          @map("created_by")
  updatedAt        DateTime?        @map("updated_at")
  updatedBy        String?          @map("updated_by")
  deletedAt        DateTime?        @map("deleted_at")
  deletedBy        String?          @map("deleted_by")

  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bundle MemoryBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([clientId, bundleId])
  @@map("client_bundle_subscriptions")
}

model Memory {
  id                   String     @id @default(cuid())
  organizationId       String     @map("organization_id")
  name                 String
  source               String?
  sourceTokenEncrypted String?    @map("source_token_encrypted")
  sourceTokenExpiresAt DateTime?  @map("source_token_expires_at")
  readBranch           String?    @map("read_branch")
  writeBranch          String?    @map("write_branch")
  visibility           Visibility @default(PRIVATE)
  requiresLicense      Boolean    @default(false) @map("requires_license")
  lastSyncedAt         DateTime?  @map("last_synced_at")
  syncStatus           SyncStatus @default(PENDING) @map("sync_status")
  syncError            String?    @map("sync_error")
  pendingEdgeCount     Int        @default(0) @map("pending_edge_count")
  createdAt            DateTime   @default(now()) @map("created_at")
  createdBy            String?    @map("created_by")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  updatedBy            String?    @map("updated_by")
  deletedAt            DateTime?  @map("deleted_at")
  deletedBy            String?    @map("deleted_by")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodes         Node[]
  subscriptions MemorySubscription[]
  bundleItems   MemoryBundleItem[]
  licenses      MemoryLicense[]
  logEntries    MemoryLogEntry[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("memories")
}

model Node {
  id          String   @id // UUIDv7 from node.yaml — stable across moves
  memoryId    String   @map("memory_id")
  name        String
  title       String
  alias       String?
  loc         String
  isLink      Boolean  @default(false) @map("is_link")
  description String?
  content     String?
  contentHash String?  @map("content_hash")
  tokens      Int?
  tags        String[]
  namespace   String
  ownerRepo   String?  @map("owner_repo")
  isRunnable  Boolean? @map("is_runnable")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?  @map("deleted_by")

  memory        Memory        @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  outgoingEdges Edge[]        @relation("SourceNode")
  incomingEdges Edge[]        @relation("TargetNode")
  pendingEdges  PendingEdge[]
  usageEvents   UsageEvent[]
  versions      NodeVersion[]

  @@unique([loc, memoryId])
  @@index([loc])
  @@index([namespace])
  @@index([memoryId])
  @@map("nodes")
}

model Edge {
  id       String    @id @default(cuid())
  sourceId String    @map("source_id")
  targetId String    @map("target_id")
  label    String
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  source Node @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target Node @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, label])
  @@index([targetId])
  @@map("edges")
}

model PendingEdge {
  id       String    @id @default(cuid())
  sourceId String    @map("source_id")
  targetId String    @map("target_id") // intended target node id — NOT a FK
  label    String?
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  source Node @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([targetId])
  @@map("pending_edges")
}

model Session {
  id              String      @id // caller-generated (e.g. UUID from h-start-session)
  type            SessionType @default(DEVELOPER)
  clientId        String?     @map("client_id")
  repo            String?
  branch          String?
  prNumber        Int?        @map("pr_number")
  customerId      String?     @map("customer_id")
  language        String?
  plan            String?
  llmModel        String?     @map("llm_model")
  inputTokens     Int?        @map("input_tokens")
  outputTokens    Int?        @map("output_tokens")
  turnCount       Int?        @map("turn_count")
  errorCount      Int?        @map("error_count")
  parentSessionId String?     @map("parent_session_id")
  prevSessionId   String?     @map("prev_session_id")
  summary         String?
  outcome         Float?
  outcomeRef      String?     @map("outcome_ref")
  outcomeMeta     Json?       @map("outcome_meta")
  startedAt       DateTime    @default(now()) @map("started_at")
  endedAt         DateTime?   @map("ended_at")
  autoExpiredAt   DateTime?   @map("auto_expired_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  createdBy       String?     @map("created_by")
  updatedAt       DateTime?   @map("updated_at")
  updatedBy       String?     @map("updated_by")
  deletedAt       DateTime?   @map("deleted_at")
  deletedBy       String?     @map("deleted_by")

  client       Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  events       UsageEvent[]
  parent       Session?   @relation("SubAgentSessions", fields: [parentSessionId], references: [id], onDelete: SetNull)
  subSessions  Session[]  @relation("SubAgentSessions")
  prev         Session?   @relation("SessionChain", fields: [prevSessionId], references: [id], onDelete: SetNull)
  nextSessions Session[]  @relation("SessionChain")

  @@index([type])
  @@index([repo])
  @@index([customerId])
  @@index([startedAt])
  @@index([parentSessionId])
  @@index([prevSessionId])
  @@index([clientId])
  @@map("sessions")
}

model UsageEvent {
  id         String    @id @default(cuid())
  type       String
  nodeLoc    String?   @map("node_loc")
  nodeId     String?   @map("node_id")
  sessionId  String?   @map("session_id")
  clientId   String?   @map("client_id")
  actionArgs Json?     @map("action_args")
  model      String?
  tokensIn   Int?      @map("tokens_in")
  tokensOut  Int?      @map("tokens_out")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime? @map("updated_at")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  node    Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([nodeLoc])
  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
  @@index([clientId])
  @@map("usage_events")
}

model MemoryBundle {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items               MemoryBundleItem[]
  clientSubscriptions ClientBundleSubscription[]

  @@unique([organizationId, name])
  @@map("memory_bundles")
}

model MemoryBundleItem {
  id       String    @id @default(cuid())
  bundleId String    @map("bundle_id")
  memoryId String    @map("memory_id")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  bundle MemoryBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  memory Memory       @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([bundleId, memoryId])
  @@map("memory_bundle_items")
}

model MemoryLicense {
  id          String    @id @default(cuid())
  memoryId    String    @map("memory_id")
  licenseType String    @map("license_type")
  seats       Int
  validFrom   DateTime  @map("valid_from")
  validUntil  DateTime  @map("valid_until")
  licenseKeys String[]  @map("license_keys")
  terms       String
  activated   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  memory        Memory              @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  subscriptions MemorySubscription[]

  @@map("memory_licenses")
}

model MemorySubscription {
  id             String    @id @default(cuid())
  memoryId       String    @map("memory_id")
  organizationId String    @map("organization_id")
  licenseId      String?   @map("license_id")
  role           Role      @default(READER)
  activated      Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  memory       Memory         @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  license      MemoryLicense? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@unique([memoryId, organizationId])
  @@index([organizationId])
  @@map("memory_subscriptions")
}

model HadronServer {
  id              String    @id @default(cuid())
  organizationId  String?   @map("organization_id")
  url             String
  logLevel        LogLevel  @default(ERROR) @map("log_level")
  version         String?
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime? @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  logEntries ServerLogEntry[]

  @@map("hadron_server")
}

model ServerLogEntry {
  id        String    @id @default(cuid())
  serverId  String    @map("server_id")
  level     LogLevel
  memoryId  String?   @map("memory_id")
  message   String
  detail    Json?
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  server HadronServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([level])
  @@index([createdAt])
  @@map("server_log")
}

model ClientLogEntry {
  id        String    @id @default(cuid())
  clientId  String    @map("client_id")
  level     LogLevel
  memoryId  String?   @map("memory_id")
  sessionId String?   @map("session_id")
  message   String
  detail    Json?
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([level])
  @@index([createdAt])
  @@map("client_log")
}

model MemoryLogEntry {
  id        String             @id @default(cuid())
  memoryId  String             @map("memory_id")
  level     LogLevel
  eventType MemoryLogEventType @map("event_type")
  message   String
  detail    Json?
  createdAt DateTime           @default(now()) @map("created_at")
  createdBy String?            @map("created_by")
  updatedAt DateTime?          @map("updated_at")
  updatedBy String?            @map("updated_by")
  deletedAt DateTime?          @map("deleted_at")
  deletedBy String?            @map("deleted_by")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([level])
  @@index([eventType])
  @@index([createdAt])
  @@map("memory_log")
}

model OrgMemberInvitation {
  id              String    @id @default(cuid())
  memberUserId    String    @map("member_user_id")
  recipientUserId String    @map("recipient_user_id")
  role            Role      @default(READER)
  expiresAt       DateTime? @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime? @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  sender    OrgMember @relation("SentByMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  recipient User      @relation("ReceivedMemberInvitations", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@map("org_member_invitations")
}

model UserInvitation {
  id             String    @id @default(cuid())
  senderUserId   String?   @map("sender_user_id")
  organizationId String?   @map("organization_id")
  slug           String    @unique
  userRole       Role?     @map("user_role")
  memberRole     Role      @default(READER) @map("member_role")
  newUserId      String?   @map("new_user_id")
  name           String?
  email          String?
  githubUsername  String?   @map("github_username")
  phoneNumber    String?   @map("phone_number")
  maxActivations Int?      @map("max_activations")
  expiresAt      DateTime? @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  sender       User?          @relation("SentInvitations", fields: [senderUserId], references: [id], onDelete: SetNull)
  organization Organization?  @relation("OrgInvitations", fields: [organizationId], references: [id], onDelete: SetNull)
  activations  UserInvitationActivation[]

  @@map("user_invitations")
}

model UserInvitationActivation {
  id           String    @id @default(cuid())
  invitationId String    @map("invitation_id")
  userId       String    @map("user_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime? @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  invitation UserInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_invitation_activations")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("email_verification_tokens")
}

model NodeVersion {
  id          String   @id @default(cuid())
  nodeId      String   @map("node_id")
  loc         String
  name        String
  title       String
  alias       String?
  description String?
  content     String?
  tags        String[]
  editedBy    String?  @map("edited_by")
  createdAt   DateTime @default(now()) @map("created_at")

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
  @@map("node_versions")
}

model PendingSetup {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  clientId        String   @map("client_id")
  rawKeyEncrypted String   @map("raw_key_encrypted")
  consumed        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pending_setups")
}
