generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  // 033-rag-vector-retrieval: postgresqlExtensions is still a preview feature
  // in Prisma 6.x; enables the `extensions` block below so `prisma db push` /
  // `migrate` manage `CREATE EXTENSION vector` (pgvector).
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // 033-rag-vector-retrieval: pgvector. db push/migrate runs CREATE EXTENSION
  // vector before creating the vector(768) column on node_embeddings.
  extensions = [vector]
}

// ─── Hadron entity model ──────────────────────────────────────────────
//
// This schema is the **canonical** source of entity definitions for the
// Hadron platform. The legacy Entities.md (in the sister `hadron-concept`
// repo, at hadron-specs/General/Entities.md) was folded into this file on
// 2026-05-11 and deleted; do not recreate it.
//
// Cross-repo references below cite paths in sister repos by repo name
// (e.g. `hadron-concept/...`, `hadron-docs/...`). Those trees do not live
// in this repository.
//
// Shared audit fields
// -------------------
// Every model below carries the same audit columns (not re-described per
// field to keep the file readable):
//   createdAt, createdBy   — set at row insert (createdBy is fk-ish to
//                            User.id but unconstrained for system writes)
//   updatedAt, updatedBy   — set on every update (Prisma @updatedAt)
//   deletedAt, deletedBy   — soft-delete marker; null = live row
// A handful of tables (AppMember, AgentSubscription, AgentOrgGrant) omit
// deletedAt/deletedBy on purpose — soft-delete is redundant there because
// the row has a richer lifecycle field (revokedAt) or is a pure join with
// no meaningful "soft-deleted" state. Each such table calls this out in
// its model-level doc.
//
// URN convention
// --------------
// Globally addressable entities (Organization, Memory, Agent, App) carry
// both a `urn` (unique, stable, colon-delimited identifier) and a `name`
// (human-friendly display label, not unique). Colon is the structural
// delimiter. URN shapes:
//   - Organization: `<domain>`               e.g. "baragaun.com"
//   - Memory:       `<org>:<slug>`           e.g. "baragaun.com:secureid"
//   - Agent:        `<org>:<slug>`           e.g. "micromentor.org:juno"
//   - App:          `<org>:<slug>`           e.g. "baragaun.com:internal-ops"
//   - Node:         `<memory.urn>:<loc>`     computed, NOT stored
//   - Asset:        computed, NOT stored — the read surface emits grammar v2
//                   `hrn:asset:<root>:<mem...>:assets:<asset.id>` (see the
//                   Asset model doc and the GraphQL `Asset.urn` docstring).
// The four stored shapes above are the BARE column values. Every read surface
// renders them through the grammar-v2 emitters (#697 Stage 2), so a client sees
// `hrn:org:` / `hrn:mem:` / `hrn:agent:` / `hrn:app:` prefixes that the column
// itself does not carry — and for Memory the `chk_memory_urn_not_prefixed`
// guardrail actively rejects storing the rendered form.
// Full scheme: `hadron-concept/hadron-specs/General/URN.md` (sister repo).
//
// Table naming
// ------------
// All model `@@map(...)` names are explicit snake_case. Most are plural
// (`users`, `organizations`, `memories`), but some are singular by
// convention — `hadron_server`, `server_log`, `memory_log`, `app_log`,
// `waiting_list`. Prisma would default to PascalCase otherwise; the
// explicit map keeps the SQL surface stable across model renames.

// ─── Enums ─────────────────────────────────────────────────────────────

/// Global / organization-membership role. Used on OrgMember.role,
/// MemorySubscription.role, and the *Invitation roles. Hierarchy:
/// OWNER > ADMIN > CONTRIBUTOR > READER. Invitations cannot grant a
/// role higher than the sender's own. **Note**: MemorySubscription /
/// OrgMemberInvitation / UserInvitation use this full enum at the
/// column level, but the intended grant set is narrower (typically
/// CONTRIBUTOR | READER for subscriptions; admin | contributor |
/// reader for invitations). Tightening the column is reserved for a
/// future cleanup spec.
enum Role {
  OWNER
  ADMIN
  CONTRIBUTOR
  READER
}

/// Per-App default role assigned to new members when no Agent
/// `installation_policy.memberRoles` override applies. Free-form
/// AppMember.role strings (validated against installation_policy) are
/// distinct from this enum — the enum survives mainly for legacy
/// App.role storage.
enum AppMembershipRole {
  OWNER
  ADMIN
  CONTRIBUTOR
  READER
}

/// **Deprecated** in favor of App.surfaces (008-agent-installation
/// R-4). Kept to avoid spurious portal churn; a follow-up cleanup
/// spec will drop it.
enum AppType {
  WORKSTATION
  CHATBOT
  AGENT
  AUTOMATION
  CLOUD
  IOT
}

/// Reserved enum — declared but not currently referenced by any
/// column. A 2026-Q3 marketplace-licensing spec is expected to wire
/// this into MemorySubscription. Flagged for cleanup-if-not-used.
enum SubscriptionType {
  READ_ONLY
  READ_WRITE
}

/// Coarse classification of a Session: who/what is driving it.
///   DEVELOPER  — interactive coding session (Claude Code, Cursor, …)
///   CHATBOT    — end-user chat through an App (e.g. Juno)
///   AUTOMATION — non-interactive run (cron, CI, scripted agent)
///   EDGE       — triggered by an Edge condition firing
enum SessionType {
  DEVELOPER
  CHATBOT
  AUTOMATION
  EDGE
}

/// State machine for Memory git-sync and ExchangeConnection mailbox
/// sync. Transitions: PENDING → SYNCING → OK | ERROR; ERROR rows can
/// re-enter SYNCING on retry.
enum SyncStatus {
  PENDING
  SYNCING
  OK
  ERROR
}

/// How a User authenticated. APP is reserved for users provisioned
/// via App-scoped flows (e.g. chatbot `createAppUser`); GOOGLE landed
/// with Sign-in-with-Google (#581), APPLE with Sign-in-with-Apple
/// (#584); MICROSOFT is reserved for future SSO.
enum IdentityProvider {
  GITHUB
  EMAIL
  APP
  GOOGLE
  MICROSOFT
  APPLE
}

/// App-level policy for whether the App may create new platform Users
/// on-the-fly when a chatbot session arrives with a previously-unseen
/// external id.
///   DENY     — never create; reject the request
///   EXPLICIT — only via the `createAppUser` mutation
///   IMPLICIT — auto-create on first contact (used by Workstation apps)
enum CreateUserPermission {
  DENY
  EXPLICIT
  IMPLICIT
}

/// App-level policy for how to resolve "which User is this?" from the
/// incoming session credential.
///   USER_ID — the App passes our internal User.id (default; trust-the-caller)
///   SECRET  — the App passes a per-user secret we look up
enum IdentifyUserMethod {
  USER_ID
  SECRET
}

/// **Largely legacy**. The Agent.type field below carries the coarse
/// behavior hint (ASSISTANT vs CHATBOT). Post-008-agent-installation
/// most behavior is driven by surfaces / installation_policy /
/// memory_provisioning, not this enum. Kept for backward-compat with
/// portal listings; a follow-up cleanup spec may collapse it.
enum AgentType {
  ASSISTANT
  CHATBOT
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// Tag for MemoryLogEntry rows to support filtered tail views in
/// hadron-portal (e.g. "show me only sync errors for this memory").
enum MemoryLogEventType {
  SYNC
  LICENSE
  EDGE
  OTHER
}

/// Memory visibility — **035-visibility-enum-cleanup**. Meaningful only
/// for `knowledge` (PUBLIC/ORGANIZATION) and `group` (GROUP); NULL for
/// every other class. The `PERSONAL`/`PRIVATE` values were dropped (spec
/// 034 moved privacy onto the `personal`/`private` CLASS). The
/// `chk_memory_visibility_class` CHECK forbids a non-null visibility on
/// any class other than knowledge/group.
enum MemoryVisibility {
  PUBLIC
  ORGANIZATION
  /// 023-app-shape: bidirectional with `MemoryClass.group`. Enforced by
  /// the `chk_memory_group_visibility` CHECK constraint:
  /// `class = 'group' ⇔ visibility = 'GROUP'`.
  GROUP
}

/// Agent visibility — **035-visibility-enum-cleanup** split this off the
/// shared `MemoryVisibility` enum. `PERSONAL` is the creator-only draft
/// state (named PERSONAL, not PRIVATE, so it never collides with the
/// memory `private` class). `Organization.agents` filters on it;
/// `createAgent` defaults to it.
enum AgentVisibility {
  PUBLIC
  ORGANIZATION
  PERSONAL
}

/// Per-Memory typology — formalized in 005-agent-subscription
/// (2026-04-30); per-class governance refined in 008-agent-installation
/// (2026-05-02), re-keyed onto `class` by 034-memory-class-access.
/// `personal`/`private`-class memories MUST have Memory.userId set
/// (chk_personal_visibility_user). `app`-class MUST have Memory.appId set;
/// `personal`/`private` MAY have it (set when app-scoped, NULL when
/// free-standing); `system`/`knowledge`/`group` MUST NOT
/// (chk_memory_class_app_id, relaxed by spec 034).
///
///   system     — the Agent's own definition (one per Agent, linked via
///                Agent.systemMemoryId). Universally read-only from any
///                App context post-008 (DEVELOP-from-App is dropped per
///                R-10). Edits happen in the Agent ownership surface.
///   app        — records the App writes through the Agent (chat history,
///                extracted facts, generated artifacts). Keyed on
///                (app_id, agent_id) for shared-app-memory Agents,
///                (app_id, agent_id, user_id) for per-user-app-memory.
///                Spec 017 (2026-05-12): app-class memories named
///                `${app.urn}:${agentSlug}:shared` are the v1 home for
///                SHARED chats (chats readable by every AppMember of
///                the App). Keyed per-(App, Agent) so the multi-Agent
///                App from 2026-05-12-user-installing-app §3 — where
///                one App can install N Agents under the reintroduced
///                AppAgent join — gives each installed Agent its own
///                shared memory. Lazy-provisioned by
///                `findOrCreateAppClassMemory` on the first shared
///                chat for an (App, Agent) pair.
///   knowledge  — reference content the Agent reads from. Per-Agent
///                (not per-App); two installs of the same Agent share
///                the same knowledge memory.
///   personal   — per-user records owned by Memory.userId. App-scoped by
///                (app_id, agent_id, user_id) when provisioned inside an
///                app (the per-App pivot gives Mike-on-two-orgs clean
///                isolation), OR free-standing (app_id/agent NULL) when a
///                user creates it directly (spec 034). Strict ownership.
///   private    — single-owner, owner-only (no MemoryShare path, no
///                ADMIN/OWNER bypass). Spec 034 (#242) made it
///                user-creatable via createMemory — free-standing or
///                app-scoped. May opt into encrypt-at-rest, but the
///                encryption implementation is a deferred follow-up, so
///                **do not rely on at-rest encryption for secrets yet.**
enum MemoryClass {
  system
  app
  knowledge
  personal
  /// 023-app-shape: symmetric team-shared memory. Governance is by
  /// `MemoryMember` (list of users with roles `reader | writer | owner`),
  /// not by a single Memory.userId owner. `Memory.userId IS NULL` for
  /// group-class rows (enforced by `chk_memory_group_no_owner`). The
  /// bidirectional invariant `class = 'group' ⇔ visibility = 'GROUP'`
  /// is enforced by `chk_memory_group_visibility`.
  group
  private
}

/// 023-app-shape: role on a `MemoryShare` row (asymmetric cross-user
/// grant for personal-class memory). `reader` permits read; `writer`
/// permits read and write.
enum MemoryShareRole {
  reader
  writer
}

/// 023-app-shape: role on a `MemoryMember` row (symmetric membership
/// for group-class memory). `reader` permits read; `writer` permits
/// read and write; `owner` adds management capabilities (add/remove
/// members, change roles, delete/rename/configure the Memory) per
/// spec 023 FR-036. The platform protects against zero-owner states:
/// removing or demoting the sole remaining `owner` is rejected with
/// `LAST_OWNER_PROTECTED` (FR-038).
enum MemoryMemberRole {
  reader
  writer
  owner
}

/// Asset virus-scan state. Downloads are gated on CLEAN. Transitions:
/// PENDING → CLEAN | BLOCKED.
enum AssetScanStatus {
  PENDING
  CLEAN
  BLOCKED
}

// ─── Models ────────────────────────────────────────────────────────────

/// A person who uses Hadron, authenticated via GitHub OAuth (or email
/// in future). N:N to Organization via OrgMember. (Spec 048: signup no
/// longer auto-creates a personal organization — an individual owns
/// Apps/Agents/Memories directly via spec 047 user-owned tenancy.)
///
/// **Invitation chain**: UserInvitationActivation links each User back
/// to their UserInvitation, whose senderUserId points to the inviter,
/// recursively up to the root (senderUserId IS NULL = system seed from
/// Baragaun).
///
/// **Referral quota** (`maxReferrals`): the maximum number of new
/// platform users this user is allowed to onboard. Unaccepted
/// invitations don't count; the count is on accepted activations only.
/// Quota is tracked transitively up the chain — if A invites B and B
/// invites C, both A's and B's quotas decrement when C joins. When
/// sending an invite, `UserInvitation.maxActivations` must not exceed
/// the minimum free quota across the inviter's referral chain. There
/// is a known race condition: if a referral starts onboarding and the
/// "create account" request would push the chain over quota, the
/// account is still created (don't block a real human on a counter).
model User {
  id               String            @id @default(cuid())
  /// Unique username, e.g. "holger"; displayed as `@holger` in UI and node
  /// frontmatter `author` field, and the owner namespace of a user-owned
  /// App/Agent/Memory URN (spec 047). NOT NULL (all users backfilled 2026-07-14):
  /// every real signup path assigns one via `generateUniqueHandle`; the
  /// DB-generated random default is a backstop for handle-omitting inserts
  /// (test fixtures) so those need no churn. Case-insensitive uniqueness is the
  /// `users_handle_lower_uniq` functional index (post-push.sql); the `@unique`
  /// here is the plain case-sensitive one.
  handle           String            @unique @default(dbgenerated("\"left\"(md5((random())::text), 12)"))
  /// User-layer action-policy link (cor:acl:040:02) — constrains runs made
  /// on-behalf-of this user. Same allow-list shape as Organization.policy;
  /// NULL = no restriction. Self-authored (updateMyPolicy).
  policy           Json?
  /// GitHub numeric account id.
  githubId         Int?              @unique @map("github_id")
  /// GitHub login.
  githubUsername   String?           @unique @map("github_username")
  /// Google account id — the OIDC `sub` claim (#581). A string of digits,
  /// but stored as text: Google documents it as an opaque string and it
  /// can exceed 2^53.
  googleId         String?           @unique @map("google_id")
  /// Apple account id — the Sign-in-with-Apple `sub` claim (#584). An
  /// opaque team-scoped string (e.g. "001234.abcd1234ef….0102").
  appleId          String?           @unique @map("apple_id")
  identityProvider IdentityProvider? @map("identity_provider")
  // 005-agent-subscription discovery (2026-04-30): R-5 in research.md
  // proposed dropping `externalId`, but the implementation found that
  // `createAppUser` and `startAgentSession` use it as the lookup key
  // for "find the existing User this chatbot already provisioned for
  // external-7." Dropping it would force every chatbot call to create
  // a new User row (no idempotency) or require the chatbot to track
  // the hadron user-id itself on every call. That requires a separate
  // design discussion — restored `externalId` for now; deferred the
  // drop. See spec.md §"Assumptions" for the deferral note.
  /// App-scoped external user id. Composite-unique with `externalAppId`.
  externalId       String?           @map("external_id")
  /// The App that minted this externalId. Forms a (App, externalId)
  /// idempotency key for chatbot user provisioning.
  externalAppId    String?           @map("external_app_id")
  /// When this app-scoped external identity was linked to the
  /// platform User (i.e. when the chatbot user "graduated" to a real
  /// account).
  linkedAt         DateTime?         @map("linked_at")
  name             String?
  /// Used for invite matching and email-based auth.
  email            String?           @unique
  avatarUrl        String?           @map("avatar_url")
  /// Global platform roles (not org-scoped). Default `[READER]`.
  roles            Role[]            @default([READER])
  /// Maximum number of new platform users this user can onboard. See
  /// the model-level doc for the referral-quota semantics.
  maxReferrals     Int?              @map("max_referrals")
  createdAt        DateTime          @default(now()) @map("created_at")
  createdBy        String?           @map("created_by")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  updatedBy        String?           @map("updated_by")
  deletedAt        DateTime?         @map("deleted_at")
  deletedBy        String?           @map("deleted_by")

  memberships                   OrgMember[]
  sentInvitations               UserInvitation[]            @relation("SentInvitations")
  invitationActivations         UserInvitationActivation[]
  receivedMemberInvitations     OrgMemberInvitation[]       @relation("ReceivedMemberInvitations")
  pendingSetup                  PendingSetup?
  exchangeConnections           ExchangeConnection[]
  connectionGrantsByUser        ConnectionGrant[]           @relation("ConnectionGrantsByUser")
  principalGrants               PrincipalGrant[]            @relation("UserPrincipalGrants")
  externalApp                   App?                        @relation(fields: [externalAppId], references: [id], onDelete: SetNull)
  sessions                      Session[]                   @relation("SessionUser")
  /// #1050 — worker names this person HOLDS. Held until released, never freed
  /// by a session ending; one human may hold many.
  heldWorkers                   Worker[]                    @relation("WorkerHolder")
  /// #1705 — agent tasks this person owns / is assigned.
  ownedAgentTasks               AgentTask[]                 @relation("AgentTaskOwnerUser")
  assignedAgentTasks            AgentTask[]                 @relation("AgentTaskAssigneeUser")
  mcpSessionStates              McpSessionState[]
  ownedMemories                 Memory[]                    @relation("UserMemoriesOwned")
  // spec 047 (Phase 2b): entities this user is the TENANT owner of (user-owned
  // App/Agent/Memory). `ownedMemories` above is the personal/private strict
  // owner (Memory.userId) — a DIFFERENT relation from `tenantMemories` here.
  ownedApps                     App[]                       @relation("AppOwner")
  ownedAgents                   Agent[]                     @relation("AgentOwner")
  tenantMemories                Memory[]                    @relation("MemoryTenantOwner")
  agentSubscriptions            AgentSubscription[]         @relation("UserAgentSubscriptions")
  appMemberships                AppMember[]                 @relation("UserAppMemberships")
  // 023-app-shape: per-Memory authorization back-relations.
  memorySharesGranted           MemoryShare[]               @relation("MemorySharesGranted")
  memorySharesByGrantor         MemoryShare[]               @relation("MemorySharesByGrantor")
  memoryMemberships             MemoryMember[]              @relation("MemoryMemberships")
  // 025-oauth-for-mcp: user-level credential + OAuth back-relations.
  userApiKeys                   UserApiKey[]
  authCodes                     AuthCode[]
  passkeyCredentials            PasskeyCredential[]
  freshSignIns                  FreshSignIn[]
  passkeyCeremonies             PasskeyCeremony[]
  passkeyRegistrationNotices    PasskeyRegistrationNotice[]
  pendingEmailSignIns           PendingEmailSignIn[]
  signIns                       SignIn[]
  authHandoffCodes              AuthHandoffCode[]
  // #620: revisions this user approved (NodeRevision.approvedBy).
  approvedNodeRevisions         NodeRevision[]              @relation("NodeRevisionApprover")
  // 046-usage-metering: billing attribution back-relation.
  usageEvents                   UsageEvent[]
  // #772: the user's placed /app/dashboard widgets (user-scoped layout config).
  dashboardWidgets              DashboardWidget[]
  // #806: the user's SAVED widget configurations (a palette, not a placement).
  dashboardWidgetPresets        DashboardWidgetPreset[]
  // Admin impersonation (read-only support sessions): sessions this user
  // started as the admin actor / was the target of.
  impersonationSessionsAsAdmin  ImpersonationSession[]      @relation("ImpersonationSessionsAsAdmin")
  impersonationSessionsAsTarget ImpersonationSession[]      @relation("ImpersonationSessionsAsTarget")
  // #692 — the user's root principal in the unified pool (handle is the
  // denormalized read source-of-truth, kept in sync at mint).
  principalId                   String?                     @unique @map("principal_id")
  principal                     Principal?                  @relation("UserPrincipal", fields: [principalId], references: [id], onDelete: SetNull)
  /// #1325 — MemoryConfig templates this user owns (user-owned owner branch).
  memoryConfigTemplates         MemoryConfigTemplate[]      @relation("MemoryConfigTemplateOwnerUser")
  /// #1715 — this account's merge into another, if it was merged away.
  mergedInto                    UserMerge?                  @relation("UserMergeSource")
  /// #1715 — accounts merged into this one.
  mergedFrom                    UserMerge[]                 @relation("UserMergeTarget")

  @@unique([externalAppId, externalId])
  @@map("users")
}

/// #1715 — one account merge (`mergeUsers`): the source account was merged
/// into the target, which survives. Written in the merge transaction and never
/// changed, so it is keyed on the source: an account is merged away at most
/// once (it is soft-deleted, so it can never be a merge's target later, which
/// also keeps the chains acyclic).
///
/// Records that store user ids inside authenticated data (decision and
/// decision-log payloads, #1641) are never rewritten by a merge. Readers
/// follow a stored id through these rows, transitively, to the account that
/// survives (src/lib/userMerges.ts). So `targetUserId` is deliberately NOT
/// retargeted by a later merge of the target: the chain is what resolves it.
model UserMerge {
  sourceUserId   String   @id @map("source_user_id")
  targetUserId   String   @map("target_user_id")
  mergedAt       DateTime @default(now()) @map("merged_at")
  /// The acting admin at the merge. Null only on historical merge records.
  mergedBy       String?  @map("merged_by")
  /// #1642: sealed dual-login consent evidence; absent only on historical merges.
  consentHash    String?  @unique @map("consent_hash")
  consentReceipt Json?    @map("consent_receipt")

  source User @relation("UserMergeSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  target User @relation("UserMergeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@map("user_merges")
}

/// #1642: a single-use approval for one ordered, full-account consolidation.
/// User ids are sealed snapshots, deliberately not retargeted on later merges.
model UserMergeConsent {
  id                String    @id @default(cuid())
  proofHash         String    @unique @map("proof_hash")
  sourceUserId      String    @map("source_user_id")
  targetUserId      String    @map("target_user_id")
  requestedBy       String    @map("requested_by")
  scope             String    @default("FULL_CONSOLIDATION")
  createdAt         DateTime  @default(now()) @map("created_at")
  expiresAt         DateTime  @map("expires_at")
  sourceLoginAt     DateTime? @map("source_login_at")
  sourceLoginMethod String?   @map("source_login_method")
  targetLoginAt     DateTime? @map("target_login_at")
  targetLoginMethod String?   @map("target_login_method")
  consumedAt        DateTime? @map("consumed_at")

  @@map("user_merge_consents")
}

/// The kinds of widget that can be placed on a user's /app/dashboard grid
/// (#772). Add a member when a new widget ships; each type has a server-side
/// data provider feeding the combined `dashboardWidgetData` query.
enum DashboardWidgetType {
  MEMORY_STATS
  AGENT_STATS
  USAGE_ACTIVITY
}

/// A widget the user has placed on their /app/dashboard grid (#772) —
/// user-scoped layout configuration, one row per placed widget, ordered by
/// `position`. Owner-only: no org, no sharing. The whole set is read via
/// `dashboardWidgets` and replaced atomically via `setDashboardWidgets`.
model DashboardWidget {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  type      DashboardWidgetType
  /// Columns to span on the 12-col desktop grid (clamped on smaller screens).
  span      Int                 @default(4)
  /// Rows to span on the fixed-height row grid (#788; clamped server-side to 1-4).
  rowSpan   Int                 @default(1) @map("row_span")
  /// Widget-instance settings, shape widget-defined (#788) — e.g. a stats
  /// widget scoped to one org. Stored + round-tripped only; no server-side
  /// behavior until dashboardWidgetData goes per-instance.
  config    Json?
  /// 0-based sort order among the user's widgets.
  position  Int                 @default(0)
  createdAt DateTime            @default(now()) @map("created_at")
  createdBy String?             @map("created_by")
  updatedAt DateTime            @updatedAt @map("updated_at")
  updatedBy String?             @map("updated_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@map("dashboard_widgets")
}

/// A named, user-scoped widget configuration (#806) — a palette entry the
/// portal COPIES into a placement's `config` on apply. Deliberately not a live
/// link: editing a preset never reaches back into placements already seeded
/// from it, and deleting one never orphans a placement. Generic over widget
/// types so the next configurable widget inherits the mechanism.
///
/// Owner-only in every direction, like DashboardWidget: no org, no sharing.
model DashboardWidgetPreset {
  id     String              @id @default(cuid())
  userId String              @map("user_id")
  type   DashboardWidgetType
  /// Display name, unique per (user, type). Trimmed, 1-60 chars.
  name   String
  /// The saved settings, shape widget-defined — same 4KB cap and plain-object
  /// guard as a placement's `config`, since it becomes one verbatim.
  config Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, name])
  @@index([userId, type])
  @@map("dashboard_widget_presets")
}

/// A company, team, or group that owns memories and has members.
/// Must have at least one OrgMember with role OWNER (can have many).
model Organization {
  id                           String    @id @default(cuid())
  name                         String
  /// The organization's domain name, e.g. "baragaun.com",
  /// "micromentor.org". Serves as the namespace for all resources
  /// owned by this org (URN prefix).
  urn                          String    @unique
  /// Opt-in marketplace catalogue flag (cor:acl:080:04): whether this org is
  /// advertised in the marketplace browse. DISTINCT from access/visibility —
  /// it governs advertisement, not who may read the org. Contributes to
  /// non-member discoverability (cor:acl:080:02). (Spec 048 dropped the former
  /// `isVisible` listing flag with the auto-personal org — every org now lists.)
  listedOnMarketplace          Boolean   @default(false) @map("listed_on_marketplace")
  /// GitHub App installation id. Used to mint ephemeral tokens
  /// (1-hour expiry) for memory git-sync against repos within this
  /// installation's scope.
  githubInstallationId         Int?      @unique @map("github_installation_id")
  githubAppId                  String?   @map("github_app_id")
  /// AES-256-GCM-encrypted GitHub App private key. Plaintext never
  /// stored or shown after initial entry. Encryption key:
  /// HADRON_ENCRYPTION_KEY env var.
  githubAppPrivateKeyEncrypted String?   @map("github_app_private_key_encrypted")
  createdAt                    DateTime  @default(now()) @map("created_at")
  createdBy                    String?   @map("created_by")
  updatedAt                    DateTime  @updatedAt @map("updated_at")
  updatedBy                    String?   @map("updated_by")
  deletedAt                    DateTime? @map("deleted_at")
  deletedBy                    String?   @map("deleted_by")

  members         OrgMember[]
  memories        Memory[]
  agents          Agent[]
  subscriptions   MemorySubscription[]
  principalGrants PrincipalGrant[]
  /// Org-layer action-policy link of the conjunctive chain (cor:acl:040:02):
  /// allow-list JSON `{ "allow": ["action", "prefix.*", "*"] }`. NULL = no
  /// restriction (the layer is absent, not deny-all). Snapshotted into
  /// AppRun.policy at mint — edits apply to FUTURE runs only.
  policy          Json?

  invitations            UserInvitation[]        @relation("OrgInvitations")
  exchangeConnections    ExchangeConnection[]
  slackConnections       SlackConnection[]
  mcpServers             McpServer[]
  homeAssistantInstances HomeAssistantInstance[]
  resendSender           ResendSender?
  // 046-usage-metering: billing back-relations.
  usageEvents            UsageEvent[]
  creditLedgerEntries    CreditLedgerEntry[]
  apps                   App[]
  agentOrgGrants         AgentOrgGrant[]
  aiServiceConfigs       AiServiceConfig[]
  // Admin impersonation (read-only support sessions) scoped to this org.
  impersonationSessions  ImpersonationSession[]
  mcpSessionStates       McpSessionState[]
  scopes                 Scope[]
  registerEntries        RegisterEntry[]
  // #692 — the org's root principal in the unified pool (urn is the denormalized
  // read source-of-truth, kept in sync at mint).
  principalId            String?                 @unique @map("principal_id")
  principal              Principal?              @relation("OrgPrincipal", fields: [principalId], references: [id], onDelete: SetNull)

  memoryConfigTemplates MemoryConfigTemplate[]

  @@map("organizations")
}

/// #692 — the unified per-server PRINCIPAL POOL. One row per root name (a user
/// handle OR an organization name), enforcing CROSS-KIND uniqueness by
/// constraint so a URN `<root>` atom resolves to exactly one principal without
/// an `@` sigil or kind marker (GitHub's model). Users and Organizations FK
/// into this; their own `handle` / `urn` columns stay the denormalized read
/// source-of-truth, kept in sync inside the mint transaction.
///
/// A released root name is TOMBSTONED (`status = 'released'`, the owning
/// user/org detached) — the row is kept, and the `name @unique` spans ALL
/// statuses, so a released name is reserved FOREVER (indefinite, no recycling —
/// the identity guarantee the `@`-sigil rename-safety is replaced by). Reserved
/// platform words (`hadron`, `platform`, …) are pre-seeded rows with
/// `status = 'reserved'`. `name` is written lowercased everywhere, so the plain
/// (Prisma-modeled) unique doubles as case-insensitive and backs `findUnique`.
model Principal {
  id         String    @id @default(cuid())
  /// The canonical root name, stored lowercase. `@unique` is a plain (case-
  /// sensitive) index, which is sufficient because every write lowercases the
  /// name (mintPrincipal + the migration backfill) — so it is effectively
  /// case-insensitive AND index-backed for the `findUnique` availability probe.
  /// Spans ALL statuses (no status filter), so a `released` tombstone reserves
  /// its name forever (indefinite, no recycling).
  name       String    @unique
  /// 'user' | 'org' | 'platform'.
  kind       String
  /// 'active' | 'released' (tombstone) | 'reserved' (platform word).
  status     String    @default("active")
  releasedAt DateTime? @map("released_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user         User?         @relation("UserPrincipal")
  organization Organization? @relation("OrgPrincipal")

  @@map("principals")
}

/// Associates a User with an Organization. To remove a User from an
/// Organization, delete the OrgMember row. Must NOT delete the
/// OrgMember if it is the only one with role OWNER (enforced at the
/// resolver, not the schema).
model OrgMember {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  role           Role      @default(READER)
  /// Whether this member can invite other existing platform users to
  /// the organization. Inviting a *new* platform user (UserInvitation)
  /// is governed separately by User.maxReferrals.
  canInvite      Boolean   @default(false) @map("can_invite")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentMemberInvitations OrgMemberInvitation[] @relation("SentByMember")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("org_members")
}

/// A Hadron knowledge graph, owned by an Organization. The four-way
/// `class` field (system / app / knowledge / personal) governs
/// addressing and access — see the MemoryClass enum doc.
///
/// **Git-backed memories** — the root `node.yaml` in the repo is the
/// **memory manifest**, declaring the memory's urn and marketplace
/// metadata. On import the server reads this manifest and creates or
/// updates the Memory row. The org portion of the URN must match an
/// existing Organization on the server.
///
/// **Git authentication** — the server first tries the owning
/// Organization's `githubInstallationId` to mint ephemeral tokens
/// (1-hour expiry). If the repo is outside the GitHub App's scope
/// (different GitHub org, personal repo, GitLab, etc.), the server
/// falls back to `sourceTokenEncrypted`. The GitHub App's private key
/// (used to sign JWT requests for installation tokens) lives in the
/// server's environment/secrets manager — not in the database. For
/// the SaaS server, Baragaun manages this key.
///
/// **Token encryption** — `sourceTokenEncrypted` uses AES-256-GCM
/// with a symmetric key from the server's environment
/// (HADRON_ENCRYPTION_KEY). Plaintext never stored or shown after
/// initial entry. To replace an expired/revoked token, the user
/// pastes a new one (overwrites the old encrypted value). Key
/// rotation: re-encrypt all stored tokens with the new key in a
/// single migration.
model Memory {
  id                    String  @id @default(cuid())
  organizationId        String? @map("organization_id")
  /// The user TENANT owner of a user-owned Memory (rooted on the bare
  /// `<handle>` — #697 v2, no `@` sigil). DISTINCT from `userId` (the
  /// personal/private strict-owner). The exactly-one-of
  /// `organizationId`/`ownerUserId` XOR is ENFORCED — `chk_memory_owner_xor` in
  /// post-push.sql: `(organization_id IS NULL) <> (owner_user_id IS NULL)` — so
  /// exactly one is non-null (the URN backfill dispatches owner KIND off it;
  /// don't add a redundant ambiguity branch).
  ownerUserId           String? @map("owner_user_id")
  ownerUser             User?   @relation("MemoryTenantOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  // 008-agent-installation (2026-05-02), relaxed by 034-memory-class-access and
  // #653: App pivot. Required for class='app'; OPTIONAL for knowledge/group/
  // personal/private (set when app-scoped, NULL when free-standing); forbidden
  // for class='system'. Enforced by the chk_memory_class_app_id CHECK constraint.
  /// The App this memory belongs to. Required when `class` is `app`; optional
  /// for `knowledge`/`group`/`personal`/`private` (set when app-scoped, NULL
  /// when free-standing); NULL for `system`. Enforced by chk_memory_class_app_id
  /// (#653 allowed knowledge + group to attach to an App).
  appId                 String? @map("app_id")
  // 005-agent-subscription (2026-04-30), re-keyed onto class by 034: explicit
  // User owner for personal/private-class memories. NULL otherwise. Postgres
  // CHECK enforces: class IN ('personal','private') ⇔ userId IS NOT NULL.
  /// Owning user for personal/private-class memories. Bidirectional invariant
  /// (CHECK chk_personal_visibility_user): `class IN ('personal','private')`
  /// ⇔ `userId IS NOT NULL`.
  userId                String? @map("user_id")
  /// Agent pivot used by live access-control and memory classification.
  /// With a calling App, legacy personal/private rows with appId NULL require
  /// this Agent installed; agent-scoped AgentSubscription checks use this Agent too.
  /// Marks per-user/session/anonymous holdings for exclusion from shared App/team
  /// memory folds. Free-standing personal/private memories leave this and appId NULL.
  userMemoryOfAgentId   String? @map("user_memory_of_agent_id")
  /// #723 — the IDENTITY of an App's `shared` app-class memory: the Agent whose
  /// shared space this is, under `appId`. Set ONLY on that runtime memory (NULL
  /// on every other row, including the name-addressable `createMemoryInApp`
  /// app-class memories), so `@@unique([appId, sharedMemoryOfAgentId])` is the
  /// find-or-create key for `findOrCreateAppClassMemory` — Postgres treats NULLs
  /// as distinct, so unset rows are unconstrained. Before #723 that identity was
  /// the URN STRING (`<app-urn>:<agent-slug>:shared`), which forced the row to
  /// keep a compound v1 URN (node URNs inside it could not round-trip through
  /// `splitNodeUrn`, so portal links to them 404'd) and silently orphaned the
  /// memory when its App was renamed. Enforced by chk_memory_shared_agent_scope
  /// (set ⇒ `class='app'` AND `app_id IS NOT NULL`).
  sharedMemoryOfAgentId String? @map("shared_memory_of_agent_id")
  /// #2044 (S7) — the IDENTITY of an App's INSTALL MEMORY: the Agent this
  /// `class='system'` row customises for `appId` (cor:agt:040:06). Set ONLY
  /// there; NULL on every other row, including an Agent's own system memory
  /// (which is `app_id IS NULL` and is reached through `Agent.systemMemoryId`,
  /// a pointer an install memory never has). Identity is by COLUMNS, never by
  /// URN, so a renamed App or Agent cannot orphan it. One LIVE row per
  /// (app_id, install_of_agent_id): the partial unique index lives in
  /// prisma/post-push.sql (Prisma cannot model the WHERE). Enforced by
  /// chk_memory_class_app_id (system ⇒ both set or both NULL).
  installOfAgentId      String? @map("install_of_agent_id")
  /// R94 C (#2064): TRUE for an App's install memory, for its whole life. The
  /// link to the Agent above is NULLed when the Agent is erased with its
  /// owner's account (the memory stays with its App, a detached install), so
  /// the discriminator every gate branches on cannot be that link. Enforced by
  /// chk_memory_class_app_id: class='system' with an app_id ⇔ TRUE.
  isInstallMemory       Boolean @default(false) @map("is_install_memory")

  /// Globally unique identifier, e.g. "baragaun.com:secureid".
  /// Derived from `org.urn + ":" + slug`.
  urn                  String            @unique
  /// Human-friendly display name, e.g. "SecureID Service".
  name                 String
  /// One-line summary for marketplace listings and search results.
  shortDescription     String?           @map("short_description")
  /// Full description (markdown); shown when expanding a listing.
  description          String?
  /// Free-form structured metadata for this memory — a client-defined
  /// JSON bag with no server-side semantics. Written via the GraphQL
  /// createMemory / updateMemory mutations; surfaced read-only over MCP
  /// (hadron_list_memories renders it as a `data:` line). The MCP surface has
  /// no memory-mutation tool, so writes stay GraphQL-only. NULL when unset.
  data                 Json?
  /// #725 — opt-in per-memory PROPERTY SCHEMA (structured storage): the
  /// collections (object types) this memory declares and each one's typed
  /// fields. A dedicated column (NOT nested in `data`) so a schema'd memory is
  /// visible at a glance. Shape + well-formedness validated by
  /// src/lib/memorySchema.ts; authored via updateMemory (GraphQL/portal),
  /// read-only over MCP for discovery. NULL ⇒ no schema (unstructured). Node
  /// `properties`/`objectType` are validated against it in the enforcement
  /// phase (a later PR) — free-form until then.
  schema               Json?
  /// #1591 — legacy whole-corpus flag retained for compatibility. Draft rights
  /// now belong to each node and end at its first mint; false does not mean
  /// every node in this memory is minted. Minting still clears this flag.
  corpusDraft          Boolean           @default(false) @map("corpus_draft")
  /// #1591 — legacy record of the latest nonempty mint in this memory and its
  /// actor. Node mint records determine mint state; this stamp confers no
  /// memory-wide removal protection or draft rights.
  corpusMintedAt       DateTime?         @map("corpus_minted_at")
  corpusMintedBy       String?           @map("corpus_minted_by")
  /// Classification tags for search and filtering.
  tags                 String[]
  /// License identifier (e.g. "MIT", "CC-BY-4.0", "proprietary").
  license              String?
  /// Primary category (e.g. "Developer Tools").
  category0            String?           @map("category_0")
  /// Secondary category (e.g. "Backend").
  category1            String?           @map("category_1")
  /// Tertiary category (e.g. "Node.js").
  category2            String?           @map("category_2")
  /// Square icon/logo URL for listings.
  iconUrl              String?           @map("icon_url")
  /// Banner image URL for the detail page.
  heroUrl              String?           @map("hero_url")
  /// External homepage or documentation URL.
  homeUrl              String?           @map("home_url")
  /// Git clone URL; null = DB-only mode (no git backing).
  source               String?
  /// AES-256-GCM-encrypted access token for repos not covered by the
  /// org's GitHub App installation (e.g. personal repos, GitLab,
  /// Bitbucket). Plaintext never stored or displayed after initial entry.
  sourceTokenEncrypted String?           @map("source_token_encrypted")
  /// Expiry of the stored token; server warns via MemoryLogEntry
  /// before expiration.
  sourceTokenExpiresAt DateTime?         @map("source_token_expires_at")
  /// Branch to clone/pull from (default: repo default branch).
  readBranch           String?           @map("read_branch")
  /// #1566: false until one safe sync using the corrected branch commits.
  /// This is conservative for both existing and newly created memories.
  readBranchCorrected  Boolean           @default(false) @map("read_branch_corrected")
  /// Branch for mutations (default: "hadron-updates").
  writeBranch          String?           @map("write_branch")
  /// 035-visibility-enum-cleanup: nullable, no default. Set only for
  /// `knowledge` (PUBLIC/ORGANIZATION) and `group` (GROUP); NULL for
  /// system/app/personal/private (enforced by chk_memory_visibility_class).
  visibility           MemoryVisibility?
  /// Opt-in marketplace catalogue flag (cor:acl:080:04): whether this memory is
  /// advertised in the marketplace browse. DISTINCT from `visibility` — PUBLIC
  /// governs access (reachable by URN), this governs advertisement. "Unlisted
  /// but public" is valid; contributes to the owner org's discoverability
  /// (cor:acl:080:02).
  listedOnMarketplace  Boolean           @default(false) @map("listed_on_marketplace")
  /// Whether the memory's contents (including asset bytes) are
  /// encrypted at rest using AES-256-GCM under HADRON_ENCRYPTION_KEY.
  isEncrypted          Boolean           @default(false) @map("is_encrypted")
  // 005-agent-subscription (2026-04-30): four-way memory typology. Required
  // post-migration; backfilled by the migration's UPDATE statements.
  /// Per-class governance — see MemoryClass enum doc for the four
  /// classes and their addressing rules.
  class                MemoryClass
  /// When an anonymous (pre-account-creation) memory expires and is
  /// reaped by the janitor. NULL for non-anonymous memories.
  anonymousExpiresAt   DateTime?         @map("anonymous_expires_at")
  /// If true, any subscription must have a valid MemoryLicense.
  requiresLicense      Boolean           @default(false) @map("requires_license")
  /// Last successful git sync.
  lastSyncedAt         DateTime?         @map("last_synced_at")
  syncStatus           SyncStatus        @default(PENDING) @map("sync_status")
  /// Error message from the last failed sync.
  syncError            String?           @map("sync_error")
  /// Versioned last completed sync outcome; null after a clean sync (or before any sync).
  lastSyncReport       String?           @map("last_sync_report")
  /// Number of live unresolved PendingEdge records whose live source is in
  /// this memory (a derived projection, denormalized for dashboard display).
  pendingEdgeCount     Int               @default(0) @map("pending_edge_count")
  // 006-asset-upload-redesign (2026-05-01): per-memory upload acceptance
  // flag. Default true at the column level; system-class memories must
  // opt out explicitly at creation time. Migration backfilled existing
  // rows by class (system → false; app/knowledge/personal → true).
  /// Whether this memory accepts asset uploads. system-class memories
  /// typically opt out.
  acceptsUploads       Boolean           @default(true) @map("accepts_uploads")
  // ─── D-2026-08-25-004 / #1180: protected-loc declarations ───
  /// Locs in THIS memory whose subtree only a specific authoring operation may

  // ─── 033-rag-vector-retrieval: per-memory vector-index config ───
  /// Opt-in: when true, this memory's nodes are vector-indexed. DB default is
  /// `false`; the **class-derived default** is applied at createMemory — a
  /// `knowledge`-class, non-encrypted memory is created with `true`, all other
  /// classes and any encrypted memory stay `false` (FR-001). Flippable per memory.
  vectorIndexEnabled Boolean         @default(false) @map("vector_index_enabled")
  /// What the vector index is built from. Memory property, NOT a query
  /// parameter (FR-002). Only meaningful when vectorIndexEnabled.
  embeddingSource    EmbeddingSource @default(abstract) @map("embedding_source")
  /// Per-memory chunking dials (FR-003). NULL ⇒ platform default (512 / 64).
  /// Consulted only when embeddingSource includes chunks.
  chunkTokens        Int?            @map("chunk_tokens")
  chunkOverlap       Int?            @map("chunk_overlap")
  /// Force fixed-size chunking, bypassing structure-aware (FR-015).
  forceFixedSize     Boolean         @default(false) @map("force_fixed_size")
  /// #621 — cap on how many NodeRevision rows are kept per node in this
  /// memory. On each new revision the oldest overflow is pruned. Must be >= 1
  /// (chk_memory_max_rev_count_positive); default 10.
  maxRevCount        Int             @default(10) @map("max_rev_count")
  /// Spec 041 (D-2026-07-06-B) — passphrase-derivation material for a
  /// caller-held-key encrypted memory. Parameters, NOT secrets: salt
  /// (base64) + scrypt params. NULL when the memory was encrypted with a
  /// raw data key (no passphrase) or is not encrypted.
  kdfSalt            String?         @map("kdf_salt")
  kdfParams          Json?           @map("kdf_params")
  /// enc:v1 encryption of a fixed check string under the data key — lets
  /// every unlock verify the supplied key WITHOUT touching node rows
  /// (wrong passphrase = typed WRONG_KEY, never garbage plaintext). The
  /// server still never holds the key itself.
  keyVerifier        String?         @map("key_verifier")

  /// Timestamp the owner acknowledged the embedding-inversion disclosure for an
  /// ENCRYPTED memory (FR-026). NULL ⇒ not acknowledged. Gates encrypted-memory
  /// indexing via chk_memory_vector_encrypted_ack.
  vectorIndexEncryptedAckAt DateTime? @map("vector_index_encrypted_ack_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  createdBy                 String?   @map("created_by")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  updatedBy                 String?   @map("updated_by")
  deletedAt                 DateTime? @map("deleted_at")
  deletedBy                 String?   @map("deleted_by")

  organization             Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodes                    Node[]
  edges                    Edge[] // first-class edges, scoped via denormalized memoryId
  embeddings               NodeEmbedding[] // 033: per-memory vectors (denormalized memoryId)
  assets                   Asset[]
  subscriptions            MemorySubscription[]
  agentItems               AgentMemoryItem[]
  licenses                 MemoryLicense[]
  /// Online URN-shape migration gate (spec 021 FR-032, repurposed for the #697
  /// v1→v2 emission flip). Null = pre-normalization row; set = row normalized
  /// onto the flat v2 form (`<root>:<slug>`, single colon). Transient.
  /// TODO(spec-021-cleanup): drop once the FR-032 migration completes.
  urnNormalizedAt          DateTime?            @map("urn_normalized_at")
  /// Spec 021 sentinel for data-defect rows during the FR-032 migration.
  /// TODO(spec-021-cleanup): drop alongside urnNormalizedAt.
  urnMigrationFailedReason String?              @map("urn_migration_failed_reason")
  /// #697 stored alias map: the pre-v2 (v1) URN this row was migrated FROM.
  /// Null until the online migration flips `urn` to the flat v2 form; then a
  /// legacy input (wikilink, export, external link) resolves to this row by
  /// matching `legacyUrn`. Indexed, non-unique — resolution disambiguates a
  /// rare collision to the live row, else a typed error. Transient with the
  /// migration; TODO(#697-cleanup): drop once every reference is v2-native.
  legacyUrn                String?              @map("legacy_urn")

  logEntries          MemoryLogEntry[]
  userMemoryOfAgent   Agent?            @relation("UserMemoriesOfAgent", fields: [userMemoryOfAgentId], references: [id], onDelete: SetNull)
  // #723: SetNull mirrors userMemoryOfAgent — a hard-deleted Agent leaves the
  // shared memory's content intact (orphan retention, cor:dmo:050:03); the row
  // simply stops being the find-or-create target for that pairing. Restrict was
  // considered and rejected: `deleteAgent` is a SOFT delete, so the only hard
  // deletes are user-account deletion and the create-persona compensation, and
  // blocking those on a memory FK trades a rare orphan for a stuck account
  // deletion. A nulled row can in principle be re-adopted by a replacement Agent
  // that reuses the slug in the same App — but only while it still carries the
  // pre-#723 compound urn (a post-#723 row's flat `<app>-shared` never matches
  // the legacy key), and user-account deletion cascades the App's memories away
  // in the same pass, so the window is narrow and self-closing.
  sharedMemoryOfAgent Agent?            @relation("SharedMemoriesOfAgent", fields: [sharedMemoryOfAgentId], references: [id], onDelete: SetNull)
  // #2044 / R94 C: SetNull. Org Agents are soft-deleted, so this fires only for
  // user-account deletion: another App's install memory of the erased Agent is
  // KEPT and detached (never erased, never blocking the erasure). It stays an
  // install memory through `isInstallMemory`, not through this link.
  installOfAgent      Agent?            @relation("InstallMemoriesOfAgent", fields: [installOfAgentId], references: [id], onDelete: SetNull)
  user                User?             @relation("UserMemoriesOwned", fields: [userId], references: [id], onDelete: SetNull)
  // 008-agent-installation: hard App deletion cascades to its personal/app
  // memories (per data-model.md "Cascade behavior"). The CHECK constraint
  // prohibits app_id IS NULL for class IN ('app', 'personal'), so SET NULL
  // would leave the row in an invalid state on delete. AppMember removal
  // (orphan retention per FR-015) is independent — that's a row delete in
  // app_members, not in apps.
  app                 App?              @relation("AppMemories", fields: [appId], references: [id], onDelete: Cascade)
  sessions            Session[]         @relation("SessionMemory")
  mcpSessionStates    McpSessionState[]
  scopeMemberships    ScopeMemory[]
  channels            Channel[]
  /// #974 — the Workers whose casting-scoped working memory this is (at most
  /// one in practice; identity lives on `Worker.memoryId`, cor:dmo:050:11).
  workerOf            Worker[]          @relation("WorkerMemory")
  // 023-app-shape: per-Memory authorization primitives.
  // `shares`      — populated only when `class = 'personal'` (FR-018);
  //                 cross-user grants (asymmetric).
  // `memberships` — populated only when `class = 'group'` (FR-027);
  //                 symmetric team membership.
  shares              MemoryShare[]
  memberships         MemoryMember[]
  /// #1325 — this memory's rulebook, at most one row. ABSENT reads as the
  /// empty config: it is materialized on the first rule write, never at memory
  /// creation (there is no shared creation helper to hang that on —
  /// hadron-server findings:memory-creation-has-no-shared-helper).
  config              MemoryConfig?
  /// #2484 — Apps holding a prefix-scoped write grant on this memory for their userless runs.
  appWriteGrants      AppMemoryWriteGrant[]
  gitMirrorObligations GitMirrorObligation[]

  // #723: ONE shared app-class memory per (App, Agent) — the find-or-create key
  // that replaced the deterministic `…:shared` URN. Spans soft-deleted rows (the
  // provisioner RESTORES a tombstoned row rather than creating a second one),
  // and NULL `sharedMemoryOfAgentId` rows are unconstrained (Postgres NULLs are
  // distinct), so it binds only the runtime shared memories.
  @@unique([appId, sharedMemoryOfAgentId])
  @@index([organizationId])
  @@index([userMemoryOfAgentId])
  @@index([anonymousExpiresAt])
  @@index([userId])
  @@index([appId])
  @@index([installOfAgentId])
  @@index([ownerUserId])
  @@index([legacyUrn])
  @@map("memories")
}

/// A user-uploaded file (document, image) bound to a Memory. Bytes
/// live in object storage (Cloudflare R2 in v1; MinIO for local dev);
/// this row carries metadata, the storage pointer, and virus-scan
/// state. Spec: `hadron-concept/spec-kits/specs/004-asset-upload/spec.md` (sister repo).
///
/// **Why a separate table (not a `nodeType`)**: normalization (asset
/// and node schemas diverge), scale (raw-material assets shouldn't
/// bloat the knowledge-node table), and FK-shape (containment is
/// foreign-key-shaped, not graph-shaped). See
/// `hadron-concept/design-discussions/hadron-platform/2026-04-28-asset-upload-design/010-summary.md`
/// (sister repo) §"Why this summary supersedes 007-summary.md".
///
/// **URN form** (computed, NOT stored): grammar v2
/// `hrn:asset:<root>:<mem...>:assets:<asset.id>`, emitted by `emitAssetUrnV2`
/// from the holding memory's stored bare urn. The GraphQL `Asset.urn` docstring
/// carries the full contract, including the two degraded shapes a parser has to
/// tolerate and why `<mem...>` is not always a single atom.
///
/// **Cross-references from nodes** are reserved for a future spec —
/// `Node.attachedAssetId?` (one-asset case) or a `node_assets` join
/// (many-to-many). Not in v1.
model Asset {
  id            String          @id @default(cuid())
  // 006-asset-upload-redesign (2026-05-01): nullable to support staging.
  // An asset with memoryId IS NULL is "staged" — uploaded but not yet
  // attached to a memory. Janitor sweeps staged assets past the 24h TTL.
  /// The Memory this asset belongs to; NULL while the asset is staged
  /// (uploaded but not yet attached). Janitor sweeps staged assets
  /// past the 24h TTL.
  memoryId      String?         @map("memory_id")
  /// Original filename as supplied by the user. Never appears in
  /// `storageKey`.
  filename      String
  /// RFC 6838 type/subtype.
  mimeType      String          @map("mime_type")
  /// Verified at complete-upload time against `HeadObject.contentLength`.
  sizeBytes     Int             @map("size_bytes")
  // Object-store key. Encrypted at rest (AES-256-GCM under
  // HADRON_ENCRYPTION_KEY) when the memory is encrypted; plaintext
  // otherwise. See src/lib/asset/encryption.ts.
  /// Object-store key shape: `{orgUrn}/{memoryUrn-segment}/{assetId}.{ext}`.
  /// Encrypted at rest when the memory is encrypted; plaintext otherwise.
  storageKey    String          @unique @map("storage_key")
  /// Virus scan state. Downloads gated on CLEAN.
  scanStatus    AssetScanStatus @default(PENDING) @map("scan_status")
  /// Engine signature name recorded when the scan verdict was BLOCKED
  /// (e.g. "Eicar-Signature"). A BLOCKED row is kept as an audit
  /// tombstone; its object bytes are deleted (#896).
  scanSignature String?         @map("scan_signature")
  /// Number of scan attempts so far (inline at complete-upload plus
  /// sweep retries). Drives the retry sweep's exponential backoff.
  scanAttempts  Int             @default(0) @map("scan_attempts")
  /// When the last scan attempt ran (whether or not it produced a
  /// verdict). NULL = never attempted. Informational; the sweep
  /// selects on `scan_due_at`, not this.
  scannedAt     DateTime?       @map("scanned_at")
  /// When the next background scan action is due (the #882
  /// embedding-queue pattern: a future-dated stamp IS the queue).
  /// PENDING rows: next scan retry. BLOCKED rows: next purge retry
  /// for object bytes that survived a failed delete. NULL = nothing
  /// pending (CLEAN, or BLOCKED with bytes confirmed gone). Every
  /// sweep touch pushes it forward, so no row can monopolize a batch.
  scanDueAt     DateTime?       @map("scan_due_at")
  /// When the bytes-missing row sweep (#1140) last examined this row.
  /// NULL = never. It is the sweep's persisted cursor (least-recently
  /// examined first, NULLs first), so a restart resumes instead of
  /// re-walking the same head of the table. A deferral (encrypted memory
  /// with no cached session key) stamps it too, so such a row rotates
  /// behind other work; a failed store lookup does NOT.
  bytesCheckedAt DateTime?      @map("bytes_checked_at")
  /// Optional; agent- or user-provided.
  description   String?
  uploadedAt    DateTime        @default(now()) @map("uploaded_at")
  /// fk to User.id — who uploaded. NULL when the asset was created
  /// server-side by an app run with no on-behalf-of user
  /// (hadron_store_file); the run id is recorded on the asset's
  /// reference node and in the audit log.
  uploadedBy    String?         @map("uploaded_by")
  /// Soft-delete marker. Janitor sweeps R2 object + hard-deletes
  /// after 24h.
  deletedAt     DateTime?       @map("deleted_at")
  /// #1667, cor:dmo:060:15 — the per-asset public-link opt-in. STORED POLICY, not
  /// proof of publication: the anonymous hotlink also needs the deployment gate
  /// and the existing eligibility checks. Every asset starts OFF.
  publicLinkEnabled Boolean     @default(false) @map("public_link_enabled")

  memory Memory? @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId, scanStatus, uploadedAt(sort: Desc)])
  // #896 — the scan sweep's selector (due rows, oldest due first).
  @@index([scanDueAt])
  // #1140 — the bytes-missing row sweep's cursor (least-recently examined first).
  @@index([bytesCheckedAt])
  // 006-asset-upload-redesign: two partial indexes for staged assets
  // (WHERE memory_id IS NULL) live in the migration SQL only — Prisma
  // schema syntax can't express WHERE clauses on @@index. See
  // prisma/migrations/20260501000000_memory_uploads_and_staged_assets/migration.sql:
  //   - assets_uploaded_by_staged_idx (per-user staged listing)
  //   - assets_staged_uploaded_at_idx (janitor TTL sweep)
  @@map("assets")
}

/// A single node in a Memory. `loc` is the colon-delimited path
/// within the memory (e.g. `auth:tokens`), memory-relative. The full
/// URN is computed `memory.urn + ":" + loc` (e.g.
/// `baragaun.com:secureid:auth:tokens`) and **not stored**. `id` is
/// optional in YAML; the server assigns it on import if missing.
///
/// **Node types** — the authoritative canonical list for ordinary nodes:
///   - `abstract`        — agent-generated summaries (chat summaries,
///                         topic abstracts); searched first by retrieval flows.
///   - `chat`            — chat session and message nodes.
///   - `data`            — the structured payload is the artifact, with no
///                         human-authored content body.
///   - `info` (default)  — reference content: articles, guides, extracted facts;
///                         the default for user-authored knowledge.
///   - `prompt`          — system prompt content for an LLM call.
///   - `record`          — append-mostly stored data: user profiles, session
///                         logs, append-only event logs.
///   - `reference`       — external sources or cross-memory pointers: papers,
///                         URLs, legislation, asset references.
///   - `system`          — agent-internal configuration: conversation designs,
///                         stages, topics; typically in an Agent's system
///                         memory and hidden from end-user search.
/// `comment` is platform-reserved for governed feedback (see `commentMeta`);
/// the canonical ordinary-node list is not a closed set of stored values.
/// (The earlier `asset` node-type was promoted to its own Asset table
/// in spec 004-asset-upload.)
///
/// **Column type is free-form `String` (not enum)** to preserve extensibility
/// for third-party agents and apps: no Prisma enum or DB CHECK constraint.
/// Hadron core does not special-case non-canonical third-party values.
///
/// **Chat-root `data.scope`** (spec 017, 2026-05-12) — chat-root nodes
/// (loc `chats:<id>`, depth 2, nodeType `record`) carry a `scope` field
/// in `data` recording the chat's visibility tier (`private` | `shared`).
/// Set at chat creation and immutable thereafter (FR-002).
/// Denormalized from `Memory.class` for chat-list query performance;
/// MUST stay consistent with the holding memory's class per the
/// invariant validator in `src/api/graphql/schema/chat-scope.ts`.
/// #1326 — how the server attributed the current content. NULL on legacy or
/// as-yet-unstamped writes; callers cannot choose this through NodeInput.
enum NodeAuthorshipKind {
  TASK
  HUMAN
}

/// #1326 — a content-validation result is advisory, never a write gate.
enum NodeContentValidationOutcome {
  PASS
  FAIL
  ERROR
}

model Node {
  /// UUIDv7 from `node.yaml` when supplied by the importer (stable across
  /// moves); falls back to `cuid()` for inserts that omit `id`.
  id                  String              @id @default(cuid())
  memoryId            String              @map("memory_id")
  /// See the node-types list in the model doc. Default `info`.
  nodeType            String              @default("info") @map("node_type")
  /// #725 — collection discriminator (the MongoDB-collection equivalent): which
  /// domain object this node is an instance of, e.g. "competitor" / "insight".
  /// Orthogonal to `nodeType` (the platform-kind axis). NULL for an ordinary
  /// node. When set on a schema-governed memory it must name a declared object
  /// type (enforced at write time — a later phase); free-form until then.
  objectType          String?             @map("object_type")
  /// Human-friendly display name of this node.
  name                String
  /// Alternative name.
  alias               String?
  /// Colon-delimited path within the memory (e.g. "auth:tokens").
  loc                 String
  isLink              Boolean             @default(false) @map("is_link")
  /// #1450 — a RESERVED spec citation with no spec written yet (a placeholder
  /// in a draft corpus; see src/lib/specCorpus.ts). Set only by the server's
  /// `reserveSpecCitation`, never by a client write, and never inferred from an
  /// empty body. Writing real content clears it; the node keeps its citation.
  /// Minting refuses while any remain, so a minted corpus has none.
  isPlaceholder       Boolean             @default(false) @map("is_placeholder")
  description         String?
  /// Paragraph-length summary of this node. Cap is 2000 characters,
  /// enforced at the API boundary (not as a DB CHECK — caps are
  /// validation, not invariants). Surfacing rules across MCP tools
  /// (find/read/list/validate), the `Source: abstract-fallback` marker
  /// on `hadron_get_node` content-scope fallback, and the RAG-substrate
  /// motivation are documented in spec 031 (FR-005 + edge cases). That
  /// is the load-bearing reference; this comment is the cold-read
  /// pointer for someone scanning the schema.
  abstract            String?
  /// The topic content (topic.md full text).
  content             String?
  /// SHA256(yaml+md)[0:8] for change detection. Set by external
  /// producers (YAML frontmatter via importer, Git sync). UNCHANGED by
  /// spec 032 — that spec adds `abstractOriginHash` below as a separate
  /// column with its own domain (SHA256(content)[0:8]); the two are
  /// never compared against each other.
  contentHash         String?             @map("content_hash")
  /// Spec 032 — fingerprint of `content` value at the time `abstract`
  /// was authored. SHA-256 of plaintext content truncated to 8 hex
  /// chars (same width as `contentHash`, different domain). At read
  /// time, compared against `computeContentHash(node.content)` to
  /// detect staleness: the abstract may not reflect current content
  /// when the two differ, OR when this is NULL on a node that has
  /// both an abstract and content (#1128 — an abstract written before
  /// the body existed was never fingerprinted, so it has never been
  /// checked against it; that reads as unverified, not as verified).
  /// NULL is a clean state only when the node has no abstract, or no
  /// content for the abstract to describe. Surfaced by
  /// `hadron_get_node`'s `Source: abstract-stale` marker and
  /// `hadron_validate`'s `[stale-abstract]` warning. System-managed:
  /// never settable via GraphQL `NodeInput`.
  ///
  /// Until #1232 this said staleness required the value to be
  /// NON-NULL — the pre-#1128 rule, which #1128 deliberately removed
  /// along with the validator's own `!= null` guard. The published
  /// Data Model reference is generated from this comment, so it
  /// contradicted the GraphQL reference for the whole gap.
  abstractOriginHash  String?             @map("abstract_origin_hash")
  // ─── 033-rag-vector-retrieval: durable embedding-queue markers ───
  /// Set when this node needs (re-)embedding; cleared on success. The single
  /// work signal the embedding worker drains (FR-006/FR-007). Operational
  /// state only — intentionally NOT versioned on NodeRevision.
  embeddingPendingAt DateTime? @map("embedding_pending_at")
  /// internal#4: opaque identity of one durable obligation; time only schedules it.
  /// Operational, never copied into revisions or approval/authorship state.
  embeddingWorkToken String?   @db.Uuid @map("embedding_work_token")
  /// Set when an embed attempt failed (record, not a work signal). Transient
  /// failures keep pending set for retry; permanent failures clear pending (FR-009).
  embeddingFailedAt   DateTime?           @map("embedding_failed_at")
  /// Attempt counter for backoff / give-up. Non-null; reset to 0 on success/revoke.
  embeddingAttempts   Int                 @default(0) @map("embedding_attempts")
  /// Passage chunks omitted by the per-node cap (#887); NULL when not truncated.
  embeddingTruncatedChunks Int? @map("embedding_truncated_chunks")
  /// Last embed error (diagnosability; surfaced by hadron_validate).
  embeddingError      String?             @map("embedding_error")
  /// Number of input tokens.
  tokens              Int?
  /// Classification tags.
  tags                String[]
  /// Typed key-value structured data; queryable via the API.
  properties          Json?
  /// Structured JSON on the node; used for template-variable
  /// resolution, user profiles, extracted facts, reference metadata.
  /// Returned by `hadron_get_node`; written by `hadron_update_node`
  /// (replaces the bag) or `hadron_update_node_data` (shallow merge).
  data                Json?
  /// Sort order among sibling nodes (lower values come first); used
  /// by `hadron_get_next_node` and portal drag-and-drop reordering.
  seq                 Int?
  /// #1430 paged attention: the owning Channel for chat-message transcript
  /// rows — stamped in the append transaction, providing a Channel-local
  /// seq-first access path (see the partial index below).
  messageChannelId    String?             @map("message_channel_id")
  /// GitHub repo slug (e.g. "micromentor/mmdata").
  ownerRepo           String?             @map("owner_repo")
  /// If true, this node can be executed as a task.
  isRunnable          Boolean?            @map("is_runnable")
  /// #1201 — what this node IS TO ITS AUTHOR, as an open string. Set it to
  /// anything; the platform reads a small CLOSED subset and ignores the rest.
  ///
  /// THREE KIND-ISH FIELDS, and the distinction is what readers get wrong:
  ///   - `nodeType`   — the PLATFORM-kind axis (info/task/prompt/…), load-bearing
  ///                    for retrieval and rendering. NOT this field.
  ///   - `objectType` — the COLLECTION discriminator (#725): which domain object
  ///                    this is an instance of, schema-validated. NOT this field.
  ///   - `role`       — what the node is FOR. It does not affect default
  ///                    retrieval/ranking, but callers may filter by role family.
  ///
  /// This is the axis the law corpus already named and the schema never had:
  /// `cor:urn:010:01` lists node TYPES and node ROLES as separate categories,
  /// and the roles (chat, chat-message, config, …) live in `nodeType` today.
  /// Migrating those off `nodeType` is deliberately NOT part of #1201 — live
  /// consumers include `isChecklistItemListing`, the chat surfaces and
  /// `preflight_add --type`.
  ///
  /// GOVERNED values (`src/lib/governedRole.ts`) route a write to that kind's
  /// own door; every other value is inert. Open so an agent builder may use it
  /// freely, closed where it gates so the gate is never caller-defined.
  role                String?
  /// LLM model that created or last modified this node (e.g.
  /// "claude-opus-4-6", "gpt-4o").
  llmModel            String?             @map("llm_model")
  /// AI agent tool that created or last modified this node (e.g.
  /// "claude-code", "cursor", "hadron-portal").
  aiAgent             String?             @map("ai_agent")
  /// #1326 — server-owned attribution for this content state. A task stamp
  /// records the stable task Node.id and its revision when the content was
  /// authored; a HUMAN stamp records the authenticated person, never a task.
  /// NULL kind means unknown/legacy, not a claim of human authorship. No FK:
  /// deleting or moving a task/user must not rewrite historical attribution.
  authorshipKind      NodeAuthorshipKind? @map("authorship_kind")
  authoredByTask      String?             @map("authored_by_task")
  authoredByRevision  Int?                @map("authored_by_revision")
  authoredByHuman     String?             @map("authored_by_human")
  authoredAt          DateTime?           @map("authored_at")
  /// #696/#1323: the live node's current revision. Creation is revision 1.
  /// A revisioned edit snapshots the pre-edit state at this number, then
  /// atomically advances the live row to the next number.
  revSeq              Int                 @default(1) @map("rev_seq")
  /// #1611 (cor:dmo:120:04) — the revision at which the approval-hashed fields
  /// (title, abstract, content under approval-hash v1) last changed through a
  /// SANCTIONED writer; maintained by the `nodes_initialize_revision_content_hash`
  /// trigger on the same 'refresh' marker as `revisionContentHash`. An approval
  /// recorded at `approvedRevNo` is still valid iff `contentRevSeq <= approvedRevNo`:
  /// metadata-only revisions advance `revSeq` but not this. A write outside the
  /// revision system never moves it, so such a change stays TAMPERED.
  contentRevSeq       Int                 @default(1) @map("content_rev_seq")
  /// #1323: host-independent MD5 of the complete at-rest revisioned state.
  /// Internal safeguard only (never an artifact fingerprint): an exposed read
  /// reconciles a mismatch by taking a server-authored revision. Included
  /// partials/template data and operational fields are deliberately outside it.
  revisionContentHash String?             @map("revision_content_hash")
  /// #1591 — the node's LATEST approval, kept here rather than only on a
  /// NodeRevision row because the live revision has no row (rows are pre-edit
  /// snapshots) and rows are prunable and deletable. The current revision is
  /// approved iff `approvedRevNo >= contentRevSeq` (#1611); a lower number
  /// means its content changed since. `approvedBy` is a User.id when one is known, with no FK so a
  /// user deletion cannot rewrite who approved; otherwise `approvedByInfo`
  /// holds the principal (the NodeRevision.editedByInfo convention).
  /// `approvalHash` is the full SHA-256 of approval hash v1
  /// (src/lib/approvalHash.ts) at approval time. All five are set together or
  /// not at all (chk_node_approval_complete), except that `approvalHash` alone is
  /// cleared when the node enters an encrypted memory (#1838): who, when and which
  /// revision stay, and a hashless approval covers nothing.
  approvedRevNo       Int?                @map("approved_rev_no")
  approvedBy          String?             @map("approved_by")
  approvedByInfo      String?             @map("approved_by_info")
  approvedAt          DateTime?           @map("approved_at")
  approvalHash        String?             @map("approval_hash")
  /// #1591 — per-node minting. A node is minted iff `mintedAt` is set; a new
  /// node starts unminted, with draft rights (renumber, move without an alias,
  /// bulk replace). Minting stamps every unminted live node of a memory at once
  /// (`mintMemoryNodes`), after its checks, including an approved current
  /// revision. `mintedRevNo` / `mintedHash` record that revision and its
  /// approval hash; both are null for nodes backfilled as minted by the #1591
  /// migration, whose minted revision is unknown. `mintedBy` is a User.id (no
  /// FK, like `approvedBy`), else `mintedByInfo` holds the principal
  /// ("backfill" for the migration). Minting protects nothing by itself
  /// (Holger, 2026-10-01: no minted-spec permanence for now).
  /// chk_node_mint_complete.
  mintedAt            DateTime?           @map("minted_at")
  mintedBy            String?             @map("minted_by")
  mintedByInfo        String?             @map("minted_by_info")
  mintedRevNo         Int?                @map("minted_rev_no")
  mintedHash          String?             @map("minted_hash")
  /// #1632 / cor:dmo:130:04 — when the node's title, abstract or content last
  /// changed, from the DB clock. Set only by the signing trigger
  /// (prisma/signing-invariants.sql), never by application code, and never
  /// decreases. A signature verified at or before this time reads EARLIER, so
  /// restoring earlier text never revives it (#9824). Null = unchanged since
  /// creation. A timestamp rather than a revision number, so pruning, history
  /// clears and revSeq reconciliation cannot move it.
  contentChangedAt    DateTime?           @map("content_changed_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  createdBy           String?             @map("created_by")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  updatedBy           String?             @map("updated_by")
  deletedAt           DateTime?           @map("deleted_at")
  deletedBy           String?             @map("deleted_by")
  /// #1610 — the Worker / Agent behind the write, beside the user in
  /// createdBy / updatedBy. Server-derived from the request's validated
  /// session binding or App run (src/lib/requestActor.ts), never
  /// client-supplied; stamped centrally on creates and authored-field
  /// updates (src/integrations/db/client.ts). The updatedBy* pair describes
  /// the LAST authored edit, so an edit with no agent behind it clears it.
  /// No FK, like the audit stamps (cor:dmo:010:01).
  createdByWorkerId   String?             @map("created_by_worker_id")
  createdByAgentId    String?             @map("created_by_agent_id")
  updatedByWorkerId   String?             @map("updated_by_worker_id")
  updatedByAgentId    String?             @map("updated_by_agent_id")
  /// #2176 — the User behind the last authored edit, beside the Worker / Agent
  /// above and stamped with them in one place (src/integrations/db/client.ts).
  /// It is exactly what NodeRevision.editedBy records for the same edit
  /// (`editorFromAuth`): the request's validated `auth.userId`, from the
  /// RequestActor holder, never a clientId or a credential holder. An authored
  /// edit with no user behind it clears it. Null = unknown (nodes edited before
  /// #2176 are not backfilled). No FK, like the audit stamps (cor:dmo:010:01).
  updatedByUserId     String?             @map("updated_by_user_id")

  memory                   Memory                        @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  includeReferences        IncludeReference[]
  includeSourceCoverage    IncludeSourceCoverage?
  outgoingEdges            Edge[]                        @relation("SourceNode")
  incomingEdges            Edge[]                        @relation("TargetNode")
  pendingEdges             PendingEdge[]
  usageEvents              UsageEvent[]
  revisions                NodeRevision[]
  edgeRemovals             NodeEdgeRemoval[]
  /// #2046 (S9): the immutable provenance of each compiled revision of this node.
  compiledPromptRevisions  CompiledPromptRevision[]
  /// #1606 — present iff `nodeType = 'comment'` (deferred DB trigger).
  commentMeta              CommentMeta?                  @relation("CommentMetaNode")
  /// #1606 — the comments (top-level and replies) whose target is this node.
  commentsOn               CommentMeta[]                 @relation("CommentMetaTarget")
  contentValidationReports NodeContentValidationReport[]
  /// Spec 049 Phase 4: the Channel whose chat root this node is, if any.
  channel                  Channel?                      @relation("ChannelRoot")
  embeddings               NodeEmbedding[] // 033: 1 abstract row + N chunk rows; Cascade delete

  signingRequests                SigningRequest[]
  signatures                     NodeSignature[]
  /// #1892 — the Agents whose tasks / processes index this node is.
  tasksIndexOf                   Agent[]                    @relation("AgentTasksIndex")
  processesIndexOf               Agent[]                    @relation("AgentProcessesIndex")
  /// #1325 — rules and template rules that reference this node as their
  /// author task, validation task or description node (node-id FKs, SET NULL).
  authorTaskOfRules              NodeRoleRule[]             @relation("NodeRoleRuleAuthorTask")
  validationTaskOfRules          NodeRoleRule[]             @relation("NodeRoleRuleValidationTask")
  descriptionNodeOfRules         NodeRoleRule[]             @relation("NodeRoleRuleDescriptionNode")
  authorTaskOfTemplateRules      MemoryConfigTemplateRule[] @relation("TemplateRuleAuthorTask")
  validationTaskOfTemplateRules  MemoryConfigTemplateRule[] @relation("TemplateRuleValidationTask")
  descriptionNodeOfTemplateRules MemoryConfigTemplateRule[] @relation("TemplateRuleDescriptionNode")

  @@unique([loc, memoryId])
  @@index([loc])
  @@index([memoryId])
  // Graph-view scale path (#466): memoryNodes runs
  // `WHERE memory_id = ? ORDER BY loc LIMIT/OFFSET`. This composite lets
  // Postgres seek to the memory's rows AND return them loc-ordered without a
  // separate sort or a full loc-index scan across other memories.
  @@index([memoryId, loc])
  // #725 — "list all nodes of collection X in this memory" (the objectType
  // facet). objectType is NULL for most nodes; the composite seeks a memory's
  // typed rows directly.
  @@index([memoryId, objectType])
  @@map("nodes")
}

/// 033-rag-vector-retrieval: what a memory's vector index is built from
/// (per-memory property, not a query parameter — FR-002).
enum EmbeddingSource {
  abstract // default — embed Node.abstract
  contentChunks @map("content_chunks") // embed content chunks
  both // embed both
}

/// 033-rag-vector-retrieval: kind of a stored vector.
enum EmbeddingKind {
  abstract // one row per node — vector of Node.abstract
  chunk // N rows per node — vector of one content chunk
}

/// 033-rag-vector-retrieval: a stored embedding vector for a node's abstract
/// or one of its content chunks. Vectors are computed on plaintext at write
/// time (FR-027) and stored plaintext (pgvector). The `embedding` column is
/// `Unsupported("vector(768)")` — Prisma has no native vector type, so it is
/// NEVER read/written through the generated client; all access is raw SQL
/// (`$queryRaw`/`$executeRaw`). The HNSW index + abstract partial-unique index
/// live in the migration + post-push.sql (not expressible in Prisma schema).
model NodeEmbedding {
  id         String                      @id @default(cuid())
  nodeId     String                      @map("node_id")
  /// Denormalized for fast per-memory similarity filtering (search filters by
  /// memory before ORDER BY distance).
  memoryId   String                      @map("memory_id")
  kind       EmbeddingKind
  /// Embedding provider — "local" | "openai" | "voyage" … v1 is always "local".
  provider   String
  /// Stored model id (FR-014) — e.g. "nomic-embed-text-v1.5". Forward-compat
  /// for a deliberate re-embed when the platform model changes.
  model      String
  /// Vector dimension (sanity / forward-compat guard).
  dim        Int
  // ── chunk-only locators (NULL for kind = abstract); FR-016 ──
  chunkIndex Int?                        @map("chunk_index")
  charStart  Int?                        @map("char_start")
  charEnd    Int?                        @map("char_end")
  chunkText  String?                     @map("chunk_text")
  // ── the vector — pgvector; Prisma has no native type ──
  // Declared OPTIONAL (and nullable in the DB) on purpose: a REQUIRED Unsupported
  // field drops the model from Prisma's client create/upsert and breaks the
  // $allModels extension in src/integrations/db/client.ts. Keeping schema and DB
  // both nullable means migrations and schema.prisma agree (the migration-smoke
  // test). Rows are only ever inserted via raw SQL, which always supplies the
  // vector, so a NULL embedding never occurs in practice.
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now()) @map("created_at")

  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([nodeId, kind, chunkIndex]) // dedupes CHUNK rows; abstract uniqueness via partial index (post-push.sql)
  @@index([nodeId])
  @@index([memoryId])
  @@map("node_embeddings")
}

/// Directed edge between two Nodes. The optional `name` describes the
/// relationship — e.g. "imports", "depends_on", "related-to", "cites",
/// "abstract-of". An edge whose target is not yet synced lives in
/// PendingEdge until the target arrives.
/// A directed Node→Node relation, upgraded to a first-class, addressable
/// entity (it has its own URN `hrn:edge:<root>:<memory>:<loc>`). Edges
/// drive task execution/automation and the chatbot/conversation platform,
/// not just describe graph relationships.
model Edge {
  id                 String            @id @default(cuid())
  /// Denormalized from the SOURCE node's memory so `loc` can be made
  /// unique within a memory (a unique index can't span the source-node
  /// table). For cross-memory edges this is the source's memory.
  memoryId           String            @map("memory_id")
  sourceId           String            @map("source_id")
  targetId           String            @map("target_id")
  /// Colon-delimited path within the memory — the edge's identity and
  /// the suffix of its URN (`hrn:edge:<root>:<memory>:<loc>`). Required;
  /// derived from the endpoints + name when not authored (see
  /// `src/lib/edgeLoc.ts`). Mirrors `Node.loc`.
  loc                String
  /// Free-form relationship name (e.g. imports, depends_on, abstract-of).
  /// Optional since spec-037 — `loc` is now the identity. (Was `label`.)
  name               String?
  /// Human-readable description of the edge (parity with `Node.description`).
  description        String?
  /// If true, this edge can be executed/run (task automation, conversation
  /// transitions). Mirrors `Node.isRunnable`.
  isRunnable         Boolean?          @map("is_runnable")
  // Edge-condition spec: JSONLogic gating expression. Null = always fires.
  // Validated server-side at save and evaluate time. See
  // src/lib/edge-conditions/.
  /// JSONLogic gating expression evaluated by the shared
  /// edge-condition evaluator at edge-resolution time. NULL means the
  /// edge always fires. Validated against the v1 operator subset and
  /// the FOUR variable scopes (`memory.*`, `chat.*`, `agent.*`,
  /// `message.data.*` — `VALID_SCOPE_PREFIXES`; anything else is
  /// UNKNOWN_SCOPE). The time builtins `now()` and `today()` are a
  /// SEPARATE constant, not a fifth scope: whole references rather than
  /// prefixes, pre-resolved by the evaluator from the request clock.
  /// Said "five variable scopes" here until #1246, in the same sentence
  /// as the GraphQL SDL and generated into the public Data Model
  /// reference. Spec:
  /// `hadron-concept/spec-kits/specs/001-edge-condition-spec/spec.md`
  /// (sister repo). User docs:
  /// https://docs.hadronmemory.com/reference/edge-conditions/.
  condition          Json?
  // Stable ordering hook (lower = earlier). Future agent-exceptions
  // feature uses this so handler edges can sit at the top of the
  // resolution order without re-architecting.
  /// Resolution-order hook for edges sharing a source node; lower
  /// fires first, ties broken by insertion order. Reserved space for
  /// the future agent-exceptions feature to slot handler edges at the
  /// top.
  priority           Int               @default(0)
  /// Free-form structured payload on the edge (e.g. transition
  /// metadata for conversation-design edges).
  data               Json?
  createdAt          DateTime          @default(now()) @map("created_at")
  createdBy          String?           @map("created_by")
  updatedAt          DateTime?         @updatedAt @map("updated_at")
  updatedBy          String?           @map("updated_by")
  deletedAt          DateTime?         @map("deleted_at")
  deletedBy          String?           @map("deleted_by")
  /// #1606 (`cor:dmo:110:01`) — set only by the comment path: the edge is a
  /// comment's anchor (comment → target) or reply (reply → thread root).
  /// NULL for every ordinary edge. A governed edge is immutable (DB trigger
  /// `edges_governed_immutable`) and no generic edge write may create, alter
  /// or delete one (`cor:dmo:110:04`).
  governedKind       EdgeGovernedKind? @map("governed_kind")
  /// The target revision a top-level comment was written against. Set iff
  /// `governedKind = COMMENT_ANCHOR` (CHECK `chk_edges_governed_anchor`).
  anchorRevNo        Int?              @map("anchor_rev_no")
  /// `computeApprovalHash` of the target's title/abstract/content AT
  /// `anchorRevNo` (64 lowercase hex), whether or not that revision was ever
  /// approved, so the anchored text stays checkable after the revision
  /// snapshot is pruned (`cor:dmo:110:01`).
  anchorApprovalHash String?           @map("anchor_approval_hash")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  source Node   @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target Node   @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([loc, memoryId])
  @@index([memoryId])
  @@index([targetId])
  @@index([sourceId])
  // Graph-view scale path (#466): memoryEdges runs
  // `WHERE memory_id = ? ORDER BY loc LIMIT/OFFSET` (plus endpoint-liveness
  // joins). Same memory-scoped, loc-ordered seek as nodes_memory_id_loc_idx.
  @@index([memoryId, loc])
  @@map("edges")
}

/// #1606 — the reserved, governed edge kinds (`cor:dmo:110:01`).
enum EdgeGovernedKind {
  COMMENT_ANCHOR
  COMMENT_REPLY
  /// Derived from an include tag in the source node's content (#2040); owned by the content writer, never by a client.
  INCLUDE
}

/// #1606 — a comment thread's state (`cor:dmo:110:05`); top-level only.
enum CommentThreadState {
  OPEN
  RESOLVED
}

/// #1606 — the comment-specific state of a `nodeType = 'comment'` node, 1:1.
/// The body is the node's `content`; the quote and moderation reasons live in
/// the node's `data`, so an encrypted memory encrypts them with the body. The
/// columns here are what a constraint or an index must see in plaintext.
///
/// Invariants (prisma/post-push.sql + migration `20261005200000_comment_nodes`):
/// meta ⇔ comment type; comment, target and thread root share one memory of a
/// commentable class; a target is never a comment; `targetNodeId`,
/// `threadRootId` and `authorKey` are immutable and equal the governed edges'
/// endpoints; at most one open, live top-level thread per (target, author)
/// (`comment_meta_one_open_thread`, a partial unique index Prisma can't model).
model CommentMeta {
  nodeId             String              @id @map("node_id")
  /// The commented node. Immutable. `ON DELETE CASCADE` only so a whole-memory
  /// delete never depends on cascade order: hard-deleting a commented target
  /// on its own is still refused, by the governed-edge trigger (its anchor
  /// edge cannot go while the comment exists) and, at commit, by the
  /// comment-without-meta check.
  targetNodeId       String              @map("target_node_id")
  /// NULL for a top-level comment; else the thread's top-level comment.
  threadRootId       String?             @map("thread_root_id")
  /// OPEN | RESOLVED for a top-level comment; NULL for a reply (CHECK).
  threadState        CommentThreadState? @map("thread_state")
  /// The author (`cor:dmo:110:03`): `w:<workerId>`, `ua:<userId>:<agentId>`,
  /// `u:<userId>` or `app:<appId>`. Immutable.
  authorKey          String              @map("author_key")
  /// #1721 — set when deleteComment leaves a stub (a top-level comment with
  /// live replies; its text is blanked). A comment deleted without replies is
  /// soft-deleted instead, and these record who deleted it.
  retractedAt        DateTime?           @map("retracted_at")
  /// Actor key (the `authorKey` grammar) of whoever deleted the comment.
  retractedBy        String?             @map("retracted_by")
  resolvedAt         DateTime?           @map("resolved_at")
  resolvedBy         String?             @map("resolved_by")
  /// Mirrors the comment node's soft delete (a thread delete, or the target's
  /// soft delete), so the one-open-thread index can exclude it.
  threadDeletedAt    DateTime?           @map("thread_deleted_at")
  threadDeletedBy    String?             @map("thread_deleted_by")
  /// `ADMIN` (deleteCommentThread), `AUTHOR` or `MANAGER` (#1721 deleteComment,
  /// by its author or by a memory manager), or `TARGET` (the target was
  /// soft-deleted; restoring the target restores exactly these).
  threadDeletedCause String?             @map("thread_deleted_cause")
  createdAt          DateTime            @default(now()) @map("created_at")

  node   Node @relation("CommentMetaNode", fields: [nodeId], references: [id], onDelete: Cascade)
  target Node @relation("CommentMetaTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([targetNodeId])
  @@index([threadRootId])
  @@map("comment_meta")
}

/// An edge whose target Node has not been synced yet; stored without
/// a foreign key to the target. When the target Node is synced, the
/// PendingEdge is converted to a regular Edge.
model PendingEdge {
  id          String    @id @default(cuid())
  sourceId    String    @map("source_id")
  /// Intended target node id — **NOT a foreign key**; resolved at
  /// promotion time.
  targetId    String    @map("target_id")
  /// Edge loc carried so an authored loc survives until promotion; the
  /// promoted Edge derives one when this is null. (Mirrors `Edge.loc`.)
  loc         String?
  /// Free-form relationship name (was `label`).
  name        String?
  /// Preserved until the unresolved edge is promoted; empty differs from null.
  description String?
  /// Structured edge payload carried through deferred Git sync and cloning.
  data        Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  source Node @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([targetId])
  @@map("pending_edges")
}

/// Tracks a unit of work by an App: an AI/agent conversation, a
/// chatbot interaction, an automation run. Sessions are the top-level
/// tracking concept; UsageEvent rows are recorded within a session.
/// #1156 / cor:dmo:070:05: only an end writer supplies a cause; legacy NULL stays unknown.
enum SessionEndReason {
  ended
  superseded
  expired
}

model Session {
  id                String            @id // caller-generated (e.g. UUID from h-start-session)
  type              SessionType       @default(DEVELOPER)
  appId             String?           @map("app_id")
  /// The User this session is attributed to (typically the end-user
  /// in a chatbot/automation session; the developer in a DEVELOPER
  /// session).
  userId            String?           @map("user_id")
  /// The Agent driving the session (NULL for free-form developer
  /// sessions not tied to a specific Agent). When `workerId` is set this
  /// records the ROLE-agent behind the casting (cor:agt:020:03).
  agentId           String?           @map("agent_id")
  /// #974 — the named identity doing the work: the Worker (casting) this
  /// session is bound to (cor:dmo:050:11, cor:agt:020:03). Binding is
  /// gated at start (the worker must belong to the session's App); "taken
  /// right now" derives from an ACTIVE session bound to the worker.
  workerId          String?           @map("worker_id")
  /// #2458 (cor:dmo:050:11): the worker's role AT BIND, stamped from the locked worker row with `agentId`, so a
  /// past session keeps the role it ran under after the worker's agent (and so its role) changes. Null for a
  /// session with no worker; the migration backfills earlier sessions exactly (the role was immutable before #2458).
  role              String?           @map("role")
  /// The active write-memory for this session, when there's an
  /// unambiguous one. Resolves the multi-writable-memory ambiguity.
  memoryId          String?           @map("memory_id")
  /// Hard expiry; the session reaper (src/jobs/reapSessions.ts, #930) ends
  /// sessions past this point. Since #1114 this is the ONLY thing the reaper
  /// acts on: a NULL here means the session is never ended automatically at
  /// all, because inactivity stopped being a reason to end one. It still
  /// stops reading as LIVE once nobody drives it inside its idle window, but
  /// that is derived at read time (lib/sessionActivity.ts) and mutates
  /// nothing. Set by startAgentSession from the App's sessionTimeoutSeconds —
  /// a promise made at session start rather than an inference from silence;
  /// startSession deliberately leaves it null (the client contract carries no
  /// TTL), so an explicit endSession is what closes those.
  expiresAt         DateTime?         @map("expires_at")
  /// Git repo slug.
  repo              String?
  /// Git branch name at session start.
  branch            String?
  /// GitHub PR number.
  prNumber          Int?              @map("pr_number")
  /// Tenant/customer identifier (free-form, supplied by the App).
  customerId        String?           @map("customer_id")
  /// Spoken ("en", "es") or programming language.
  language          String?
  /// The execution plan, when one was prepared.
  plan              String?
  /// LLM model used (e.g. "claude-opus-4-6").
  llmModel          String?           @map("llm_model")
  /// #928 coding-session provenance: where the driving tool's transcript
  /// physically lives on `host` (a filesystem path in that tool's store).
  transcriptPath    String?           @map("transcript_path")
  /// #928: machine identifier the session ran on.
  host              String?
  /// #928: the tool driving the session ("claude-code", "codex", ...).
  tool              String?
  /// #1707 — the model family this session runs as (cor:agt:060:04): given
  /// at session start, or derived from `llmModel` then `tool`; null when it
  /// could not be classified. A worker's family is its live bound session's.
  /// A matching input only, never an authorization input: it is self-declared.
  family            String?
  /// #2252 — when `llmModel` was last SELF-REPORTED (start, resume, or an
  /// updateSession carrying a model; a repeat of the same model counts). Null
  /// for a session that never reported, including every row from before this
  /// column: no historical backfill. Not `updated_at`, which unrelated writes
  /// move. Describes a self-report, not verified detection.
  modelReportedAt   DateTime?         @map("model_reported_at")
  /// #1709 (cor:agt:070:08; Holger via Vera #10773) — a host-launched session:
  /// the host that started it, the `worker.start` operation, the task it was
  /// launched for (none for a manager's start without one), and who issued the
  /// start (`platform` | `manager`). Bound on the holder's own token; the hold
  /// is unchanged. All four null for a session a person started by hand.
  launchHostId      String?           @map("launch_host_id")
  launchOperationId String?           @unique @map("launch_operation_id")
  launchTaskId      String?           @map("launch_task_id")
  launchIssuedBy    String?           @map("launch_issued_by")
  /// Total prompt tokens across the session.
  inputTokens       Int?              @map("input_tokens")
  /// Total completion tokens across the session.
  outputTokens      Int?              @map("output_tokens")
  /// Number of human-AI exchanges.
  turnCount         Int?              @map("turn_count")
  /// Failed tool calls / action runs.
  errorCount        Int?              @map("error_count")
  /// Sub-agent vertical relation (this session was spawned by a parent).
  parentSessionId   String?           @map("parent_session_id")
  /// Chain horizontal relation (linked journey — this session
  /// continues from a previous one).
  prevSessionId     String?           @map("prev_session_id")
  /// AI-composed summary at session end.
  summary           String?
  /// 0.0-1.0, reported externally.
  outcome           Float?
  /// GUID or URL of authoritative outcome record.
  outcomeRef        String?           @map("outcome_ref")
  /// Domain-specific outcome detail.
  outcomeMeta       Json?             @map("outcome_meta")
  startedAt         DateTime          @default(now()) @map("started_at")
  endedAt           DateTime?         @map("ended_at")
  /// First end wins. NULL on legacy ended rows is exposed as unknown, never backfilled.
  endReason         SessionEndReason? @map("end_reason")
  /// Set by the reaper (#930) when the session was auto-expired — meaning
  /// past `expiresAt`, and since #1114 nothing else. It no longer records an
  /// idle-window expiry, because there is no longer such a thing: inactivity
  /// never ends a session. Rows carrying this from before that change are the
  /// only ones stamped for idleness, which is why the liveness derivation
  /// still drops `updatedAt` on an auto-expired row (the reap overwrote it).
  /// Always written together with `endedAt` and to the same instant, so
  /// "ended" stays the single predicate `endedAt IS NOT NULL` and this
  /// column records only HOW it ended. (#1232 — this read `IS NULL`,
  /// which is the predicate for a session that has NOT ended, and it
  /// said so in the published Data Model reference.)
  autoExpiredAt     DateTime?         @map("auto_expired_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  createdBy         String?           @map("created_by")
  updatedAt         DateTime?         @updatedAt @map("updated_at")
  updatedBy         String?           @map("updated_by")
  deletedAt         DateTime?         @map("deleted_at")
  deletedBy         String?           @map("deleted_by")

  events       UsageEvent[]
  parent       Session?     @relation("SubAgentSessions", fields: [parentSessionId], references: [id], onDelete: SetNull)
  subSessions  Session[]    @relation("SubAgentSessions")
  prev         Session?     @relation("SessionChain", fields: [prevSessionId], references: [id], onDelete: SetNull)
  nextSessions Session[]    @relation("SessionChain")
  app          App?         @relation(fields: [appId], references: [id], onDelete: SetNull)
  user         User?        @relation("SessionUser", fields: [userId], references: [id], onDelete: SetNull)
  agent        Agent?       @relation("SessionAgent", fields: [agentId], references: [id], onDelete: SetNull)
  worker       Worker?      @relation("SessionWorker", fields: [workerId], references: [id], onDelete: SetNull)
  memory       Memory?      @relation("SessionMemory", fields: [memoryId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([repo])
  @@index([customerId])
  @@index([startedAt])
  @@index([parentSessionId])
  @@index([prevSessionId])
  @@index([appId, userId])
  @@index([expiresAt])
  @@index([workerId])
  /// #451: agent and memory deletes null these FKs (SET NULL); each needs its own leading index.
  @@index([agentId])
  @@index([memoryId])
  /// #1016 — the "what am I driving?" read (`hadron_whoami`), which filters
  /// `userId` alone and orders by `startedAt`. `[appId, userId]` cannot serve
  /// it: Postgres will not seek on a composite index's SECOND column, so the
  /// planner fell back to the `[startedAt]` index and scanned the global
  /// session history backwards — worst for the caller with NO open session,
  /// which is exactly the compaction-recovery case the tool exists for.
  @@index([userId, startedAt])
  @@map("sessions")
}

/// Record of a single operation within a Session (read, write,
/// action run, edge traversal, session summary).
///
/// **Column `type` is `String` (not enum)** — intended values:
/// `read | write | action-run | edge-traversal | session-summary`.
/// Tightening to a Prisma enum is reserved for a future cleanup spec.
model UsageEvent {
  id               String    @id @default(cuid())
  type             String
  /// Stored directly so the event survives node deletion.
  nodeLoc          String?   @map("node_loc")
  /// Set null on node deletion.
  nodeId           String?   @map("node_id")
  /// Memory the event is attributed to (#796). Stored DIRECTLY at write time
  /// like `nodeLoc` — deliberately NO relation, unlike this model's five other
  /// FKs. Those are all `SetNull`, and memory-scoped analytics used to reach
  /// the memory by joining through `node`, so deleting a node silently erased
  /// the event from its memory's history. A `SetNull` FK here would recreate
  /// that loss one level up (on memory deletion), which is exactly what this
  /// column exists to prevent.
  memoryId         String?   @map("memory_id")
  /// Set null on session deletion.
  sessionId        String?   @map("session_id")
  /// The App that authored this event.
  appId            String?   @map("app_id")
  /// Key-value args when `type = 'action-run'`.
  actionArgs       Json?     @map("action_args")
  /// LLM model used for this specific event.
  model            String?
  /// Input tokens consumed.
  tokensIn         Int?      @map("tokens_in")
  /// Output tokens generated.
  tokensOut        Int?      @map("tokens_out")
  // ── 046-usage-metering (billing Phase 0) ──────────────────────────────
  /// The on-behalf-of user (billing attribution). Nullable — pure-App
  /// service runs have no user. Distinct from the audit `createdBy` string.
  userId           String?   @map("user_id")
  /// The billable organization. Set on every metered event so ledger
  /// attribution never needs a join through App.
  organizationId   String?   @map("organization_id")
  /// LLM provider that served the call — `model` alone is ambiguous
  /// across providers (e.g. claude via anthropic vs bedrock).
  provider         String?
  /// AiConfigOwnerType of the API key that served the call
  /// (HADRON_SERVER | ORGANIZATION | APP | AGENT). Only HADRON_SERVER
  /// spend is platform-paid and thus debitable; BYOK is observability-only.
  keyOwnerType     String?   @map("key_owner_type")
  /// Provider cost snapshot in micro-cents (1e-8 USD), computed from the
  /// AiModelPrice row effective at event time. NULL = no price known (or the
  /// event carries no tokens). Never recomputed — prices change (FR-003).
  costMicroCents   BigInt?   @map("cost_micro_cents")
  /// #1653 / ruling DY-2: whether this event counts as ACTIVITY for its
  /// session's liveness. True only when the session was live AND owned by the
  /// recording principal at write time (`usageEventCountsAsActivity`), so a
  /// request attributed to a LAPSED session keeps its attribution but never
  /// revives it — resuming is the DA door alone. Defaults to false so a writer
  /// that forgets the check fails safe; rows before the column are backfilled
  /// true by the migration, so liveness was unchanged at deploy.
  countsAsActivity Boolean   @default(false) @map("counts_as_activity")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  node         Node?         @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  session      Session?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  app          App?          @relation(fields: [appId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([nodeLoc])
  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
  @@index([appId])
  /// #451: a node hard delete nulls this FK (SET NULL); without it each delete scans the firehose.
  @@index([nodeId])
  /// #796 — the two `usageActivity` scopes. Both are composite on `createdAt`
  /// so the bucketed aggregation is an index range scan; the composite
  /// `(userId, createdAt)` also prefix-covers the plain `userId` lookups the
  /// bare index used to serve, so that one was dropped.
  @@index([userId, createdAt])
  @@index([memoryId, createdAt])
  @@index([organizationId, createdAt])
  // #1903: session liveness also needs the PARTIAL index
  // usage_events_session_activity_idx (session_id, created_at) WHERE
  // counts_as_activity. Prisma can't model a partial index, so it lives in
  // prisma/post-push.sql and migration 20261014040000.
  @@map("usage_events")
}

/// **The Agent definition** — what a Builder creates and what the
/// marketplace sells. One Agent row holds the canonical conversation
/// design (system memory), the default AI config, the declared
/// memory-provisioning policy, and the declared installation policy.
/// Spec: 008-agent-installation (2026-05-02).
///
/// An **App** is the *deployment* of an Agent in some org. The Agent
/// is what is shared across installations; the App is what
/// authenticates, holds members, and accumulates per-deployment data.
/// (PWA analogy: you build an Agent, and when someone installs it,
/// the running instance is called an App.)
///
/// Examples: "Mealplan" (the Agent your family meal planner is built
/// from), "Juno" (the mentee chat agent shared across MicroMentor
/// orgs).
model Agent {
  id                    String          @id @default(cuid())
  /// #2138 §3.5 — false: every worker cast from this Agent counts as HAVING a task (coordinators, the
  /// lifecycle agent), so it is expected to check every period.
  usesTasks             Boolean         @default(true) @map("uses_tasks")
  /// #2162 (cor:agt:050:27) — when a task one of this Agent's workers had started finishes or is cancelled, and it holds
  /// no other started task, the platform asks the worker's host to reset its context: a shed, never a session end.
  /// Off by default; written by whoever manages the Agent, like `usesTasks`.
  resetContextAfterTask Boolean         @default(false) @map("reset_context_after_task")
  organizationId        String?         @map("organization_id")
  /// User owner of a user-owned Agent (rooted on the bare `<handle>` — #697 v2,
  /// no `@` sigil). The org/owner XOR is ENFORCED — `chk_agent_owner_xor` in
  /// post-push.sql: `(organization_id IS NULL) <> (owner_user_id IS NULL)` — so
  /// exactly one of `organizationId`/`ownerUserId` is non-null.
  ownerUserId           String?         @map("owner_user_id")
  ownerUser             User?           @relation("AgentOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// Globally unique identifier (e.g. "micromentor.org:juno");
  /// derived from `org.urn + ":" + slug`.
  urn                   String          @unique
  /// Display name of this agent.
  name                  String
  description           String?
  /// #2045 (S8, cor:agt:040:07) — this Agent's boot-prompt POINTER: the id of a
  /// compiled boot-prompt node (`nodeType = 'compiled-boot-prompt'`), never its
  /// source. NO foreign key: nodes are hard-deleted on some paths (deleteNode
  /// hard/subtree, memory merge, git-sync cleanup), and SET NULL would turn a
  /// deleted target (R27) into "no pointer" (R26) while RESTRICT would block
  /// those deletes. `bootPromptUrn` is the target's canonical URN at write time,
  /// read only when the row is gone; both are set or both NULL
  /// (chk_*_boot_prompt_pointer_pair, prisma/boot-prompt-pointer-invariants.sql).
  /// Written only through `setBootPromptPointer` (src/lib/bootPromptPointer.ts).
  bootPromptNodeId      String?         @map("boot_prompt_node_id")
  bootPromptUrn         String?         @map("boot_prompt_urn")
  /// Memory containing conversation designs (stages, prompts,
  /// partials). Universally read-only from any App context post-008
  /// (DEVELOP-from-App is dropped per R-10); edits happen in the
  /// Agent ownership surface.
  systemMemoryId        String?         @map("system_memory_id")
  /// PUBLIC | ORGANIZATION | PERSONAL (035-visibility-enum-cleanup gave
  /// agents their own enum). PERSONAL is the creator-only draft state.
  visibility            AgentVisibility @default(PERSONAL)
  /// Opt-in marketplace catalogue flag (cor:acl:080:04): whether this agent is
  /// advertised in the marketplace browse. DISTINCT from `visibility` — PUBLIC
  /// governs access, this governs advertisement. Contributes to the owner org's
  /// discoverability (cor:acl:080:02) only when that org is activated.
  listedOnMarketplace   Boolean         @default(false) @map("listed_on_marketplace")
  /// Coarse behavior hint — see AgentType enum doc. Largely legacy
  /// post-008.
  type                  AgentType       @default(ASSISTANT)
  /// Surfaces this Agent is designed for (free-form per 008 R-9; v1
  /// known values: 'chat', 'slack', 'mcp', 'web'). Distinct from the
  /// per-App `surfaces` — this is the *design-time* declaration.
  surfaces              String[]        @default([])
  // 036-ai-service-config: the legacy ai_provider/ai_model/
  // ai_api_key_encrypted/ai_api_key_preview columns were dropped in favor
  // of Agent-owned AiServiceConfig rows (the Agent's design-time default
  // lives in its config named 'default'; an App-owned config overrides at
  // deploy time per the resolution walk).
  /// Loc of the currently-published revision of the Agent's system
  /// memory. Lets the Builder ship draft revisions without affecting
  /// running Apps.
  publishedRevisionLoc  String?         @map("published_revision_loc")
  /// Optimistic editor-lock owner (one Builder at a time can hold the
  /// edit lock on the system memory).
  editorLockUserId      String?         @map("editor_lock_user_id")
  /// When the editor lock expires (auto-released on stale).
  editorLockExpiresAt   DateTime?       @map("editor_lock_expires_at")
  /// Agent working state (per-user data like family budget,
  /// preferences); automatically available to the LLM as context.
  properties            Json?
  // 008-agent-installation (2026-05-02): Agent declares per-deployment memory
  // provisioning shape. Schema: { appMemory: 'shared' | 'user' | 'none' }.
  // Personal-class provisioning is implicit (lazy on first user-attributed write).
  /// Declares how this Agent expects per-App memory to be
  /// provisioned. Shape: `{ appMemory: 'shared' | 'user' | 'none' }`.
  /// `personalMemory` provisioning is implicit (lazy-create on first
  /// user-attributed write). 008-agent-installation FR-008.
  memoryProvisioning    Json            @default("{\"appMemory\": \"shared\"}") @map("memory_provisioning")
  /// Spec 049 Phase 5 (plan §3.5 recommendation): the defaults this Agent's
  /// install-created register row is made with — `{ mentionOnly?: boolean }`.
  /// A scalar default, not a reference that can rot; null = platform defaults.
  registerDefaults      Json?           @map("register_defaults")
  // 008-agent-installation (2026-05-02): Agent declares membership constraints.
  // Schema: { maxMembers: number | 'unlimited', memberRoles: string[] }.
  // Enforced at AppMember invite-acceptance time.
  /// Declares membership constraints for any App that installs this
  /// Agent. Shape: `{ maxMembers: number | 'unlimited', memberRoles:
  /// string[] }`. `maxMembers` enforced at AppMember
  /// invite-acceptance time. 008-agent-installation FR-009.
  installationPolicy    Json            @default("{\"maxMembers\": \"unlimited\", \"memberRoles\": [\"owner\"]}") @map("installation_policy")
  // #928 persona dressing, re-cut to the Worker model by #974 (cor:agt:020:01,
  // D-2026-08-14-004): a persona is UNIVERSAL DRESSING on an Agent — a role
  // plus a template prompt that let any agent present as a colleague. The
  // NAMED identity ("Iris") lives on the Worker entity (the casting of an
  // installed agent into an App), never here: the retired persona-as-agent
  // model's `persona_name` / `team_app_id` columns were dropped by the
  // 20260814130000_worker_model migration. These two columns are PURE
  // METADATA; no server behavior may fork on their presence (that would
  // rebuild the deprecated AgentType axis).
  /// Persona role — free string with conventions ("backend-engineer").
  /// A dedicated column so roster/casting queries can filter without
  /// parsing the prompt.
  personaRole           String?         @map("persona_role")
  /// #1885 (cor:dmo:050:14) — the one base Agent this Agent extends, or null.
  /// The child inherits its base chain's system-memory nodes (except boot
  /// prompts). One base, no cycles, at most 4 Agents in a chain counting this
  /// one: enforced by `src/lib/agentBase.ts`, the only writer, and backstopped
  /// by `agent_base_guard` (prisma/agent-base-invariants.sql). `Restrict`, as
  /// for an imported Agent: a live child keeps its base from being removed.
  extendsAgentId        String?         @map("extends_agent_id")
  /// #1892 (cor:dmo:050:15) — the index node whose incoming, trigger-labelled
  /// edges list this Agent's own tasks; null when it names none. Written only
  /// by `setAgentIndexRefs`, read by src/lib/agentDefinitionLists.ts.
  /// `SetNull`: removing the index node unsets the pointer.
  /// #2245 (R145/R146): the Agent this one was cloned from, as a plain ref (the source's URN at clone time).
  /// No FK: the source may be retired or renamed, and the provenance must survive both.
  clonedFromAgentRef   String?         @map("cloned_from_agent_ref")
  tasksIndexRef        String?         @map("tasks_index_ref")
  /// #1892 (cor:dmo:050:16) — the index node whose incoming, trigger-labelled
  /// edges list the processes this Agent starts or owns; null when none.
  processesIndexRef     String?         @map("processes_index_ref")
  createdAt             DateTime        @default(now()) @map("created_at")
  createdBy             String?         @map("created_by")
  updatedAt             DateTime?       @updatedAt @map("updated_at")
  updatedBy             String?         @map("updated_by")
  deletedAt             DateTime?       @map("deleted_at")
  deletedBy             String?         @map("deleted_by")

  /// Online URN-shape migration gate (spec 021 FR-032, repurposed for the #697
  /// v1→v2 emission flip). Null = pre-normalization row; set = row normalized
  /// onto the flat v2 form (`<root>:<slug>`, single colon). Transient.
  /// TODO(spec-021-cleanup): drop once the FR-032 migration completes.
  urnNormalizedAt          DateTime? @map("urn_normalized_at")
  /// Spec 021 sentinel for data-defect rows during the FR-032 migration.
  /// TODO(spec-021-cleanup): drop alongside urnNormalizedAt.
  urnMigrationFailedReason String?   @map("urn_migration_failed_reason")
  /// #697 stored alias map: the pre-v2 (v1) URN this row was migrated FROM
  /// (see Memory.legacyUrn). Null until the online migration flips `urn` to v2.
  legacyUrn                String?   @map("legacy_urn")

  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memoryItems        AgentMemoryItem[]
  userMemories       Memory[]            @relation("UserMemoriesOfAgent")
  /// #723 — the per-App `shared` app-class memories this Agent is the identity
  /// of (at most one per App).
  sharedMemories     Memory[]            @relation("SharedMemoriesOfAgent")
  /// #2044 — the per-App install memories that customise this Agent.
  installMemories    Memory[]            @relation("InstallMemoriesOfAgent")
  sessions           Session[]           @relation("SessionAgent")
  userSubscriptions  AgentSubscription[] @relation("AgentUserSubscriptions")
  // 023-app-shape Phase 2b: App↔Agent goes through `AppAgent` (N:M).
  // The direct `App[]` back-relation is gone (dropped with App.agentId).
  appAgents          AppAgent[]
  imports            AgentImport[]       @relation("ParentAgent")
  importedBy         AgentImport[]       @relation("ImportedAgent")
  orgGrants          AgentOrgGrant[]
  aiServiceConfigs   AiServiceConfig[]
  modelGroups        ModelGroup[]
  scopes             Scope[]
  registerAttendeeOf RegisterEntry[]     @relation("RegisterAttendeeAgent")
  readStates         ChannelReadState[]  @relation("ReadStateAgent")
  /// #974 — the named castings of this agent into Apps (cor:dmo:050:11).
  workers            Worker[]
  /// #1885 (cor:dmo:050:14) — the base this Agent extends, and the Agents
  /// that extend it. Never called a parent: that word belongs to imports.
  extendsAgent       Agent?              @relation("AgentBase", fields: [extendsAgentId], references: [id], onDelete: Restrict)
  extendedBy         Agent[]             @relation("AgentBase")
  /// #1892 — the nodes `tasksIndexRef` / `processesIndexRef` name.
  tasksIndex         Node?               @relation("AgentTasksIndex", fields: [tasksIndexRef], references: [id], onDelete: SetNull)
  processesIndex     Node?               @relation("AgentProcessesIndex", fields: [processesIndexRef], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([extendsAgentId])
  @@index([legacyUrn])
  @@index([bootPromptNodeId])
  /// #451: org agent listings and the org-delete cascade. The persona-name uniques are partial and cannot serve them.
  @@index([organizationId])
  @@map("agents")
  /// #2024 (S8, cor:agt:080:33): the tickers this Agent declares; each cast of a worker from it instantiates them.
  tickerTemplates       AgentTickerTemplate[]
}

/// Associates a Memory with an Agent, with a per-memory access level.
/// The Agent controls which memories are read-only vs read-write
/// per-attached-memory. After 005-agent-subscription,
/// `AgentMemoryItem.role` is the sole per-knowledge-memory write cap
/// (the AppAgent-level cap was first relaxed in 005, then the
/// AppAgent join itself was dropped in 008-agent-installation).
model AgentMemoryItem {
  id        String    @id @default(cuid())
  agentId   String    @map("agent_id")
  memoryId  String    @map("memory_id")
  /// `"read"` or `"read-write"`. Default `"read"`. Controls whether
  /// the Agent can write to this memory.
  role      String    @default("read")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([agentId, memoryId])
  @@map("agent_memory_items")
}

/// Commercial usage grant of a Memory; defines capacity and terms.
/// Consumed via MemorySubscription.licenseId.
model MemoryLicense {
  id          String    @id @default(cuid())
  memoryId    String    @map("memory_id")
  /// **Column type is `String` (not enum)** — intended values:
  /// `user | app | organization`.
  licenseType String    @map("license_type")
  /// Number of consumers allowed to use this license.
  seats       Int
  validFrom   DateTime  @map("valid_from")
  validUntil  DateTime  @map("valid_until")
  /// One or more license keys.
  licenseKeys String[]  @map("license_keys")
  /// Usage terms & conditions.
  terms       String
  /// If true, the memory will be merged into the blended graph for
  /// the consumer.
  activated   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")

  memory        Memory               @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  subscriptions MemorySubscription[]

  @@map("memory_licenses")
}

/// An Organization subscribes to another Organization's Memory.
/// Governed by a MemoryLicense when the memory requires one.
///
/// **Access evaluation order** (cross-org chain — extended in
/// 005-agent-subscription with the App↔Agent and User↔Agent gates;
/// 008-agent-installation added AgentOrgGrant; 023-app-shape replaced the
/// direct `App.agentId` with the `AppAgent` join (an App can install N Agents)):
///   1. **App ↔ Agent** — the App has the Agent installed (an `AppAgent`
///      row links them) AND `Agent.visibility` allows the App's org.
///      Cross-org installs (`App.organizationId != Agent.organizationId`)
///      additionally require an active `AgentOrgGrant(App.organizationId,
///      agentId)`. Same-org installs auto-pass.
///   2. **Agent ↔ Memory (knowledge / app / system)** — current
///      implementation (`src/mcp/access-control.ts#foldAgentIntoAccessMap`):
///      `AgentMemoryItem(agent, memory)` exists OR memory is the
///      Agent's `systemMemoryId`. When cross-org for knowledge:
///      `MemorySubscription(orgB, memory)` AND any required
///      `MemoryLicense` valid (not expired, seats available).
///      **Known gap** (tracked in
///      [issue #115](https://github.com/hadron-memory/hadron-server/issues/115)):
///      this gate does NOT auto-grant access to app-class memories
///      where `memory.appId = App.id` AND `memory.class = 'app'`.
///      Today an explicit `AgentMemoryItem` row is required for
///      app-class memories to be reachable through the MCP/GraphQL
///      gates. The spec called for auto-grant; the implementation
///      currently does not.
///   3. **User ↔ Agent (personal-class memory only)** —
///      `AgentSubscription(user, agentId)` exists AND active per
///      the predicate, AND `Memory.appId = App.id` (the per-App
///      isolation that User Story 2 hangs on — a session through App
///      A cannot read the personal memory at `(B.id, user.id)` for
///      some other App B of the same Agent).
///   4. **Effective role** — most restrictive of
///      `AgentMemoryItem.role` and `MemorySubscription.role`. (The
///      legacy `AppAgent.role` is dropped post-008 — system memory is
///      universally read-only from any App.) `personal`/`private`-class
///      memories enforce strict ownership *additionally*: even an
///      ADMIN/OWNER who would otherwise satisfy gate 2 cannot read a
///      `personal`/`private` memory they do not own (FR-016).
///
/// **Worked example** (the four-org Juno scenario, 008 vocabulary):
/// an App in `OrgA` deploys Juno (Agent in `OrgB` with
/// visibility=ORGANIZATION since Alice is a Micromentor org-member;
/// or PUBLIC for marketplace shape) which references a knowledge
/// Memory in `OrgC`. The cross-org App↔Agent gate is satisfied by an
/// active `AgentOrgGrant(OrgA, juno)`. End-user Alice (personal org
/// `personal-alice`) chats through that App; her records land in a
/// personal Memory at `(App.id, alice.id)` (`Memory.userId = alice`,
/// `Memory.appId = App.id`, `class = personal`, `visibility = null`).
/// The cross-org write into Alice's
/// personal memory is granted by `AgentSubscription(alice, juno)` —
/// without it, Juno has zero access. If Alice installs Juno into a
/// *second* App (different Org), her records there go to a separate
/// `(B.id, alice.id)` row — fully isolated from the OrgA installation.
/// Each gate above must clear in order; failure denies at the right
/// layer with a typed error.
model MemorySubscription {
  id             String    @id @default(cuid())
  memoryId       String    @map("memory_id")
  /// The subscribing organization (not the owner).
  organizationId String    @map("organization_id")
  licenseId      String?   @map("license_id")
  /// Column type is the full `Role` enum, but the intended grant set
  /// is `CONTRIBUTOR | READER` (reader = read-only, contributor =
  /// read-write). Tightening reserved for a future cleanup spec.
  role           Role      @default(READER)
  /// If true, the memory will be merged into the blended graph for
  /// the subscriber.
  activated      Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  memory       Memory         @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  license      MemoryLicense? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@unique([memoryId, organizationId])
  @@index([organizationId])
  @@map("memory_subscriptions")
}

/// Represents a running Hadron server instance (SaaS or self-hosted).
/// Each organization connects to one server; a server serves one or
/// many organizations.
model HadronServer {
  id              String    @id @default(cuid())
  /// The organization that owns/operates this server; NULL for the
  /// Baragaun SaaS server.
  organizationId  String?   @map("organization_id")
  /// Base URL of this server (e.g. "https://server.hadrongraph.io").
  url             String
  /// Minimum level for ServerLogEntry records.
  logLevel        LogLevel  @default(ERROR) @map("log_level")
  /// Deployed software version.
  version         String?
  /// Last health-check timestamp.
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  logEntries       ServerLogEntry[]
  aiServiceConfigs AiServiceConfig[]

  memoryConfigTemplates MemoryConfigTemplate[]

  @@map("hadron_server")
}

/// Named AI service configuration (spec 036). Owned by exactly one of
/// HadronServer / Organization / App / Agent — enforced by the Postgres
/// CHECK `chk_ai_service_config_owner` (see prisma/post-push.sql; Prisma
/// cannot express it). Resolved by name walking App -> Agent -> Org (of
/// the App, else of the Agent) -> HadronServer; the first ENABLED config
/// with the requested name wins. Well-known fallback name: 'default'
/// (conventional extras: 'fast', 'frontier'). Name is unique per owner
/// via four partial unique indexes (also post-push.sql). Replaces the
/// legacy Agent.ai_* / App.ai_* columns, which the 036 migration dropped
/// without backfill (stored values confirmed disposable 2026-06-11).
model AiServiceConfig {
  id              String    @id @default(cuid())
  /// Lookup name used by the resolution walk; lower-case canonical.
  name            String
  // Owner FKs — exactly one non-null (chk_ai_service_config_owner).
  hadronServerId  String?   @map("hadron_server_id")
  organizationId  String?   @map("organization_id")
  appId           String?   @map("app_id")
  agentId         String?   @map("agent_id")
  /// Provider identifier; known: 'anthropic' | 'openai' | 'glm' | 'bedrock' |
  /// 'openai-compatible' (endpoint required). Validated against the registry
  /// in src/lib/aiConfig.ts.
  provider        String
  /// Model identifier, passed verbatim to the provider.
  model           String
  /// AES-256-GCM-encrypted API key (src/lib/tokenCrypto.ts encryptToken).
  /// For 'bedrock' this is a JSON-encoded {accessKeyId, secretAccessKey,
  /// region} triple, stored opaque.
  apiKeyEncrypted String?   @map("api_key_encrypted")
  /// Ellipsis + last 4 chars of the raw key for masked display.
  apiKeyPreview   String?   @map("api_key_preview")
  /// Provider-specific knobs (maxTokens, thinking, effort, baseUrl, ...).
  /// Validated per provider by zod in src/lib/aiConfig.ts.
  params          Json?
  /// #1373: base URL requests for this config are sent to. Null = the
  /// provider's default (src/lib/aiEndpoint.ts, the one suggestion list).
  /// Validated at write (validateEndpoint) and guarded at connect time.
  endpoint        String?
  /// #1373 D3: wire protocol for an OpenAI-compatible provider —
  /// 'CHAT_COMPLETIONS' | 'RESPONSES'. Null = the provider's default
  /// (src/lib/aiEndpoint.ts). Refused for providers with one protocol.
  apiStyle        String?   @map("api_style")
  /// Disabled configs are skipped by resolution (walk continues outward).
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")

  hadronServer HadronServer? @relation(fields: [hadronServerId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  app          App?          @relation(fields: [appId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([hadronServerId])
  @@index([organizationId])
  @@index([appId])
  @@index([agentId])
  @@map("ai_service_configs")
}

/// Log entry for the Hadron server, surfaced in hadron-portal for
/// troubleshooting. Examples: memory sync failures, GitHub App
/// errors, system-level events.
model ServerLogEntry {
  id        String    @id @default(cuid())
  serverId  String    @map("server_id")
  level     LogLevel
  /// Set if the log relates to a specific memory.
  memoryId  String?   @map("memory_id")
  /// Human-readable log message.
  message   String
  /// Structured context (stack trace, request/response, etc.).
  detail    Json?
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  server HadronServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([level])
  @@index([createdAt])
  @@map("server_log")
}

/// Log entry for a specific memory, surfaced in hadron-portal for
/// troubleshooting. Examples: sync failures, license expirations,
/// pending edge resolution, branch conflicts.
model MemoryLogEntry {
  id        String             @id @default(cuid())
  memoryId  String             @map("memory_id")
  level     LogLevel
  /// Categorizes the log for filtering.
  eventType MemoryLogEventType @map("event_type")
  /// Human-readable log message.
  message   String
  /// Structured context (sync diff, expired license details, etc.).
  detail    Json?
  createdAt DateTime           @default(now()) @map("created_at")
  createdBy String?            @map("created_by")
  updatedAt DateTime?          @updatedAt @map("updated_at")
  updatedBy String?            @map("updated_by")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([level])
  @@index([eventType])
  @@index([createdAt])
  @@map("memory_log")
}

/// An invitation sent to an existing platform User to join an
/// Organization. The `role` cannot be higher than that of the sender.
/// (Contrast with UserInvitation, which is for inviting *new* platform
/// users.)
model OrgMemberInvitation {
  id              String    @id @default(cuid())
  /// fk to OrgMember.id — the sender of the invitation.
  memberUserId    String    @map("member_user_id")
  /// fk to User.id — the recipient (an existing platform user).
  recipientUserId String    @map("recipient_user_id")
  /// Column type is the full `Role` enum, but the intended grant set
  /// is `ADMIN | CONTRIBUTOR | READER` (you can't invite someone as
  /// OWNER — promotion happens via a separate transfer flow).
  role            Role      @default(READER)
  /// When this invitation expires.
  expiresAt       DateTime? @map("expires_at")
  /// When the recipient accepted the invitation.
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  sender    OrgMember @relation("SentByMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  recipient User      @relation("ReceivedMemberInvitations", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@map("org_member_invitations")
}

/// Invitation sent out to one or more persons that do not yet have a
/// user account. If `maxActivations = 1` this invitation is
/// single-use. If `email` or `githubUsername` is given, the new user
/// is validated against this — which essentially locks the identity
/// of the new person and sets `maxActivations` to 1.
///
/// **Quota** is tracked on `User.maxReferrals`, not on the invitation.
/// When a new user is created from this invitation, their
/// `maxReferrals` is set by the onboarding process (e.g. from the
/// sender's remaining quota or a system default).
///
/// **Race conditions**: if a referral arrives at the landing page
/// after activations exceed `maxActivations`, the page shows
/// "The invitation has expired. Please contact the sender." If
/// onboarding has *started* and the create-account request would push
/// the count above the cap, the account is still created (don't block
/// a real human on a counter).
///
/// **Role bounds**: `userRole` cannot be higher than the sender's;
/// `memberRole` cannot be higher than the sender's OrgMember role in
/// the target org.
model UserInvitation {
  id             String    @id @default(cuid())
  /// fk to User.id — the sender; NULL for system/seed invitations
  /// from Baragaun.
  senderUserId   String?   @map("sender_user_id")
  /// If the new user should be added to an organization on signup.
  organizationId String?   @map("organization_id")
  /// Random string to get a unique invite URL.
  slug           String    @unique
  /// Column type is the full `Role` enum, but the intended set is
  /// `ADMIN | null` (most invites grant no global role).
  userRole       Role?     @map("user_role")
  /// Column type is the full `Role` enum, but the intended grant set
  /// is `ADMIN | CONTRIBUTOR | READER`.
  memberRole     Role      @default(READER) @map("member_role")
  /// fk to User.id — set when the invitation is accepted and a User
  /// is created.
  newUserId      String?   @map("new_user_id")
  /// Recipient's name.
  name           String?
  email          String?
  githubUsername String?   @map("github_username")
  phoneNumber    String?   @map("phone_number")
  /// Maximum number of times this invitation can be accepted by a
  /// new recipient; current count is determined from
  /// UserInvitationActivation rows.
  maxActivations Int?      @map("max_activations")
  expiresAt      DateTime? @map("expires_at")
  /// When this invitation was accepted and the new User was created.
  /// (For multi-use invites this is set on the *first* acceptance.)
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  sender       User?                      @relation("SentInvitations", fields: [senderUserId], references: [id], onDelete: SetNull)
  organization Organization?              @relation("OrgInvitations", fields: [organizationId], references: [id], onDelete: SetNull)
  activations  UserInvitationActivation[]

  @@map("user_invitations")
}

/// One row per User created in response to a UserInvitation. Role
/// bounds match UserInvitation's: `userRole` and `memberRole` cannot
/// exceed the sender's at activation time.
model UserInvitationActivation {
  id           String    @id @default(cuid())
  /// The invitation that was accepted.
  invitationId String    @map("invitation_id")
  /// The newly created User.
  userId       String    @map("user_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")

  invitation UserInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_invitation_activations")
}

/// Temporary token for email verification during signup.
model EmailVerificationToken {
  id              String    @id @default(cuid())
  email           String
  token           String    @unique
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  /// #505 session-fixation binding: SHA-256 of the browser nonce the portal set
  /// (HttpOnly cookie) when the magic link was REQUESTED. Carried into the login
  /// handoff code's clientStateHash at verify time so the browser that redeems
  /// must be the one that requested the link. NOT NULL in practice (POST
  /// /auth/email requires clientState); nullable only for forward-compat.
  clientStateHash String?   @map("client_state_hash")

  @@index([email])
  @@map("email_verification_tokens")
}

/// #2046 (S9, R38): the immutable provenance of ONE compiled boot-prompt
/// revision, written by the compile in the same transaction as that revision.
/// Keyed by the revision, not the node: a recompile inserts a new row and never
/// rewrites an older one (an UPDATE is refused at the SQL layer). It records
/// what the compile selected (the root source and every include or replacing
/// node, each as {nodeId, revNo, hash} with its effective selection settings and
/// its place in the expansion), never copied source text, names or titles. The
/// live compiled-from edge is a derived index of the LATEST compile; this row,
/// read through readCompiledRevision, is the authority for a given revision.
/// Operational state: excluded from revisions, approval and content hashes.
model CompiledPromptRevision {
  compiledNodeId  String   @map("compiled_node_id")
  compiledRevNo   Int      @map("compiled_rev_no")
  /// SHA-256 hex of the compiled text this revision holds.
  contentHash     String   @map("content_hash")
  /// AGENT | APP_AGENT | WORKER: the target this revision was compiled for.
  targetKind      String   @map("target_kind")
  targetAgentId   String   @map("target_agent_id")
  targetAppId     String?  @map("target_app_id")
  targetWorkerId  String?  @map("target_worker_id")
  /// CompiledProvenance (src/lib/bootCompile/provenance.ts).
  provenance      Json
  occurrenceCount Int      @map("occurrence_count")
  compiledBy      String?  @map("compiled_by")
  createdAt       DateTime @default(now()) @map("created_at")
  compiledNode    Node     @relation(fields: [compiledNodeId], references: [id], onDelete: Cascade)

  @@id([compiledNodeId, compiledRevNo])
  @@map("compiled_prompt_revisions")
}

/// A versioned snapshot of a Node's content. Written every time a
/// Node is updated, so the full history is recoverable.
model NodeRevision {
  id                 String              @id @default(cuid())
  nodeId             String              @map("node_id")
  /// Memory this snapshot's content belonged to at capture time. A node
  /// can be MOVED across memories (moveNode keeps the stable id), so gating
  /// revision history by the node's CURRENT memory alone would leak snapshots
  /// captured while the node lived in a memory the caller can't read (#602 /
  /// Codex P1). Every snapshot site stamps this; nullable only for legacy
  /// rows predating the column (backfilled to the node's current memory —
  /// the read gate treats NULL as the current memory).
  memoryId           String?             @map("memory_id")
  loc                String
  name               String
  alias              String?
  description        String?
  /// Paragraph summary at the time of the snapshot. Spec 031.
  /// Added in the US1 implementation when the live `Node.abstract`
  /// column landed — revision history would otherwise silently drop
  /// abstract edits.
  abstract           String?
  /// Spec 032 — snapshot of `Node.abstractOriginHash` at the time of
  /// revision capture. Restored verbatim by `restoreNodeRevision`;
  /// legacy revisions (pre-spec) have NULL here, which short-circuits
  /// the staleness check on the live row after restore (no false
  /// positives).
  abstractOriginHash String?             @map("abstract_origin_hash")
  content            String?
  tags               String[]
  // ─── #620: full curated-subset snapshot of the Node's content fields.
  // NULL `nodeType` marks a LEGACY row captured before these columns
  // existed (nodeType is non-null on Node, so every post-#620 snapshot
  // sets it) — restoreNodeRevision keys on that sentinel to leave the
  // live node's values for these fields untouched when restoring a
  // legacy snapshot, instead of wiping them to NULL. Deliberately NOT
  // versioned: embedding* (operational state), tokens (derived from
  // content), contentHash + ownerRepo (external-sync provenance), and
  // the created/updated/deleted audit stamps.
  nodeType           String?             @map("node_type")
  /// #725 — collection discriminator at capture time (parity with nodeType).
  objectType         String?             @map("object_type")
  isLink             Boolean?            @map("is_link")
  properties         Json?
  data               Json?
  seq                Int?
  isRunnable         Boolean?            @map("is_runnable")
  /// #1201 — `Node.role` at capture time. In the curated subset for a specific
  /// reason rather than for parity: the escalation path #1202 exists for is
  /// CLEARING a governed role, and a history that cannot show the role cannot
  /// show the un-governing.
  role               String?
  llmModel           String?             @map("llm_model")
  aiAgent            String?             @map("ai_agent")
  /// #1326 — pre-edit content attribution, distinct from editedBy (the actor
  /// taking this snapshot for the next edit). NULL on legacy snapshots.
  authorshipKind     NodeAuthorshipKind? @map("authorship_kind")
  authoredByTask     String?             @map("authored_by_task")
  authoredByRevision Int?                @map("authored_by_revision")
  authoredByHuman    String?             @map("authored_by_human")
  authoredAt         DateTime?           @map("authored_at")
  /// #620: the User.id of the editor, when a user is known — nothing
  /// else goes here anymore. Historically this column was overloaded
  /// (`reason ?? clientId ?? userId`, so it held edit rationales, OAuth
  /// identity strings like "github:<login>", or a User id); the #620
  /// migration moved identity strings to `editedByInfo`, rationales to
  /// `revLabel`, and backfilled from `createdBy` where that held a User id.
  editedBy           String?             @map("edited_by")
  /// #620: what we know about the editor when no User.id is available.
  /// Identity-string forms in the wild: "github:<login>" / "email:<addr>"
  /// / "user:<id>" (AuthContext.clientId) and "app:<App.id>" (App-key
  /// principals).
  editedByInfo       String?             @map("edited_by_info")
  /// #1610 — the Worker / Agent behind the edit this snapshot records,
  /// beside editedBy (the user). Set from the snapshot editor (editorFromAuth),
  /// so the lazy reconcile, which builds its own editor, records none.
  editedByWorkerId   String?             @map("edited_by_worker_id")
  editedByAgentId    String?             @map("edited_by_agent_id")
  /// #620: user-settable label for this revision (updateNodeRevision
  /// mutation; REV_LABEL_MAX_LEN cap). Also captures the #88 `reason`
  /// arg at snapshot time — the edit rationale that previously squatted
  /// in `editedBy` (legacy reasons were migrated here).
  revLabel           String?             @map("rev_label")
  /// #620: which node fields the edit that took this snapshot changed
  /// (e.g. ["abstract","tags"]). The snapshot itself is the PRE-edit
  /// state, so `changes` describes the delta between this snapshot and
  /// the state that replaced it. Empty for legacy rows (NULL reads as []).
  changes            String[]
  /// #620/#1591: User who approved this revision, copied from the live
  /// node's approval when this revision is snapshotted (edited away) while
  /// approved. The approval of record is on Node (see Node.approvedRevNo);
  /// these columns are its history.
  approvedBy         String?             @map("approved_by")
  /// #1591: the approving principal when no User.id is known.
  approvedByInfo     String?             @map("approved_by_info")
  /// #1591: when this revision was approved.
  approvedAt         DateTime?           @map("approved_at")
  /// #1591: approval hash v1 recorded when this revision was approved.
  approvalHash       String?             @map("approval_hash")
  /// #696: per-node MONOTONIC revision number (1, 2, 3, …) — the stable atom
  /// in the `hrn:noderev:<root>:<mem>:<loc...>:<rev>` URN (rendered `r<N>`).
  /// Minted race-safely from `Node.revSeq` (atomic increment) inside the same
  /// tx that inserts the snapshot. Nullable only for legacy rows predating the
  /// column (backfilled per-node by createdAt order in the migration).
  revNo              Int?                @map("rev_no")
  createdBy          String?             @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at")

  node           Node  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  approvedByUser User? @relation("NodeRevisionApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  /// #696: resolve a noderev URN by its per-node revision number.
  @@unique([nodeId, revNo], map: "node_revisions_node_rev_no_uniq")
  @@index([nodeId, createdAt])
  @@map("node_revisions")
}

/// #1326 — append-only content-validation evidence. It names the exact Node
/// revision and validation-task revision observed by its producer. Reports do
/// not edit Node, mint an authorship stamp, or fire node-written events. A
/// late report for revision N stays historical when live content reaches N+1.
model NodeContentValidationReport {
  id                   String                       @id @default(cuid())
  nodeId               String                       @map("node_id")
  /// Snapshot of the holding memory, so a later cross-memory move cannot
  /// disclose this report to a reader of only the new memory.
  memoryId             String                       @map("memory_id")
  nodeRevSeq           Int                          @map("node_rev_seq")
  /// Stable Node.id values rather than FKs: task deletion preserves history.
  validationTaskId     String                       @map("validation_task_id")
  validationTaskRevSeq Int                          @map("validation_task_rev_seq")
  outcome              NodeContentValidationOutcome
  reportedAt           DateTime                     @default(now()) @map("reported_at")
  /// Optional producer-run identity for idempotent insertion by #1332.
  runId                String?                      @unique @map("run_id")

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, nodeRevSeq, reportedAt], map: "node_validation_node_rev_reported_idx")
  @@index([memoryId])
  @@map("node_content_validation_reports")
}

/// Temporary record holding an encrypted API key for a newly
/// provisioned workspace, consumed during first-time setup. The raw
/// key is the `hdr_app_<…>` value, shown once via `/setup/info`.
model PendingSetup {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  /// The workspace's App; ON DELETE CASCADE.
  appId           String   @map("app_id")
  /// AES-256-GCM-encrypted raw API key.
  rawKeyEncrypted String   @map("raw_key_encrypted")
  consumed        Boolean  @default(false)
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  app  App  @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("pending_setups")
}

/// A connected email mailbox (identity record). Provider state — refresh
/// tokens, Graph subscriptions — lives in the provider capability tool
/// (hadrontool-ms-exchange, #396); mail operations route through
/// src/lib/emailClient.ts using `toolConnectionId`.
model ExchangeConnection {
  id                    String     @id @default(cuid())
  organizationId        String     @map("organization_id")
  userId                String     @map("user_id")
  /// The mailbox/account email address; (organizationId, provider,
  /// mailboxEmail) is unique — provider-scoped so a calendar connection
  /// (provider 'google-cal') for the same Google account COEXISTS with its
  /// mail connection instead of overwriting it (PR-638 Codex P1).
  mailboxEmail          String     @map("mailbox_email")
  displayName           String?    @map("display_name")
  /// Email provider backing this connection — the emailClient dispatch key
  /// (#396: one capability tool per provider; 'ms-exchange' today).
  provider              String     @default("ms-exchange")
  /// The provider tool's connection id. NULL only for legacy rows whose
  /// token hasn't been transferred yet (scripts/admin-transfer-exchange-tokens.ts).
  toolConnectionId      String?    @map("tool_connection_id")
  /// LEGACY (#396): AES-256-GCM-encrypted MS Graph refresh token, kept (NULL
  /// for new rows) only as the rollback path until the one-time core→tool
  /// transfer is verified; a follow-up migration drops it.
  refreshTokenEncrypted String?    @map("refresh_token_encrypted")
  /// Soft toggle — operator can pause sync without removing the
  /// connection.
  syncEnabled           Boolean    @default(true) @map("sync_enabled")
  syncStatus            SyncStatus @default(PENDING) @map("sync_status")
  lastSyncAt            DateTime?  @map("last_sync_at")
  /// Error message from the last failed sync.
  lastError             String?    @map("last_error")
  /// MS Graph change-notification subscription id.
  webhookSubscriptionId String?    @map("webhook_subscription_id")
  /// Subscription expiry — MS Graph webhooks are short-lived; the
  /// renewer cron job watches this column.
  webhookExpiresAt      DateTime?  @map("webhook_expires_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  createdBy             String?    @map("created_by")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  updatedBy             String?    @map("updated_by")
  deletedAt             DateTime?  @map("deleted_at")
  deletedBy             String?    @map("deleted_by")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionGrants ConnectionGrant[]

  @@unique([organizationId, provider, mailboxEmail])
  @@index([userId])
  // The email-events ingress resolves connections by the tool's id on every
  // inbound email — this lookup must be indexed (#396 Phase 4).
  @@index([toolConnectionId])
  @@map("exchange_connections")
}

/// User→App scoped delegation on a user-owned connection (spec-042 Track B,
/// #593; supersedes the deferred AgentEmailGrant). Lets a connection's OWNER
/// grant a specific App install scoped access (e.g. `mail.read`) to their
/// mailbox/calendar. Enforced in `requireEmailConnection` (owner OR live grant
/// covering the operation's scope).
///
/// - Grantee is the App INSTALL (`granteeAppId`), never the Agent — one Agent
///   in two Apps/orgs is two trust contexts (the Juno fixture).
/// - Owner-only create/revoke, no org-admin bypass. Revoke is a SOFT delete;
///   liveness lookups use `findFirst` + `deletedAt: null` (never `findUnique`).
/// - Cross-org is intended: connection org and grantee-App org may differ; the
///   grant row is the sole authority.
/// - Multiple live grants per (connection, App) are valid — union-of-scopes —
///   so there is deliberately no unique constraint on the pair.
model ConnectionGrant {
  id              String    @id @default(cuid())
  connectionId    String    @map("connection_id")
  /// The App install this grant delegates to (the grantee = `ctx.appId`).
  granteeAppId    String    @map("grantee_app_id")
  /// The connection owner who created the grant (owner-only create).
  grantedByUserId String    @map("granted_by_user_id")
  /// Operation scopes covered — subset of {mail.read, mail.send,
  /// calendar.freebusy, calendar.read}. See src/lib/emailOperationScopes.ts.
  scopes          String[]  @default([])
  /// Optional expiry; NULL = perpetual until revoked.
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  deletedBy       String?   @map("deleted_by")

  connection ExchangeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  granteeApp App                @relation("AppConnectionGrants", fields: [granteeAppId], references: [id], onDelete: Cascade)
  grantedBy  User               @relation("ConnectionGrantsByUser", fields: [grantedByUserId], references: [id], onDelete: Cascade)

  // Composite on the gate's hot lookup (connectionId + granteeAppId). The
  // connectionId-leading order still serves the ExchangeConnection cascade
  // delete, so no separate single-column index is needed (PR-599 review).
  @@index([connectionId, granteeAppId])
  @@index([granteeAppId])
  @@index([grantedByUserId])
  @@map("connection_grants")
}

/// An individual action grant — the ADDITIVE half of the grant model
/// (design:grant-model; evaluated by @hadron-memory/access-control as a
/// PrincipalGrantLike). Hands one principal extra management actions
/// within one organization WITHOUT changing their OrgMember role: the
/// gate's effective allow-set is union(role bundle, live grants).
/// Multiple live grants per (principal, org) are valid = union-of-actions
/// (no unique constraint — the ConnectionGrant precedent). Revocation is
/// soft delete; expiry optional (NULL = perpetual). Liveness (deletedAt +
/// expiresAt) is filtered IN the gate's query, never after it.
model PrincipalGrant {
  id             String    @id @default(cuid())
  /// 'USER' (v1). Reserved for future app/agent principals.
  principalType  String    @default("USER") @map("principal_type")
  /// The granted user (v1: principalType='USER').
  principalId    String    @map("principal_id")
  organizationId String    @map("organization_id")
  /// Allowed actions — the access-control matcher grammar: exact
  /// ('memory.clone'), prefix ('memory.*'), or '*'.
  actions        String[]  @default([])
  /// Optional expiry; NULL = perpetual until revoked.
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  principal    User         @relation("UserPrincipalGrants", fields: [principalId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Composite on the gate's hot lookup (principal + org); principal-leading
  // order also serves the User cascade delete.
  @@index([principalId, organizationId])
  @@index([organizationId])
  @@map("principal_grants")
}

/// One Slack workspace install of the Hadron Slack app (spec 043).
/// Org-owned at WORKSPACE granularity (decision 1) — unlike the App-owned
/// TelegramConnection design and the user-owned ExchangeConnection.
/// `defaultAppId` names the Hadron App that serves /hadron commands from
/// this workspace; per-channel App overrides are a later binding table.
/// The tokens live ENCRYPTED IN THE TOOL (hadrontool-slack) — core stores
/// identity only, and no token ever appears in a GraphQL field.
model SlackConnection {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  /// The Hadron App that serves commands from this workspace.
  defaultAppId     String    @map("default_app_id")
  /// The slackClient dispatch key ('slack' today).
  provider         String    @default("slack")
  /// The provider tool's connection id — the ops-call handle and the
  /// events-ingress resolution key.
  toolConnectionId String    @map("tool_connection_id")
  /// Slack workspace (team) id, e.g. "T0123456789".
  teamId           String    @map("team_id")
  teamName         String    @map("team_name")
  /// The bot's Slack USER id ("U…") — the sender on messages it posts.
  botUserId        String    @map("bot_user_id")
  /// The bot's BOT id ("B…") — what bot message EVENTS carry as `bot_id`.
  /// Distinct from botUserId; the bridge loop filter needs BOTH (spec 043
  /// decision 8, PR #594 review). Don't "simplify" to one column.
  botId            String    @map("bot_id")
  /// 'ACTIVE' | 'ERROR' — mirrors the tool's connection-status vocabulary
  /// (there is no sync loop here, so SyncStatus does not apply).
  status           String    @default("ACTIVE")
  /// Error message from the last permanent provider failure.
  lastError        String?   @map("last_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultApp   App          @relation(fields: [defaultAppId], references: [id], onDelete: Cascade)

  // The slack-events ingress resolves connections by the tool's id on every
  // inbound event — the routing key must be 1:1, so this is UNIQUE (PR #600
  // review): two rows sharing a tool id would make dispatch ambiguous and
  // risk cross-org misdelivery. Every registration mints a fresh tool id,
  // so soft-deleted history rows never collide.
  @@unique([toolConnectionId])
  // One LIVE connection per (org, workspace) — enforced by the PARTIAL
  // unique index `slack_connections_org_team_active_uniq WHERE deleted_at
  // IS NULL` (raw SQL: the 043 migration + prisma/post-push.sql +
  // src/test/globalSetup.ts, which must stay in sync). Prisma's @@unique
  // would be non-partial and make a soft-deleted row block workspace
  // re-registration forever — the apps_urn_active_uniq precedent.
  @@index([organizationId, teamId])
  @@index([defaultAppId])
  @@map("slack_connections")
}

/// Envelope-dedupe receipts for the at-least-once Slack events ingress
/// (spec 043 decision 5): the tool's persist-before-ack inbox may deliver
/// an event more than once (a crash between core's 2xx and the tool's row
/// delete), so dispatch INSERTs here first and drops duplicates on
/// conflict. `connectionId` is the TOOL's connection id — dedupe runs
/// before resolution, so no FK by design.
model SlackEventReceipt {
  id           String   @id @default(cuid())
  connectionId String   @map("connection_id")
  envelopeId   String   @map("envelope_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([connectionId, envelopeId])
  @@index([createdAt])
  @@map("slack_event_receipts")
}

/// Core-owned routing/audit binding for a sidecar-owned webfetch poll job.
/// Poll state, scheduling, snapshots, and credentials remain in the sidecar;
/// this immutable snapshot answers which already-authorized run principal an
/// at-least-once event may wake.
model WebFetchPollBinding {
  jobId              String    @id @map("job_id")
  sourceRunId        String    @map("source_run_id")
  organizationId     String    @map("organization_id")
  appId              String    @map("app_id")
  agentId            String?   @map("agent_id")
  userId             String?   @map("user_id")
  entryNodeUrn       String    @map("entry_node_urn")
  policy             Json?
  /// The resolved `Secret` row a credentialed poll used (#677 — audit
  /// provenance; supersedes the #628 credentials_node_urn node scheme).
  credentialSecretId String?   @map("credential_secret_id")
  /// Query- and fragment-free URL for audit/event-origin validation.
  url                String
  cancelledAt        DateTime? @map("cancelled_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  sourceRun AppRun @relation("WebFetchPollSourceRun", fields: [sourceRunId], references: [id], onDelete: Cascade)

  @@index([organizationId, appId, cancelledAt])
  @@index([sourceRunId])
  @@map("webfetch_poll_bindings")
}

/// Durable completed-dispatch receipt for the at-least-once webfetch event
/// ingress. An absent snapshot hash is represented by the empty string so the
/// compound unique key remains effective under Postgres NULL semantics.
model WebFetchEventReceipt {
  id           String   @id @default(cuid())
  jobId        String   @map("job_id")
  snapshotHash String   @default("") @map("snapshot_hash")
  kind         String
  routedRunId  String   @map("routed_run_id")
  createdAt    DateTime @default(now()) @map("created_at")

  routedRun AppRun @relation("WebFetchEventRoutedRun", fields: [routedRunId], references: [id], onDelete: Cascade)

  @@unique([jobId, snapshotHash, kind])
  @@index([createdAt])
  @@index([routedRunId])
  @@map("webfetch_event_receipts")
}

/// Registered EXTERNAL MCP server — the org-scoped registry behind the
/// hadrontool-mcp conduit (headless runs calling third-party MCP tools).
/// The conduit tool is stateless and Hadron-blind (cor:int:030:01); core
/// owns identity, governance, and the encrypted static headers. A run
/// reaches a server's tool via the run-tool name `mcp__<slug>__<tool>`,
/// and every call is gated by the policy chain as `tool.mcp__<slug>__<tool>`
/// plus the run's action budget — this row grants nothing by itself.
model McpServer {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  /// Run-tool name segment (`mcp__<slug>__<tool>`); lowercase [a-z0-9-],
  /// unique per org. Keep it short — provider tool-name caps are ~64 chars.
  slug             String
  name             String
  /// Streamable-HTTP MCP endpoint URL. The conduit refuses private-network
  /// hosts unless explicitly allowed (SSRF guard, dev only).
  url              String
  /// AES-256-GCM-encrypted JSON object of static request headers
  /// (src/lib/tokenCrypto.ts), e.g. {"Authorization":"Bearer ..."} —
  /// v1 auth posture (no OAuth). WRITE-ONLY on the API surface: resolvers
  /// expose only a hasHeaders boolean, never the value.
  headersEncrypted String?  @map("headers_encrypted")
  /// Exposed-tool allowlist; empty = every tool the server advertises.
  toolAllowlist    String[] @default([]) @map("tool_allowlist")
  /// Disabled servers fail run-tool resolution loud (unknown tool), same
  /// posture as an unregistered slug.
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  createdBy        String?  @map("created_by")
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedBy        String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Hard delete by design: a registry row is config, not audit history —
  // deleting one makes referencing runs fail their hop loud, which is the
  // wanted signal. No deletedAt ⇒ a plain (non-partial) unique works.
  @@unique([organizationId, slug], map: "mcp_servers_org_slug_uniq")
  @@map("mcp_servers")
}

/// One named, owner-scoped secret — the general secret store (#677).
/// Polymorphic owner (`user` | `org` | `app` | `memory`) — deliberately no
/// FK: entitlement is checked at resolution time under the caller/run
/// principal, and a dangling owner simply never resolves. A bare name
/// resolves via the CSS cascade, most-specific-first: memory → app → user
/// → org. `kind` is extensible (`generic` opaque; `webfetch-auth` typed:
/// metadata `{ type, urlPrefix }`, origin-bound at use).
model Secret {
  id             String   @id @default(cuid())
  ownerType      String   @map("owner_type") // 'user' | 'org' | 'app' | 'memory'
  ownerId        String   @map("owner_id")
  /// Cascade-resolution key; unique per owner; lowercase [a-z0-9-], max 64.
  name           String
  kind           String
  /// The NON-secret, inspectable half — safe on every read surface. A
  /// reader can see THAT a secret exists and (webfetch-auth) WHERE it
  /// applies without decrypting.
  metadata       Json     @default("{}")
  /// encryptToken(JSON.stringify(payload)) — AES-256-GCM under the platform
  /// key (src/lib/tokenCrypto.ts). NEVER selected into a read surface:
  /// redaction by construction, same as the aiConfig / HA / Resend / MCP
  /// registries. Rotation is overwrite (updateSecret), no versioning (v1).
  valueEncrypted String   @map("value_encrypted")
  /// Key-rotation lineage headroom; unused (null) while HADRON_ENCRYPTION_KEY
  /// is the only key.
  keyId          String?  @map("key_id")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String?  @map("created_by")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedBy      String?  @map("updated_by")

  // Hard delete by design (registry-row posture): a deleted secret makes
  // referencing runs fail their resolution loud — the wanted signal.
  // The unique doubles as the (ownerType, ownerId) lookup index.
  @@unique([ownerType, ownerId, name], map: "secrets_owner_name_uniq")
  @@map("secrets")
}

/// One registered Home Assistant instance — the org-scoped registry behind
/// the hadrontool-home-assistant capability tool (hadron-server#640). Same
/// posture as McpServer: the row grants nothing by itself (every run-time
/// call walks the policy chain as `tool.ha__<slug>__<op>` + action budget),
/// hard delete by design, slug immutable because flow nodes reference it
/// inside data.tools names.
model HomeAssistantInstance {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// Run-tool name segment (`ha__<slug>__<op>`); lowercase [a-z0-9-],
  /// unique per org. Keep it short — provider tool-name caps are ~64 chars.
  slug           String
  name           String
  /// Home Assistant base URL (e.g. https://ha.example.com or a Nabu Casa
  /// remote URL). The tool refuses private-network hosts unless its
  /// HA_TOOL_ALLOW_PRIVATE_NETWORKS flag is set (self-hosted posture).
  url            String
  /// AES-256-GCM-encrypted long-lived access token
  /// (src/lib/tokenCrypto.ts). WRITE-ONLY on the API surface: resolvers
  /// never return it; update replaces it.
  tokenEncrypted String   @map("token_encrypted")
  /// Exposed-op allowlist over the closed HA_OPS catalog; empty = every op.
  /// Lets an admin register a READ-ONLY instance (no call_service).
  opAllowlist    String[] @default([]) @map("op_allowlist")
  /// Disabled instances fail run-tool resolution loud (unknown tool), same
  /// posture as an unregistered slug.
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String?  @map("created_by")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedBy      String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug], map: "home_assistant_instances_org_slug_uniq")
  @@map("home_assistant_instances")
}

/// One BYO Resend sender for an organization. Core owns and encrypts the API
/// key; the stateless hadrontool-resend sidecar receives it only for an
/// already-authorized send. One sender per org keeps credential selection
/// deterministic and outside model control.
model ResendSender {
  id              String   @id @default(cuid())
  organizationId  String   @unique(map: "resend_senders_organization_id_uniq") @map("organization_id")
  /// Fixed sender identity accepted by Resend, e.g.
  /// `Hadron Agent <agent@example.com>`. Not secret.
  fromAddress     String   @map("from_address")
  /// AES-256-GCM-encrypted Resend sending-access API key
  /// (src/lib/tokenCrypto.ts). WRITE-ONLY on the API surface.
  apiKeyEncrypted String   @map("api_key_encrypted")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String?  @map("created_by")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("resend_senders")
}

/// Pre-launch waitlist signup capture from the marketing site. Holds
/// an email plus an optional free-form "what features would you most
/// want?" answer. Not connected to User (signups happen before the
/// user has an account).
model WaitingListItem {
  id                String   @id @default(cuid())
  email             String
  requestedFeatures String?  @map("requested_features")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("waiting_list")
}

// ─── Multi-user agent: Apps ────────────────────────────────────────────

/// **The runtime deployment of an Agent in some Organization** — what
/// someone installs when they pick an Agent off the marketplace (or
/// install one from their own org). Holds credentials, surfaces,
/// optional AI override, members, and per-deployment memory pivots.
/// Per Constitution Technology Invariant #6, this is also the unified
/// caller-identity entity that authenticates against the Hadron platform.
///
/// Per (org, Agent) install: typically one App per pair. Multi-install
/// of the same Agent across orgs is supported and explicitly isolates
/// app- and personal-class memory at `(app_id, …)` keys.
///
/// **Auth credentials** live on AppKey rows (one or many per App,
/// independently revocable). The wire-token prefix `hdr_app_` and the
/// `appKey` developer-facing identifier are deliberately preserved by
/// 008 — there is no rename.
///
/// 008-agent-installation drops the `AppAgent` join: an App now
/// references its Agent directly via `agentId`. The legacy
/// OPERATE/DEVELOP role distinction is removed (system memory is
/// universally read-only from any App context — DEVELOP-from-App is
/// gone per R-10).
///
/// **Cascade behavior**: hard App deletion cascades to AppKey,
/// AppLogEntry, AppMember, and the App's `app`/`personal`-class Memory
/// rows. The orphan-retention behavior in 008 FR-015 (personal memory
/// survives an AppMember removal) is independent — it's a row delete
/// in `app_members`, not in `apps`.
model App {
  id                                String               @id @default(cuid())
  /// Display name.
  name                              String
  /// App-layer action-policy link (cor:acl:040:02) — same allow-list shape
  /// as Organization.policy; NULL = no restriction. Org-admin-authored
  /// (updateApp). Snapshotted into AppRun.policy at mint.
  policy                            Json?
  /// Globally unique identifier; derived from `org.urn + ":" + slug`.
  ///
  /// **Spec 021 (FR-027) — uniqueness is now PARTIAL.** The DB-level
  /// constraint is `apps_urn_active_uniq WHERE uninstalled_at IS NULL`
  /// (declared in the 021 migration). The same URN can legitimately
  /// appear on multiple rows: one active (`uninstalledAt IS NULL`)
  /// plus N uninstalled history rows. Prisma's field-level `@unique`
  /// declaration was REMOVED because it would generate a non-partial
  /// global unique index that fights with the migration.
  ///
  /// Callers MUST use `findFirst({ where: { urn, uninstalledAt: null } })`
  /// for active-row resolution per FR-028 resolution precedence; the
  /// `findUnique` callers in `resolvers.ts` were migrated to this
  /// pattern in PR #124.
  urn                               String
  organizationId                    String?              @map("organization_id")
  /// User owner of a user-owned App (rooted on the bare `<handle>` — #697 v2, no
  /// `@` sigil). The org/owner XOR is ENFORCED — `chk_app_owner_xor` in
  /// post-push.sql: `(organization_id IS NULL) <> (owner_user_id IS NULL)` — so
  /// exactly one of `organizationId`/`ownerUserId` is non-null.
  ownerUserId                       String?              @map("owner_user_id")
  ownerUser                         User?                @relation("AppOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createUserPermission              CreateUserPermission @default(EXPLICIT) @map("create_user_permission")
  identifyUserMethod                IdentifyUserMethod   @default(USER_ID) @map("identify_user_method")
  sessionTimeoutSeconds             Int                  @default(900) @map("session_timeout_seconds")
  /// Ruling DY-5: days of no activity after which a lapsed worker session of
  /// this App is DORMANT. No agent act resumes a dormant session (DA/DY-1);
  /// only an explicit rebind by its human holder brings the worker back. The
  /// security half of Holger's session-lifetime principle: a long-forgotten
  /// session must not start acting again on its own.
  sessionDormancyDays               Int                  @default(90) @map("session_dormancy_days")
  /// Ruling DY-3: whether `startAgentSession` stamps a hard `expiresAt` by
  /// default. False = this App's agent sessions have NO hard expiry unless the
  /// call asks for one (a caller-supplied `sessionTimeoutSeconds`, still capped
  /// by the App ceiling). A forgotten one is still bounded: past the App's
  /// `sessionDormancyDays` it no longer binds (`bindSession`, DY-5).
  agentSessionsExpire               Boolean              @default(true) @map("agent_sessions_expire")
  anonymousTtlDays                  Int                  @default(7) @map("anonymous_ttl_days")
  /// cor:agt:080:05 — the App's ticker settings (one set per App), changed only
  /// by whoever manages the App. Bounds are enforced in the write
  /// (`TICKER_SETTINGS_OUT_OF_RANGE`) and pinned by CHECK
  /// `chk_apps_ticker_settings` (prisma/ticker-invariants.sql).
  /// The cadence floor, also the wake-rate ceiling: >= 60.
  tickerMinCadenceSeconds           Int                  @default(120) @map("ticker_min_cadence_seconds")
  /// #2025 / cor:agt:080:05 — Proposed bounds: 1..86400 whole seconds.
  deliveryBusyDelaySeconds          Int                  @default(600) @map("delivery_busy_delay_seconds")
  /// Proposed bounds: 1..604800; strictly greater than busy delay + cadence floor.
  deliveryStuckWindowSeconds        Int                  @default(900) @map("delivery_stuck_window_seconds")
  /// Stored OFF; enabling is refused until #2023 supplies standby behavior.
  deliveryStandbyEnabled            Boolean              @default(false) @map("delivery_standby_enabled")
  /// #2138 §3.2 — a worker with a task is expected to check its team channel every period (seconds);
  /// the team ticker's cadence is set together with it.
  deliveryCheckPeriodSeconds        Int                  @default(600) @map("delivery_check_period_seconds")
  /// #2138 §3.2 — OVERDUE after this many missed periods (+5 min slack, hard-coded); at least 1.
  deliveryFailedChecksToOverdue     Int                  @default(2) @map("delivery_failed_checks_to_overdue")
  /// #2755 — a worker's unacknowledged due wake raises the dark-worker alarm after this many seconds (300..86400;
  /// default 1800). Not `deliveryStuckWindowSeconds` (deprecated, cor:agt:050:26's window).
  deliveryDarkAlarmWindowSeconds    Int                  @default(1800) @map("delivery_dark_alarm_window_seconds")
  /// #2138 §3.6 — a TEAM pause, separate from every worker's own `pausedUntil`: a worker cannot lift
  /// it, and ending it never clears a self-pause. NULL = not paused.
  teamPausedAt                      DateTime?            @map("team_paused_at")
  /// #2138 §3.6 — when the last team pause ENDED; restarts every worker's check clock (the status is not OVERDUE the moment a pause lifts). NULL = never paused.
  teamResumedAt                     DateTime?            @map("team_resumed_at")
  /// The fastest ticker a worker may subscribe ITSELF to: [floor, 86400].
  tickerSelfSubscribeCadenceSeconds Int                  @default(600) @map("ticker_self_subscribe_cadence_seconds")
  /// How many live tickers the App may have: [1, 100].
  tickerLiveCap                     Int                  @default(20) @map("ticker_live_cap")
  /// Null = derived (subscribed workers x (86400 / self-subscribe cadence) x 2).
  wakeDailyBudget                   Int?                 @map("wake_daily_budget")
  /// **Deprecated** — superseded by `surfaces`. Scheduled for removal
  /// in a follow-up cleanup spec (per 008 R-4); kept in place to
  /// avoid spurious portal churn.
  appType                           AppType              @default(WORKSTATION) @map("app_type")
  /// Default member role applied when the Agent's
  /// `installation_policy.memberRoles` doesn't apply.
  role                              AppMembershipRole    @default(READER)
  description                       String?
  /// Tools this App's agent can access; default `[]`.
  agentTools                        String[]             @default([]) @map("agent_tools")
  // 036-ai-service-config: the legacy ai_provider/ai_model/
  // ai_api_key_encrypted columns were dropped in favor of App-owned
  // AiServiceConfig rows (an App-owned config is the deploy-time override
  // that wins over the Agent's default in the resolution walk).
  expiresAt                         DateTime?            @map("expires_at")
  // 008-agent-installation introduced a direct App→Agent FK; 023-app-shape
  // Phase 2b dropped it in favor of the reintroduced N:M `AppAgent` join
  // (multi-Agent App per US1). The GraphQL `App.agentId` and `App.agent`
  // fields are kept as soft-deprecated convenience reads, resolved via
  // the first AppAgent row by helpers in `src/lib/appAgent.ts`.
  /// Migrated from the dropped `app_agents.training_mode`. Sessions
  /// through this App are flagged as training data for the Agent's
  /// owner to review. 008-agent-installation FR-022.
  trainingMode                      Boolean              @default(false) @map("training_mode")
  /// Free-form per 008 R-9; v1 known values: `'chat'`, `'slack'`,
  /// `'mcp'`, `'web'`. Surface enforcement (which features are gated
  /// on which surfaces) is handled by the portal/app code; chat-tab
  /// gating in hadron-portal#187 reads `surfaces.includes('chat')`.
  /// 008-agent-installation FR-014.
  surfaces                          String[]             @default(["chat"])
  // Standard audit fields
  createdAt                         DateTime             @default(now()) @map("created_at")
  createdBy                         String?              @map("created_by")
  updatedAt                         DateTime?            @updatedAt @map("updated_at")
  updatedBy                         String?              @map("updated_by")
  deletedAt                         DateTime?            @map("deleted_at")
  deletedBy                         String?              @map("deleted_by")

  /// Soft-uninstall timestamp per spec 021 FR-025. Null = active install;
  /// set = uninstalled (read-only, write-rejected with "app uninstalled"
  /// error including cascade to child agents/memories/nodes per FR-026).
  /// Reinstall after soft-uninstall is allowed via the partial unique index
  /// `apps_urn_active_uniq WHERE uninstalled_at IS NULL` (declared in the
  /// 021 migration; supersedes Prisma's @unique on urn at the DB level).
  uninstalledAt            DateTime? @map("uninstalled_at")
  /// Online URN-shape migration gate (spec 021 FR-032, repurposed for the #697
  /// v1→v2 emission flip; transient). Null = pre-normalization row (read
  /// through the legacy parser); set = row normalized onto the flat v2 form
  /// (`<root>:<slug>`, single colon). Dropped once 100% of rows are migrated.
  /// TODO(spec-021-cleanup): drop this column once the FR-032 migration
  /// completes — tracked under the spec-021 cleanup follow-up. The
  /// `apps_urn_migration_pending_idx` partial index goes with it.
  urnNormalizedAt          DateTime? @map("urn_normalized_at")
  /// Spec 021 sentinel for data-defect rows during the FR-032 migration.
  /// Non-null = the row's urn failed normalization; the migration job
  /// skips it on subsequent passes (avoids infinite retry). Transient;
  /// dropped with urnNormalizedAt.
  /// TODO(spec-021-cleanup): drop alongside urnNormalizedAt.
  urnMigrationFailedReason String?   @map("urn_migration_failed_reason")
  /// #697 stored alias map: the pre-v2 (v1) URN this row was migrated FROM
  /// (see Memory.legacyUrn). Null until the online migration flips `urn` to v2.
  legacyUrn                String?   @map("legacy_urn")

  organization            Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 023-app-shape Phase 2b: App↔Agent is N:M through AppAgent. The
  // direct `agent` relation is gone (dropped with `agentId`).
  appAgents               AppAgent[]
  /// #974 — this App's STAFF: the named castings of installed agents
  /// (cor:dmo:050:11). Distinct from `appAgents`: the roster join says an
  /// Agent is installed here; a Worker is who, by name, does attributable
  /// work.
  workers                 Worker[]
  /// #1705 — the App's agent tasks and their append-only event stream.
  agentTasks              AgentTask[]
  agentTaskCounters       AgentTaskCounter[]
  /// #1747 — tickers (cor:agt:080) and the grants held by this App's workers.
  tickers                 Ticker[]
  appGrants               AppGrant[]
  wakeDays                AppWakeDay[]
  wakeReservations        AppWakeReservation[]
  agentTeamEvents         AgentTeamEvent[]
  darkWorkerEpisodes      DarkWorkerEpisode[]
  postLimitEpisodes       PostLimitEpisode[]
  automationAdoptionEvents AutomationAdoptionEvent[]
  /// #2484 — this App's prefix-scoped write grants for its userless runs, and their append-only history.
  memoryWriteGrants       AppMemoryWriteGrant[]
  memoryWriteGrantEvents  AppMemoryWriteGrantEvent[]
  /// #1706 — model-family availability (cor:agt:060:03) and the stall schedule.
  modelFamilyAvailability ModelFamilyAvailability[]
  agentTaskStallSchedule  AgentTaskStallSchedule?
  /// #1707 — hosts that registered which workers they can launch (cor:agt:070:01).
  hostRegistrations       HostRegistration[]
  hostOperations          HostOperation[]
  /// #2162 — the context resets of this App's workers.
  contextResets           ContextReset[]
  /// #2022 (S6, cor:agt:090) — the App's stop signals, live and ended.
  stopSignals             TeamStopSignal[]
  stopConsumerDeclarations StopConsumerDeclaration[]
  launchGrants            LaunchGrant[]
  /// #1956 — resume claims written before a deliberate context reset (cor:agt:020:03).
  resumeClaims            ResumeClaim[]
  sessionEndRequests      TaskSessionEndRequest[]
  mcpSessionStates        McpSessionState[]
  scopes                  Scope[]
  registerEntries         RegisterEntry[]           @relation("RegisterOwnerApp")
  readStates              ChannelReadState[]        @relation("ReadStateApp")
  /// Spec 049 Phase 4 (D-2026-09-13-007 D2): the App's DEFAULT Channel — the row the
  /// team chat became, what `teamChatMessages(appRef)` addresses and what an
  /// installed Agent's default register row points at. Set at App creation
  /// (`ensureDefaultChannel`) and by the Phase 4 backfill (the OLDEST live
  /// `chats:team` root, the resolver's own ordering). A nullable FK rather than a
  /// flag on the Channel: two defaults per App would be a state no CHECK refuses.
  defaultChannelId        String?                   @unique @map("default_channel_id")
  defaultChannel          Channel?                  @relation("AppDefaultChannel", fields: [defaultChannelId], references: [id], onDelete: SetNull)
  keys                    AppKey[]
  members                 AppMember[]
  memories                Memory[]                  @relation("AppMemories")
  users                   User[]
  sessions                Session[]
  logEntries              AppLogEntry[]
  usageEvents             UsageEvent[]
  pendingSetups           PendingSetup[]
  aiServiceConfigs        AiServiceConfig[]
  modelGroups             ModelGroup[]
  automationVersions      AutomationVersion[]
  connectionGrants        ConnectionGrant[]         @relation("AppConnectionGrants")
  slackConnections        SlackConnection[]
  memoryConfigTemplates   MemoryConfigTemplate[]

  @@index([organizationId])
  // Spec 021 FR-027: keep `urn` lookups index-served. The DB-level
  // partial unique index `apps_urn_active_uniq` already covers active-row
  // queries; this @@index makes lookups across the full history (active
  // + uninstalled) also index-served. Prisma generates a non-unique
  // btree index on `urn`.
  @@index([urn])
  @@index([ownerUserId])
  @@index([legacyUrn])
  @@map("apps")
}

/// An API key for an App, independently revocable; multiple keys per
/// App. The raw key carries the canonical `hdr_app_` prefix and is
/// shown once at creation; only the SHA-256 hash is stored. (SHA-256,
/// not bcrypt — bcrypt's per-hash salt would prevent the
/// constant-time keyHash lookup the auth resolver does. The raw key
/// is a 256-bit random value, so dictionary attacks against the hash
/// are not a concern.)
///
/// **Auth path**: the resolver at `src/middleware/auth.ts` accepts
/// `hdr_app_`-prefixed bearer tokens, looks up the AppKey by SHA-256
/// hash, and resolves the principal to the parent App. Memory access
/// is then gated by `src/mcp/access-control.ts`, which reads
/// `App.agentId` directly (the legacy AppAgent join was dropped in
/// 008-agent-installation) and folds the Agent's `systemMemoryId` +
/// `memoryItems` into the access map.
///
/// **Client config field**: hadron-client reads the AppKey value from
/// the `appKey` field of `.hadron/config.json`. The env var name
/// `HADRON_CLIENT_KEY` describes location (the client process), not
/// the entity.
model AppKey {
  id         String    @id @default(cuid())
  appId      String    @map("app_id")
  /// SHA-256 hash of the raw `hdr_app_<…>` key.
  keyHash    String    @unique @map("key_hash")
  /// Last 4 characters of the raw key for masked display.
  keyPreview String    @map("key_preview")
  /// Human-friendly name for this key.
  label      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  app      App              @relation(fields: [appId], references: [id], onDelete: Cascade)
  scopes   AppKeyScope[]
  reads    AppKeyWakeRead[]
  hostUses HostKeyUse[]

  @@index([appId])
  @@map("app_keys")
}

/// The User↔App membership join with a per-member role. Spec:
/// 008-agent-installation FR-004.
///
/// **Per-User lifecycle is reserved for a future spec** — there is no
/// `revokedAt` / `expiresAt` column. Removing a member is a row delete;
/// the user's personal-class Memory at `(app_id, user.id)` is
/// **retained by default** as an orphan (FR-015) and re-attaches
/// automatically if the user later rejoins the *same* App.
///
/// **No deletedAt** — soft-delete is meaningless for a pure join.
// 008-agent-installation (2026-05-02): User↔App membership join.
// Per-User lifecycle is reserved for a future spec — there is no
// revoked_at / expires_at column. Removing a member is a row delete.
// The user's personal-class Memory at (app_id, user.id) survives the
// row delete (orphan retention per FR-015).
model AppMember {
  appId     String    @map("app_id")
  userId    String    @map("user_id")
  // Free-form string per R-7. Validated at write-time against the parent
  // Agent's installation_policy.memberRoles (e.g., ['owner', 'guide']).
  /// Free-form string validated at write-time against the parent
  /// Agent's `installation_policy.memberRoles` (per 008 R-7). Examples:
  /// `'owner'`, `'guide'`, `'cook'`. `installation_policy.maxMembers`
  /// is enforced at invite-acceptance time (per FR-016).
  role      String
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  app  App  @relation(fields: [appId], references: [id], onDelete: Cascade)
  user User @relation("UserAppMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([appId, userId])
  @@index([userId])
  @@map("app_members")
}

/// The Org↔Agent license — authorizes an Org to (a) create Apps that
/// deploy this Agent, and (b) bundle this Agent in `AgentImport` edges
/// of Agents the Org owns. Spec: 008-agent-installation FR-006 / R-2.
///
/// Sibling to `AgentSubscription` (User↔Agent, from 005). Both share
/// the lifecycle field shape (`activatedAt`, `expiresAt`, `revokedAt`,
/// `revokedBy`) and the same active-status predicate. The two-table
/// split (rather than a polymorphic `subjectType` + `subjectId`)
/// preserves typed FK integrity and per-table indexing clarity.
///
/// For **same-org installs** (an Org deploying its own Agent), the
/// grant is auto-provisioned by `ensureAgentOrgGrant` on first
/// contact. **Cross-org installs** require an existing active grant;
/// PUBLIC Agents can be subscribed to through createAgentOrgGrant.
///
/// **No deletedAt** — soft-delete is redundant with the
/// `revokedAt` lifecycle.
///
/// **Active-status predicate** (shared with `AgentSubscription` via
/// the `isLifecycleActive` helper):
///
///     activatedAt IS NOT NULL
///       AND revokedAt IS NULL
///       AND (expiresAt IS NULL OR expiresAt > now())
// 008-agent-installation (2026-05-02): Org↔Agent license. Authorizes
// (a) creating an App in org_id that uses agent_id, and (b) bundling
// agent_id as an AgentImport in another Agent that org_id owns. Sibling
// to AgentSubscription (User↔Agent, from 005); shares the lifecycle
// shape and the isLifecycleActive predicate.
model AgentOrgGrant {
  orgId       String    @map("org_id")
  agentId     String    @map("agent_id")
  /// v1 default: `now()` on creation since billing is out of scope.
  activatedAt DateTime? @map("activated_at")
  expiresAt   DateTime? @map("expires_at")
  /// Set by an ADMIN/OWNER of the Agent's owning org via
  /// `revokeAgentOrgGrant`.
  revokedAt   DateTime? @map("revoked_at")
  /// fk to User.id — audit trail for who revoked.
  revokedBy   String?   @map("revoked_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  imports      AgentImport[]

  @@id([orgId, agentId])
  @@index([agentId])
  @@map("agent_org_grants")
}

/// A directed dependency edge between two Agents — "Agent A imports
/// Agent B as a dep." Spec: 008-agent-installation FR-005 / User Story 3.
///
/// Installing the parent (a row in `apps` with `agentId = parent`)
/// cascade-installs required deps (creates additional Apps in the
/// same org, one per dep). Optional deps install only if the caller
/// passes `installOptional`.
///
/// v1 enforces **1-level imports only** — the dep itself must NOT be
/// a parent of any AgentImport. Cycles are trivially blocked at write
/// time (`parentAgentId != importedAgentId`).
// 008-agent-installation (2026-05-02): directed Agent→Agent dependency
// edge. v1 enforces 1-level imports only (the dep itself must not be
// a parent of any AgentImport). The composite FK to AgentOrgGrant is
// the Builder-grant authorizing this import — the spec named this
// agent_subscription_id (FR-005); R-2 renamed it to the new sibling
// table since the universal-grant role lives on AgentOrgGrant for
// org-level grants, not AgentSubscription (which stays User↔Agent).
model AgentImport {
  /// The Agent that does the importing (the "Suite"). ON DELETE
  /// CASCADE.
  parentAgentId        String   @map("parent_agent_id")
  /// The dep Agent. ON DELETE RESTRICT — deleting it would
  /// invalidate every Suite that depends on it; operators must
  /// remove the import edge first.
  importedAgentId      String   @map("imported_agent_id")
  /// Sparse-int ordering (per 008 R-8). Builders set values like
  /// 100, 200, 300 to allow easy reordering without renumbering.
  position             Int
  /// Hard dep vs optional. Default `true`.
  required             Boolean  @default(true)
  /// Composite fk to `AgentOrgGrant(orgId, agentId)` (ON DELETE
  /// RESTRICT) — the Builder grant authorizing this import. Spec
  /// FR-005 named this column `agent_subscription_id`; renamed per
  /// 008 R-2 since the universal-grant role for org-level grants
  /// lives on the new `AgentOrgGrant` sibling, not `AgentSubscription`.
  agentOrgGrantOrgId   String   @map("agent_org_grant_org_id")
  agentOrgGrantAgentId String   @map("agent_org_grant_agent_id")
  createdAt            DateTime @default(now()) @map("created_at")
  createdBy            String?  @map("created_by")

  parentAgent   Agent         @relation("ParentAgent", fields: [parentAgentId], references: [id], onDelete: Cascade)
  importedAgent Agent         @relation("ImportedAgent", fields: [importedAgentId], references: [id], onDelete: Restrict)
  agentOrgGrant AgentOrgGrant @relation(fields: [agentOrgGrantOrgId, agentOrgGrantAgentId], references: [orgId, agentId], onDelete: Restrict)

  @@id([parentAgentId, importedAgentId])
  @@unique([parentAgentId, position]) // prevents two imports at the same position under the same parent
  @@index([importedAgentId])
  @@map("agent_imports")
}

/// The User-side license: "this user is authorized to use this agent."
/// Auto-provisioned on first user-attributed contact (per
/// `controller/operations/ensureAgentSubscription.ts`); revocable by
/// an ADMIN/OWNER of the Agent's owning org. Authorizes the cross-org
/// write from the Agent into the user's *personal*-class Memory.
///
/// Sibling to `AgentOrgGrant` (Org↔Agent, added in
/// 008-agent-installation). Both share the lifecycle field shape and
/// the same `isLifecycleActive` predicate; AgentSubscription
/// continues to express User↔Agent grants while AgentOrgGrant covers
/// Org↔Agent (App-creation + import-bundling) grants.
///
/// Spec: 005-agent-subscription (2026-04-30). Composite primary key
/// on `(userId, agentId)`.
///
/// **No deletedAt** — soft-delete is redundant with `revokedAt`.
///
/// **Active-status predicate** (used by the access-resolver):
///
///     activatedAt IS NOT NULL
///       AND revokedAt IS NULL
///       AND (expiresAt IS NULL OR expiresAt > now())
///
/// **Revocation behavior** (per FR-028 / FR-029): when revoked, the
/// user's personal Memory of the Agent is **retained** by default —
/// the user owns it, may want to keep their notes after a class ends.
/// The Agent loses write access (per FR-019); the user retains read
/// access via direct authenticated queries. The
/// `Memory.userMemoryOfAgentId` pivot is preserved so the memory
/// remains identifiable as "originally from Agent X." **Single
/// exception**: if the personal Memory has zero nodes at revocation
/// time, the platform may hard-delete it alongside the
/// AgentSubscription (avoids orphan accumulation).
// User-side license expressing "this user is authorized to use this agent."
// Auto-provisioned on first user-attributed contact (per
// `controller/operations/ensureAgentSubscription.ts`); revocable by an
// ADMIN/OWNER of the Agent's owning org. Spec: 005-agent-subscription
// (2026-04-30). Authorizes the cross-org write from the Agent into the
// user's personal-class Memory.
model AgentSubscription {
  userId      String    @map("user_id")
  agentId     String    @map("agent_id")
  // Lifecycle. v1 default: activatedAt = now() on creation. Future billing
  // work introduces a deferred-activation path (activatedAt = null until
  // payment confirms).
  /// v1 default: `now()` on creation since billing is out of scope;
  /// future billing introduces a deferred-activation path
  /// (activatedAt = null until payment confirms).
  activatedAt DateTime? @map("activated_at") @db.Timestamptz()
  /// Time-bounded subscriptions; NULL for non-expiring.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz()
  /// Set by an ADMIN/OWNER of the Agent's owning org via
  /// `revokeAgentSubscription`.
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz()
  /// fk to User.id — audit trail.
  revokedBy   String?   @map("revoked_by")
  // Standard audit fields. (No deletedAt — soft-delete is redundant with
  // the revokedAt lifecycle; if a row needs to truly disappear it's a
  // hard delete.)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy   String?   @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz()
  updatedBy   String?   @map("updated_by")

  user  User  @relation("UserAgentSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  agent Agent @relation("AgentUserSubscriptions", fields: [agentId], references: [id], onDelete: Cascade)

  @@id([userId, agentId])
  @@index([agentId])
  @@map("agent_subscriptions")
}

/// Log entry for a specific App, surfaced in hadron-portal for
/// troubleshooting.
model AppLogEntry {
  id        String    @id @default(cuid())
  appId     String    @map("app_id")
  level     LogLevel
  memoryId  String?   @map("memory_id")
  sessionId String?   @map("session_id")
  /// Human-readable log message.
  message   String
  /// Structured context.
  detail    Json?
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([appId, createdAt])
  @@index([level])
  @@index([createdAt])
  @@map("app_log")
}

// ─── 023-app-shape: multi-Agent App + per-Memory authorization ─────────

/// N:M join between `App` and `Agent`, reintroduced by spec 023.
///
/// **No `role` column** — system memory is read-only to every App
/// regardless (the pre-008 OPERATE/DEVELOP distinction stays deleted
/// per spec 023 FR-003). **No `trainingMode` column** — training mode
/// is a per-App setting and lives on `App.trainingMode` (spec 023
/// FR-001; deviates from the 2026-05-12-user-installing-app summary
/// §3 to avoid per-Agent conflicts on an App-wide setting).
///
/// **Transition note**: `App.agentId` was dropped and consumers
/// retrofitted in Phase 2b ([hadron-server#129](https://github.com/hadron-memory/hadron-server/pull/129),
/// 2026-05-17). Install flows go through the `installAgentIntoApp`
/// mutation (spec 023 US1, [hadron-server#130](https://github.com/hadron-memory/hadron-server/pull/130))
/// which writes an `AppAgent` row.
///
/// **Cascade behavior**: hard `App` or `Agent` deletion cascades to
/// the `AppAgent` row. Uninstalling an Agent from an App (deleting
/// the row) does NOT cascade-delete the (app_id, agent_id, *) memories
/// (FR-005; orphan retention preserved). Duplicate inserts for the
/// same (app_id, agent_id) are rejected by the composite PK.
model AppAgent {
  appId            String    @map("app_id")
  agentId          String    @map("agent_id")
  // Audit fields mirror AppMember (no soft-delete). Uninstall is a
  // hard row delete; predicate lookups use `findUnique` on the
  // composite PK with no filter.
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by")
  /// #2045 (S8, cor:agt:040:07) — the install's boot-prompt POINTER: the id of a
  /// compiled boot-prompt node (`nodeType = 'compiled-boot-prompt'`), never its
  /// source. NO foreign key: nodes are hard-deleted on some paths (deleteNode
  /// hard/subtree, memory merge, git-sync cleanup), and SET NULL would turn a
  /// deleted target (R27) into "no pointer" (R26) while RESTRICT would block
  /// those deletes. `bootPromptUrn` is the target's canonical URN at write time,
  /// read only when the row is gone; both are set or both NULL
  /// (chk_*_boot_prompt_pointer_pair, prisma/boot-prompt-pointer-invariants.sql).
  /// Written only through `setBootPromptPointer` (src/lib/bootPromptPointer.ts).
  /// The row is hard-deleted on uninstall, so a reinstall starts empty until
  /// the App's manager next compiles (cor:agt:040:06, cor:dmo:050:03).
  bootPromptNodeId String?   @map("boot_prompt_node_id")
  bootPromptUrn    String?   @map("boot_prompt_urn")

  app   App   @relation(fields: [appId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([appId, agentId])
  @@index([agentId])
  @@index([bootPromptNodeId])
  @@map("app_agents")
}

/// #974 — a **Worker**: the named casting of an installed Agent into an App
/// (cor:dmo:050:11, cor:agt:020:01). The Agent carries the reusable persona
/// dressing (`personaRole` and its compiled boot prompt); the Worker is the
/// local named identity ("Iris") that does attributable work. Casting is
/// opt-in (an installed agent with no Worker row is just an agent) and
/// requires the agent installed in the App at cast time; multiple Workers may
/// cast the SAME agent in one App (Iris and Henry, both `backend-engineer`).
///
/// **Name uniqueness**: unique per App, case-insensitively — the functional
/// unique `workers_app_name_uniq` on `(app_id, lower(name))` in post-push.sql
/// (Prisma cannot express functional uniques). Deliberately NOT filtered on
/// retirement: a name binds to one casting forever (cor:agt:020:02 — PR
/// trailers and chat archives reference it, and a recycled name would
/// silently re-attribute old work).
///
/// **Lifecycle**: workers RETIRE (`retiredAt`), never soft-delete — the row
/// must survive the agent's uninstall and keep resolving for history. There
/// is no `deletedAt`; the only removal escape is the hard delete of a
/// never-used miscast (no sessions ever bound, empty working memory).
/// `agentId` is `Restrict` so a referenced casting can never lose its agent
/// silently (agent deletion is soft everywhere; the hard-delete compensation
/// paths only ever remove agents without castings).
model Worker {
  id                String    @id @default(cuid())
  darkWorkerEpisodes DarkWorkerEpisode[]
  postLimitEpisodes PostLimitEpisode[]
  appId             String    @map("app_id")
  agentId           String    @map("agent_id")
  /// The worker's name ("Iris") — the identity every surface renders.
  name              String
  /// #991 — the URN atom: `hrn:worker:<root>:<app-slug>:<slug>`. DERIVED from
  /// `name` at cast time (`deriveSlugFromName`, then `-2`/`-3`… until free in
  /// the App) and permanent thereafter — there is no rename mutation, and the
  /// name it was derived from is itself permanent (cor:agt:020:02).
  ///
  /// This is a SECOND stored uniqueness (`workers_app_slug_uniq`), which
  /// cor:agt:020:02 otherwise forbids — the distinction that makes it legal is
  /// that it NEVER REFUSES: the mint iterates instead of erroring, so the name
  /// collision stays the single allocation primitive a caller can observe. That
  /// is exactly what the reverted mention-token unique (PR #979) did not do.
  /// The index exists so a race between two casts deriving one base slug cannot
  /// produce two workers sharing a URN.
  slug              String
  /// The cast-list role this filling answers ("backend-engineer").
  /// Free string with conventions; defaults to the agent's `personaRole`
  /// at cast time when the caller names none.
  role              String?
  /// Per-worker signature template, delivered through S4 (cor:agt:040:04).
  signature         String
  /// Per-worker commit trailer template, delivered through S4 (cor:agt:040:04).
  trailer           String
  /// #2045 (S8, cor:agt:040:07) — this worker's boot-prompt POINTER: the id of a
  /// compiled boot-prompt node (`nodeType = 'compiled-boot-prompt'`), never its
  /// source. NO foreign key: nodes are hard-deleted on some paths (deleteNode
  /// hard/subtree, memory merge, git-sync cleanup), and SET NULL would turn a
  /// deleted target (R27) into "no pointer" (R26) while RESTRICT would block
  /// those deletes. `bootPromptUrn` is the target's canonical URN at write time,
  /// read only when the row is gone; both are set or both NULL
  /// (chk_*_boot_prompt_pointer_pair, prisma/boot-prompt-pointer-invariants.sql).
  /// Written only through `setBootPromptPointer` (src/lib/bootPromptPointer.ts).
  /// Set for customised workers only, empty otherwise (cor:dmo:050:11).
  bootPromptNodeId  String?   @map("boot_prompt_node_id")
  bootPromptUrn     String?   @map("boot_prompt_urn")
  /// #974 — the worker-scoped working memory in the App's container
  /// (`hrn:mem:<owner>:<app-slug>:<worker-slug>`), provisioned at cast.
  /// Identity is THIS column, never the memory's URN (the #723 rule).
  memoryId          String?   @map("memory_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")
  /// #1050 — the HUMAN holding this name. A name is held by a person, not by a
  /// live session: expiry, a reap, or a closed chat session never free it, and
  /// only an explicit release does.
  ///
  /// This is what separates the two meanings of "taken" that used to share one
  /// word (hadron-cli#487). HELD = the name belongs to someone; the answer to a
  /// second person wanting it is to cast their own, never to adjudicate whether
  /// the first is "really gone". TAKEN = a live session exists, which is only
  /// ever a question about your OWN worker. Deriving availability from session
  /// liveness is what let an agent end a mid-PR driver's session and bind as
  /// them, every step following the documented procedure (hadron-cli#492).
  ///
  /// Nullable because a released worker is genuinely unheld — and because a
  /// worker cast before this column existed has a holder only by backfill from
  /// `createdBy`. The next bind of an unheld worker holds it.
  heldByUserId      String?   @map("held_by_user_id")
  /// When the current hold was taken — provenance for a release decision, and
  /// what an admin force-release reports.
  ///
  /// Both platform write paths (`releaseWorker`, `deleteUserAccount`) clear
  /// this together with `heldByUserId`, but the FK's ON DELETE SET NULL clears
  /// only the id, so a RAW hard delete of a user can leave a vestigial
  /// timestamp here. `Worker.heldAt` therefore masks it to null whenever there
  /// is no holder, so the API invariant — heldAt is set exactly when
  /// heldByUserId is — holds because it is enforced rather than remembered. A
  /// CHECK cannot do that job: it would make the FK's own SET NULL violate it.
  heldAt            DateTime? @map("held_at")
  /// Retirement instant — the name stays reserved forever (cor:agt:020:02).
  /// A retired worker stops authoring (team chat's worker-App pin checks
  /// retirement at post time) and refuses new session bindings.
  retiredAt         DateTime? @map("retired_at")
  retiredBy         String?   @map("retired_by")
  /// #1726 — the one Worker this worker reports to (Holger, 2026-10-09): a
  /// non-retired Worker of the same App, never itself, and never a cycle. Null
  /// reports to nobody (the top of a team, or an unclaimed worker). A property
  /// of the casting, not of a session: binding, rotating or ending a session
  /// leaves it alone. Written only by `src/lib/workers/reportsTo.ts`, which
  /// also appends the `worker.reports-to` event that keeps its history.
  reportsToWorkerId String?   @map("reports_to_worker_id")
  /// S12: explicit human choice; false + null reportsTo is UNSET, never inferred NO_TEAM.
  explicitNoTeam Boolean @default(false) @map("explicit_no_team")
  /// #2771 (proposed cor:agt:070:09) — the latest terminal report a HOST made for this worker, built by the server
  /// (`src/lib/workerTerminal.ts`): host {id,label}, status, prompt, reason (a closed code), lastTurnAt, checkedAt,
  /// reportedAt. Null until a host first reports. A stored report that DECIDES NOTHING: it feeds no `checkStatus`,
  /// availability, matcher, stall rule or alarm. No screen text is ever stored; `chk_workers_terminal_shape` (in
  /// prisma/host-operation-invariants.sql) allows exactly the keys above, so a write that bypasses the resolver still
  /// cannot store more. Read behind `maySeeWorkerInternals` (cor:dmo:050:11).
  terminal Json? @map("terminal")

  app                  App                       @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// SetNull: a worker row is never hard-deleted in normal operation, but an
  /// App cascade must not fail on the self-reference.
  reportsTo            Worker?                   @relation("WorkerReportsTo", fields: [reportsToWorkerId], references: [id], onDelete: SetNull)
  reports              Worker[]                  @relation("WorkerReportsTo")
  agent                Agent                     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  memory               Memory?                   @relation("WorkerMemory", fields: [memoryId], references: [id], onDelete: SetNull)
  /// SetNull, not Cascade: a deleted user's held names must be RELEASED, never
  /// take the castings (and their worklog and handoff history) with them.
  heldBy               User?                     @relation("WorkerHolder", fields: [heldByUserId], references: [id], onDelete: SetNull)
  sessions             Session[]                 @relation("SessionWorker")
  /// Spec 049 Phase 5 — register rows naming this Worker as the attendee.
  registerAttendeeOf   RegisterEntry[]           @relation("RegisterAttendeeWorker")
  readStates           ChannelReadState[]        @relation("ReadStateWorker")
  /// #1705 — agent tasks this worker owns / is assigned.
  ownedAgentTasks      AgentTask[]               @relation("AgentTaskOwnerWorker")
  assignedAgentTasks   AgentTask[]               @relation("AgentTaskAssigneeWorker")
  /// #1706 — availability for work (cor:agt:060:02).
  availability         WorkerAvailability?
  /// #1747 — ticker subscriptions, wake settings, delivery record, grants held.
  tickerSubscriptions  TickerSubscription[]
  wakeSettings         WorkerWakeSettings?
  deliveryChannels     WorkerDeliveryChannel[]
  deliveryTicks        WorkerDeliveryTick[]
  deliveryTaskEvents   WorkerDeliveryTaskEvent[]
  wakeAcks             WorkerWakeAck[]
  wakeReservation      AppWakeReservation?
  appGrants            AppGrant[]
  launchableVia        HostRegistrationWorker[]
  hostOperations       HostOperation[]
  /// #2162 — this worker's context resets (cor:agt:050:27).
  contextResets        ContextReset[]
  /// #2022 — worker- and team-scope stop signals naming this worker as target.
  stopSignalsTargeting TeamStopSignal[]

  /// The URN atom's uniqueness. Unfiltered on retirement, like
  /// `workers_app_name_uniq`: a retired worker's URN must keep resolving.
  @@unique([appId, slug], map: "workers_app_slug_uniq")
  @@index([appId])
  @@index([agentId])
  /// #1050 — "what does this person hold", across Apps.
  @@index([heldByUserId])
  @@index([reportsToWorkerId])
  @@index([bootPromptNodeId])
  @@map("workers")
}

/// Asymmetric cross-user grant for personal-class memory (spec 023
/// US3 / FR-017–FR-022). Composite PK `(memoryId, granteeId)` — one
/// row per (Memory, grantee).
///
/// **Scope**: applies ONLY to personal-class Memories (FR-018).
/// Application-layer guard in `createMemoryShare.ts` enforces this.
///
/// **Grantor semantics** (FR-019): `grantorId` is the **principal**
/// (`Memory.userId`), recorded explicitly so the row is
/// self-describing without a JOIN to `memories` at read time. The
/// API actor (which may be an App backend acting on the principal's
/// behalf) is recorded in `createdBy`.
///
/// **No time-window** (FR-021): isolation between grantees over time
/// is modeled by creating a new personal Memory per pairing — not by
/// time-slicing one Memory.
model MemoryShare {
  memoryId  String          @map("memory_id")
  granteeId String          @map("grantee_id")
  grantorId String          @map("grantor_id")
  role      MemoryShareRole
  // Audit fields (no soft-delete). Revoke is a hard row delete (FR-022);
  // predicate lookups use `findUnique` on the composite PK.
  createdAt DateTime        @default(now()) @map("created_at")
  createdBy String?         @map("created_by")
  updatedAt DateTime?       @updatedAt @map("updated_at")
  updatedBy String?         @map("updated_by")

  memory  Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  grantee User   @relation("MemorySharesGranted", fields: [granteeId], references: [id], onDelete: Cascade)
  grantor User   @relation("MemorySharesByGrantor", fields: [grantorId], references: [id], onDelete: Cascade)

  @@id([memoryId, granteeId])
  @@index([granteeId])
  @@index([grantorId])
  @@map("memory_shares")
}

/// Symmetric team membership for group-class memory (spec 023 US4 /
/// FR-026–FR-031). Composite PK `(memoryId, userId)` — one row per
/// (Memory, member).
///
/// **Scope**: applies ONLY to group-class Memories (FR-027).
/// Application-layer guard in `addMemoryMember.ts` enforces this.
///
/// **Role capabilities**:
///   `reader` — read.
///   `writer` — read + write nodes within the Memory.
///   `owner`  — read + write + manage member list, delete/rename the
///              Memory, change Memory configuration (FR-036).
///
/// **Last-owner protection** (FR-038): the platform rejects removal
/// or demotion of the sole remaining `owner`. The MemoryMember row
/// can still be deleted; the operation-layer guard enforces the
/// invariant (`removeMemoryMember.ts`, `updateMemoryMemberRole.ts`).
/// FR-031: removing the last non-owner does NOT delete the Memory.
model MemoryMember {
  memoryId  String           @map("memory_id")
  userId    String           @map("user_id")
  role      MemoryMemberRole
  // Audit fields (no soft-delete). Remove is a hard row delete (FR-038
  // protects the last owner; non-owner removal is unrestricted);
  // predicate lookups use `findUnique` on the composite PK.
  createdAt DateTime         @default(now()) @map("created_at")
  createdBy String?          @map("created_by")
  updatedAt DateTime?        @updatedAt @map("updated_at")
  updatedBy String?          @map("updated_by")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user   User   @relation("MemoryMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([memoryId, userId])
  @@index([userId])
  @@map("memory_members")
}

/// User-owned API key — the credential primitive for user-scoped MCP
/// access (spec 025-oauth-for-mcp; D-2026-05-13-001, D-2026-05-17-001).
/// Mirrors AppKey but resolves to a User instead of an App. The raw key is
/// `hdr_user_<…>`; we store SHA-256 (not bcrypt) for the same reason
/// AppKey does — direct hash lookup needs a deterministic hash, and the
/// 256-bit raw key (32 bytes / 64 hex chars) already makes dictionary
/// attacks irrelevant.
///
/// Tokens issued by the OAuth /token endpoint share this shape and storage
/// path so a single `resolveUserApiKey` middleware validates both
/// portal-minted and OAuth-issued tokens (FR-015). The path the key
/// arrived through is recorded in `issuedVia` (not `createdBy`); see the
/// column docstrings.
///
/// **Audit fields omitted (matches AppKey precedent):** no `updatedAt` /
/// `updatedBy` / `deletedAt` / `deletedBy`. UserApiKey rows are
/// append-once with a single terminal state transition (revoked);
/// `revokedAt` carries the lifecycle info, and there is no edit
/// operation. Soft-delete is meaningless for a revocable credential.
model UserApiKey {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  /// SHA-256 hash of the raw `hdr_user_<…>` key.
  keyHash     String    @unique @map("key_hash")
  /// Last 4 characters of the raw key for masked display.
  keyPreview  String    @map("key_preview")
  /// Human-friendly name for this key.
  label       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Actor that minted this key. Schema-wide convention: `User.id` of
  /// the actor. For self-service v1 this equals `userId`; the column
  /// exists for future admin-issued paths (where actor != owner).
  createdBy   String?   @map("created_by")
  /// Issuance identity: portal for direct sign-in, oauth:<client_id> for
  /// OAuth issuance, inherited from an authenticated minting key. Nullable
  /// historical provenance remains unknown. Distinct from the User actor.
  issuedVia   String?   @map("issued_via")
  /// Immutable OAuth scopes copied from the authorization code at token
  /// redemption. Empty means an unrestricted portal/legacy user key. There is
  /// deliberately no DB default: every issuance path writes the exact grant.
  oauthScopes String[]  @map("oauth_scopes")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  /// #2298: the owner hid this REVOKED key from their default list. Display
  /// state only: never read by authentication, revocation or lineage.
  hiddenAt    DateTime? @map("hidden_at")

  /// Authenticated credential that minted this key (#1253). Null means
  /// direct issuance or unknown legacy ancestry; never inferred/backfilled.
  mintedByKeyId String?      @map("minted_by_key_id")
  mintedByKey   UserApiKey?  @relation("UserKeyLineage", fields: [mintedByKeyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mintedKeys    UserApiKey[] @relation("UserKeyLineage")

  /// #1897 / R66: the factor-protected sign-in this key descends from, directly
  /// or through minting keys. Immutable, server-derived, never inferred from
  /// email/time/issuedVia; null = direct issuance or legacy (S6), never backfilled.
  originSignInId String? @map("origin_sign_in_id")
  originSignIn   SignIn? @relation(fields: [originSignInId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mintedByKeyId])
  @@index([originSignInId])
  @@map("user_api_keys")
}

/// Admin-impersonation audit record AND revocation source of truth. One row
/// per impersonation session: an org ADMIN/OWNER (or platform admin) viewing
/// the platform read-only as the target user, scoped to the single
/// organization shared by admin and target. The target's other organizations
/// and all personal-class resources (personal/private memories, chats,
/// mailbox, assets, personal credentials) stay invisible.
///
/// A session is LIVE iff `endedAt IS NULL AND expiresAt > now()`. Expiry is
/// derived from `expiresAt` at read time and never written back.
///
/// `endedAt` and `endedBy` together distinguish how a session finished:
///   - `endedAt` set, `endedBy` set  — a person explicitly stopped it.
///   - `endedAt` set, `endedBy` NULL — the system REVOKED it (#878). Every
///     request re-derives both parties' current org roles, so losing the
///     admin role, a promotion that breaches peer-or-below, the target
///     leaving the org, or the admin's account being deleted ends it at once.
///   - `endedAt` NULL, past `expiresAt` — it simply lapsed.
///
/// Rows are never deleted by the stop path — the table is the durable audit
/// trail (who impersonated whom, where, when).
model ImpersonationSession {
  id             String    @id @default(cuid())
  /// Actor (the admin). Schema-wide audit-actor convention: `User.id`.
  adminUserId    String    @map("admin_user_id")
  /// The member being impersonated.
  targetUserId   String    @map("target_user_id")
  /// The shared org that scopes the impersonated session's reads.
  organizationId String    @map("organization_id")
  /// Optional support/diagnostic reason supplied at start. Capped at the
  /// resolver (USER_API_KEY_LABEL_MAX_LEN precedent).
  reason         String?
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  /// Explicit-stop timestamp. NULL while live or when the session merely
  /// lapsed by TTL.
  endedAt        DateTime? @map("ended_at")
  /// `User.id` of whoever stopped it early (the admin in v1 — never the
  /// target: the impersonated context's self-stop records the actor).
  endedBy        String?   @map("ended_by")

  adminUser    User         @relation("ImpersonationSessionsAsAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  targetUser   User         @relation("ImpersonationSessionsAsTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([organizationId, createdAt])
  @@map("impersonation_sessions")
}

/// OAuth 2.1 client registry (spec 025-oauth-for-mcp; D-2026-05-17-002).
/// Rows are populated by `POST /oauth/register` (RFC 7591 DCR) or seeded
/// explicitly. Public clients only (no `clientSecret`); PKCE S256 is the
/// auth proof. Per Q-025-001, only the `'test'` row will be seeded by
/// `prisma/seed.ts` (spec 025 task T009 — not yet in this PR);
/// `'claude-desktop'` and other real clients self-register via DCR.
///
/// **PK note:** `clientId` is the PK (no separate cuid `id`) because
/// `clientId` is the natural key — it's the public, immutable identifier
/// the client sends on every `/authorize` / `/token` request and is
/// referenced by `AuthCode.clientId` as the FK target. Precedent for a
/// non-cuid PK: `Session.id` is caller-generated. Diverges from PR 137's
/// reference (which carried a separate cuid `id`) — see
/// `spec-kits/specs/025-oauth-for-mcp/data-model.md` §OAuthClient.
///
/// Carries the full standard audit-field set per the schema-top
/// convention because edit / delete affordances are anticipated (admin
/// "rename a client", "rotate redirect URIs", etc.); v1 has no such
/// surface, but the columns are cheap to add now and would otherwise
/// need a backfill later.
model OAuthClient {
  /// The public client identifier. DCR-registered:
  /// `dcr_<32 hex>` (16 bytes / 128 bits). Seeded fixtures use stable
  /// identifiers like `'test'`. Primary key.
  clientId     String    @id @map("client_id")
  clientName   String    @map("client_name")
  /// Allowed redirect URIs. /authorize must reject any redirect_uri
  /// not present here (OAuth 2.1 §3.1.2).
  redirectUris String[]  @map("redirect_uris")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")
  /// #155: when an unused DCR client becomes collectable. Set to now + 30
  /// days at registration and pushed forward by each token redemption; the
  /// GC job (src/jobs/gcOauthClients.ts) soft-deletes a client 7 days past
  /// it. NULL never expires (seeded and hand-made clients).
  expiresAt    DateTime? @map("expires_at")

  authCodes AuthCode[]

  @@map("oauth_clients")
}

/// Short-lived OAuth authorization code (spec 025-oauth-for-mcp;
/// RFC 6749 §4.1). Issued by `POST /oauth/authorize` on
/// `decision=approve`, redeemed once at `POST /oauth/token`. Stores PKCE
/// S256 challenge + RFC 8707 resource indicators for verification at
/// redemption. Single-use via race-safe `updateMany`-with-conditional
/// `redeemedAt: null` pattern (FR-013). PKCE / resource mismatch at
/// /token also marks `redeemedAt` to prevent probing.
///
/// **Code storage:** the raw code value is hashed (SHA-256) before
/// storage, matching `AppKey.keyHash` and `UserApiKey.keyHash` — auth
/// codes are credentials in their 10-minute redemption window and should
/// not be plaintext in the DB. `/oauth/authorize` returns the raw code
/// to the client; `/oauth/token` hashes the supplied code and looks up
/// by hash. Diverges from PR 137's reference (which stored plaintext)
/// — see `spec-kits/specs/025-oauth-for-mcp/contracts/oauth-endpoints.md`
/// §`POST /oauth/token`.
///
/// **Audit fields omitted (matches AppKey precedent):** no `updatedAt` /
/// `updatedBy` / `deletedAt` / `deletedBy`. AuthCode rows are append-once
/// with two terminal state transitions (redeemed / expired); `redeemedAt`
/// and `expiresAt` carry the lifecycle info. Soft-delete is meaningless
/// for a single-use, expiring credential.
model AuthCode {
  id            String    @id @default(cuid())
  /// SHA-256 hash of the raw code value handed to the client. Looked up
  /// by hash at /token to avoid plaintext credentials in the DB.
  codeHash      String    @unique @map("code_hash")
  clientId      String    @map("client_id")
  userId        String    @map("user_id")
  redirectUri   String    @map("redirect_uri")
  /// PKCE S256 challenge value (base64url, no padding).
  codeChallenge String    @map("code_challenge")
  /// RFC 8707 resource indicator(s) captured at /authorize. Multi-valued
  /// per RFC 8707 §2; v1 MCP usage populates a single element (the MCP
  /// endpoint URL). Application enforces ≥1 element.
  resource      String[]
  /// Immutable OAuth scopes approved by the user. Copied exactly to the
  /// UserApiKey minted when this code is redeemed.
  /// No DB default: the authorize path must always write the approved grant.
  oauthScopes   String[]  @map("oauth_scopes")
  expiresAt     DateTime  @map("expires_at")
  redeemedAt    DateTime? @map("redeemed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  /// Actor that initiated the /authorize request that minted this code.
  /// Resolves to the signed-in User; equals `userId` in self-service v1.
  createdBy     String?   @map("created_by")
  /// #1897: the sign-in this code descends from (null = not factor-protected;
  /// never inferred). Immutable, same owner as `userId`.
  signInId      String?   @map("sign_in_id")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  signIn SignIn?     @relation(fields: [signInId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([clientId])
  @@index([signInId])
  @@map("auth_codes")
}

/// #1631 S2a: one browser-bound, purpose-bound, single-use ceremony step.
/// Expiry and consumption are decided on the database clock.
model PasskeyCeremony {
  id                 String             @id
  purpose            String
  browserNonceHash   String             @map("browser_nonce_hash")
  /// SHA-256 hex of the challenge issued for this ceremony: every ceremony is bound to one.
  challengeHash      String             @map("challenge_hash")
  createdAt          DateTime           @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at")
  expiresAt          DateTime           @map("expires_at")
  consumedAt         DateTime?          @map("consumed_at")
  /// #1631 PR2: a REGISTER ceremony's binding, set once at its options step (cor:aut:040:02): who registers,
  /// 'first' (a fresh sign-in, its method and that browser's hash) or 'later' (the vouching passkey), and the
  /// fresh random WebAuthn user handle. Null for every other ceremony.
  userId             String?            @map("user_id")
  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind               String?
  registrationMethod String?            @map("registration_method")
  signInBrowserHash  String?            @map("sign_in_browser_hash")
  vouchPasskeyId     String?            @map("vouch_passkey_id")
  vouchPasskey       PasskeyCredential? @relation("PasskeyCeremonyVouch", fields: [vouchPasskeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userHandle         Bytes?             @map("user_handle")

  @@index([expiresAt])
  @@map("passkey_ceremonies")
}

/// #1631 PR2 (cor:aut:040:02): every registration's email notice, written in the registering transaction and sent
/// by a loop. A first passkey's carries its cancel token encrypted until sent. seenAt records the in-app notice.
model PasskeyRegistrationNotice {
  id             String            @id
  passkeyId      String            @unique @map("passkey_id")
  passkey        PasskeyCredential @relation(fields: [passkeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId         String            @map("user_id")
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// 'first' | 'later'
  kind           String
  cancelTokenEnc String?           @map("cancel_token_enc")
  createdAt      DateTime          @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at")
  attempts       Int               @default(0)
  leaseUntil     DateTime?         @map("lease_until")
  claimToken     String?           @map("claim_token")
  sentAt         DateTime?         @map("sent_at")
  failedAt       DateTime?         @map("failed_at")
  seenAt         DateTime?         @map("seen_at")

  @@index([userId])
  @@index([sentAt])
  @@map("passkey_registration_notices")
}

/// #1631 PR2 (cor:aut:040:07-08): a first passkey's cancel link. One per first passkey, stored as SHA-256,
/// spent once, never deleted; the cancel itself is recorded on the credential. Times come from the guard trigger.
model PasskeyCancelToken {
  id        String            @id
  passkeyId String            @unique @map("passkey_id")
  passkey   PasskeyCredential @relation(fields: [passkeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash String            @unique @map("token_hash")
  createdAt DateTime          @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at")
  usedAt    DateTime?         @map("used_at")

  @@map("passkey_cancel_tokens")
}

/// #1631 PR1b slice 2 (cor:aut:040:09): a fresh sign-in bound to the ceremony browser. Signs the person in to
/// nothing. Counts once confirmed by the same browser, and is consumed once. Times are set by the guard trigger
/// from the database clock; identity is immutable. Rows are disposable after 24 hours.
model FreshSignIn {
  id               String    @id
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'github' | 'google' | 'apple' | 'email', set from the provider whose callback ran.
  method           String
  browserNonceHash String    @map("browser_nonce_hash")
  /// SHA-256 of the one-time leg id (IdP) or emailed token (email). The raw value is never stored.
  legHash          String    @unique @map("leg_hash")
  createdAt        DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  signedInAt       DateTime? @map("signed_in_at")
  confirmedAt      DateTime? @map("confirmed_at")
  consumedAt       DateTime? @map("consumed_at")
  /// 'register' | 'end-window' | 'revoke'
  consumedFor      String?   @map("consumed_for")

  @@index([browserNonceHash])
  @@index([createdAt])
  @@map("fresh_sign_ins")
}

/// #1897 slice B1: an email sign-in waiting for its passkey. Created when a magic link is claimed for a user who
/// has a passkey, and completed only by that passkey's assertion over a SIGN_IN ceremony bound to this browser.
/// Publishes nothing: no handoff code, no JWT, no cookie, no key exists until it completes. Identity and
/// continuation are immutable; completion is set once, together with the sign-in it produced.
model PendingEmailSignIn {
  id              String    @id
  userId          String    @map("user_id")
  /// 'PORTAL' | 'OAUTH'. Each kind carries exactly its own columns (CHECK).
  continuation    String
  /// Portal: the ORIGINAL SHA-256 of the requesting browser's nonce, carried untouched to the handoff code.
  clientStateHash String?   @map("client_state_hash")
  redirect        String?
  isNew           Boolean?  @map("is_new")
  /// OAuth: the already-validated server-local path to resume at.
  returnTo        String?   @map("return_to")
  /// SHA-256 of the pending cookie; the cookie value is never stored.
  browserHash     String    @unique @map("browser_hash")
  /// The current SIGN_IN ceremony; replacing it consumes the earlier one.
  ceremonyId      String?   @map("ceremony_id")
  createdAt       DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("created_at")
  expiresAt       DateTime  @map("expires_at")
  completedAt     DateTime? @map("completed_at")
  signInId        String?   @map("sign_in_id")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  signIn SignIn? @relation(fields: [signInId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([createdAt])
  @@map("pending_email_sign_ins")
}

/// #1631 schema-first: shared credential registry (cor:aut:040:05), no enrollment route yet.
/// Identity/public-key fields are immutable; records are never deleted, revokedAt is set once.
model PasskeyCredential {
  id                 String    @id @default(cuid())
  ownerId            String    @map("owner_id")
  /// Raw WebAuthn identifier bytes: encoding aliases cannot create duplicate records.
  credentialId       Bytes     @unique @map("credential_id")
  publicKey          Bytes     @map("public_key")
  algorithm          Int
  /// Random authenticator user handle, not an email, User.id or session bearer.
  userHandle         Bytes     @map("user_handle")
  /// The WebAuthn RP ID the credential was registered under (Eden #10470), recorded at
  /// enrollment and immutable. Never inferred from the current PASSKEY_RP_ID: an assertion
  /// counts only while it equals the deployment's RP ID (cor:aut:040:06).
  enrollmentRpId     String    @map("enrollment_rp_id")
  label              String
  registeredAt       DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @map("registered_at")
  lastUsedAt         DateTime? @map("last_used_at")
  revokedAt          DateTime? @map("revoked_at")
  /// WebAuthn's unsigned 32-bit counter does not fit a signed PostgreSQL Int.
  counter            BigInt    @default(0)
  transports         String[]  @default([])
  backupEligible     Boolean   @default(false) @map("backup_eligible")
  backedUp           Boolean   @default(false) @map("backed_up")
  /// First credential only: the verified sign-in method used for registration.
  registrationMethod String?   @map("registration_method")
  windowEndsAt       DateTime? @map("window_ends_at")
  windowEndedAt      DateTime? @map("window_ended_at")
  /// null while open (or not first); ran-out | ended-early | cancelled once closed.
  windowOutcome      String?   @map("window_outcome")
  /// SEC-9: provenance of a cancel-link use, distinct from other revocation routes.
  cancelledAt        DateTime? @map("cancelled_at")
  cancelIp           String?   @map("cancel_ip")
  cancelUserAgent    String?   @map("cancel_user_agent")

  owner             User                       @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  signatures        NodeSignature[]
  signIns           SignIn[]
  cancelToken       PasskeyCancelToken?
  notice            PasskeyRegistrationNotice?
  vouchedCeremonies PasskeyCeremony[]          @relation("PasskeyCeremonyVouch")

  @@index([ownerId])
  @@map("passkey_credentials")
}

/// #1897 / cor:aut:030:02 + R66: a completed, factor-protected sign-in. Its id is
/// the `sid` claim of the JWT it publishes and the root of every code/key that
/// descends from it, so ending it (the first-passkey cancel link) can revoke
/// exactly that lineage. Identity/lineage fields are immutable; only `endedAt`/
/// `endReason` are set, once. Rows are never deleted while descendants exist.
model SignIn {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  /// How the person arrived ('email'); the factor is `completedByPasskeyId`.
  method               String
  completedByPasskeyId String?   @map("completed_by_passkey_id")
  completedAt          DateTime  @default(now()) @map("completed_at")
  expiresAt            DateTime  @map("expires_at")
  endedAt              DateTime? @map("ended_at")
  endReason            String?   @map("end_reason")

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  passkey   PasskeyCredential?   @relation(fields: [completedByPasskeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  handoffs  AuthHandoffCode[]
  authCodes AuthCode[]
  keys      UserApiKey[]
  pendings  PendingEmailSignIn[]

  @@unique([id, userId])
  @@index([userId])
  @@index([completedByPasskeyId])
  @@map("sign_ins")
}

/// #1632 / cor:dmo:130:03 — a request for a person to sign one node's content.
/// Pinned at creation and immutable: the node, its revision, the v1 approval
/// hash and the payload version. It is open, then ends exactly once:
/// completed | declined | expired | stale | withdrawn. Ended requests are kept
/// for the node's lifetime (#10019). Every timestamp comes from the DB clock,
/// set by the guard trigger (prisma/signing-invariants.sql), which also
/// enforces the single end; application code only names the end state.
/// User / App / worker ids are sealed history with no FK (an FK action would
/// be a write the guard refuses): see conventions:append-only-table-trigger.
model SigningRequest {
  /// 128 bits of randomness, base64url (plan SEC-8): never guessable.
  id                 String    @id
  nodeId             String    @map("node_id")
  revision           Int
  approvalHash       String    @map("approval_hash")
  payloadVersion     String    @map("payload_version")
  /// Null = any eligible signer (a writer of the node's memory).
  namedSignerId      String?   @map("named_signer_id")
  /// The requester ACCOUNT is requesterUserId, else requesterAppId (#10397).
  requesterUserId    String?   @map("requester_user_id")
  requesterAppId     String?   @map("requester_app_id")
  requesterWorkerId  String?   @map("requester_worker_id")
  requesterSessionId String?   @map("requester_session_id")
  /// open | completed | declined | expired | stale | withdrawn
  state              String    @default("open")
  createdAt          DateTime  @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @map("created_at")
  expiresAt          DateTime  @map("expires_at")
  endedAt            DateTime? @map("ended_at")

  node      Node           @relation(fields: [nodeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  signature NodeSignature?

  @@index([nodeId, createdAt])
  @@map("signing_requests")
}

/// #1632 / cor:dmo:130:07 — an append-only signature record: no update or
/// delete surface at all (cor:dmo:130:05). Removed only with its node (hard
/// delete, memory delete). State is never stored; it is derived on every read
/// by re-verifying the stored assertion (src/lib/signing/state.ts).
model NodeSignature {
  id                  String   @id @default(cuid())
  nodeId              String   @map("node_id")
  /// The request it completed; one record per request.
  signingRequestId    String   @unique @map("signing_request_id")
  /// A person, always. Sealed history: no FK.
  signerId            String   @map("signer_id")
  passkeyCredentialId String   @map("passkey_credential_id")
  revision            Int
  approvalHash        String   @map("approval_hash")
  payloadVersion      String   @map("payload_version")
  /// The WebAuthn RP ID the signature was made under, from config at
  /// completion. Re-verification uses this, never the current PASSKEY_RP_ID,
  /// so a domain change cannot invalidate old signatures (#10469/#10470). The
  /// guard requires the assertion's rpIdHash to match it.
  rpId                String   @map("rp_id")
  authenticatorData   Bytes    @map("authenticator_data")
  clientDataJson      Bytes    @map("client_data_json")
  signature           Bytes
  verifiedAt          DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC'::text)")) @map("verified_at")

  node           Node              @relation(fields: [nodeId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  signingRequest SigningRequest    @relation(fields: [signingRequestId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  passkey        PasskeyCredential @relation(fields: [passkeyCredentialId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([nodeId])
  @@map("node_signatures")
}

/// Short-lived, single-use handoff codes that keep the session JWT out of
/// browser-visible URLs (#477). Two kinds share the same shape:
///   - 'login'          — minted after GitHub/email auth; the portal's server
///                        `load` redeems it at POST /auth/session for the JWT,
///                        which it sets as an HttpOnly cookie. For the GitHub
///                        flow `clientStateHash` binds the finishing browser to
///                        the login it started (session-fixation defense); the
///                        email flow leaves it null (magic links open cross-device).
///   - 'exchange_start' — minted by POST /auth/microsoft/start (Bearer-authed,
///                        server-to-server) so the long-lived JWT never rides in
///                        the /auth/microsoft redirect URL.
/// The raw code is only ever handed out once; the DB stores its SHA-256 hash.
/// Single use is enforced by an atomic `updateMany(redeemedAt: null)` claim,
/// mirroring AuthCode. DB-backed (not in-memory) so it survives multi-worker
/// deploys, unlike the legacy pendingStates maps.
model AuthHandoffCode {
  id              String    @id @default(cuid())
  /// SHA-256 hash of the raw code handed to the browser/portal.
  codeHash        String    @unique @map("code_hash")
  /// 'login' | 'exchange_start'.
  kind            String
  userId          String    @map("user_id")
  /// Post-redemption destination path (login: portal path; exchange: return path).
  redirect        String?
  /// login only — whether the user was just provisioned (drives /app/setup).
  isNew           Boolean   @default(false) @map("is_new")
  /// Verified login evidence survives handoff; redemption must never refresh it.
  loginEvidence   Json?     @map("login_evidence")
  /// exchange_start only — the org the Exchange connection is being attached to.
  orgId           String?   @map("org_id")
  /// login+GitHub only — SHA-256 of the portal-set browser nonce; the redeemer
  /// must present the matching raw nonce (constant-time compared).
  clientStateHash String?   @map("client_state_hash")
  expiresAt       DateTime  @map("expires_at")
  redeemedAt      DateTime? @map("redeemed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  /// #1897: the sign-in this handoff publishes (null = not factor-protected).
  signInId        String?   @map("sign_in_id")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  signIn SignIn? @relation(fields: [signInId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([signInId])
  @@map("auth_handoff_codes")
}

/// Durable pending login state for the first-party auth flows (GitHub /
/// Google / Apple, `src/auth/pendingLoginState.ts`). Carries the OAuth
/// state-CSRF token minted at the start route until the provider callback
/// claims it (atomic delete-by-PK — single use). Replaces the three
/// in-process `pendingStates` Maps in server.ts, which died on every
/// deploy/restart: the provider callback then 400d mid-login — the failure
/// mode behind the Apple App Review "the app failed to login with Apple"
/// rejection (Apple's callback is a cross-site form POST after a flow that
/// can involve slow 2FA). DB-backed rows survive restarts and multi-worker
/// deploys. No user FK: the row exists BEFORE we know who is logging in.
model PendingLoginState {
  /// The OAuth `state` CSRF token (random hex) — handed to the IdP at the
  /// start route and echoed back on the callback.
  state             String   @id
  /// 'github' | 'google' | 'apple' — a state minted for one provider can
  /// never be claimed by another provider's callback.
  provider          String
  /// Portal-local path to land on after login (portal-handoff flow).
  redirect          String?
  /// Spec 025 FR-007 Option-C server-local return path (cookie flow).
  returnTo          String?  @map("return_to")
  /// #477 session-fixation binding — the portal's browser nonce, stamped
  /// onto the login handoff code at the callback.
  clientState       String?  @map("client_state")
  /// #1631 PR1b: SHA-256 of the ceremony browser cookie when this state is a passkey ceremony's sign-in leg.
  /// Such a state carries no return_to or client_state (CHECK), and its callback mints no session.
  ceremonyNonceHash String?  @map("ceremony_nonce_hash")
  /// #2204: SHA-256 of the OIDC `nonce` sent to Google/Apple (binds the ID token to this attempt). NULL only for
  /// GitHub and for rows minted before #2204; `chk_pending_login_provider_nonce` (NOT VALID) refuses a new
  /// google/apple row without it. Distinct from `client_state` and `ceremony_nonce_hash`, which bind the browser.
  providerNonceHash String?  @map("provider_nonce_hash")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  // The lazy expiry sweep deletes WHERE expires_at < now() on every
  // unauthenticated start-route hit — keep it index-backed.
  @@index([expiresAt])
  @@map("pending_login_states")
}

// ─── Spec 040 — headless agent runs ─────────────────────────────────────────
// Design: D-2026-07-04 A–F over the 2026-05/06 design corpus (the spec-040 plan
// is retired; see git history). Spec: cor:agt:010 (+ cor:acl:040/:050).

enum AppRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  TIMED_OUT
  CANCELLED
}

enum AppRunTriggerKind {
  SCHEDULE
  WEBHOOK
  MANUAL
  INTEGRATION
  /// Fan-out (plan-spawn): child + callback runs minted by hadron_spawn;
  /// triggerId carries the parent run id.
  SPAWN
}

/// One headless run (cor:agt:010:02). Simultaneously the audit record AND —
/// v1, D-2026-07-04-D — the activation: created only after the launch gate
/// passes; every action inside the run re-checks status + policy and
/// decrements the live budgets; zeroing a budget or setting CANCELLED halts
/// the run at its next action (the kill switch). Also the outbox row for
/// run.requested.v1 (publishedAt NULL ⇒ sweep republishes).
model AppRun {
  id                   String               @id
  organizationId       String               @map("organization_id")
  appId                String               @map("app_id")
  agentId              String?              @map("agent_id")
  /// On-behalf-of user (cor:agt:010:01, D-2026-07-04-C). NULL ⇒ pure App
  /// service identity — no personal/private reach.
  userId               String?              @map("user_id")
  triggerKind          AppRunTriggerKind    @map("trigger_kind")
  triggerId            String?              @map("trigger_id")
  /// #1719 R5b: owner-adopted complete graph; NULL fails closed at execution.
  automationPin        Json?                @map("automation_pin")
  manualAutomationPin  ManualAutomationPin?
  entryNodeUrn         String               @map("entry_node_urn")
  /// #2438: the entry node's stable id — what the run resolves by once the
  /// automation pin moved off literal URNs. NULL on runs minted before the
  /// column existed; those keep verifying under their stored pin's URN identity.
  entryNodeId          String?              @map("entry_node_id")
  eventData            Json?                @map("event_data")
  /// Run envelope (D-2026-05-09-013): the mutable bag of fields extracted
  /// by flow nodes as the walker advances. Bare field names — conditions
  /// address them through the evaluator's `message.data.*` scope prefix
  /// (plan-multi-node D-MN-1). `eventData` stays the immutable trigger
  /// payload; on key collision the envelope wins.
  data                 Json?
  /// Per-hop trail (#538): the walked path, one element per COMPLETED hop,
  /// appended in the same checkpoint/finish UPDATE the runner already
  /// writes. `[{node, edgeOut, startedAt, finishedAt, tokensSpent}]` —
  /// edgeOut is the routing edge taken FROM the hop (null on the last).
  /// Bounded by RUN_MAX_HOPS. A hop that FAILS mid-execution has no
  /// element; `curNodeUrn` + `failure` identify it.
  hops                 Json?
  /// #2047 (S10, cor:agt:040:03): the derived blocks each hop of the run saw, append-only, `[{hop, blocks}]`, where
  /// `blocks` is the full list and may be EMPTY (so a block going away is recorded too). An entry is written, guarded on
  /// RUNNING, before the hop's LLM call and only when the blocks differ from the last entry, so a hop that fails or is
  /// aborted (it gets no `hops` element) still shows what it saw. The blocks seen by hop n are the last entry with
  /// hop <= n. Run progress, readable by the run read gate; deliberately NOT part of the immutable boot record.
  derivedLog           Json?             @map("derived_log")
  /// PARENT-side fan-out state (plan-spawn D-SP-1): set by hadron_spawn —
  /// {processItem, itemKey, callback?, itemCallback?, total, dispatching?,
  /// callbackFiredAt?}. Its own column, NOT `data`: the parent's envelope
  /// checkpoint would clobber a mid-hop write there. callbackFiredAt is the
  /// exactly-once claim (D-SP-4, atomic SQL).
  spawn                Json?
  /// Run-layer allow-list snapshot (the narrowest chain link; plan §4).
  policy               Json?
  /// Remaining LLM tokens — live-decrement kill switch.
  budgetTokens         Int?                 @map("budget_tokens")
  /// Remaining tool/write actions — live-decrement kill switch.
  budgetActions        Int?                 @map("budget_actions")
  /// #832 — the budget this run was MINTED with, so a client can render
  /// "spent vs budget". `budgetTokens` above is what REMAINS. NULL on runs
  /// minted before the column existed.
  budgetTokensInitial  Int?                 @map("budget_tokens_initial")
  budgetActionsInitial Int?                 @map("budget_actions_initial")
  /// #832 — cumulative spend, incremented in the same write as the budget
  /// decrement. Deliberately NOT derived:
  ///   * a `hops` sum under-reports — a hop that failed mid-execution has no
  ///     element, which is exactly the run an operator is auditing;
  ///   * `initial - remaining` under-reports too — the decrement is CLAMPED
  ///     (`Math.min(spent, budget)`) so the remaining budget never goes
  ///     negative, and an overspending run would report exactly its budget.
  /// These counters are unclamped and therefore truthful in overage.
  ///
  /// NULLABLE with a default: new runs start at 0, while a run minted BEFORE
  /// the columns existed is genuinely UNKNOWN rather than zero — reporting 0
  /// for a run whose already-decremented budget proves otherwise would be a
  /// false total (PR #854 review, Codex P2). `tokens_spent` is backfilled from
  /// the hop trail where one exists; `actions_spent` has no such signal.
  ///
  /// A rejected tool-loop call counts the steps the SDK had already completed
  /// (#862); usage the SDK did not report (the failed step, or a step without
  /// counts) is not counted, so such a run can still under-report. See the
  /// GraphQL field docs.
  tokensSpent          Int?                 @default(0) @map("tokens_spent")
  actionsSpent         Int?                 @default(0) @map("actions_spent")
  /// #2439 — priced LLM cost of this run in micro-cents (1e-8 USD): the sum of
  /// its usage events' `costMicroCents`, incremented where each event is
  /// recorded. Unpriced events add nothing. NULL = UNKNOWN for a run minted
  /// before the column existed (no usage-event link to back-fill from); new
  /// runs start at 0.
  costMicroCents       BigInt?              @map("cost_micro_cents")
  status               AppRunStatus         @default(PENDING)
  curNodeUrn           String?              @map("cur_node_urn")
  /// Spec 049 Phase 3b (D-2026-09-13-004): the trigger's scope, SNAPSHOTTED at mint as
  /// its ordered memory-id list (as `policy` is snapshotted — a run must not change
  /// meaning because someone edited a scope mid-flight). SCOPE DATA ONLY: every
  /// consumer re-intersects it with the principal's CURRENT access (`resolveRunScope`);
  /// never an access grant that outlives a revoked membership. NULL ⇒ `app`.
  scopeSnapshot        Json?                @map("scope_snapshot")
  /// Spec 049 Phase 6 (D-2026-09-13-007): the attendee's resolved REGISTER at mint
  /// (Agent-in-App = agentId + appId), rows only — for the attention section (Phase 7).
  /// Same re-intersection rule as scopeSnapshot: the Channel watermarks are read
  /// live and the gates are evaluated on every use; never a grant. NULL ⇒ no attendee.
  registerSnapshot     Json?                @map("register_snapshot")
  parentRunId          String?              @map("parent_run_id")
  failure              Json?
  timeoutMs            Int?                 @map("timeout_ms")
  attempts             Int                  @default(0)
  publishedAt          DateTime?            @map("published_at")
  startedAt            DateTime?            @map("started_at")
  finishedAt           DateTime?            @map("finished_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  createdBy            String?              @map("created_by")

  webFetchPollBindings  WebFetchPollBinding[]  @relation("WebFetchPollSourceRun")
  webFetchEventReceipts WebFetchEventReceipt[] @relation("WebFetchEventRoutedRun")

  @@index([status, publishedAt])
  @@index([appId, createdAt])
  @@index([triggerId, status])
  @@index([parentRunId]) // spawn completion checks + child listings (plan-spawn)
  @@index([organizationId, createdAt])
  @@map("app_runs")
}

/// Recurring trigger (cor:agt:010, D-2026-07-04-E) — per-kind table
/// mirroring the decided AgentWebhook shape. The scheduler claims rows by
/// (enabled, nextRunAt) and mints an AppRun per due tick.
model AgentSchedule {
  id             String    @id
  organizationId String    @map("organization_id")
  appId          String    @map("app_id")
  agentId        String?   @map("agent_id")
  /// On-behalf-of user, captured at creation (cor:agt:010:01).
  userId         String?   @map("user_id")
  name           String
  /// 5-field cron expression, evaluated in `timezone` — recurring
  /// schedules. XOR with `runAt` (chk_agent_schedule_cron_xor_run_at).
  cron           String?
  timezone       String    @default("UTC")
  /// One-shot: run once at this instant (#510). XOR with `cron`; the
  /// scheduler claim flips `enabled` to false instead of advancing
  /// `nextRunAt`. Misfire policy unchanged (overdue runs once).
  runAt          DateTime? @map("run_at")
  /// #1719 R5b: owner-adopted complete graph; NULL fails closed at execution.
  automationPin  Json?     @map("automation_pin")
  entryNodeUrn   String    @map("entry_node_urn")
  /// #2438: the entry node's stable id, stamped at adoption (and lazily at
  /// launch) — a same-memory rename/move of the entry keeps the trigger
  /// working; entryNodeUrn stays the immutable display/audit address.
  entryNodeId     String?   @map("entry_node_id")
  /// #2479: optional per-run limits; NULL uses the current platform default.
  budgetTokens   Int?      @map("budget_tokens")
  budgetActions  Int?      @map("budget_actions")
  eventData      Json?     @map("event_data")
  /// Trigger-layer allow-list (chain link; plan §4).
  policy         Json?
  /// Per-trigger AI-config override (name into the spec-036 walk).
  aiConfigName   String?   @map("ai_config_name")
  /// Spec 049 Phase 3b (D-2026-09-13-004) — the scope this trigger's runs carry, snapshotted at mint; NULL ⇒ `app`.
  scopeId        String?   @map("scope_id")
  enabled        Boolean   @default(true)
  lastRunAt      DateTime? @map("last_run_at")
  /// Next due time — the scheduler's work signal. A skipped overlap STILL
  /// advances this (plan §7; prevents back-to-back storms).
  nextRunAt      DateTime? @map("next_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")
  scope          Scope?    @relation(fields: [scopeId], references: [id], onDelete: SetNull)

  @@index([enabled, nextRunAt])
  @@index([appId, deletedAt])
  @@index([scopeId])
  @@map("agent_schedules")
}

/// Continuous quota tier (cor:acl:050:01/:04): windowed counters per App and
/// per org for run.execute + llm.tokens. Checked at the launch gate and
/// decremented live during runs.
model QuotaCounter {
  id        String   @id
  scopeKind String   @map("scope_kind")
  scopeId   String   @map("scope_id")
  action    String
  window    String
  used      Int      @default(0)
  limit     Int
  resetAt   DateTime @map("reset_at")

  @@unique([scopeKind, scopeId, action, window])
  @@map("quota_counters")
}

/// Consumable quota tier (cor:acl:050:01/:04): TAN-style tickets, v1 required
/// only for the outbound-communication action class. The ledger answers
/// "where did they all go?" — every consumption names the run.
model ActionTicket {
  id              String    @id
  organizationId  String    @map("organization_id")
  appId           String?   @map("app_id")
  action          String
  mintedBy        String    @map("minted_by")
  note            String?
  consumedByRunId String?   @map("consumed_by_run_id")
  consumedAt      DateTime? @map("consumed_at")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([organizationId, action, consumedAt])
  @@map("action_tickets")
}

/// Provider price row for one (provider, model, tier) triple — the rate
/// source for UsageEvent.costMicroCents AND the debit markup (spec 046
/// FR-002/FR-003). Effective-dated: lookup takes the latest
/// `effectiveAt <= eventTime` with `deletedAt IS NULL`; price changes
/// append a new row, never mutate an old one (historical costs stay
/// auditable — stamped costs are snapshots, so soft-deleting a mispriced
/// row is safe and is the "retire" lever). Prices are in micro-cents
/// (1e-8 USD) per MILLION tokens — e.g. $3/MTok input = 30_000_000.
/// Operator-managed via `setAiModelPrice` (platform admin); an absent
/// triple means "no cost computed", never a blocked call.
/// String columns, no enums — validation lives in src/lib/metering.
model AiModelPrice {
  id                      String    @id
  provider                String
  model                   String
  /// Pricing tier 1-3 (Holger, 2026-07-11): reserved room for future
  /// product tiers carrying different markups per (provider, model)
  /// WITHOUT another AiModelPrice migration. Everything defaults to and
  /// resolves tier 1 until tiers become a real product concept; the
  /// semantics of 2/3 are deliberately undefined today. Validated 1-3 in
  /// code (setAiModelPrice / getAiModelPrice), no CHECK by convention.
  tier                    Int       @default(1)
  /// Micro-cents per 1M input tokens.
  inputMicroCentsPerMTok  BigInt    @map("input_micro_cents_per_mtok")
  /// Micro-cents per 1M output tokens.
  outputMicroCentsPerMTok BigInt    @map("output_micro_cents_per_mtok")
  /// Markup applied when debiting platform-key spend at THIS tier, in
  /// basis points (2500 = 25%) — integer-exact, no float money. NULL
  /// falls back to the CREDIT_MARKUP_PERCENT env (which this column
  /// supersedes). Effective-dated with the rest of the row.
  markupBasisPoints       Int?      @map("markup_basis_points")
  /// Row applies to events at/after this instant (until a later row).
  effectiveAt             DateTime  @map("effective_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  createdBy               String?   @map("created_by")
  updatedAt               DateTime? @updatedAt @map("updated_at")
  updatedBy               String?   @map("updated_by")
  deletedAt               DateTime? @map("deleted_at")
  deletedBy               String?   @map("deleted_by")

  @@unique([provider, model, tier, effectiveAt])
  @@index([provider, model, tier])
  @@map("ai_model_prices")
}

/// Append-only monetary ledger for an organization's AI credits (spec 046
/// FR-005). Signed amounts: grants +, debits −, adjustments ±; balance is
/// SUM(amountMicroCents). Rows are NEVER mutated, deleted, or reset — this
/// is the durable billing record (unlike QuotaCounter's daily counters).
/// `expiresAt` on grants is stored policy only in Phase 0 (jurisdictions
/// restrict prepaid expiry — see the spec's legal notes); FIFO expiry
/// enforcement is a later phase. Automatic usage debits are gated by
/// BILLING_DEBIT_ENABLED and apply only to platform-key spend (FR-004/006).
/// Audit columns follow the schema-wide convention; the SANCTIONED
/// correction is an `adjustment` row — soft-delete is break-glass ops only
/// (balance and reads exclude soft-deleted rows, codebase-wide semantic).
model CreditLedgerEntry {
  id               String    @id
  organizationId   String    @map("organization_id")
  /// 'grant' | 'debit' | 'adjustment' (validated in src/lib/metering).
  kind             String
  /// Signed micro-cents (1e-8 USD). Grants positive, debits negative.
  amountMicroCents BigInt    @map("amount_micro_cents")
  /// Grant expiry policy field (no enforcement in Phase 0).
  expiresAt        DateTime? @map("expires_at")
  /// Provenance: e.g. ('usage-event', <UsageEvent.id>), ('admin', <userId>),
  /// later ('payment', <processor ref>).
  sourceType       String?   @map("source_type")
  sourceId         String?   @map("source_id")
  note             String?
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Idempotency for at-least-once payment webhooks (hadrontool-billing):
  // one ledger row per (sourceType, sourceId); NULL-source rows unaffected
  // (Postgres unique treats NULLs as distinct).
  @@unique([sourceType, sourceId])
  @@index([organizationId, createdAt])
  @@map("credit_ledger_entries")
}

/// Webhook trigger (D-2026-05-02, spec 040 plan §8) — per-kind table like
/// AgentSchedule. URL shape: /hooks/<secret>/<name>?hpt=<platform JWT>.
/// The opaque secret is the lookup key (no app/agent IDs in the URL);
/// the time-limited platform JWT is the second factor — a leaked URL is
/// useless without it (D-2026-05-02-006).
model AgentWebhook {
  id             String    @id
  organizationId String    @map("organization_id")
  appId          String    @map("app_id")
  agentId        String?   @map("agent_id")
  /// On-behalf-of user, captured at creation (cor:agt:010:01).
  userId         String?   @map("user_id")
  name           String
  /// Opaque URL secret — unique lookup key, never reused across webhooks.
  secret         String    @unique
  /// JSON Schema for POST args (stored in v1; Ajv enforcement is follow-on).
  argsSchema     Json?     @map("args_schema")
  /// #1719 R5b: owner-adopted complete graph; NULL fails closed at execution.
  automationPin  Json?     @map("automation_pin")
  entryNodeUrn   String    @map("entry_node_urn")
  /// #2438: the entry node's stable id, stamped at adoption (and lazily at
  /// launch) — a same-memory rename/move of the entry keeps the trigger
  /// working; entryNodeUrn stays the immutable display/audit address.
  entryNodeId     String?   @map("entry_node_id")
  /// #2479: optional per-run limits; NULL uses the current platform default.
  budgetTokens   Int?      @map("budget_tokens")
  budgetActions  Int?      @map("budget_actions")
  eventData      Json?     @map("event_data")
  policy         Json?
  aiConfigName   String?   @map("ai_config_name")
  /// Spec 049 Phase 3b (D-2026-09-13-004) — the scope this trigger's runs carry, snapshotted at mint; NULL ⇒ `app`.
  scopeId        String?   @map("scope_id")
  enabled        Boolean   @default(true)
  lastCalledAt   DateTime? @map("last_called_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")
  scope          Scope?    @relation(fields: [scopeId], references: [id], onDelete: SetNull)

  @@index([appId, deletedAt])
  @@index([scopeId])
  @@map("agent_webhooks")
}

/// #1012 — a client's DURABLE MCP selections (active App, active memory).
///
/// The in-process selection maps in `src/mcp/server.ts` live for exactly one MCP
/// TRANSPORT session, and clients re-initialize transparently after a server
/// restart — so a selection silently evaporated mid-conversation (#1005). #1009
/// made that loss legible and recoverable for callers holding a Hadron session
/// id; this table is the remedy for everyone else, including plain memory work
/// with no session at all.
///
/// Keyed on (userId, clientKey), NOT on the MCP session id — which is exactly
/// the thing that does not survive. `clientKey` is the caller's own stable
/// instance id, supplied per request via the `X-Hadron-Client-Id` header. A
/// client that sends none is not persisted at all and keeps the pre-#1012
/// in-memory behaviour, so nothing regresses for clients that never opt in.
///
/// Per-CLIENT rather than per-USER on purpose: one person may drive Claude
/// Desktop, Cursor and the CLI at once, and a per-user row would let one switch
/// the others' active App mid-conversation — turning a lost selection into a
/// silently wrong one, which is worse than the bug being fixed.
///
/// This is a CACHE of a choice, never a grant. Both pointers are re-authorized
/// on read (`isAppParticipant` for the App, the memory read gate for the
/// memory), because a stored selection outlives the membership that justified
/// it (#475 / the #1007 review finding). Both are nullable and `SetNull`, so a
/// deleted App or memory degrades to "nothing selected" rather than dangling.
model McpSessionState {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  /// Caller-supplied stable client-instance id (`X-Hadron-Client-Id`). Opaque
  /// to the server; length-capped and trimmed at the boundary.
  clientKey String @map("client_key")

  /// The active App selection, or NULL if none. Re-authorized on every read.
  appId          String? @map("app_id")
  /// The active memory selection, stored as the PK rather than the URN so a
  /// rename cannot strand it. The URN is resolved on read.
  memoryId       String? @map("memory_id")
  /// Spec 049 Phase 1 (D-2026-09-13-003) — the EXPLICITLY selected active
  /// organization (`hadron_set_active_org`), or NULL if none. Distinct from
  /// the App's organization, which is derived from `appId` at read time and
  /// outranks this in the resolution ladder (`src/lib/auth/activeOrg.ts`).
  /// Re-authorized against current org membership on every read — a stored
  /// selection is a cache of a choice, never a grant.
  organizationId String? @map("organization_id")
  /// Spec 049 Phase 3 (D-2026-09-13-002) — the session's ACTIVE SCOPE
  /// (`hadron_set_active_scope`): rung 2 of the search ladder, outranked only
  /// by a scope named in the call. Re-authorized (readable) on every read.
  scopeId        String? @map("scope_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  app          App?          @relation(fields: [appId], references: [id], onDelete: SetNull)
  memory       Memory?       @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  scope        Scope?        @relation(fields: [scopeId], references: [id], onDelete: SetNull)

  /// One row per (user, client instance) — the upsert target.
  @@unique([userId, clientKey], map: "mcp_session_state_user_client_uniq")
  @@index([appId])
  @@index([memoryId])
  @@index([organizationId])
  @@index([scopeId])
  @@map("mcp_session_state")
}

/// Which kind of entity a {@link UrnAlias} addresses. The four stored-URN
/// entities can be renamed; a Node also needs its own alias when a move
/// rewrites its memory or loc without renaming either parent (#1391).
enum UrnAliasEntityType {
  ORGANIZATION
  MEMORY
  AGENT
  APP
  NODE
}

/// Why a {@link UrnAlias} row exists.
enum UrnAliasReason {
  /// A deliberate rename of the entity's own URN.
  RENAME
  /// The org-URN prefix rewrite cascaded onto a child row (#337).
  ORG_RENAME_CASCADE
  /// The pre-v2 URN this row was migrated FROM (#697) — backfilled from the
  /// per-table `legacy_urn` columns, which this table supersedes.
  V1_MIGRATION
}

/// #1079 — every URN an entity USED to answer to.
///
/// A URN is the platform's stable, publishable identifier: it goes into commit
/// trailers, PR descriptions, issue signatures, chat messages and exported
/// documents, none of which can be rewritten after the fact. Four entities
/// store their URN in a column, and all four can be renamed; a node's composed
/// URN also changes when its loc or memory changes. Without this table those
/// changes silently turned published references into a 404.
///
/// The blast radius is wider than the four rows, because most URNs in the
/// platform are COMPOSED on read from one of them: a node URN carries its
/// memory's slug, a worker URN carries its App's slug, an apprun URN likewise.
/// Renaming one memory therefore orphans every published node URN under it.
/// Aliasing the four storing entities heals parent renames. A node move also
/// records the old composed node URN, because its loc or memory can change
/// while both stored parent URNs remain unchanged (#1391).
///
/// **Liveness is not stored here.** A row records only that a URN once
/// addressed an entity; whether that entity is still readable, uninstalled or
/// soft-deleted is answered by re-querying it, so an alias can never resurrect
/// a dead row or leak one past its own gate.
///
/// **A live URN always wins.** An old URN becomes free on rename and may be
/// taken by a new entity, so every resolver tries the `urn` column first and
/// consults this table only on a miss. Two entities may therefore legitimately
/// have held the SAME urn at different times; that is why the alias urn is not
/// unique, and an ambiguous lookup fails loudly rather than guessing (the
/// `AmbiguousLegacyUrnError` rule this shares with the `legacy_urn` fallback).
model UrnAlias {
  id String @id @default(cuid())

  /// The superseded URN, stored in the same normalized lookup form the
  /// resolvers compute (`hrn:`/`urn:` prefix stripped, `::` collapsed to `:`)
  /// — a raw spelling here would be unreachable from a normalized query.
  urn        String             @map("urn")
  entityType UrnAliasEntityType @map("entity_type")
  entityId   String             @map("entity_id")
  reason     UrnAliasReason

  /// The URN that replaced it — provenance only, never matched on. Null for a
  /// V1_MIGRATION backfill row, whose successor is the entity's current urn.
  replacedByUrn String? @map("replaced_by_urn")

  createdAt DateTime @default(now()) @map("created_at")
  /// Who performed the rename, when a principal was attributable.
  createdBy String?  @map("created_by")

  /// One alias row per (urn, entity) — a rename back and forth must not
  /// accumulate duplicates, which would read as an ambiguous lookup and start
  /// refusing a URN that resolves to exactly one entity.
  @@unique([urn, entityType, entityId], map: "urn_aliases_urn_entity_uniq")
  /// The lookup index: resolvers query by (urn, entityType).
  @@index([urn, entityType])
  /// Reverse lookup — "what did this entity used to be called".
  @@index([entityType, entityId])
  @@map("urn_aliases")
}

/// Spec 049 Phase 2 (D-2026-09-13-001) — a named search SCOPE ("lens"): an
/// ORDERED list of memories with exactly one owner — organization, Agent, or
/// App — as three nullable FKs with a CHECK (`chk_scope_owner`,
/// `num_nonnulls(...) = 1`), never an `ownerKind` string. The Scope pattern
/// the register table copies (plan §2 S1). A scope selects memories only
/// (filters stay per call; no saved filter, no retrieval parameters) and
/// NEVER grants: every consumer intersects it with the caller's accessible
/// set (D-2026-09-13-004, `lib/auth/narrowToAccessible.ts`).
///
/// `name` is unique PER OWNER among live rows — partial unique indexes in
/// post-push.sql / the migration, since Prisma cannot express them and a plain
/// @@unique would let a soft-deleted row block the name forever. Collisions
/// across owners in an App's context resolve App › Agent › organization,
/// namespaced, never unioned (`lib/scopes.ts`). `global` and `app` are
/// reserved ladder tokens and refused at create.
model Scope {
  id             String    @id @default(cuid())
  name           String
  description    String?
  organizationId String?   @map("organization_id")
  agentId        String?   @map("agent_id")
  appId          String?   @map("app_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent            Agent?            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  app              App?              @relation(fields: [appId], references: [id], onDelete: Cascade)
  memories         ScopeMemory[]
  mcpSessionStates McpSessionState[]
  agentSchedules   AgentSchedule[]
  agentWebhooks    AgentWebhook[]

  @@index([organizationId])
  @@index([agentId])
  @@index([appId])
  @@map("scopes")
}

/// The ordered memory list of a Scope. A join row rather than an id array so
/// that "which scopes include this memory" is a query (D-2026-09-13-001
/// rejected ids-in-JSON for exactly that — `scope explain` and memory deletion
/// need the reverse lookup) and so a deleted memory cascades out of every
/// scope. Composite PK: listed in `MODELS_WITHOUT_ID` (db/client.ts).
model ScopeMemory {
  scopeId  String @map("scope_id")
  memoryId String @map("memory_id")
  /// 0-based order within the scope — the only thing the task-customization
  /// operation will consume; search ignores it (D-2026-09-13-005).
  position Int

  scope  Scope  @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@id([scopeId, memoryId])
  @@unique([scopeId, position])
  @@index([memoryId])
  @@map("scope_memories")
}

/// Spec 049 Phase 4 (D-2026-09-13-006) — what kind of feed a Channel is. `CHAT`
/// today; `BLOCKERS` / `TASKS` when built (D7 local, register session). Adding
/// a value that a CHECK references is TWO migration files (the Postgres
/// transaction rule).
enum ChannelKind {
  CHAT
}

/// Spec 049 Phase 4 (D-2026-09-13-006) — a CHANNEL: a durable, ordered message
/// stream hosted in ONE memory at ONE reserved address, server-ordered and
/// server-attributed, that people and Agents post to and an Agent can be told
/// about. NOT a chatbot conversation (`cor:cht`). A PLATFORM ENTITY, not the
/// chat-root node: the row is created EAGERLY, one-to-one with its chat root
/// (`chatRootNodeId`, unique), in the same transaction — that is what makes
/// "the canonical reference is the PK of the chat node" and the table one
/// thing, and what leaves nothing unprotected before the first post.
///
/// Creating a row RESERVES and PROTECTS its address: every generic node write
/// under `loc` (and any subtree operation overlapping it) is refused
/// (`src/lib/protectedLoc.ts`, spec 049 §2 S4 shape B). The Channel table is
/// the protection's ONLY source: D-2026-08-25-004 added `Memory.protectedLocs`
/// as a second one and #1201 removed it again — governance of authored kinds
/// moved to `Node.role` + `isRunnable`, a property of the WRITE rather than of
/// the address. ADDRESS-based protection is a Channel concept and only that.
/// The owning operations write
/// through their own gate. This is hadron-server#1047's closure: the loc is
/// operation-exclusive because it is protected, and protected because this
/// row declared it.
///
/// `lastSeq` / `lastMessageAt` are the platform-maintained WATERMARK
/// (D-2026-09-13-009) — the allocator's output, written inside
/// `appendChatMessage`'s lock in the same transaction as the seq. The chat
/// root's `data.messageCount` stays what it is, a routing operand; two numbers,
/// two jobs. `lastSeq − lastSeenSeq` is a watermark delta, never a message
/// count (gaps and the known prod duplicate are preserved).
///
/// Reusing a soft-deleted Channel address tombstones its old transcript and
/// resets these Channel watermarks to the empty state, but preserves the root
/// allocator history. The first new post therefore resumes above the old seq
/// maximum, which prevents a retained read cursor from hiding that message.
///
/// The audience is the HOST MEMORY's (`cor:acl:030:01`): a Channel has no
/// access layer of its own. Participation, reads and posts follow the memory.
/// Soft-deleted in step with its root; the protection holds while either exists.
model Channel {
  id             String      @id @default(cuid())
  memoryId       String      @map("memory_id")
  /// The reserved address of the chat root (e.g. `chats:team`).
  loc            String
  name           String
  kind           ChannelKind @default(CHAT)
  description    String?
  chatRootNodeId String      @unique @map("chat_root_node_id")
  lastSeq        Int         @default(0) @map("last_seq")
  lastMessageAt  DateTime?   @map("last_message_at")
  /// Monotonic identity of the live occupancy at this reserved address.
  /// Incremented when a tombstoned Channel is reused so requests resolved
  /// against the previous incarnation cannot post to or delete the new one.
  incarnation    Int         @default(1)
  createdAt      DateTime    @default(now()) @map("created_at")
  createdBy      String?     @map("created_by")
  updatedAt      DateTime?   @updatedAt @map("updated_at")
  updatedBy      String?     @map("updated_by")
  deletedAt      DateTime?   @map("deleted_at")
  deletedBy      String?     @map("deleted_by")

  memory          Memory             @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  chatRoot        Node               @relation("ChannelRoot", fields: [chatRootNodeId], references: [id], onDelete: Cascade)
  defaultOfApps   App[]              @relation("AppDefaultChannel")
  registerEntries RegisterEntry[]
  readStates      ChannelReadState[]

  /// One Channel per address.
  @@unique([memoryId, loc])
  @@index([memoryId])
  @@map("channels")
}

/// Spec 049 Phase 5 — what a register row declares about an attendee's
/// relationship to a Channel: INTENT, never permission (D-2026-09-13-008).
enum RegisterRole {
  WATCH
  POST
  BOTH
}

/// Spec 049 Phase 5 — a REGISTER ENTRY (D-2026-09-13-007, §14 corrections 1
/// and 2): "this attendee takes part in this Channel". Owned by exactly ONE of
/// an organization or an App (S1: `chk_register_owner`). The attendee is a
/// Worker when cast, otherwise an Agent in an App; BOTH NULL means every
/// attendee in the owner's context (org-wide for an org row, App-wide for an
/// App row) — one row for "every Agent attends the announcements channel".
///
/// Not a trigger list: a row here never starts a run. Not exportable
/// (D-2026-08-25-006): platform instrumentation, excluded from memory export
/// and the git mirror. The register never grants — `canRead` / `canPost` are
/// the host memory's gates, evaluated at read time (Phase 6).
///
/// Partial uniques per (owner, channel, attendee) WHERE deleted_at IS NULL —
/// the install default's natural key (`post-push.sql`, the migration).
model RegisterEntry {
  id               String       @id @default(cuid())
  organizationId   String?      @map("organization_id")
  appId            String?      @map("app_id")
  channelId        String       @map("channel_id")
  attendeeWorkerId String?      @map("attendee_worker_id")
  attendeeAgentId  String?      @map("attendee_agent_id")
  role             RegisterRole @default(BOTH)
  mentionOnly      Boolean      @default(false) @map("mention_only")
  /// The human's intent, free text (D1).
  description      String?
  /// D2 — the row install materialised for the App's default Channel; an App
  /// may remove it (D4), uninstall removes it.
  installDefault   Boolean      @default(false) @map("install_default")
  createdAt        DateTime     @default(now()) @map("created_at")
  createdBy        String?      @map("created_by")
  updatedAt        DateTime?    @updatedAt @map("updated_at")
  updatedBy        String?      @map("updated_by")
  deletedAt        DateTime?    @map("deleted_at")
  deletedBy        String?      @map("deleted_by")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  app            App?          @relation("RegisterOwnerApp", fields: [appId], references: [id], onDelete: Cascade)
  channel        Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  attendeeWorker Worker?       @relation("RegisterAttendeeWorker", fields: [attendeeWorkerId], references: [id], onDelete: Cascade)
  attendeeAgent  Agent?        @relation("RegisterAttendeeAgent", fields: [attendeeAgentId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([organizationId])
  @@index([appId])
  @@index([attendeeWorkerId])
  @@index([attendeeAgentId])
  @@map("register_entries")
}

/// Spec 049 Phase 7 — per ATTENDEE per Channel: where this attendee is up to
/// (D-2026-09-13-009, §14 correction 1). OUTSIDE the register: a cursor on the
/// register row "mixes what-I-attend with where-I-am and the relay would keep
/// a second copy". Keyed on the attendee, not the bare Agent — two Workers
/// cast from one Agent in one App must not share a cursor. Advances are
/// MONOTONIC (`GREATEST`, `lib/channelReadState.ts`): an older transaction
/// never overwrites a newer cursor; concurrent runs may both see a window as
/// new — duplicate attention, never skipped attention. Mute is session state,
/// never a column here (D16 local).
///
/// CHECKs `chk_read_state_attendee` (exactly one of worker / agent) and
/// `chk_read_state_agent_app` (an Agent attendee carries its App); partial
/// uniques on (worker, channel) and (agent, app, channel) — post-push.sql.
model ChannelReadState {
  id                 String    @id @default(cuid())
  workerId           String?   @map("worker_id")
  agentId            String?   @map("agent_id")
  appId              String?   @map("app_id")
  channelId          String    @map("channel_id")
  lastSeenSeq        Int       @default(0) @map("last_seen_seq")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  /// #2138 §3.1 — when the worker last CHECKED this channel through its own bound session (a page read, an
  /// inbox read or a mark-read, an empty one included). Stamped only by `stampChannelCheck`; a read by a
  /// person (asMe), by another worker or of another channel never moves it. NULL = never checked.
  lastCheckedAt      DateTime? @map("last_checked_at")
  /// #2181 — the Channel incarnation the stored cursor was last RAISED under. Written by `advanceReadState` in the
  /// same statement that creates the row or raises `lastSeenSeq` (an equal or lower mark changes neither). NULL =
  /// legacy or never advanced under a known incarnation; it is never backfilled and never relabelled, so a stale cursor
  /// is not presented as current.
  channelIncarnation Int?      @map("channel_incarnation")

  worker  Worker? @relation("ReadStateWorker", fields: [workerId], references: [id], onDelete: Cascade)
  agent   Agent?  @relation("ReadStateAgent", fields: [agentId], references: [id], onDelete: Cascade)
  app     App?    @relation("ReadStateApp", fields: [appId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([workerId])
  @@index([agentId, appId])
  @@map("channel_read_states")
}

// ─────────────────────────────────────────────────────────────────────────────
// #1325 (concept#74 L1.1, D-2026-09-24-002) — node kinds are PROCEDURE, held in
// a per-memory MemoryConfig; the object store (Memory.schema) keeps SHAPE.
// ─────────────────────────────────────────────────────────────────────────────

/// Who may write nodes of a role (D-2026-09-24-005). Enforced in the
/// authorization layer, never in a door (#1331 ALL/ADMIN, #1333 OWNER).
enum NodeRoleWriters {
  ALL
  OWNER
  ADMIN
}

/// Who runs a rule's validation task (D-2026-09-24-004): an agent in a
/// separate context, or the platform on a node-written trigger (#1332/#1335).
enum ContentValidator {
  AGENT
  PLATFORM
}

/// A memory's complete rulebook: exactly one per memory, by construction.
/// `memoryId @unique` makes it at most one; an ABSENT row reads as the empty
/// config, so every memory has one without a backfill or a creation hook, and
/// the first rule write materializes it. Not shared between memories —
/// templates are the shared, owned thing, and they are COPIED in (Holger,
/// 2026-09-25, #1325 H4). Read and managed only by the memory's managers;
/// enforcement loads it internally for any writer.
model MemoryConfig {
  id        String    @id @default(cuid())
  memoryId  String    @unique @map("memory_id")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  memory Memory         @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  rules  NodeRoleRule[]

  @@map("memory_configs")
}

/// One row per role or dotted sub-role (`spec`, `spec.rule`): the rows ARE
/// the config's declared roles, and a row may carry no tasks at all
/// (#1325 H1). `strictSubRoles` on a parent row refuses its undeclared
/// sub-roles; off, an undeclared sub-role falls back to the nearest declared
/// ancestor (#1322's lookup).
///
/// Task references are node-id FKs — accepted and shown as URNs — so moving a
/// task keeps the rule (moveNode keeps ids, even across memories). A HARD
/// delete of the task (replaceSubtree, git sync of a removed file, memory
/// deletion) nulls the FK; the `*TaskRequired` marker survives it, so the rule
/// FAILS CLOSED instead of silently ceasing to require the task (#1325 H5).
/// Cascade and Restrict were rejected: the first drops governance, the second
/// lets whoever references a public task veto its owner's own deletes.
model NodeRoleRule {
  id                     String            @id @default(cuid())
  configId               String            @map("config_id")
  role                   String
  authorTaskId           String?           @map("author_task_id")
  authorTaskRequired     Boolean           @default(false) @map("author_task_required")
  validationTaskId       String?           @map("validation_task_id")
  validationTaskRequired Boolean           @default(false) @map("validation_task_required")
  descriptionNodeId      String?           @map("description_node_id")
  strictSubRoles         Boolean           @default(false) @map("strict_sub_roles")
  writers                NodeRoleWriters   @default(ALL)
  validateBy             ContentValidator? @map("validate_by")
  enabled                Boolean           @default(true)
  /// #1334 — the template this rule was copied from. Provenance only, no FK:
  /// a template is copied in, never live-linked, so deleting one must not
  /// rewrite the configs it was applied to.
  sourceTemplateId       String?           @map("source_template_id")
  /// #1334 — set by a REQUIRED template; only org admins may change the rule.
  locked                 Boolean           @default(false)
  /// Optimistic-concurrency counter (#1325, cli#716 Q1): starts at 1, +1 on
  /// every update; a mutation passing `expectedRevision` refuses CONFLICT when
  /// it no longer matches, so a stale read can never overwrite a newer write.
  revision               Int               @default(1)
  createdAt              DateTime          @default(now()) @map("created_at")
  createdBy              String?           @map("created_by")
  updatedAt              DateTime?         @updatedAt @map("updated_at")
  updatedBy              String?           @map("updated_by")

  config          MemoryConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  authorTask      Node?        @relation("NodeRoleRuleAuthorTask", fields: [authorTaskId], references: [id], onDelete: SetNull)
  validationTask  Node?        @relation("NodeRoleRuleValidationTask", fields: [validationTaskId], references: [id], onDelete: SetNull)
  descriptionNode Node?        @relation("NodeRoleRuleDescriptionNode", fields: [descriptionNodeId], references: [id], onDelete: SetNull)

  @@unique([configId, role])
  @@index([authorTaskId])
  @@index([validationTaskId])
  @@index([descriptionNodeId])
  @@map("node_role_rules")
}

/// A reusable rulebook owned by EXACTLY ONE of HadronServer / Organization /
/// User / App — nullable FKs with a CHECK (`chk_memory_config_template_owner`,
/// `num_nonnulls(...) = 1`), never an owner-kind string (the Scope /
/// AiServiceConfig mechanism, plus a User owner AiServiceConfig does not
/// have). Applied by COPYING its rules into a memory's config (#1334); editing
/// a template changes no memory until it is re-applied. `required` templates
/// arrive locked. `name` is unique per owner among live rows (partial unique
/// indexes in post-push.sql / the migration).
model MemoryConfigTemplate {
  id             String    @id @default(cuid())
  name           String
  description    String?
  required       Boolean   @default(false)
  /// Optimistic-concurrency counter, as on NodeRoleRule. Rules are replaced
  /// wholesale with the template, so the template's revision covers them.
  revision       Int       @default(1)
  hadronServerId String?   @map("hadron_server_id")
  organizationId String?   @map("organization_id")
  ownerUserId    String?   @map("owner_user_id")
  appId          String?   @map("app_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  hadronServer HadronServer?              @relation(fields: [hadronServerId], references: [id], onDelete: Cascade)
  organization Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUser    User?                      @relation("MemoryConfigTemplateOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  app          App?                       @relation(fields: [appId], references: [id], onDelete: Cascade)
  rules        MemoryConfigTemplateRule[]

  @@index([hadronServerId])
  @@index([organizationId])
  @@index([ownerUserId])
  @@index([appId])
  @@map("memory_config_templates")
}

/// A template's rule: NodeRoleRule's columns minus the per-memory provenance
/// and lock, with the same node-id FK + fail-closed marker semantics.
model MemoryConfigTemplateRule {
  id                     String            @id @default(cuid())
  templateId             String            @map("template_id")
  role                   String
  authorTaskId           String?           @map("author_task_id")
  authorTaskRequired     Boolean           @default(false) @map("author_task_required")
  validationTaskId       String?           @map("validation_task_id")
  validationTaskRequired Boolean           @default(false) @map("validation_task_required")
  descriptionNodeId      String?           @map("description_node_id")
  strictSubRoles         Boolean           @default(false) @map("strict_sub_roles")
  writers                NodeRoleWriters   @default(ALL)
  validateBy             ContentValidator? @map("validate_by")
  enabled                Boolean           @default(true)

  template        MemoryConfigTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  authorTask      Node?                @relation("TemplateRuleAuthorTask", fields: [authorTaskId], references: [id], onDelete: SetNull)
  validationTask  Node?                @relation("TemplateRuleValidationTask", fields: [validationTaskId], references: [id], onDelete: SetNull)
  descriptionNode Node?                @relation("TemplateRuleDescriptionNode", fields: [descriptionNodeId], references: [id], onDelete: SetNull)

  @@unique([templateId, role])
  @@index([authorTaskId])
  @@index([validationTaskId])
  @@index([descriptionNodeId])
  @@map("memory_config_template_rules")
}

/// #1655 DAE/DAG: immutable compiled code; approval is the temporary DZ-3
/// bridge until passkey signatures ship. Identity strings preserve audit history.
enum AutomationTier {
  PERSON
  APP
}

/// #2441 — append-only record of every approval, decline and revocation of an
/// automation's consent (cor:agt:010:01). Written in the SAME transaction as
/// the pin change by `adoptionDoor` (resolvers.automationPin.ts) and nowhere
/// else. The trigger id, the actor and the org carry no FK on purpose: history
/// must survive trigger deletion and user erasure, and an FK action would have
/// to UPDATE a row the trigger refuses to update. The App FK cascades so a hard
/// delete still works (the trigger lets a DELETE through once the App is gone).
model AutomationAdoptionEvent {
  id             String   @id @default(cuid())
  appId          String   @map("app_id")
  /// The App's organization; null for a user-owned App.
  organizationId String?  @map("organization_id")
  /// SCHEDULE | WEBHOOK | MANUAL (CHECK in automation-adoption-invariants.sql).
  triggerKind    String   @map("trigger_kind")
  /// The trigger row id; for MANUAL, the origin run id. Plain text, no FK.
  triggerRef     String   @map("trigger_ref")
  /// APPROVE | DECLINE | REVOKE (CHECK).
  action         String
  actorUserId    String   @map("actor_user_id")
  /// APPROVE: the adopted hash. REVOKE: the hash of the removed pin. DECLINE
  /// with nothing adopted: null.
  pinHash        String?  @map("pin_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt])
  @@index([triggerKind, triggerRef, createdAt])
  @@map("automation_adoption_events")
}

/// #2484 (cor:agt:010:01, epic #2435) — an App's write grant on ONE memory under ONE loc prefix, for its USERLESS
/// runs only: the register-recorded grant the Open paragraph rules on. One row per (App, memory, prefix); the prefix
/// is required and matches the loc itself and its `:`-boundary descendants only, judged on the destination after
/// `writeTo` expansion, at write time (`src/lib/appWriteGrant.ts`). A row is never edited: it ends with a terminal
/// `revokedAt` (trigger + CHECKs in app-memory-write-grant-invariants.sql, where the partial unique index also lives).
/// `grantedBy` / `revokedBy` carry no FK on purpose: they are sealed history of who acted and must survive user
/// erasure. `registerNodeUrn` is a citation of the register line, never evidence that the line exists.
model AppMemoryWriteGrant {
  id              String    @id @default(cuid())
  appId           String    @map("app_id")
  memoryId        String    @map("memory_id")
  prefix          String
  registerNodeUrn String?   @map("register_node_urn")
  grantedBy       String    @map("granted_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  revokedBy       String?   @map("revoked_by")

  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt])
  @@index([memoryId])
  @@map("app_memory_write_grants")
}

/// #2484 — append-only record of every grant and revocation of an App memory write grant: who, which App, which
/// memory, which prefix, and nothing of any node's content. Written in the SAME transaction as the row change by
/// `src/lib/appWriteGrant.ts` and nowhere else. The memory, grant and actor carry no FK on purpose: history must
/// survive their deletion. The App FK cascades so a hard delete still works (the trigger lets a DELETE through once
/// the App is gone).
model AppMemoryWriteGrantEvent {
  id          String   @id @default(cuid())
  appId       String   @map("app_id")
  memoryId    String   @map("memory_id")
  grantId     String   @map("grant_id")
  prefix      String
  /// GRANT | REVOKE (CHECK in app-memory-write-grant-invariants.sql).
  action      String
  actorUserId String   @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, createdAt])
  @@index([grantId])
  @@map("app_memory_write_grant_events")
}

/// #430 (first slice) — a Git-mirror attempt that did NOT land, recorded so the divergence is no longer silent.
/// One row per (memory, node, kind, remove_loc): a WRITE row per node, plus one REMOVE row per distinct old loc a move
/// left behind (remove_loc is '' for WRITE). `node_id` carries NO foreign key on purpose, so a REMOVE row survives the
/// node's hard delete; the memory FK cascades. A row exists only while the last settled attempt failed: success, and
/// ordinary writes to a memory that is not mirrored delete it. The sweep leaves ineligible memories untouched.
/// `attempt_seq` comes from
/// `git_mirror_attempt_seq`, taken INSIDE the per-memory checkout lock and settled before it releases, so a stale
/// settle can never overwrite a newer one (src/integrations/github/mirrorObligations.ts). `error_class` is a fixed,
/// CHECK-constrained set (git-mirror-obligation-invariants.sql); no exception text, URL or token is ever stored.
/// The sweep retries recorded failures only, with capped attempts; no writer-side PENDING or new triggers.
model GitMirrorObligation {
  memoryId      String                   @map("memory_id")
  nodeId        String                   @map("node_id")
  kind          GitMirrorObligationKind
  removeLoc     String                   @default("") @map("remove_loc")
  state         GitMirrorObligationState
  errorClass    String                   @map("error_class")
  attempts      Int                      @default(1)
  attemptSeq    BigInt                   @map("attempt_seq")
  lastAttemptAt DateTime                 @default(now()) @map("last_attempt_at")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@id([memoryId, nodeId, kind, removeLoc])
  @@index([memoryId, state])
  @@map("git_mirror_obligations")
}

enum GitMirrorObligationKind {
  WRITE
  REMOVE

  @@map("git_mirror_obligation_kind")
}

/// FAILED = retryable failure; NOT_CLONED = no local clone; EXHAUSTED = sweep cap reached (ordinary writes still settle).
enum GitMirrorObligationState {
  FAILED
  NOT_CLONED
  EXHAUSTED

  @@map("git_mirror_obligation_state")
}

model AutomationVersion {
  id                String         @id @default(cuid())
  appId             String         @map("app_id")
  app               App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  number            Int
  entrySourceNodeId String         @map("entry_source_node_id")
  compiledJson      String         @map("compiled_json")
  versionHash       String         @map("version_hash")
  sourceManifest    Json           @map("source_manifest")
  tier              AutomationTier
  runAsUserId       String?        @map("run_as_user_id")
  publishedBy       String         @map("published_by")
  publishedAt       DateTime       @default(now()) @map("published_at")
  approvalHash      String?        @map("approval_hash")
  approvedBy        String?        @map("approved_by")
  approvedAt        DateTime?      @map("approved_at")
  revokedBy         String?        @map("revoked_by")
  revokedAt         DateTime?      @map("revoked_at")

  @@unique([appId, entrySourceNodeId, number])
  @@index([appId])
  @@map("automation_versions")
}

/// #1705 (Task Management T1) — one piece of work a team App has assigned, or
/// wants assigned (cor:agt:050:01). The platform records who holds it, since
/// when, and how it ended; it never reads what the work is.
///
/// Shape (CHECK `chk_agent_tasks_shape`, prisma/agent-task-invariants.sql):
/// exactly one owner and at most one assignee, each a Worker OR a User; the
/// status vocabulary; per-status timestamps; a result only on a finished task.
/// `queued` (cor:agt:050:03) and `waitingOnChildren` (cor:agt:050:04) are
/// DERIVED at read time, never stored.
///
/// Worker / User references are NO ACTION, not RESTRICT: an App hard delete
/// cascades its workers and its tasks in one statement, and NO ACTION checks at
/// the END of that statement, after both are gone. A worker with tasks is
/// otherwise in use (`deleteWorker` refuses WORKER_IN_USE).
model AgentTask {
  id                   String    @id @default(cuid())
  appId                String    @map("app_id")
  /// #2553: this task's own segment of its handle: the project number (counted per App) for a top-level row, else the
  /// number counted within its parent. Assigned once at creation from `agent_task_counters`, never changed or reissued.
  /// 0 is the reserved project `AT0` ("no project"). NOT NULL in the database (prisma/agent-task-number-invariants.sql,
  /// which also fills it for any writer that leaves it out); optional here only so a writer need not state it.
  taskNumber           BigInt?   @map("task_number")
  /// #2553: the full dotted handle (`AT3.405.16`), composed once at creation from the parent's handle and never
  /// recomputed: parentage is fixed at creation (a trigger refuses UPDATE of parent_task_id), so it always matches the tree.
  handle               String?
  /// What is asked, in the team's own words. Never read by the platform.
  title                String
  description          String?
  /// Opaque origin reference (an issue URL, a node URN). Not interpreted.
  source               String?
  /// Null for a root task. Always in the same App (cor:agt:050:01).
  parentTaskId         String?   @map("parent_task_id")
  ownerWorkerId        String?   @map("owner_worker_id")
  ownerUserId          String?   @map("owner_user_id")
  /// Both null ⇒ queued while pending (cor:agt:050:03).
  assigneeWorkerId     String?   @map("assignee_worker_id")
  assigneeUserId       String?   @map("assignee_user_id")
  /// For the matcher (T3): `{ role?, familyIn?, familyNotIn?, excludeWorkerIds? }`.
  requirements         Json?
  /// #2420 (cor:agt:050:28): this task's OWN optional, platform-opaque JSON object (the team's namespaces: review
  /// schedule, complexity, a seat's reviewed head). Never inherited, never matcher or authorization input; written by
  /// the cor:agt:050:09 set and the task's assignee, validated against the Team Agent's `schema:task-properties`.
  properties           Json?
  /// 'backlog' | 'pending' | 'started' | 'finished' | 'cancelled' (cor:agt:050:02).
  /// 'backlog' (#1754): parked — no assignee, not matched, never waited on, no alarms.
  status               String    @default("pending")
  /// #2644: 1 is highest; existing tasks retain FIFO within default priority1.
  priority             Int       @default(1) @db.SmallInt
  /// Maintained transactionally with the blocker graph, never caller supplied.
  blocked              Boolean   @default(false)
  releasedAt           DateTime? @map("released_at")
  startBy              DateTime? @map("start_by")
  /// #2648 (cor:agt:050:14): the finish-by deadline. Set, it exempts the task from every stall window; one alarm
  /// when it passes with the task neither finished nor cancelled.
  finishBy             DateTime? @map("finish_by")
  startedAt            DateTime? @map("started_at")
  finishedAt           DateTime? @map("finished_at")
  cancelledAt          DateTime? @map("cancelled_at")
  /// The result (cor:agt:050:01) — set only on finish.
  resultOutcome        String?   @map("result_outcome")
  resultSummary        String?   @map("result_summary")
  resultEvidence       String?   @map("result_evidence")
  tags                 String[]  @default([])
  /// #2649 (cor:agt:050:01 References, :09): the task's ordered typed references, a JSON array of
  /// {kind, target, label} (at most 20, chk_agent_tasks_references). Targets are stored as given and never resolved.
  /// Column named task_references: REFERENCES is reserved in SQL.
  references           Json      @default("[]") @map("task_references")
  /// Set by whoever assigns; T6 acts on it (cor:agt:050:10). False unless the assigner asks (R182, #2249): the
  /// default only reaches a raw insert, since every create path writes the resolved value.
  closeSessionWhenDone Boolean   @default(false) @map("close_session_when_done")
  /// The latest assignment, by hand or by the matcher, in the #1610 actor shape.
  assignedAt           DateTime? @map("assigned_at")
  assignedBy           String?   @map("assigned_by")
  assignedByWorkerId   String?   @map("assigned_by_worker_id")
  assignedByAgentId    String?   @map("assigned_by_agent_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  createdBy            String?   @map("created_by")
  createdByWorkerId    String?   @map("created_by_worker_id")
  createdByAgentId     String?   @map("created_by_agent_id")
  /// #1756 (cor:agt:050:06): the headless run that created the task, when one did.
  /// Then createdBy / createdByWorkerId / createdByAgentId are all null. A plain
  /// id, not a foreign key: a run is pruned long before its tasks are.
  createdByRunId       String?   @map("created_by_run_id")
  updatedAt            DateTime? @updatedAt @map("updated_at")
  updatedBy            String?   @map("updated_by")
  updatedByWorkerId    String?   @map("updated_by_worker_id")
  updatedByAgentId     String?   @map("updated_by_agent_id")

  app            App                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  parent         AgentTask?          @relation("AgentTaskParent", fields: [parentTaskId], references: [id], onDelete: NoAction)
  children       AgentTask[]         @relation("AgentTaskParent")
  /// #2553: the counter of the numbers issued under this task.
  childCounters  AgentTaskCounter[]
  blockerLinks AgentTaskBlocker[] @relation("TaskBlockedBy")
  dependentLinks AgentTaskBlocker[] @relation("TaskBlocks")
  ownerWorker    Worker?             @relation("AgentTaskOwnerWorker", fields: [ownerWorkerId], references: [id], onDelete: NoAction)
  ownerUser      User?               @relation("AgentTaskOwnerUser", fields: [ownerUserId], references: [id], onDelete: NoAction)
  assigneeWorker Worker?             @relation("AgentTaskAssigneeWorker", fields: [assigneeWorkerId], references: [id], onDelete: NoAction)
  assigneeUser   User?               @relation("AgentTaskAssigneeUser", fields: [assigneeUserId], references: [id], onDelete: NoAction)
  /// #2022 — times stop signals kept this task from being assigned.
  stopHolds      AgentTaskStopHold[]

  @@index([appId, status, priority, createdAt, id])
  @@unique([appId, handle])
  @@index([appId, status])
  @@index([parentTaskId])
  @@index([ownerWorkerId])
  @@index([ownerUserId])
  @@index([assigneeWorkerId])
  @@index([assigneeUserId])
  @@map("agent_tasks")
}

/// #2644: same-App acyclic dependency graph, guarded by task-blocker-invariants.sql.
model AgentTaskBlocker {
  taskId String @map("task_id")
  blockerTaskId String @map("blocker_task_id")
  createdAt DateTime @default(now()) @map("created_at")
  task AgentTask @relation("TaskBlockedBy", fields: [taskId], references: [id], onDelete: Cascade)
  blocker AgentTask @relation("TaskBlocks", fields: [blockerTaskId], references: [id], onDelete: Cascade)
  @@id([taskId, blockerTaskId])
  @@index([blockerTaskId])
  @@map("agent_task_blockers")
}

/// #2553: the last number issued under one parent: `parentTaskId` NULL is the App's project counter. Its own table, so a
/// task create serializes against other creates under the SAME parent only and never takes the App row exclusively
/// (the App row stays a shared authority anchor). The one-row-per-App project counter is a partial unique index in
/// prisma/agent-task-number-invariants.sql (Prisma cannot model it; NULLs are distinct in the unique below).
model AgentTaskCounter {
  id           String  @id @default(cuid())
  appId        String  @map("app_id")
  parentTaskId String? @map("parent_task_id")
  lastNumber   BigInt  @map("last_number")

  app        App        @relation(fields: [appId], references: [id], onDelete: Cascade)
  parentTask AgentTask? @relation(fields: [parentTaskId], references: [id], onDelete: Cascade)

  @@unique([appId, parentTaskId])

  @@map("agent_task_counters")
}

/// #1705 — one append-only record of something that happened in a team App's
/// task work (cor:agt:050:11). Never changed or removed: the trigger in
/// prisma/agent-task-invariants.sql refuses every UPDATE except the one-time
/// acknowledgement of an alarm, refuses an INSERT that arrives acknowledged,
/// and refuses a DELETE unless the App itself is gone (the cascade).
///
/// `payload` carries counts, outcomes, reasons and ids only — never message or
/// description text (cor:agt:050:11, Proposed); src/lib/agentTasks/events.ts
/// is its only writer. Actor and subject ids carry no FK on purpose: they are a
/// sealed record of who acted, and an FK action would have to UPDATE the row.
model AgentTeamEvent {
  id                     String    @id @default(cuid())
  appId                  String    @map("app_id")
  /// e.g. `task.created`, `task.assigned` (cor:agt:050:11).
  type                   String
  taskId                 String?   @map("task_id")
  /// Who acted, in the #1610 shape: the human credential, plus the Worker /
  /// Agent bound to the request's session.
  actorUserId            String?   @map("actor_user_id")
  actorWorkerId          String?   @map("actor_worker_id")
  actorAgentId           String?   @map("actor_agent_id")
  /// #1756: the headless run that acted, when one did; the other actor columns are then null.
  actorRunId             String?   @map("actor_run_id")
  /// The worker the event concerns, if any (e.g. the new assignee).
  subjectWorkerId        String?   @map("subject_worker_id")
  /// null for an ordinary event, 'alarm' for an alarm.
  severity               String?
  /// Alarms only: the owner chain when raised, nearest first.
  chain                  Json?
  acknowledgedByUserId   String?   @map("acknowledged_by_user_id")
  acknowledgedByWorkerId String?   @map("acknowledged_by_worker_id")
  acknowledgedAt         DateTime? @map("acknowledged_at")
  payload                Json      @default("{}")
  createdAt              DateTime  @default(now()) @map("created_at")
  /// #1706 — stall alarms only: when the stall episode began (cor:agt:050:13),
  /// the instant of the move that began the condition, never the evaluator's
  /// clock. With `taskId` and `type` (the rule) it is the episode's key, and
  /// the unique index below is what makes "exactly one alarm per episode"
  /// hold across concurrent evaluator passes: a second insert of the same
  /// episode is ON CONFLICT DO NOTHING, not a read-then-write. NULL on every
  /// other event, and NULLs are distinct, so ordinary events never collide.
  episodeStart           DateTime? @map("episode_start")

  app        App                       @relation(fields: [appId], references: [id], onDelete: Cascade)
  wakes      AgentTeamAlarmSchedule[]
  deliveries WorkerDeliveryTaskEvent[]
  darkEpisode DarkWorkerEpisode?
  postLimitEpisode PostLimitEpisode?

  @@unique([taskId, type, episodeStart], map: "agent_team_events_episode_uniq")
  @@index([appId, createdAt])
  @@index([taskId])
  /// #1707 — "assigned least recently" (cor:agt:060:06) reads a worker's
  /// latest assignment event.
  @@index([subjectWorkerId, createdAt])
  @@map("agent_team_events")
}

/// #1706 — who an alarm wakes, and when (cor:agt:050:19). One row per owner in
/// the alarm's `chain`, by its index there: the nearest owner (index 0) is
/// woken when the alarm is raised, and owner i is due `i` windows later. The
/// stall evaluator stamps `wokenAt` once a row is due and its alarm is still
/// unacknowledged; acknowledging stops every later row (cor:agt:050:20).
///
/// A side table because the alarm event is append-only. "Woken" here is the
/// platform's record that the owner is now due a wake-up; DELIVERING it is the
/// heartbeat slice's (T5). A person in the chain is recorded as woken the same
/// way, and the timer runs on past them.
model AgentTeamAlarmSchedule {
  eventId    String    @map("event_id")
  chainIndex Int       @map("chain_index")
  dueAt      DateTime  @map("due_at")
  wokenAt    DateTime? @map("woken_at")
  /// #2200 (R196) — when the escalation found that the alarm's OWN episode had ended (the task moved, so the
  /// condition no longer holds) and closed this row unwoken. Woken or ended, never both
  /// (chk_agent_team_alarm_schedule_shape); the alarm event, its chain and every `woken_at` stay as written.
  endedAt    DateTime? @map("ended_at")

  event AgentTeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, chainIndex])
  @@index([wokenAt, dueAt])
  @@map("agent_team_alarm_schedule")
}

/// #2755 — one dark-worker episode (a worker that went OVERDUE or left a due wake unacknowledged past the App's
/// window). The alarm event stream is append-only, so an episode's end lives here. At most one OPEN row per
/// worker (partial unique index in prisma/dark-alarm-invariants.sql): the worker's single open episode across both
/// reasons. `reason` is the trigger that opened it. The episode ends when BOTH conditions have cleared.
model DarkWorkerEpisode {
  id       String    @id @default(cuid())
  appId    String    @map("app_id")
  workerId String    @map("worker_id")
  /// The task-less alarm raised with the episode (agent_team_events, type `alarm.dark-worker`).
  eventId  String    @unique @map("event_id")
  /// `overdue` | `wake-unacked`.
  reason   String
  openedAt DateTime  @map("opened_at")
  endedAt  DateTime? @map("ended_at")
  /// When the platform's one team-channel post for this episode was written; NULL until then (retried each pass while the episode is open).
  noticePostedAt DateTime? @map("notice_posted_at")

  app    App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  worker Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  event  AgentTeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([appId, endedAt])
  @@map("dark_worker_episodes")
}

/// #2014 — one post-limit episode: the first refusal of a worker's team-chat post by the rate limit in an hour. It only
/// de-duplicates the alarm raised with it (agent_team_events, type `alarm.post-limit`); the alarm itself stays open until
/// acknowledged. At most one OPEN row per worker (partial unique index in prisma/post-limit-invariants.sql); an open
/// episode older than an hour is closed (`endedAt = openedAt + 1 hour`) by the next refusal, which then opens a new one.
model PostLimitEpisode {
  id       String    @id @default(cuid())
  appId    String    @map("app_id")
  workerId String    @map("worker_id")
  eventId  String    @unique @map("event_id")
  openedAt DateTime  @map("opened_at")
  endedAt  DateTime? @map("ended_at")

  app    App            @relation(fields: [appId], references: [id], onDelete: Cascade)
  worker Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  event  AgentTeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([appId, endedAt])
  @@map("post_limit_episodes")
}

/// #1706 — one worker's availability for work (cor:agt:060:02). At most one
/// row per worker, and a worker with none is available (Proposed). The row is
/// kept when the worker becomes available again, for history. An `until` that
/// has passed reads as available at once, and the matcher's sweep rewrites the
/// row to `available`, set by `lapse`, with one event (#1766).
///
/// `setBy` names the setter class of cor:agt:060:08: `worker` (itself, only to
/// unavailable), `holder`, `app-manager`, `reports-to` (#1759: the worker it
/// reports to, only clearing a stall-rule mark, 060:11), `stall-rule` (060:07)
/// or `host` (T6); or `lapse` (#1766), the platform recording a passed `until`.
/// The actor ids follow the #1610 shape. Shape: chk_worker_availability_shape
/// (prisma/agent-task-stall-invariants.sql).
model WorkerAvailability {
  workerId              String    @id @map("worker_id")
  /// 'available' | 'unavailable'.
  state                 String
  /// Unavailable only: 'stalled' | 'out-of-tokens' | 'host-down' | 'other'.
  reason                String?
  until                 DateTime?
  setAt                 DateTime  @map("set_at")
  setBy                 String    @map("set_by")
  setByUserId           String?   @map("set_by_user_id")
  setByWorkerId         String?   @map("set_by_worker_id")
  setByAgentId          String?   @map("set_by_agent_id")
  /// #1709 — the host whose key set this record (`setBy = host` only), so a
  /// host clears only its own marks (cor:agt:060:08).
  setByHostId           String?   @map("set_by_host_id")
  /// #2162 (cor:agt:050:27) — a `resetting` mark only: the instant the host reported the old agent stopped. The
  /// worker's first activity AFTER it ends the mark (the relaunched agent's first call); null while the old agent may
  /// still be running, when no activity ends it.
  clearsOnActivityAfter DateTime? @map("clears_on_activity_after")
  /// #2162 (cor:agt:050:27) — a `resetting` mark only, and always on one: the reset that claimed it. A reset moves or
  /// releases only its own mark, so an older reset still open after its lease lapsed never touches a newer one's.
  /// No FK: both rows go with their worker (cascade), and the shape CHECK pairs this with the reason.
  contextResetId        String?   @map("context_reset_id")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_availability")
}

/// #2831 S1 (cor:agt:060:12) — a model group: an opaque name over a list of model
/// patterns (globs), declared by the team Agent (`agentId`) or by an App (`appId`,
/// an override of the Agent's group of that name, or an App-only group). Exactly
/// one owner (chk_model_group_owner). Resolved LIVE at match time, App's row else
/// the Agent's (src/lib/agentTasks/modelGroups.ts); never copied at install. The
/// platform gives name and patterns no meaning, and a group is never an
/// authorization input. `name` and every pattern are stored lowercase.
model ModelGroup {
  id        String    @id @default(cuid())
  name      String
  agentId   String?   @map("agent_id")
  appId     String?   @map("app_id")
  patterns  String[]
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  app   App?   @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([agentId, name])
  @@unique([appId, name])
  @@map("model_groups")
}

/// #1706 — one model family's availability for work in one App
/// (cor:agt:060:03): at most one row per App and family; with none, the family
/// is available. Set only by whoever manages the App (cor:agt:060:09).
model ModelFamilyAvailability {
  appId         String    @map("app_id")
  /// The model family, e.g. `claude`, `codex`, `glm` (cor:agt:060:04).
  family        String
  state         String
  reason        String?
  until         DateTime?
  setAt         DateTime  @map("set_at")
  setByUserId   String?   @map("set_by_user_id")
  setByWorkerId String?   @map("set_by_worker_id")
  setByAgentId  String?   @map("set_by_agent_id")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, family])
  @@map("model_family_availability")
}

/// #1706 — an App's stall windows, in minutes (cor:agt:050:14–:17 "What Can
/// Change"). A NULL column, or no row, means the platform default
/// (src/lib/agentTasks/stall.ts STALL_WINDOW_DEFAULTS). Tunables, not
/// contract; set by whoever manages the App.
model AgentTaskStallSchedule {
  appId                    String   @id @map("app_id")
  notStartedMinutes        Int?     @map("not_started_minutes")
  noProgressMinutes        Int?     @map("no_progress_minutes")
  ownerReactionMinutes     Int?     @map("owner_reaction_minutes")
  assignmentMinutes        Int?     @map("assignment_minutes")
  /// #1763 (cor:agt:070:01) — how many of a host's own check-in intervals may
  /// pass without a refresh before its registration in this App lapses: 2 to
  /// 10 (chk_agent_task_stall_schedule_range); null is the default, 3.
  hostLapseCheckIns        Int?     @map("host_lapse_check_ins")
  /// #1709 (cor:agt:050:10) — how many minutes a worker asked to end its
  /// session on its task's finish or cancellation has before the platform ends
  /// it through its host: 1 to 1440; null is the default, 10.
  sessionEndGraceMinutes   Int?     @map("session_end_grace_minutes")
  /// #1881 (cor:agt:070:02) — how many minutes a host has to report an
  /// operation it collected before the platform fails it: 5 to 1440; null is
  /// the default, 60.
  hostReportTimeoutMinutes Int?     @map("host_report_timeout_minutes")
  updatedAt                DateTime @updatedAt @map("updated_at")
  updatedBy                String?  @map("updated_by")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("agent_task_stall_schedule")
}

/// #1707 — a host's statement of which team App it serves and which workers it
/// can launch, each with the model family it would run as (cor:agt:070:01).
/// Identified within its App by `hostId` (Proposed); `label` is for display.
///
/// The host's identity comes from its key, never from a request: the public
/// `registerHost` mutation (#1709) takes the host id from the calling key's
/// `host:operate` scope row (cor:agt:070:04). The writer is
/// src/lib/agentTasks/hosts.ts.
///
/// A registration not refreshed within LAPSE_POLLS poll intervals has lapsed
/// (plan default 3, cor:agt:070:01 open question): its workers stop counting as
/// launchable through it, and the sweep writes `host.lost` once, stamping
/// `lostAt`. A refresh clears `lostAt`.
model HostRegistration {
  id                  String    @id @default(cuid())
  appId               String    @map("app_id")
  hostId              String    @map("host_id")
  label               String
  pollIntervalSeconds Int       @map("poll_interval_seconds")
  registeredAt        DateTime  @default(now()) @map("registered_at")
  refreshedAt         DateTime  @map("refreshed_at")
  lostAt              DateTime? @map("lost_at")
  /// #2162 (cor:agt:070:01, Proposed) — the capability-gated operation types this host declared it performs. A host
  /// is never issued such a type unless its live registration lists it; today that is only `worker.reset-context`.
  capabilities        String[]  @default([])

  app         App                      @relation(fields: [appId], references: [id], onDelete: Cascade)
  workers     HostRegistrationWorker[]
  /// #2022 — host-scope stop signals naming this registration.
  stopSignals TeamStopSignal[]

  @@unique([appId, hostId], map: "host_registrations_app_host_uniq")
  @@map("host_registrations")
}

/// #1707 — one worker a registered host can launch, and the model family it
/// would run as (cor:agt:070:01). A worker may be launchable through several
/// hosts (Proposed).
model HostRegistrationWorker {
  registrationId String   @map("registration_id")
  workerId       String   @map("worker_id")
  family         String
  /// #1709 — the worker's existing worktrees on this host, as the host names
  /// them (tokens the host resolves from its own configuration, never paths the
  /// platform invents). A worker is started only in one of these
  /// (cor:agt:070:06, :08); empty means it has none here.
  worktrees      String[] @default([])

  registration HostRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  worker       Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([registrationId, workerId])
  @@index([workerId])
  @@map("host_registration_workers")
}

/// #1709 (Task Management T6) — one typed operation the platform issued to one
/// host of a team App (cor:agt:070:02). `type` is one of the closed set of
/// cor:agt:070:03 and `args` its typed arguments, validated at issue
/// (src/lib/hostOperations/types.ts); there is no free-form type.
///
/// Status (070:02, `collected` Proposed by #1709): `issued` → `collected` (the
/// host took it) → `succeeded` | `failed` (the host reported; a failure carries
/// a reason). Each outcome also writes `host.operation.succeeded` / `.failed`.
/// Only the host it names collects or reports it (070:04). The issuer is a
/// person, a worker (through its session) or the platform (`issuedBy`).
/// Shape: prisma/host-operation-invariants.sql.
model HostOperation {
  id               String    @id
  appId            String    @map("app_id")
  hostId           String    @map("host_id")
  type             String
  args             Json
  /// The worker the operation is for; every type names one.
  workerId         String    @map("worker_id")
  status           String    @default("issued")
  /// `user` | `worker` | `platform`.
  issuedBy         String    @map("issued_by")
  issuedByUserId   String?   @map("issued_by_user_id")
  issuedByWorkerId String?   @map("issued_by_worker_id")
  issuedByAgentId  String?   @map("issued_by_agent_id")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  collectedAt      DateTime? @map("collected_at")
  finishedAt       DateTime? @map("finished_at")
  /// The typed result a success reports (e.g. the created worktree).
  result           Json?
  /// Why it failed, as the host said it; failures only.
  failureReason    String?   @map("failure_reason")
  /// #1709 slice 2 (#1883 review, Diego P2-1) — `worker.start` only: the hold
  /// that authorized the start, as (holder, held-at) when it was issued. A
  /// grant is minted, and a bind made, only while the worker's hold is still
  /// exactly this one: a release and re-hold changes `heldAt`, a move or an
  /// account merge changes the holder (Holger via Vera #10775).
  holdUserId       String?   @map("hold_user_id")
  holdAt           DateTime? @map("hold_at")

  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([appId, hostId, status])
  @@index([workerId])
  @@map("host_operations")
}

/// #1956 (cor:agt:020:03; Holger via Vera #11904, the window #12291) — a resume
/// claim: written by a worker session's own driver before a deliberate context
/// reset (a shed keeps the session open; a rotation ends it with its handoff),
/// so the fresh context can recover its worker with one call and no arguments,
/// with no binding file. Single use, consumed by a guarded update; it lives
/// RESUME_CLAIM_TTL_MS (60 s) from the write. Redeemable only by its holder,
/// judged by the caller's token, never by anything the caller presents: the
/// claim carries no secret and its id is never shown, so a non-holder has
/// nothing to present and learns nothing. Same mechanics family as
/// `LaunchGrant` (#1883), but it authorizes nothing the holder could not
/// already do by naming the worker.
model ResumeClaim {
  id               String    @id
  appId            String    @map("app_id")
  sessionId        String    @map("session_id")
  workerId         String    @map("worker_id")
  holderUserId     String    @map("holder_user_id")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at")
  /// The session the redemption bound: the claimed one when it was still open,
  /// or the new session started for its worker when it had ended.
  resumedSessionId String?   @map("resumed_session_id")
  /// Set when a newer claim for the same session replaced this one unused.
  revokedAt        DateTime? @map("revoked_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([holderUserId, expiresAt])
  @@index([sessionId])
  @@map("resume_claims")
}

/// #1709 (T6 slice 2; Holger's ruling A, Vera #10761) — a single-use launch
/// grant: the proof a host passes to the agent it starts, which the agent
/// redeems at `startSession` for an ordinary worker session. Minted when the
/// host COLLECTS a `worker.start` (so no secret is stored in the operation),
/// bound to (worker, host, task, holder), short-lived, stored only as a hash.
/// Redeemable only by the holder, judged by the caller's token, never by the
/// grant; consumed atomically. A re-collection revokes the unconsumed grant
/// before minting a new one. Never a credential: it authorizes nothing the
/// holder's own token does not.
model LaunchGrant {
  id           String    @id
  appId        String    @map("app_id")
  operationId  String    @map("operation_id")
  workerId     String    @map("worker_id")
  hostId       String    @map("host_id")
  taskId       String?   @map("task_id")
  holderUserId String    @map("holder_user_id")
  tokenHash    String    @unique @map("token_hash")
  issuedAt     DateTime  @default(now()) @map("issued_at")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  sessionId    String?   @map("session_id")
  revokedAt    DateTime? @map("revoked_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@map("launch_grants")
}

/// #2162 (cor:agt:050:27) — one context reset of a worker, requested when a task it had started finished or was
/// cancelled. At most one per task (`taskId` unique: a task ends once). The phase only moves forward:
/// requested → claimed → checkpointed → stop-granted → agent-stopped → relaunched → done, or to `refused` / `failed`
/// with a closed `reason`. `epoch` moves at claim and at every cancellation, so a host call naming an older epoch is
/// refused STALE_EPOCH. The host operation keeps its own 070:02 status; this row is the reset's protocol state.
/// Never reads or writes the task's outcome.
model ContextReset {
  id                   String    @id
  appId                String    @map("app_id")
  workerId             String    @map("worker_id")
  /// The worker's session open when the task ended: the fence the claim re-checks.
  sessionId            String    @map("session_id")
  taskId               String    @unique @map("task_id")
  /// The host the reset was issued to; null when no capable live host registered the worker (HOST_UNSUPPORTED).
  hostId               String?   @map("host_id")
  hostOperationId      String?   @unique @map("host_operation_id")
  phase                String
  /// Refused or failed only: a word from the closed set (src/lib/contextReset/types.ts).
  reason               String?
  epoch                Int       @default(0)
  requestedAt          DateTime  @map("requested_at")
  claimedAt            DateTime? @map("claimed_at")
  /// The agent process the host observed at claim: `{pid, startTime}`.
  claimProcess         Json?     @map("claim_process")
  /// `{checkpointNodeId, sessionId, taskId}`, registered before any process control.
  recoveryRef          Json?     @map("recovery_ref")
  recoveryRegisteredAt DateTime? @map("recovery_registered_at")
  stopGrantedAt        DateTime? @map("stop_granted_at")
  stopLeaseMs          Int?      @map("stop_lease_ms")
  agentStoppedAt       DateTime? @map("agent_stopped_at")
  relaunchedAt         DateTime? @map("relaunched_at")
  relaunchProcess      Json?     @map("relaunch_process")
  /// When a cancellation found a stop lease outstanding: the mark lifts no earlier than this.
  releasePendingAt     DateTime? @map("release_pending_at")
  endedAt              DateTime? @map("ended_at")

  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, phase])
  @@index([phase])
  @@map("context_resets")
}

/// #1709 (cor:agt:050:10) — a task's request that its assignee end its worker
/// session: written when a task with `closeSessionWhenDone` finishes or is
/// cancelled while its worker assignee has an open session. One per task.
///
/// The worker is asked first; at `dueAt` (the App's grace, default 10 minutes)
/// the sweep resolves it: `ended` (the session ended, by the worker or
/// otherwise), `end-issued` (still open: the platform issued `worker.end` for
/// that exact session to a live host registering the worker; `operationId`),
/// or `no-live-host` (still open, no live host: nothing more happens). A
/// replacement session is never touched: only `sessionId` is ever ended.
model TaskSessionEndRequest {
  id                  String    @id
  appId               String    @map("app_id")
  taskId              String    @unique @map("task_id")
  workerId            String    @map("worker_id")
  sessionId           String    @map("session_id")
  /// The `task.session-end-requested` event this request wrote.
  eventId             String    @map("event_id")
  /// The worker that finished or cancelled the task, when a worker did.
  requestedByWorkerId String?   @map("requested_by_worker_id")
  requestedAt         DateTime  @map("requested_at")
  dueAt               DateTime  @map("due_at")
  resolvedAt          DateTime? @map("resolved_at")
  /// `ended` | `end-issued` | `no-live-host`; null while open.
  resolution          String?
  operationId         String?   @map("operation_id")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, dueAt])
  @@index([workerId])
  @@map("task_session_end_requests")
}

/// #1709 — one use of a host key (cor:agt:070:07: every use is recorded):
/// which key, for which App and host, what it did, and when. `operationId`
/// names the operation a report was about; `count` how many operations a
/// collection returned or workers a registration listed.
model HostKeyUse {
  id          String   @id
  appKeyId    String   @map("app_key_id")
  appId       String   @map("app_id")
  hostId      String   @map("host_id")
  /// `register` | `collect` | `report` | `availability` | `read` (#1881: the
  /// App's host registrations or host-operations listing, read with the key;
  /// #2931: its host's tickers, `count` the rows returned) |
  /// `session` (#1969: a refused session write; always carries a refusedCode).
  action      String
  operationId String?  @map("operation_id")
  count       Int?
  /// #1881 (cor:agt:070:07, Holger #10849): the refusal's code when the call
  /// was refused, written apart from the refused call so its rollback keeps it.
  refusedCode String?  @map("refused_code")
  usedAt      DateTime @default(now()) @map("used_at")

  appKey AppKey @relation(fields: [appKeyId], references: [id], onDelete: Cascade)

  @@index([appKeyId, usedAt])
  @@map("host_key_uses")
}

/// #1719: mutable manual-trigger consent kept apart from the immutable run snapshot.
model ManualAutomationPin {
  runId     String   @id @map("run_id")
  pin       Json
  adoptedAt DateTime @default(now()) @map("adopted_at")
  adoptedBy String?  @map("adopted_by")
  run       AppRun   @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("manual_automation_pins")
}

/// #1747 (Tickers S1) — a named wake schedule owned by one team App
/// (cor:agt:080:01). Ticks are COMPUTED from `anchorAt` + k x `cadenceSeconds`,
/// never stored (cor:agt:080:06). Nothing reads a ticker until S2.
///
/// The NAME is unique among live tickers, ignoring case, and reusable after a
/// delete (partial index `tickers_app_name_live_uniq`); the SLUG is permanent:
/// unique within the App forever, deleted rows included (`tickers_app_slug_uniq`),
/// so a re-created `engineering` gets `engineering-2` (#8083).
/// Owner is exactly one of user / worker, taken from `currentActor()`, never an
/// argument (CHECK `chk_tickers_shape`, prisma/ticker-invariants.sql).
model Ticker {
  id                String    @id @default(cuid())
  appId             String    @map("app_id")
  name              String
  slug              String
  /// Permanent action-register code, snapped from the template name for generated tickers.
  tickCode          String    @map("tick_code")
  cadenceSeconds    Int       @map("cadence_seconds")
  anchorAt          DateTime  @default(now()) @map("anchor_at")
  /// `{ timezone, windows: [{ days: [1..7], from: "22:00", to: "07:00" }] }`.
  quietHours        Json?     @map("quiet_hours")
  /// Null = every channel the subscriber watches. Not a grant (cor:agt:080:01).
  channelIds        String[]  @default([]) @map("channel_ids")
  /// 'ALL' | 'MENTIONS'.
  relevance         String    @default("ALL")
  /// #2068 (cor:agt:080:01, :10, R49): why the ticker fires, a closed set: 'read-team-channel' (relevant unread, as before) and
  /// 'every-tick' (unconditional), and 'live-check' (#2138: the worker has not checked its team channel within the ticker's cadence,
  /// whatever is unread; never for a worker not expected to check). Empty = never fires; any-of when several (Decided, R54).
  reasons           String[]  @default(["read-team-channel"]) @map("reasons")
  enabled           Boolean   @default(true)
  ownerUserId       String?   @map("owner_user_id")
  ownerWorkerId     String?   @map("owner_worker_id")
  /// #2024 (S8): set only on a ticker the platform generated at cast from an Agent ticker template. The template
  /// is a plain reference (no FK, so removing a template never cascades into runtime state) and the revision is
  /// the one the ticker was made from; `generatedForWorkerId` is the worker it was made for. A partial unique
  /// (generatedForWorkerId, sourceTemplateId) over live rows makes a retried cast unable to mint a second live instance.
  sourceTemplateId       String? @map("source_template_id")
  sourceTemplateRevision Int?    @map("source_template_revision")
  generatedForWorkerId   String? @map("generated_for_worker_id")
  /// #2429 (cor:dmo:050:11): set by every accepted `updateTicker` on a GENERATED ticker, whatever the fields and even when
  /// the values end up unchanged (it fails toward blocking). An edited generated ticker is no longer the cast's own
  /// bookkeeping, so it counts as a reference and blocks the miscast repair. Soft-deletes are not edits.
  editedAt               DateTime? @map("edited_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by")
  createdByWorkerId String?   @map("created_by_worker_id")
  createdByAgentId  String?   @map("created_by_agent_id")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")
  updatedByWorkerId String?   @map("updated_by_worker_id")
  updatedByAgentId  String?   @map("updated_by_agent_id")
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by")
  deletedByWorkerId String?   @map("deleted_by_worker_id")
  deletedByAgentId  String?   @map("deleted_by_agent_id")

  app           App                  @relation(fields: [appId], references: [id], onDelete: Cascade)
  subscriptions TickerSubscription[]
  deliveryTicks WorkerDeliveryTick[]

  @@unique([appId, slug], map: "tickers_app_slug_uniq")
  // #2096: ONE LIVE generated ticker per (worker, template) — enforced by the PARTIAL unique index
  // `tickers_generated_live_uniq WHERE generated_for_worker_id IS NOT NULL AND deleted_at IS NULL` (raw SQL: the
  // 20261030120000 migration + prisma/ticker-generated-live-unique.sql via post-push.sql + src/test/globalSetup.ts,
  // which must stay in sync). A @@unique would be non-partial and make a soft-deleted generated ticker block its
  // recreation by the apply operation (the slack_connections / apps_urn_active_uniq precedent).
  @@index([generatedForWorkerId, sourceTemplateId], map: "tickers_generated_idx")
  @@index([appId, deletedAt])
  @@map("tickers")
}

/// #2024 (S8, cor:agt:080:33) — one ticker an Agent declares. Casting a worker from the Agent into an App creates
/// the worker's tickers from these (a SNAPSHOT: a later edit or removal reaches only future casts, R96 A) and
/// subscribes it. Identity is `id`, never the name or a position; `revision` counts edits so a stale writer is
/// refused (`expectedRevision`); `shapeVersion` lets a future shape be decoded explicitly (an unknown one is
/// refused). Soft-deleted rows stay, because generated tickers keep their provenance.
/// Live names are unique per Agent ignoring case; the CHECKs mirror the ticker's (prisma/agent-ticker-template-invariants.sql).
model AgentTickerTemplate {
  id             String    @id @default(cuid())
  agentId        String    @map("agent_id")
  revision       Int       @default(1)
  shapeVersion   Int       @default(1) @map("shape_version")
  name           String
  /// Requested cadence; the cast clamps it up to the App's floor (R92).
  cadenceSeconds Int       @map("cadence_seconds")
  quietHours     Json?     @map("quiet_hours")
  /// 'ALL' | 'MENTIONS'.
  relevance      String    @default("ALL")
  /// Closed set, non-empty: 'read-team-channel' | 'every-tick' | 'live-check' (a template with none would never fire).
  reasons        String[]  @default(["read-team-channel"]) @map("reasons")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, deletedAt])
  @@map("agent_ticker_templates")
}

/// #1747 — a worker's subscription to one ticker (cor:agt:080:02). Workers of the
/// ticker's App only, never Agents. One LIVE row per (ticker, worker) (partial
/// index `ticker_subscriptions_live_uniq`). History is kept, never hard-deleted.
/// `endedReason` is UNSUBSCRIBED | WORKER_RETIRED | TICKER_DELETED, never
/// dormancy (#8099). `viaGrantId` + `viaGrantPersonId` record a grant use (N2).
model TickerSubscription {
  id                    String    @id @default(cuid())
  tickerId              String    @map("ticker_id")
  workerId              String    @map("worker_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  createdBy             String?   @map("created_by")
  createdByWorkerId     String?   @map("created_by_worker_id")
  createdByAgentId      String?   @map("created_by_agent_id")
  viaGrantId            String?   @map("via_grant_id")
  viaGrantPersonId      String?   @map("via_grant_person_id")
  endedAt               DateTime? @map("ended_at")
  endedBy               String?   @map("ended_by")
  endedByWorkerId       String?   @map("ended_by_worker_id")
  endedByAgentId        String?   @map("ended_by_agent_id")
  endedViaGrantId       String?   @map("ended_via_grant_id")
  endedViaGrantPersonId String?   @map("ended_via_grant_person_id")
  endedReason           String?   @map("ended_reason")

  ticker Ticker @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([tickerId])
  @@map("ticker_subscriptions")
}

/// #1747 — one worker's wake settings (cor:agt:080:03), created lazily.
/// `mentions` is IMMEDIATE | OFF (no ON_TICK, #8090). `pausedUntil` belongs to
/// the worker, not a session (#8077).
model WorkerWakeSettings {
  workerId          String    @id @map("worker_id")
  mentions          String    @default("IMMEDIATE")
  pausedUntil       DateTime? @map("paused_until")
  /// S7 (#2023, R85) — ISOLATION is its own state, never `pausedUntil`: written only by
  /// isolateWorker / clearWorkerIsolation, always by a human acting as themselves.
  isolatedUntil     DateTime? @map("isolated_until")
  isolatedAt        DateTime? @map("isolated_at")
  isolatedByUserId  String?   @map("isolated_by_user_id")
  /// #2755 — when an ACTIVE pause or isolation was ended on purpose (clearPause, clearWorkerIsolation), which erases
  /// the only timestamp that said when the exemption ended. Natural expiry needs none (its own end stays stored).
  exemptEndedAt     DateTime? @map("exempt_ended_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")
  updatedByWorkerId String?   @map("updated_by_worker_id")
  updatedByAgentId  String?   @map("updated_by_agent_id")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_wake_settings")
}

/// #1747 — the delivery record, part 1 (cor:agt:080:04): the newest seq a wake
/// for a channel was acknowledged for. Created here, WRITTEN ONLY by S2's
/// `acknowledgeWakes`. It only rises.
model WorkerDeliveryChannel {
  workerId            String   @map("worker_id")
  channelId           String   @map("channel_id")
  channelIncarnation  Int      @default(0) @map("channel_incarnation")
  deliveredThroughSeq Int      @map("delivered_through_seq")
  deliveredAt         DateTime @map("delivered_at")
  /// Who acknowledged the newest wake (cor:agt:080:16): a person, a worker's
  /// session behind them, or a bare App key (S3).
  ackedByUserId       String?  @map("acked_by_user_id")
  ackedByWorkerId     String?  @map("acked_by_worker_id")
  ackedByAppKeyId     String?  @map("acked_by_app_key_id")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([workerId, channelId])
  @@map("worker_delivery_channels")
}

/// #2072 (Holger R53, cor:agt:080:04/:13/:15) — the receipt of an acknowledged wake, per (worker, wake key). A wake
/// carries no message text, so its acknowledgement moves no message mark; this row is what it records instead: the
/// floor's clock (`ackedAt`) and the budget's once-per-wake test. A row is (re)written only by an acknowledgement of a
/// proof issued AFTER both the receipt and its accepted-issue watermark, so a repeat or an older proof's replay changes nothing
/// while the same wake offered again after the floor counts again.
model WorkerWakeAck {
  workerId        String   @map("worker_id")
  wakeKey         String   @map("wake_key")
  ackedAt         DateTime @map("acked_at")
  /// #3022: issue time that spent/covered this key; absorbed keys inherit the descendant's issue time.
  /// NULL is an old writer's receipt: replay comparison falls back to ackedAt.
  issuedAt        DateTime? @map("issued_at")
  ackedByUserId   String?  @map("acked_by_user_id")
  ackedByWorkerId String?  @map("acked_by_worker_id")
  ackedByAppKeyId String?  @map("acked_by_app_key_id")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([workerId, wakeKey])
  @@index([workerId, ackedAt])
  @@map("worker_wake_acks")
}

/// #1747 — the delivery record, part 2: the last tick acknowledged per ticker.
/// WRITTEN ONLY by S2.
model WorkerDeliveryTick {
  workerId        String   @map("worker_id")
  tickerId        String   @map("ticker_id")
  lastAckedTick   Int      @map("last_acked_tick")
  ackedAt         DateTime @map("acked_at")
  ackedByUserId   String?  @map("acked_by_user_id")
  ackedByWorkerId String?  @map("acked_by_worker_id")
  ackedByAppKeyId String?  @map("acked_by_app_key_id")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  ticker Ticker @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@id([workerId, tickerId])
  @@map("worker_delivery_ticks")
}

/// #1708 (Task Management T5) — the delivery record, part 3: one row per
/// (worker, task event, alarm chain position). `deliveredAt` is set ONLY by
/// `acknowledgeWakes` (a wake proof naming the event), and is the receipt that
/// the nudge for this event reached this worker. It is never an alarm
/// acknowledgement (cor:agt:050:20): that stays `acknowledgeAlarm`'s.
/// `undeliverableAt` is set by the stall-evaluator tick when the subject is
/// dormant (cor:agt:080:11); a later delivery still records `deliveredAt`.
/// `chainIndex` is 0 for an ordinary event and the woken position for an alarm.
model WorkerDeliveryTaskEvent {
  workerId            String    @map("worker_id")
  eventId             String    @map("event_id")
  chainIndex          Int       @default(0) @map("chain_index")
  deliveredAt         DateTime? @map("delivered_at")
  ackedByUserId       String?   @map("acked_by_user_id")
  ackedByWorkerId     String?   @map("acked_by_worker_id")
  ackedByAppKeyId     String?   @map("acked_by_app_key_id")
  undeliverableAt     DateTime? @map("undeliverable_at")
  /// 'dormant' — the only reason this slice records.
  undeliverableReason String?   @map("undeliverable_reason")

  worker Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  event  AgentTeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([workerId, eventId, chainIndex])
  @@index([workerId, deliveredAt])
  @@index([eventId])
  @@map("worker_delivery_task_events")
}

/// #1748 — wakes acknowledged per App per UTC day (cor:agt:080:15). `wakes` is
/// the budget counter (exempt wakes are not counted); `noticePostedAt` is the
/// once-a-day "budget spent" notice claim. Written only by `acknowledgeWakes`
/// and the notice claim.
model AppWakeDay {
  appId          String    @map("app_id")
  day            DateTime  @map("day") @db.Date
  wakes          Int       @default(0)
  noticePostedAt DateTime? @map("notice_posted_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, day])
  @@map("app_wake_days")
}

/// #1748 cycle 1 — an outstanding budget reservation: `dueWakes` issued a
/// non-exempt wake proof for this worker and has not yet seen it acknowledged.
/// Counted against the day's budget for as long as the proof could still be
/// acknowledged (15 minutes), so concurrent readers cannot hand out more than
/// the budget (cor:agt:080:15). One row per worker; refreshed by a re-read,
/// removed by the acknowledgement.
model AppWakeReservation {
  workerId     String   @id @map("worker_id")
  appId        String   @map("app_id")
  reservedAt   DateTime @map("reserved_at")
  /// Which wake it was reserved for (the proof's channels, seqs and ticks, hashed): an acknowledgement spends only the
  /// reservation of the wake it delivers, so an old proof replayed cannot cancel a newer wake's allowance.
  wakeKey      String   @map("wake_key")
  /// The wake itself, so an outstanding one is handed out again, exactly, until it is consumed or lapses.
  wake         Json     @map("wake")
  /// #2069: the wake keys this reservation absorbed (a tick or task that fell due after them). An earlier proof whose key
  /// is listed shares this reservation's allowance and is not charged again; any other proof is unrelated to it.
  absorbedKeys String[] @default([]) @map("absorbed_keys")

  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([appId, reservedAt])
  @@map("app_wake_reservations")
}

/// #2022 (S6, cor:agt:090:01) — a stop signal: team state that stops work for the workers it covers until it ends.
/// Level `pause-dispatch` | `pause` | `halt`; scope `worker` | `team` | `host`. A worker or team signal names its
/// target worker (a team by its head); a host signal names its host registration. Who set it is a person
/// (`setByUserId`) or a host key (`setByAppKeyId`), never both. It is live while `endedAt` is null and `until` (when
/// given) has not passed: an expiry is in effect at `until` even before the sweep records it. The level, scope,
/// target, setter and set time never change; the end is recorded once (prisma/stop-signal-invariants.sql). No text.
model TeamStopSignal {
  id                       String    @id
  appId                    String    @map("app_id")
  level                    String
  scope                    String
  targetWorkerId           String?   @map("target_worker_id")
  targetHostRegistrationId String?   @map("target_host_registration_id")
  setAt                    DateTime  @map("set_at")
  until                    DateTime?
  setByUserId              String?   @map("set_by_user_id")
  setByAppKeyId            String?   @map("set_by_app_key_id")
  endedAt                  DateTime? @map("ended_at")
  /// `lifted` | `expired`.
  endKind                  String?   @map("end_kind")
  endedByUserId            String?   @map("ended_by_user_id")
  endedByAppKeyId          String?   @map("ended_by_app_key_id")

  app          App                @relation(fields: [appId], references: [id], onDelete: Cascade)
  targetWorker Worker?            @relation(fields: [targetWorkerId], references: [id], onDelete: Cascade)
  targetHost   HostRegistration?  @relation(fields: [targetHostRegistrationId], references: [id], onDelete: Cascade)
  coverage     TeamStopCoverage[]

  @@index([appId, setAt, id])
  @@index([targetWorkerId])
  @@index([targetHostRegistrationId])
  @@map("team_stop_signals")
}

/// #2169 (S6b, R95) — one serving lane's declaration that its consumer takes stop notices: a `dueWakes` call that
/// passes `accepts: [STOP]` upserts the row of the lane it serves (a host registration id for a host key, `unhosted` for a
/// person who manages the App or a non-host key). A declaration is FRESH for STOP_CONSUMER_FRESH_SECONDS; setting a stop
/// signal is refused while any worker it would cover has no fresh lane. `lane` is deliberately not a foreign key: it is
/// either a registration id or the literal `unhosted`, and a stale row for a deleted registration is simply never read.
model StopConsumerDeclaration {
  appId      String   @map("app_id")
  lane       String
  declaredAt DateTime @map("declared_at")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, lane])
  @@map("stop_consumer_declarations")
}

/// #2022 (R95) — when a stop signal covered a worker: the HISTORY that stall clocks and notices read. Enforcement never
/// reads it; it works coverage out live (cor:agt:090:02). Kept by `reconcileStopCoverage` under the App's stop fence:
/// one open interval per (signal, worker) (partial unique index, prisma/stop-signal-invariants.sql). An interval ends
/// at the earliest of `leftAt`, its signal's end and its signal's `until`.
model TeamStopCoverage {
  id        String    @id
  appId     String    @map("app_id")
  signalId  String    @map("signal_id")
  workerId  String    @map("worker_id")
  enteredAt DateTime  @map("entered_at")
  leftAt    DateTime? @map("left_at")

  signal TeamStopSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([workerId, enteredAt])
  @@index([signalId])
  @@index([appId])
  @@map("team_stop_coverage")
}

/// #2022 (R68, Vera's receipt §5) — a time when stop signals were what kept a queued task from being assigned: every
/// worker that would otherwise match it was covered, or its creator was under a `pause` or `halt` (R71). The
/// couldn't-be-assigned clock (cor:agt:050:17) doesn't count it. Opened and closed by the matcher's pass; one open
/// hold per task (partial unique index).
model AgentTaskStopHold {
  id        String    @id
  appId     String    @map("app_id")
  taskId    String    @map("task_id")
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
  @@map("agent_task_stop_holds")
}

/// #1747 — a narrow, named App grant held by a WORKER (cor:agt:080:24). One
/// live row per (app, grantee, name) (partial index `app_grants_live_uniq`).
/// `name` is a closed list: `ticker.subscribe-workers`. Given and revoked only
/// by whoever manages the App.
model AppGrant {
  id              String    @id @default(cuid())
  appId           String    @map("app_id")
  granteeWorkerId String    @map("grantee_worker_id")
  name            String
  grantedAt       DateTime  @default(now()) @map("granted_at")
  grantedBy       String?   @map("granted_by")
  revokedAt       DateTime? @map("revoked_at")
  revokedBy       String?   @map("revoked_by")

  app     App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  grantee Worker @relation(fields: [granteeWorkerId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([granteeWorkerId])
  @@map("app_grants")
}

/// A scope an App key holds (cor:aut:010:03, #1749). A closed list; today only `attention:deliver`. At most one LIVE
/// row per key and scope (a partial unique index, prisma/app-key-scope-invariants.sql). Granted and revoked only by
/// whoever manages the App; read from the database on every call it gates, never cached in the auth context.
model AppKeyScope {
  id              String    @id
  appKeyId        String    @map("app_key_id")
  scope           String
  grantedByUserId String    @map("granted_by_user_id")
  grantedAt       DateTime  @default(now()) @map("granted_at")
  revokedByUserId String?   @map("revoked_by_user_id")
  revokedAt       DateTime? @map("revoked_at")
  /// #1709 — the one host a `host:operate` scope is bound to (cor:agt:070:04):
  /// required for that scope, absent for every other (chk_app_key_scopes_shape).
  hostId          String?   @map("host_id")

  appKey AppKey @relation(fields: [appKeyId], references: [id], onDelete: Cascade)

  @@index([appKeyId])
  @@map("app_key_scopes")
}

/// One row per App-key `dueWakes` call: which key read, how many workers it was shown, when (#1749, cor:agt:080:23).
model AppKeyWakeRead {
  id          String   @id
  appKeyId    String   @map("app_key_id")
  appId       String   @map("app_id")
  workerCount Int      @map("worker_count")
  readAt      DateTime @default(now()) @map("read_at")

  appKey AppKey @relation(fields: [appKeyId], references: [id], onDelete: Cascade)

  @@index([appKeyId, readAt])
  @@map("app_key_wake_reads")
}

/// #1647 (cor:aut:020:03): one row per erasure a platform admin performs on ANOTHER user's account. Written in the
/// deletion's own SERIALIZABLE transaction, so the audit and the erasure commit or roll back together. User ids are
/// plain columns, deliberately NOT foreign keys: the audit must outlive any cascade. Immutable (trigger in
/// post-push.sql + the migration) and exposed on no read surface.
model UserDeletionAudit {
  id           String   @id @map("id")
  actorUserId  String   @map("actor_user_id")
  targetUserId String   @unique @map("target_user_id")
  reason       String
  completedAt  DateTime @default(now()) @map("completed_at")

  notice UserDeletionNotice?

  @@map("user_deletion_audits")
}

enum UserDeletionNoticeStatus {
  PENDING
  SENT
  FAILED
  UNAVAILABLE
}

/// #1647: the outbox for the deleted user's notice. Written in the deletion's transaction with the recipient address
/// encrypted (tokenCrypto); a post-commit worker sends it and clears the ciphertext at a terminal state. The notice
/// text never carries the audit reason.
model UserDeletionNotice {
  auditId             String                   @id @map("audit_id")
  status              UserDeletionNoticeStatus @default(PENDING)
  recipientCiphertext String?                  @map("recipient_ciphertext")
  attempts            Int                      @default(0)
  /// Exclusive send lease: while `leaseUntil` is in the future only the holder of `claimToken` is sending.
  leaseUntil          DateTime?                @map("lease_until")
  claimToken          String?                  @map("claim_token")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  audit UserDeletionAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("user_deletion_notices")
}

/// #1162: internal MVCC coordination, not authored history or a Worker FK.
/// Writers and miscast deletion update this version in their own transaction.
/// Retained after deletion to fence older snapshots; no public API.
/// The key is an immutable Worker id.
model WorkerReferenceFence {
  subjectId String @id @map("subject_id")
  version   BigInt @default(0)

  @@map("worker_reference_fences")
}

enum ServedPromptKind {
  BIND
  CHAT
  RUN
}

enum ServedPromptPointerLevel {
  WORKER
  APP_AGENT
  AGENT
}

/// #2047 (S10, cor:agt:040:03): what a bind, a chatbot chat or a headless run was given. IMMUTABLE platform data, not
/// memory content: it names the compiled revision served, the pointer level that chose it, that revision's own
/// provenance (copied from the revision at serve time, so a recompile never rewrites it, R38) and the values the
/// platform variables were filled with. No composed text, no derived blocks (run progress holds those), no export.
///
/// Identity of a revision is `(compiledNodeId, servedRevSeq)`: `Node.revSeq`, never `contentRevSeq`. `compiledNodeId` is
/// deliberately not a foreign key: the record outlives a deliberately deleted node and shows it as pruned.
///
/// Owner (exactly one of session / chat node / run), the owner-consistency foreign keys, immutability and the
/// owner-absence delete gate are database facts Prisma cannot model: prisma/served-prompt-invariants.sql.
model ServedPrompt {
  id                  String                   @id
  kind                ServedPromptKind
  sessionId           String?                  @map("session_id")
  chatId              String?                  @map("chat_id")
  runId               String?                  @map("run_id")
  /// 1 for a bind or a run; a chat records again when its served revision changes (R37), counting up.
  ordinal             Int                      @default(1)
  /// Null only for a chat held in a memory no App owns (chk_served_prompts_app, prisma/served-prompt-app-invariants.sql).
  appId               String?                  @map("app_id")
  agentId             String                   @map("agent_id")
  workerId            String?                  @map("worker_id")
  pointerLevel        ServedPromptPointerLevel @map("pointer_level")
  compiledNodeId      String                   @map("compiled_node_id")
  servedRevSeq        Int                      @map("served_rev_seq")
  /// The compile revision that owns the provenance: the greatest compile revSeq at or below the served one (a
  /// metadata-only revision above a compile advances revSeq but not the provenance).
  provenanceRevSeq    Int                      @map("provenance_rev_seq")
  compiledContentHash String                   @map("compiled_content_hash")
  /// `[{nodeId, revSeq, hash}]`, read through its own cursor field, never in one response.
  provenance          Json                     @default("[]")
  variables           Json                     @default("{}")
  servedAt            DateTime                 @default(now()) @map("served_at")

  @@index([compiledNodeId, servedRevSeq])
  @@map("served_prompts")
}

/// #2245 (R170.6): one append-only record per Agent clone. Written in the clone's own transaction, so the audit and
/// the copy commit or roll back together. Ids are plain columns, deliberately NOT foreign keys: the record must
/// outlive the Agents, orgs and users it names. Exactly one of the two targets is set (CHECK in post-push.sql);
/// S1 only writes `targetOrgId`. Immutable (trigger) and exposed on no read surface.
model AgentCloneAudit {
  id                String   @id @map("id")
  actorUserId       String?  @map("actor_user_id")
  sourceAgentId     String   @map("source_agent_id")
  newAgentId        String   @map("new_agent_id")
  targetOrgId       String?  @map("target_org_id")
  targetUserId      String?  @map("target_user_id")
  nodeCount         Int      @map("node_count")
  edgeCount         Int      @map("edge_count")
  skippedEdgeCount  Int      @map("skipped_edge_count")
  importCount       Int      @map("import_count")
  linkCount         Int      @map("link_count")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([sourceAgentId])
  @@map("agent_clone_audits")
}

/// #2517, cor:dmo:010:04 (Proposed) — a separate audit entry, written on each SOURCE node, when a hard
/// delete cascades an edge that node held to the deleted target. Deliberately NOT a NodeRevision (a
/// node's revisions stay snapshots of its own fields). The source is a real FK (the trace dies with the
/// source); the target is NOT one, since the target row is gone by the time anyone reads this.
model NodeEdgeRemoval {
  id             String   @id @default(cuid())
  sourceId       String   @map("source_id")
  /// The source's memory when the edge was removed (a node can later be moved).
  memoryId       String   @map("memory_id")
  edgeId         String   @map("edge_id")
  edgeLoc        String   @map("edge_loc")
  edgeName       String?  @map("edge_name")
  targetId       String   @map("target_id")
  targetMemoryId String   @map("target_memory_id")
  targetLoc      String   @map("target_loc")
  /// Why the edge went: today only `TARGET_HARD_DELETED`.
  reason         String
  /// Same value `Node.deletedBy` would carry (user, app or client id), null when unattributed.
  removedBy      String?  @map("removed_by")
  createdAt      DateTime @default(now()) @map("created_at")

  source Node @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, createdAt])
  @@map("node_edge_removals")
}

/// #1667, cor:dmo:060:15 — append-only record of every successful per-asset
/// public-link switch call: who, when, to what. Written in the SAME transaction
/// as the flag. Deliberately NO foreign keys: the record must outlive the asset
/// row (the janitor hard-deletes assets) and the actor.
model AssetPublicLinkAudit {
  id                String   @id @map("id")
  assetId           String   @map("asset_id")
  memoryId          String   @map("memory_id")
  actorUserId       String   @map("actor_user_id")
  enabled           Boolean
  previouslyEnabled Boolean  @map("previously_enabled")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([assetId, createdAt])
  @@map("asset_public_link_audits")
}

// #2063 R1 / cor:dmo:150:07. Plaintext structural metadata, never source prose.
// No target FK: a source's written address survives target/edge deletion.
model IncludeReference {
  id                 String  @id @default(cuid())
  includerId         String  @map("includer_id")
  ordinal            Int
  kind               IncludeReferenceKind
  reference          String
  targetMemoryId     String? @map("target_memory_id")
  targetLoc          String? @map("target_loc")
  pinnedRevNo        Int?    @map("pinned_rev_no")
  requiresApproved   Boolean @default(false) @map("requires_approved")
  requiresSigned     Boolean @default(false) @map("requires_signed")
  metadataGeneration Int     @map("metadata_generation")
  includer           Node    @relation(fields: [includerId], references: [id], onDelete: Cascade)

  @@unique([includerId, ordinal])
  @@index([targetMemoryId, targetLoc])
  @@index([targetMemoryId, reference])
  @@map("include_references")
}

enum IncludeReferenceKind {
  loc
  urn
}

enum IncludeSourceCoverageState {
  COMPLETE_EMPTY
  COMPLETE_TAGS
  NEEDS_AUTHORIZED_REWRITE
}

// Fingerprints describe STORED bytes (ciphertext when sealed); no plaintext copy.
// Tombstones remain sources. Only an includer's purge cascades coverage away.
model IncludeSourceCoverage {
  id                       String @id @default(cuid())
  includerId               String @unique @map("includer_id")
  sourceRevision           Int    @map("source_revision")
  sourceMemoryId           String @map("source_memory_id")
  sourceLoc                String @map("source_loc")
  sourceContentFingerprint String @map("source_content_fingerprint")
  sourceEncrypted          Boolean @map("source_encrypted")
  parserVersion            Int    @map("parser_version")
  metadataGeneration       Int    @map("metadata_generation")
  referenceCount           Int    @map("reference_count")
  state                    IncludeSourceCoverageState
  includer                 Node   @relation(fields: [includerId], references: [id], onDelete: Cascade)

  @@map("include_source_coverage")
}

enum IncludeRetentionState {
  PREPARING
  BACKFILLING
  VERIFYING
  ACTIVE
  BLOCKED
}

// Singleton is absent/inactive until separately authorized maintenance verifies it.
// R1 adds no activator, operator command, backfill or production caller.
model IncludeRetentionGeneration {
  id                        String @id @default("singleton")
  schemaVersion             Int @default(1) @map("schema_version")
  parserVersion             Int @default(1) @map("parser_version")
  metadataGeneration        Int @default(1) @map("metadata_generation")
  state                     IncludeRetentionState @default(PREPARING)
  sourceHighWaterId         String? @map("source_high_water_id")
  replayCursor              String? @map("replay_cursor")
  bindingGeneration         Int @default(0) @map("binding_generation")
  verifiedBindingGeneration Int? @map("verified_binding_generation")
  sourceCount               Int @default(0) @map("source_count")
  coveredCount              Int @default(0) @map("covered_count")
  blockedCount              Int @default(0) @map("blocked_count")

  @@map("include_retention_generation")
}

/// #1793: server-owned policy; defaults seed once, mode deploys LOG_ONLY.
model RateLimitPolicy {
  fieldClass      String   @id @map("field_class")
  principalLimit  Int      @map("principal_limit")
  keyLimit        Int      @map("key_limit")
  ipLimit         Int      @map("ip_limit")
  windowSeconds   Int      @map("window_seconds")
  retentionSeconds Int     @default(86400) @map("retention_seconds")
  enforcementMode String   @default("LOG_ONLY") @map("enforcement_mode")
  version         Int      @default(1)
  updatedAt       DateTime @default(now()) @map("updated_at")
  @@map("rate_limit_policies")
}

/// #1793: HMAC subjects only. Window-independent advisory locks protect absent rows too.
model RateLimitBucket {
  id          String   @id
  fieldClass  String   @map("field_class")
  dimension   String
  subject     String
  windowStart DateTime @map("window_start")
  used        BigInt
  expiresAt   DateTime @map("expires_at")
  @@unique([fieldClass, dimension, subject, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

/// #1793: no secrets, only key IDs and fingerprints. Operators fence overlap/drain transitions.
model RateLimitManifest {
  id                String   @id
  keyIds            String[] @map("key_ids")
  fingerprints      Json
  overlapStartedAt  DateTime? @map("overlap_started_at")
  version           Int      @default(1)
  @@map("rate_limit_manifests")
}

/// #1793: platform-admin-only configuration audit; contains no subject/counter/secret.
model RateLimitPolicyAudit {
  id              String   @id
  fieldClass      String   @map("field_class")
  actorId         String   @map("actor_id")
  before          Json
  after           Json
  changeReference String   @map("change_reference")
  createdAt       DateTime @default(now()) @map("created_at")
  @@map("rate_limit_policy_audits")
}
