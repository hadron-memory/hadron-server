# File-provider snippet: replace CHOSEN_HOST, CHOSEN_BASE_PATH and PRIVATE_HOST_GATEWAY after approval.
http:
  routers:
    passkey-al:
      rule: "Host(`CHOSEN_HOST`) && PathPrefix(`CHOSEN_BASE_PATH`)"
      priority: 10000
      entryPoints: [EXISTING_HTTPS_ENTRYPOINT]
      tls: {}
      service: passkey-al
  services:
    passkey-al:
      loadBalancer:
        servers:
          - url: "http://PRIVATE_HOST_GATEWAY:4380"
