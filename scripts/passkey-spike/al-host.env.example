# Set only after Holger chooses exact origin. No secrets or Hadron credentials.
PASSKEY_SPIKE_ORIGIN=https://CHOSEN_HOST
PASSKEY_SPIKE_RP_ID=hadronmemory.com
PASSKEY_SPIKE_BASE_PATH=/__passkey-al-RANDOM/
PASSKEY_SPIKE_BIND=PRIVATE_HOST_GATEWAY_IP
PASSKEY_SPIKE_PORT=4380

# Optional AL retry timing; unset keeps the original 300/60-second defaults.
PASSKEY_SPIKE_SESSION_TTL_SECONDS=1800
PASSKEY_SPIKE_PAIRING_TTL_SECONDS=300

# Server ceremony expiry (seconds), capped by session; browser timeout is only a hint (ms).
PASSKEY_SPIKE_CEREMONY_EXPIRY_SECONDS=600
PASSKEY_SPIKE_BROWSER_TIMEOUT_MS=300000
