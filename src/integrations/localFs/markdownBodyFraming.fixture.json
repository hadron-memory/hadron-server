    { "name": "hand-no-blank-line", "kind": "parse", "body": "Body\n", "loaded": "Body" },
    { "name": "hand-no-final-newline", "kind": "parse", "body": "\nBody", "loaded": "Body" },
    { "name": "hand-no-framing", "kind": "parse", "body": "Body", "loaded": "Body" },
    { "name": "hand-extra-trailing-blank-lines", "kind": "parse", "body": "\nBody\n\n\n", "loaded": "Body\n\n" },
