{
  "_comment": "Parser-LAYER golden-set fixture (cats 1 and 4 only). Consumed by parser tests in hadron-server, hadron-portal, and hadron-client. Each repo's parser test suite iterates and asserts behavior. Cats 2 and 3 are resolver-layer (DB lookup required) and live in a separate server-only fixture; see contracts/parser.md and contracts/canonical-form.md.",
  "_schema": {
    "input": "string — the URN string to feed parseUrn()",
    "expectedType": "UrnType — the parsed `.type`",
    "expectedParserCanonical": "string — the parser-layer canonical form, what `.parserCanonical` should equal",
    "expectedParserRewrites": "AliasCategory[] — parser-layer rewrites that fired (cats 1, 4 only)",
    "expectedNeedsResolver": "boolean — whether `.needsResolverCanonicalization` is true (cat 2 or cat 3 may need to fire downstream). Defaults to false when omitted; test harnesses MUST treat missing as false.",
    "expectedReject": "UrnParseError.reason — if set, the parser MUST throw with this reason instead of returning",
    "offendingSegment": "string — optional, the segment cited in the error"
  },

  "cases": [
    {
      "_section": "D1 — type registry acceptance",
      "input": "hrn:agent:hadronmemory.com::coding-agent",
      "expectedType": "agent",
      "expectedParserCanonical": "hrn:agent:hadronmemory.com::coding-agent",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:memory:hadronmemory.com::coding-agent::system",
      "expectedType": "memory",
      "expectedParserCanonical": "hrn:memory:hadronmemory.com::coding-agent::system",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:app:micromentor.org::coding-app",
      "expectedType": "app",
      "expectedParserCanonical": "hrn:app:micromentor.org::coding-app",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:fake:foo",
      "expectedReject": "unknown-type"
    },

    {
      "_section": "D2 — grammar (both forms accepted; bare is canonical)",
      "input": "hrn:agent:micromentor.org::app:coding-app::agent:hadronmemory.com:coding-agent",
      "expectedType": "agent",
      "expectedParserCanonical": "hrn:agent:micromentor.org::coding-app::hadronmemory.com:coding-agent",
      "expectedParserRewrites": ["type-marker-optionality"]
    },
    {
      "input": "hrn:memory:org::::app",
      "expectedReject": "empty-segment"
    },
    {
      "input": "hrn:memory:org::app::",
      "expectedReject": "trailing-double-colon"
    },

    {
      "_section": "D4 — memory-role markers",
      "input": "hrn:memory:micromentor.org::coding-app::coding-agent::system",
      "expectedType": "memory",
      "expectedParserCanonical": "hrn:memory:micromentor.org::coding-app::coding-agent::system",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:memory:micromentor.org::coding-app::coding-agent::app-mem",
      "expectedType": "memory",
      "expectedParserCanonical": "hrn:memory:micromentor.org::coding-app::coding-agent::app-mem",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:memory:micromentor.org::coding-app::coding-agent::app-user:shadowbrush",
      "expectedType": "memory",
      "expectedParserCanonical": "hrn:memory:micromentor.org::coding-app::coding-agent::app-user:shadowbrush",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:memory:micromentor.org::coding-app::coding-agent::priv:shadowbrush",
      "expectedType": "memory",
      "expectedParserCanonical": "hrn:memory:micromentor.org::coding-app::coding-agent::priv:shadowbrush",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:memory:micromentor.org::coding-app::coding-agent::group-mem:eng-team",
      "expectedType": "memory",
      "expectedParserCanonical": "hrn:memory:micromentor.org::coding-app::coding-agent::group-mem:eng-team",
      "expectedParserRewrites": []
    },

    {
      "_section": "D5 — slug-or-PK at parameterized role-marker positions",
      "input": "hrn:memory:micromentor.org::coding-app::coding-agent::app-user:c0123abc456def789012345678",
      "expectedType": "memory",
      "expectedParserCanonical": "hrn:memory:micromentor.org::coding-app::coding-agent::app-user:c0123abc456def789012345678",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:memory:micromentor.org::coding-app::coding-agent::priv:01234567890abcdef0123456789abcde",
      "expectedType": "memory",
      "expectedParserCanonical": "hrn:memory:micromentor.org::coding-app::coding-agent::priv:01234567890abcdef0123456789abcde",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:memory:micromentor.org::coding-app::coding-agent::app-user:foo bar",
      "expectedReject": "invalid-charset",
      "offendingSegment": "foo bar"
    },

    {
      "_section": "D8 — loc: deprecated",
      "input": "hrn:loc:foo:bar",
      "expectedReject": "loc-segment-rejected"
    },
    {
      "input": "loc:foo",
      "expectedReject": "loc-segment-rejected"
    },
    {
      "input": "hrn:memory:org::loc:foo",
      "expectedReject": "loc-segment-rejected"
    },

    {
      "_section": "D9 — slug rules",
      "input": "hrn:org:baragaun.com",
      "expectedType": "org",
      "expectedParserCanonical": "hrn:org:baragaun.com",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:memory:acme.com::foo bar",
      "expectedReject": "invalid-charset",
      "offendingSegment": "foo bar"
    },
    {
      "_note": "system as the position-1 segment of a 2-segment memory URN: no agent context, so the role-marker word is at the wrong structural position. Uses acme.com (not 'org') so the test isolates the system rejection rather than tripping on 'org' as a reserved-word.",
      "input": "hrn:memory:acme.com::system",
      "expectedReject": "reserved-word-slug",
      "offendingSegment": "system"
    },
    {
      "_note": "case-insensitive reserved-word check: Agent (mixed case) is still rejected.",
      "input": "hrn:memory:acme.com::Agent",
      "expectedReject": "reserved-word-slug",
      "offendingSegment": "Agent"
    },
    {
      "input": "hrn:memory:acme.com::aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-toolong",
      "expectedReject": "slug-too-long"
    },

    {
      "_section": "D10 / R2 — installed-object URNs (already canonical)",
      "input": "hrn:agent:micromentor.org::coding-app::hadronmemory.com:coding-agent",
      "expectedType": "agent",
      "expectedParserCanonical": "hrn:agent:micromentor.org::coding-app::hadronmemory.com:coding-agent",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:agent:micromentor.org::coding-app::competitor.com:coding-agent",
      "expectedType": "agent",
      "expectedParserCanonical": "hrn:agent:micromentor.org::coding-app::competitor.com:coding-agent",
      "expectedParserRewrites": []
    },

    {
      "_section": "D11 cat 1 — source/install memory (canonical = definition URN)",
      "_note": "When the installing org equals the author, the install-by-self URN is an alias for the definition URN.",
      "input": "hrn:memory:hadronmemory.com::hadronmemory.com:coding-agent::system",
      "expectedType": "memory",
      "expectedParserCanonical": "hrn:memory:hadronmemory.com::coding-agent::system",
      "expectedParserRewrites": ["source-install-memory"]
    },

    {
      "_section": "D11 cat 2 — node-role polymorphism (RESOLVER LAYER)",
      "_note": "The role-form rewrite needs DB access to look up the node's role; parser flags it for the resolver.",
      "input": "hrn:node:micromentor.org::coding-app::coding-agent::system::review:sort-imports",
      "expectedType": "node",
      "expectedParserCanonical": "hrn:node:micromentor.org::coding-app::coding-agent::system::review:sort-imports",
      "expectedParserRewrites": [],
      "expectedNeedsResolver": true
    },
    {
      "input": "hrn:prompt:micromentor.org::coding-app::coding-agent::system::notify",
      "expectedType": "prompt",
      "expectedParserCanonical": "hrn:prompt:micromentor.org::coding-app::coding-agent::system::notify",
      "expectedParserRewrites": [],
      "expectedNeedsResolver": false
    },

    {
      "_section": "D11 cat 3 — path/slug shortening (RESOLVER LAYER)",
      "_note": "Shortened form is parsed faithfully; resolver does the DB lookup to find the author-org. Parser flags needsResolver=true.",
      "input": "hrn:agent:micromentor.org::coding-app::coding-agent",
      "expectedType": "agent",
      "expectedParserCanonical": "hrn:agent:micromentor.org::coding-app::coding-agent",
      "expectedParserRewrites": [],
      "expectedNeedsResolver": true
    },

    {
      "_section": "D11 cat 4 — type-marker optionality (canonical = bare)",
      "input": "hrn:agent:micromentor.org::app:coding-app::agent:hadronmemory.com:coding-agent",
      "expectedType": "agent",
      "expectedParserCanonical": "hrn:agent:micromentor.org::coding-app::hadronmemory.com:coding-agent",
      "expectedParserRewrites": ["type-marker-optionality"]
    },
    {
      "input": "hrn:memory:micromentor.org::app:coding-app::agent:hadronmemory.com:coding-agent::memory:app-mem",
      "expectedType": "memory",
      "expectedParserCanonical": "hrn:memory:micromentor.org::coding-app::hadronmemory.com:coding-agent::app-mem",
      "expectedParserRewrites": ["type-marker-optionality"]
    },

    {
      "_section": "Compound rewrites — parser-layer cat 4 + resolver-flagged cat 3",
      "_note": "type-markered AND shortened. Parser strips markers (cat 4 fires at parser layer); shortening remains for the resolver.",
      "input": "hrn:agent:micromentor.org::app:coding-app::agent:coding-agent",
      "expectedType": "agent",
      "expectedParserCanonical": "hrn:agent:micromentor.org::coding-app::coding-agent",
      "expectedParserRewrites": ["type-marker-optionality"],
      "expectedNeedsResolver": true
    },

    {
      "_section": "Idempotence — canonical-form inputs pass through unchanged",
      "input": "hrn:agent:micromentor.org::coding-app::hadronmemory.com:coding-agent",
      "expectedType": "agent",
      "expectedParserCanonical": "hrn:agent:micromentor.org::coding-app::hadronmemory.com:coding-agent",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:prompt:micromentor.org::coding-app::coding-agent::system::review:sort-imports",
      "expectedType": "prompt",
      "expectedParserCanonical": "hrn:prompt:micromentor.org::coding-app::coding-agent::system::review:sort-imports",
      "expectedParserRewrites": []
    },

    {
      "_section": "spec 047 — @<handle> owner namespace (user-owned entities) accepted alongside org domains",
      "input": "hrn:app:@holger::gmail-app",
      "expectedType": "app",
      "expectedParserCanonical": "hrn:app:@holger::gmail-app",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:agent:@holger::inbox-triage",
      "expectedType": "agent",
      "expectedParserCanonical": "hrn:agent:@holger::inbox-triage",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:memory:@holger::inbox-triage",
      "expectedType": "memory",
      "expectedParserCanonical": "hrn:memory:@holger::inbox-triage",
      "expectedParserRewrites": []
    },
    {
      "input": "hrn:node:@holger::gmail-app::inbox-triage::system::review:sort-imports",
      "expectedType": "node",
      "expectedParserCanonical": "hrn:node:@holger::gmail-app::inbox-triage::system::review:sort-imports",
      "expectedParserRewrites": [],
      "expectedNeedsResolver": true
    },
    {
      "_section": "spec 047 — self-install collapse with a @<handle> author namespace (cat 1)",
      "input": "hrn:agent:@holger::@holger:triage",
      "expectedType": "agent",
      "expectedParserCanonical": "hrn:agent:@holger::triage",
      "expectedParserRewrites": ["source-install-memory"]
    },
    {
      "_section": "spec 047 — @ rejected for user URNs (position-0 is the handle itself, not an owner namespace)",
      "input": "hrn:user:@holger",
      "expectedReject": "invalid-charset",
      "offendingSegment": "@holger"
    },
    {
      "_section": "spec 047 — @ rejected at a non-namespace position (single-atom slug segment)",
      "input": "hrn:app:hadronmemory.com::@foo",
      "expectedReject": "invalid-charset",
      "offendingSegment": "@foo"
    },
    {
      "_section": "spec 047 — empty @<handle> is a shape error",
      "input": "hrn:app:@::gmail-app",
      "expectedReject": "invalid-segment-shape",
      "offendingSegment": "@"
    },
    {
      "_section": "spec 047 — @ rejected in a node LOC (not an author-context position)",
      "input": "hrn:node:hadronmemory.com::gmail-app::inbox-triage::system::@foo:bar",
      "expectedReject": "invalid-charset",
      "offendingSegment": "@foo"
    },
    {
      "_section": "spec 047 — @<handle> author context IS accepted at the agent position of a node URN",
      "input": "hrn:node:micromentor.org::coding-app::@holger:triage::system::review:foo",
      "expectedType": "node",
      "expectedParserCanonical": "hrn:node:micromentor.org::coding-app::@holger:triage::system::review:foo",
      "expectedParserRewrites": [],
      "expectedNeedsResolver": true
    },
    {
      "_section": "spec 047 — @<handle> author survives an optional leading type marker (cat 4 optionality)",
      "input": "hrn:agent:micromentor.org::app:gmail::agent:@holger:triage",
      "expectedType": "agent",
      "expectedParserCanonical": "hrn:agent:micromentor.org::gmail::@holger:triage",
      "expectedParserRewrites": ["type-marker-optionality"]
    }
  ]
}
